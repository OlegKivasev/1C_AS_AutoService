Перем АС_СтароеНаименование;

Процедура ПередЗаписью(Отказ)

	АС_СтароеНаименование = "";
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|  Бренды.Наименование КАК Наименование
			|ИЗ
			|  Справочник.АС_БрендыТоваров КАК Бренды
			|ГДЕ
			|  Бренды.Ссылка = &Ссылка");
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			АС_СтароеНаименование = СокрЛП(Строка(Выборка.Наименование));
		КонецЕсли;
	КонецЕсли;

	Если АС_УсловноИспользоватьОбработчик Тогда
		Наименование = НормализоватьНаименование(Наименование);
	КонецЕсли;

КонецПроцедуры

Процедура ПриЗаписи(Отказ)

	Если Отказ
		Или ПустаяСтрока(АС_СтароеНаименование)
		Или АС_СтароеНаименование = СокрЛП(Строка(Наименование)) Тогда
		Возврат;
	КонецЕсли;

	АС_ОбновитьНоменклатуруПоБренду(
		АС_СтароеНаименование,
		СокрЛП(Строка(Наименование)),
		Ссылка);

КонецПроцедуры

Процедура АС_ОбновитьНоменклатуруПоБренду(СтароеНаименование, НовоеНаименование, СсылкаБренда)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|  Номенклатура.Ссылка КАК Ссылка
		|ИЗ
		|  Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|  Номенклатура.АС_Бренд = &Бренд
		|  И НЕ Номенклатура.ЭтоГруппа");
	Запрос.УстановитьПараметр("Бренд", СсылкаБренда);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбъектНоменклатуры = Выборка.Ссылка.ПолучитьОбъект();
		ОбновленноеНаименование = АС_ЗаменитьСуффиксБренда(
			ОбъектНоменклатуры.Наименование,
			СтароеНаименование,
			НовоеНаименование,
			100);
		ОбновленноеНаименованиеПолное = АС_ЗаменитьСуффиксБренда(
			ОбъектНоменклатуры.НаименованиеПолное,
			СтароеНаименование,
			НовоеНаименование,
			0);

		Если ОбъектНоменклатуры.Наименование <> ОбновленноеНаименование
			Или ОбъектНоменклатуры.НаименованиеПолное <> ОбновленноеНаименованиеПолное Тогда
			ОбъектНоменклатуры.Наименование = ОбновленноеНаименование;
			ОбъектНоменклатуры.НаименованиеПолное = ОбновленноеНаименованиеПолное;
			ОбъектНоменклатуры.Записать();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция АС_ЗаменитьСуффиксБренда(ИсходноеНаименование, СтароеНаименование, НовоеНаименование, МаксимальнаяДлина)

	Результат = СокрЛП(СтрЗаменить(Строка(ИсходноеНаименование), Символы.НПП, " "));
	Если ПустаяСтрока(Результат) Тогда
		Возврат Результат;
	КонецЕсли;

	СтарыйСуффикс = " | " + СокрЛП(СтароеНаименование);
	Если Не СтрЗаканчиваетсяНа(Результат, СтарыйСуффикс) Тогда
		Возврат Результат;
	КонецЕсли;

	ОсноваНаименования = СокрЛП(Лев(
		Результат,
		СтрДлина(Результат) - СтрДлина(СтарыйСуффикс)));
	НовыйСуффикс = " | " + СокрЛП(НовоеНаименование);
	Если МаксимальнаяДлина > 0 Тогда
		МаксимальнаяДлинаОсновы = МаксимальнаяДлина - СтрДлина(НовыйСуффикс);
		Если МаксимальнаяДлинаОсновы < 1 Тогда
			Возврат Результат;
		КонецЕсли;
		ОсноваНаименования = СокрЛП(Лев(ОсноваНаименования, МаксимальнаяДлинаОсновы));
	КонецЕсли;

	Если ПустаяСтрока(ОсноваНаименования) Тогда
		Возврат Результат;
	КонецЕсли;

	Возврат ОсноваНаименования + НовыйСуффикс;

КонецФункции

Функция НормализоватьНаименование(Значение)

	Результат = СокрЛП(СтрЗаменить(Строка(Значение), Символы.НПП, " "));
	Возврат ТРег(НРег(Результат));

КонецФункции
