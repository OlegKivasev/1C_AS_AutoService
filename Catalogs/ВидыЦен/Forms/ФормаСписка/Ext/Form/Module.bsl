#Область ОбработчикиСобытийФормы

&НаСервере
Процедура АС_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	АС_УстановитьОформлениеОсновногоВидаЦенБезналичногоРасчета();

КонецПроцедуры

&НаКлиенте
&После("ПриОткрытии")
Процедура АС_ПриОткрытииПосле(Отказ)

	АС_УстановитьОформлениеОсновногоВидаЦенБезналичногоРасчета();

КонецПроцедуры

&НаКлиенте
Процедура АС_УстановитьОсновнойВидЦенБезналичногоРасчета(Команда)

	ВыбранныйЭлемент = Элементы.Список.ТекущаяСтрока;
	Если ЗначениеЗаполнено(ВыбранныйЭлемент) Тогда
		АС_СохранитьОсновнойВидЦенБезналичногоРасчета(ВыбранныйЭлемент);
		Элементы.Список.Обновить();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура АС_СохранитьОсновнойВидЦенБезналичногоРасчета(ВыбранныйЭлемент)

	Если ТипЗнч(ВыбранныйЭлемент) <> Тип("СправочникСсылка.ВидыЦен") Тогда
		Возврат;
	КонецЕсли;

	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить(
		"АС_ВидыЦен",
		"ОсновнойВидЦенБезналичногоРасчета",
		ВыбранныйЭлемент);

	АС_УстановитьОформлениеОсновногоВидаЦенБезналичногоРасчета();

КонецПроцедуры

&НаСервере
Процедура АС_УстановитьОформлениеОсновногоВидаЦенБезналичногоРасчета()

	ИмяНастройки = "АС_ОсновнойВидЦенБезналичногоРасчета";
	НастройкиУсловногоОформления = Список.КомпоновщикНастроек.Настройки.УсловноеОформление;

	УдаляемыеЭлементы = Новый Массив;
	Для Каждого ЭлементУсловногоОформления Из НастройкиУсловногоОформления.Элементы Цикл
		Если ЭлементУсловногоОформления.ИдентификаторПользовательскойНастройки = ИмяНастройки Тогда
			УдаляемыеЭлементы.Добавить(ЭлементУсловногоОформления);
		КонецЕсли;
	КонецЦикла;

	Для Каждого ЭлементУсловногоОформления Из УдаляемыеЭлементы Цикл
		НастройкиУсловногоОформления.Элементы.Удалить(ЭлементУсловногоОформления);
	КонецЦикла;

	ОсновнойВидЦенБезналичногоРасчета = АС_ПолучитьОсновнойВидЦенБезналичногоРасчета();
	Если Не ЗначениеЗаполнено(ОсновнойВидЦенБезналичногоРасчета) Тогда
		Возврат;
	КонецЕсли;

	ЭлементУсловногоОформления = НастройкиУсловногоОформления.Элементы.Добавить();
	ЭлементОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = ОсновнойВидЦенБезналичногоРасчета;

	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра(
		"Шрифт", Новый Шрифт(ШрифтыСтиля.ОбычныйШрифтТекста, , , Истина));
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Зеленый);
	ЭлементУсловногоОформления.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	ЭлементУсловногоОформления.ИдентификаторПользовательскойНастройки = ИмяНастройки;
	ЭлементУсловногоОформления.Представление = НСтр(
		"ru = 'Выделение основного вида цен безналичного расчета'");

КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_ПолучитьОсновнойВидЦенБезналичногоРасчета()

	ОсновнойВидЦен = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
		"АС_ВидыЦен",
		"ОсновнойВидЦенБезналичногоРасчета");

	Если ТипЗнч(ОсновнойВидЦен) <> Тип("СправочникСсылка.ВидыЦен") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ОсновнойВидЦен;

КонецФункции

#КонецОбласти
