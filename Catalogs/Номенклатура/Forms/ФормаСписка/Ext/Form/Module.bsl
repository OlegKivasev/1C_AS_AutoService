&НаСервереБезКонтекста
Функция АС_ПолучитьСписокАвтомобилейДляОтбора(ВыбиратьМарки, Марка)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	| 	Автомобили.Ссылка КАК Ссылка,
	| 	Автомобили.Наименование КАК Наименование,
	| 	Автомобили.Родитель КАК Родитель
	|ИЗ
	| 	Справочник.АС_Автомобили КАК Автомобили
	|ГДЕ
	| 	Автомобили.ЭтоГруппа = &ВыбиратьМарки
	| 	И НЕ Автомобили.ПометкаУдаления";
	Запрос.УстановитьПараметр("ВыбиратьМарки", ВыбиратьМарки);
	Если Не ВыбиратьМарки И ЗначениеЗаполнено(Марка) Тогда
		Запрос.Текст = Запрос.Текст + Символы.ПС + "И Автомобили.Родитель = &Марка";
		Запрос.УстановитьПараметр("Марка", Марка);
	КонецЕсли;
	Запрос.Текст = Запрос.Текст + Символы.ПС + "УПОРЯДОЧИТЬ ПО Автомобили.Наименование";

	Результат = Новый СписокЗначений;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ВыбиратьМарки Тогда
			Представление = Выборка.Наименование;
		Иначе
			Представление = Строка(Выборка.Родитель) + " " + Выборка.Наименование;
		КонецЕсли;
		Результат.Добавить(Выборка.Ссылка, Представление);
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция АС_ПолучитьАвтомобилиДляАвтоПодбора(Текст, ВыбиратьМарки, Марка)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 20
	| 	Автомобили.Ссылка КАК Ссылка,
	| 	Автомобили.Наименование КАК Наименование,
	| 	Автомобили.Родитель КАК Родитель
	|ИЗ
	| 	Справочник.АС_Автомобили КАК Автомобили
	|ГДЕ
	| 	Автомобили.ЭтоГруппа = &ВыбиратьМарки
	| 	И НЕ Автомобили.ПометкаУдаления
	| 	И (Автомобили.Наименование ПОДОБНО &СтрокаПоиска
	| 		ИЛИ Автомобили.АС_Синонимы ПОДОБНО &СтрокаПоиска)";
	Запрос.УстановитьПараметр("ВыбиратьМарки", ВыбиратьМарки);
	Запрос.УстановитьПараметр("СтрокаПоиска", "%" + СокрЛП(Текст) + "%");
	Если Не ВыбиратьМарки И ЗначениеЗаполнено(Марка) Тогда
		Запрос.Текст = Запрос.Текст + Символы.ПС + "И Автомобили.Родитель = &Марка";
		Запрос.УстановитьПараметр("Марка", Марка);
	КонецЕсли;
	Запрос.Текст = Запрос.Текст + Символы.ПС + "УПОРЯДОЧИТЬ ПО Автомобили.Наименование";

	Результат = Новый СписокЗначений;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ВыбиратьМарки Тогда
			Представление = Выборка.Наименование;
		Иначе
			Представление = Строка(Выборка.Родитель) + " " + Выборка.Наименование;
		КонецЕсли;
		Результат.Добавить(Выборка.Ссылка, Представление);
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция АС_ПолучитьМаркуМодели(Модель)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		| 	Автомобили.Родитель КАК Марка
		|ИЗ
		| 	Справочник.АС_Автомобили КАК Автомобили
		|ГДЕ
		| 	Автомобили.Ссылка = &Модель
		| 	И НЕ Автомобили.ЭтоГруппа");
	Запрос.УстановитьПараметр("Модель", Модель);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Марка;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

&НаСервере
Процедура АС_ПрименитьОтборПоАвтомобилюНаСервере()

	ЕстьОтборАвтомобиля = ЗначениеЗаполнено(АС_ОтборМарка)
		Или ЗначениеЗаполнено(АС_ОтборМодель)
		Или ЗначениеЗаполнено(АС_ОтборГод);
	Если Не АС_БезДокументов И Не ЕстьОтборАвтомобиля Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
			СписокЗапасы, "Ссылка", Неопределено, ВидСравненияКомпоновкиДанных.ВСписке, , Ложь);
		Возврат;
	КонецЕсли;

	Если ЕстьОтборАвтомобиля Тогда
		СписокНоменклатуры = АС_ПолучитьНоменклатуруПоАвтомобилю(
			АС_ОтборМарка, АС_ОтборМодель, АС_ОтборГод);
	Иначе
		СписокНоменклатуры = АС_ПолучитьНоменклатуруБезДокументов();
	КонецЕсли;

	Если АС_БезДокументов И ЕстьОтборАвтомобиля Тогда
		БезДокументов = Новый Соответствие;
		Для Каждого ЗначениеСписка Из АС_ПолучитьНоменклатуруБезДокументов() Цикл
			БезДокументов.Вставить(ЗначениеСписка.Значение, Истина);
		КонецЦикла;
		Индекс = СписокНоменклатуры.Количество() - 1;
		Пока Индекс >= 0 Цикл
			Если БезДокументов.Получить(СписокНоменклатуры[Индекс].Значение) = Неопределено Тогда
				СписокНоменклатуры.Удалить(Индекс);
			КонецЕсли;
			Индекс = Индекс - 1;
		КонецЦикла;
	КонецЕсли;

	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		СписокЗапасы, "Ссылка", СписокНоменклатуры, ВидСравненияКомпоновкиДанных.ВСписке, , Истина);

КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_ПолучитьНоменклатуруПоАвтомобилю(Марка, Модель, Год)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	| 	Применяемость.Ссылка КАК Номенклатура
	|ИЗ
	| 	Справочник.Номенклатура.АС_Применяемость КАК Применяемость";
	Если ЗначениеЗаполнено(Модель) Тогда
		Запрос.Текст = Запрос.Текст + Символы.ПС
			+ "ГДЕ Применяемость.Автомобиль = &Модель";
		Запрос.УстановитьПараметр("Модель", Модель);
	ИначеЕсли ЗначениеЗаполнено(Марка) Тогда
		Запрос.Текст = Запрос.Текст + Символы.ПС
			+ "ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.АС_Автомобили КАК Автомобили"
			+ Символы.ПС + "ПО Применяемость.Автомобиль = Автомобили.Ссылка"
			+ Символы.ПС + "ГДЕ Автомобили.Родитель = &Марка";
		Запрос.УстановитьПараметр("Марка", Марка);
	Иначе
		Запрос.Текст = Запрос.Текст + Символы.ПС
			+ "ГДЕ НЕ Применяемость.Автомобиль = ЗНАЧЕНИЕ(Справочник.АС_Автомобили.ПустаяСсылка)";
	КонецЕсли;

	Если ЗначениеЗаполнено(Год) Тогда
		Запрос.Текст = Запрос.Текст + Символы.ПС
			+ "И (Применяемость.ГодС = 0 ИЛИ Применяемость.ГодС <= &Год)"
			+ Символы.ПС + "И (Применяемость.ГодПо = 0 ИЛИ Применяемость.ГодПо >= &Год)";
		Запрос.УстановитьПараметр("Год", Год);
	КонецЕсли;

	Результат = Новый СписокЗначений;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Номенклатура);
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция АС_ПолучитьНоменклатуруБезДокументов()

	ТекстыЗапросов = Новый Массив;
	Для Каждого ЭлементСостава Из Метаданные.КритерииОтбора.ДокументыПоНоменклатуре.Состав Цикл
		СтруктураДанных = АС_СтруктураДанныхКритерияОтбора(ЭлементСостава.ПолноеИмя());

		Если СтруктураДанных.ТипОбъекта <> "Документ"
			Или Не ПравоДоступа("Просмотр", СтруктураДанных.Метаданные)
			Или Не ОбщегоНазначения.ОбъектМетаданныхДоступенПоФункциональнымОпциям(СтруктураДанных.Метаданные) Тогда
			Продолжить;
		КонецЕсли;

		Если ПустаяСтрока(СтруктураДанных.ИмяТаблЧасти) Тогда
			ИмяТаблицы = "Документ." + СтруктураДанных.ВидОбъекта;
		Иначе
			ИмяТаблицы = "Документ." + СтруктураДанных.ВидОбъекта + "." + СтруктураДанных.ИмяТаблЧасти;
		КонецЕсли;

		ТекстЗапроса =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		| 	ТаблицаКритерия." + СтруктураДанных.ИмяРеквизита + " КАК Номенклатура";
		Если ТекстыЗапросов.Количество() = 0 Тогда
			ТекстЗапроса = ТекстЗапроса + Символы.ПС + "ПОМЕСТИТЬ ВТНоменклатураВДокументах";
		КонецЕсли;
		ТекстЗапроса = ТекстЗапроса +
		Символы.ПС + "ИЗ" +
		Символы.ПС + " 	" + ИмяТаблицы + " КАК ТаблицаКритерия" +
		Символы.ПС + "ГДЕ" +
		Символы.ПС + " 	НЕ ТаблицаКритерия." + СтруктураДанных.ИмяРеквизита + " ЕСТЬ NULL";
		ТекстыЗапросов.Добавить(ТекстЗапроса);
	КонецЦикла;

	Если ТекстыЗапросов.Количество() = 0 Тогда
		ТекстЗапроса = "";
	Иначе
		ТекстЗапроса = СтрСоединить(ТекстыЗапросов, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС);
		ТекстЗапроса = ТекстЗапроса +
		Символы.ПС + ";" +
		Символы.ПС + "ВЫБРАТЬ РАЗЛИЧНЫЕ" +
		Символы.ПС + " 	Товары.Ссылка КАК Номенклатура" +
		Символы.ПС + "ИЗ" +
		Символы.ПС + " 	Справочник.Номенклатура КАК Товары" +
		Символы.ПС + " 	ЛЕВОЕ СОЕДИНЕНИЕ ВТНоменклатураВДокументах КАК НоменклатураВДокументах" +
		Символы.ПС + " 	ПО Товары.Ссылка = НоменклатураВДокументах.Номенклатура" +
		Символы.ПС + "ГДЕ" +
		Символы.ПС + " 	НЕ Товары.ЭтоГруппа" +
		Символы.ПС + " 	И НоменклатураВДокументах.Номенклатура ЕСТЬ NULL";
	КонецЕсли;

	Если ПустаяСтрока(ТекстЗапроса) Тогда
		ТекстЗапроса =
		"ВЫБРАТЬ
		| 	Номенклатура.Ссылка КАК Номенклатура
		|ИЗ
		| 	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		| 	НЕ Номенклатура.ЭтоГруппа";
	КонецЕсли;

	Запрос = Новый Запрос(ТекстЗапроса);
	СписокНоменклатуры = Новый СписокЗначений;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СписокНоменклатуры.Добавить(Выборка.Номенклатура);
	КонецЦикла;

	Возврат СписокНоменклатуры;

КонецФункции

&НаСервереБезКонтекста
Функция АС_СтруктураДанныхКритерияОтбора(ПутьКДанным)

	СтруктураДанных = Новый Структура;
	ИменаПолей = Новый Массив;
	ИменаПолей.Добавить("ТипОбъекта");
	ИменаПолей.Добавить("ВидОбъекта");
	ИменаПолей.Добавить("ПутьКДанным");
	ИменаПолей.Добавить("ИмяТаблЧасти");
	ИменаПолей.Добавить("ИмяРеквизита");

	Для Индекс = 1 По 3 Цикл
		ПозицияТочки = СтрНайти(ПутьКДанным, ".");
		ТекущееЗначение = Лев(ПутьКДанным, ПозицияТочки - 1);
		СтруктураДанных.Вставить(ИменаПолей[Индекс - 1], ТекущееЗначение);
		ПутьКДанным = Сред(ПутьКДанным, ПозицияТочки + 1);
	КонецЦикла;

	ПутьКДанным = СтрЗаменить(ПутьКДанным, "Реквизит.", "");
	Если СтруктураДанных.ПутьКДанным = "ТабличнаяЧасть" Тогда
		Для Индекс = 4 По 5 Цикл
			ПозицияТочки = СтрНайти(ПутьКДанным, ".");
			Если ПозицияТочки = 0 Тогда
				ТекущееЗначение = ПутьКДанным;
			Иначе
				ТекущееЗначение = Лев(ПутьКДанным, ПозицияТочки - 1);
			КонецЕсли;
			СтруктураДанных.Вставить(ИменаПолей[Индекс - 1], ТекущееЗначение);
			ПутьКДанным = Сред(ПутьКДанным, ПозицияТочки + 1);
		КонецЦикла;
	Иначе
		СтруктураДанных.Вставить("ИмяТаблЧасти", "");
		СтруктураДанных.Вставить("ИмяРеквизита", ПутьКДанным);
	КонецЕсли;

	СтруктураДанных.Вставить("Метаданные", Метаданные.Документы[СтруктураДанных.ВидОбъекта]);
	Возврат СтруктураДанных;

КонецФункции
