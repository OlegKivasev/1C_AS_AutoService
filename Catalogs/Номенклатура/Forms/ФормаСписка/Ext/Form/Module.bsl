Функция АС_ПолучитьНоменклатуруПоОтборам(ПараметрыОтбора)

	ЕстьОтборАвтомобиля = ЗначениеЗаполнено(ПараметрыОтбора.Марка)
		Или ЗначениеЗаполнено(ПараметрыОтбора.Модель)
		Или ЗначениеЗаполнено(ПараметрыОтбора.Год);
	ЕстьТоварныеОтборы = ЗначениеЗаполнено(ПараметрыОтбора.Бренд)
		Или ПараметрыОтбора.ПоступившиеЗаПериод
		Или ПараметрыОтбора.ПроданныеЗаПериод
		Или ПараметрыОтбора.Изображение
		Или ПараметрыОтбора.OEMАртикулы
		Или ПараметрыОтбора.Применяемость;
	ЕстьОтборOEM = ЗначениеЗаполнено(ПараметрыОтбора.OEM) Или ЗначениеЗаполнено(ПараметрыОтбора.МаркаOEM);
	Если Не ПараметрыОтбора.Документы И Не ЕстьОтборАвтомобиля И Не ЕстьТоварныеОтборы
		И Не ЕстьОтборOEM И Не ПараметрыОтбора.ЕстьАналоги
		И Не ПараметрыОтбора.РекомендацииПоЗакупке Тогда
		Возврат Неопределено;
	КонецЕсли;

	СписокНоменклатуры = Неопределено;
	Если ЕстьОтборАвтомобиля Тогда
		СписокНоменклатуры = АС_ПолучитьНоменклатуруПоАвтомобилю(
			ПараметрыОтбора.Марка, ПараметрыОтбора.Модель, ПараметрыОтбора.Год);
	КонецЕсли;

	Если ПараметрыОтбора.Документы Тогда
		СписокБезДокументов = ?(ПараметрыОтбора.ОтборДокументы = 1,
			АС_ПолучитьНоменклатуруБезДокументов(), АС_ПолучитьНоменклатуруСДокументами());
		Если СписокНоменклатуры = Неопределено Тогда
			СписокНоменклатуры = СписокБезДокументов;
		Иначе
			СписокНоменклатуры = АС_ПересечьСпискиНоменклатуры(
				СписокНоменклатуры, СписокБезДокументов);
		КонецЕсли;
	КонецЕсли;

	Если ЕстьТоварныеОтборы Тогда
		СписокПоТоварнымОтборам = АС_ПолучитьНоменклатуруПоТоварнымОтборам(ПараметрыОтбора);
		Если СписокНоменклатуры = Неопределено Тогда
			СписокНоменклатуры = СписокПоТоварнымОтборам;
		Иначе
			СписокНоменклатуры = АС_ПересечьСпискиНоменклатуры(
				СписокНоменклатуры, СписокПоТоварнымОтборам);
		КонецЕсли;
	КонецЕсли;

	Если ЕстьОтборOEM Тогда
		СписокПоOEM = АС_ПолучитьНоменклатуруПоOEM(ПараметрыОтбора.OEM, ПараметрыОтбора.МаркаOEM);
		Если СписокНоменклатуры = Неопределено Тогда
			СписокНоменклатуры = СписокПоOEM;
		Иначе
			СписокНоменклатуры = АС_ПересечьСпискиНоменклатуры(СписокНоменклатуры, СписокПоOEM);
		КонецЕсли;
	КонецЕсли;

	Если ПараметрыОтбора.ЕстьАналоги Тогда
		СписокПоАналогам = АС_ПолучитьНоменклатуруПоНаличиюАналогов(ПараметрыОтбора.ОтборЕстьАналоги);
		Если СписокНоменклатуры = Неопределено Тогда
			СписокНоменклатуры = СписокПоАналогам;
		Иначе
			СписокНоменклатуры = АС_ПересечьСпискиНоменклатуры(СписокНоменклатуры, СписокПоАналогам);
		КонецЕсли;
	КонецЕсли;

	Если ПараметрыОтбора.РекомендацииПоЗакупке И Не ПараметрыОтбора.ПроданныеЗаПериод Тогда
		ТоварыКЗакупке = ПараметрыОтбора.ТоварыКЗакупке;
		Если ТоварыКЗакупке = Неопределено Тогда
			ТоварыКЗакупке = Новый Массив;
		КонецЕсли;
		Если СписокНоменклатуры = Неопределено Тогда
			СписокНоменклатуры = ТоварыКЗакупке;
		Иначе
			СписокНоменклатуры = АС_ПересечьСпискиНоменклатуры(СписокНоменклатуры, ТоварыКЗакупке);
		КонецЕсли;
	КонецЕсли;
	Возврат СписокНоменклатуры;

КонецФункции

&НаСервереБезКонтекста
Функция АС_ПолучитьНоменклатуруПоНаличиюАналогов(ОтборАналоги)

	АС_ИндексOEMСервер.ОбеспечитьИндекс();
	// Считаем разные товары по ключу OEM, чтобы не строить все пары аналогов.
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|ИндексOEM.КлючOEM КАК КлючOEM
		|ПОМЕСТИТЬ OEMСАналогами
		|ИЗ РегистрСведений.АС_ИндексOEMНоменклатуры КАК ИндексOEM
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Товары
		|ПО ИндексOEM.Номенклатура = Товары.Ссылка
		|ГДЕ НЕ Товары.ЭтоГруппа
		|И НЕ Товары.ПометкаУдаления
		|И НЕ Товары.Недействителен
		|И Товары.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)
		|СГРУППИРОВАТЬ ПО ИндексOEM.КлючOEM
		|ИМЕЮЩИЕ КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ИндексOEM.Номенклатура) > 1
		|ИНДЕКСИРОВАТЬ ПО КлючOEM
		|;
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|ИндексOEM.Номенклатура КАК Номенклатура
		|ПОМЕСТИТЬ ТоварыСАналогами
		|ИЗ РегистрСведений.АС_ИндексOEMНоменклатуры КАК ИндексOEM
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ OEMСАналогами КАК ОбщиеOEM
		|ПО ИндексOEM.КлючOEM = ОбщиеOEM.КлючOEM
		|ИНДЕКСИРОВАТЬ ПО Номенклатура
		|;
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|ТоварыСписка.Ссылка КАК Номенклатура
		|ИЗ Справочник.Номенклатура КАК ТоварыСписка
		|ЛЕВОЕ СОЕДИНЕНИЕ ТоварыСАналогами КАК САналогами
		|ПО ТоварыСписка.Ссылка = САналогами.Номенклатура
		|ГДЕ НЕ ТоварыСписка.ЭтоГруппа
		|И ТоварыСписка.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)
		|И ((&ЕстьАналоги И НЕ САналогами.Номенклатура ЕСТЬ NULL)
		| ИЛИ (НЕ &ЕстьАналоги И САналогами.Номенклатура ЕСТЬ NULL))");
	Запрос.УстановитьПараметр("ЕстьАналоги", ОтборАналоги <> 1);
	Результат = Новый СписокЗначений;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Номенклатура);
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция АС_ПолучитьНоменклатуруПоOEM(OEM, Марка)

	Результат = Новый СписокЗначений;
	ЕстьOEM = ЗначениеЗаполнено(OEM);
	КлючOEM = АС_ИндексOEMСервер.НормализоватьOEM(OEM);
	Если ЕстьOEM И ПустаяСтрока(КлючOEM) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|  OEMПоМаркам.Ссылка КАК Номенклатура,
		|  OEMПоМаркам.OEM КАК OEM
		|ИЗ Справочник.Номенклатура.АС_OEMПоМаркам КАК OEMПоМаркам
		|ГДЕ OEMПоМаркам.OEM <> """"");
	Если ЕстьOEM Тогда
		АС_ИндексOEMСервер.ОбеспечитьИндекс();
		// Индекс включает старое поле OEM: ниже сверяем именно строку таблицы карточки.
		Запрос.Текст = Запрос.Текст + Символы.ПС
			+ "И OEMПоМаркам.Ссылка В (" + Символы.ПС
			+ "ВЫБРАТЬ ИндексOEM.Номенклатура" + Символы.ПС
			+ "ИЗ РегистрСведений.АС_ИндексOEMНоменклатуры КАК ИндексOEM" + Символы.ПС
			+ "ГДЕ ИндексOEM.КлючOEM = &КлючOEM)";
		Запрос.УстановитьПараметр("КлючOEM", КлючOEM);
	КонецЕсли;
	Если ЗначениеЗаполнено(Марка) Тогда
		Запрос.Текст = Запрос.Текст + Символы.ПС + "И OEMПоМаркам.Марка = &Марка";
		Запрос.УстановитьПараметр("Марка", Марка);
	КонецЕсли;

	НайденныеСсылки = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЕстьOEM И АС_ИндексOEMСервер.НормализоватьOEM(Выборка.OEM) <> КлючOEM Тогда
			Продолжить;
		КонецЕсли;
		Если НайденныеСсылки.Получить(Выборка.Номенклатура) = Неопределено Тогда
			НайденныеСсылки.Вставить(Выборка.Номенклатура, Истина);
			Результат.Добавить(Выборка.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция АС_ПересечьСпискиНоменклатуры(ПервыйСписок, ВторойСписок)

	// Обычные отборы возвращают СписокЗначений, рекомендации — Массив ссылок.
	// Приводим только локальные переменные; исходные коллекции не меняем.
	ПервыйСписокДляПересечения = ПервыйСписок;
	Если ТипЗнч(ПервыйСписок) = Тип("Массив") Тогда
		ПервыйСписокДляПересечения = Новый СписокЗначений;
		ПервыйСписокДляПересечения.ЗагрузитьЗначения(ПервыйСписок);
	КонецЕсли;
	ВторойСписокДляПересечения = ВторойСписок;
	Если ТипЗнч(ВторойСписок) = Тип("Массив") Тогда
		ВторойСписокДляПересечения = Новый СписокЗначений;
		ВторойСписокДляПересечения.ЗагрузитьЗначения(ВторойСписок);
	КонецЕсли;

	ЗначенияВторогоСписка = Новый Соответствие;
	Для Каждого ЗначениеСписка Из ВторойСписокДляПересечения Цикл
		ЗначенияВторогоСписка.Вставить(ЗначениеСписка.Значение, Истина);
	КонецЦикла;

	Результат = Новый СписокЗначений;
	Для Каждого ЗначениеСписка Из ПервыйСписокДляПересечения Цикл
		Если ЗначенияВторогоСписка.Получить(ЗначениеСписка.Значение) <> Неопределено Тогда
			Результат.Добавить(ЗначениеСписка.Значение, ЗначениеСписка.Представление);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция АС_ПолучитьНоменклатуруПоТоварнымОтборам(ПараметрыОтбора)

	Если (ПараметрыОтбора.ПоступившиеЗаПериод
		И (Не ЗначениеЗаполнено(ПараметрыОтбора.ДатаПоступленияС)
			Или Не ЗначениеЗаполнено(ПараметрыОтбора.ДатаПоступленияПо)))
		Или (ПараметрыОтбора.ПроданныеЗаПериод
			И (Не ЗначениеЗаполнено(ПараметрыОтбора.ДатаПродажиС)
				Или Не ЗначениеЗаполнено(ПараметрыОтбора.ДатаПродажиПо))) Тогда
		Возврат Новый СписокЗначений;
	КонецЕсли;

	ТекстПакетаПериодов = "";
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		| 	Номенклатура.Ссылка КАК Номенклатура
		|ИЗ
		| 	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		| 	НЕ Номенклатура.ЭтоГруппа");

	Если ЗначениеЗаполнено(ПараметрыОтбора.Бренд) Тогда
		Запрос.Текст = Запрос.Текст + Символы.ПС
			+ "И Номенклатура.АС_Бренд = &Бренд";
		Запрос.УстановитьПараметр("Бренд", ПараметрыОтбора.Бренд);
	КонецЕсли;

	Если ПараметрыОтбора.Изображение Тогда
		Если ПараметрыОтбора.ОтборИзображение = 1 Тогда
			Запрос.Текст = Запрос.Текст + Символы.ПС
				+ "И Номенклатура.ФайлКартинки = ЗНАЧЕНИЕ(Справочник.НоменклатураПрисоединенныеФайлы.ПустаяСсылка)";
		Иначе
			Запрос.Текст = Запрос.Текст + Символы.ПС
				+ "И НЕ Номенклатура.ФайлКартинки = ЗНАЧЕНИЕ(Справочник.НоменклатураПрисоединенныеФайлы.ПустаяСсылка)";
		КонецЕсли;
	КонецЕсли;

	Если ПараметрыОтбора.OEMАртикулы Тогда
		Если ПараметрыОтбора.ОтборOEMАртикулы = 1 Тогда
			ОператорОтсутствияOEM = "НЕ ";
		Иначе
			ОператорОтсутствияOEM = "";
		КонецЕсли;
		Запрос.Текст = Запрос.Текст + Символы.ПС
			+ "И " + ОператорОтсутствияOEM + "Номенклатура.Ссылка В (" + Символы.ПС
			+ "ВЫБРАТЬ РАЗЛИЧНЫЕ OEMПоМаркам.Ссылка" + Символы.ПС
			+ "ИЗ Справочник.Номенклатура.АС_OEMПоМаркам КАК OEMПоМаркам" + Символы.ПС
			+ "ГДЕ OEMПоМаркам.OEM <> """"";
		Если ЗначениеЗаполнено(ПараметрыОтбора.МаркаOEMАртикулов) Тогда
			Запрос.Текст = Запрос.Текст + Символы.ПС
				+ "И OEMПоМаркам.Марка = &МаркаOEMАртикулов";
			Запрос.УстановитьПараметр("МаркаOEMАртикулов", ПараметрыОтбора.МаркаOEMАртикулов);
		КонецЕсли;
		Запрос.Текст = Запрос.Текст + ")";
	КонецЕсли;

	Если ПараметрыОтбора.Применяемость Тогда
		Если ПараметрыОтбора.ОтборПрименяемость = 1 Тогда
			ОператорОтсутствияПрименяемости = "НЕ ";
		Иначе
			ОператорОтсутствияПрименяемости = "";
		КонецЕсли;
		Запрос.Текст = Запрос.Текст + Символы.ПС
			+ "И " + ОператорОтсутствияПрименяемости + "Номенклатура.Ссылка В (" + Символы.ПС
			+ "ВЫБРАТЬ РАЗЛИЧНЫЕ Применяемость.Ссылка" + Символы.ПС
			+ "ИЗ Справочник.Номенклатура.АС_Применяемость КАК Применяемость)";
	КонецЕсли;

	Если ПараметрыОтбора.ПоступившиеЗаПериод Тогда
		ТекстПакетаПериодов = ТекстПакетаПериодов
			+ АС_ПродажиНоменклатурыСервер.ТекстОтбораПоступлений(ПараметрыОтбора.НазначениеПоступления) + Символы.ПС;
		Запрос.Текст = Запрос.Текст + Символы.ПС
			+ "И Номенклатура.Ссылка В (" + Символы.ПС
			+ "ВЫБРАТЬ Номенклатура ИЗ АС_ПоступившиеНоменклатура"
			+ ")";
		Запрос.УстановитьПараметр("ДатаПоступленияС", НачалоДня(ПараметрыОтбора.ДатаПоступленияС));
		Запрос.УстановитьПараметр("ДатаПоступленияПо", КонецДня(ПараметрыОтбора.ДатаПоступленияПо));
		Запрос.УстановитьПараметр("ПоступлениеПодЗаказПокупателя", ПараметрыОтбора.НазначениеПоступления = 2);
	КонецЕсли;

	Если ПараметрыОтбора.ПроданныеЗаПериод Тогда
		ТекстПакетаПериодов = ТекстПакетаПериодов
			+ АС_ПродажиНоменклатурыСервер.ТекстОтбораПродаж(ПараметрыОтбора.ИсточникПродажи) + Символы.ПС;
		Запрос.Текст = Запрос.Текст + Символы.ПС
			+ "И Номенклатура.Ссылка В (" + Символы.ПС
			+ "ВЫБРАТЬ Номенклатура ИЗ АС_ПроданныеНоменклатура"
			+ ")";
		Запрос.УстановитьПараметр("ДатаПродажиС", НачалоДня(ПараметрыОтбора.ДатаПродажиС));
		Запрос.УстановитьПараметр("ДатаПродажиПо", КонецДня(ПараметрыОтбора.ДатаПродажиПо));
		Запрос.УстановитьПараметр("ПродажаПодЗаказПокупателя", ПараметрыОтбора.ИсточникПродажи = 2);
	КонецЕсли;

	Запрос.Текст = ТекстПакетаПериодов + Запрос.Текст;

	СписокНоменклатуры = Новый СписокЗначений;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СписокНоменклатуры.Добавить(Выборка.Номенклатура);
	КонецЦикла;
	Возврат СписокНоменклатуры;

КонецФункции

&НаСервереБезКонтекста
Функция АС_ПолучитьНоменклатуруПоАвтомобилю(Марка, Модель, Год)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	| 	Применяемость.Ссылка КАК Номенклатура
	|ИЗ
	| 	Справочник.Номенклатура.АС_Применяемость КАК Применяемость";
	Если ЗначениеЗаполнено(Модель) Тогда
		Запрос.Текст = Запрос.Текст + Символы.ПС
			+ "ГДЕ Применяемость.Автомобиль = &Модель";
		Запрос.УстановитьПараметр("Модель", Модель);
	ИначеЕсли ЗначениеЗаполнено(Марка) Тогда
		Запрос.Текст = Запрос.Текст + Символы.ПС
			+ "ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.АС_Автомобили КАК Автомобили"
			+ Символы.ПС + "ПО Применяемость.Автомобиль = Автомобили.Ссылка"
			+ Символы.ПС + "ГДЕ Автомобили.Родитель = &Марка";
		Запрос.УстановитьПараметр("Марка", Марка);
	Иначе
		Запрос.Текст = Запрос.Текст + Символы.ПС
			+ "ГДЕ НЕ Применяемость.Автомобиль = ЗНАЧЕНИЕ(Справочник.АС_Автомобили.ПустаяСсылка)";
	КонецЕсли;

	Если ЗначениеЗаполнено(Год) Тогда
		Запрос.Текст = Запрос.Текст + Символы.ПС
			+ "И (Применяемость.ГодС = 0 ИЛИ Применяемость.ГодС <= &Год)"
			+ Символы.ПС + "И (Применяемость.ГодПо = 0 ИЛИ Применяемость.ГодПо >= &Год)";
		Запрос.УстановитьПараметр("Год", Год);
	КонецЕсли;

	Результат = Новый СписокЗначений;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Номенклатура);
	КонецЦикла;
	Возврат Результат;

