Функция АС_ПолучитьНоменклатуруПоТоварнымОтборам(ПараметрыОтбора)

	Если (ПараметрыОтбора.ПоступившиеЗаПериод
		И (Не ЗначениеЗаполнено(ПараметрыОтбора.ДатаПоступленияС)
			Или Не ЗначениеЗаполнено(ПараметрыОтбора.ДатаПоступленияПо)))
		Или (ПараметрыОтбора.ПроданныеЗаПериод
			И (Не ЗначениеЗаполнено(ПараметрыОтбора.ДатаПродажиС)
				Или Не ЗначениеЗаполнено(ПараметрыОтбора.ДатаПродажиПо))) Тогда
		Возврат Новый СписокЗначений;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		| 	Номенклатура.Ссылка КАК Номенклатура
		|ИЗ
		| 	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		| 	НЕ Номенклатура.ЭтоГруппа");

	Если ЗначениеЗаполнено(ПараметрыОтбора.Бренд) Тогда
		Запрос.Текст = Запрос.Текст + Символы.ПС
			+ "И Номенклатура.АС_Бренд = &Бренд";
		Запрос.УстановитьПараметр("Бренд", ПараметрыОтбора.Бренд);
	КонецЕсли;

	Если ПараметрыОтбора.Изображение Тогда
		Если ПараметрыОтбора.ОтборИзображение = 1 Тогда
			Запрос.Текст = Запрос.Текст + Символы.ПС
				+ "И Номенклатура.ФайлКартинки = ЗНАЧЕНИЕ(Справочник.НоменклатураПрисоединенныеФайлы.ПустаяСсылка)";
		Иначе
			Запрос.Текст = Запрос.Текст + Символы.ПС
				+ "И НЕ Номенклатура.ФайлКартинки = ЗНАЧЕНИЕ(Справочник.НоменклатураПрисоединенныеФайлы.ПустаяСсылка)";
		КонецЕсли;
	КонецЕсли;

	Если ПараметрыОтбора.OEMАртикулы Тогда
		Если ПараметрыОтбора.ОтборOEMАртикулы = 1 Тогда
			ОператорОтсутствияOEM = "НЕ ";
		Иначе
			ОператорОтсутствияOEM = "";
		КонецЕсли;
		Запрос.Текст = Запрос.Текст + Символы.ПС
			+ "И " + ОператорОтсутствияOEM + "Номенклатура.Ссылка В (" + Символы.ПС
			+ "ВЫБРАТЬ РАЗЛИЧНЫЕ OEMПоМаркам.Ссылка" + Символы.ПС
			+ "ИЗ Справочник.Номенклатура.АС_OEMПоМаркам КАК OEMПоМаркам" + Символы.ПС
			+ "ГДЕ OEMПоМаркам.OEM <> """"";
		Если ЗначениеЗаполнено(ПараметрыОтбора.МаркаOEMАртикулов) Тогда
			Запрос.Текст = Запрос.Текст + Символы.ПС
				+ "И OEMПоМаркам.Марка = &МаркаOEMАртикулов";
			Запрос.УстановитьПараметр("МаркаOEMАртикулов", ПараметрыОтбора.МаркаOEMАртикулов);
		КонецЕсли;
		Запрос.Текст = Запрос.Текст + ")";
	КонецЕсли;

	Если ПараметрыОтбора.Применяемость Тогда
		Если ПараметрыОтбора.ОтборПрименяемость = 1 Тогда
			ОператорОтсутствияПрименяемости = "НЕ ";
		Иначе
			ОператорОтсутствияПрименяемости = "";
		КонецЕсли;
		Запрос.Текст = Запрос.Текст + Символы.ПС
			+ "И " + ОператорОтсутствияПрименяемости + "Номенклатура.Ссылка В (" + Символы.ПС
			+ "ВЫБРАТЬ РАЗЛИЧНЫЕ Применяемость.Ссылка" + Символы.ПС
			+ "ИЗ Справочник.Номенклатура.АС_Применяемость КАК Применяемость)";
	КонецЕсли;

	Если ПараметрыОтбора.ПоступившиеЗаПериод Тогда
		Запрос.Текст = Запрос.Текст + Символы.ПС
			+ "И Номенклатура.Ссылка В (" + Символы.ПС
			+ "ВЫБРАТЬ РАЗЛИЧНЫЕ СтрокиПоступления.Номенклатура" + Символы.ПС
			+ "ИЗ Документ.ПриходнаяНакладная.Запасы КАК СтрокиПоступления" + Символы.ПС
			+ "	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПриходнаяНакладная КАК Поступление" + Символы.ПС
			+ "	ПО СтрокиПоступления.Ссылка = Поступление.Ссылка" + Символы.ПС
			+ "ГДЕ НЕ Поступление.ПометкаУдаления" + Символы.ПС
			+ "	И Поступление.Проведен" + Символы.ПС
			+ "	И Поступление.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПриходнаяНакладная.ПоступлениеОтПоставщика)" + Символы.ПС
			+ "	И Поступление.Дата МЕЖДУ &ДатаПоступленияС И &ДатаПоступленияПо)";
		Запрос.УстановитьПараметр("ДатаПоступленияС", НачалоДня(ПараметрыОтбора.ДатаПоступленияС));
		Запрос.УстановитьПараметр("ДатаПоступленияПо", КонецДня(ПараметрыОтбора.ДатаПоступленияПо));
	КонецЕсли;

	Если ПараметрыОтбора.ПроданныеЗаПериод Тогда
		Запрос.Текст = Запрос.Текст + Символы.ПС
			+ "И Номенклатура.Ссылка В (" + Символы.ПС
			+ "ВЫБРАТЬ РАЗЛИЧНЫЕ СтрокиЗаказа.Номенклатура" + Символы.ПС
			+ "ИЗ Документ.ЗаказПокупателя.Запасы КАК СтрокиЗаказа" + Символы.ПС
			+ "	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя КАК Заказ" + Символы.ПС
			+ "	ПО СтрокиЗаказа.Ссылка = Заказ.Ссылка" + Символы.ПС
			+ "ГДЕ НЕ Заказ.ПометкаУдаления" + Символы.ПС
			+ "	И Заказ.ВариантЗавершения <> ЗНАЧЕНИЕ(Перечисление.ВариантыЗавершенияЗаказа.Отменен)" + Символы.ПС
			+ "	И Заказ.Дата МЕЖДУ &ДатаПродажиС И &ДатаПродажиПо" + Символы.ПС
			+ "	И (Заказ.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаряд)" + Символы.ПС
			+ "		ИЛИ (Заказ.ВидОперации <> ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаряд)" + Символы.ПС
			+ "			И Заказ.СостояниеЗаказа = ЗНАЧЕНИЕ(Справочник.СостоянияЗаказовПокупателей.Завершен)))" + Символы.ПС
			+ ")";
		Запрос.УстановитьПараметр("ДатаПродажиС", НачалоДня(ПараметрыОтбора.ДатаПродажиС));
		Запрос.УстановитьПараметр("ДатаПродажиПо", КонецДня(ПараметрыОтбора.ДатаПродажиПо));
	КонецЕсли;

	СписокНоменклатуры = Новый СписокЗначений;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СписокНоменклатуры.Добавить(Выборка.Номенклатура);
	КонецЦикла;
	Возврат СписокНоменклатуры;

КонецФункции

