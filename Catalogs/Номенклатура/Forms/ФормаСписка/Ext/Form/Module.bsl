&НаКлиенте
Процедура АС_ПоискВДеревеИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)

	// Во время набора не меняем дерево и не запускаем его обработчики выбора.
	СтандартнаяОбработка = Ложь;
	Элемент.ОбновлениеТекстаРедактирования = ОбновлениеТекстаРедактирования.НеИспользовать;
	ЭтотОбъект[Элемент.Имя] = Текст;
	Если АС_ПоследниеПоискиКатегорийГрупп <> Неопределено Тогда
		ИмяДерева = ?(Элемент.Имя = "АС_ПоискКатегорий", "ОтборКатегории", "ОтборИерархия");
		АС_ПоследниеПоискиКатегорийГрупп.Удалить(ИмяДерева);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_ПоискВДеревеОкончаниеВводаТекста(
	Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	// Принимаем поисковый текст как строку, чтобы платформа не показывала «не найдено».
	ДанныеВыбора = Новый СписокЗначений;
	ДанныеВыбора.Добавить(Текст);
	ЭтотОбъект[Элемент.Имя] = Текст;
	АС_НайтиСледующийУзелДерева(Элемент);

КонецПроцедуры

&НаКлиенте
Процедура АС_НайтиСледующийУзелДерева(ЭлементПоиска)

	Если ЭлементПоиска.Имя = "АС_ПоискКатегорий" Тогда
		ИмяДерева = "ОтборКатегории";
	ИначеЕсли ЭлементПоиска.Имя = "АС_ПоискГрупп" Тогда
		ИмяДерева = "ОтборИерархия";
	Иначе
		Возврат;
	КонецЕсли;

	ТекстПоиска = НРег(СокрЛП(ЭтотОбъект[ЭлементПоиска.Имя]));
	ТекстПоиска = СтрЗаменить(ТекстПоиска, Символ(160), " ");
	СловаПоиска = СтрРазделить(ТекстПоиска, " " + Символы.Таб + Символы.ПС + Символы.ВК, Ложь);
	Если СловаПоиска.Количество() = 0 Тогда
		Если АС_ПоследниеПоискиКатегорийГрупп <> Неопределено Тогда
			АС_ПоследниеПоискиКатегорийГрупп.Удалить(ИмяДерева);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	ТекстПоиска = СтрСоединить(СловаПоиска, " ");

	// Собираем актуальные идентификаторы: после записи папки дерево может обновиться.
	Совпадения = Новый Массив;
	ДеревоПоиска = ЭтотОбъект[ИмяДерева];
	АС_СобратьСовпаденияВДереве(ДеревоПоиска.ПолучитьЭлементы(), СловаПоиска, Совпадения);
	Если Совпадения.Количество() = 0 Тогда
		Сообщить(СтрШаблон("Категории или папки по запросу «%1» не найдены.",
			ЭтотОбъект[ЭлементПоиска.Имя]));
		Возврат;
	КонецЕсли;

	Если АС_ПоследниеПоискиКатегорийГрупп = Неопределено Тогда
		АС_ПоследниеПоискиКатегорийГрупп = Новый Соответствие;
	КонецЕсли;
	НомерСовпадения = 0;
	Если АС_ПоследниеПоискиКатегорийГрупп.Получить(ИмяДерева) = ТекстПоиска Тогда
		ТекущийНомер = Совпадения.Найти(Элементы[ИмяДерева].ТекущаяСтрока);
		Если ТекущийНомер <> Неопределено И ТекущийНомер + 1 < Совпадения.Количество() Тогда
			НомерСовпадения = ТекущийНомер + 1;
		КонецЕсли;
	КонецЕсли;
	АС_ПоследниеПоискиКатегорийГрупп.Вставить(ИмяДерева, ТекстПоиска);

	ИдентификаторСтроки = Совпадения[НомерСовпадения];
	СтрокаДерева = ДеревоПоиска.НайтиПоИдентификатору(ИдентификаторСтроки);
	Родители = Новый Массив;
	Родитель = СтрокаДерева.ПолучитьРодителя();
	Пока Родитель <> Неопределено Цикл
		Родители.Вставить(0, Родитель.ПолучитьИдентификатор());
		Родитель = Родитель.ПолучитьРодителя();
	КонецЦикла;
	Для Каждого ИдентификаторРодителя Из Родители Цикл
		Элементы[ИмяДерева].Развернуть(ИдентификаторРодителя);
	КонецЦикла;

	Элементы[ИмяДерева].ТекущаяСтрока = ИдентификаторСтроки;
	Если ИмяДерева = "ОтборКатегории" Тогда
		ОтборКатегорииПриАктивизацииСтроки(Неопределено);
	Иначе
		ОтборИерархияПриАктивизацииСтроки(Неопределено);
	КонецЕсли;

	// Штатный выбор категории переводит фокус в дерево. Возвращаем его в поиск.
	ТекущийЭлемент = ЭлементПоиска;

КонецПроцедуры

&НаКлиенте
Процедура АС_СобратьСовпаденияВДереве(СтрокиДерева, СловаПоиска, Совпадения)

	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		Если ЗначениеЗаполнено(СтрокаДерева.Значение)
			И АС_НазваниеУзлаСодержитСлова(СтрокаДерева.Представление, СловаПоиска) Тогда
			Совпадения.Добавить(СтрокаДерева.ПолучитьИдентификатор());
		КонецЕсли;
		АС_СобратьСовпаденияВДереве(СтрокаДерева.ПолучитьЭлементы(), СловаПоиска, Совпадения);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция АС_НазваниеУзлаСодержитСлова(Представление, СловаПоиска)

	Если СловаПоиска.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	НаименованиеУзла = НРег(Строка(Представление));
	// Все части запроса должны встречаться в названии, порядок не важен.
	Для Каждого СловоПоиска Из СловаПоиска Цикл
		Если СтрНайти(НаименованиеУзла, СловоПоиска) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

