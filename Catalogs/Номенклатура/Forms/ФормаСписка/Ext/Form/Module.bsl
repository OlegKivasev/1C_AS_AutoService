&НаКлиенте
Процедура АС_ОбновитьСписокЗапасов(Команда)

	АС_СброситьКэшOEMАналогов();
	АС_ПрименитьОтборПоАвтомобилю();
	Элементы.СписокЗапасы.Обновить();
	АС_ОбновитьКоличествоВсехСтрокСпискаЗапасов();

КонецПроцедуры

&НаКлиенте
&После("ОбработкаОповещения")
Процедура АС_ОбработкаОповещенияПосле(ИмяСобытия, Параметр, Источник)

	Если Лев(ИмяСобытия, 7) = "Запись_"
		Или ИмяСобытия = "АС_Запись_ПриходнаяНакладная"
		Или ИмяСобытия = "АС_Запись_ЗаказПоставщикуБезЗаказа" Тогда
		АС_АктуализироватьСписокЗапасовПослеЗаписи(ИмяСобытия, Параметр);
		Возврат;
	КонецЕсли;

	Если ИмяСобытия <> "АС_ИзмененыНастройкиИндикацииОстатков" Тогда
		Возврат;
	КонецЕсли;

	АС_ПерестроитьОформлениеЗаканчивающихсяТоваров();
	Элементы.СписокЗапасы.Обновить();

КонецПроцедуры

&НаКлиенте
Процедура АС_АктуализироватьСписокЗапасовПослеЗаписи(ИмяСобытия, Параметр)

	Если ИмяСобытия = "Запись_Номенклатура" Тогда
		АС_СброситьКэшOEMАналогов();
	КонецЕсли;

	Если ИмяСобытия = "Запись_Файл" Тогда
		Если ТипЗнч(Параметр) = Тип("Структура") Тогда
			Если Параметр.Свойство("ВладелецФайла") Тогда
				Если ТипЗнч(Параметр.ВладелецФайла) <> Тип("СправочникСсылка.Номенклатура") Тогда
					Возврат;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	АС_ПрименитьОтборПоАвтомобилю();
	Элементы.СписокЗапасы.Обновить();
	АС_ОбновитьКоличествоВсехСтрокСпискаЗапасов();

	Если ТекущаяСтраницаНоменклатуры <> "СписокЗапасы" Тогда
		Возврат;
	КонецЕсли;

	Если ИмяСобытия = "Запись_Номенклатура" Тогда
		ТекущиеДанные = Элементы.СписокЗапасы.ТекущиеДанные;
		Если ТекущиеДанные <> Неопределено
			И ТекущиеДанные.Ссылка = Параметр Тогда
			ОбновитьДанныеПоНоменклатуреКлиент();
		КонецЕсли;
	ИначеЕсли ИмяСобытия = "Запись_Файл" Тогда
		ОбновитьПанель = Истина;
		Если ТипЗнч(Параметр) = Тип("Структура") Тогда
			Если Параметр.Свойство("ВладелецФайла") Тогда
				ТекущиеДанные = Элементы.СписокЗапасы.ТекущиеДанные;
				ОбновитьПанель = ТекущиеДанные <> Неопределено
					И ТекущиеДанные.Ссылка = Параметр.ВладелецФайла;
			КонецЕсли;
		КонецЕсли;
		Если ОбновитьПанель Тогда
			ОбновитьДанныеПоНоменклатуреКлиент();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&Перед("СписокЗапасыВыбор")
Процедура АС_СписокЗапасыВыборПеред(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Если Поле = Неопределено Или Поле.Имя <> "АС_КПоступлению" Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.СписокЗапасы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено
		Или Не ЗначениеЗаполнено(ТекущиеДанные.Ссылка)
		Или ТекущиеДанные.АС_КПоступлению <= 0 Тогда
		Возврат;
	КонецЕсли;

	ПараметрыПоступления = Новый Структура;
	ПараметрыПоступления.Вставить("Номенклатура", ТекущиеДанные.Ссылка);
	ПараметрыПоступления.Вставить("Характеристика",
		ПредопределенноеЗначение("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка"));
	ПараметрыПоступления.Вставить("ОтборПоХарактеристике", Ложь);
	ПараметрыПоступления.Вставить("Организация", ОтборОрганизация);
	ПараметрыПоступления.Вставить("ЕдиницаИзмерения", ТекущиеДанные.ЕдиницаИзмерения);
	СписокДокументов = СписокДокументовПоНоменклатуре("Поступления", ПараметрыПоступления);
	Если СписокДокументов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ПараметрыОповещения = Новый Структура("ВыбранноеПоле", "Поступления");
	Оповещение = Новый ОписаниеОповещения(
		"ПослеВыбораИзВыпадающегоСпискаТабличнойЧасти", ЭтотОбъект, ПараметрыОповещения);
	ПоказатьВыборИзМеню(Оповещение, СписокДокументов, Элемент.ТекущийЭлемент);

КонецПроцедуры

&НаКлиенте
&После("СписокЗапасыПриАктивизацииСтроки")
Процедура АС_СписокЗапасыПриАктивизацииСтрокиПосле(Элемент)

	АС_ЗапланироватьОбновлениеOEMАналогов();

КонецПроцедуры

&НаКлиенте
Процедура АС_ЗапланироватьОбновлениеOEMАналогов()

	ОтключитьОбработчикОжидания("АС_ОбновитьOEMАналогиКлиент");
	Если ТекущаяСтраницаНоменклатуры <> "СписокЗапасы" Тогда
		Возврат;
	КонецЕсли;
	ТекущиеДанные = Элементы.СписокЗапасы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено
		Или Не ТекущиеДанные.Свойство("Ссылка") Тогда
		АС_НоменклатураOEMАналогов = Неопределено;
		АС_НадписьOEMАналоги = "OEM не указан";
		Возврат;
	КонецЕсли;
	Если АС_НоменклатураOEMАналогов = ТекущиеДанные.Ссылка Тогда
		АС_НадписьOEMАналоги = АС_ПодписьOEMАналогов;
		Возврат;
	КонецЕсли;
	АС_НадписьOEMАналоги = "Аналоги по OEM";
	ПодключитьОбработчикОжидания("АС_ОбновитьOEMАналогиКлиент", 0.5, Истина);

КонецПроцедуры

&НаКлиенте
Процедура АС_ОбновитьOEMАналогиКлиент()

	Если ТекущаяСтраницаНоменклатуры <> "СписокЗапасы" Тогда
		Возврат;
	КонецЕсли;
	ТекущиеДанные = Элементы.СписокЗапасы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено
		Или Не ТекущиеДанные.Свойство("Ссылка")
		Или Не ЗначениеЗаполнено(ТекущиеДанные.Ссылка) Тогда
		АС_НоменклатураOEMАналогов = Неопределено;
		АС_НадписьOEMАналоги = "OEM не указан";
		Возврат;
	КонецЕсли;
	Если АС_НоменклатураOEMАналогов = ТекущиеДанные.Ссылка Тогда
		Возврат;
	КонецЕсли;
	Если АС_КэшOEMАналогов = Неопределено Тогда
		АС_КэшOEMАналогов = Новый Соответствие;
	КонецЕсли;
	Информация = АС_КэшOEMАналогов.Получить(ТекущиеДанные.Ссылка);
	Если Информация = Неопределено Тогда
		Информация = АС_СостояниеOEMАналоговНаСервере(ТекущиеДанные.Ссылка);
		// Ограничиваем память формы. Не кэшируем еще не построенный индекс.
		Если Информация.ИндексГотов Тогда
			Если АС_КэшOEMАналогов.Количество() >= 100 Тогда
				АС_КэшOEMАналогов.Очистить();
			КонецЕсли;
			АС_КэшOEMАналогов.Вставить(ТекущиеДанные.Ссылка, Информация);
		КонецЕсли;
	КонецЕсли;
	АС_НоменклатураOEMАналогов = ТекущиеДанные.Ссылка;
	Если Не Информация.ИндексГотов Тогда
		АС_НадписьOEMАналоги = "Аналоги по OEM — открыть";
	ИначеЕсли Не Информация.ЕстьКлючиOEM Тогда
		АС_НадписьOEMАналоги = "OEM не указан";
	ИначеЕсли Не Информация.ЕстьАналоги Тогда
		АС_НадписьOEMАналоги = "Аналоги по OEM не найдены";
	Иначе
		АС_НадписьOEMАналоги = "Аналоги по OEM — открыть";
	КонецЕсли;
	АС_ПодписьOEMАналогов = АС_НадписьOEMАналоги;

КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_СостояниеOEMАналоговНаСервере(Номенклатура)

	Возврат АС_НоменклатураСервер.СостояниеOEMАналогов(Номенклатура);

КонецФункции

&НаКлиенте
Процедура АС_СброситьКэшOEMАналогов()

	АС_КэшOEMАналогов = Новый Соответствие;
	АС_НоменклатураOEMАналогов = Неопределено;
	АС_ЗапланироватьОбновлениеOEMАналогов();

КонецПроцедуры

&НаКлиенте
&После("ПриЗакрытии")
Процедура АС_ПриЗакрытииПосле(ЗавершениеРаботы)

	ОтключитьОбработчикОжидания("АС_ОбновитьOEMАналогиКлиент");
	ОтключитьОбработчикОжидания("АС_ПрименитьОтборOEMСЗадержкой");

КонецПроцедуры

&НаКлиенте
Процедура АС_OEMАналогиНажатие(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.СписокЗапасы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено
		Или Не ТекущиеДанные.Свойство("Ссылка")
		Или Не ЗначениеЗаполнено(ТекущиеДанные.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	// Открываем список сразу, без повторной проверки и подсчета аналогов.
	ОтключитьОбработчикОжидания("АС_ОбновитьOEMАналогиКлиент");
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("Номенклатура", ТекущиеДанные.Ссылка);
	СкладОстатков = ?(ОтборОстатки = 1, ОтборСклад, Неопределено);
	ПараметрыОткрытия.Вставить("Склад", СкладОстатков);
	ОповещениеЗакрытия = Новый ОписаниеОповещения("АС_OEMАналогиЗакрыты", ЭтотОбъект);
	ОткрытьФорму(
		"ОбщаяФорма.АС_OEMАналоги",
		ПараметрыОткрытия,
		ЭтотОбъект, , , , ОповещениеЗакрытия,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура АС_OEMАналогиЗакрыты(Результат, ДополнительныеПараметры) Экспорт

	АС_СброситьКэшOEMАналогов();
	Если АС_ЕстьАналоги Тогда
		АС_ПрименитьОтборПоАвтомобилю();
		Элементы.СписокЗапасы.Обновить();
		АС_ОбновитьКоличествоВсехСтрокСпискаЗапасов();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&Вместо("СтрокаРасширенногоПоискаПриИзменении")
Процедура АС_СтрокаРасширенногоПоискаПриИзменении(Элемент)

	// Непустой текст ищем при окончании ввода (Enter), а не при потере фокуса.
	Если ПустаяСтрока(АС_СтрокаПоискаАртикула) Тогда
		АС_СброситьПоискПоАртикулу();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_СтрокаПоискаАртикулаИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)

	// При наборе и частичном удалении текста сервер не вызывается.
	Если ПустаяСтрока(Текст) Тогда
		АС_СброситьПоискПоАртикулу();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_СтрокаПоискаАртикулаОкончаниеВводаТекста(
	Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	АС_СтрокаПоискаАртикула = Текст;
	Если ПустаяСтрока(Текст) Тогда
		АС_СброситьПоискПоАртикулу();
		Возврат;
	КонецЕсли;

	АС_ПрименитьПоискПоАртикулуНаСервере();
	АС_ПоискПоАртикулуПрименен = Истина;
	АС_ОбновитьКоличествоВсехСтрокСпискаЗапасов();

КонецПроцедуры

&НаКлиенте
Процедура АС_СтрокаПоискаАртикулаОчистка(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	АС_СброситьПоискПоАртикулу();

КонецПроцедуры

&НаКлиенте
Процедура АС_СброситьПоискПоАртикулу()

	АС_СтрокаПоискаАртикула = "";
	// Очистка может породить несколько событий поля: снимаем отбор один раз.
	Если АС_ПоискПоАртикулуПрименен = Истина Тогда
		АС_ПрименитьПоискПоАртикулуНаСервере();
		АС_ПоискПоАртикулуПрименен = Ложь;
		АС_ОбновитьКоличествоВсехСтрокСпискаЗапасов();
	КонецЕсли;

КонецПроцедуры

&НаСервере
&После("УстановитьВидимостьИДоступность")
Процедура АС_УстановитьВидимостьИДоступностьПосле(ЭтоСозданиеФормы = Ложь)

	Если ОтборОстатки = 3 Или ОтборОстатки = 4 Тогда
		ОтборОстатки = 0;
	КонецЕсли;

	Если Элементы.Найти("АС_ОстатокСУчетомЗаказов") <> Неопределено Тогда
		Элементы.АС_ОстатокСУчетомЗаказов.Видимость =
			ТекущаяСтраницаНоменклатуры = "СписокЗапасы" И ПоказыватьОстатки;
	КонецЕсли;
	Если Элементы.Найти("АС_КПоступлению") <> Неопределено Тогда
		Элементы.АС_КПоступлению.Видимость =
			ТекущаяСтраницаНоменклатуры = "СписокЗапасы" И ПоказыватьОстатки;
	КонецЕсли;

	Элементы.СтрокаРасширенногоПоиска.Видимость = Истина;
	Элементы.СписокЗапасыСтандартныйПоиск.Видимость = Ложь;
	Элементы.ЗапасыУправлениеПоиском.Видимость = Ложь;

КонецПроцедуры

&НаСервере
&После("ПереопределитьТекстЗапросаСписокЗапасы")
Процедура АС_ПереопределитьТекстЗапросаСписокЗапасыПосле()

	ТекстЗапроса = СписокЗапасы.ТекстЗапроса;
	ПредставлениеОбычногоОстатка =
		"ЕСТЬNULL(ОстаткиТоваров.Количество, 0) КАК КоличествоОстаток";
	Если СтрНайти(ТекстЗапроса, ПредставлениеОбычногоОстатка) = 0 Тогда
		ТекстЗапроса = СтрЗаменить(
			ТекстЗапроса,
			"0 КАК КоличествоОстаток",
			"0 КАК КоличествоОстаток," + Символы.ПС
			+ "    0 КАК АС_ОстатокСУчетомЗаказов," + Символы.ПС
			+ "    0 КАК АС_КПоступлению");
		СписокЗапасы.ТекстЗапроса = ТекстЗапроса;
		Возврат;
	КонецЕсли;

	ВыражениеДоступногоОстатка =
		"ЕСТЬNULL(ОстаткиТоваров.Количество, 0)"
		+ " + ЕСТЬNULL(ОстаткиТоваров.Резерв, 0)"
		+ " - ЕСТЬNULL(АС_АктивныеЗаказы.Количество, 0)";
	ВыражениеКолонки =
		"ВЫБОР КОГДА " + ВыражениеДоступногоОстатка + " > 0" + Символы.ПС
		+ "        ТОГДА " + ВыражениеДоступногоОстатка + Символы.ПС
		+ "    ИНАЧЕ 0 КОНЕЦ КАК АС_ОстатокСУчетомЗаказов";
	ВыражениеКПоступлению =
		"ЕСТЬNULL(АС_КПоступлению.Количество, 0) КАК АС_КПоступлению";

	ТекстЗапроса = СтрЗаменить(
		ТекстЗапроса,
		ПредставлениеОбычногоОстатка,
		ПредставлениеОбычногоОстатка + "," + Символы.ПС + "    "
		+ ВыражениеКолонки + "," + Символы.ПС + "    " + ВыражениеКПоступлению);

	ТекстЗапроса = СтрЗаменить(
		ТекстЗапроса,
		"ПО СправочникНоменклатура.Ссылка = ОстаткиТоваров.Номенклатура",
		"ПО СправочникНоменклатура.Ссылка = ОстаткиТоваров.Номенклатура" + Символы.ПС
		+ "        ЛЕВОЕ СОЕДИНЕНИЕ АС_АктивныеЗаказы КАК АС_АктивныеЗаказы" + Символы.ПС
		+ "        ПО СправочникНоменклатура.Ссылка = АС_АктивныеЗаказы.Номенклатура" + Символы.ПС
		+ "        ЛЕВОЕ СОЕДИНЕНИЕ АС_КПоступлению КАК АС_КПоступлению" + Символы.ПС
		+ "        ПО СправочникНоменклатура.Ссылка = АС_КПоступлению.Номенклатура");

	ВТКПоступлению =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|    ЗаказыПоставщикамОстатки.Номенклатура КАК Номенклатура,
	|    СУММА(ЗаказыПоставщикамОстатки.КоличествоОстаток
	|        - ЕСТЬNULL(РазмещениеЗаказовОстатки.КоличествоОстаток, 0)) КАК Количество
	|ПОМЕСТИТЬ АС_КПоступлению
	|ИЗ
	|    РегистрНакопления.ЗаказыПоставщикам.Остатки(
	|            ,
	|            (&ВсеОрганизации ИЛИ Организация В (&Организация))) КАК ЗаказыПоставщикамОстатки
	|        ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РазмещениеЗаказов.Остатки(
	|                ,
	|                (&ВсеОрганизации ИЛИ Организация В (&Организация))) КАК РазмещениеЗаказовОстатки
	|        ПО ЗаказыПоставщикамОстатки.Организация = РазмещениеЗаказовОстатки.Организация
	|            И ЗаказыПоставщикамОстатки.ЗаказПоставщику = РазмещениеЗаказовОстатки.ИсточникОбеспечения
	|            И ЗаказыПоставщикамОстатки.Номенклатура = РазмещениеЗаказовОстатки.Номенклатура
	|            И ЗаказыПоставщикамОстатки.Характеристика = РазмещениеЗаказовОстатки.Характеристика
	|ГДЕ
	|    ЗаказыПоставщикамОстатки.КоличествоОстаток
	|        - ЕСТЬNULL(РазмещениеЗаказовОстатки.КоличествоОстаток, 0) > 0
	|СГРУППИРОВАТЬ ПО
	|    ЗаказыПоставщикамОстатки.Номенклатура
	|;

	|////////////////////////////////////////////////////////////////////////////////
	|";

	ВТАктивныеЗаказы =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|    ЗаказыПокупателейОстатки.Номенклатура КАК Номенклатура,
	|    СУММА(ЗаказыПокупателейОстатки.КоличествоОстаток) КАК Количество
	|ПОМЕСТИТЬ АС_АктивныеЗаказы
	|ИЗ
	|    РегистрНакопления.ЗаказыПокупателей.Остатки(
	|            ,
	|            (&ВсеСклады ИЛИ Склад В (&Склад))
	|                И (&ВсеОрганизации ИЛИ Организация В (&Организация))
	|                И (&БезОтбора ИЛИ Характеристика В (&Характеристика))) КАК ЗаказыПокупателейОстатки
	|ГДЕ
	|    ЗаказыПокупателейОстатки.КоличествоОстаток > 0
	|СГРУППИРОВАТЬ ПО
	|    ЗаказыПокупателейОстатки.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|";

	СписокЗапасы.ТекстЗапроса = ВТКПоступлению + ВТАктивныеЗаказы + ТекстЗапроса;

КонецПроцедуры

&НаСервере
&После("ПриСозданииНаСервере")
Процедура АС_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)

	Для НомерВарианта = 3 По 4 Цикл
		ВариантОтбора = Элементы.ОтборОстатки.СписокВыбора.НайтиПоЗначению(НомерВарианта);
		Если ВариантОтбора <> Неопределено Тогда
			Элементы.ОтборОстатки.СписокВыбора.Удалить(ВариантОтбора);
		КонецЕсли;
	КонецЦикла;
	Если ОтборОстатки = 3 Или ОтборОстатки = 4 Тогда
		ОтборОстатки = 0;
	КонецЕсли;

	ИмяКолонки = "АС_ОстатокСУчетомЗаказов";
	Если Элементы.Найти(ИмяКолонки) = Неопределено Тогда
		Колонка = Элементы.Добавить(ИмяКолонки, Тип("ПолеФормы"), Элементы.СписокЗапасы);
		Колонка.Вид = ВидПоляФормы.ПолеВвода;
		Колонка.ПутьКДанным = "СписокЗапасы.АС_ОстатокСУчетомЗаказов";
		Колонка.Заголовок = "С учетом" + Символы.ПС + "заказов";
		Колонка.Подсказка = "Физический остаток за вычетом товаров в активных заказах покупателей и заказ-нарядах";
		Колонка.ТолькоПросмотр = Истина;
		Колонка.Ширина = 9;
		Колонка.Формат = "ЧН=0; ЧДЦ=3";
		Колонка.Видимость = ПоказыватьОстатки;
		Элементы.Переместить(Колонка, Элементы.СписокЗапасы, Элементы.КартинкаОстатки);
	КонецЕсли;

	ИмяКолонкиКПоступлению = "АС_КПоступлению";
	Если Элементы.Найти(ИмяКолонкиКПоступлению) = Неопределено Тогда
		Колонка = Элементы.Добавить(ИмяКолонкиКПоступлению, Тип("ПолеФормы"), Элементы.СписокЗапасы);
		Колонка.Вид = ВидПоляФормы.ПолеНадписи;
		Колонка.ПутьКДанным = "СписокЗапасы.АС_КПоступлению";
		Колонка.Заголовок = "К поступлению";
		Колонка.Подсказка = "Заказы поставщикам, по которым товар ожидается к поступлению";
		Колонка.Гиперссылка = Истина;
		Колонка.ГиперссылкаЯчейки = Истина;
		Колонка.Ширина = 9;
		Колонка.Формат = "ЧН=0; ЧДЦ=3";
		Колонка.Видимость = ПоказыватьОстатки;
		Элементы.Переместить(Колонка, Элементы.СписокЗапасы, Элементы.КартинкаОстатки);
	КонецЕсли;

	АС_ПерестроитьОформлениеЗаканчивающихсяТоваров();

	// Нулевой остаток у номенклатуры без записи в регистре штатная форма
	// показывает пустым. Сохраняем числовое значение для сортировки, но скрываем
	// его текст и не показываем нули для услуг и работ.
	АС_ДобавитьСкрытиеТекстаКолонкиПоПолю(
		ИмяКолонки,
		"СписокЗапасы.КоличествоОстаток",
		0,
		ВидСравненияКомпоновкиДанных.Равно);
	АС_ДобавитьСкрытиеТекстаКолонкиПоПолю(
		ИмяКолонки,
		"СписокЗапасы.ТипНоменклатуры",
		Перечисления.ТипыНоменклатуры.Запас,
		ВидСравненияКомпоновкиДанных.НеРавно);

	// Поступление показываем, если оно действительно есть. Нулевое значение
	// оставляем только для запаса с отображаемым остатком.
	АС_ДобавитьСкрытиеТекстаКолонкиПоДвумПолям(
		ИмяКолонкиКПоступлению,
		"СписокЗапасы.КоличествоОстаток",
		0,
		ВидСравненияКомпоновкиДанных.Равно,
		"СписокЗапасы.АС_КПоступлению",
		0,
		ВидСравненияКомпоновкиДанных.Равно);
	АС_ДобавитьСкрытиеТекстаКолонкиПоПолю(
		ИмяКолонкиКПоступлению,
		"СписокЗапасы.ТипНоменклатуры",
		Перечисления.ТипыНоменклатуры.Запас,
		ВидСравненияКомпоновкиДанных.НеРавно);

КонецПроцедуры

&НаСервере
Процедура АС_ПерестроитьОформлениеЗаканчивающихсяТоваров()

	УдаляемыеЭлементы = Новый Массив;
	Для Каждого ЭлементОформления Из УсловноеОформление.Элементы Цикл
		Если ЭлементОформления.ИдентификаторПользовательскойНастройки =
			"АС_ДинамическаяИндикацияОстатков" Тогда
			УдаляемыеЭлементы.Добавить(ЭлементОформления);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ЭлементОформления Из УдаляемыеЭлементы Цикл
		УсловноеОформление.Элементы.Удалить(ЭлементОформления);
	КонецЦикла;

	НастройкиОформления = АС_ИндикацияОстатковСервер.НастройкиОформления();
	Для Каждого ПравилоОформления Из НастройкиОформления.Правила Цикл
		АС_ДобавитьОформлениеЗаканчивающегосяТовара(
			"АС_ОстатокСУчетомЗаказов",
			ПравилоОформления.ВерхняяГраница,
			ПравилоОформления.НижняяГраница,
			ПравилоОформления.ЦветФона,
			ПравилоОформления.Номенклатура,
			НастройкиОформления.ИсключенияОбщейИндикации);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура АС_ДобавитьОформлениеЗаканчивающегосяТовара(
	ИмяКолонки, ВерхняяГраница, НижняяГраница, ЦветФона,
	Номенклатура, ИсключенияОбщейИндикации)

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементОформления.ИдентификаторПользовательскойНастройки =
		"АС_ДинамическаяИндикацияОстатков";
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
		ЭлементОформления.Отбор,
		"СписокЗапасы.АС_ОстатокСУчетомЗаказов",
		ВерхняяГраница,
		ВидСравненияКомпоновкиДанных.МеньшеИлиРавно);
	Если НижняяГраница <> Неопределено Тогда
		РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
			ЭлементОформления.Отбор,
			"СписокЗапасы.АС_ОстатокСУчетомЗаказов",
			НижняяГраница,
			ВидСравненияКомпоновкиДанных.Больше);
	КонецЕсли;
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
			ЭлементОформления.Отбор,
			"СписокЗапасы.Номенклатура",
			Номенклатура);
	ИначеЕсли ИсключенияОбщейИндикации.Количество() > 0 Тогда
		РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
			ЭлементОформления.Отбор,
			"СписокЗапасы.Номенклатура",
			ИсключенияОбщейИндикации,
			ВидСравненияКомпоновкиДанных.НеВСписке);
	КонецЕсли;
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
		ЭлементОформления.Отбор,
		"СписокЗапасы.ТипНоменклатуры",
		Перечисления.ТипыНоменклатуры.Запас);
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
		ЭлементОформления.Отбор,
		"СписокЗапасы.КоличествоОстаток",
		0,
		ВидСравненияКомпоновкиДанных.Больше);
	РаботаСФормой.ДобавитьОформляемоеПоле(ЭлементОформления, ИмяКолонки);
	РаботаСФормой.ДобавитьЭлементУсловногоОформления(
		ЭлементОформления, "ЦветФона", ЦветФона);

КонецПроцедуры

&НаСервере
Процедура АС_ДобавитьСкрытиеТекстаКолонкиПоПолю(
	ИмяКолонки, ИмяПоля, ЗначениеПоля, ВидСравнения)

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
		ЭлементОформления.Отбор,
		ИмяПоля,
		ЗначениеПоля,
		ВидСравнения);
	РаботаСФормой.ДобавитьОформляемоеПоле(ЭлементОформления, ИмяКолонки);
	РаботаСФормой.ДобавитьЭлементУсловногоОформления(
		ЭлементОформления, "Текст", "");

КонецПроцедуры

&НаСервере
Процедура АС_ДобавитьСкрытиеТекстаКолонкиПоДвумПолям(
	ИмяКолонки,
	ИмяПоля1, ЗначениеПоля1, ВидСравнения1,
	ИмяПоля2, ЗначениеПоля2, ВидСравнения2)

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
		ЭлементОформления.Отбор,
		ИмяПоля1,
		ЗначениеПоля1,
		ВидСравнения1);
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
		ЭлементОформления.Отбор,
		ИмяПоля2,
		ЗначениеПоля2,
		ВидСравнения2);
	РаботаСФормой.ДобавитьОформляемоеПоле(ЭлементОформления, ИмяКолонки);
	РаботаСФормой.ДобавитьЭлементУсловногоОформления(
		ЭлементОформления, "Текст", "");

КонецПроцедуры

&НаСервере
Процедура АС_ПрименитьПоискПоАртикулуНаСервере()

	Если ПустаяСтрока(СокрЛП(АС_СтрокаПоискаАртикула)) Тогда
		ПодборПоискНеУдачный = Ложь;
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
			ЭтотОбъект[ТекущаяСтраницаНоменклатуры], "Номенклатура", , , , Ложь);
		Возврат;
	КонецЕсли;

	ИсходнаяСтрокаПоиска = СтрокаРасширенногоПоиска;
	ИсходныйРежимПоиска = НастройкиПоискаКакИскать;
	СтрокаРасширенногоПоиска = АС_СтрокаПоискаАртикула;
	НастройкиПоискаКакИскать = 1;

	Попытка
		ПоискПоПодстроке();
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		СтрокаРасширенногоПоиска = ИсходнаяСтрокаПоиска;
		НастройкиПоискаКакИскать = ИсходныйРежимПоиска;
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;

	СтрокаРасширенногоПоиска = ИсходнаяСтрокаПоиска;
	НастройкиПоискаКакИскать = ИсходныйРежимПоиска;

КонецПроцедуры

&НаСервере
&Вместо("РезультатПоискаПоПодстроке")
Функция АС_РезультатПоискаПоПодстроке(СтрокаРасширенногоПоиска)
	
	МассивНоменклатуры = ПродолжитьВызов(СтрокаРасширенногоПоиска);
	ВариантыСинонимов = АС_СинонимыПоискаСервер.ВариантыСтрокиПоиска(СтрокаРасширенногоПоиска);
	Если ВариантыСинонимов.Количество() > 1 Тогда
		НайденнаяНоменклатура = АС_СинонимыПоискаСервер.НайтиНоменклатуруПоВариантам(ВариантыСинонимов);
		Для Каждого Номенклатура Из НайденнаяНоменклатура Цикл
			Если МассивНоменклатуры.Найти(Номенклатура) = Неопределено Тогда
				МассивНоменклатуры.Добавить(Номенклатура);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	АС_ДополнитьРезультатПоискаПоТочкамИЗапятым(
		МассивНоменклатуры, СтрокаРасширенногоПоиска);
	АС_ДополнитьРезультатПоискаПоОтдельнымСловам(
		МассивНоменклатуры, СтрокаРасширенногоПоиска);
	КлючАртикула = АС_НоменклатураСервер.КомпактныйКлючАртикула(СтрокаРасширенногоПоиска);
	
	Если ПустаяСтрока(КлючАртикула) Тогда
		Возврат МассивНоменклатуры;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("КлючАртикула", "%" + КлючАртикула + "%");
	Запрос.УстановитьПараметр("МассивНоменклатуры", МассивНоменклатуры);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	| 	Номенклатура.Ссылка КАК Номенклатура
	|ИЗ
	| 	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	| 	НЕ Номенклатура.Ссылка В (&МассивНоменклатуры)
	| 	И Номенклатура.АС_АртикулДляПоиска ПОДОБНО &КлючАртикула";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МассивНоменклатуры.Добавить(Выборка.Номенклатура);
	КонецЦикла;
	
	Возврат МассивНоменклатуры;
	
КонецФункции

&НаСервере
Процедура АС_ДополнитьРезультатПоискаПоТочкамИЗапятым(МассивНоменклатуры, СтрокаПоиска)

	Если СтрНайти(СтрокаПоиска, ".") = 0
		И СтрНайти(СтрокаПоиска, ",") = 0 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивНоменклатуры", МассивНоменклатуры);
	Запрос.УстановитьПараметр(
		"СтрокаПоиска", АС_ШаблонПоискаСУчетомРазделителя(СтрокаПоиска));
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	| 	Номенклатура.Ссылка КАК Номенклатура
	|ИЗ
	| 	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	| 	НЕ Номенклатура.Ссылка В (&МассивНоменклатуры)
	| 	И (Номенклатура.Наименование ПОДОБНО &СтрокаПоиска
	| 		ИЛИ Номенклатура.НаименованиеПолное ПОДОБНО &СтрокаПоиска)";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МассивНоменклатуры.Добавить(Выборка.Номенклатура);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура АС_ДополнитьРезультатПоискаПоОтдельнымСловам(МассивНоменклатуры, СтрокаПоиска)

	СтрокаПоиска = СтрЗаменить(СтрокаПоиска, Символы.Таб, " ");
	СтрокаПоиска = СтрЗаменить(СтрокаПоиска, Символы.ВК, " ");
	СтрокаПоиска = СтрЗаменить(СтрокаПоиска, Символы.ПС, " ");
	ЧастиПоиска = СтрРазделить(СокрЛП(СтрокаПоиска), " ", Ложь);
	Если ЧастиПоиска.Количество() < 2 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивНоменклатуры", МассивНоменклатуры);
	УсловияПоискаПоНаименованию = Новый Массив;
	УсловияПоискаПоПолномуНаименованию = Новый Массив;
	Для Индекс = 0 По ЧастиПоиска.ВГраница() Цикл
		ИмяПараметра = "ЧастьПоиска" + Строка(Индекс);
		Запрос.УстановитьПараметр(
			ИмяПараметра, АС_ШаблонПоискаСУчетомРазделителя(ЧастиПоиска[Индекс]));
		УсловияПоискаПоНаименованию.Добавить(
			"Номенклатура.Наименование ПОДОБНО &" + ИмяПараметра);
		УсловияПоискаПоПолномуНаименованию.Добавить(
			"Номенклатура.НаименованиеПолное ПОДОБНО &" + ИмяПараметра);
	КонецЦикла;

	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	| 	Номенклатура.Ссылка КАК Номенклатура
	|ИЗ
	| 	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	| 	НЕ Номенклатура.ЭтоГруппа
	| 	И НЕ Номенклатура.Ссылка В (&МассивНоменклатуры)
	| 	И (" + СтрСоединить(УсловияПоискаПоНаименованию, " И ")
		+ " ИЛИ " + СтрСоединить(УсловияПоискаПоПолномуНаименованию, " И ") + ")";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МассивНоменклатуры.Добавить(Выборка.Номенклатура);
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_ШаблонПоискаСУчетомРазделителя(СтрокаПоиска)

	ШаблонПоиска = "";
	Для Позиция = 1 По СтрДлина(СтрокаПоиска) Цикл
		СимволСтроки = Сред(СтрокаПоиска, Позиция, 1);
		Если СимволСтроки = "." Или СимволСтроки = "," Тогда
			ШаблонПоиска = ШаблонПоиска + "[.,]";
		Иначе
			ШаблонПоиска = ШаблонПоиска + СимволСтроки;
		КонецЕсли;
	КонецЦикла;

	Возврат "%" + ШаблонПоиска + "%";

КонецФункции

&НаКлиенте
Процедура АС_БезДокументовПриИзменении(Элемент)

	Если АС_БезДокументов И АС_ОтборДокументы <> 1 И АС_ОтборДокументы <> 2 Тогда
		АС_ОтборДокументы = 2;
	ИначеЕсли Не АС_БезДокументов Тогда
		АС_ОтборДокументы = Неопределено;
	КонецЕсли;
	АС_УстановитьВидимостьОтборовИзображенияИДокументов();
	АС_ПрименитьОтборПоАвтомобилю();
	АС_ОбновитьКоличествоВсехСтрокСпискаЗапасов();

КонецПроцедуры

&НаКлиенте
Процедура АС_ОтборOEMИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)

	// Значение храним сразу, а текст и позицию курсора оставляем редактору поля.
	СтандартнаяОбработка = Ложь;
	Элемент.ОбновлениеТекстаРедактирования = ОбновлениеТекстаРедактирования.НеИспользовать;
	АС_ОтборOEM = Текст;
	АС_ТекстОтбораOEM = Текст;
	ОтключитьОбработчикОжидания("АС_ПрименитьОтборOEMСЗадержкой");
	ПодключитьОбработчикОжидания("АС_ПрименитьОтборOEMСЗадержкой", 0.4, Истина);

КонецПроцедуры

&НаКлиенте
Процедура АС_ПрименитьОтборOEMСЗадержкой()

	ОтключитьОбработчикОжидания("АС_ПрименитьОтборOEMСЗадержкой");
	// Поиск использует сохранённый текст и не обновляет редактор поля.
	АС_ПрименитьОтборOEMКлиент(АС_ТекстОтбораOEM);

КонецПроцедуры

