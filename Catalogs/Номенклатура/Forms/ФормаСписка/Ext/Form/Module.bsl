Функция АС_СтруктураДанныхКритерияОтбора(ПутьКДанным)

	СтруктураДанных = Новый Структура;
	ИменаПолей = Новый Массив;
	ИменаПолей.Добавить("ТипОбъекта");
	ИменаПолей.Добавить("ВидОбъекта");
	ИменаПолей.Добавить("ПутьКДанным");
	ИменаПолей.Добавить("ИмяТаблЧасти");
	ИменаПолей.Добавить("ИмяРеквизита");

	Для Индекс = 1 По 3 Цикл
		ПозицияТочки = СтрНайти(ПутьКДанным, ".");
		ТекущееЗначение = Лев(ПутьКДанным, ПозицияТочки - 1);
		СтруктураДанных.Вставить(ИменаПолей[Индекс - 1], ТекущееЗначение);
		ПутьКДанным = Сред(ПутьКДанным, ПозицияТочки + 1);
	КонецЦикла;

	ПутьКДанным = СтрЗаменить(ПутьКДанным, "Реквизит.", "");
	Если СтруктураДанных.ПутьКДанным = "ТабличнаяЧасть" Тогда
		Для Индекс = 4 По 5 Цикл
			ПозицияТочки = СтрНайти(ПутьКДанным, ".");
			Если ПозицияТочки = 0 Тогда
				ТекущееЗначение = ПутьКДанным;
			Иначе
				ТекущееЗначение = Лев(ПутьКДанным, ПозицияТочки - 1);
			КонецЕсли;
			СтруктураДанных.Вставить(ИменаПолей[Индекс - 1], ТекущееЗначение);
			ПутьКДанным = Сред(ПутьКДанным, ПозицияТочки + 1);
		КонецЦикла;
	Иначе
		СтруктураДанных.Вставить("ИмяТаблЧасти", "");
		СтруктураДанных.Вставить("ИмяРеквизита", ПутьКДанным);
	КонецЕсли;

	СтруктураДанных.Вставить("Метаданные", Метаданные.Документы[СтруктураДанных.ВидОбъекта]);
	Возврат СтруктураДанных;

КонецФункции

&НаКлиенте
&После("ПриОткрытии")
Процедура АС_ПриОткрытииПосле(Отказ)

	АС_БезопасноеОбновлениеКлиент.НастроитьЗащитуРедакторов(ЭтотОбъект);
	АС_ОбновитьРежимОстатковПоПродажам();
	Если Не РежимВыбора И Не ЭтоПодбор Тогда
		АС_ПоступившиеЗаПериод = Истина;
		АС_НазначениеПоступления = 1;
		ДатаСеанса = ОбщегоНазначенияКлиент.ДатаСеанса();
		АС_ДатаПоступленияС = НачалоДня(ДатаСеанса);
		АС_ДатаПоступленияПо = КонецДня(ДатаСеанса);
	КонецЕсли;
	АС_ЗаполнитьПериодПоступленийПоУмолчанию();
	АС_ЗаполнитьПериодПродажПоУмолчанию();
	АС_УстановитьВидимостьПериодовТоварныхОтборов();
	АС_УстановитьВидимостьОтборовИзображенияИДокументов();
	АС_КоличествоВыделенныхСтрокСпискаЗапасов = 0;
	Если Не АС_ОтложитьФоновоеДействиеПриВводеПоиска("АС_ОбновитьСтатистикуВыделенияСпискаЗапасов") Тогда
		ПодключитьОбработчикОжидания("АС_ОбновитьСтатистикуВыделенияСпискаЗапасов", 1, Ложь);
		АС_ОбновитьСтатистикуВыделенияСпискаЗапасов();
	КонецЕсли;
	Если АС_ПоступившиеЗаПериод Или АС_ПроданныеЗаПериод Тогда
		АС_ЗапланироватьПрименениеТоварныхОтборов();
	Иначе
		АС_ОбновитьКоличествоВсехСтрокСпискаЗапасов();
	КонецЕсли;
	АС_ЗапуститьКонтрольИзмененияОстатков();
	Если АС_РекомендацииПоЗакупке Тогда
		АС_РекомендацииПоЗакупкеПриИзменении(Неопределено);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_ЗаполнитьПериодПоступленийПоУмолчанию()

	ДатаСеанса = ОбщегоНазначенияКлиент.ДатаСеанса();
	Если Не ЗначениеЗаполнено(АС_ДатаПоступленияС) Тогда
		АС_ДатаПоступленияС = НачалоДня(ДатаСеанса);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(АС_ДатаПоступленияПо) Тогда
		АС_ДатаПоступленияПо = КонецДня(ДатаСеанса);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_ЗаполнитьПериодПродажПоУмолчанию()

	ДатаСеанса = ОбщегоНазначенияКлиент.ДатаСеанса();
	Если Не ЗначениеЗаполнено(АС_ДатаПродажиС) Тогда
		АС_ДатаПродажиС = НачалоДня(ДатаСеанса - 7 * 24 * 60 * 60);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(АС_ДатаПродажиПо) Тогда
		АС_ДатаПродажиПо = КонецДня(ДатаСеанса);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_УстановитьВидимостьПериодовТоварныхОтборов()

	Элементы.АС_ПериодПоступления.Видимость = АС_ПоступившиеЗаПериод;
	Элементы.АС_НазначениеПоступления.Видимость = АС_ПоступившиеЗаПериод;
	Элементы.АС_ПериодПродаж.Видимость = АС_ПроданныеЗаПериод;
	Элементы.АС_ИсточникПродажи.Видимость = АС_ПроданныеЗаПериод;

КонецПроцедуры

&НаКлиенте
Процедура АС_УстановитьВидимостьОтборовИзображенияИДокументов()

	Элементы.АС_ОтборИзображение.Видимость = АС_БезФотографии;
	Элементы.АС_ОтборДокументы.Видимость = АС_БезДокументов;
	Элементы.АС_ОтборOEMАртикулы.Видимость = АС_OEMАртикулы;
	Элементы.АС_ОтборOEMАртикулыМарка.Видимость = АС_OEMАртикулы;
	Элементы.АС_ОтборЕстьАналоги.Видимость = АС_ЕстьАналоги;
	Элементы.АС_ОтборПрименяемость.Видимость = АС_Применяемость;

КонецПроцедуры

&НаКлиенте
&Перед("ПриЗакрытии")
Процедура АС_ПриЗакрытииПеред(ЗавершениеРаботы)

	ОтключитьОбработчикОжидания("АС_ЗапуститьРасчетЗакупки");

	ОтключитьОбработчикОжидания("АС_ОбновитьСтатистикуВыделенияСпискаЗапасов");
	ОтключитьОбработчикОжидания("АС_ПроверитьИзменениеОстатков");
	ОтключитьОбработчикОжидания("АС_ПрименитьТоварныеОтборыСЗадержкой");
	ОтключитьОбработчикОжидания("АС_ПересчитатьКоличествоВсехСтрокСпискаЗапасов");

КонецПроцедуры

&НаКлиенте
Процедура АС_ЗапуститьКонтрольИзмененияОстатков()

	Если АС_ОтложитьФоновоеДействиеПриВводеПоиска("АС_ПроверитьИзменениеОстатков") Тогда
		Возврат;
	КонецЕсли;
	АС_ПодписьИзмененийОстатков = АС_ПолучитьПодписьИзмененийОстатков();
	ПодключитьОбработчикОжидания("АС_ПроверитьИзменениеОстатков", 60, Истина);

КонецПроцедуры

&НаКлиенте
Процедура АС_ПроверитьИзменениеОстатков()

	Если АС_ОтложитьФоновоеДействиеПриВводеПоиска("АС_ПроверитьИзменениеОстатков") Тогда
		Возврат;
	КонецЕсли;

	ПодключитьОбработчикОжидания("АС_ПроверитьИзменениеОстатков", 60, Истина);
	Если ТекущаяСтраницаНоменклатуры <> "СписокЗапасы" Тогда
		Возврат;
	КонецЕсли;

	Если АС_РекомендацииПоЗакупке И АС_ЗакупкаВыполняется <> Истина Тогда
		Если Не ЗначениеЗаполнено(АС_СледующаяПроверкаЗакупки)
			Или ОбщегоНазначенияКлиент.ДатаСеанса() >= АС_СледующаяПроверкаЗакупки Тогда
			АС_ЗапроситьПересчетЗакупки();
		КонецЕсли;
	КонецЕсли;

	НоваяПодпись = АС_ПолучитьПодписьИзмененийОстатков();
	Если НоваяПодпись = АС_ПодписьИзмененийОстатков Тогда
		Возврат;
	КонецЕсли;

	АС_ПодписьИзмененийОстатков = НоваяПодпись;
	АС_АктуализироватьСписокЗапасовПослеЗаписи("АС_ИзменениеОстатков", Неопределено);

КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_ПолучитьПодписьИзмененийОстатков()

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ОстаткиТоваров.Номенклатура КАК Номенклатура,
		|	ЕСТЬNULL(СУММА(ОстаткиТоваров.Количество), 0) КАК Количество,
		|	ЕСТЬNULL(СУММА(ОстаткиТоваров.Резерв), 0) КАК Резерв
		|ИЗ
		|	РегистрСведений.ОстаткиТоваров КАК ОстаткиТоваров
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиТоваров.Номенклатура
		|УПОРЯДОЧИТЬ ПО
		|	ОстаткиТоваров.Номенклатура");
	Выборка = Запрос.Выполнить().Выбрать();
	СтрокиДляХэша = Новый Массив;
	Пока Выборка.Следующий() Цикл
		СтрокиДляХэша.Добавить(ЗначениеВСтрокуВнутр(Выборка.Номенклатура) + "|" + Строка(Выборка.Количество)
			+ "|" + Строка(Выборка.Резерв) );
	КонецЦикла;

	Возврат ОбщегоНазначенияИС.ХэшСуммаСтроки(СтрСоединить(СтрокиДляХэша, Символы.ПС));

КонецФункции

&НаКлиенте
Процедура АС_ОбновитьСтатистикуВыделенияСпискаЗапасов()

	Если АС_ОтложитьФоновоеДействиеПриВводеПоиска("АС_ОбновитьСтатистикуВыделенияСпискаЗапасов") Тогда
		Возврат;
	КонецЕсли;
	// Выделение проверяем только при работе с таблицей, без перезапуска таймера.
	Если ТекущаяСтраницаНоменклатуры <> "СписокЗапасы"
		Или ТекущийЭлемент <> Элементы.СписокЗапасы Тогда
		Возврат;
	КонецЕсли;

	КоличествоВыделенныхСтрок = Элементы.СписокЗапасы.ВыделенныеСтроки.Количество();
	Если АС_КоличествоВыделенныхСтрокСпискаЗапасов = КоличествоВыделенныхСтрок Тогда
		Возврат;
	КонецЕсли;
	АС_КоличествоВыделенныхСтрокСпискаЗапасов = КоличествоВыделенныхСтрок;
	АС_УстановитьТекстСтатистикиСпискаЗапасов();

КонецПроцедуры

&НаКлиенте
Процедура АС_ОбновитьКоличествоВсехСтрокСпискаЗапасов()

	Если ТекущаяСтраницаНоменклатуры <> "СписокЗапасы" Тогда
		Возврат;
	КонецЕсли;
	Если АС_ОтложитьФоновоеДействиеПриВводеПоиска("АС_ПересчитатьКоличествоВсехСтрокСпискаЗапасов") Тогда
		Возврат;
	КонецЕсли;
	ОтключитьОбработчикОжидания("АС_ПересчитатьКоличествоВсехСтрокСпискаЗапасов");
	ПодключитьОбработчикОжидания("АС_ПересчитатьКоличествоВсехСтрокСпискаЗапасов", 0.2, Истина);

КонецПроцедуры

&НаКлиенте
Процедура АС_ПересчитатьКоличествоВсехСтрокСпискаЗапасов()

	Если АС_ОтложитьФоновоеДействиеПриВводеПоиска("АС_ПересчитатьКоличествоВсехСтрокСпискаЗапасов") Тогда
		Возврат;
	КонецЕсли;
	АС_ОбновитьСчетчикиПослеЯвногоПоиска();

КонецПроцедуры

&НаКлиенте
Процедура АС_ОбновитьСчетчикиПослеЯвногоПоиска()

	ОтключитьОбработчикОжидания("АС_ПересчитатьКоличествоВсехСтрокСпискаЗапасов");
	Если АС_ОтложенныеДействияПослеПоиска <> Неопределено Тогда
		АС_ОтложенныеДействияПослеПоиска.Удалить("АС_ПересчитатьКоличествоВсехСтрокСпискаЗапасов");
	КонецЕсли;

	Если ТекущаяСтраницаНоменклатуры <> "СписокЗапасы" Тогда
		Возврат;
	КонецЕсли;
	АС_КоличествоВсехСтрокСпискаЗапасов = АС_ПолучитьКоличествоСтрокСпискаЗапасовНаСервере();
	АС_КоличествоВыделенныхСтрокСпискаЗапасов = Элементы.СписокЗапасы.ВыделенныеСтроки.Количество();
	АС_УстановитьТекстСтатистикиСпискаЗапасов();

КонецПроцедуры

&НаКлиенте
Процедура АС_УстановитьТекстСтатистикиСпискаЗапасов()

	Если АС_КоличествоВсехСтрокСпискаЗапасов = Неопределено Тогда
		Элементы.АС_СтатистикаСпискаЗапасов.Видимость = Ложь;
		Возврат;
	КонецЕсли;

	Элементы.АС_СтатистикаСпискаЗапасов.Видимость = Истина;
	АС_СтатистикаВыделенияСпискаЗапасов = "Всего строк: "
		+ Строка(АС_КоличествоВсехСтрокСпискаЗапасов);
	Если АС_КоличествоВыделенныхСтрокСпискаЗапасов > 0 Тогда
		АС_СтатистикаВыделенияСпискаЗапасов = АС_СтатистикаВыделенияСпискаЗапасов
			+ "; Выделено: " + Строка(АС_КоличествоВыделенныхСтрокСпискаЗапасов);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция АС_ПолучитьКоличествоСтрокСпискаЗапасовНаСервере()

	Перем АС_СчетчикСхема, АС_СчетчикНастройки, АС_СчетчикПолеГруппы;
	Перем АС_СчетчикПолеКоличества, АС_СчетчикРесурс, АС_СчетчикГруппировка;
	Перем АС_СчетчикАвтовыборГруппы, АС_СчетчикПолеГруппировки, АС_СчетчикПолеВыбора;
	Перем АС_СчетчикКомпоновщикМакета, АС_СчетчикМакетКомпоновки, АС_СчетчикПроцессорКомпоновки;
	Перем АС_СчетчикРезультат, АС_СчетчикПроцессорВывода, АС_СчетчикКолонка;

	АС_СчетчикСхема = Элементы.СписокЗапасы.ПолучитьИсполняемуюСхемуКомпоновкиДанных();
	АС_СчетчикНастройки = Элементы.СписокЗапасы.ПолучитьИсполняемыеНастройкиКомпоновкиДанных();

	// Отборы, поисковые условия и параметры сохраняются. Вместо всех строк
	// выводим единственную группу с количеством записей списка.
	АС_СчетчикПолеГруппы = АС_СчетчикСхема.ВычисляемыеПоля.Добавить();
	АС_СчетчикПолеГруппы.ПутьКДанным = "АС_ПодсчетСтрокГруппа";
	АС_СчетчикПолеГруппы.Выражение = "1";
	АС_СчетчикПолеКоличества = АС_СчетчикСхема.ВычисляемыеПоля.Добавить();
	АС_СчетчикПолеКоличества.ПутьКДанным = "АС_ПодсчетСтрокКоличество";
	АС_СчетчикПолеКоличества.Выражение = "1";
	АС_СчетчикПолеКоличества.Заголовок = "АС_ПодсчетСтрокКоличество";
	АС_СчетчикРесурс = АС_СчетчикСхема.ПоляИтога.Добавить();
	АС_СчетчикРесурс.ПутьКДанным = "АС_ПодсчетСтрокКоличество";
	АС_СчетчикРесурс.Выражение = "Количество(Ссылка)";

	АС_СчетчикНастройки.Структура.Очистить();
	АС_СчетчикНастройки.Выбор.Элементы.Очистить();
	АС_СчетчикНастройки.Порядок.Элементы.Очистить();
	АС_СчетчикГруппировка = АС_СчетчикНастройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	АС_СчетчикГруппировка.Использование = Истина;
	АС_СчетчикАвтовыборГруппы = АС_СчетчикГруппировка.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	АС_СчетчикАвтовыборГруппы.Использование = Истина;
	АС_СчетчикПолеГруппировки = АС_СчетчикГруппировка.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
	АС_СчетчикПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных("АС_ПодсчетСтрокГруппа");
	АС_СчетчикПолеГруппировки.ТипГруппировки = ТипГруппировкиКомпоновкиДанных.Элементы;
	АС_СчетчикПолеГруппировки.Использование = Истина;
	АС_СчетчикПолеВыбора = АС_СчетчикНастройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	АС_СчетчикПолеВыбора.Поле = Новый ПолеКомпоновкиДанных("АС_ПодсчетСтрокКоличество");
	АС_СчетчикПолеВыбора.Использование = Истина;
	АС_СчетчикНастройки.ПараметрыВывода.УстановитьЗначениеПараметра(
		"ГоризонтальноеРасположениеОбщихИтогов", РасположениеИтоговКомпоновкиДанных.Нет);
	АС_СчетчикНастройки.ПараметрыВывода.УстановитьЗначениеПараметра(
		"ВертикальноеРасположениеОбщихИтогов", РасположениеИтоговКомпоновкиДанных.Нет);

	АС_СчетчикКомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных();
	АС_СчетчикМакетКомпоновки = АС_СчетчикКомпоновщикМакета.Выполнить(
		АС_СчетчикСхема, АС_СчетчикНастройки,,, Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	АС_СчетчикПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	АС_СчетчикПроцессорКомпоновки.Инициализировать(АС_СчетчикМакетКомпоновки);
	АС_СчетчикРезультат = Новый ТаблицаЗначений;
	АС_СчетчикПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	АС_СчетчикПроцессорВывода.УстановитьОбъект(АС_СчетчикРезультат);
	АС_СчетчикПроцессорВывода.Вывести(АС_СчетчикПроцессорКомпоновки);
	Если АС_СчетчикРезультат.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Для Каждого АС_СчетчикКолонка Из АС_СчетчикРезультат.Колонки Цикл
		Если АС_СчетчикКолонка.Имя = "АС_ПодсчетСтрокКоличество"
			Или АС_СчетчикКолонка.Заголовок = "АС_ПодсчетСтрокКоличество" Тогда
			Возврат АС_СчетчикРезультат[0][АС_СчетчикКолонка.Имя];
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

&НаКлиенте
&После("ПоказыватьЦеныПриИзменении")
Процедура АС_ПоказыватьЦеныПриИзмененииПосле(Элемент)

	АС_ОбновитьКоличествоВсехСтрокСпискаЗапасов();

КонецПроцедуры

&НаКлиенте
&После("ПоказыватьОстаткиПриИзменении")
Процедура АС_ПоказыватьОстаткиПриИзмененииПосле(Элемент)

	АС_ОбновитьКоличествоВсехСтрокСпискаЗапасов();

КонецПроцедуры

&НаКлиенте
&После("ОтборОстаткиПриИзменении")
Процедура АС_ОтборОстаткиПриИзмененииПосле(Элемент)

	Если АС_РекомендацииПоЗакупке И ОтборОстатки <> 0 Тогда
		АС_ОбновитьРежимОстатковПоПродажам();
	КонецЕсли;

	АС_ОбновитьКоличествоВсехСтрокСпискаЗапасов();

КонецПроцедуры

&НаКлиенте
&После("ОтборХарактеристикаПриИзменении")
Процедура АС_ОтборХарактеристикаПриИзмененииПосле(Элемент)

	АС_ОбновитьКоличествоВсехСтрокСпискаЗапасов();

КонецПроцедуры

&НаКлиенте
