&НаСервере
Процедура АС_ДобавитьКолонкуЗакупки()

	Колонка = Элементы.Добавить("АС_КоличествоКЗакупке", Тип("ПолеФормы"), Элементы.СписокЗапасы);
	Колонка.Вид = ВидПоляФормы.ПолеВвода;
	Колонка.ПутьКДанным = "СписокЗапасы.АС_КоличествоКЗакупке";
	Колонка.Заголовок = "Количество к закупке";
	Колонка.Подсказка = "Рекомендованная закупка по всем областям учёта, как в карточке товара";
	Колонка.ТолькоПросмотр = Истина;
	Колонка.Ширина = 12;
	Колонка.Формат = "ЧДЦ=0; ЧН=0; ЧГ=";
	Колонка.Видимость = Ложь;
	// Значение вычисляется запросом до разбиения на страницы: обычная
	// сортировка заголовком работает для всего отобранного списка.
	Поля = Новый Массив;
	Поля.Добавить("АС_КоличествоКЗакупке");
	СписокЗапасы.УстановитьОграниченияИспользованияВОтборе(Поля);
	СписокЗапасы.УстановитьОграниченияИспользованияВГруппировке(Поля);

КонецПроцедуры

&НаКлиенте
Процедура АС_РекомендацииПоЗакупкеПриИзменении(Элемент)

	Если АС_РекомендацииПоЗакупке Тогда
		АС_УстановитьКолонкиЗакупки();
	КонецЕсли;
	АС_ОбновитьРежимОстатковПоПродажам();
	Если АС_РекомендацииПоЗакупке Тогда
		// Даже если в форме остались старые служебные отборы наличия,
		// пересоздаём их из режима «Все», включая нулевые остатки.
		ОтборОстаткиПриИзменении(Элементы.ОтборОстатки);
		АС_ТоварыКЗакупке = Новый Массив;
		Если АС_КэшЗакупки <> Неопределено Тогда
			Если Не АС_ПривязатьКэшЗакупки(АС_КэшЗакупки.АдресРезультата) Тогда
				АС_КэшЗакупки = Неопределено;
			КонецЕсли;
		КонецЕсли;
		Если АС_КэшЗакупки <> Неопределено Тогда
			АС_ТоварыКЗакупке = АС_КэшЗакупки.ТоварыКЗакупке;
			Элементы.АС_СостояниеЗакупки.Заголовок = АС_КэшЗакупки.Представление;
		КонецЕсли;
		Элементы.АС_СостояниеЗакупки.Видимость = Истина;
		АС_ОбновитьОтборЗакупки();
		Если АС_КэшЗакупки = Неопределено Или АС_ЗакупкаТребуетПересчета
			Или АС_КэшЗакупки.День <> НачалоДня(ОбщегоНазначенияКлиент.ДатаСеанса()) Тогда
			АС_ЗапроситьПересчетЗакупки();
		КонецЕсли;
	Иначе
		АС_ОтключитьРекомендацииПоЗакупке();
		АС_ОбновитьОтборЗакупки();
		// Уже запущенную работу не уничтожаем: результат останется в кэше.
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_ОбновитьОтборЗакупки()

	АС_ПрименитьОтборПоАвтомобилю();
	Элементы.СписокЗапасы.Обновить();
	АС_ОбновитьКоличествоВсехСтрокСпискаЗапасов();

КонецПроцедуры

&НаКлиенте
Процедура АС_УстановитьКолонкиЗакупки()

	Если АС_РекомендацииПоЗакупке И Не АС_ПроданныеЗаПериод Тогда
		Если АС_ВидимостьКолонокДоЗакупки = Неопределено Тогда
			АС_ВидимостьКолонокДоЗакупки = Новый Соответствие;
			АС_ЗаголовокДоЗакупки = Элементы.Наименование.Заголовок;
			Для Каждого Колонка Из Элементы.СписокЗапасы.ПодчиненныеЭлементы Цикл
				АС_ВидимостьКолонокДоЗакупки.Вставить(Колонка.Имя, Колонка.Видимость);
			КонецЦикла;
		КонецЕсли;
		Для Каждого Колонка Из Элементы.СписокЗапасы.ПодчиненныеЭлементы Цикл
			Колонка.Видимость = Колонка.Имя = "Наименование" Или Колонка.Имя = "АС_КоличествоКЗакупке";
		КонецЦикла;
		Элементы.Наименование.Заголовок = "Номенклатура";
	ИначеЕсли АС_ВидимостьКолонокДоЗакупки <> Неопределено Тогда
		Для Каждого Пара Из АС_ВидимостьКолонокДоЗакупки Цикл
			Элементы[Пара.Ключ].Видимость = Пара.Значение;
		КонецЦикла;
		Элементы.Наименование.Заголовок = АС_ЗаголовокДоЗакупки;
		АС_ВидимостьКолонокДоЗакупки = Неопределено;
	КонецЕсли;
	// В списке проданных сохраняем его колонки, добавляя только закупку.
	Элементы.АС_КоличествоКЗакупке.Видимость = АС_РекомендацииПоЗакупке;

КонецПроцедуры

&НаКлиенте
Процедура АС_ЗапроситьПересчетЗакупки(Принудительно = Ложь)

	АС_ЗакупкаТребуетПересчета = Истина;
	Если Принудительно Тогда
		АС_ЗакупкаПринудительно = Истина;
	КонецЕсли;
	Если Не АС_РекомендацииПоЗакупке Или АС_ЗакупкаВыполняется = Истина Тогда
		// Изменения объединяем. Идущий расчёт обязательно доходит до результата.
		Возврат;
	КонецЕсли;
	Если АС_КэшЗакупки = Неопределено Тогда
		Элементы.АС_СостояниеЗакупки.Заголовок = "Рассчитываются рекомендации по закупке…";
	КонецЕсли;
	Элементы.АС_СостояниеЗакупки.Видимость = Истина;
	ОтключитьОбработчикОжидания("АС_ЗапуститьРасчетЗакупки");
	ПодключитьОбработчикОжидания("АС_ЗапуститьРасчетЗакупки", 1, Истина);

КонецПроцедуры


&НаСервере
Функция АС_НачатьРасчетЗакупки(ПредыдущаяПодпись, ТоварыОтбора, КлючОбласти)

	Если АС_ПроданныеЗаПериод И ТоварыОтбора = Неопределено Тогда
		ВызватьИсключение "Не определён список проданных товаров для расчёта закупки";
	КонецЕсли;
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	Возврат ДлительныеОперации.ВыполнитьВФоне("АС_ПродажиНоменклатурыСервер.РассчитатьЗакупкуВФоне",
		Новый Структура("ПредыдущаяПодпись,ТоварыОтбора,КлючОбласти",
			ПредыдущаяПодпись, ТоварыОтбора, КлючОбласти), ПараметрыВыполнения);

КонецФункции




&НаСервере
Функция АС_ЗапросСПолемЗакупки(ТекстЗапроса, ПараметрыЗакупки)

	ПараметрыЗакупки = Новый Структура;
	Если СтрНайти(ТекстЗапроса, " КАК АС_КоличествоКЗакупке") > 0 Тогда
		Возврат ТекстЗапроса;
	КонецЕсли;
	Якорь = "ЛОЖЬ КАК ПрямойАналог,";
	Если СтрНайти(ТекстЗапроса, Якорь) = 0 Тогда
		ВызватьИсключение "Изменилась структура запроса списка номенклатуры";
	КонецЕсли;
	Выражение = АС_ВыражениеКоличестваЗакупки(ПараметрыЗакупки);
	Возврат СтрЗаменить(ТекстЗапроса, Якорь, Якорь + Символы.ПС
		+ "    " + Выражение + " КАК АС_КоличествоКЗакупке,");

КонецФункции

&НаСервере
Функция АС_ВыражениеКоличестваЗакупки(ПараметрыЗакупки)

	НулевоеКоличество = "ВЫРАЗИТЬ(0 КАК ЧИСЛО(15, 3))";
	Если Не АС_РекомендацииПоЗакупке Тогда
		Возврат НулевоеКоличество;
	КонецЕсли;
	Адрес = "";
	Свойства = СписокЗапасы.КомпоновщикНастроек.Настройки.ДополнительныеСвойства;
	Если Не Свойства.Свойство("АС_РасчетЗакупки", Адрес) Или ПустаяСтрока(Адрес) Тогда
		Возврат НулевоеКоличество;
	КонецЕсли;
	Расчет = ПолучитьИзВременногоХранилища(Адрес);
	Если ТипЗнч(Расчет) <> Тип("Структура") Тогда
		Возврат НулевоеКоличество;
	КонецЕсли;

	// Одно условие на количество, а не на каждый товар. Значения и ссылки
	// передаются параметрами; число ветвей зависит от разных количеств.
	ГруппыКоличества = Новый Соответствие;
	Для Каждого Пара Из Расчет.Результат Цикл
		Показатель = Пара.Значение;
		Если Не Показатель.Доступно Или Показатель.Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;
		ТоварыГруппы = ГруппыКоличества.Получить(Показатель.Количество);
		Если ТоварыГруппы = Неопределено Тогда
			ТоварыГруппы = Новый Массив;
			ГруппыКоличества.Вставить(Показатель.Количество, ТоварыГруппы);
		КонецЕсли;
		ТоварыГруппы.Добавить(Пара.Ключ);
	КонецЦикла;
	Если ГруппыКоличества.Количество() = 0 Тогда
		Возврат НулевоеКоличество;
	КонецЕсли;

	Выражение = "ВЫРАЗИТЬ(ВЫБОР";
	НомерГруппы = 0;
	Для Каждого Группа Из ГруппыКоличества Цикл
		НомерГруппы = НомерГруппы + 1;
		Суффикс = Формат(НомерГруппы, "ЧГ=; ЧДЦ=0");
		ПараметрТоваров = "АС_ТоварыЗакупки" + Суффикс;
		ПараметрКоличества = "АС_КоличествоЗакупки" + Суффикс;
		ПараметрыЗакупки.Вставить(ПараметрТоваров, Группа.Значение);
		ПараметрыЗакупки.Вставить(ПараметрКоличества, Группа.Ключ);
		Выражение = Выражение + Символы.ПС
			+ "        КОГДА СправочникНоменклатура.Ссылка В (&" + ПараметрТоваров + ")"
			+ " ТОГДА &" + ПараметрКоличества;
	КонецЦикла;
	Возврат Выражение + Символы.ПС + "        ИНАЧЕ 0 КОНЕЦ КАК ЧИСЛО(15, 3))";

КонецФункции

&НаСервере
Процедура АС_УстановитьПараметрыЗакупки(ПараметрыЗакупки)

	Для Каждого Параметр Из ПараметрыЗакупки Цикл
		УстановитьПараметрСписка(СписокЗапасы, Параметр.Ключ, Параметр.Значение);
	КонецЦикла;

КонецПроцедуры



&НаКлиенте
Процедура АС_ЗапуститьРасчетЗакупки()

	Если Не АС_РекомендацииПоЗакупке Или АС_ЗакупкаВыполняется = Истина Тогда
		Возврат;
	КонецЕсли;
	Если АС_ОтложитьФоновоеДействиеПриВводеПоиска("АС_ЗапуститьРасчетЗакупки") Тогда
		Возврат;
	КонецЕсли;
	Если АС_ПроданныеЗаПериод Тогда
		// Перед фоновой проверкой актуализируем именно действующий список продаж.
		АС_ПрименитьОтборПоАвтомобилю();
		ОтключитьОбработчикОжидания("АС_ЗапуститьРасчетЗакупки");
	КонецЕсли;
	ПредыдущаяПодпись = "";
	Если АС_КэшЗакупки <> Неопределено И АС_ЗакупкаПринудительно <> Истина Тогда
		ПредыдущаяПодпись = АС_КэшЗакупки.Подпись;
	КонецЕсли;
	АС_ЗакупкаВыполняется = Истина;
	АС_ЗакупкаТребуетПересчета = Ложь;
	АС_ЗакупкаПринудительно = Ложь;
	Попытка
		Операция = АС_НачатьРасчетЗакупки(ПредыдущаяПодпись,
			АС_ТоварыДляРасчетаЗакупки, АС_КлючОбластиЗакупки);
		Ожидание = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		Ожидание.ВыводитьОкноОжидания = Ложь;
		Ожидание.ОтменятьПриЗакрытииФормыВладельца = Истина;
		ДлительныеОперацииКлиент.ОжидатьЗавершение(Операция,
			Новый ОписаниеОповещения("АС_РасчетЗакупкиЗавершен", ЭтотОбъект, АС_КлючОбластиЗакупки), Ожидание);
	Исключение
		АС_ЗакупкаВыполняется = Ложь;
		АС_ЗакупкаТребуетПересчета = Истина;
		Элементы.АС_СостояниеЗакупки.Заголовок = "Не удалось запустить расчёт закупки: " + ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура АС_РасчетЗакупкиЗавершен(Результат, ДополнительныеПараметры) Экспорт

	Если Не ЭтотОбъект.Открыта() Тогда
		Возврат;
	КонецЕсли;
	АС_ЗакупкаВыполняется = Ложь;
	Если ДополнительныеПараметры <> АС_КлючОбластиЗакупки Тогда
		// Пользователь сменил период, источник или состав отбора за время работы.
		// Результат прежнего набора не подменяет действующий список.
		Если Результат <> Неопределено Тогда
			Если Результат.Статус = "Выполнено" Тогда
				АС_УдалитьРезультатЗакупки(Результат.АдресРезультата);
			КонецЕсли;
		КонецЕсли;
		АС_ЗапроситьПересчетЗакупки();
		Возврат;
	КонецЕсли;
	АС_СледующаяПроверкаЗакупки = ОбщегоНазначенияКлиент.ДатаСеанса() + 300;
	Если Результат = Неопределено Тогда
		АС_ЗакупкаТребуетПересчета = Истина;
		Элементы.АС_СостояниеЗакупки.Заголовок = "Расчёт закупки отменён";
		Возврат;
	КонецЕсли;
	Если Результат.Статус <> "Выполнено" Тогда
		АС_ЗакупкаТребуетПересчета = Истина;
		Элементы.АС_СостояниеЗакупки.Заголовок = "Рекомендации не рассчитаны: "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(Результат.ИнформацияОбОшибке);
		Возврат;
	КонецЕсли;
	Попытка
		Итог = АС_ПринятьРезультатЗакупки(Результат.АдресРезультата);
	Исключение
		АС_ЗакупкаТребуетПересчета = Истина;
		Элементы.АС_СостояниеЗакупки.Заголовок = "Не удалось получить рекомендации: " + ОписаниеОшибки();
		Возврат;
	КонецПопытки;
	Если Не Итог.БезИзменений Тогда
		АС_КэшЗакупки = Итог;
		Если АС_РекомендацииПоЗакупке Тогда
			АС_ТоварыКЗакупке = Итог.ТоварыКЗакупке;
			АС_ОбновитьОтборЗакупки();
		КонецЕсли;
	КонецЕсли;
	Если АС_КэшЗакупки <> Неопределено Тогда
		Элементы.АС_СостояниеЗакупки.Заголовок = АС_КэшЗакупки.Представление;
	КонецЕсли;
	Если АС_РекомендацииПоЗакупке И АС_ЗакупкаТребуетПересчета Тогда
		// Сначала публикуем результат. События за время работы вызывают одну
		// проверку подписи; неизменившиеся данные не запускают штатную СКД.
		ПодключитьОбработчикОжидания("АС_ЗапуститьРасчетЗакупки", 10, Истина);
	КонецЕсли;

КонецПроцедуры


&НаСервере
Функция АС_ПринятьРезультатЗакупки(Адрес)

	Расчет = ПолучитьИзВременногоХранилища(Адрес);
	Если ТипЗнч(Расчет) <> Тип("Структура") Тогда
		ВызватьИсключение "Результат фонового расчёта недоступен";
	КонецЕсли;
	Если Расчет.БезИзменений Тогда
		УдалитьИзВременногоХранилища(Адрес);
		Возврат Новый Структура("БезИзменений", Истина);
	КонецЕсли;
	Итог = Новый Структура("БезИзменений,ТоварыКЗакупке,Подпись,День,Представление,АдресРезультата",
		Ложь, Новый Массив, Расчет.Подпись, НачалоДня(Расчет.ДатаРасчета), "", Адрес);
	Итог.Вставить("КлючОбласти", Расчет.КлючОбласти);
	Ошибки = 0;
	ПерваяОшибка = "";
	Для Каждого Пара Из Расчет.Результат Цикл
		Если Не Пара.Значение.Доступно Тогда
			Ошибки = Ошибки + 1;
			Если ПустаяСтрока(ПерваяОшибка) Тогда
				ПерваяОшибка = Пара.Значение.Сообщение;
			КонецЕсли;
		ИначеЕсли Пара.Значение.Количество > 0 Тогда
			Итог.ТоварыКЗакупке.Добавить(Пара.Ключ);
		КонецЕсли;
	КонецЦикла;
	Итог.Представление = "К закупке: " + Строка(Итог.ТоварыКЗакупке.Количество())
		+ " товаров. Обновлено: " + Формат(Расчет.ДатаРасчета, "ДФ=HH:mm:ss");
	Если Ошибки > 0 Тогда
		Итог.Представление = Итог.Представление + ". Не рассчитано: " + Строка(Ошибки) + ". " + ПерваяОшибка;
	КонецЕсли;
	Свойства = СписокЗапасы.КомпоновщикНастроек.Настройки.ДополнительныеСвойства;
	ПредыдущийАдрес = "";
	Свойства.Свойство("АС_РасчетЗакупки", ПредыдущийАдрес);
	Если АС_РекомендацииПоЗакупке Тогда
		Свойства.Вставить("АС_РасчетЗакупки", Адрес);
		АС_ОбновитьЗапросКоличестваЗакупки();
	КонецЕсли;
	Если Не ПустаяСтрока(ПредыдущийАдрес) И ПредыдущийАдрес <> Адрес Тогда
		УдалитьИзВременногоХранилища(ПредыдущийАдрес);
	КонецЕсли;
	Возврат Итог;

КонецФункции

&НаСервере
Функция АС_ПривязатьКэшЗакупки(Адрес)

	Попытка
		Расчет = ПолучитьИзВременногоХранилища(Адрес);
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Если ТипЗнч(Расчет) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	СписокЗапасы.КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("АС_РасчетЗакупки", Адрес);
	АС_ОбновитьЗапросКоличестваЗакупки();
	Возврат Истина;

КонецФункции


&НаСервере
Процедура АС_ОчиститьРасчетЗакупки()

	Свойства = СписокЗапасы.КомпоновщикНастроек.Настройки.ДополнительныеСвойства;
	Адрес = "";
	Если Свойства.Свойство("АС_РасчетЗакупки", Адрес) Тогда
		Свойства.Удалить("АС_РасчетЗакупки");
		Если Не ПустаяСтрока(Адрес) Тогда
			УдалитьИзВременногоХранилища(Адрес);
		КонецЕсли;
	КонецЕсли;

	АС_ОбновитьЗапросКоличестваЗакупки();

КонецПроцедуры

&НаСервереБезКонтекста
Процедура АС_УдалитьРезультатЗакупки(Адрес)

	УдалитьИзВременногоХранилища(Адрес);

КонецПроцедуры

&НаКлиенте
Процедура АС_ОтключитьРекомендацииПоЗакупке()

	АС_РекомендацииПоЗакупке = Ложь;
	ОтключитьОбработчикОжидания("АС_ЗапуститьРасчетЗакупки");
	Если АС_ОтложенныеДействияПослеПоиска <> Неопределено Тогда
		АС_ОтложенныеДействияПослеПоиска.Удалить("АС_ЗапуститьРасчетЗакупки");
	КонецЕсли;
	АС_ОтвязатьКоличествоЗакупки();
	АС_ТоварыКЗакупке = Неопределено;
	Элементы.АС_СостояниеЗакупки.Видимость = Ложь;
	АС_УстановитьКолонкиЗакупки();
	// Текущий расчёт может завершиться в кэш, но новый запуск уже запрещён.

КонецПроцедуры

&НаСервере
Процедура АС_ОтвязатьКоличествоЗакупки()

	// Кэш сохраняем для повторного включения. Из текущего запроса убираем
	// значения до восстановления штатного режима остатков.
	СписокЗапасы.КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Удалить("АС_РасчетЗакупки");
	АС_ОбновитьЗапросКоличестваЗакупки();

КонецПроцедуры

&НаСервере
Процедура АС_ОбновитьЗапросКоличестваЗакупки()

	ПереопределитьТекстЗапросаСписокЗапасы();
	// Как в штатной перестройке: после запроса восстанавливаем параметры
	// склада, организации, характеристик, вида цен и даты среза.
	УстановитьПараметрыЗапросовСписков();

КонецПроцедуры
