		Возврат;
	КонецЕсли;
	ПродолжитьВызов();

КонецПроцедуры

&НаКлиенте
&Вместо("ОбновлениеИндексаПолнотекстовогоПоискаДанных")
Процедура АС_ОбновлениеИндексаПолнотекстовогоПоискаДанныхПриВводеПоиска()

	Если АС_ОтложитьФоновоеДействиеПриВводеПоиска("ОбновлениеИндексаПолнотекстовогоПоискаДанных") Тогда
		Возврат;
	КонецЕсли;
