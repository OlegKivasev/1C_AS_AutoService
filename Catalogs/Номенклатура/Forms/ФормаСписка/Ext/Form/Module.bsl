&НаКлиенте
Процедура АС_ОбновитьСписокЗапасов(Команда)

	АС_ЗапроситьПересчетЗакупки(Истина);

	АС_СброситьКэшOEMАналогов();
	АС_ОбновитьКлючЗапросаОстатковНаСервере();
	АС_ПрименитьОтборПоАвтомобилю();
	Элементы.СписокЗапасы.Обновить();
	АС_ОбновитьКоличествоВсехСтрокСпискаЗапасов();

КонецПроцедуры

&НаКлиенте
&Вместо("ОбработкаОповещения")
Процедура АС_ОбработкаОповещенияВместо(ИмяСобытия, Параметр, Источник)

	// Оборудование обрабатывается штатно и ровно один раз, даже при фокусе в поиске.
	Если Источник = "ПодключаемоеОборудование" Тогда
		АС_БезопасноеОбновлениеКлиент.ОтметитьСканирование(АС_СостояниеФоновогоОбновления);
		ПредыдущееСканирование = АС_ОбрабатываетсяСканирование;
		АС_ОбрабатываетсяСканирование = Истина;
		Попытка
			ПродолжитьВызов(ИмяСобытия, Параметр, Источник);
		Исключение
			АС_ОбрабатываетсяСканирование = ПредыдущееСканирование;
			ВызватьИсключение;
		КонецПопытки;
		АС_ОбрабатываетсяСканирование = ПредыдущееСканирование;
		Возврат;
	КонецЕсли;

	Если АС_ФоновоеОповещениеСписка(ИмяСобытия) И АС_ВыполняетсяПакетОповещений <> Истина Тогда
		Если АС_ОтложенныеОповещенияПриВводеПоиска = Неопределено Тогда
			АС_ОтложенныеОповещенияПриВводеПоиска = Новый Соответствие;
		КонецЕсли;
		// Для панели важны актуальные данные, а не воспроизведение каждой записи.
		АС_ОтложенныеОповещенияПриВводеПоиска.Вставить(ИмяСобытия,
			Новый Структура("ИмяСобытия,Параметр,Источник", ИмяСобытия, Параметр, Источник));
		ОтключитьОбработчикОжидания("АС_ОбработатьОтложенныеОповещенияПоиска");
		ПодключитьОбработчикОжидания("АС_ОбработатьОтложенныеОповещенияПоиска", 1, Истина);
		Возврат;
	КонецЕсли;

	ПродолжитьВызов(ИмяСобытия, Параметр, Источник);
	Если АС_ВыполняетсяПакетОповещений = Истина Тогда
		Возврат;
	КонецЕсли;

	Если Лев(ИмяСобытия, 7) = "Запись_"
		Или ИмяСобытия = "ИзменениеСостояния_ЗаказПокупателя"
		Или ИмяСобытия = "ИзменениеСостояния_ЗаказНаряд"
		Или ИмяСобытия = "АС_Запись_ПриходнаяНакладная"
		Или ИмяСобытия = "АС_Запись_ЗаказПоставщикуБезЗаказа"
		Или ИмяСобытия = "ОбновитьФормуСпискаДокументовЧекККМ"
		Или ИмяСобытия = "АС_ИзмененыПродажиЧекамиККМ" Тогда
		АС_АктуализироватьСписокЗапасовПослеЗаписи(ИмяСобытия, Параметр);
		Возврат;
	КонецЕсли;

	Если ИмяСобытия <> "АС_ИзмененыНастройкиИндикацииОстатков" Тогда
		Возврат;
	КонецЕсли;

	АС_ПерестроитьОформлениеЗаканчивающихсяТоваров();
	Элементы.СписокЗапасы.Обновить();

КонецПроцедуры

&НаКлиенте
Процедура АС_АктуализироватьСписокЗапасовПослеЗаписи(ИмяСобытия, Параметр)

	АС_ЗапроситьПересчетЗакупки();

	Если ИмяСобытия = "Запись_Номенклатура" Тогда
		АС_СброситьКэшOEMАналогов();
	КонецЕсли;

	Если ИмяСобытия = "Запись_Файл" Тогда
		Если ТипЗнч(Параметр) = Тип("Структура") Тогда
			Если Параметр.Свойство("ВладелецФайла") Тогда
				Если ТипЗнч(Параметр.ВладелецФайла) <> Тип("СправочникСсылка.Номенклатура") Тогда
					Возврат;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	АС_ОбновитьКлючЗапросаОстатковНаСервере();
	// При обычном изменении остатка не трогаем уже установленный поиск.
	Если АС_ЕстьАктивныеТоварныеОтборы() Тогда
		АС_ПрименитьОтборПоАвтомобилю();
	КонецЕсли;
	Элементы.СписокЗапасы.Обновить();
	АС_ОбновитьКоличествоВсехСтрокСпискаЗапасов();

	Если ТекущаяСтраницаНоменклатуры <> "СписокЗапасы" Тогда
		Возврат;
	КонецЕсли;

	Если ИмяСобытия = "Запись_Номенклатура" Тогда
		ТекущиеДанные = Элементы.СписокЗапасы.ТекущиеДанные;
		Если ТекущиеДанные <> Неопределено
			И ТекущиеДанные.Ссылка = Параметр Тогда
			ОбновитьДанныеПоНоменклатуреКлиент();
		КонецЕсли;
	ИначеЕсли ИмяСобытия = "Запись_Файл" Тогда
		ОбновитьПанель = Истина;
		Если ТипЗнч(Параметр) = Тип("Структура") Тогда
			Если Параметр.Свойство("ВладелецФайла") Тогда
				ТекущиеДанные = Элементы.СписокЗапасы.ТекущиеДанные;
				ОбновитьПанель = ТекущиеДанные <> Неопределено
					И ТекущиеДанные.Ссылка = Параметр.ВладелецФайла;
			КонецЕсли;
		КонецЕсли;
		Если ОбновитьПанель Тогда
			ОбновитьДанныеПоНоменклатуреКлиент();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&Вместо("СписокЗапасыВыбор")
Процедура АС_СписокЗапасыВыборКПоступлению(
	Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Если Поле = Неопределено Тогда
		ПродолжитьВызов(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка);
		Возврат;
	КонецЕсли;
	Если Поле.Имя <> "АС_КПоступлению"
		И Поле.Имя <> "АС_КПоступлениюЗамены" Тогда
		ПродолжитьВызов(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка);
		Возврат;
	КонецЕсли;

	// Не вызываем штатное добавление товара в корзину по числам.
	СтандартнаяОбработка = Ложь;
	ДанныеПоступления = Элемент.ДанныеСтроки(ВыбраннаяСтрока);
	Если ДанныеПоступления = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДанныеПоступления.Ссылка)
		Или ДанныеПоступления.ТипНоменклатуры <>
			ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Запас") Тогда
		Возврат;
	КонецЕсли;

	Если Поле.Имя = "АС_КПоступлениюЗамены" Тогда
		Если Окр(ДанныеПоступления.АС_КПоступлениюЗамены, 0) <= 0 Тогда
			Возврат;
		КонецЕсли;
		Заказы = АС_ПолучитьЗаказыКПоступлениюЗаменыДляСписка(
			ДанныеПоступления.Ссылка, ДанныеПоступления.ЕдиницаИзмерения);
	Иначе
		Если Окр(ДанныеПоступления.АС_КПоступлению, 0) <= 0 Тогда
			Возврат;
		КонецЕсли;
		Заказы = АС_ПродажиНоменклатурыСервер.ПолучитьЗаказыКПоступлению(
			ДанныеПоступления.Ссылка, ДанныеПоступления.ЕдиницаИзмерения);
	КонецЕсли;
	Если Заказы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ОповещениеОВыборе = Новый ОписаниеОповещения("АС_ЗаказКПоступлениюВыбран", ЭтотОбъект);
	ПоказатьВыборИзСписка(ОповещениеОВыборе, Заказы, Элемент);

КонецПроцедуры

&НаСервере
Функция АС_ПолучитьЗаказыКПоступлениюЗаменыДляСписка(Номенклатура, ЕдиницаИзмерения)

	Возврат АС_ПродажиНоменклатурыСервер.ПолучитьЗаказыКПоступлениюВзаимозаменяемых(
		Номенклатура, ЕдиницаИзмерения);

КонецФункции

&НаКлиенте
Процедура АС_ЗаказКПоступлениюВыбран(РезультатВыбора, ДополнительныеПараметры) Экспорт
	Если РезультатВыбора <> Неопределено Тогда
		ПоказатьЗначение(Неопределено, РезультатВыбора.Значение);
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Процедура АС_ЗаполнитьПредставлениеКПоступлениюПослеПолученияДанных(
	ИмяЭлемента, Настройки, Строки)

	НоменклатурыБезЗамены = Новый Массив;
	Для Каждого КлючИСтрока Из Строки Цикл
		ДанныеСтроки = КлючИСтрока.Значение.Данные;
		Если Не ДанныеСтроки.Свойство("Ссылка")
			Или Не ДанныеСтроки.Свойство("АС_КПоступлениюЗамены") Тогда
			Продолжить;
		КонецЕсли;
		Если ДанныеСтроки.АС_КПоступлениюЗамены = 0
			И ЗначениеЗаполнено(ДанныеСтроки.Ссылка) Тогда
			НоменклатурыБезЗамены.Добавить(ДанныеСтроки.Ссылка);
		КонецЕсли;
	КонецЦикла;

	СвязанныеНоменклатуры = Новый Соответствие;
	Если НоменклатурыБезЗамены.Количество() > 0 Тогда
		Запрос = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|    Связи.Номенклатура КАК Номенклатура
			|ИЗ РегистрСведений.АС_ВзаимозаменяемыеТовары КАК Связи
			|ГДЕ Связи.Номенклатура В (&Номенклатуры)
			|ОБЪЕДИНИТЬ
			|ВЫБРАТЬ
			|    Связи.ВзаимозаменяемыйТовар
			|ИЗ РегистрСведений.АС_ВзаимозаменяемыеТовары КАК Связи
			|ГДЕ Связи.ВзаимозаменяемыйТовар В (&Номенклатуры)");
		Запрос.УстановитьПараметр("Номенклатуры", НоменклатурыБезЗамены);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			СвязанныеНоменклатуры.Вставить(Выборка.Номенклатура, Истина);
		КонецЦикла;
	КонецЕсли;

	КэшПоказателей = Новый Соответствие;
	Для Каждого КлючИСтрока Из Строки Цикл
		ДанныеСтроки = КлючИСтрока.Значение.Данные;
		Если Не ДанныеСтроки.Свойство("АС_КПоступлению")
			Или Не ДанныеСтроки.Свойство("АС_КПоступлениюЗамены") Тогда
			Продолжить;
		КонецЕсли;
		Если Не ДанныеСтроки.Свойство("Ссылка") Тогда
			Продолжить;
		КонецЕсли;
		Если ДанныеСтроки.АС_КПоступлениюЗамены = 0
			И СвязанныеНоменклатуры.Получить(ДанныеСтроки.Ссылка) = Истина Тогда
			Показатели = КэшПоказателей.Получить(ДанныеСтроки.Ссылка);
			Если Показатели = Неопределено Тогда
				Показатели = АС_ПродажиНоменклатурыСервер.ПолучитьПоказателиПоступленияСВзаимозаменяемыми(
					ДанныеСтроки.Ссылка);
				КэшПоказателей.Вставить(ДанныеСтроки.Ссылка, Показатели);
			КонецЕсли;
			ДанныеСтроки.АС_КПоступлению = Показатели.КПоступлению;
			ДанныеСтроки.АС_КПоступлениюЗамены = Показатели.КПоступлениюВзаимозаменяемых;
		КонецЕсли;
		ОригиналДляПоказа = Окр(ДанныеСтроки.АС_КПоступлению, 0);
		ЗаменыДляПоказа = Окр(ДанныеСтроки.АС_КПоступлениюЗамены, 0);
		Если ДанныеСтроки.ТипНоменклатуры <> Перечисления.ТипыНоменклатуры.Запас Тогда
			ОригиналДляПоказа = 0;
			ЗаменыДляПоказа = 0;
		КонецЕсли;
		ПредставленияЧисел = Новый Структура("АС_КПоступлению,АС_КПоступлениюЗамены",
			?(ОригиналДляПоказа = 0, "", Формат(ОригиналДляПоказа, "ЧДЦ=0; ЧГ=")),
			?(ЗаменыДляПоказа = 0, "", Формат(ЗаменыДляПоказа, "ЧДЦ=0; ЧГ=")));
		Для Каждого ПредставлениеЧисла Из ПредставленияЧисел Цикл
			ОформлениеЧисла = КлючИСтрока.Значение.Оформление.Получить(ПредставлениеЧисла.Ключ);
			Если ОформлениеЧисла <> Неопределено Тогда
				ОформлениеЧисла.УстановитьЗначениеПараметра("Текст", ПредставлениеЧисла.Значение);
				ОформлениеЧисла.УстановитьЗначениеПараметра("Доступность",
					Не ПустаяСтрока(ПредставлениеЧисла.Значение));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура АС_ЗапланироватьОбновлениеOEMАналогов()

	ОтключитьОбработчикОжидания("АС_ОбновитьOEMАналогиКлиент");
	Если ТекущаяСтраницаНоменклатуры <> "СписокЗапасы" Тогда
		Возврат;
	КонецЕсли;
	ТекущиеДанные = Элементы.СписокЗапасы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено
		Или Не ТекущиеДанные.Свойство("Ссылка") Тогда
		АС_НоменклатураOEMАналогов = Неопределено;
		АС_НадписьOEMАналоги = "OEM не указан";
		Возврат;
	КонецЕсли;
	Если АС_НоменклатураOEMАналогов = ТекущиеДанные.Ссылка Тогда
		АС_НадписьOEMАналоги = АС_ПодписьOEMАналогов;
		Возврат;
	КонецЕсли;
	АС_НадписьOEMАналоги = "Аналоги по OEM";
	ПодключитьОбработчикОжидания("АС_ОбновитьOEMАналогиКлиент", 0.5, Истина);

КонецПроцедуры

&НаКлиенте
Процедура АС_ОбновитьOEMАналогиКлиент()

	Если АС_ОтложитьФоновоеДействиеПриВводеПоиска("АС_ОбновитьOEMАналогиКлиент") Тогда
		Возврат;
	КонецЕсли;

	Если ТекущаяСтраницаНоменклатуры <> "СписокЗапасы" Тогда
		Возврат;
	КонецЕсли;
	ТекущиеДанные = Элементы.СписокЗапасы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено
		Или Не ТекущиеДанные.Свойство("Ссылка")
		Или Не ЗначениеЗаполнено(ТекущиеДанные.Ссылка) Тогда
		АС_НоменклатураOEMАналогов = Неопределено;
		АС_НадписьOEMАналоги = "OEM не указан";
		Возврат;
	КонецЕсли;
	Если АС_НоменклатураOEMАналогов = ТекущиеДанные.Ссылка Тогда
		Возврат;
	КонецЕсли;
	Если АС_КэшOEMАналогов = Неопределено Тогда
		АС_КэшOEMАналогов = Новый Соответствие;
	КонецЕсли;
	Информация = АС_КэшOEMАналогов.Получить(ТекущиеДанные.Ссылка);
	Если Информация = Неопределено Тогда
		Информация = АС_СостояниеOEMАналоговНаСервере(ТекущиеДанные.Ссылка);
		// Ограничиваем память формы. Не кэшируем еще не построенный индекс.
		Если Информация.ИндексГотов Тогда
			Если АС_КэшOEMАналогов.Количество() >= 100 Тогда
				АС_КэшOEMАналогов.Очистить();
			КонецЕсли;
			АС_КэшOEMАналогов.Вставить(ТекущиеДанные.Ссылка, Информация);
		КонецЕсли;
	КонецЕсли;
	АС_НоменклатураOEMАналогов = ТекущиеДанные.Ссылка;
	Если Не Информация.ИндексГотов Тогда
		АС_НадписьOEMАналоги = "Аналоги по OEM — открыть";
	ИначеЕсли Не Информация.ЕстьКлючиOEM Тогда
		АС_НадписьOEMАналоги = "OEM не указан";
	ИначеЕсли Не Информация.ЕстьАналоги Тогда
		АС_НадписьOEMАналоги = "Аналоги по OEM не найдены";
	Иначе
		АС_НадписьOEMАналоги = "Аналоги по OEM — открыть";
	КонецЕсли;
	АС_ПодписьOEMАналогов = АС_НадписьOEMАналоги;

КонецПроцедуры

