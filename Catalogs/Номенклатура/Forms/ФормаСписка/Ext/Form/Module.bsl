КонецПроцедуры

&НаСервере
&После("УстановитьВидимостьИДоступность")
Процедура АС_УстановитьВидимостьИДоступностьПосле(ЭтоСозданиеФормы = Ложь)

	Если ОтборОстатки = 3 Или ОтборОстатки = 4 Тогда
		ОтборОстатки = 0;
	КонецЕсли;

	Если Элементы.Найти("АС_ОстатокСУчетомЗаказов") <> Неопределено Тогда
		Элементы.АС_ОстатокСУчетомЗаказов.Видимость =
			ТекущаяСтраницаНоменклатуры = "СписокЗапасы" И ПоказыватьОстатки;
	КонецЕсли;
	Если Элементы.Найти("АС_КПоступлениюРаздельно") <> Неопределено Тогда
		Элементы.АС_КПоступлениюРаздельно.Видимость =
			ТекущаяСтраницаНоменклатуры = "СписокЗапасы" И ПоказыватьОстатки;
	КонецЕсли;

	Элементы.СтрокаРасширенногоПоиска.Видимость = Истина;
	Элементы.СписокЗапасыСтандартныйПоиск.Видимость = Ложь;
	Элементы.ЗапасыУправлениеПоиском.Видимость = Ложь;

	Элементы.ОтборТипРабота.Видимость = Ложь;
	Элементы.ОтборТипВидРабот.Видимость = Ложь;
	Элементы.ОтборНабор.Видимость = Ложь;
	Если АС_РекомендацииПоЗакупке И Элементы.Найти("АС_КоличествоКЗакупке") <> Неопределено Тогда
		Если Не АС_ПроданныеЗаПериод Тогда
			Для Каждого Колонка Из Элементы.СписокЗапасы.ПодчиненныеЭлементы Цикл
				Колонка.Видимость = Колонка.Имя = "Наименование" Или Колонка.Имя = "АС_КоличествоКЗакупке";
			КонецЦикла;
		КонецЕсли;
		Элементы.АС_КоличествоКЗакупке.Видимость = Истина;
	КонецЕсли;

КонецПроцедуры

&НаСервере
&После("ПереопределитьТекстЗапросаСписокЗапасы")
Процедура АС_ПереопределитьТекстЗапросаСписокЗапасыПосле()

	Если Не ЗначениеЗаполнено(АС_КлючОбновленияОстатков) Тогда
		АС_КлючОбновленияОстатков = Строка(Новый УникальныйИдентификатор());
	КонецЕсли;
	УстановитьПараметрСписка(СписокЗапасы, "АС_КлючОбновленияОстатков", АС_КлючОбновленияОстатков);

	ПараметрыЗакупки = Новый Структура;
	ТекстЗапроса = АС_ЗапросСПолемЗакупки(СписокЗапасы.ТекстЗапроса, ПараметрыЗакупки);
	ПредставлениеОбычногоОстатка =
		"ЕСТЬNULL(ОстаткиТоваров.Количество, 0) КАК КоличествоОстаток";
	Если СтрНайти(ТекстЗапроса, ПредставлениеОбычногоОстатка) = 0 Тогда
		ТекстЗапроса = СтрЗаменить(
			ТекстЗапроса,
			"0 КАК КоличествоОстаток",
			"0 КАК КоличествоОстаток," + Символы.ПС
			+ "    0 КАК АС_ОстатокСУчетомЗаказов," + Символы.ПС
			+ "    0 КАК АС_КПоступлению," + Символы.ПС
			+ "    0 КАК АС_КПоступлениюЗамены," + Символы.ПС
			+ "    &АС_КлючОбновленияОстатков КАК АС_КлючОбновленияОстатков");
		СписокЗапасы.ТекстЗапроса = ТекстЗапроса;
		АС_УстановитьПараметрыЗакупки(ПараметрыЗакупки);
		Возврат;
	КонецЕсли;

	ВыражениеДоступногоОстатка =
		"ЕСТЬNULL(ОстаткиТоваров.Количество, 0)"
		+ " + ЕСТЬNULL(ОстаткиТоваров.Резерв, 0)"
		+ " - ЕСТЬNULL(АС_АктивныеЗаказы.Количество, 0)";
	ВыражениеКолонки =
		"ВЫБОР КОГДА " + ВыражениеДоступногоОстатка + " > 0" + Символы.ПС
		+ "        ТОГДА " + ВыражениеДоступногоОстатка + Символы.ПС
		+ "    ИНАЧЕ 0 КОНЕЦ КАК АС_ОстатокСУчетомЗаказов";
	ВыражениеКПоступлению =
		"ЕСТЬNULL(АС_КПоступлению.Количество, 0) КАК АС_КПоступлению";
	ВыражениеКПоступлениюЗамены =
		"ЕСТЬNULL(АС_КПоступлениюЗамены.Количество, 0) КАК АС_КПоступлениюЗамены";

	ТекстЗапроса = СтрЗаменить(
		ТекстЗапроса,
		ПредставлениеОбычногоОстатка,
		ПредставлениеОбычногоОстатка + "," + Символы.ПС + "    "
		+ ВыражениеКолонки + "," + Символы.ПС + "    " + ВыражениеКПоступлению + "," + Символы.ПС
		+ "    " + ВыражениеКПоступлениюЗамены + "," + Символы.ПС
		+ "    &АС_КлючОбновленияОстатков КАК АС_КлючОбновленияОстатков");

	ТекстЗапроса = СтрЗаменить(
		ТекстЗапроса,
		"ПО СправочникНоменклатура.Ссылка = ОстаткиТоваров.Номенклатура",
		"ПО СправочникНоменклатура.Ссылка = ОстаткиТоваров.Номенклатура" + Символы.ПС
		+ "        ЛЕВОЕ СОЕДИНЕНИЕ АС_АктивныеЗаказы КАК АС_АктивныеЗаказы" + Символы.ПС
		+ "        ПО СправочникНоменклатура.Ссылка = АС_АктивныеЗаказы.Номенклатура" + Символы.ПС
		+ "        ЛЕВОЕ СОЕДИНЕНИЕ АС_КПоступлению КАК АС_КПоступлению" + Символы.ПС
		+ "        ПО СправочникНоменклатура.Ссылка = АС_КПоступлению.Номенклатура" + Символы.ПС
		+ "        ЛЕВОЕ СОЕДИНЕНИЕ АС_КПоступлениюЗамены КАК АС_КПоступлениюЗамены" + Символы.ПС
		+ "        ПО СправочникНоменклатура.Ссылка = АС_КПоступлениюЗамены.Номенклатура");

	ВТКПоступлению = АС_ПродажиНоменклатурыСервер.ТекстЗапросаПоступления();
	ВТКПоступлениюЗамены = АС_ПродажиНоменклатурыСервер.ТекстЗапросаПоступленияЗамен();

	ВТАктивныеЗаказы =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|    ЗаказыПокупателейОстатки.Номенклатура КАК Номенклатура,
	|    СУММА(ЗаказыПокупателейОстатки.КоличествоОстаток) КАК Количество
	|ПОМЕСТИТЬ АС_АктивныеЗаказы
	|ИЗ
	|    РегистрНакопления.ЗаказыПокупателей.Остатки(
	|            ,
	|            (&ВсеСклады ИЛИ Склад В (&Склад))
	|                И (&ВсеОрганизации ИЛИ Организация В (&Организация))
	|                И (&БезОтбора ИЛИ Характеристика В (&Характеристика))) КАК ЗаказыПокупателейОстатки
	|ГДЕ
	|    ЗаказыПокупателейОстатки.КоличествоОстаток > 0
	|СГРУППИРОВАТЬ ПО
	|    ЗаказыПокупателейОстатки.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|";

	СписокЗапасы.ТекстЗапроса = ВТКПоступлению + ВТКПоступлениюЗамены
		+ ВТАктивныеЗаказы + ТекстЗапроса;
	АС_УстановитьПараметрыЗакупки(ПараметрыЗакупки);
	УстановитьПараметрСписка(СписокЗапасы, "АС_КлючОбновленияОстатков", АС_КлючОбновленияОстатков);

КонецПроцедуры

&НаСервере
Процедура АС_ОбновитьКлючЗапросаОстатковНаСервере()

	АС_КлючОбновленияОстатков = Строка(Новый УникальныйИдентификатор());
	УстановитьПараметрСписка(СписокЗапасы, "АС_КлючОбновленияОстатков", АС_КлючОбновленияОстатков);

КонецПроцедуры

&НаСервере
&После("ПриСозданииНаСервере")
Процедура АС_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)

	ПараметрыЗакупки = Новый Структура;
	СписокЗапасы.ТекстЗапроса = АС_ЗапросСПолемЗакупки(СписокЗапасы.ТекстЗапроса, ПараметрыЗакупки);
	АС_УстановитьПараметрыЗакупки(ПараметрыЗакупки);
	АС_ДобавитьКолонкуЗакупки();

	Для НомерВарианта = 3 По 4 Цикл
		ВариантОтбора = Элементы.ОтборОстатки.СписокВыбора.НайтиПоЗначению(НомерВарианта);
		Если ВариантОтбора <> Неопределено Тогда
			Элементы.ОтборОстатки.СписокВыбора.Удалить(ВариантОтбора);
		КонецЕсли;
	КонецЦикла;
	Если ОтборОстатки = 3 Или ОтборОстатки = 4 Тогда
		ОтборОстатки = 0;
	КонецЕсли;

	ИмяКолонки = "АС_ОстатокСУчетомЗаказов";
	Если Элементы.Найти(ИмяКолонки) = Неопределено Тогда
		Колонка = Элементы.Добавить(ИмяКолонки, Тип("ПолеФормы"), Элементы.СписокЗапасы);
		Колонка.Вид = ВидПоляФормы.ПолеВвода;
		Колонка.ПутьКДанным = "СписокЗапасы.АС_ОстатокСУчетомЗаказов";
		Колонка.Заголовок = "С учетом" + Символы.ПС + "заказов";
		Колонка.Подсказка = "Физический остаток за вычетом товаров в активных заказах покупателей и заказ-нарядах";
		Колонка.ТолькоПросмотр = Истина;
		Колонка.Ширина = 9;
		Колонка.Формат = "ЧН=0; ЧДЦ=3";
		Колонка.Видимость = ПоказыватьОстатки;
		Элементы.Переместить(Колонка, Элементы.СписокЗапасы, Элементы.КартинкаОстатки);
	КонецЕсли;

	АС_ДобавитьКолонкиКПоступлению();

	АС_ПерестроитьОформлениеЗаканчивающихсяТоваров();

	// Без отбора продаж сохраняем штатное скрытие нуля при отсутствии остатка.
	// В отборе продаж ноль виден также для полностью распроданных товаров.
	// Услуги и работы по-прежнему не показывают складские количества.
	АС_ДобавитьСкрытиеТекстаКолонкиПоПолю(
		ИмяКолонки,
		"СписокЗапасы.КоличествоОстаток",
		0,
		ВидСравненияКомпоновкиДанных.Равно,
		Истина);
	АС_ДобавитьСкрытиеТекстаКолонкиПоПолю(
		ИмяКолонки,
		"СписокЗапасы.ТипНоменклатуры",
		Перечисления.ТипыНоменклатуры.Запас,
		ВидСравненияКомпоновкиДанных.НеРавно);

КонецПроцедуры

&НаСервере
Процедура АС_ДобавитьКолонкиКПоступлению()

	Если Элементы.Найти("АС_КПоступлениюРаздельно") <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	ГруппаПоступления = Элементы.Добавить("АС_КПоступлениюРаздельно",
		Тип("ГруппаФормы"), Элементы.СписокЗапасы);
	ГруппаПоступления.Вид = ВидГруппыФормы.ГруппаКолонок;
	// Горизонтально: каждое число имеет собственное поле события Выбор.
	// ВЯчейке объединяет поля в один текст и добавляет штатные запятые.
	ГруппаПоступления.Группировка = ГруппировкаКолонок.Горизонтальная;
	ГруппаПоступления.Заголовок = "К поступлению";
	ГруппаПоступления.ОтображатьЗаголовок = Истина;
	ГруппаПоступления.ОтображатьВШапке = Истина;
	ГруппаПоступления.Видимость = ПоказыватьОстатки;
	Элементы.Переместить(ГруппаПоступления, Элементы.СписокЗапасы, Элементы.КартинкаОстатки);

	Для Каждого ИмяПоля Из СтрРазделить(
		"АС_КПоступлению,АС_КПоступлениюЗамены", ",") Цикл
		Колонка = Элементы.Добавить(ИмяПоля, Тип("ПолеФормы"), ГруппаПоступления);
		Колонка.Вид = ВидПоляФормы.ПолеНадписи;
		Колонка.ПутьКДанным = "СписокЗапасы." + ИмяПоля;
		Колонка.Заголовок = ?(ИмяПоля = "АС_КПоступлению", "Оригинал", "Замена");
		Колонка.ОтображатьВШапке = Истина;
		Колонка.ГиперссылкаЯчейки = Истина;
		Колонка.Ширина = 6;
		Колонка.РастягиватьПоГоризонтали = Ложь;
		Колонка.Формат = "ЧДЦ=0; ЧГ=";
		Колонка.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Право;
		Колонка.Подсказка = ?(ИмяПоля = "АС_КПоступлению",
			"Заказы поставщику по этой детали",
			"Заказы поставщику по взаимозаменяемым деталям");
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура АС_ПерестроитьОформлениеЗаканчивающихсяТоваров()

	УдаляемыеЭлементы = Новый Массив;
	Для Каждого ЭлементОформления Из УсловноеОформление.Элементы Цикл
		Если ЭлементОформления.ИдентификаторПользовательскойНастройки =
			"АС_ДинамическаяИндикацияОстатков" Тогда
			УдаляемыеЭлементы.Добавить(ЭлементОформления);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ЭлементОформления Из УдаляемыеЭлементы Цикл
		УсловноеОформление.Элементы.Удалить(ЭлементОформления);
	КонецЦикла;

	НастройкиОформления = АС_ИндикацияОстатковСервер.НастройкиОформления();
	Для Каждого ПравилоОформления Из НастройкиОформления.Правила Цикл
		АС_ДобавитьОформлениеЗаканчивающегосяТовара(
			"АС_ОстатокСУчетомЗаказов",
			ПравилоОформления.ВерхняяГраница,
			ПравилоОформления.НижняяГраница,
			ПравилоОформления.ЦветФона,
			ПравилоОформления.Номенклатура,
			НастройкиОформления.ИсключенияОбщейИндикации);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура АС_ДобавитьОформлениеЗаканчивающегосяТовара(
	ИмяКолонки, ВерхняяГраница, НижняяГраница, ЦветФона,
	Номенклатура, ИсключенияОбщейИндикации)

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементОформления.ИдентификаторПользовательскойНастройки =
		"АС_ДинамическаяИндикацияОстатков";
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
		ЭлементОформления.Отбор,
		"СписокЗапасы.АС_ОстатокСУчетомЗаказов",
		ВерхняяГраница,
		ВидСравненияКомпоновкиДанных.МеньшеИлиРавно);
	Если НижняяГраница <> Неопределено Тогда
		РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
			ЭлементОформления.Отбор,
			"СписокЗапасы.АС_ОстатокСУчетомЗаказов",
			НижняяГраница,
			ВидСравненияКомпоновкиДанных.Больше);
	КонецЕсли;
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
			ЭлементОформления.Отбор,
			"СписокЗапасы.Номенклатура",
			Номенклатура);
	ИначеЕсли ИсключенияОбщейИндикации.Количество() > 0 Тогда
		РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
			ЭлементОформления.Отбор,
			"СписокЗапасы.Номенклатура",
			ИсключенияОбщейИндикации,
			ВидСравненияКомпоновкиДанных.НеВСписке);
	КонецЕсли;
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
		ЭлементОформления.Отбор,
		"СписокЗапасы.ТипНоменклатуры",
		Перечисления.ТипыНоменклатуры.Запас);
	// При отборе продаж индикация действует и для товаров без остатка.
	АС_ОтборНаличия = РаботаСФормой.ДобавитьГруппуЭлементовОтбораКомпоновкиДанных(
		ЭлементОформления.Отбор, ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли);
	АС_ОтборНаличия.Использование = Истина;
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
		АС_ОтборНаличия,
		"СписокЗапасы.КоличествоОстаток",
		0,
		ВидСравненияКомпоновкиДанных.Больше);
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
		АС_ОтборНаличия, "АС_ПроданныеЗаПериод", Истина);
	РаботаСФормой.ДобавитьОформляемоеПоле(ЭлементОформления, ИмяКолонки);
	РаботаСФормой.ДобавитьЭлементУсловногоОформления(
		ЭлементОформления, "ЦветФона", ЦветФона);

КонецПроцедуры

&НаСервере
Процедура АС_ДобавитьСкрытиеТекстаКолонкиПоПолю(
	ИмяКолонки, ИмяПоля, ЗначениеПоля, ВидСравнения, ТолькоБезОтбораПродаж = Ложь)

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
		ЭлементОформления.Отбор,
		ИмяПоля,
		ЗначениеПоля,
		ВидСравнения);
	Если ТолькоБезОтбораПродаж Тогда
		РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
			ЭлементОформления.Отбор, "АС_ПроданныеЗаПериод", Ложь);
	КонецЕсли;
	РаботаСФормой.ДобавитьОформляемоеПоле(ЭлементОформления, ИмяКолонки);
	РаботаСФормой.ДобавитьЭлементУсловногоОформления(
		ЭлементОформления, "Текст", "");

КонецПроцедуры

&НаСервере
Процедура АС_ДобавитьСкрытиеТекстаКолонкиПоДвумПолям(
	ИмяКолонки,
	ИмяПоля1, ЗначениеПоля1, ВидСравнения1,
	ИмяПоля2, ЗначениеПоля2, ВидСравнения2)

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
		ЭлементОформления.Отбор,
		ИмяПоля1,
		ЗначениеПоля1,
		ВидСравнения1);
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
		ЭлементОформления.Отбор,
		ИмяПоля2,
		ЗначениеПоля2,
		ВидСравнения2);
	РаботаСФормой.ДобавитьОформляемоеПоле(ЭлементОформления, ИмяКолонки);
	РаботаСФормой.ДобавитьЭлементУсловногоОформления(
		ЭлементОформления, "Текст", "");

КонецПроцедуры

&НаСервере
Процедура АС_ПрименитьПоискПоАртикулуНаСервере()

	Если ПустаяСтрока(СокрЛП(АС_СтрокаПоискаАртикула)) Тогда
		ПодборПоискНеУдачный = Ложь;
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
			ЭтотОбъект[ТекущаяСтраницаНоменклатуры], "Номенклатура", , , , Ложь);
		Возврат;
	КонецЕсли;

	ИсходнаяСтрокаПоиска = СтрокаРасширенногоПоиска;
	ИсходныйРежимПоиска = НастройкиПоискаКакИскать;
	СтрокаРасширенногоПоиска = АС_СтрокаПоискаАртикула;
	НастройкиПоискаКакИскать = 1;

	Попытка
		ПоискПоПодстроке();
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		СтрокаРасширенногоПоиска = ИсходнаяСтрокаПоиска;
		НастройкиПоискаКакИскать = ИсходныйРежимПоиска;
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;

	СтрокаРасширенногоПоиска = ИсходнаяСтрокаПоиска;
	НастройкиПоискаКакИскать = ИсходныйРежимПоиска;

КонецПроцедуры

&НаСервереБезКонтекста
&Вместо("ПолнотекстовыйПоискНаСервереБезКонтекста")
Функция АС_ПолнотекстовыйПоискНаСервереБезКонтекста(
	СтрокаПоиска, РезультатПоиска, СтркуткраНастроекПоиска)

	ПоискНеУдачный = ПродолжитьВызов(
		СтрокаПоиска, РезультатПоиска, СтркуткраНастроекПоиска);
	Если ПоискНеУдачный Тогда
		Возврат ПоискНеУдачный;
	КонецЕсли;

	АС_СинонимыПоискаСервер.ДополнитьПоискСинонимами(РезультатПоиска.Номенклатура, СтрокаПоиска);

	Возврат ПоискНеУдачный;

КонецФункции

&НаСервере
&Вместо("РезультатПоискаПоПодстроке")
Функция АС_РезультатПоискаПоПодстроке(СтрокаРасширенногоПоиска)
	
	МассивНоменклатуры = ПродолжитьВызов(СтрокаРасширенногоПоиска);
	АС_СинонимыПоискаСервер.ДополнитьПоискСинонимами(МассивНоменклатуры, СтрокаРасширенногоПоиска);

	АС_ДополнитьРезультатПоискаПоТочкамИЗапятым(
		МассивНоменклатуры, СтрокаРасширенногоПоиска);
	АС_ДополнитьРезультатПоискаПоОтдельнымСловам(
		МассивНоменклатуры, СтрокаРасширенногоПоиска);
	КлючАртикула = АС_НоменклатураСервер.КомпактныйКлючАртикула(СтрокаРасширенногоПоиска);
	
	Если ПустаяСтрока(КлючАртикула) Тогда
		Возврат МассивНоменклатуры;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	УсловиеАртикула = АС_НоменклатураСервер.УсловиеПоискаПоАртикулу(
		Запрос, СтрокаРасширенногоПоиска);
	Запрос.УстановитьПараметр("МассивНоменклатуры", МассивНоменклатуры);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	| 	Номенклатура.Ссылка КАК Номенклатура
	|ИЗ
	| 	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	| 	НЕ Номенклатура.Ссылка В (&МассивНоменклатуры)
	| 	И (" + УсловиеАртикула + ")";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МассивНоменклатуры.Добавить(Выборка.Номенклатура);
	КонецЦикла;
	
	Возврат МассивНоменклатуры;
	
КонецФункции

&НаСервере
Процедура АС_ДополнитьРезультатПоискаПоТочкамИЗапятым(МассивНоменклатуры, СтрокаПоиска)

	Если СтрНайти(СтрокаПоиска, ".") = 0
		И СтрНайти(СтрокаПоиска, ",") = 0 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивНоменклатуры", МассивНоменклатуры);
	Запрос.УстановитьПараметр(
		"СтрокаПоиска", АС_ШаблонПоискаСУчетомРазделителя(СтрокаПоиска));
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	| 	Номенклатура.Ссылка КАК Номенклатура
	|ИЗ
	| 	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	| 	НЕ Номенклатура.Ссылка В (&МассивНоменклатуры)
	| 	И (Номенклатура.Наименование ПОДОБНО &СтрокаПоиска
	| 		ИЛИ Номенклатура.НаименованиеПолное ПОДОБНО &СтрокаПоиска)";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МассивНоменклатуры.Добавить(Выборка.Номенклатура);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура АС_ДополнитьРезультатПоискаПоОтдельнымСловам(МассивНоменклатуры, СтрокаПоиска)

	СтрокаПоиска = СтрЗаменить(СтрокаПоиска, Символы.Таб, " ");
	СтрокаПоиска = СтрЗаменить(СтрокаПоиска, Символы.ВК, " ");
	СтрокаПоиска = СтрЗаменить(СтрокаПоиска, Символы.ПС, " ");
	ЧастиПоиска = СтрРазделить(СокрЛП(СтрокаПоиска), " ", Ложь);
	Если ЧастиПоиска.Количество() < 2 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивНоменклатуры", МассивНоменклатуры);
	УсловияПоискаПоНаименованию = Новый Массив;
	УсловияПоискаПоПолномуНаименованию = Новый Массив;
	Для Индекс = 0 По ЧастиПоиска.ВГраница() Цикл
		ИмяПараметра = "ЧастьПоиска" + Строка(Индекс);
		Запрос.УстановитьПараметр(
			ИмяПараметра, АС_ШаблонПоискаСУчетомРазделителя(ЧастиПоиска[Индекс]));
		УсловияПоискаПоНаименованию.Добавить(
			"Номенклатура.Наименование ПОДОБНО &" + ИмяПараметра);
		УсловияПоискаПоПолномуНаименованию.Добавить(
			"Номенклатура.НаименованиеПолное ПОДОБНО &" + ИмяПараметра);
	КонецЦикла;

	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	| 	Номенклатура.Ссылка КАК Номенклатура
	|ИЗ
	| 	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	| 	НЕ Номенклатура.ЭтоГруппа
	| 	И НЕ Номенклатура.Ссылка В (&МассивНоменклатуры)
	| 	И (" + СтрСоединить(УсловияПоискаПоНаименованию, " И ")
		+ " ИЛИ " + СтрСоединить(УсловияПоискаПоПолномуНаименованию, " И ") + ")";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МассивНоменклатуры.Добавить(Выборка.Номенклатура);
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_ШаблонПоискаСУчетомРазделителя(СтрокаПоиска)

	ШаблонПоиска = "";
	Для Позиция = 1 По СтрДлина(СтрокаПоиска) Цикл
		СимволСтроки = Сред(СтрокаПоиска, Позиция, 1);
		Если СимволСтроки = "." Или СимволСтроки = "," Тогда
			ШаблонПоиска = ШаблонПоиска + "[.,]";
		Иначе
			ШаблонПоиска = ШаблонПоиска + СимволСтроки;
		КонецЕсли;
	КонецЦикла;

	Возврат "%" + ШаблонПоиска + "%";

КонецФункции

&НаКлиенте
Процедура АС_БезДокументовПриИзменении(Элемент)

	Если АС_БезДокументов И АС_ОтборДокументы <> 1 И АС_ОтборДокументы <> 2 Тогда
		АС_ОтборДокументы = 2;
	ИначеЕсли Не АС_БезДокументов Тогда
		АС_ОтборДокументы = Неопределено;
	КонецЕсли;
	АС_УстановитьВидимостьОтборовИзображенияИДокументов();
	АС_ПрименитьОтборПоАвтомобилю();
	АС_ОбновитьКоличествоВсехСтрокСпискаЗапасов();

КонецПроцедуры

&НаКлиенте
Процедура АС_ОтборOEMИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)

	// Значение храним сразу, а текст и позицию курсора оставляем редактору поля.
	СтандартнаяОбработка = Ложь;
	Элемент.ОбновлениеТекстаРедактирования = ОбновлениеТекстаРедактирования.НеИспользовать;
	АС_ОтборOEM = Текст;
	АС_ТекстОтбораOEM = Текст;
	ОтключитьОбработчикОжидания("АС_ПрименитьОтборOEMСЗадержкой");
	ПодключитьОбработчикОжидания("АС_ПрименитьОтборOEMСЗадержкой", 0.4, Истина);

КонецПроцедуры

&НаКлиенте
Процедура АС_ПрименитьОтборOEMСЗадержкой()

	Если АС_ОтложитьФоновоеДействиеПриВводеПоиска("АС_ПрименитьОтборOEMСЗадержкой") Тогда
		Возврат;
	КонецЕсли;

	ОтключитьОбработчикОжидания("АС_ПрименитьОтборOEMСЗадержкой");
	// Поиск использует сохранённый текст и не обновляет редактор поля.
	АС_ПрименитьОтборOEMКлиент(АС_ТекстОтбораOEM);

КонецПроцедуры

&НаКлиенте
Процедура АС_ОтборOEMПриИзменении(Элемент)

	ОтключитьОбработчикОжидания("АС_ПрименитьОтборOEMСЗадержкой");
	АС_ТекстОтбораOEM = АС_ОтборOEM;
	АС_ПрименитьОтборOEMКлиент(АС_ТекстОтбораOEM);

КонецПроцедуры

&НаКлиенте
Процедура АС_ПрименитьОтборOEMКлиент(ТекстOEM, Принудительно = Ложь)

	Если ТекстOEM = Неопределено
		Или (Не Принудительно И АС_ПримененныйОтборOEM = ТекстOEM) Тогда
		Возврат;
	КонецЕсли;
	АС_ПрименитьОтборПоАвтомобилю(ТекстOEM);
	Элементы.СписокЗапасы.Обновить();
	АС_ОбновитьКоличествоВсехСтрокСпискаЗапасов();

КонецПроцедуры

&НаКлиенте
Процедура АС_ОтборOEMОчистка(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	АС_ОтборOEM = "";
	// Явная очистка должна обновить текст даже при отключённом автоперечитывании.
	Элемент.ОбновитьТекстРедактирования();
	АС_ОтборOEMПриИзменении(Элемент);

КонецПроцедуры

&НаКлиенте
Процедура АС_ОтборOEMМаркаПриИзменении(Элемент)

	ОтключитьОбработчикОжидания("АС_ПрименитьОтборOEMСЗадержкой");
	Если АС_ТекстОтбораOEM = Неопределено Тогда
		АС_ТекстОтбораOEM = АС_ОтборOEM;
	КонецЕсли;
	АС_ПрименитьОтборOEMКлиент(АС_ТекстОтбораOEM, Истина);

КонецПроцедуры

&НаКлиенте
Процедура АС_ОтборOEMМаркаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Марки = АС_ПолучитьСписокАвтомобилейДляОтбора(Истина, Неопределено);
	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("АС_ОтборOEMМаркаВыбрана", ЭтотОбъект),
		Марки, Элемент, Марки.НайтиПоЗначению(АС_ОтборOEMМарка));

КонецПроцедуры

&НаКлиенте
Процедура АС_ОтборOEMМаркаАвтоПодбор(
	Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)

	Если ПустаяСтрока(СокрЛП(Текст)) Тогда
		Возврат;
	КонецЕсли;
	Ожидание = Ложь;
	ДанныеВыбора = АС_ПолучитьАвтомобилиДляАвтоПодбора(Текст, Истина, Неопределено);
	СтандартнаяОбработка = ДанныеВыбора.Количество() = 0;

КонецПроцедуры

&НаКлиенте
Процедура АС_ОтборOEMМаркаВыбрана(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт

	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	АС_ОтборOEMМарка = ВыбранныйЭлемент.Значение;
	АС_ОтборOEMМаркаПриИзменении(Неопределено);

КонецПроцедуры

&НаКлиенте
Процедура АС_ОтборБрендПриИзменении(Элемент)

	АС_ПрименитьОтборПоАвтомобилю();
	АС_ОбновитьКоличествоВсехСтрокСпискаЗапасов();

КонецПроцедуры

&НаКлиенте
Процедура АС_ПоступившиеЗаПериодПриИзменении(Элемент)

	Если АС_ПоступившиеЗаПериод Тогда
		АС_ЗаполнитьПериодПоступленийПоУмолчанию();
		Если АС_НазначениеПоступления <> 1
			И АС_НазначениеПоступления <> 2
			И АС_НазначениеПоступления <> 3 Тогда
			АС_НазначениеПоступления = 1;
		КонецЕсли;
	КонецЕсли;
	АС_УстановитьВидимостьПериодовТоварныхОтборов();
	АС_ЗапланироватьПрименениеТоварныхОтборов();

КонецПроцедуры

&НаКлиенте
Процедура АС_ДатаПоступленияПриИзменении(Элемент)

	Если АС_ПоступившиеЗаПериод Тогда
		АС_ЗапланироватьПрименениеТоварныхОтборов();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_НазначениеПоступленияПриИзменении(Элемент)

	Если АС_ПоступившиеЗаПериод Тогда
		АС_ЗапланироватьПрименениеТоварныхОтборов();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_ПроданныеЗаПериодПриИзменении(Элемент)

	Если Не АС_ПроданныеЗаПериод Тогда
		АС_ОтключитьРекомендацииПоЗакупке();
	КонецЕсли;
	АС_ОбновитьРежимОстатковПоПродажам();
	Если АС_ПроданныеЗаПериод Тогда
		АС_ЗаполнитьПериодПродажПоУмолчанию();
		Если АС_ИсточникПродажи <> 1
			И АС_ИсточникПродажи <> 2
			И АС_ИсточникПродажи <> 3 Тогда
			АС_ИсточникПродажи = 1;
		КонецЕсли;
	КонецЕсли;
	АС_УстановитьВидимостьПериодовТоварныхОтборов();
	АС_УстановитьКолонкиЗакупки();
	АС_ЗапланироватьПрименениеТоварныхОтборов();

КонецПроцедуры

&НаКлиенте
Процедура АС_ОбновитьРежимОстатковПоПродажам()

	Если АС_ПроданныеЗаПериод Или АС_РекомендацииПоЗакупке Тогда
		Если АС_ОтборОстатковДоПродаж = Неопределено Тогда
			АС_ОтборОстатковДоПродаж = ОтборОстатки;
		КонецЕсли;
		АС_НовыйРежимОстатков = 0; // Все остатки, включая полностью распроданные товары.
	Иначе
		Если АС_ОтборОстатковДоПродаж = Неопределено Тогда
			Возврат;
		КонецЕсли;
		АС_НовыйРежимОстатков = АС_ОтборОстатковДоПродаж;
		АС_ОтборОстатковДоПродаж = Неопределено;
	КонецЕсли;

	Если ОтборОстатки <> АС_НовыйРежимОстатков Тогда
		ОтборОстатки = АС_НовыйРежимОстатков;
		ОтборОстаткиПриИзменении(Элементы.ОтборОстатки);
		// Количество строк пересчитается один раз после применения отбора продаж.
		ОтключитьОбработчикОжидания("АС_ПересчитатьКоличествоВсехСтрокСпискаЗапасов");
	КонецЕсли;

КонецПроцедуры

