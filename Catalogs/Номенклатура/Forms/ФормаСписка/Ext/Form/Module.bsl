Функция АС_СтруктураДанныхКритерияОтбора(ПутьКДанным)

	СтруктураДанных = Новый Структура;
	ИменаПолей = Новый Массив;
	ИменаПолей.Добавить("ТипОбъекта");
	ИменаПолей.Добавить("ВидОбъекта");
	ИменаПолей.Добавить("ПутьКДанным");
	ИменаПолей.Добавить("ИмяТаблЧасти");
	ИменаПолей.Добавить("ИмяРеквизита");

	Для Индекс = 1 По 3 Цикл
		ПозицияТочки = СтрНайти(ПутьКДанным, ".");
		ТекущееЗначение = Лев(ПутьКДанным, ПозицияТочки - 1);
		СтруктураДанных.Вставить(ИменаПолей[Индекс - 1], ТекущееЗначение);
		ПутьКДанным = Сред(ПутьКДанным, ПозицияТочки + 1);
	КонецЦикла;

	ПутьКДанным = СтрЗаменить(ПутьКДанным, "Реквизит.", "");
	Если СтруктураДанных.ПутьКДанным = "ТабличнаяЧасть" Тогда
		Для Индекс = 4 По 5 Цикл
			ПозицияТочки = СтрНайти(ПутьКДанным, ".");
			Если ПозицияТочки = 0 Тогда
				ТекущееЗначение = ПутьКДанным;
			Иначе
				ТекущееЗначение = Лев(ПутьКДанным, ПозицияТочки - 1);
			КонецЕсли;
			СтруктураДанных.Вставить(ИменаПолей[Индекс - 1], ТекущееЗначение);
			ПутьКДанным = Сред(ПутьКДанным, ПозицияТочки + 1);
		КонецЦикла;
	Иначе
		СтруктураДанных.Вставить("ИмяТаблЧасти", "");
		СтруктураДанных.Вставить("ИмяРеквизита", ПутьКДанным);
	КонецЕсли;

	СтруктураДанных.Вставить("Метаданные", Метаданные.Документы[СтруктураДанных.ВидОбъекта]);
	Возврат СтруктураДанных;

КонецФункции

&НаКлиенте
&После("ПриОткрытии")
Процедура АС_ПриОткрытииПосле(Отказ)

	АС_ЗаполнитьПериодПоступленийПоУмолчанию();
	АС_ЗаполнитьПериодПродажПоУмолчанию();
	АС_УстановитьВидимостьПериодовТоварныхОтборов();
	АС_УстановитьВидимостьОтборовИзображенияИДокументов();
	АС_ОбновитьСтатистикуВыделенияСпискаЗапасов();
	АС_ОбновитьКоличествоВсехСтрокСпискаЗапасов();

КонецПроцедуры

&НаКлиенте
Процедура АС_ЗаполнитьПериодПоступленийПоУмолчанию()

	ДатаСеанса = ОбщегоНазначенияКлиент.ДатаСеанса();
	Если Не ЗначениеЗаполнено(АС_ДатаПоступленияС) Тогда
		АС_ДатаПоступленияС = НачалоДня(ДатаСеанса - 7 * 24 * 60 * 60);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(АС_ДатаПоступленияПо) Тогда
		АС_ДатаПоступленияПо = КонецДня(ДатаСеанса);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_ЗаполнитьПериодПродажПоУмолчанию()

	ДатаСеанса = ОбщегоНазначенияКлиент.ДатаСеанса();
	Если Не ЗначениеЗаполнено(АС_ДатаПродажиС) Тогда
		АС_ДатаПродажиС = НачалоДня(ДатаСеанса - 7 * 24 * 60 * 60);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(АС_ДатаПродажиПо) Тогда
		АС_ДатаПродажиПо = КонецДня(ДатаСеанса);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_УстановитьВидимостьПериодовТоварныхОтборов()

	Элементы.АС_ПериодПоступления.Видимость = АС_ПоступившиеЗаПериод;
	Элементы.АС_ПериодПродаж.Видимость = АС_ПроданныеЗаПериод;

КонецПроцедуры

&НаКлиенте
Процедура АС_УстановитьВидимостьОтборовИзображенияИДокументов()

	Элементы.АС_ОтборИзображение.Видимость = АС_БезФотографии;
	Элементы.АС_ОтборДокументы.Видимость = АС_БезДокументов;
	Элементы.АС_ОтборOEMАртикулы.Видимость = АС_OEMАртикулы;
	Элементы.АС_ОтборOEMАртикулыМарка.Видимость = АС_OEMАртикулы;
	Элементы.АС_ОтборЕстьАналоги.Видимость = АС_ЕстьАналоги;
	Элементы.АС_ОтборПрименяемость.Видимость = АС_Применяемость;

КонецПроцедуры

&НаКлиенте
&Перед("ПриЗакрытии")
Процедура АС_ПриЗакрытииПеред(ЗавершениеРаботы)

	ОтключитьОбработчикОжидания("АС_ОбновитьСтатистикуВыделенияСпискаЗапасов");

КонецПроцедуры

&НаКлиенте
Процедура АС_ОбновитьСтатистикуВыделенияСпискаЗапасов()

	КоличествоВыделенныхСтрок = Элементы.СписокЗапасы.ВыделенныеСтроки.Количество();
	Если АС_КоличествоВыделенныхСтрокСпискаЗапасов = КоличествоВыделенныхСтрок Тогда
		ПодключитьОбработчикОжидания("АС_ОбновитьСтатистикуВыделенияСпискаЗапасов", 0.2, Истина);
		Возврат;
	КонецЕсли;

	АС_КоличествоВыделенныхСтрокСпискаЗапасов = КоличествоВыделенныхСтрок;
	АС_УстановитьТекстСтатистикиСпискаЗапасов();

	ПодключитьОбработчикОжидания("АС_ОбновитьСтатистикуВыделенияСпискаЗапасов", 0.2, Истина);

КонецПроцедуры

&НаКлиенте
Процедура АС_ОбновитьКоличествоВсехСтрокСпискаЗапасов()

	Если ТекущаяСтраницаНоменклатуры <> "СписокЗапасы" Тогда
		Возврат;
	КонецЕсли;

	АС_КоличествоВсехСтрокСпискаЗапасов = АС_ПолучитьКоличествоСтрокСпискаЗапасовНаСервере();
	АС_УстановитьТекстСтатистикиСпискаЗапасов();

КонецПроцедуры

&НаКлиенте
Процедура АС_УстановитьТекстСтатистикиСпискаЗапасов()

	Если АС_КоличествоВсехСтрокСпискаЗапасов = Неопределено Тогда
		Элементы.АС_СтатистикаСпискаЗапасов.Видимость = Ложь;
		Возврат;
	КонецЕсли;

	Элементы.АС_СтатистикаСпискаЗапасов.Видимость = Истина;
	АС_СтатистикаВыделенияСпискаЗапасов = "Всего строк: "
		+ Строка(АС_КоличествоВсехСтрокСпискаЗапасов);
	Если АС_КоличествоВыделенныхСтрокСпискаЗапасов > 0 Тогда
		АС_СтатистикаВыделенияСпискаЗапасов = АС_СтатистикаВыделенияСпискаЗапасов
			+ "; Выделено: " + Строка(АС_КоличествоВыделенныхСтрокСпискаЗапасов);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция АС_ПолучитьКоличествоСтрокСпискаЗапасовНаСервере()

	Схема = Элементы.СписокЗапасы.ПолучитьИсполняемуюСхемуКомпоновкиДанных();
	Настройки = Элементы.СписокЗапасы.ПолучитьИсполняемыеНастройкиКомпоновкиДанных();

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных();
	МакетКомпоновки = КомпоновщикМакета.Выполнить(
		Схема, Настройки,,, Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	Результат = ПроцессорВывода.Вывести(ПроцессорКомпоновки);

	Возврат Результат.Количество();

КонецФункции

