Процедура АС_СтрокаРасширенногоПоискаПриИзменении(Элемент)

	// Потеря фокуса не запускает поиск или тяжелое обновление в событии поля.
	// Единственный клиентский таймер возобновит отложенные действия отдельно.
	Возврат;

КонецПроцедуры

&НаКлиенте
Процедура АС_СтрокаПоискаАртикулаИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	// Только первый символ приостанавливает таймеры; следующие символы не трогают их.
	АС_ПриостановитьФоновыеДействияПоиска();

КонецПроцедуры

&НаКлиенте
Процедура АС_СтрокаПоискаАртикулаОкончаниеВводаТекста(
	Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	АС_СтрокаПоискаАртикула = Текст;
	Если ПустаяСтрока(Текст) Тогда
		АС_СброситьПоискПоАртикулу();
		Возврат;
	КонецЕсли;

	АС_ПрименитьПоискПоАртикулуНаСервере();
	АС_ПоискПоАртикулуПрименен = Истина;
	АС_ОбновитьСчетчикиПослеЯвногоПоиска();

КонецПроцедуры

&НаКлиенте
Процедура АС_СтрокаПоискаАртикулаОчистка(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	АС_СброситьПоискПоАртикулу();

КонецПроцедуры

&НаКлиенте
Процедура АС_СброситьПоискПоАртикулу()

	АС_СтрокаПоискаАртикула = "";
	Элементы.СтрокаРасширенногоПоиска.ОбновитьТекстРедактирования();
	// Очистка может породить несколько событий поля: снимаем отбор один раз.
	Если АС_ПоискПоАртикулуПрименен = Истина Тогда
		АС_ПрименитьПоискПоАртикулуНаСервере();
		АС_ПоискПоАртикулуПрименен = Ложь;
		АС_ОбновитьСчетчикиПослеЯвногоПоиска();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция АС_ВводитсяСтрокаПоиска()

	Если Не АС_БезопасноеОбновлениеКлиент.МожноОбновить(ЭтотОбъект, АС_СостояниеФоновогоОбновления) Тогда
		Возврат Истина;
	КонецЕсли;
	// Ячейки идентификаторов копируют без открытия редактора. Не перестраиваем
	// список под Ctrl+C; штатное сканирование проходит в отдельной области вызова.
	Колонка = ТекущийЭлемент;
	Если Колонка = Элементы.СписокЗапасы Тогда
		Колонка = Элементы.СписокЗапасы.ТекущийЭлемент;
	КонецЕсли;
	Если ТипЗнч(Колонка) = Тип("ПолеФормы") Тогда
		// ПутьКДанным поля формы доступен на сервере. На клиенте используем
		// имена элементов формы, которые не меняются от заголовков и настроек.
		ИмяКолонки = ВРег(Колонка.Имя);
		Если ИмяКолонки = "АРТИКУЛ" Или ИмяКолонки = "КОД"
			Или ИмяКолонки = "ШТРИХКОД" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;

	// Живые фильтры сохраняют текст в реквизит на каждом символе.
	Возврат ТипЗнч(ТекущийЭлемент) = Тип("ПолеФормы")
		И ТекущийЭлемент.Вид = ВидПоляФормы.ПолеВвода
		И Не ТекущийЭлемент.ТолькоПросмотр;

КонецФункции

&НаКлиенте
Функция АС_ОтложитьФоновоеДействиеПриВводеПоиска(ИмяОбработчика)

	АС_БезопасноеОбновлениеКлиент.ПодготовитьСостояние(АС_СостояниеФоновогоОбновления);
	Если АС_СостояниеФоновогоОбновления.Закрыта Тогда
		Возврат Истина;
	КонецЕсли;
	Если АС_ОбрабатываетсяСканирование = Истина Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Не АС_ВводитсяСтрокаПоиска() Тогда
		Возврат Ложь;
	КонецЕсли;

	АС_ПриостановитьФоновыеДействияПоиска();
	ОтключитьОбработчикОжидания(ИмяОбработчика);
	// Не воспроизводим после ввода устаревшую смену фокуса/разворачивание дерева.
	Если ИмяОбработчика <> "АктивизироватьДерево"
		И ИмяОбработчика <> "РазвернутьТекущуюСтрокиДерева"
		И ИмяОбработчика <> "ПоказатьВСпискеКлиент" Тогда
		АС_ОтложенныеДействияПослеПоиска.Вставить(ИмяОбработчика, Истина);
	КонецЕсли;
	Возврат Истина;

КонецФункции

&НаКлиенте
Процедура АС_ПриостановитьФоновыеДействияПоиска()

	Если АС_ФоновыеДействияПоискаПриостановлены = Истина Тогда
		Возврат;
	КонецЕсли;

	АС_ФоновыеДействияПоискаПриостановлены = Истина;
	АС_ОтложенныеДействияПослеПоиска = Новый Соответствие;
	АС_ОтложенныеДействияПослеПоиска.Вставить("АС_ПроверитьИзменениеОстатков", Истина);
	АС_ОтложенныеДействияПослеПоиска.Вставить("АС_ОбновитьСтатистикуВыделенияСпискаЗапасов", Истина);
	ОтключитьОбработчикОжидания("АС_ПроверитьИзменениеОстатков");
	ОтключитьОбработчикОжидания("АС_ОбновитьСтатистикуВыделенияСпискаЗапасов");
	// Один легкий клиентский контроль фокуса вместо таймера для каждого действия.
	ПодключитьОбработчикОжидания("АС_ВозобновитьФоновыеДействияПослеПоиска", 1, Ложь);

КонецПроцедуры

&НаКлиенте
Процедура АС_ВозобновитьФоновыеДействияПослеПоиска()

	Если АС_ВводитсяСтрокаПоиска() Тогда
		Возврат;
	КонецЕсли;

	ОтключитьОбработчикОжидания("АС_ВозобновитьФоновыеДействияПослеПоиска");
	АС_ФоновыеДействияПоискаПриостановлены = Ложь;
	ОтложенныеДействия = АС_ОтложенныеДействияПослеПоиска;
	АС_ОтложенныеДействияПослеПоиска = Неопределено;
	Если ОтложенныеДействия = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Действие Из ОтложенныеДействия Цикл
		Если Действие.Ключ = "АС_ПроверитьИзменениеОстатков" Тогда
			ПодключитьОбработчикОжидания(Действие.Ключ, 60, Истина);
		ИначеЕсли Действие.Ключ = "АС_ОбновитьСтатистикуВыделенияСпискаЗапасов" Тогда
			ПодключитьОбработчикОжидания(Действие.Ключ, 1, Ложь);
		Иначе
			ПодключитьОбработчикОжидания(Действие.Ключ, 0.2, Истина);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура АС_ОбработатьОтложенныеОповещенияПоиска()

	Если АС_ОтложитьФоновоеДействиеПриВводеПоиска("АС_ОбработатьОтложенныеОповещенияПоиска") Тогда
		Возврат;
	КонецЕсли;
	Если АС_ОтложенныеОповещенияПриВводеПоиска = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Оповещения = АС_ОтложенныеОповещенияПриВводеПоиска;
	АС_ОтложенныеОповещенияПриВводеПоиска = Неопределено;
	АС_ВыполняетсяПакетОповещений = Истина;
	Попытка
		Для Каждого Оповещение Из Оповещения Цикл
			Данные = Оповещение.Значение;
			// Сохраняем штатную обработку каждого вида уведомления.
			ОбработкаОповещения(Данные.ИмяСобытия, Данные.Параметр, Данные.Источник);
		КонецЦикла;
	Исключение
		АС_ВыполняетсяПакетОповещений = Ложь;
		ВызватьИсключение;
	КонецПопытки;
	АС_ВыполняетсяПакетОповещений = Ложь;
	Если Оповещения.Получить("АС_ИзмененыНастройкиИндикацииОстатков") <> Неопределено Тогда
		АС_ПерестроитьОформлениеЗаканчивающихсяТоваров();
	КонецЕсли;
	ИзмененаКарточка = Оповещения.Получить("Запись_Номенклатура") <> Неопределено;
	Если ИзмененаКарточка Тогда
		АС_СброситьКэшOEMАналогов();
	КонецЕсли;
	АС_АктуализироватьСписокЗапасовПослеЗаписи("АС_ПакетИзменений", Неопределено);
	Если ИзмененаКарточка Или Оповещения.Получить("Запись_Файл") <> Неопределено Тогда
		ОбновитьДанныеПоНоменклатуреКлиент();
	Иначе
		ОбновитьОстаткиПоНоменклатуреКлиент();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&Вместо("ОбновитьДанныеПоНоменклатуреКлиент")
Процедура АС_ОбновитьДанныеПоНоменклатуреКлиентПриВводеПоиска()

	Если АС_ОтложитьФоновоеДействиеПриВводеПоиска("ОбновитьДанныеПоНоменклатуреКлиент") Тогда
		Возврат;
	КонецЕсли;
	ПродолжитьВызов();

КонецПроцедуры

