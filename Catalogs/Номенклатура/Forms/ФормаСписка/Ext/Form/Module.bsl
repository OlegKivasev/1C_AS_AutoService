&НаКлиенте
Перем АС_ПоискПоАртикулуПрименен;

&НаКлиенте
&После("СписокЗапасыПриАктивизацииСтроки")
Процедура АС_СписокЗапасыПриАктивизацииСтрокиПосле(Элемент)

	ПодключитьОбработчикОжидания("АС_ОбновитьOEMАналогиКлиент", 0.5, Истина);

КонецПроцедуры

&НаКлиенте
Процедура АС_ОбновитьOEMАналогиКлиент()

	ТекущиеДанные = Элементы.СписокЗапасы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено
		Или Не ТекущиеДанные.Свойство("Ссылка") Тогда
		АС_НадписьOEMАналоги = "OEM не указан";
		Возврат;
	КонецЕсли;

	АС_ОбновитьOEMАналогиНаСервере(ТекущиеДанные.Ссылка);

КонецПроцедуры

&НаСервере
Процедура АС_ОбновитьOEMАналогиНаСервере(Номенклатура)

	Информация = АС_НоменклатураСервер.ИнформацияПоOEMАналогам(Номенклатура);
	Если Не Информация.ЕстьOEM Тогда
		АС_НадписьOEMАналоги = "OEM не указан";
	ИначеЕсли Не Информация.ЕстьКлючиOEM Тогда
		АС_НадписьOEMАналоги = "OEM не распознан";
	ИначеЕсли Информация.Количество = 0 Тогда
		АС_НадписьOEMАналоги = "Аналоги по OEM не найдены";
	Иначе
		АС_НадписьOEMАналоги = "Аналоги по OEM: " + Строка(Информация.Количество);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_OEMАналогиНажатие(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.СписокЗапасы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено
		Или Не ТекущиеДанные.Свойство("Ссылка") Тогда
		Возврат;
	КонецЕсли;

	Если Не АС_ЕстьOEMАналогиНаСервере(ТекущиеДанные.Ссылка) Тогда
		АС_ОбновитьOEMАналогиНаСервере(ТекущиеДанные.Ссылка);
		ПоказатьПредупреждение(, АС_НадписьOEMАналоги);
		Возврат;
	КонецЕсли;

	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("Номенклатура", ТекущиеДанные.Ссылка);
	СкладОстатков = ?(ОтборОстатки = 1, ОтборСклад, Неопределено);
	ПараметрыОткрытия.Вставить("Склад", СкладОстатков);
	ОткрытьФорму(
		"ОбщаяФорма.АС_OEMАналоги",
		ПараметрыОткрытия,
		ЭтотОбъект, , , , ,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_ЕстьOEMАналогиНаСервере(Номенклатура)

	Информация = АС_НоменклатураСервер.ИнформацияПоOEMАналогам(Номенклатура);
	Возврат Информация.Количество > 0;

КонецФункции

&НаКлиенте
&Вместо("СтрокаРасширенногоПоискаПриИзменении")
Процедура АС_СтрокаРасширенногоПоискаПриИзменении(Элемент)

	// Непустой текст ищем при окончании ввода (Enter), а не при потере фокуса.
	Если ПустаяСтрока(АС_СтрокаПоискаАртикула) Тогда
		АС_СброситьПоискПоАртикулу();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_СтрокаПоискаАртикулаИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)

	// При наборе и частичном удалении текста сервер не вызывается.
	Если ПустаяСтрока(Текст) Тогда
		АС_СброситьПоискПоАртикулу();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_СтрокаПоискаАртикулаОкончаниеВводаТекста(
	Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	АС_СтрокаПоискаАртикула = Текст;
	Если ПустаяСтрока(Текст) Тогда
		АС_СброситьПоискПоАртикулу();
		Возврат;
	КонецЕсли;

	АС_ПрименитьПоискПоАртикулуНаСервере();
	АС_ПоискПоАртикулуПрименен = Истина;

КонецПроцедуры

&НаКлиенте
Процедура АС_СтрокаПоискаАртикулаОчистка(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	АС_СброситьПоискПоАртикулу();

КонецПроцедуры

&НаКлиенте
Процедура АС_СброситьПоискПоАртикулу()

	АС_СтрокаПоискаАртикула = "";
	// Очистка может породить несколько событий поля: снимаем отбор один раз.
	Если АС_ПоискПоАртикулуПрименен = Истина Тогда
		АС_ПрименитьПоискПоАртикулуНаСервере();
		АС_ПоискПоАртикулуПрименен = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаСервере
&После("УстановитьВидимостьИДоступность")
Процедура АС_УстановитьВидимостьИДоступностьПосле(ЭтоСозданиеФормы = Ложь)

	Если ОтборОстатки = 3 Или ОтборОстатки = 4 Тогда
		ОтборОстатки = 0;
	КонецЕсли;

	Если Элементы.Найти("АС_ОстатокСУчетомЗаказов") <> Неопределено Тогда
		Элементы.АС_ОстатокСУчетомЗаказов.Видимость =
			ТекущаяСтраницаНоменклатуры = "СписокЗапасы" И ПоказыватьОстатки;
	КонецЕсли;

	Элементы.СтрокаРасширенногоПоиска.Видимость = Истина;
	Элементы.СписокЗапасыСтандартныйПоиск.Видимость = Ложь;
	Элементы.ЗапасыУправлениеПоиском.Видимость = Ложь;

КонецПроцедуры

&НаСервере
&После("ПереопределитьТекстЗапросаСписокЗапасы")
Процедура АС_ПереопределитьТекстЗапросаСписокЗапасыПосле()

	ТекстЗапроса = СписокЗапасы.ТекстЗапроса;
	ПредставлениеОбычногоОстатка =
		"ЕСТЬNULL(ОстаткиТоваров.Количество, 0) КАК КоличествоОстаток";
	Если СтрНайти(ТекстЗапроса, ПредставлениеОбычногоОстатка) = 0 Тогда
		ТекстЗапроса = СтрЗаменить(
			ТекстЗапроса,
			"0 КАК КоличествоОстаток",
			"0 КАК КоличествоОстаток," + Символы.ПС
			+ "    0 КАК АС_ОстатокСУчетомЗаказов");
		СписокЗапасы.ТекстЗапроса = ТекстЗапроса;
		Возврат;
	КонецЕсли;

	ВыражениеДоступногоОстатка =
		"ЕСТЬNULL(ОстаткиТоваров.Количество, 0)"
		+ " + ЕСТЬNULL(ОстаткиТоваров.Резерв, 0)"
		+ " - ЕСТЬNULL(АС_АктивныеЗаказы.Количество, 0)";
	ВыражениеКолонки =
		"ВЫБОР КОГДА " + ВыражениеДоступногоОстатка + " > 0" + Символы.ПС
		+ "        ТОГДА " + ВыражениеДоступногоОстатка + Символы.ПС
		+ "    ИНАЧЕ 0 КОНЕЦ КАК АС_ОстатокСУчетомЗаказов";

	ТекстЗапроса = СтрЗаменить(
		ТекстЗапроса,
		ПредставлениеОбычногоОстатка,
		ПредставлениеОбычногоОстатка + "," + Символы.ПС + "    " + ВыражениеКолонки);

	ТекстЗапроса = СтрЗаменить(
		ТекстЗапроса,
		"ПО СправочникНоменклатура.Ссылка = ОстаткиТоваров.Номенклатура",
		"ПО СправочникНоменклатура.Ссылка = ОстаткиТоваров.Номенклатура" + Символы.ПС
		+ "        ЛЕВОЕ СОЕДИНЕНИЕ АС_АктивныеЗаказы КАК АС_АктивныеЗаказы" + Символы.ПС
		+ "        ПО СправочникНоменклатура.Ссылка = АС_АктивныеЗаказы.Номенклатура");

	ВТАктивныеЗаказы =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|    ЗаказыПокупателейОстатки.Номенклатура КАК Номенклатура,
	|    СУММА(ЗаказыПокупателейОстатки.КоличествоОстаток) КАК Количество
	|ПОМЕСТИТЬ АС_АктивныеЗаказы
	|ИЗ
	|    РегистрНакопления.ЗаказыПокупателей.Остатки(
	|            ,
	|            (&ВсеСклады ИЛИ Склад В (&Склад))
	|                И (&ВсеОрганизации ИЛИ Организация В (&Организация))
	|                И (&БезОтбора ИЛИ Характеристика В (&Характеристика))) КАК ЗаказыПокупателейОстатки
	|ГДЕ
	|    ЗаказыПокупателейОстатки.КоличествоОстаток > 0
	|СГРУППИРОВАТЬ ПО
	|    ЗаказыПокупателейОстатки.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|";

	СписокЗапасы.ТекстЗапроса = ВТАктивныеЗаказы + ТекстЗапроса;

КонецПроцедуры

&НаСервере
&После("ПриСозданииНаСервере")
Процедура АС_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)

	Для НомерВарианта = 3 По 4 Цикл
		ВариантОтбора = Элементы.ОтборОстатки.СписокВыбора.НайтиПоЗначению(НомерВарианта);
		Если ВариантОтбора <> Неопределено Тогда
			Элементы.ОтборОстатки.СписокВыбора.Удалить(ВариантОтбора);
		КонецЕсли;
	КонецЦикла;
	Если ОтборОстатки = 3 Или ОтборОстатки = 4 Тогда
		ОтборОстатки = 0;
	КонецЕсли;

	ИмяКолонки = "АС_ОстатокСУчетомЗаказов";
	Если Элементы.Найти(ИмяКолонки) = Неопределено Тогда
		Колонка = Элементы.Добавить(ИмяКолонки, Тип("ПолеФормы"), Элементы.СписокЗапасы);
		Колонка.Вид = ВидПоляФормы.ПолеВвода;
		Колонка.ПутьКДанным = "СписокЗапасы.АС_ОстатокСУчетомЗаказов";
		Колонка.Заголовок = "С учетом" + Символы.ПС + "заказов";
		Колонка.Подсказка = "Физический остаток за вычетом товаров в активных заказах покупателей и заказ-нарядах";
		Колонка.ТолькоПросмотр = Истина;
		Колонка.Ширина = 9;
		Колонка.Формат = "ЧН=0; ЧДЦ=3";
		Колонка.Видимость = ПоказыватьОстатки;
		Элементы.Переместить(Колонка, Элементы.СписокЗапасы, Элементы.КартинкаОстатки);
	КонецЕсли;

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяКолонки);
	ОформляемоеПоле.Использование = Истина;

	ОтборПоОстатку = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборПоОстатку.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СписокЗапасы.АС_ОстатокСУчетомЗаказов");
	ОтборПоОстатку.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборПоОстатку.ПравоеЗначение = 0;
	ОтборПоОстатку.Использование = Истина;

	ОтборПоТипу = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборПоТипу.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СписокЗапасы.ТипНоменклатуры");
	ОтборПоТипу.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборПоТипу.ПравоеЗначение = Перечисления.ТипыНоменклатуры.Запас;
	ОтборПоТипу.Использование = Истина;

	ЦветТекста = ЭлементОформления.Оформление.Элементы.Найти("ЦветТекста");
	ЦветТекста.Значение = WebЦвета.Красный;
	ЦветТекста.Использование = Истина;

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяКолонки);
	ОформляемоеПоле.Использование = Истина;

	ОтборПоОбычномуОстатку =
		ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборПоОбычномуОстатку.ЛевоеЗначение =
		Новый ПолеКомпоновкиДанных("СписокЗапасы.КоличествоОстаток");
	ОтборПоОбычномуОстатку.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборПоОбычномуОстатку.ПравоеЗначение = 0;
	ОтборПоОбычномуОстатку.Использование = Истина;

	Текст = ЭлементОформления.Оформление.Элементы.Найти("Текст");
	Текст.Значение = "";
	Текст.Использование = Истина;

КонецПроцедуры

&НаСервере
Процедура АС_ПрименитьПоискПоАртикулуНаСервере()

	Если ПустаяСтрока(СокрЛП(АС_СтрокаПоискаАртикула)) Тогда
		ПодборПоискНеУдачный = Ложь;
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
			ЭтотОбъект[ТекущаяСтраницаНоменклатуры], "Номенклатура", , , , Ложь);
		Возврат;
	КонецЕсли;

	ИсходнаяСтрокаПоиска = СтрокаРасширенногоПоиска;
	ИсходныйРежимПоиска = НастройкиПоискаКакИскать;
	СтрокаРасширенногоПоиска = АС_СтрокаПоискаАртикула;
	НастройкиПоискаКакИскать = 1;

	Попытка
		ПоискПоПодстроке();
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		СтрокаРасширенногоПоиска = ИсходнаяСтрокаПоиска;
		НастройкиПоискаКакИскать = ИсходныйРежимПоиска;
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;

	СтрокаРасширенногоПоиска = ИсходнаяСтрокаПоиска;
	НастройкиПоискаКакИскать = ИсходныйРежимПоиска;

КонецПроцедуры

&НаСервере
&Вместо("РезультатПоискаПоПодстроке")
Функция АС_РезультатПоискаПоПодстроке(СтрокаРасширенногоПоиска)
	
	МассивНоменклатуры = ПродолжитьВызов(СтрокаРасширенногоПоиска);
	ВариантыСинонимов = АС_СинонимыПоискаСервер.ВариантыСтрокиПоиска(СтрокаРасширенногоПоиска);
	Если ВариантыСинонимов.Количество() > 1 Тогда
		НайденнаяНоменклатура = АС_СинонимыПоискаСервер.НайтиНоменклатуруПоВариантам(ВариантыСинонимов);
		Для Каждого Номенклатура Из НайденнаяНоменклатура Цикл
			Если МассивНоменклатуры.Найти(Номенклатура) = Неопределено Тогда
				МассивНоменклатуры.Добавить(Номенклатура);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	АС_ДополнитьРезультатПоискаПоТочкамИЗапятым(
		МассивНоменклатуры, СтрокаРасширенногоПоиска);
	АС_ДополнитьРезультатПоискаПоОтдельнымСловам(
		МассивНоменклатуры, СтрокаРасширенногоПоиска);
	КлючАртикула = АС_НоменклатураСервер.КомпактныйКлючАртикула(СтрокаРасширенногоПоиска);
	
	Если ПустаяСтрока(КлючАртикула) Тогда
		Возврат МассивНоменклатуры;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("КлючАртикула", "%" + КлючАртикула + "%");
	Запрос.УстановитьПараметр("МассивНоменклатуры", МассивНоменклатуры);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	| 	Номенклатура.Ссылка КАК Номенклатура
	|ИЗ
	| 	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	| 	НЕ Номенклатура.Ссылка В (&МассивНоменклатуры)
	| 	И Номенклатура.АС_АртикулДляПоиска ПОДОБНО &КлючАртикула";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МассивНоменклатуры.Добавить(Выборка.Номенклатура);
	КонецЦикла;
	
	Возврат МассивНоменклатуры;
	
КонецФункции

&НаСервере
Процедура АС_ДополнитьРезультатПоискаПоТочкамИЗапятым(МассивНоменклатуры, СтрокаПоиска)

	Если СтрНайти(СтрокаПоиска, ".") = 0
		И СтрНайти(СтрокаПоиска, ",") = 0 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивНоменклатуры", МассивНоменклатуры);
	Запрос.УстановитьПараметр(
		"СтрокаПоиска", АС_ШаблонПоискаСУчетомРазделителя(СтрокаПоиска));
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	| 	Номенклатура.Ссылка КАК Номенклатура
	|ИЗ
	| 	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	| 	НЕ Номенклатура.Ссылка В (&МассивНоменклатуры)
	| 	И (Номенклатура.Наименование ПОДОБНО &СтрокаПоиска
	| 		ИЛИ Номенклатура.НаименованиеПолное ПОДОБНО &СтрокаПоиска)";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МассивНоменклатуры.Добавить(Выборка.Номенклатура);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура АС_ДополнитьРезультатПоискаПоОтдельнымСловам(МассивНоменклатуры, СтрокаПоиска)

	СтрокаПоиска = СтрЗаменить(СтрокаПоиска, Символы.Таб, " ");
	СтрокаПоиска = СтрЗаменить(СтрокаПоиска, Символы.ВК, " ");
	СтрокаПоиска = СтрЗаменить(СтрокаПоиска, Символы.ПС, " ");
	ЧастиПоиска = СтрРазделить(СокрЛП(СтрокаПоиска), " ", Ложь);
	Если ЧастиПоиска.Количество() < 2 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивНоменклатуры", МассивНоменклатуры);
	УсловияПоискаПоНаименованию = Новый Массив;
	УсловияПоискаПоПолномуНаименованию = Новый Массив;
	Для Индекс = 0 По ЧастиПоиска.ВГраница() Цикл
		ИмяПараметра = "ЧастьПоиска" + Строка(Индекс);
		Запрос.УстановитьПараметр(
			ИмяПараметра, АС_ШаблонПоискаСУчетомРазделителя(ЧастиПоиска[Индекс]));
		УсловияПоискаПоНаименованию.Добавить(
			"Номенклатура.Наименование ПОДОБНО &" + ИмяПараметра);
		УсловияПоискаПоПолномуНаименованию.Добавить(
			"Номенклатура.НаименованиеПолное ПОДОБНО &" + ИмяПараметра);
	КонецЦикла;

	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	| 	Номенклатура.Ссылка КАК Номенклатура
	|ИЗ
	| 	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	| 	НЕ Номенклатура.ЭтоГруппа
	| 	И НЕ Номенклатура.Ссылка В (&МассивНоменклатуры)
	| 	И (" + СтрСоединить(УсловияПоискаПоНаименованию, " И ")
		+ " ИЛИ " + СтрСоединить(УсловияПоискаПоПолномуНаименованию, " И ") + ")";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МассивНоменклатуры.Добавить(Выборка.Номенклатура);
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_ШаблонПоискаСУчетомРазделителя(СтрокаПоиска)

	ШаблонПоиска = "";
	Для Позиция = 1 По СтрДлина(СтрокаПоиска) Цикл
		СимволСтроки = Сред(СтрокаПоиска, Позиция, 1);
		Если СимволСтроки = "." Или СимволСтроки = "," Тогда
			ШаблонПоиска = ШаблонПоиска + "[.,]";
		Иначе
			ШаблонПоиска = ШаблонПоиска + СимволСтроки;
		КонецЕсли;
	КонецЦикла;

	Возврат "%" + ШаблонПоиска + "%";

