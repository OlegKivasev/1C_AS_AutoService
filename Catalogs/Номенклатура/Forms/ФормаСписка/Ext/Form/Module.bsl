КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_ПолучитьСписокАвтомобилейДляОтбора(ВыбиратьМарки, Марка)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	| 	Автомобили.Ссылка КАК Ссылка,
	| 	Автомобили.Наименование КАК Наименование,
	| 	Автомобили.Родитель КАК Родитель
	|ИЗ
	| 	Справочник.АС_Автомобили КАК Автомобили
	|ГДЕ
	| 	Автомобили.ЭтоГруппа = &ВыбиратьМарки
	| 	И НЕ Автомобили.ПометкаУдаления";
	Запрос.УстановитьПараметр("ВыбиратьМарки", ВыбиратьМарки);
	Если Не ВыбиратьМарки И ЗначениеЗаполнено(Марка) Тогда
		Запрос.Текст = Запрос.Текст + Символы.ПС + "И Автомобили.Родитель = &Марка";
		Запрос.УстановитьПараметр("Марка", Марка);
	КонецЕсли;
	Запрос.Текст = Запрос.Текст + Символы.ПС + "УПОРЯДОЧИТЬ ПО Автомобили.Наименование";

	Результат = Новый СписокЗначений;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ВыбиратьМарки Тогда
			Представление = Выборка.Наименование;
		Иначе
			Представление = Строка(Выборка.Родитель) + " " + Выборка.Наименование;
		КонецЕсли;
		Результат.Добавить(Выборка.Ссылка, Представление);
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция АС_ПолучитьАвтомобилиДляАвтоПодбора(Текст, ВыбиратьМарки, Марка)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 20
	| 	Автомобили.Ссылка КАК Ссылка,
	| 	Автомобили.Наименование КАК Наименование,
	| 	Автомобили.Родитель КАК Родитель
	|ИЗ
	| 	Справочник.АС_Автомобили КАК Автомобили
	|ГДЕ
	| 	Автомобили.ЭтоГруппа = &ВыбиратьМарки
	| 	И НЕ Автомобили.ПометкаУдаления
	| 	И (Автомобили.Наименование ПОДОБНО &СтрокаПоиска
	| 		ИЛИ Автомобили.АС_Синонимы ПОДОБНО &СтрокаПоиска)";
	Запрос.УстановитьПараметр("ВыбиратьМарки", ВыбиратьМарки);
	Запрос.УстановитьПараметр("СтрокаПоиска", "%" + СокрЛП(Текст) + "%");
	Если Не ВыбиратьМарки И ЗначениеЗаполнено(Марка) Тогда
		Запрос.Текст = Запрос.Текст + Символы.ПС + "И Автомобили.Родитель = &Марка";
		Запрос.УстановитьПараметр("Марка", Марка);
	КонецЕсли;
	Запрос.Текст = Запрос.Текст + Символы.ПС + "УПОРЯДОЧИТЬ ПО Автомобили.Наименование";

	Результат = Новый СписокЗначений;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ВыбиратьМарки Тогда
			Представление = Выборка.Наименование;
		Иначе
			Представление = Строка(Выборка.Родитель) + " " + Выборка.Наименование;
		КонецЕсли;
		Результат.Добавить(Выборка.Ссылка, Представление);
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция АС_ПолучитьМаркуМодели(Модель)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		| 	Автомобили.Родитель КАК Марка
		|ИЗ
		| 	Справочник.АС_Автомобили КАК Автомобили
		|ГДЕ
		| 	Автомобили.Ссылка = &Модель
		| 	И НЕ Автомобили.ЭтоГруппа");
	Запрос.УстановитьПараметр("Модель", Модель);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Марка;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

&НаКлиенте
Процедура АС_ПрименитьОтборПоАвтомобилю(ТекстOEM = Неопределено)

	Если ТекстOEM = Неопределено Тогда
		ТекстOEM = АС_ПримененныйОтборOEM;
	КонецЕсли;
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Марка", АС_ОтборМарка);
	ПараметрыОтбора.Вставить("Модель", АС_ОтборМодель);
	ПараметрыОтбора.Вставить("Год", АС_ОтборГод);
	ПараметрыОтбора.Вставить("Бренд", АС_ОтборБренд);
	ПараметрыОтбора.Вставить("ПоступившиеЗаПериод", АС_ПоступившиеЗаПериод);
	ПараметрыОтбора.Вставить("ПроданныеЗаПериод", АС_ПроданныеЗаПериод);
	ПараметрыОтбора.Вставить("Изображение", АС_БезФотографии);
	ПараметрыОтбора.Вставить("OEMАртикулы", АС_OEMАртикулы);
	ПараметрыОтбора.Вставить("ЕстьАналоги", АС_ЕстьАналоги);
	ПараметрыОтбора.Вставить("Применяемость", АС_Применяемость);
	ПараметрыОтбора.Вставить("Документы", АС_БезДокументов);
	ПараметрыОтбора.Вставить("ОтборДокументы", АС_ОтборДокументы);
	ПараметрыОтбора.Вставить("ОтборИзображение", АС_ОтборИзображение);
	ПараметрыОтбора.Вставить("ОтборOEMАртикулы", АС_ОтборOEMАртикулы);
	ПараметрыОтбора.Вставить("МаркаOEMАртикулов", АС_ОтборOEMАртикулыМарка);
	ПараметрыОтбора.Вставить("ОтборЕстьАналоги", АС_ОтборЕстьАналоги);
	ПараметрыОтбора.Вставить("ОтборПрименяемость", АС_ОтборПрименяемость);
	ПараметрыОтбора.Вставить("ДатаПоступленияС", АС_ДатаПоступленияС);
	ПараметрыОтбора.Вставить("ДатаПоступленияПо", АС_ДатаПоступленияПо);
	ПараметрыОтбора.Вставить("ДатаПродажиС", АС_ДатаПродажиС);
	ПараметрыОтбора.Вставить("ДатаПродажиПо", АС_ДатаПродажиПо);
	ПараметрыОтбора.Вставить("OEM", ТекстOEM);
	ПараметрыОтбора.Вставить("МаркаOEM", АС_ОтборOEMМарка);

	// Расчёт получает только параметры отборов и возвращает ссылки для списка.
	СписокНоменклатуры = АС_ПолучитьНоменклатуруПоОтборам(ПараметрыОтбора);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		СписокЗапасы, "Ссылка", СписокНоменклатуры, ВидСравненияКомпоновкиДанных.ВСписке,
		, СписокНоменклатуры <> Неопределено);
	АС_ПримененныйОтборOEM = ТекстOEM;

КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_ПолучитьНоменклатуруПоОтборам(ПараметрыОтбора)

	ЕстьОтборАвтомобиля = ЗначениеЗаполнено(ПараметрыОтбора.Марка)
		Или ЗначениеЗаполнено(ПараметрыОтбора.Модель)
		Или ЗначениеЗаполнено(ПараметрыОтбора.Год);
	ЕстьТоварныеОтборы = ЗначениеЗаполнено(ПараметрыОтбора.Бренд)
		Или ПараметрыОтбора.ПоступившиеЗаПериод
		Или ПараметрыОтбора.ПроданныеЗаПериод
		Или ПараметрыОтбора.Изображение
		Или ПараметрыОтбора.OEMАртикулы
		Или ПараметрыОтбора.Применяемость;
	ЕстьОтборOEM = ЗначениеЗаполнено(ПараметрыОтбора.OEM) Или ЗначениеЗаполнено(ПараметрыОтбора.МаркаOEM);
	Если Не ПараметрыОтбора.Документы И Не ЕстьОтборАвтомобиля И Не ЕстьТоварныеОтборы
		И Не ЕстьОтборOEM И Не ПараметрыОтбора.ЕстьАналоги Тогда
		Возврат Неопределено;
	КонецЕсли;

	СписокНоменклатуры = Неопределено;
	Если ЕстьОтборАвтомобиля Тогда
		СписокНоменклатуры = АС_ПолучитьНоменклатуруПоАвтомобилю(
			ПараметрыОтбора.Марка, ПараметрыОтбора.Модель, ПараметрыОтбора.Год);
	КонецЕсли;

	Если ПараметрыОтбора.Документы Тогда
		СписокБезДокументов = ?(ПараметрыОтбора.ОтборДокументы = 1,
			АС_ПолучитьНоменклатуруБезДокументов(), АС_ПолучитьНоменклатуруСДокументами());
		Если СписокНоменклатуры = Неопределено Тогда
			СписокНоменклатуры = СписокБезДокументов;
		Иначе
			СписокНоменклатуры = АС_ПересечьСпискиНоменклатуры(
				СписокНоменклатуры, СписокБезДокументов);
		КонецЕсли;
	КонецЕсли;

	Если ЕстьТоварныеОтборы Тогда
		СписокПоТоварнымОтборам = АС_ПолучитьНоменклатуруПоТоварнымОтборам(ПараметрыОтбора);
		Если СписокНоменклатуры = Неопределено Тогда
			СписокНоменклатуры = СписокПоТоварнымОтборам;
		Иначе
			СписокНоменклатуры = АС_ПересечьСпискиНоменклатуры(
				СписокНоменклатуры, СписокПоТоварнымОтборам);
		КонецЕсли;
	КонецЕсли;

	Если ЕстьОтборOEM Тогда
		СписокПоOEM = АС_ПолучитьНоменклатуруПоOEM(ПараметрыОтбора.OEM, ПараметрыОтбора.МаркаOEM);
		Если СписокНоменклатуры = Неопределено Тогда
			СписокНоменклатуры = СписокПоOEM;
		Иначе
			СписокНоменклатуры = АС_ПересечьСпискиНоменклатуры(СписокНоменклатуры, СписокПоOEM);
		КонецЕсли;
	КонецЕсли;

	Если ПараметрыОтбора.ЕстьАналоги Тогда
		СписокПоАналогам = АС_ПолучитьНоменклатуруПоНаличиюАналогов(ПараметрыОтбора.ОтборЕстьАналоги);
		Если СписокНоменклатуры = Неопределено Тогда
			СписокНоменклатуры = СписокПоАналогам;
		Иначе
			СписокНоменклатуры = АС_ПересечьСпискиНоменклатуры(СписокНоменклатуры, СписокПоАналогам);
		КонецЕсли;
	КонецЕсли;

	Возврат СписокНоменклатуры;

КонецФункции

&НаСервереБезКонтекста
Функция АС_ПолучитьНоменклатуруПоНаличиюАналогов(ОтборАналоги)

	АС_ИндексOEMСервер.ОбеспечитьИндекс();
	// Считаем разные товары по ключу OEM, чтобы не строить все пары аналогов.
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|ИндексOEM.КлючOEM КАК КлючOEM
		|ПОМЕСТИТЬ OEMСАналогами
		|ИЗ РегистрСведений.АС_ИндексOEMНоменклатуры КАК ИндексOEM
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Товары
		|ПО ИндексOEM.Номенклатура = Товары.Ссылка
		|ГДЕ НЕ Товары.ЭтоГруппа
		|И НЕ Товары.ПометкаУдаления
		|И НЕ Товары.Недействителен
		|И Товары.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)
		|СГРУППИРОВАТЬ ПО ИндексOEM.КлючOEM
		|ИМЕЮЩИЕ КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ИндексOEM.Номенклатура) > 1
		|ИНДЕКСИРОВАТЬ ПО КлючOEM
		|;
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|ИндексOEM.Номенклатура КАК Номенклатура
		|ПОМЕСТИТЬ ТоварыСАналогами
		|ИЗ РегистрСведений.АС_ИндексOEMНоменклатуры КАК ИндексOEM
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ OEMСАналогами КАК ОбщиеOEM
		|ПО ИндексOEM.КлючOEM = ОбщиеOEM.КлючOEM
		|ИНДЕКСИРОВАТЬ ПО Номенклатура
		|;
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|ТоварыСписка.Ссылка КАК Номенклатура
		|ИЗ Справочник.Номенклатура КАК ТоварыСписка
		|ЛЕВОЕ СОЕДИНЕНИЕ ТоварыСАналогами КАК САналогами
		|ПО ТоварыСписка.Ссылка = САналогами.Номенклатура
		|ГДЕ НЕ ТоварыСписка.ЭтоГруппа
		|И ТоварыСписка.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)
		|И ((&ЕстьАналоги И НЕ САналогами.Номенклатура ЕСТЬ NULL)
		| ИЛИ (НЕ &ЕстьАналоги И САналогами.Номенклатура ЕСТЬ NULL))");
	Запрос.УстановитьПараметр("ЕстьАналоги", ОтборАналоги <> 1);
	Результат = Новый СписокЗначений;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Номенклатура);
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция АС_ПолучитьНоменклатуруПоOEM(OEM, Марка)

	Результат = Новый СписокЗначений;
	ЕстьOEM = ЗначениеЗаполнено(OEM);
	КлючOEM = АС_ИндексOEMСервер.НормализоватьOEM(OEM);
	Если ЕстьOEM И ПустаяСтрока(КлючOEM) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|  OEMПоМаркам.Ссылка КАК Номенклатура,
		|  OEMПоМаркам.OEM КАК OEM
		|ИЗ Справочник.Номенклатура.АС_OEMПоМаркам КАК OEMПоМаркам
		|ГДЕ OEMПоМаркам.OEM <> """"");
	Если ЕстьOEM Тогда
		АС_ИндексOEMСервер.ОбеспечитьИндекс();
		// Индекс включает старое поле OEM: ниже сверяем именно строку таблицы карточки.
		Запрос.Текст = Запрос.Текст + Символы.ПС
			+ "И OEMПоМаркам.Ссылка В (" + Символы.ПС
			+ "ВЫБРАТЬ ИндексOEM.Номенклатура" + Символы.ПС
			+ "ИЗ РегистрСведений.АС_ИндексOEMНоменклатуры КАК ИндексOEM" + Символы.ПС
			+ "ГДЕ ИндексOEM.КлючOEM = &КлючOEM)";
		Запрос.УстановитьПараметр("КлючOEM", КлючOEM);
	КонецЕсли;
	Если ЗначениеЗаполнено(Марка) Тогда
		Запрос.Текст = Запрос.Текст + Символы.ПС + "И OEMПоМаркам.Марка = &Марка";
		Запрос.УстановитьПараметр("Марка", Марка);
	КонецЕсли;

	НайденныеСсылки = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЕстьOEM И АС_ИндексOEMСервер.НормализоватьOEM(Выборка.OEM) <> КлючOEM Тогда
			Продолжить;
		КонецЕсли;
		Если НайденныеСсылки.Получить(Выборка.Номенклатура) = Неопределено Тогда
			НайденныеСсылки.Вставить(Выборка.Номенклатура, Истина);
			Результат.Добавить(Выборка.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция АС_ПересечьСпискиНоменклатуры(ПервыйСписок, ВторойСписок)

	ЗначенияВторогоСписка = Новый Соответствие;
	Для Каждого ЗначениеСписка Из ВторойСписок Цикл
		ЗначенияВторогоСписка.Вставить(ЗначениеСписка.Значение, Истина);
	КонецЦикла;

	Результат = Новый СписокЗначений;
	Для Каждого ЗначениеСписка Из ПервыйСписок Цикл
		Если ЗначенияВторогоСписка.Получить(ЗначениеСписка.Значение) <> Неопределено Тогда
			Результат.Добавить(ЗначениеСписка.Значение, ЗначениеСписка.Представление);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

