&НаКлиенте
Асинх Функция АС_КопироватьПолеНоменклатуры(ИмяПоля)

	ТекущиеДанные = Элементы.СписокЗапасы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Сообщить("Выберите строку номенклатуры для копирования.");
		Возврат Ложь;
	КонецЕсли;
	ТекстКопирования = Строка(ТекущиеДанные[ИмяПоля]);
	Если ПустаяСтрока(ТекстКопирования) Тогда
		Сообщить(?(ИмяПоля = "Артикул",
			"У выбранной номенклатуры не заполнен артикул.",
			"У выбранной номенклатуры не заполнено наименование."));
		Возврат Ложь;
	КонецЕсли;

	Попытка
		Если Не СредстваБуфераОбмена.ИспользованиеДоступно() Тогда
			Сообщить("Копирование в буфер обмена недоступно в текущем клиенте.");
			Возврат Ложь;
		КонецЕсли;
		ФорматДанных = СтандартныйФорматДанныхБуфераОбмена.Текст;
		Если Не (Ждать СредстваБуфераОбмена.ПоддерживаетсяФорматДанных(ФорматДанных)) Тогда
			Сообщить("Копирование текста в буфер обмена недоступно.");
			Возврат Ложь;
		КонецЕсли;
		ПомещаемыеДанные = Новый ЭлементБуфераОбмена(ФорматДанных, ТекстКопирования);
		Если Не (Ждать СредстваБуфераОбмена.ПоместитьДанныеАсинх(ПомещаемыеДанные)) Тогда
			Сообщить("Не удалось скопировать текст в буфер обмена.");
			Возврат Ложь;
		КонецЕсли;
		Возврат Истина;
	Исключение
		Сообщить("Не удалось скопировать текст в буфер обмена: " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;

КонецФункции

&НаКлиенте
Процедура АС_СделатьВзаимозаменяемыми(Команда)

	ТекущиеДанные = Элементы.СписокЗапасы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Или Не ЗначениеЗаполнено(ТекущиеДанные.Ссылка) Тогда
		ПоказатьПредупреждение(, "Выберите основной товар в списке.");
		Возврат;
	КонецЕсли;
	ОсновнойТовар = ТекущиеДанные.Ссылка;
	ВыделенныеТовары = Новый Массив;
	Для Каждого ВыделеннаяСтрока Из Элементы.СписокЗапасы.ВыделенныеСтроки Цикл
		Если ТипЗнч(ВыделеннаяСтрока) = Тип("СправочникСсылка.Номенклатура") Тогда
			ВыделенныеТовары.Добавить(ВыделеннаяСтрока);
		КонецЕсли;
	КонецЦикла;
	Если ВыделенныеТовары.Количество() < 2 Тогда
		ПоказатьПредупреждение(, "Выделите как минимум два товара.");
		Возврат;
	КонецЕсли;

	Результат = АС_СделатьВзаимозаменяемымиНаСервере(ОсновнойТовар, ВыделенныеТовары);
	Если Не ПустаяСтрока(Результат.Сообщение) Тогда
		ПоказатьПредупреждение(, Результат.Сообщение);
		Возврат;
	КонецЕсли;
	Элементы.СписокЗапасы.Обновить();
	Оповестить("АС_ИзмененыВзаимозаменяемыеТовары", ОсновнойТовар, ЭтаФорма);
	Сообщить(СтрШаблон("Для товара «%1» сохранены взаимозаменяемые товары: %2.",
		Строка(ОсновнойТовар), Результат.Количество));

КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_СделатьВзаимозаменяемымиНаСервере(ОсновнойТовар, ВыделенныеТовары)

	Возврат АС_НоменклатураСервер.ДобавитьВыделенныеВзаимозаменяемыеТовары(
		ОсновнойТовар, ВыделенныеТовары);

КонецФункции

&НаКлиенте
Функция АС_ФоновоеОповещениеСписка(ИмяСобытия)

	Возврат Лев(ИмяСобытия, 7) = "Запись_"
		Или Лев(ИмяСобытия, 19) = "ИзменениеСостояния_"
		Или ИмяСобытия = "АС_Запись_ПриходнаяНакладная"
		Или ИмяСобытия = "АС_Запись_ЗаказПоставщикуБезЗаказа"
		Или ИмяСобытия = "ОбновитьФормуСпискаДокументовЧекККМ"
		Или ИмяСобытия = "АС_ИзмененыПродажиЧекамиККМ"
		Или ИмяСобытия = "АС_ИзмененыНастройкиИндикацииОстатков"
		Или ИмяСобытия = "АС_ИзмененыВзаимозаменяемыеТовары";

