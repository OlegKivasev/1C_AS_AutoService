&НаКлиенте
Перем АС_ВидимостьДоУслуги;

&НаКлиенте
Перем АС_ПоказыватьВсеПоля;

&НаКлиенте
Перем АС_ПоследнееАвтоматическоеНаименованиеФильтра;

&НаКлиенте
&После("ПриОткрытии")
Процедура АС_ПриОткрытииПосле(Отказ)

	АС_ПоказыватьВсеПоля = Ложь;
	АС_ПоследнееАвтоматическоеНаименованиеФильтра = Неопределено;
	АС_УстановитьТипНоменклатурыПоУмолчанию();
	АС_УстановитьПараметрыУслугиПоУмолчанию();
	АС_УстановитьАвтоматическиеПараметрыФильтра();
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
	АС_ОбновитьНаименованиеФильтра();
	КонецЕсли;
	АС_ЗаполнитьПредставленияПрименяемости();
	АС_ЗаполнитьГодыПрименяемости();
	АС_ОграничитьСписокТиповНоменклатуры();
	АС_РазрешитьИзменениеТипаНоменклатуры();
	АС_ОбновитьВидимостьУслуги();
	АС_ОбновитьВидимостьФильтра();

КонецПроцедуры

&НаКлиенте
&После("ТипНоменклатурыПриИзменении")
Процедура АС_ТипНоменклатурыПриИзмененииПосле(Элемент)

	АС_ОграничитьСписокТиповНоменклатуры();
	АС_УстановитьПараметрыУслугиПоУмолчанию();
	АС_УстановитьАвтоматическиеПараметрыФильтра();
	АС_ОбновитьНаименованиеФильтра();
	АС_ОбновитьВидимостьУслуги();
	АС_ОбновитьВидимостьФильтра();

КонецПроцедуры

&НаКлиенте
&После("ПослеЗаписи")
Процедура АС_ПослеЗаписиПосле(ПараметрыЗаписи)

	АС_РазрешитьИзменениеТипаНоменклатуры();

КонецПроцедуры

&НаКлиенте
Процедура АС_КатегорияНоменклатурыПриИзменении(Элемент)

	АС_ОбновитьВидимостьФильтра();
	АС_УстановитьАвтоматическиеПараметрыФильтра();
	АС_ОбновитьНаименованиеФильтра();

КонецПроцедуры

&НаКлиенте
&После("КатегорияНоменклатурыПриИзменении")
Процедура АС_КатегорияНоменклатурыПриИзмененииПосле(Элемент)

	АС_ОбновитьВидимостьФильтра();

КонецПроцедуры

&НаКлиенте
&После("УправлениеФормой")
Процедура АС_УправлениеФормойПосле(ОткрытиеФормы)

	АС_ОбновитьВидимостьФильтра();

КонецПроцедуры

&НаКлиенте
Процедура АС_РеквизитФильтраПриИзменении(Элемент)

	АС_УстановитьАвтоматическиеПараметрыФильтра();
	АС_ОбновитьНаименованиеФильтра();

КонецПроцедуры

&НаКлиенте
Процедура АС_УстановитьАвтоматическиеПараметрыФильтра()

	Если АС_ЭтоФильтр() Тогда
		Объект.ЗапретитьВводДробногоКоличества = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_ОбновитьНаименованиеФильтра()

	Если НЕ АС_ЭтоФильтр() Тогда
		Возврат;
	КонецЕсли;

	ТекущееНаименование = СокрЛП(Строка(Объект.Наименование));
	Если НЕ ПустаяСтрока(ТекущееНаименование)
		И (АС_ПоследнееАвтоматическоеНаименованиеФильтра = Неопределено
		ИЛИ ТекущееНаименование <> АС_ПоследнееАвтоматическоеНаименованиеФильтра) Тогда
		Возврат;
	КонецЕсли;

	ЧастиНаименования = Новый Массив;
	НаименованиеКатегории = СокрЛП(Строка(Объект.КатегорияНоменклатуры));
	Если НРег(НаименованиеКатегории) = "фильтры" Тогда
		НаименованиеКатегории = "Фильтр";
	КонецЕсли;
	ЧастиНаименования.Добавить(НаименованиеКатегории);
	Если ЗначениеЗаполнено(Объект.АС_ТипФильтра) Тогда
		ЧастиНаименования.Добавить(НРег(СокрЛП(Строка(Объект.АС_ТипФильтра))));
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.АС_КонструкцияФильтра) Тогда
		ЧастиНаименования.Добавить(НРег(СокрЛП(Строка(Объект.АС_КонструкцияФильтра))));
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.АС_ВариантИсполненияФильтра) Тогда
		ЧастиНаименования.Добавить(НРег(СокрЛП(Строка(Объект.АС_ВариантИсполненияФильтра))));
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.АС_БрендФильтра) Тогда
		ЧастиНаименования.Добавить(НРег(СокрЛП(Строка(Объект.АС_БрендФильтра))));
	КонецЕсли;

	НовоеНаименование = СтрСоединить(ЧастиНаименования, " ");
	Объект.Наименование = НовоеНаименование;
	Объект.НаименованиеПолное = НовоеНаименование;
	АС_ПоследнееАвтоматическоеНаименованиеФильтра = НовоеНаименование;

КонецПроцедуры

&НаКлиенте
Процедура АС_ПрименяемостьАвтомобильПриИзменении(Элемент)

	СтрокаПрименяемости = Элементы.АС_Применяемость.ТекущиеДанные;
	Если СтрокаПрименяемости = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПредставлениеАвтомобиля = СокрЛП(Строка(СтрокаПрименяемости.АС_АвтомобильПредставление));
	СтрокаПрименяемости.АС_АвтомобильПредставление = ПредставлениеАвтомобиля;
	Если ПустаяСтрока(ПредставлениеАвтомобиля) Тогда
		СтрокаПрименяемости.Автомобиль = Неопределено;
		Возврат;
	КонецЕсли;

	СтрокаПрименяемости.Автомобиль = АС_НайтиАвтомобильПоПредставлению(
		ПредставлениеАвтомобиля);
	Если ЗначениеЗаполнено(СтрокаПрименяемости.Автомобиль) Тогда
		Элементы.АС_Применяемость.ТекущийЭлемент = Элементы.АС_ПрименяемостьГодС;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_ПрименяемостьАвтомобильАвтоПодбор(
	Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)

	Если ПустаяСтрока(СокрЛП(Текст)) Тогда
		Возврат;
	КонецЕсли;

	Ожидание = Ложь;
	ДанныеВыбора = АС_ПолучитьАвтомобилиДляПрименяемости(Текст);
	СтандартнаяОбработка = ДанныеВыбора.Количество() = 0;

КонецПроцедуры

&НаКлиенте
Процедура АС_ПрименяемостьГодСПриИзменении(Элемент)

	СтрокаПрименяемости = Элементы.АС_Применяемость.ТекущиеДанные;
	Если СтрокаПрименяемости = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(СтрокаПрименяемости.ГодС)
		И НЕ ЗначениеЗаполнено(СтрокаПрименяемости.ГодПо) Тогда
		СтрокаПрименяемости.ГодПо = СтрокаПрименяемости.ГодС;
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_ПолучитьАвтомобилиДляПрименяемости(Текст)

	Результат = Новый СписокЗначений;
	Если ПустаяСтрока(СокрЛП(Текст)) Тогда
		Возврат Результат;
	КонецЕсли;

	СтрокаПоиска = СокрЛП(Текст);
	ЧастиПоиска = СтрРазделить(СтрокаПоиска, " ", Ложь);
	Если ЧастиПоиска.Количество() > 1 Тогда
		СтрокаПоиска = ЧастиПоиска[ЧастиПоиска.Количество() - 1];
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 20
		| Автомобили.Ссылка КАК Ссылка,
		| Автомобили.Наименование КАК Наименование,
		| Автомобили.Родитель КАК Родитель
		|ИЗ
		| Справочник.АС_Автомобили КАК Автомобили
		|ГДЕ
		| Автомобили.ЭтоГруппа = ЛОЖЬ
		| И НЕ Автомобили.ПометкаУдаления
		| И (Автомобили.Наименование ПОДОБНО &СтрокаПоиска
		|  ИЛИ Автомобили.АС_Синонимы ПОДОБНО &СтрокаПоиска)
		|УПОРЯДОЧИТЬ ПО Автомобили.Наименование";
	Запрос.УстановитьПараметр("СтрокаПоиска", "%" + СтрокаПоиска + "%");

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Модель = СокрЛП(Строка(Выборка.Наименование));
		Марка = СокрЛП(Строка(Выборка.Родитель));
		Представление = Модель;
		Если НЕ ПустаяСтрока(Марка) Тогда
			Представление = Марка + " " + Модель;
		КонецЕсли;

		Результат.Добавить(Представление, Представление);
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция АС_НайтиАвтомобильПоПредставлению(ПредставлениеАвтомобиля)

	ИскомоеПредставление = СокрЛП(Строка(ПредставлениеАвтомобиля));
	Если ПустаяСтрока(ИскомоеПредставление) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЧастиПредставления = СтрРазделить(ИскомоеПредставление, " ", Ложь);
	МодельДляПоиска = ИскомоеПредставление;
	Если ЧастиПредставления.Количество() > 1 Тогда
		МодельДляПоиска = ЧастиПредставления[ЧастиПредставления.Количество() - 1];
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1000
		| Автомобили.Ссылка КАК Ссылка,
		| Автомобили.Наименование КАК Наименование,
		| Автомобили.Родитель КАК Родитель
		|ИЗ
		| Справочник.АС_Автомобили КАК Автомобили
		|ГДЕ
		| Автомобили.ЭтоГруппа = ЛОЖЬ
		| И НЕ Автомобили.ПометкаУдаления
		| И (Автомобили.Наименование ПОДОБНО &СтрокаПоиска
		|  ИЛИ Автомобили.АС_Синонимы ПОДОБНО &СтрокаПоиска)";
	Запрос.УстановитьПараметр("СтрокаПоиска", "%" + СокрЛП(МодельДляПоиска) + "%");

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Модель = СокрЛП(Строка(Выборка.Наименование));
		Марка = СокрЛП(Строка(Выборка.Родитель));
		ПолноеПредставление = Модель;
		Если НЕ ПустаяСтрока(Марка) Тогда
			ПолноеПредставление = Марка + " " + Модель;
		КонецЕсли;

		Если НРег(ПолноеПредставление) = НРег(ИскомоеПредставление) Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

&НаКлиенте
Функция АС_ПолноеНаименованиеАвтомобиля(Автомобиль)

	Если НЕ ЗначениеЗаполнено(Автомобиль) Тогда
		Возврат "";
	КонецЕсли;

	Модель = СокрЛП(Строка(Автомобиль));
	Марка = СокрЛП(Строка(Автомобиль.Родитель));
	Если ПустаяСтрока(Марка) Тогда
		Возврат Модель;
	КонецЕсли;

	Возврат Марка + " " + Модель;

КонецФункции

&НаКлиенте
Процедура АС_ЗаполнитьПредставленияПрименяемости()

	Для каждого СтрокаПрименяемости Из Объект.АС_Применяемость Цикл
		СтрокаПрименяемости.АС_АвтомобильПредставление = АС_ПолноеНаименованиеАвтомобиля(
			СтрокаПрименяемости.Автомобиль);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура АС_ЗаполнитьГодыПрименяемости()

	Для каждого СтрокаПрименяемости Из Объект.АС_Применяемость Цикл
		Если ЗначениеЗаполнено(СтрокаПрименяемости.ГодС)
			И НЕ ЗначениеЗаполнено(СтрокаПрименяемости.ГодПо) Тогда
			СтрокаПрименяемости.ГодПо = СтрокаПрименяемости.ГодС;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура АС_УстановитьТипНоменклатурыПоУмолчанию()

	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;

	Если Объект.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Запас")
		Или Объект.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Услуга") Тогда
		Возврат;
	КонецЕсли;

	Объект.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Запас");

КонецПроцедуры

&НаКлиенте
Процедура АС_УстановитьПараметрыУслугиПоУмолчанию()

	Если Объект.ТипНоменклатуры <> ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Услуга") Тогда
		Возврат;
	КонецЕсли;

	Объект.КатегорияНоменклатуры = ПредопределенноеЗначение("Справочник.КатегорииНоменклатуры.ПустаяСсылка");

	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;

	Объект.АС_НормализоватьНаименованиеУслуги = Истина;
	Объект.ЗапретитьВводДробногоКоличества = Истина;

КонецПроцедуры

&НаКлиенте
Процедура АС_РазрешитьИзменениеТипаНоменклатуры()

	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;

	РеквизитыДляРазблокирования = Новый Массив;
	РеквизитыДляРазблокирования.Добавить("ТипНоменклатуры");
	ЗапретРедактированияРеквизитовОбъектовКлиент.УстановитьДоступностьЭлементовФормы(
		ЭтотОбъект,
		РеквизитыДляРазблокирования);

КонецПроцедуры

&НаКлиенте
Процедура АС_ОграничитьСписокТиповНоменклатуры()

	СписокТиповНоменклатуры = Элементы.ТипНоменклатуры.СписокВыбора;
	СписокТиповНоменклатуры.Очистить();
	СписокТиповНоменклатуры.Добавить(
		ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Запас"),
		"Запас");
	СписокТиповНоменклатуры.Добавить(
		ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Услуга"),
		"Услуга");

КонецПроцедуры

&НаКлиенте
Процедура АС_НаименованиеПриИзменении(Элемент)

	АС_ПрименитьНормализациюНаименованияУслуги();
	Если АС_ЭтоФильтр() Тогда
		Объект.НаименованиеПолное = Объект.Наименование;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_НормализоватьНаименованиеУслугиПриИзменении(Элемент)

	АС_ПрименитьНормализациюНаименованияУслуги();

КонецПроцедуры

&НаКлиенте
&Перед("ПередЗаписью")
Процедура АС_ПередЗаписьюПеред(Отказ, ПараметрыЗаписи)

	АС_ЗаполнитьРеквизитыСозданияУслуги();
	АС_УстановитьАвтоматическиеПараметрыФильтра();
	АС_ОбновитьНаименованиеФильтра();
	Если АС_ЭтоФильтр() Тогда
		Объект.НаименованиеПолное = Объект.Наименование;
	КонецЕсли;
	АС_ПрименитьНормализациюНаименованияУслуги();
	АС_ЗаполнитьГодыПрименяемости();
	АС_ПроверитьПрименяемостьФильтров(Отказ);
	Если НЕ Отказ Тогда
		АС_ЗаполнитьПредставленияПрименяемости();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_ПроверитьПрименяемостьФильтров(Отказ)

	Если Отказ ИЛИ НЕ АС_ЭтоФильтр() Тогда
		Возврат;
	КонецЕсли;

	Для каждого СтрокаПрименяемости Из Объект.АС_Применяемость Цикл
		ПредставлениеАвтомобиля = СокрЛП(Строка(СтрокаПрименяемости.АС_АвтомобильПредставление));
		Если ПустаяСтрока(ПредставлениеАвтомобиля)
			И НЕ ЗначениеЗаполнено(СтрокаПрименяемости.Автомобиль) Тогда
			Продолжить;
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(СтрокаПрименяемости.Автомобиль) Тогда
			Сообщить("Выберите автомобиль из списка автоподбора.");
			Отказ = Истина;
			Возврат;
		КонецЕсли;

		Если НРег(ПредставлениеАвтомобиля) <> НРег(АС_ПолноеНаименованиеАвтомобиля(
			СтрокаПрименяемости.Автомобиль)) Тогда
			Сообщить("Выберите автомобиль из списка автоподбора, чтобы сохранить марку и модель.");
			Отказ = Истина;
			Возврат;
		КонецЕсли;

		Если ЗначениеЗаполнено(СтрокаПрименяемости.ГодС)
			И ЗначениеЗаполнено(СтрокаПрименяемости.ГодПо)
			И СтрокаПрименяемости.ГодС > СтрокаПрименяемости.ГодПо Тогда
			Сообщить("Год с не может быть больше, чем год по.");
			Отказ = Истина;
			Возврат;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура АС_ЗаполнитьРеквизитыСозданияУслуги()

	Если Объект.ТипНоменклатуры <> ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Услуга") Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.Ответственный) Тогда
		Объект.Ответственный = АС_ОтветственныйТекущегоПользователя();
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.ДатаСоздания) Тогда
		Объект.ДатаСоздания = АС_ТекущаяДатаСеанса();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция АС_ОтветственныйТекущегоПользователя()

	СотрудникиПользователя = РегистрыСведений.СотрудникиПользователя.ПолучитьСотрудниковПользователя(
		Пользователи.ТекущийПользователь());
	Если СотрудникиПользователя.Количество() > 0 Тогда
		Возврат СотрудникиПользователя[0];
	КонецЕсли;

	Возврат ПерсональныеНастройкиРУНФ.Прочитать("ОсновнойОтветственный");

КонецФункции

&НаСервере
Функция АС_ТекущаяДатаСеанса()

	Возврат ТекущаяДатаСеанса();

КонецФункции

&НаКлиенте
Процедура АС_ПрименитьНормализациюНаименованияУслуги()

	Если Объект.ТипНоменклатуры <> ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Услуга") Тогда
		Возврат;
	КонецЕсли;

	Если Не Объект.АС_НормализоватьНаименованиеУслуги Тогда
		Возврат;
	КонецЕсли;

	НаименованиеУслуги = Строка(Объект.Наименование);
	Если ПустаяСтрока(СокрЛП(НаименованиеУслуги)) Тогда
		Возврат;
	КонецЕсли;

	Объект.Наименование = АС_НормализоватьНаименование(НаименованиеУслуги);
	Объект.НаименованиеПолное = Объект.Наименование;

КонецПроцедуры

&НаКлиенте
Функция АС_НормализоватьНаименование(Значение)

	Результат = СокрЛП(СтрЗаменить(Строка(Значение), Символы.НПП, " "));
	Результат = НРег(Результат);
	Если СтрДлина(Результат) > 0 Тогда
		Результат = ВРег(Лев(Результат, 1)) + Сред(Результат, 2);
	КонецЕсли;
	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура АС_ОбновитьВидимостьФильтра()

	ВидимостьФильтра = (АС_ПоказыватьВсеПоля = Истина) ИЛИ АС_ЭтоФильтр();
	Элементы.АС_ТипФильтра.Видимость = ВидимостьФильтра;
	Элементы.АС_КонструкцияФильтра.Видимость = ВидимостьФильтра;
	Элементы.АС_ВариантИсполненияФильтра.Видимость = ВидимостьФильтра;
	Элементы.АС_БрендФильтра.Видимость = ВидимостьФильтра;
	Элементы.АС_Применяемость.Видимость = ВидимостьФильтра;
	АС_ОбновитьВидимостьСкрываемыхПолейФильтра();

КонецПроцедуры

&НаКлиенте
Процедура АС_ОбновитьВидимостьСкрываемыхПолейФильтра()

	СкрыватьПоля = АС_ЭтоФильтр();
	ИменаЭлементов = Новый Массив;
	ИменаЭлементов.Добавить("НаименованиеПолное");
	ИменаЭлементов.Добавить("ДублиНаименованиеПолное");
	ИменаЭлементов.Добавить("Код");
	ИменаЭлементов.Добавить("ГруппаЕдиницыИзмерения");
	ИменаЭлементов.Добавить("ГруппаГабариты");
	ИменаЭлементов.Добавить("ГруппаОбъемИВес");
	ИменаЭлементов.Добавить("Весовой");
	ИменаЭлементов.Добавить("Родитель");

	Для каждого ИмяЭлемента Из ИменаЭлементов Цикл
		ЭлементФормы = Элементы.Найти(ИмяЭлемента);
		Если ЭлементФормы <> Неопределено Тогда
			ЭлементФормы.Видимость = НЕ СкрыватьПоля;
		КонецЕсли;
	КонецЦикла;

	Если СкрыватьПоля Тогда
		ЭлементФормы = Элементы.Найти("ЗапретитьВводДробногоКоличества");
		Если ЭлементФормы <> Неопределено Тогда
			ЭлементФормы.Видимость = Истина;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция АС_ЭтоФильтр()

	Если Объект.ТипНоменклатуры <> ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Запас") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат НРег(СокрЛП(Строка(Объект.КатегорияНоменклатуры))) = "фильтры";

КонецФункции

&НаКлиенте
Процедура АС_ОбновитьВидимостьУслуги()

	Если АС_ПоказыватьВсеПоля Тогда
		АС_ПоказатьВсеПоляВФорме();
		Возврат;
	КонецЕсли;

	ЭтоУслуга = Объект.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Услуга");

	Если ЭтоУслуга Тогда
		Если АС_ВидимостьДоУслуги = Неопределено Тогда
			АС_СохранитьВидимостьДоУслуги();
		КонецЕсли;

		АС_СкрытьПоляДляУслуги();
	Иначе
		АС_ВосстановитьВидимостьДоУслуги();
		Элементы.АС_НормализоватьНаименованиеУслуги.Видимость = Ложь;
		УправлениеФормой();
		АС_ОбновитьВидимостьФильтра();
	КонецЕсли;


КонецПроцедуры

&НаКлиенте
Процедура АС_ПоказатьВсеПоля(Команда)

	АС_ПоказыватьВсеПоля = Истина;
	АС_ПоказатьВсеПоляВФорме();

КонецПроцедуры

&НаКлиенте
Процедура АС_ПоказатьВсеПоляВФорме()

	Элементы.ЛеваяКолонка.Видимость = Истина;
	Элементы.ПраваяКолонка.Видимость = Истина;
	Элементы.ОсновныеРеквизиты.Видимость = Истина;

	АС_ПоказатьВсеПоляВКоллекции(Элементы.ЛеваяКолонка.ПодчиненныеЭлементы);
	АС_ПоказатьВсеПоляВКоллекции(Элементы.ПраваяКолонка.ПодчиненныеЭлементы);
	АС_ПоказатьВсеПоляВКоллекции(Элементы.ОсновныеРеквизиты.ПодчиненныеЭлементы);
	АС_ОбновитьВидимостьСкрываемыхПолейФильтра();

КонецПроцедуры

&НаКлиенте
Процедура АС_ПоказатьВсеПоляВКоллекции(КоллекцияЭлементов)

	Для каждого ЭлементФормы Из КоллекцияЭлементов Цикл
		ЭлементФормы.Видимость = Истина;
		Попытка
			АС_ПоказатьВсеПоляВКоллекции(ЭлементФормы.ПодчиненныеЭлементы);
		Исключение
			// У листового элемента нет подчиненных элементов.
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура АС_СохранитьВидимостьДоУслуги()

	АС_ВидимостьДоУслуги = Новый Соответствие;
	АС_СохранитьВидимостьКоллекции(Элементы.ЛеваяКолонка.ПодчиненныеЭлементы);
	АС_СохранитьВидимостьКоллекции(Элементы.ПраваяКолонка.ПодчиненныеЭлементы);
	АС_СохранитьВидимостьКоллекции(Элементы.ОсновныеРеквизиты.ПодчиненныеЭлементы);

КонецПроцедуры

&НаКлиенте
Процедура АС_СохранитьВидимостьКоллекции(КоллекцияЭлементов)

	Для каждого ЭлементФормы Из КоллекцияЭлементов Цикл
		АС_ВидимостьДоУслуги.Вставить(ЭлементФормы.Имя, ЭлементФормы.Видимость);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура АС_СкрытьПоляДляУслуги()

	Для каждого ЭлементФормы Из Элементы.ЛеваяКолонка.ПодчиненныеЭлементы Цикл
		ЭлементФормы.Видимость = ЭлементФормы.Имя = "ОсновныеРеквизиты";
	КонецЦикла;

	Для каждого ЭлементФормы Из Элементы.ПраваяКолонка.ПодчиненныеЭлементы Цикл
		ЭлементФормы.Видимость = ЭлементФормы.Имя = "АС_ИнформацияСоздания";
	КонецЦикла;

	Элементы.ОсновныеРеквизиты.Видимость = Истина;
	Для каждого ЭлементФормы Из Элементы.ОсновныеРеквизиты.ПодчиненныеЭлементы Цикл
		ЭлементФормы.Видимость = ЭлементФормы.Имя = "ГруппаТипНоменклатуры"
			ИЛИ ЭлементФормы.Имя = "Наименование"
			ИЛИ ЭлементФормы.Имя = "АС_НормализоватьНаименованиеУслуги";
	КонецЦикла;

	Элементы.Наименование.Видимость = Истина;
	Элементы.АС_НормализоватьНаименованиеУслуги.Видимость = Истина;

КонецПроцедуры

&НаКлиенте
Процедура АС_ВосстановитьВидимостьДоУслуги()

	Если АС_ВидимостьДоУслуги = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для каждого ИмяИВидимость Из АС_ВидимостьДоУслуги Цикл
		ЭлементФормы = Элементы.Найти(ИмяИВидимость.Ключ);
		Если ЭлементФормы <> Неопределено Тогда
			ЭлементФормы.Видимость = ИмяИВидимость.Значение;
		КонецЕсли;
	КонецЦикла;

	АС_ВидимостьДоУслуги = Неопределено;

КонецПроцедуры
