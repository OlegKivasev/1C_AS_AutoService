&НаКлиентеНаСервереБезКонтекста
Процедура АС_ПрименитьСведенияОбОстатках(Форма, Сведения)

	ЕдиницаОстатков = СокрЛП(Строка(Форма.Объект.ЕдиницаИзмерения));
	СуффиксЕдиницы = ?(ПустаяСтрока(ЕдиницаОстатков), "", " " + ЕдиницаОстатков);
	ПредставлениеОстатка = Строка(Сведения.ОстатокСУчетомЗаказов) + СуффиксЕдиницы;
	ПоказыватьОстатки = ЗначениеЗаполнено(Форма.Объект.Ссылка)
		И Форма.Объект.ТипНоменклатуры = ПредопределенноеЗначение(
			"Перечисление.ТипыНоменклатуры.Запас");

	// Читаем и количество, и склад из текущих регистров, а не из дерева при открытии.
	Если Форма.АС_ОстаткиКоличества <> ПредставлениеОстатка Тогда
		Форма.АС_ОстаткиКоличества = ПредставлениеОстатка;
		Форма.АС_ОстатокСУчетомЗаказов = ПредставлениеОстатка;
	КонецЕсли;
	Если Форма.АС_ОстаткиСклады <> Сведения.ПредставлениеСкладов Тогда
		Форма.АС_ОстаткиСклады = Сведения.ПредставлениеСкладов;
	КонецЕсли;
	Если Форма.АС_КоличествоАктивныхЗаказов <> Сведения.КоличествоАктивныхЗаказов Тогда
		Форма.АС_КоличествоАктивныхЗаказов = Сведения.КоличествоАктивныхЗаказов;
	КонецЕсли;

	ЕстьАктивныеЗаказы = ПоказыватьОстатки И Сведения.КоличествоАктивныхЗаказов > 0;
	ЗаголовокЗаказов = СтрШаблон("Активные заказы: %1", Сведения.КоличествоАктивныхЗаказов);
	Если Форма.Элементы.АС_ПоказатьАктивныеЗаказы.Заголовок <> ЗаголовокЗаказов Тогда
		Форма.Элементы.АС_ПоказатьАктивныеЗаказы.Заголовок = ЗаголовокЗаказов;
	КонецЕсли;
	Форма.Элементы.АС_ПоказатьАктивныеЗаказы.Доступность = ЕстьАктивныеЗаказы;
	Форма.Элементы.АС_ПоказатьАктивныеЗаказы.Видимость = ЕстьАктивныеЗаказы;
	Форма.Элементы.АС_ОстатокСУчетомЗаказовГруппа.Видимость = Ложь;
	Форма.Элементы.АС_ОстатокСУчетомЗаказовЗаголовок.Видимость = Ложь;
	Форма.Элементы.АС_ОстатокСУчетомЗаказов.Видимость = Ложь;
	Форма.Элементы.Остатки.Видимость = Ложь;
	Форма.Элементы.ДекорацияНетОстатков.Видимость = Ложь;
	// Нулевой остаток показываем явно; первый приход не требует переоткрытия карточки.
	Форма.Элементы.АС_ОстаткиПредставление.Видимость = ПоказыватьОстатки;

КонецПроцедуры

&НаКлиенте
Процедура АС_НастроитьАвтообновлениеОстатков()

	ОтключитьОбработчикОжидания("АС_ПроверитьИзменениеОстатков");
	Если ЗначениеЗаполнено(Объект.Ссылка)
		И Объект.ТипНоменклатуры = ПредопределенноеЗначение(
			"Перечисление.ТипыНоменклатуры.Запас") Тогда
		// Оповещения действуют в текущем сеансе; таймер подхватывает другие сеансы и обмены.
		ПодключитьОбработчикОжидания("АС_ПроверитьИзменениеОстатков", 5, Ложь);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_ПроверитьИзменениеОстатков()

	Если ЗначениеЗаполнено(Объект.Ссылка)
		И Объект.ТипНоменклатуры = ПредопределенноеЗначение(
			"Перечисление.ТипыНоменклатуры.Запас") Тогда
		АС_ОбновитьПредставлениеОстатков();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&После("ОбработкаОповещения")
Процедура АС_ОбработкаОповещенияПосле(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "Запись_ЗаказПокупателя"
		Или ИмяСобытия = "ИзменениеСостояния_ЗаказПокупателя"
		Или ИмяСобытия = "Запись_ЗаказНаряды"
		Или ИмяСобытия = "ПроведениеЗаказНаряда"
		Или ИмяСобытия = "Запись_РасходнаяНакладная"
		Или ИмяСобытия = "Запись_ПриходнаяНакладная"
		Или ИмяСобытия = "АС_Запись_ПриходнаяНакладная"
		Или ИмяСобытия = "Запись_СписаниеЗапасов"
		Или ИмяСобытия = "Запись_ПересортицаЗапасов"
		Или ИмяСобытия = "Запись_ОприходованиеЗапасов"
		Или ИмяСобытия = "Запись_ПеремещениеЗапасов"
		Или ИмяСобытия = "Запись_ЧекККМ"
		Или ИмяСобытия = "Запись_ЧекККМВозврат"
		Или ИмяСобытия = "Запись_ОтчетОРозничныхПродажах" Тогда
		ОтключитьОбработчикОжидания("АС_ОбновитьОстаткиПоОповещению");
		ПодключитьОбработчикОжидания("АС_ОбновитьОстаткиПоОповещению", 0.2, Истина);
	КонецЕсли;

КонецПроцедуры

