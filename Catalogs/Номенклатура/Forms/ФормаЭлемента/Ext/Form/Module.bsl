&НаСервереБезКонтекста
Функция АС_ПолучитьАвтомобилиДляПрименяемости(Текст)

	Результат = Новый СписокЗначений;
	Если ПустаяСтрока(СокрЛП(Текст)) Тогда
		Возврат Результат;
	КонецЕсли;

	СтрокаПоиска = СокрЛП(Текст);
	ЧастиПоиска = СтрРазделить(СтрокаПоиска, " ", Ложь);
	Если ЧастиПоиска.Количество() > 1 Тогда
		СтрокаПоиска = ЧастиПоиска[ЧастиПоиска.Количество() - 1];
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 20
		| Автомобили.Ссылка КАК Ссылка,
		| Автомобили.Наименование КАК Наименование,
		| Автомобили.Родитель КАК Родитель
		|ИЗ
		| Справочник.АС_Автомобили КАК Автомобили
		|ГДЕ
		| Автомобили.ЭтоГруппа = ЛОЖЬ
		| И НЕ Автомобили.ПометкаУдаления
		| И (Автомобили.Наименование ПОДОБНО &СтрокаПоиска
		|  ИЛИ Автомобили.АС_Синонимы ПОДОБНО &СтрокаПоиска)
		|УПОРЯДОЧИТЬ ПО Автомобили.Наименование";
	Запрос.УстановитьПараметр("СтрокаПоиска", "%" + СтрокаПоиска + "%");

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Модель = СокрЛП(Строка(Выборка.Наименование));
		Марка = СокрЛП(Строка(Выборка.Родитель));
		Представление = Модель;
		Если НЕ ПустаяСтрока(Марка) Тогда
			Представление = Марка + " " + Модель;
		КонецЕсли;

		Результат.Добавить(Представление, Представление);
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция АС_НайтиАвтомобильПоПредставлению(ПредставлениеАвтомобиля)

	ИскомоеПредставление = СокрЛП(Строка(ПредставлениеАвтомобиля));
	Если ПустаяСтрока(ИскомоеПредставление) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЧастиПредставления = СтрРазделить(ИскомоеПредставление, " ", Ложь);
	МодельДляПоиска = ИскомоеПредставление;
	Если ЧастиПредставления.Количество() > 1 Тогда
		МодельДляПоиска = ЧастиПредставления[ЧастиПредставления.Количество() - 1];
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1000
		| Автомобили.Ссылка КАК Ссылка,
		| Автомобили.Наименование КАК Наименование,
		| Автомобили.Родитель КАК Родитель
		|ИЗ
		| Справочник.АС_Автомобили КАК Автомобили
		|ГДЕ
		| Автомобили.ЭтоГруппа = ЛОЖЬ
		| И НЕ Автомобили.ПометкаУдаления
		| И (Автомобили.Наименование ПОДОБНО &СтрокаПоиска
		|  ИЛИ Автомобили.АС_Синонимы ПОДОБНО &СтрокаПоиска)";
	Запрос.УстановитьПараметр("СтрокаПоиска", "%" + СокрЛП(МодельДляПоиска) + "%");

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Модель = СокрЛП(Строка(Выборка.Наименование));
		Марка = СокрЛП(Строка(Выборка.Родитель));
		ПолноеПредставление = Модель;
		Если НЕ ПустаяСтрока(Марка) Тогда
			ПолноеПредставление = Марка + " " + Модель;
		КонецЕсли;

		Если НРег(ПолноеПредставление) = НРег(ИскомоеПредставление) Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

&НаСервереБезКонтекста
Функция АС_ПолноеНаименованиеАвтомобиля(Автомобиль)

	Если НЕ ЗначениеЗаполнено(Автомобиль) Тогда
		Возврат "";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		| Автомобили.Наименование КАК Наименование,
		| Автомобили.Родитель КАК Родитель
		|ИЗ
		| Справочник.АС_Автомобили КАК Автомобили
		|ГДЕ
		| Автомобили.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Автомобиль);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Модель = СокрЛП(Строка(Выборка.Наименование));
		Марка = СокрЛП(Строка(Выборка.Родитель));
	Иначе
		Модель = СокрЛП(Строка(Автомобиль));
		Марка = "";
	КонецЕсли;

	Если ПустаяСтрока(Марка) Тогда
		Возврат Модель;
	КонецЕсли;

	Возврат Марка + " " + Модель;

