&НаКлиенте
Процедура АС_ВыполнитьКомандуPartsAPI(ИдентификаторКоманды)

	РезультатПоиска = АС_ПолучитьКомандуPartsAPIНаСервере(ИдентификаторКоманды);
	Если Не ПустаяСтрока(РезультатПоиска.Ошибка) Тогда
		АС_ПоказатьСообщениеPartsAPI(РезультатПоиска.Ошибка);
		Возврат;
	КонецЕсли;

	ОбъектыНазначения = Новый Массив;
	Если ИдентификаторКоманды = "ПолучитьСведенияПоПрименяемость" Тогда
		Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
			АС_ПоказатьСообщениеPartsAPI(
				"Сначала запишите карточку номенклатуры, затем повторите запрос PartsAPI.");
			Возврат;
		КонецЕсли;
		ОбъектыНазначения.Добавить(Объект.Ссылка);
	КонецЕсли;

	ДополнительныеОтчетыИОбработкиКлиент.ВыполнитьКлиентскийМетодОбработки(
		РезультатПоиска.ВыполняемаяКоманда,
		ЭтотОбъект,
		ОбъектыНазначения);

КонецПроцедуры

&НаКлиенте
Процедура АС_ПоказатьСообщениеPartsAPI(ТекстСообщения)

	Документ = Новый ТекстовыйДокумент;
	Документ.УстановитьТекст(ТекстСообщения);
	Документ.Показать("PartsAPI");

КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_ПолучитьКомандуPartsAPIНаСервере(ИдентификаторКоманды)

	Результат = Новый Структура("Ошибка, ВыполняемаяКоманда", "", Неопределено);

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		| Обработки.Ссылка КАК Ссылка
		|ИЗ
		| Справочник.ДополнительныеОтчетыИОбработки КАК Обработки
		|ГДЕ
		| Обработки.ИмяОбъекта = &ИмяОбъекта
		| И НЕ Обработки.ПометкаУдаления
		| И Обработки.Вид = ЗНАЧЕНИЕ(Перечисление.ВидыДополнительныхОтчетовИОбработок.ЗаполнениеОбъекта)";
	Запрос.УстановитьПараметр("ИмяОбъекта", "PartsAPI");

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Результат.Ошибка = "Внешняя обработка PartsAPI не зарегистрирована или недоступна. "
			+ "Добавьте файл PartsAPI.epf в «Дополнительные отчеты и обработки».";
		Возврат Результат;
	КонецЕсли;

	ОбъектОбработки = Выборка.Ссылка.ПолучитьОбъект();
	СтрокиКоманд = ОбъектОбработки.Команды.НайтиСтроки(
		Новый Структура("Идентификатор", ИдентификаторКоманды));
	Если СтрокиКоманд.Количество() = 0 Тогда
		Результат.Ошибка = "В зарегистрированной обработке PartsAPI нет команды «"
			+ ИдентификаторКоманды + "». Обновите файл PartsAPI.epf.";
		Возврат Результат;
	КонецЕсли;

	СтрокаКоманды = СтрокиКоманд[0];
	Если СтрокаКоманды.ВариантЗапуска <> ПредопределенноеЗначение(
		"Перечисление.СпособыВызоваДополнительныхОбработок.ВызовКлиентскогоМетода") Тогда
		Результат.Ошибка = "Команда PartsAPI настроена с неподдерживаемым способом запуска.";
		Возврат Результат;
	КонецЕсли;

	ВыполняемаяКоманда = Новый Структура(
		"Ссылка, Представление, Идентификатор, ВариантЗапуска, ПоказыватьОповещение, "
		+ "Модификатор, ОбъектыНазначения, ЭтоОтчет, Вид");
	ЗаполнитьЗначенияСвойств(ВыполняемаяКоманда, СтрокаКоманды);
	ВыполняемаяКоманда.Ссылка = Выборка.Ссылка;
	ВыполняемаяКоманда.Вид = ОбъектОбработки.Вид;
	ВыполняемаяКоманда.ЭтоОтчет = Ложь;
	Результат.ВыполняемаяКоманда = ВыполняемаяКоманда;

	Возврат Результат;

КонецФункции

