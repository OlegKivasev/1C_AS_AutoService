		| 	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		| 	Номенклатура.НаименованиеПолное ПОДОБНО &НаименованиеПолное СПЕЦСИМВОЛ ""~""
		| 	И НЕ Номенклатура.Ссылка = &СсылкаРедактируемогоОбъекта";
	Запрос.УстановитьПараметр("НаименованиеПолное", НаименованиеДляПоиска);
	Запрос.УстановитьПараметр("СсылкаРедактируемогоОбъекта", СсылкаРедактируемогоОбъекта);

	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции

&НаКлиенте
Процедура АС_УстановитьПараметрыУслугиПоУмолчанию()

	Если Объект.ТипНоменклатуры <> ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Услуга") Тогда
		Возврат;
	КонецЕсли;

	Объект.КатегорияНоменклатуры = ПредопределенноеЗначение("Справочник.КатегорииНоменклатуры.ПустаяСсылка");

	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;

	Объект.АС_НормализоватьНаименованиеУслуги = Истина;
	Объект.ЗапретитьВводДробногоКоличества = Истина;

КонецПроцедуры

&НаКлиенте
Процедура АС_РазрешитьИзменениеТипаНоменклатуры()

	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;

	РеквизитыДляРазблокирования = Новый Массив;
	РеквизитыДляРазблокирования.Добавить("ТипНоменклатуры");
	ЗапретРедактированияРеквизитовОбъектовКлиент.УстановитьДоступностьЭлементовФормы(
		ЭтотОбъект,
		РеквизитыДляРазблокирования);

КонецПроцедуры

&НаКлиенте
Процедура АС_ОграничитьСписокТиповНоменклатуры()

	СписокТиповНоменклатуры = Элементы.ТипНоменклатуры.СписокВыбора;
	СписокТиповНоменклатуры.Очистить();
	СписокТиповНоменклатуры.Добавить(
		ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Запас"),
		"Запас");
	СписокТиповНоменклатуры.Добавить(
		ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Услуга"),
		"Услуга");

КонецПроцедуры

&НаКлиенте
Процедура АС_НаименованиеПриИзменении(Элемент)

	АС_ПрименитьНормализациюНаименованияУслуги();
	АС_ОбновитьНаименованиеПоБренду(СокрЛП(Строка(Объект.АС_Бренд)));

КонецПроцедуры

&НаКлиенте
Процедура АС_БрендАвтоПодбор(
	Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Ожидание = Ложь;
	ДанныеВыбора = АС_ПолучитьБрендыДляАвтоПодбора(Текст);

КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_ПолучитьБрендыДляАвтоПодбора(Текст)

	Результат = Новый СписокЗначений;
	Если ПустаяСтрока(СокрЛП(Текст)) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 20
		| Бренды.Ссылка КАК Ссылка,
		| Бренды.Наименование КАК Наименование
		|ИЗ
		| Справочник.АС_БрендыТоваров КАК Бренды
		|ГДЕ
		| НЕ Бренды.ПометкаУдаления
		| И (Бренды.Наименование ПОДОБНО &СтрокаПоиска
		|  ИЛИ Бренды.АС_Синонимы ПОДОБНО &СтрокаПоиска)
		|УПОРЯДОЧИТЬ ПО Бренды.Наименование";
	Запрос.УстановитьПараметр("СтрокаПоиска", "%" + СокрЛП(Текст) + "%");

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Ссылка, Выборка.Наименование);
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура АС_БрендПриИзменении(Элемент)

	АС_ОбновитьНаименованиеПоБренду(АС_ПредыдущееПредставлениеБренда);
	АС_ПредыдущееПредставлениеБренда = СокрЛП(Строка(Объект.АС_Бренд));
	АС_ОбновитьИндикаторДублейПоПолномуНаименованию();

КонецПроцедуры

&НаКлиенте
Процедура АС_ОбновитьНаименованиеПоБренду(ПредыдущееПредставлениеБренда)

	НаименованиеБезБренда = СокрЛП(СтрЗаменить(Строка(Объект.Наименование), Символы.НПП, " "));
	Если Не ПустаяСтрока(ПредыдущееПредставлениеБренда) Тогда
		ПредыдущийСуффикс = " | " + ПредыдущееПредставлениеБренда;
		Если СтрЗаканчиваетсяНа(НаименованиеБезБренда, ПредыдущийСуффикс) Тогда
			НаименованиеБезБренда = СокрЛП(Лев(
				НаименованиеБезБренда,
				СтрДлина(НаименованиеБезБренда) - СтрДлина(ПредыдущийСуффикс)));
		КонецЕсли;
	КонецЕсли;

	ПредставлениеБренда = СокрЛП(Строка(Объект.АС_Бренд));
	Если ПустаяСтрока(ПредставлениеБренда) Тогда
		Объект.Наименование = НаименованиеБезБренда;
		АС_СинхронизироватьНаименованиеДляПечатиПоБренду();
		Возврат;
	КонецЕсли;

	СуффиксБренда = " | " + ПредставлениеБренда;
	Если Не СтрЗаканчиваетсяНа(НаименованиеБезБренда, СуффиксБренда)
		И Не ПустаяСтрока(НаименованиеБезБренда) Тогда
		МаксимальнаяДлинаОсновы = 100 - СтрДлина(СуффиксБренда);
		Если МаксимальнаяДлинаОсновы > 0 Тогда
			НаименованиеБезБренда = СокрЛП(Лев(НаименованиеБезБренда, МаксимальнаяДлинаОсновы));
			Объект.Наименование = НаименованиеБезБренда + СуффиксБренда;
		КонецЕсли;
	Иначе
		Объект.Наименование = НаименованиеБезБренда;
	КонецЕсли;

	АС_СинхронизироватьНаименованиеДляПечатиПоБренду();

КонецПроцедуры

&НаКлиенте
Процедура АС_СинхронизироватьНаименованиеДляПечатиПоБренду()

	Если ФормироватьНаименованиеПолноеАвтоматически Тогда
		Объект.НаименованиеПолное = Объект.Наименование;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_НормализоватьНаименованиеУслугиПриИзменении(Элемент)

	АС_ПрименитьНормализациюНаименованияУслуги();

КонецПроцедуры

&НаКлиенте
&Перед("ПередЗаписью")
Процедура АС_ПередЗаписьюПеред(Отказ, ПараметрыЗаписи)

	АС_ОбновитьНаименованиеПоБренду(СокрЛП(Строка(Объект.АС_Бренд)));
	АС_ЗаполнитьРеквизитыСозданияУслуги();
	АС_ПрименитьНормализациюНаименованияУслуги();
	АС_ЗаполнитьГодыПрименяемости();
	ДанныеАвтомобилей = АС_ПолучитьДанныеАвтомобилейПрименяемости(Объект.АС_Применяемость);
	АС_ПрименитьДанныеАвтомобилей(Объект.АС_Применяемость, ДанныеАвтомобилей);

КонецПроцедуры

&НаКлиенте
Процедура АС_ЗаполнитьРеквизитыСозданияУслуги()

	Если Объект.ТипНоменклатуры <> ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Услуга") Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.Ответственный) Тогда
		Объект.Ответственный = АС_ОтветственныйТекущегоПользователя();
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.ДатаСоздания) Тогда
		Объект.ДатаСоздания = АС_ТекущаяДатаСеанса();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция АС_ОтветственныйТекущегоПользователя()

	СотрудникиПользователя = РегистрыСведений.СотрудникиПользователя.ПолучитьСотрудниковПользователя(
		Пользователи.ТекущийПользователь());
	Если СотрудникиПользователя.Количество() > 0 Тогда
		Возврат СотрудникиПользователя[0];
	КонецЕсли;

	Возврат ПерсональныеНастройкиРУНФ.Прочитать("ОсновнойОтветственный");

КонецФункции

&НаСервере
Функция АС_ТекущаяДатаСеанса()

	Возврат ТекущаяДатаСеанса();

КонецФункции

&НаКлиенте
Процедура АС_ПрименитьНормализациюНаименованияУслуги()

	Если Объект.ТипНоменклатуры <> ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Услуга") Тогда
		Возврат;
	КонецЕсли;

	Если Не Объект.АС_НормализоватьНаименованиеУслуги Тогда
		Возврат;
	КонецЕсли;

	НаименованиеУслуги = Строка(Объект.Наименование);
	Если ПустаяСтрока(СокрЛП(НаименованиеУслуги)) Тогда
		Возврат;
	КонецЕсли;

	Объект.Наименование = АС_НормализоватьНаименование(НаименованиеУслуги);
	Объект.НаименованиеПолное = Объект.Наименование;

КонецПроцедуры

&НаКлиенте
Функция АС_НормализоватьНаименование(Значение)

	Результат = СокрЛП(СтрЗаменить(Строка(Значение), Символы.НПП, " "));
	Результат = НРег(Результат);
	Если СтрДлина(Результат) > 0 Тогда
		Результат = ВРег(Лев(Результат, 1)) + Сред(Результат, 2);
	КонецЕсли;
	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура АС_ОбновитьВидимостьПрименяемости()

	ПоказыватьВсеПоля = АС_ПоказыватьВсеПоляВключено();
	ЭтоУслуга = Объект.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Услуга");
	ВидимостьПрименяемости = ПоказыватьВсеПоля Или Не ЭтоУслуга;
	Элементы.АС_ГруппаПрименяемость.Видимость = ВидимостьПрименяемости;
	Элементы.АС_Применяемость.Видимость = ВидимостьПрименяемости;
	АС_ОбновитьВидимостьПолейНоменклатуры();

КонецПроцедуры

&НаКлиенте
Процедура АС_ОбновитьВидимостьПолейНоменклатуры()

	ЭтоУслуга = Объект.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Услуга");
	ЭтоЗапас = Объект.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Запас");
	ПоказыватьВсеПоля = АС_ПоказыватьВсеПоляВключено();
	СкрыватьПоля = ЭтоУслуга И Не ПоказыватьВсеПоля;
	ИменаЭлементов = Новый Массив;
	ИменаЭлементов.Добавить("НаименованиеПолное");
	ИменаЭлементов.Добавить("Код");
	ИменаЭлементов.Добавить("ГруппаЕдиницыИзмерения");
	ИменаЭлементов.Добавить("Родитель");

	Для каждого ИмяЭлемента Из ИменаЭлементов Цикл
		ЭлементФормы = Элементы.Найти(ИмяЭлемента);
		Если ЭлементФормы <> Неопределено Тогда
			ЭлементФормы.Видимость = НЕ СкрыватьПоля;
		КонецЕсли;
	КонецЦикла;

	Если СкрыватьПоля Тогда
		Элементы.ДублиНаименованиеПолное.Видимость = Ложь;
	Иначе
		АС_ОбновитьИндикаторДублейПоПолномуНаименованию();
	КонецЕсли;

	Если ЭтоЗапас И Не ПоказыватьВсеПоля Тогда
		ИменаЭлементовГабаритовИВеса = Новый Массив;
		ИменаЭлементовГабаритовИВеса.Добавить("ГруппаГабариты");
		ИменаЭлементовГабаритовИВеса.Добавить("ГруппаОбъемИВес");
		ИменаЭлементовГабаритовИВеса.Добавить("Весовой");

		Для каждого ИмяЭлемента Из ИменаЭлементовГабаритовИВеса Цикл
			ЭлементФормы = Элементы.Найти(ИмяЭлемента);
			Если ЭлементФормы <> Неопределено Тогда
				ЭлементФормы.Видимость = Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если ЭтоУслуга И Не ПоказыватьВсеПоля Тогда
		ЭлементФормы = Элементы.Найти("ЗапретитьВводДробногоКоличества");
		Если ЭлементФормы <> Неопределено Тогда
			ЭлементФормы.Видимость = Ложь;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция АС_ПоказыватьВсеПоляВключено()

	Возврат АС_ПоказыватьВсеПоля = Истина;

КонецФункции

&НаКлиенте
Функция АС_ВыбранаКатегорияТовар()

	Категория = НРег(СокрЛП(Строка(Объект.КатегорияНоменклатуры)));
	Возврат Категория = "товар" ИЛИ Категория = "фильтры";

КонецФункции

&НаКлиенте
Процедура АС_ОбновитьВидимостьУслуги()

	Если АС_ПоказыватьВсеПоляВключено() Тогда
		АС_ПоказатьВсеПоляВФорме();
		Возврат;
	КонецЕсли;

	ЭтоУслуга = Объект.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Услуга");

	Если ЭтоУслуга Тогда
		Если АС_ВидимостьДоУслуги = Неопределено Тогда
			АС_СохранитьВидимостьДоУслуги();
		КонецЕсли;

		АС_СкрытьПоляДляУслуги();
	Иначе
		АС_ВосстановитьВидимостьДоУслуги();
		Элементы.АС_НормализоватьНаименованиеУслуги.Видимость = Ложь;
		УправлениеФормой();
		АС_ОбновитьВидимостьПрименяемости();
	КонецЕсли;


КонецПроцедуры

&НаКлиенте
Процедура АС_ПоказатьВсеПоля(Команда)

	АС_ПоказыватьВсеПоля = Истина;
	АС_ПоказатьВсеПоляВФорме();

КонецПроцедуры

&НаКлиенте
Процедура АС_ПоказатьВсеПоляВФорме()

	Элементы.ЛеваяКолонка.Видимость = Истина;
	Элементы.ПраваяКолонка.Видимость = Истина;
	Элементы.ОсновныеРеквизиты.Видимость = Истина;

	АС_ПоказатьВсеПоляВКоллекции(Элементы.ЛеваяКолонка.ПодчиненныеЭлементы);
	АС_ПоказатьВсеПоляВКоллекции(Элементы.ПраваяКолонка.ПодчиненныеЭлементы);
	АС_ПоказатьВсеПоляВКоллекции(Элементы.ОсновныеРеквизиты.ПодчиненныеЭлементы);
	АС_ОбновитьВидимостьПолейНоменклатуры();

КонецПроцедуры

&НаКлиенте
Процедура АС_ПоказатьВсеПоляВКоллекции(КоллекцияЭлементов)

	Для каждого ЭлементФормы Из КоллекцияЭлементов Цикл
		ЭлементФормы.Видимость = Истина;
		Попытка
			АС_ПоказатьВсеПоляВКоллекции(ЭлементФормы.ПодчиненныеЭлементы);
		Исключение
			// У листового элемента нет подчиненных элементов.
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура АС_СохранитьВидимостьДоУслуги()

	АС_ВидимостьДоУслуги = Новый Соответствие;
	АС_СохранитьВидимостьКоллекции(Элементы.ЛеваяКолонка.ПодчиненныеЭлементы);
	АС_СохранитьВидимостьКоллекции(Элементы.ПраваяКолонка.ПодчиненныеЭлементы);
	АС_СохранитьВидимостьКоллекции(Элементы.ИзображениеАктуальныеЦены.ПодчиненныеЭлементы);
	АС_СохранитьВидимостьКоллекции(Элементы.ОсновныеРеквизиты.ПодчиненныеЭлементы);

КонецПроцедуры

&НаКлиенте
Процедура АС_СохранитьВидимостьКоллекции(КоллекцияЭлементов)

	Для каждого ЭлементФормы Из КоллекцияЭлементов Цикл
		АС_ВидимостьДоУслуги.Вставить(ЭлементФормы.Имя, ЭлементФормы.Видимость);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура АС_СкрытьПоляДляУслуги()

	Для каждого ЭлементФормы Из Элементы.ЛеваяКолонка.ПодчиненныеЭлементы Цикл
		ЭлементФормы.Видимость = ЭлементФормы.Имя = "ОсновныеРеквизиты";
	КонецЦикла;

	Для каждого ЭлементФормы Из Элементы.ПраваяКолонка.ПодчиненныеЭлементы Цикл
		ЭлементФормы.Видимость = ЭлементФормы.Имя = "АС_ИнформацияСоздания"
			ИЛИ ЭлементФормы.Имя = "ИзображениеАктуальныеЦены";
	КонецЦикла;

	Для каждого ЭлементФормы Из Элементы.ИзображениеАктуальныеЦены.ПодчиненныеЭлементы Цикл
		ЭлементФормы.Видимость = ЭлементФормы.Имя = "ГруппаЦены";
	КонецЦикла;

	Элементы.ОсновныеРеквизиты.Видимость = Истина;
	Для каждого ЭлементФормы Из Элементы.ОсновныеРеквизиты.ПодчиненныеЭлементы Цикл
		ЭлементФормы.Видимость = ЭлементФормы.Имя = "ГруппаТипНоменклатуры"
			ИЛИ ЭлементФормы.Имя = "Наименование"
			ИЛИ ЭлементФормы.Имя = "АС_НормализоватьНаименованиеУслуги"
			ИЛИ ЭлементФормы.Имя = "НедействительнаРастяжение";
	КонецЦикла;

	Элементы.Наименование.Видимость = Истина;
	Элементы.АС_НормализоватьНаименованиеУслуги.Видимость = Истина;

КонецПроцедуры

&НаКлиенте
Процедура АС_ВосстановитьВидимостьДоУслуги()

	Если АС_ВидимостьДоУслуги = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для каждого ИмяИВидимость Из АС_ВидимостьДоУслуги Цикл
		ЭлементФормы = Элементы.Найти(ИмяИВидимость.Ключ);
		Если ЭлементФормы <> Неопределено Тогда
			ЭлементФормы.Видимость = ИмяИВидимость.Значение;
		КонецЕсли;
	КонецЦикла;

	АС_ВидимостьДоУслуги = Неопределено;

КонецПроцедуры

&НаКлиенте
Процедура АС_МассовоДобавитьOEM(Команда)

	Если ТолькоПросмотр Или Элементы.АС_OEMПоМаркам.ТолькоПросмотр Тогда
		Возврат;
	КонецЕсли;
	ОповещениеЗакрытия = Новый ОписаниеОповещения("АС_МассовоеДобавлениеOEMЗавершено", ЭтотОбъект);
	ОткрытьФорму("ОбщаяФорма.АС_МассовоеДобавлениеOEM",
		, ЭтотОбъект, , , , ОповещениеЗакрытия,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура АС_МассовоеДобавлениеOEMЗавершено(ДанныеДобавления, ДополнительныеПараметры) Экспорт

	Если ДанныеДобавления = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Результат = АС_ДобавитьOEMПоМаркамНаСервере(ДанныеДобавления);
	Если Не ПустаяСтрока(Результат.Ошибка) Тогда
		Сообщить(Результат.Ошибка);
		Возврат;
	КонецЕсли;
	Если Результат.Добавлено > 0 Тогда
		Модифицированность = Истина;
	КонецЕсли;
	Сообщить(СтрШаблон("Добавлено OEM: %1. Уже были в таблице: %2.",
		Результат.Добавлено, Результат.Пропущено));

КонецПроцедуры

&НаСервере
Функция АС_МожноМассовоДобавлятьOEM()

	Если ТолькоПросмотр Или Объект.ЭтоГруппа Или Элементы.АС_OEMПоМаркам.ТолькоПросмотр Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат ПравоДоступа("Изменение", Метаданные.Справочники.Номенклатура);
	КонецЕсли;
	Возврат ПравоДоступа("Добавление", Метаданные.Справочники.Номенклатура);

КонецФункции

&НаСервере
Функция АС_ДобавитьOEMПоМаркамНаСервере(ДанныеДобавления)

	Результат = Новый Структура("Добавлено, Пропущено, Ошибка", 0, 0, "");
	Если Не АС_МожноМассовоДобавлятьOEM() Тогда
		Результат.Ошибка = "Карточка номенклатуры недоступна для изменения.";
		Возврат Результат;
	КонецЕсли;

	// Берём текущие данные формы, включая ещё не записанные строки OEM.
	ПарыПоМаркам = Новый Соответствие;
	Для Каждого СтрокаOEM Из Объект.АС_OEMПоМаркам Цикл
		КлючOEM = АС_ИндексOEMСервер.НормализоватьOEM(СтрокаOEM.OEM);
		Если ПустаяСтрока(КлючOEM) Или Не ЗначениеЗаполнено(СтрокаOEM.Марка) Тогда
			Продолжить;
		КонецЕсли;
		КлючиМарки = ПарыПоМаркам.Получить(СтрокаOEM.Марка);
		Если КлючиМарки = Неопределено Тогда
			КлючиМарки = Новый Соответствие;
			ПарыПоМаркам.Вставить(СтрокаOEM.Марка, КлючиМарки);
		КонецЕсли;
		КлючиМарки.Вставить(КлючOEM, Истина);
	КонецЦикла;

	НовыеПары = Новый Массив;
	Для Каждого OEM Из ДанныеДобавления.Артикулы Цикл
		КлючOEM = АС_ИндексOEMСервер.НормализоватьOEM(OEM);
		Для Каждого Марка Из ДанныеДобавления.Марки Цикл
			КлючиМарки = ПарыПоМаркам.Получить(Марка);
			Если КлючиМарки = Неопределено Тогда
				КлючиМарки = Новый Соответствие;
				ПарыПоМаркам.Вставить(Марка, КлючиМарки);
			КонецЕсли;
			Если КлючиМарки.Получить(КлючOEM) <> Неопределено Тогда
				Результат.Пропущено = Результат.Пропущено + 1;
				Продолжить;
			КонецЕсли;
			КлючиМарки.Вставить(КлючOEM, Истина);
			НовыеПары.Добавить(Новый Структура("OEM, Марка", OEM, Марка));
		КонецЦикла;
	КонецЦикла;

	Для Каждого Пара Из НовыеПары Цикл
		НоваяСтрока = Объект.АС_OEMПоМаркам.Добавить();
		НоваяСтрока.OEM = Пара.OEM;
		НоваяСтрока.Марка = Пара.Марка;
	КонецЦикла;
	Результат.Добавлено = НовыеПары.Количество();
	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура АС_СохранитьOEMВTXT(Команда)

	ДанныеTXT = АС_ПолучитьДанныеOEMДляTXT();
	Если Не ПустаяСтрока(ДанныеTXT.Ошибка) Тогда
		Сообщить(ДанныеTXT.Ошибка);
		Возврат;
	КонецЕсли;

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = "Сохранить OEM в TXT";
	Диалог.ПолноеИмяФайла = ДанныеTXT.ИмяФайла;
	Диалог.Расширение = "txt";
	Диалог.Фильтр = "Текстовые файлы (*.txt)|*.txt";
	Диалог.МножественныйВыбор = Ложь;
	Диалог.Показать(Новый ОписаниеОповещения(
		"АС_СохранитьOEMВTXTЗавершение", ЭтотОбъект, ДанныеTXT.Текст));

КонецПроцедуры

&НаКлиенте
Процедура АС_СохранитьOEMВTXTЗавершение(ВыбранныеФайлы, ТекстOEM) Экспорт

	Если ВыбранныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ДокументTXT = Новый ТекстовыйДокумент;
		ДокументTXT.УстановитьТекст(ТекстOEM);
		ДокументTXT.Записать(ВыбранныеФайлы[0], КодировкаТекста.UTF8);
	Исключение
		Сообщить("Не удалось сохранить OEM в TXT: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаСервере
Функция АС_ПолучитьДанныеOEMДляTXT()

	Результат = Новый Структура("Текст, ИмяФайла, Ошибка", "", "", "");
	СтрокиTXT = Новый Массив;
	НомерСтроки = 0;
	// Выгружаем текущую таблицу формы, включая ещё не записанные изменения.
	Для Каждого СтрокаOEM Из Объект.АС_OEMПоМаркам Цикл
		НомерСтроки = НомерСтроки + 1;
		OEM = СокрЛП(СтрокаOEM.OEM);
		Если ПустаяСтрока(OEM) И Не ЗначениеЗаполнено(СтрокаOEM.Марка) Тогда
			Продолжить;
		КонецЕсли;
		Если ПустаяСтрока(OEM) Или Не ЗначениеЗаполнено(СтрокаOEM.Марка) Тогда
			Результат.Ошибка = СтрШаблон("В строке OEM %1 заполните артикул и марку автомобиля.", НомерСтроки);
			Возврат Результат;
		КонецЕсли;
		СтрокиTXT.Добавить(OEM + " | " + Строка(СтрокаOEM.Марка));
	КонецЦикла;

	Если СтрокиTXT.Количество() = 0 Тогда
		Результат.Ошибка = "В таблице нет OEM для сохранения в TXT.";
		Возврат Результат;
	КонецЕсли;

	Результат.Текст = СтрСоединить(СтрокиTXT, Символы.ПС);
	ИмяФайла = СокрЛП(Объект.Артикул);
	Если ПустаяСтрока(ИмяФайла) Тогда
		ИмяФайла = "OEM";
	КонецЕсли;
	Результат.ИмяФайла = АС_ИмяФайлаOEMДляTXT(ИмяФайла) + ".txt";
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция АС_ИмяФайлаOEMДляTXT(Артикул)

	ИмяФайла = Артикул;
	Для НомерСимвола = 1 По СтрДлина(ИмяФайла) Цикл
		СимволИмени = Сред(ИмяФайла, НомерСимвола, 1);
		Если КодСимвола(СимволИмени) < 32 Или СтрНайти("<>:""/\|?*", СимволИмени) > 0 Тогда
			ИмяФайла = Лев(ИмяФайла, НомерСимвола - 1) + "_" + Сред(ИмяФайла, НомерСимвола + 1);
		КонецЕсли;
	КонецЦикла;
	Пока Не ПустаяСтрока(ИмяФайла) И (Прав(ИмяФайла, 1) = "." Или Прав(ИмяФайла, 1) = " ") Цикл
		ИмяФайла = Лев(ИмяФайла, СтрДлина(ИмяФайла) - 1);
	КонецЦикла;
	Если ПустаяСтрока(ИмяФайла) Тогда
		ИмяФайла = "OEM";
	КонецЕсли;

	ЧастиИмени = СтрРазделить(ИмяФайла, ".");
	ОсноваИмени = ВРег(ЧастиИмени[0]);
	ЗарезервированныеИмена = СтрРазделить("CON,PRN,AUX,NUL,COM1,COM2,COM3,COM4,COM5,COM6,COM7,COM8,COM9,LPT1,LPT2,LPT3,LPT4,LPT5,LPT6,LPT7,LPT8,LPT9", ",");
	Если ЗарезервированныеИмена.Найти(ОсноваИмени) <> Неопределено Тогда
		ИмяФайла = "OEM_" + ИмяФайла;
	КонецЕсли;
	Возврат ИмяФайла;

КонецФункции
