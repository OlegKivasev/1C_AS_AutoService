Функция АС_ПолучитьДанныеАвтомобилейНаСервере(Модели)

	Результат = Новый Соответствие;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|Автомобили.Ссылка КАК Автомобиль,
		|Автомобили.Родитель КАК Марка,
		|Автомобили.Наименование КАК Модель,
		|ЕСТЬNULL(Автомобили.Родитель.Наименование, """") КАК НаименованиеМарки
		|ИЗ Справочник.АС_Автомобили КАК Автомобили
		|ГДЕ Автомобили.Ссылка В (&Модели)");
	Запрос.УстановитьПараметр("Модели", Модели);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Модель = СокрЛП(Строка(Выборка.Модель));
