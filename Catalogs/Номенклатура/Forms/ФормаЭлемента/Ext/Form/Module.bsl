&НаСервереБезКонтекста
Функция АС_ЕстьДубльПоНаименованиюДляПечатиНаСервере(НаименованиеПолное, СсылкаРедактируемогоОбъекта)

	НаименованиеДляПоиска = ОбщегоНазначения.СформироватьСтрокуДляПоискаВЗапросе(НаименованиеПолное);
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		| 	Номенклатура.Ссылка КАК Ссылка
		|ИЗ
		| 	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		| 	Номенклатура.НаименованиеПолное ПОДОБНО &НаименованиеПолное СПЕЦСИМВОЛ ""~""
		| 	И НЕ Номенклатура.Ссылка = &СсылкаРедактируемогоОбъекта";
	Запрос.УстановитьПараметр("НаименованиеПолное", НаименованиеДляПоиска);
	Запрос.УстановитьПараметр("СсылкаРедактируемогоОбъекта", СсылкаРедактируемогоОбъекта);

	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции

