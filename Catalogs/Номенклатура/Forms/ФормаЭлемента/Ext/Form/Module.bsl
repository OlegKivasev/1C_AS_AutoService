&НаКлиенте
&После("ПриОткрытии")
Процедура АС_ПриОткрытииПосле(Отказ)

	АС_ПоказыватьВсеПоля = Ложь;
	АС_ПоследнееАвтоматическоеНаименованиеФильтра = Неопределено;
	АС_УстановитьТипНоменклатурыПоУмолчанию();
	АС_УстановитьПараметрыНовойНоменклатуры();
	АС_УстановитьПараметрыУслугиПоУмолчанию();
	АС_УстановитьАвтоматическиеПараметрыФильтра();
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
	АС_ОбновитьНаименованиеФильтра();
	КонецЕсли;
	АС_ЗаполнитьПредставленияПрименяемости();
	АС_ЗаполнитьГодыПрименяемости();
	АС_ОграничитьСписокТиповНоменклатуры();
	АС_РазрешитьИзменениеТипаНоменклатуры();
	АС_ОбновитьВидимостьУслуги();
	АС_ОбновитьВидимостьФильтра();
	АС_ОбновитьПоляТовара();
	АС_ОбновитьИндикаторДублейПоПолномуНаименованию();
	Если АС_ЭтоФильтр() И Объект.АС_ИспользоватьВнутреннийАртикул Тогда
		АС_ЗаполнитьВнутреннийАртикул();
		АС_ОбновитьВидимостьВнутреннегоАртикула();
	КонецЕсли;

КонецПроцедуры

