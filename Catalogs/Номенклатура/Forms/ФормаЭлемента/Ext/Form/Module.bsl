		Представление = ?(ПустаяСтрока(Марка), Модель, Марка + " " + Модель);
		Результат.Вставить(Выборка.Автомобиль,
			Новый Структура("Марка, Представление", Выборка.Марка, Представление));
	КонецЦикла;
	Возврат Результат;

