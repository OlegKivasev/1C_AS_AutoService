&НаКлиенте
Процедура АС_ПоказатьАктивныеЗаказы(Команда)

	АктивныеЗаказы = АС_ПолучитьАктивныеЗаказыНаСервере(Объект.Ссылка);
	Если АктивныеЗаказы.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Для товара нет активных заказов.");
		Возврат;
	КонецЕсли;

	ОповещениеОВыборе = Новый ОписаниеОповещения(
		"АС_ПоказатьАктивныеЗаказыЗавершение", ЭтотОбъект);
	ПоказатьВыборИзСписка(
		ОповещениеОВыборе,
		АктивныеЗаказы,
		Элементы.АС_ПоказатьАктивныеЗаказы);

КонецПроцедуры

&НаКлиенте
Процедура АС_ПоказатьАктивныеЗаказыЗавершение(РезультатВыбора, ДополнительныеПараметры) Экспорт

	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПоказатьЗначение(Неопределено, РезультатВыбора.Значение);

КонецПроцедуры

