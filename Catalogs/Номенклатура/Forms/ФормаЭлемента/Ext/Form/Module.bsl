	Объект.КатегорияНоменклатуры = ПредопределенноеЗначение("Справочник.КатегорииНоменклатуры.ПустаяСсылка");

	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;

	Объект.АС_НормализоватьНаименованиеУслуги = Истина;
	Объект.ЗапретитьВводДробногоКоличества = Истина;

КонецПроцедуры

&НаКлиенте
Процедура АС_РазрешитьИзменениеТипаНоменклатуры()

	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
