&После("ОбработкаПолученияДанныхВыбора")
Процедура АС_ОбработкаПолученияДанныхВыбораПосле(ДанныеВыбора, Параметры, СтандартнаяОбработка)

	Если Не Параметры.Свойство("СтрокаПоиска") Тогда
		Возврат;
	КонецЕсли;

	ВариантыСинонимов = АС_СинонимыПоискаСервер.ВариантыСтрокиПоиска(Параметры.СтрокаПоиска);
	Если ВариантыСинонимов.Количество() > 1 Тогда
		НайденнаяНоменклатура = АС_СинонимыПоискаСервер.НайтиНоменклатуруПоВариантам(ВариантыСинонимов);
		ОтборНоменклатуры = Неопределено;
		Параметры.Свойство("Отбор", ОтборНоменклатуры);
		Для Каждого Номенклатура Из НайденнаяНоменклатура Цикл
			Если Не АС_СинонимыПоискаСервер.СоответствуетОтборуНоменклатуры(
				Номенклатура, ОтборНоменклатуры) Тогда
				Продолжить;
			КонецЕсли;

			Если ТипЗнч(ДанныеВыбора) <> Тип("СписокЗначений") Тогда
				ДанныеВыбора = Новый СписокЗначений;
			КонецЕсли;
			Если ДанныеВыбора.НайтиПоЗначению(Номенклатура) = Неопределено Тогда
				ДанныеВыбора.Добавить(Номенклатура, Строка(Номенклатура));
			КонецЕсли;
		КонецЦикла;

		Если ТипЗнч(ДанныеВыбора) = Тип("СписокЗначений")
			И ДанныеВыбора.Количество() > 0 Тогда
			СтандартнаяОбработка = Ложь;
			Возврат;
		КонецЕсли;
	КонецЕсли;

	КлючАртикула = АС_НоменклатураСервер.КомпактныйКлючАртикула(Параметры.СтрокаПоиска);
	Если ПустаяСтрока(КлючАртикула) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("КлючАртикула", "%" + КлючАртикула + "%");
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 15
		| Номенклатура.Ссылка КАК Ссылка,
		| Номенклатура.Наименование КАК Наименование,
		| Номенклатура.Артикул КАК Артикул
		|ИЗ
		| Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		| НЕ Номенклатура.ЭтоГруппа
		| И НЕ Номенклатура.ПометкаУдаления
		| И НЕ Номенклатура.Недействителен
		| И Номенклатура.АС_АртикулДляПоиска ПОДОБНО &КлючАртикула";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ТипЗнч(ДанныеВыбора) <> Тип("СписокЗначений") Тогда
			ДанныеВыбора = Новый СписокЗначений;
			СтандартнаяОбработка = Ложь;
		КонецЕсли;

		Если ДанныеВыбора.НайтиПоЗначению(Выборка.Ссылка) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ВыделенныйАртикул = АС_ПредставлениеАртикулаСПодсветкой(
			Выборка.Артикул,
			КлючАртикула);
		Представление = Новый ФорматированнаяСтрока(
			ВыделенныйАртикул,
			" (" + Выборка.Наименование + ")");
		ДанныеВыбора.Добавить(Выборка.Ссылка, Представление);
	КонецЦикла;

КонецПроцедуры

Функция АС_ПредставлениеАртикулаСПодсветкой(Артикул, КлючАртикула)

	ТекстАртикула = Строка(Артикул);
	КомпактныйАртикул = АС_НоменклатураСервер.КомпактныйКлючАртикула(ТекстАртикула);
	НачалоСовпадения = СтрНайти(КомпактныйАртикул, КлючАртикула);

	Если НачалоСовпадения = 0 Тогда
		Возврат Новый ФорматированнаяСтрока(ТекстАртикула);
	КонецЕсли;

	КонецСовпадения = НачалоСовпадения + СтрДлина(КлючАртикула) - 1;
	ЧастиПредставления = Новый Массив;
	ОбычныйФрагмент = "";
	ПозицияВКомпактномАртикуле = 0;
	ШрифтВыделения = Новый Шрифт(,,Истина);
	ЦветВыделения = ЦветаСтиля.ЦветУспешногоПоиска;

	Для Позиция = 1 По СтрДлина(ТекстАртикула) Цикл
		СимволАртикула = Сред(ТекстАртикула, Позиция, 1);
		КомпактныйСимвол = АС_НоменклатураСервер.КомпактныйКлючАртикула(СимволАртикула);

		Если Не ПустаяСтрока(КомпактныйСимвол) Тогда
			ПозицияВКомпактномАртикуле = ПозицияВКомпактномАртикуле + 1;
		КонецЕсли;

		Если (Не ПустаяСтрока(КомпактныйСимвол)
				И ПозицияВКомпактномАртикуле >= НачалоСовпадения
				И ПозицияВКомпактномАртикуле <= КонецСовпадения)
			Или (ПустаяСтрока(КомпактныйСимвол)
				И ПозицияВКомпактномАртикуле >= НачалоСовпадения
				И ПозицияВКомпактномАртикуле < КонецСовпадения) Тогда

			Если Не ПустаяСтрока(ОбычныйФрагмент) Тогда
				ЧастиПредставления.Добавить(Новый ФорматированнаяСтрока(ОбычныйФрагмент));
				ОбычныйФрагмент = "";
			КонецЕсли;

			ЧастиПредставления.Добавить(Новый ФорматированнаяСтрока(
				СимволАртикула,
				ШрифтВыделения,
				ЦветВыделения));
		Иначе
			ОбычныйФрагмент = ОбычныйФрагмент + СимволАртикула;
		КонецЕсли;
	КонецЦикла;

	Если Не ПустаяСтрока(ОбычныйФрагмент) Тогда
		ЧастиПредставления.Добавить(Новый ФорматированнаяСтрока(ОбычныйФрагмент));
	КонецЕсли;

	Возврат Новый ФорматированнаяСтрока(ЧастиПредставления);

КонецФункции
