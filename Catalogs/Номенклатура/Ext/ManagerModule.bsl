&После("ОбработкаПолученияДанныхВыбора")
Процедура АС_ОбработкаПолученияДанныхВыбораПосле(ДанныеВыбора, Параметры, СтандартнаяОбработка)

	ЭтоВнутреннийВариантПоиска = Ложь;
	Если Параметры.Свойство("АС_ВнутреннийВариантПоиска", ЭтоВнутреннийВариантПоиска)
		И ЭтоВнутреннийВариантПоиска Тогда
		Возврат;
	КонецЕсли;

	Если Не Параметры.Свойство("СтрокаПоиска") Тогда
		Возврат;
	КонецЕсли;

	// Быстрый подбор в документах не передаёт настройки расширенного
	// представления. Дополняем его штатными строками для всех вариантов
	// поиска: синонимов, точки/запятой и обозначений размерности.
	ОтборНоменклатуры = Неопределено;
	Параметры.Свойство("Отбор", ОтборНоменклатуры);
	Если (ТипЗнч(ОтборНоменклатуры) <> Тип("Структура")
			И ТипЗнч(ОтборНоменклатуры) <> Тип("ФиксированнаяСтруктура"))
		Или Не ОтборНоменклатуры.Свойство("НастройкиПолейСтрокой") Тогда
		АС_ДополнитьШтатныйВыборВариантамиПоиска(ДанныеВыбора, Параметры);
		Возврат;
	КонецЕсли;

	ВариантыСинонимов = АС_СинонимыПоискаСервер.ВариантыСтрокиПоиска(Параметры.СтрокаПоиска);
	Если ВариантыСинонимов.Количество() > 1 Тогда
		АС_ДополнитьШтатныйВыборВариантамиПоиска(ДанныеВыбора, Параметры);
		НайденнаяНоменклатура = АС_СинонимыПоискаСервер.НайтиНоменклатуруПоВариантам(ВариантыСинонимов);
		Для Каждого Номенклатура Из НайденнаяНоменклатура Цикл
			Если Не АС_СинонимыПоискаСервер.СоответствуетОтборуНоменклатуры(
				Номенклатура, ОтборНоменклатуры) Тогда
				Продолжить;
			КонецЕсли;

			Если ТипЗнч(ДанныеВыбора) <> Тип("СписокЗначений") Тогда
				ДанныеВыбора = Новый СписокЗначений;
			КонецЕсли;
			Если ДанныеВыбора.НайтиПоЗначению(Номенклатура) = Неопределено Тогда
				ДанныеВыбора.Добавить(Номенклатура, Строка(Номенклатура));
			КонецЕсли;
		КонецЦикла;

		Если ТипЗнч(ДанныеВыбора) = Тип("СписокЗначений")
			И ДанныеВыбора.Количество() > 0 Тогда
			АС_ПереместитьБыстроеСозданиеВКонец(ДанныеВыбора);
			СтандартнаяОбработка = Ложь;
			Возврат;
		КонецЕсли;
	КонецЕсли;

	КлючАртикула = АС_НоменклатураСервер.КомпактныйКлючАртикула(Параметры.СтрокаПоиска);
	Если ПустаяСтрока(КлючАртикула) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("КлючАртикула", "%" + КлючАртикула + "%");
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 15
		| Номенклатура.Ссылка КАК Ссылка,
		| Номенклатура.Наименование КАК Наименование,
		| Номенклатура.Артикул КАК Артикул,
		| Номенклатура.АС_Бренд КАК Бренд
		|ИЗ
		| Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		| НЕ Номенклатура.ЭтоГруппа
		| И НЕ Номенклатура.ПометкаУдаления
		| И НЕ Номенклатура.Недействителен
		| И Номенклатура.АС_АртикулДляПоиска ПОДОБНО &КлючАртикула";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ТипЗнч(ДанныеВыбора) <> Тип("СписокЗначений") Тогда
			ДанныеВыбора = Новый СписокЗначений;
			СтандартнаяОбработка = Ложь;
		КонецЕсли;

		Если ДанныеВыбора.НайтиПоЗначению(Выборка.Ссылка) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ВыделенныйАртикул = АС_ПредставлениеАртикулаСПодсветкой(
			Выборка.Артикул,
			КлючАртикула);
		Если ЗначениеЗаполнено(Выборка.Бренд) Тогда
			ЧастиПредставления = Новый Массив;
			ЧастиПредставления.Добавить(Новый ФорматированнаяСтрока(
				Строка(Выборка.Бренд),
				,
				ЦветаСтиля.ЦветУспешногоПоиска));
			ЧастиПредставления.Добавить(" | ");
			ЧастиПредставления.Добавить(ВыделенныйАртикул);
			ЧастиПредставления.Добавить(" (" + Выборка.Наименование + ")");
			Представление = Новый ФорматированнаяСтрока(ЧастиПредставления);
		Иначе
			Представление = Новый ФорматированнаяСтрока(
				ВыделенныйАртикул,
				" (" + Выборка.Наименование + ")");
		КонецЕсли;
		ДанныеВыбора.Добавить(Выборка.Ссылка, Представление);
	КонецЦикла;
	АС_ПереместитьБыстроеСозданиеВКонец(ДанныеВыбора);

КонецПроцедуры

Процедура АС_ДополнитьШтатныйВыборВариантамиПоиска(ДанныеВыбора, Параметры)

	СтрокаПоиска = "";
	Если Не Параметры.Свойство("СтрокаПоиска", СтрокаПоиска)
		Или ТипЗнч(ДанныеВыбора) <> Тип("СписокЗначений") Тогда
		Возврат;
	КонецЕсли;

	ВариантыПоиска = АС_СинонимыПоискаСервер.ВариантыСтрокиПоиска(СтрокаПоиска);
	Если ВариантыПоиска.Количество() < 2 Тогда
		Возврат;
	КонецЕсли;

	ПоследнийЭлементПустой = Ложь;
	Если ДанныеВыбора.Количество() > 0 Тогда
		ПоследнееЗначение = ДанныеВыбора.Получить(ДанныеВыбора.Количество() - 1).Значение;
		ПоследнийЭлементПустой = ТипЗнч(ПоследнееЗначение) = Тип("Строка")
			И ПустаяСтрока(ПоследнееЗначение);
		Если ПоследнийЭлементПустой Тогда
			ДанныеВыбора.Удалить(ДанныеВыбора.Количество() - 1);
		КонецЕсли;
	КонецЕсли;

	Для Каждого ВариантПоиска Из ВариантыПоиска Цикл
		ПараметрыВарианта = Новый Структура;
		Для Каждого Параметр Из Параметры Цикл
			ПараметрыВарианта.Вставить(Параметр.Ключ, Параметр.Значение);
		КонецЦикла;
		ПараметрыВарианта.Вставить("СтрокаПоиска", ВариантПоиска);
		ПараметрыВарианта.Вставить("АС_ВнутреннийВариантПоиска", Истина);

		ДанныеВарианта = Справочники.Номенклатура.
			ПолучитьДанныеВыбора(ПараметрыВарианта);
		Для Каждого ЭлементВарианта Из ДанныеВарианта Цикл
			Если ТипЗнч(ЭлементВарианта.Значение) <> Тип("СправочникСсылка.Номенклатура") Тогда
				Продолжить;
			КонецЕсли;
			Если ДанныеВыбора.НайтиПоЗначению(ЭлементВарианта.Значение) = Неопределено Тогда
				ДанныеВыбора.Добавить(
					ЭлементВарианта.Значение, ЭлементВарианта.Представление);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Если ПоследнийЭлементПустой Тогда
		ДанныеВыбора.Добавить("");
	КонецЕсли;
	АС_ПереместитьБыстроеСозданиеВКонец(ДанныеВыбора);

КонецПроцедуры

Процедура АС_ПереместитьБыстроеСозданиеВКонец(ДанныеВыбора)

	Если ТипЗнч(ДанныеВыбора) <> Тип("СписокЗначений") Тогда
		Возврат;
	КонецЕсли;

	ПоследнийЭлементПустой = Ложь;
	Если ДанныеВыбора.Количество() > 0 Тогда
		ПоследнееЗначение = ДанныеВыбора.Получить(ДанныеВыбора.Количество() - 1).Значение;
		ПоследнийЭлементПустой = ТипЗнч(ПоследнееЗначение) = Тип("Строка")
			И ПустаяСтрока(ПоследнееЗначение);
		Если ПоследнийЭлементПустой Тогда
			ДанныеВыбора.Удалить(ДанныеВыбора.Количество() - 1);
		КонецЕсли;
	КонецЕсли;

	БыстрыеСоздания = Новый Массив;
	Индекс = 0;
	Пока Индекс < ДанныеВыбора.Количество() Цикл
		ЭлементВыбора = ДанныеВыбора.Получить(Индекс);
		ЗначениеВыбора = ЭлементВыбора.Значение;
		БыстроеСоздание = Ложь;
		Если (ТипЗнч(ЗначениеВыбора) = Тип("Структура")
				Или ТипЗнч(ЗначениеВыбора) = Тип("ФиксированнаяСтруктура"))
			И ЗначениеВыбора.Свойство("БыстроеСоздание", БыстроеСоздание)
			И БыстроеСоздание Тогда
			БыстрыеСоздания.Добавить(Новый Структура(
				"Значение, Представление", ЗначениеВыбора, ЭлементВыбора.Представление));
			ДанныеВыбора.Удалить(Индекс);
			Продолжить;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;

	Для Каждого БыстроеСозданиеИзСписка Из БыстрыеСоздания Цикл
		ДанныеВыбора.Добавить(
			БыстроеСозданиеИзСписка.Значение, БыстроеСозданиеИзСписка.Представление);
	КонецЦикла;

	Если ПоследнийЭлементПустой Тогда
		ДанныеВыбора.Добавить("");
	КонецЕсли;

КонецПроцедуры

Функция АС_ПредставлениеАртикулаСПодсветкой(Артикул, КлючАртикула)

	ТекстАртикула = Строка(Артикул);
	КомпактныйАртикул = АС_НоменклатураСервер.КомпактныйКлючАртикула(ТекстАртикула);
	НачалоСовпадения = СтрНайти(КомпактныйАртикул, КлючАртикула);

	Если НачалоСовпадения = 0 Тогда
		Возврат Новый ФорматированнаяСтрока(ТекстАртикула);
	КонецЕсли;

	КонецСовпадения = НачалоСовпадения + СтрДлина(КлючАртикула) - 1;
	ЧастиПредставления = Новый Массив;
	ОбычныйФрагмент = "";
	ПозицияВКомпактномАртикуле = 0;
	ШрифтВыделения = Новый Шрифт(,,Истина);
	ЦветВыделения = ЦветаСтиля.ЦветУспешногоПоиска;

	Для Позиция = 1 По СтрДлина(ТекстАртикула) Цикл
		СимволАртикула = Сред(ТекстАртикула, Позиция, 1);
		КомпактныйСимвол = АС_НоменклатураСервер.КомпактныйКлючАртикула(СимволАртикула);

		Если Не ПустаяСтрока(КомпактныйСимвол) Тогда
			ПозицияВКомпактномАртикуле = ПозицияВКомпактномАртикуле + 1;
		КонецЕсли;

		Если (Не ПустаяСтрока(КомпактныйСимвол)
				И ПозицияВКомпактномАртикуле >= НачалоСовпадения
				И ПозицияВКомпактномАртикуле <= КонецСовпадения)
			Или (ПустаяСтрока(КомпактныйСимвол)
				И ПозицияВКомпактномАртикуле >= НачалоСовпадения
				И ПозицияВКомпактномАртикуле < КонецСовпадения) Тогда

			Если Не ПустаяСтрока(ОбычныйФрагмент) Тогда
				ЧастиПредставления.Добавить(Новый ФорматированнаяСтрока(ОбычныйФрагмент));
				ОбычныйФрагмент = "";
			КонецЕсли;

			ЧастиПредставления.Добавить(Новый ФорматированнаяСтрока(
				СимволАртикула,
				ШрифтВыделения,
				ЦветВыделения));
		Иначе
			ОбычныйФрагмент = ОбычныйФрагмент + СимволАртикула;
		КонецЕсли;
	КонецЦикла;

	Если Не ПустаяСтрока(ОбычныйФрагмент) Тогда
		ЧастиПредставления.Добавить(Новый ФорматированнаяСтрока(ОбычныйФрагмент));
	КонецЕсли;

	Возврат Новый ФорматированнаяСтрока(ЧастиПредставления);

КонецФункции
