&После("ОбработкаЗаполнения")
Процедура АС_ПослеОбработкиЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	АС_ОчиститьКатегориюУслуги();
	АС_ЗаполнитьРеквизитыСозданияУслуги();

КонецПроцедуры

&Перед("ПередЗаписью")
Процедура АС_ПередЗаписьюПеред(Отказ)

	АС_ЗаполнитьРеквизитыСозданияУслуги();
	АС_ОбработатьВнутреннийАртикул(Отказ);
	АС_АртикулДляПоиска = АС_НоменклатураСервер.КомпактныйКлючАртикула(Артикул);
	АС_ОбновитьНаименованиеПоБренду();
	АС_ПроверитьБрендИАртикул(Отказ);

КонецПроцедуры

Процедура АС_ПроверитьБрендИАртикул(Отказ)

	Если Отказ Или ЭтоГруппа Или ПустаяСтрока(СокрЛП(Строка(Артикул))) Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(АС_Бренд) Тогда
		Сообщить("Для номенклатуры с артикулом обязательно выберите бренд.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|  Номенклатура.Ссылка КАК Ссылка
		|ИЗ
		|  Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|  НЕ Номенклатура.Ссылка = &ТекущаяСсылка
		|  И Номенклатура.АС_Бренд = &Бренд
		|  И (Номенклатура.АС_АртикулДляПоиска = &КлючАртикула
		|      И &КлючАртикула <> """"
		|    ИЛИ Номенклатура.Артикул = &Артикул)";
	Запрос.УстановитьПараметр("ТекущаяСсылка", Ссылка);
	Запрос.УстановитьПараметр("Бренд", АС_Бренд);
	Запрос.УстановитьПараметр("КлючАртикула", АС_АртикулДляПоиска);
	Запрос.УстановитьПараметр("Артикул", СокрЛП(Строка(Артикул)));

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Сообщить(СтрШаблон(
			"Номенклатура бренда «%1» с артикулом «%2» уже найдена: %3. Используйте найденную карточку.",
			Строка(АС_Бренд), СокрЛП(Строка(Артикул)), Строка(Выборка.Ссылка)));
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

Процедура АС_ОбновитьНаименованиеПоБренду()

	Если ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;

	ПредыдущееПредставлениеБренда = "";
	Если Не ЭтоНовый() Тогда
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|  Номенклатура.АС_Бренд КАК Бренд
			|ИЗ
			|  Справочник.Номенклатура КАК Номенклатура
			|ГДЕ
			|  Номенклатура.Ссылка = &Ссылка");
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ПредыдущееПредставлениеБренда = СокрЛП(Строка(Выборка.Бренд));
		КонецЕсли;
	КонецЕсли;

	НаименованиеБезБренда = СокрЛП(СтрЗаменить(Строка(Наименование), Символы.НПП, " "));
	Если Не ПустаяСтрока(ПредыдущееПредставлениеБренда) Тогда
		ПредыдущийСуффикс = " | " + ПредыдущееПредставлениеБренда;
		Если СтрЗаканчиваетсяНа(НаименованиеБезБренда, ПредыдущийСуффикс) Тогда
			НаименованиеБезБренда = СокрЛП(Лев(
				НаименованиеБезБренда,
				СтрДлина(НаименованиеБезБренда) - СтрДлина(ПредыдущийСуффикс)));
		КонецЕсли;
	КонецЕсли;

	ПредставлениеБренда = СокрЛП(Строка(АС_Бренд));
	Если ПустаяСтрока(ПредставлениеБренда) Тогда
		Наименование = НаименованиеБезБренда;
		Возврат;
	КонецЕсли;

	СуффиксБренда = " | " + ПредставлениеБренда;
	Если СтрЗаканчиваетсяНа(НаименованиеБезБренда, СуффиксБренда) Тогда
		Наименование = НаименованиеБезБренда;
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(НаименованиеБезБренда) Тогда
		Возврат;
	КонецЕсли;

	МаксимальнаяДлинаОсновы = 100 - СтрДлина(СуффиксБренда);
	Если МаксимальнаяДлинаОсновы < 1 Тогда
		Возврат;
	КонецЕсли;
	НаименованиеБезБренда = СокрЛП(Лев(НаименованиеБезБренда, МаксимальнаяДлинаОсновы));
	Наименование = НаименованиеБезБренда + СуффиксБренда;

КонецПроцедуры

&После("ПриЗаписи")
Процедура АС_ПослеПриЗаписи(Отказ)

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	ИндексироватьOEM = Не ЭтоГруппа
		И Не ПометкаУдаления
		И Не Недействителен
		И ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Запас;
	АС_ИндексOEMСервер.ОбновитьИндексНоменклатуры(
		Ссылка, АС_OEM, ИндексироватьOEM);

	АС_ОчиститьКатегориюУслуги();

КонецПроцедуры

Процедура АС_ОбработатьВнутреннийАртикул(Отказ)

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Если ЭтоГруппа
		Или ТипНоменклатуры <> Перечисления.ТипыНоменклатуры.Запас
		Или НРег(СокрЛП(Строка(КатегорияНоменклатуры))) <> "фильтры" Тогда
		АС_ИспользоватьВнутреннийАртикул = Ложь;
		Возврат;
	КонецЕсли;

	Если АС_ИспользоватьВнутреннийАртикул Тогда
		Если ЗначениеЗаполнено(АС_ВнутреннийАртикул)
			И АС_НоменклатураСервер.ЭтоВнутреннийАртикул(АС_ВнутреннийАртикул) Тогда
			Артикул = АС_ВнутреннийАртикул;
		Иначе
			АС_ВнутреннийАртикул = АС_НоменклатураСервер.ПолучитьСледующийВнутреннийАртикул();
			Артикул = АС_ВнутреннийАртикул;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Функция АС_ЭтоФильтр()

	Если ТипНоменклатуры <> Перечисления.ТипыНоменклатуры.Запас Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат НРег(СокрЛП(Строка(КатегорияНоменклатуры))) = "фильтры";

КонецФункции

Процедура АС_ЗаполнитьРеквизитыСозданияУслуги()

	Если ОбменДанными.Загрузка
		Или ЭтоГруппа
		Или ТипНоменклатуры <> Перечисления.ТипыНоменклатуры.Услуга Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Ответственный) Тогда
		СотрудникиПользователя = РегистрыСведений.СотрудникиПользователя.ПолучитьСотрудниковПользователя(
			Пользователи.ТекущийПользователь());
		Если СотрудникиПользователя.Количество() > 0 Тогда
			Ответственный = СотрудникиПользователя[0];
		Иначе
			Ответственный = ПерсональныеНастройкиРУНФ.Прочитать("ОсновнойОтветственный");
		КонецЕсли;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаСоздания) Тогда
		ДатаСоздания = ТекущаяДатаСеанса();
	КонецЕсли;

	АС_ПрименитьНормализациюНаименованияУслуги();

КонецПроцедуры

Процедура АС_ПрименитьНормализациюНаименованияУслуги()

	Если Не АС_НормализоватьНаименованиеУслуги Тогда
		Возврат;
	КонецЕсли;

	НаименованиеУслуги = Строка(Наименование);
	Если ПустаяСтрока(СокрЛП(НаименованиеУслуги)) Тогда
		Возврат;
	КонецЕсли;

	Наименование = АС_НормализоватьНаименование(НаименованиеУслуги);
	НаименованиеПолное = Наименование;

КонецПроцедуры

Функция АС_НормализоватьНаименование(Значение)

	Результат = СокрЛП(СтрЗаменить(Строка(Значение), Символы.НПП, " "));
	Результат = НРег(Результат);
	Если СтрДлина(Результат) > 0 Тогда
		Результат = ВРег(Лев(Результат, 1)) + Сред(Результат, 2);
	КонецЕсли;
	Возврат Результат;

КонецФункции

Процедура АС_ОчиститьКатегориюУслуги()

	Если ЭтоГруппа
		Или ТипНоменклатуры <> Перечисления.ТипыНоменклатуры.Услуга Тогда
		Возврат;
	КонецЕсли;

	КатегорияНоменклатуры = ПредопределенноеЗначение(
		"Справочник.КатегорииНоменклатуры.ПустаяСсылка");

КонецПроцедуры