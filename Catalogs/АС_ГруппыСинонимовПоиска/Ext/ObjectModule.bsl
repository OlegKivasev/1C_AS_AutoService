Процедура ПередЗаписью(Отказ)

	ИспользованныеКлючи = Новый Соответствие;
	ИспользованныеЗначения = Новый Соответствие;
	КлючНаименования = АС_СинонимыПоискаСервер.НормализоватьСтроку(Наименование);
	Если ПустаяСтрока(КлючНаименования) Тогда
		Сообщить("Укажите наименование группы синонимов.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	ИспользованныеКлючи.Вставить(КлючНаименования, Наименование);
	ИспользованныеЗначения.Вставить(НРег(СокрЛП(Наименование)), Наименование);

	Для Каждого СтрокаСинонима Из Синонимы Цикл
		КлючСинонима = АС_СинонимыПоискаСервер.НормализоватьСтроку(СтрокаСинонима.Синоним);
		Если ПустаяСтрока(КлючСинонима) Тогда
			Сообщить("В таблице синонимов есть пустая строка.");
			Отказ = Истина;
			Возврат;
		КонецЕсли;

		КлючЗначения = НРег(СокрЛП(СтрокаСинонима.Синоним));
		Если ИспользованныеЗначения.Получить(КлючЗначения) <> Неопределено Тогда
			Сообщить("Синоним повторяется внутри группы: " + СтрокаСинонима.Синоним);
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		ИспользованныеЗначения.Вставить(КлючЗначения, СтрокаСинонима.Синоним);
		Если ИспользованныеКлючи.Получить(КлючСинонима) = Неопределено Тогда
			ИспользованныеКлючи.Вставить(КлючСинонима, СтрокаСинонима.Синоним);
		КонецЕсли;
	КонецЦикла;

	Если ИспользованныеЗначения.Количество() < 2 Тогда
		Сообщить("Добавьте хотя бы один синоним к наименованию группы.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|Группы.Ссылка КАК Группа,
		|Группы.Наименование КАК Синоним
		|ИЗ
		|Справочник.АС_ГруппыСинонимовПоиска КАК Группы
		|ГДЕ
		|Группы.Ссылка <> &ТекущаяГруппа
		|И НЕ Группы.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|Группы.Ссылка,
		|ГруппыСинонимы.Синоним
		|ИЗ
		|Справочник.АС_ГруппыСинонимовПоиска КАК Группы
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.АС_ГруппыСинонимовПоиска.Синонимы КАК ГруппыСинонимы
		|ПО Группы.Ссылка = ГруппыСинонимы.Ссылка
		|ГДЕ
		|Группы.Ссылка <> &ТекущаяГруппа
		|И НЕ Группы.ПометкаУдаления");
	Запрос.УстановитьПараметр("ТекущаяГруппа", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		КлючСинонима = АС_СинонимыПоискаСервер.НормализоватьСтроку(Выборка.Синоним);
		Если ИспользованныеКлючи.Получить(КлючСинонима) <> Неопределено Тогда
			Сообщить("Синоним уже используется в другой группе: " + Выборка.Синоним);
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры
