&НаКлиенте
Процедура АС_МодельАвтомобиляАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Ожидание = Ложь;
	ДанныеВыбора = АС_ПолучитьАвтомобилиДляАвтоПодбора(
		Текст, Ложь, Объект.АС_МаркаАвтомобиляИзСправочника);

КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_ПолучитьАвтомобилиДляАвтоПодбора(Текст, ЭтоМарка, Родитель = Неопределено)

	Результат = Новый СписокЗначений;
	Если ПустаяСтрока(СокрЛП(Текст))
		ИЛИ (НЕ ЭтоМарка И НЕ ЗначениеЗаполнено(Родитель)) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 20
		| Автомобили.Ссылка КАК Ссылка,
		| Автомобили.Наименование КАК Наименование
		|ИЗ
		| Справочник.АС_Автомобили КАК Автомобили
		|ГДЕ
		| Автомобили.ЭтоГруппа = &ЭтоГруппа
		| И НЕ Автомобили.ПометкаУдаления
		| И (Автомобили.Наименование ПОДОБНО &СтрокаПоиска
		|  ИЛИ Автомобили.АС_Синонимы ПОДОБНО &СтрокаПоиска)";

	Если НЕ ЭтоМарка Тогда
		Запрос.Текст = Запрос.Текст + Символы.ПС
			+ " И Автомобили.Родитель = &Родитель";
		Запрос.УстановитьПараметр("Родитель", Родитель);
	КонецЕсли;

	Запрос.Текст = Запрос.Текст + Символы.ПС
		+ "УПОРЯДОЧИТЬ ПО Автомобили.Наименование";
	Запрос.УстановитьПараметр("ЭтоГруппа", ЭтоМарка);
	Запрос.УстановитьПараметр("СтрокаПоиска", "%" + СокрЛП(Текст) + "%");

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Ссылка, Выборка.Наименование);
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура АС_ГосНомерАвтомобиляПриИзменении(Элемент)

	АС_ЗаполнитьНаименованиеПоАвтомобилю();

КонецПроцедуры

&НаКлиенте
Процедура АС_VINАвтомобиляПриИзменении(Элемент)

	Объект.АС_VINАвтомобиля = ВРег(Объект.АС_VINАвтомобиля);

КонецПроцедуры

&НаКлиенте
Процедура АС_ЗаполнитьНаименованиеПоАвтомобилю()

	Если НЕ ЗначениеЗаполнено(Объект.АС_МаркаАвтомобиляИзСправочника)
		ИЛИ НЕ ЗначениеЗаполнено(Объект.АС_МодельАвтомобиляИзСправочника)
		ИЛИ ПустаяСтрока(СокрЛП(Объект.АС_ГосНомерАвтомобиля)) Тогда
		Возврат;
	КонецЕсли;

	Марка = СокрЛП(Строка(Объект.АС_МаркаАвтомобиляИзСправочника));
	Модель = СокрЛП(Строка(Объект.АС_МодельАвтомобиляИзСправочника));
	ГосНомер = ВРег(СокрЛП(Объект.АС_ГосНомерАвтомобиля));

	Объект.АС_ГосНомерАвтомобиля = ГосНомер;
	Объект.Наименование = Марка + " " + Модель + " | " + ГосНомер;

КонецПроцедуры
