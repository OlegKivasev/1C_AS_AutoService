&После("ОбработкаПолученияФормы")
Процедура АС_ПолнаяКарточкаНовогоКонтрагента(
	ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка)

	Если ВидФормы <> "ФормаОбъекта" Тогда
		Возврат;
	КонецЕсли;
	Ключ = Неопределено;
	Если Параметры.Свойство("Ключ", Ключ) И ЗначениеЗаполнено(Ключ) Тогда
		Возврат;
	КонецЕсли;
	// Явно возвращаем созданную ссылку владельцу при закрытии карточки.
	Параметры.Вставить("НеобходимоОповеститьОЗаписиНового", Истина);
	// В новой карточке тип можно сменить на физлицо уже после открытия.
	Если ВыбраннаяФорма = "ФормаЭлементаБыстрая" Тогда
		ВыбраннаяФорма = "ФормаЭлемента";
		СтандартнаяОбработка = Ложь;
	КонецЕсли;

КонецПроцедуры
