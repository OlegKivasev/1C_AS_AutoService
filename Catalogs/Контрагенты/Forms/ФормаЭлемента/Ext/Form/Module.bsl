&НаКлиенте
&Перед("ПередЗаписью")
Процедура АС_ПередЗаписью(Отказ, ПараметрыЗаписи)

	АС_ЭтоНовыйОбъект = НЕ ЗначениеЗаполнено(Объект.Ссылка);

	АС_ЗаполнитьНаименованияЮрЛица();

	Если Вид = "ЮридическоеЛицо" Тогда
		Если НЕ ЗначениеЗаполнено(Объект.АС_ОПФ) Тогда
			Сообщить("Заполните поле «ОПФ».");
			Отказ = Истина;
		КонецЕсли;

		Если ПустаяСтрока(СокрЛП(Объект.АС_НазваниеОрганизации)) Тогда
			Сообщить("Заполните поле «Название».");
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;

	Если НЕ АС_ТребуетсяАвтомобиль() Тогда
		Возврат;
	КонецЕсли;

	АС_ЗаполнитьЮридическоеНазвание();

	Если НЕ ЗначениеЗаполнено(Объект.АС_МаркаАвтомобиляИзСправочника) Тогда
		Сообщить("Заполните поле «Марка» в разделе «Автомобиль».");
		Отказ = Истина;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Объект.АС_МодельАвтомобиляИзСправочника) Тогда
		Сообщить("Заполните поле «Модель» в разделе «Автомобиль».");
		Отказ = Истина;
	КонецЕсли;

	Если АС_ТребуетсяГосНомер()
		И ПустаяСтрока(СокрЛП(Объект.АС_ГосНомерАвтомобиля)) Тогда
		Сообщить("Заполните поле «Гос. номер» в разделе «Автомобиль».");
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

