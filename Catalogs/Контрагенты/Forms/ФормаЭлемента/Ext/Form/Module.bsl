&НаКлиенте
Процедура АС_НазваниеОрганизацииПриИзменении(Элемент)

	АС_ЗаполнитьНаименованияЮрЛица();

КонецПроцедуры

&НаКлиенте
Процедура АС_ЗаполнитьНаименованияЮрЛица()

	Если НЕ Вид = "ЮридическоеЛицо" Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Объект.АС_ОПФ) Тогда
		Возврат;
	КонецЕсли;

	Название = СокрЛП(Объект.АС_НазваниеОрганизации);
	Если ПустаяСтрока(Название) Тогда
		Возврат;
	КонецЕсли;

	ОПФ = СокрЛП(Строка(Объект.АС_ОПФ));
	Объект.НаименованиеПолное = ОПФ + " «" + Название + "»";
	Объект.Наименование = "«" + Название + "» " + ОПФ;

КонецПроцедуры

&НаКлиенте
Процедура АС_ЗаполнитьЮридическоеНазвание()

	Если НЕ ЗначениеЗаполнено(Объект.АС_МаркаАвтомобиляИзСправочника)
		ИЛИ НЕ ЗначениеЗаполнено(Объект.АС_МодельАвтомобиляИзСправочника) Тогда
		Возврат;
	КонецЕсли;

	Если АС_ТребуетсяГосНомер()
		И ПустаяСтрока(СокрЛП(Объект.АС_ГосНомерАвтомобиля)) Тогда
		Возврат;
	КонецЕсли;

	Марка = СокрЛП(Строка(Объект.АС_МаркаАвтомобиляИзСправочника));
	Модель = СокрЛП(Строка(Объект.АС_МодельАвтомобиляИзСправочника));
	АвтоматическоеНаименование = Марка + " " + Модель;
	Если АС_ТребуетсяГосНомер() Тогда
		ГосНомер = СокрЛП(Объект.АС_ГосНомерАвтомобиля);
		АвтоматическоеНаименование = АвтоматическоеНаименование + " | " + ГосНомер;
	КонецЕсли;
	Объект.НаименованиеПолное = АвтоматическоеНаименование;
	Объект.Наименование = АвтоматическоеНаименование;

КонецПроцедуры

&НаКлиенте
Процедура АС_ОбновитьВидимостьЭлементов()

	ЭтоФизическоеЛицо = Вид = "ФизическоеЛицо";
	ЭтоЮридическоеЛицо = Вид = "ЮридическоеЛицо";
	ВидимостьСкрываемыхЭлементов = НЕ (ЭтоФизическоеЛицо ИЛИ ЭтоЮридическоеЛицо);
	ТребуетсяАвтомобиль = АС_ТребуетсяАвтомобиль();

	АС_УстановитьВидимостьЭлемента("АС_Автомобиль", ТребуетсяАвтомобиль);
	АС_УстановитьВидимостьЭлемента("Наименование", Истина);
	АС_УстановитьВидимостьЭлемента("АС_ОПФ", ЭтоЮридическоеЛицо);
	АС_УстановитьВидимостьЭлемента("АС_НазваниеОрганизации", ЭтоЮридическоеЛицо);
	АС_УстановитьВидимостьЭлемента("ПредставлениеВПрограмме", Ложь);
	АС_УстановитьВидимостьЭлемента("ДекорацияВзаиморасчеты", НЕ ТребуетсяАвтомобиль);
	АС_УстановитьВидимостьЭлемента("ФормаЗаполнитьРеквизитыПоДаннымЕГР", НЕ ТребуетсяАвтомобиль);
	АС_УстановитьВидимостьЭлемента("ГруппаЮридическиеДанные", НЕ ЭтоФизическоеЛицо);
	АС_УстановитьВидимостьЭлемента("ГруппаОсновнойБанковскийСчет", ВидимостьСкрываемыхЭлементов);
	АС_УстановитьВидимостьЭлемента("Контакты", Истина);
	АС_УстановитьВидимостьЭлемента("ИсточникПривлеченияПокупателя", ВидимостьСкрываемыхЭлементов);
	АС_УстановитьВидимостьЭлемента("СтатьяДДСПоУмолчанию", ВидимостьСкрываемыхЭлементов);
	АС_УстановитьВидимостьЭлемента("ГруппаВзаиморасчеты", ВидимостьСкрываемыхЭлементов);
	АС_УстановитьВидимостьЭлемента("Взаиморасчеты", ВидимостьСкрываемыхЭлементов);
	АС_УстановитьВидимостьЭлемента("АналитикаВзаиморасчетов", ВидимостьСкрываемыхЭлементов);
	АС_УстановитьВидимостьЭлемента("ДополнительныеРеквизиты", ВидимостьСкрываемыхЭлементов);
	АС_УстановитьВидимостьЭлемента("ДобавитьДополнительныйРеквизит", ВидимостьСкрываемыхЭлементов);
	АС_УстановитьВидимостьЭлемента("ГруппаИндексыСПАРКРиски", НЕ ЭтоЮридическоеЛицо);

	АС_ОбновитьВидимостьКонтактнойИнформации(НЕ ЭтоФизическоеЛицо);

КонецПроцедуры

&НаКлиенте
Процедура АС_ОбновитьВидимостьКонтактнойИнформации(Видимость)

	СкрываемыеВиды = Новый Массив;
	СкрываемыеВиды.Добавить(ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.EmailКонтрагента"));
	СкрываемыеВиды.Добавить(ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.ЮрАдресКонтрагента"));
	СкрываемыеВиды.Добавить(ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.ФактАдресКонтрагента"));
	СкрываемыеВиды.Добавить(ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.ВебСайтКонтрагента"));
	СкрываемыеВиды.Добавить(ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.ПочтовыйАдресКонтрагента"));

	Для Каждого ОписаниеКИ Из ЭтотОбъект.КонтактнаяИнформацияОписаниеДополнительныхРеквизитов Цикл
		Если СкрываемыеВиды.Найти(ОписаниеКИ.Вид) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		АС_УстановитьВидимостьЭлемента("Группа" + ОписаниеКИ.ИмяРеквизита, Видимость);
		АС_УстановитьВидимостьЭлемента("ГруппаЗаголовок" + ОписаниеКИ.ИмяРеквизита, Видимость);
		АС_УстановитьВидимостьЭлемента(ОписаниеКИ.ИмяРеквизита, Видимость);
		АС_УстановитьВидимостьЭлемента("Комментарий" + ОписаниеКИ.ИмяРеквизита, Видимость);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура АС_УстановитьВидимостьЭлемента(ИмяЭлемента, Видимость)

	ЭлементФормы = Элементы.Найти(ИмяЭлемента);
	Если ЭлементФормы <> Неопределено Тогда
		ЭлементФормы.Видимость = Видимость;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция АС_ТребуетсяАвтомобиль()

	Возврат (Объект.Покупатель
		И (Вид = "ФизическоеЛицо" ИЛИ Вид = "Самозанятый"))
		ИЛИ (Объект.ПрочиеОтношения И Вид = "ФизическоеЛицо");

КонецФункции

&НаКлиенте
Функция АС_ТребуетсяГосНомер()

	Возврат Объект.Покупатель
		И (Вид = "ФизическоеЛицо" ИЛИ Вид = "Самозанятый")
		И НЕ (Объект.ПрочиеОтношения И Вид = "ФизическоеЛицо");

КонецФункции

&НаКлиенте
&После("ПослеЗаписи")
Процедура АС_ПослеЗаписи(ПараметрыЗаписи)

	Если НЕ АС_ЭтоНовыйОбъект Тогда
		Возврат;
	КонецЕсли;

	АС_ЗаполнитьДатуСозданияОсновногоДоговора();

КонецПроцедуры

&НаСервере
Процедура АС_ЗаполнитьДатуСозданияОсновногоДоговора()

	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;

	Если НЕ Объект.ВидКонтрагента = Перечисления.ВидыКонтрагентов.ЮридическоеЛицо Тогда
		Возврат;
	КонецЕсли;

	Договор = Справочники.ДоговорыКонтрагентов.ДоговорПоУмолчанию(Объект.Ссылка);
	Если НЕ ЗначениеЗаполнено(Договор) Тогда
		Возврат;
	КонецЕсли;

	ОбъектДоговора = Договор.ПолучитьОбъект();
	Если НЕ ЗначениеЗаполнено(ОбъектДоговора.ДатаСоздания) Тогда
		ОбъектДоговора.ДатаСоздания = ТекущаяДатаСеанса();
		ОбъектДоговора.Записать();
	КонецЕсли;

КонецПроцедуры
