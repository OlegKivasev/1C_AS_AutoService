Процедура ПередЗаписью(Отказ)
	
	Если АС_УсловноИспользоватьОбработчик Тогда
		Наименование = НормализоватьНаименование(Наименование);
	КонецЕсли;
	
КонецПроцедуры

Функция НормализоватьНаименование(Значение)
	
	Результат = СокрЛП(СтрЗаменить(Строка(Значение), Символы.НПП, " "));
	Результат = НРег(Результат);
	Если СтрДлина(Результат) > 0 Тогда
		Результат = ВРег(Лев(Результат, 1)) + Сред(Результат, 2);
	КонецЕсли;
	Возврат Результат;
	
КонецФункции
