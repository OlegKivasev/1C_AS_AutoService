
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)

	Оповещение = Новый ОписаниеОповещения("ПослеВыбораФайла", ЭтотОбъект,
		Новый Структура("Источник", ПараметрыВыполненияКоманды.Источник));
	ФайловаяСистемаКлиент.ЗагрузитьФайл(Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораФайла(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Или Результат.Количество() = 0
		Или НЕ ЗначениеЗаполнено(Результат.Хранение) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Итог = ИмпортироватьCSVНаСервере(Результат.Хранение);
		ОбщегоНазначенияКлиент.СообщитьПользователю(Итог);
	Исключение
		ПоказатьПредупреждение(, "Не удалось импортировать CSV:" + Символы.ПС
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

&НаСервере
Функция ИмпортироватьCSVНаСервере(Адрес)

	ДвоичныеДанныеCSV = ПолучитьИзВременногоХранилища(Адрес);
	ТекстCSV = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанныеCSV, КодировкаТекста.UTF8);

	СуществующиеНаименования = ПолучитьСуществующиеНаименования();
	Добавлено = 0;
	ПропущеноПустыхСтрок = 0;
	ПропущеноДубликатов = 0;

	Для Каждого СтрокаCSV Из СтрРазделить(ТекстCSV, Символы.ПС, Ложь) Цикл
		Наименование = ОчиститьНаименованиеCSV(СтрокаCSV);
		Если ПустаяСтрока(Наименование) Тогда
			ПропущеноПустыхСтрок = ПропущеноПустыхСтрок + 1;
			Продолжить;
		КонецЕсли;

		КлючНаименования = СформироватьКлючНаименования(Наименование);
		Если СуществующиеНаименования.Получить(КлючНаименования) <> Неопределено Тогда
			ПропущеноДубликатов = ПропущеноДубликатов + 1;
			Продолжить;
		КонецЕсли;

		ОбъектРаботы = Справочники.АС_Работа.СоздатьЭлемент();
		ОбъектРаботы.АС_УсловноИспользоватьОбработчик = Истина;
		ОбъектРаботы.Наименование = Наименование;
		ОбъектРаботы.Записать();

		СуществующиеНаименования.Вставить(КлючНаименования, Истина);
		Добавлено = Добавлено + 1;
	КонецЦикла;

	Возврат СтрШаблон("Импорт завершён. Добавлено: %1. Пропущено пустых строк: %2. Дубликатов: %3.",
		Добавлено, ПропущеноПустыхСтрок, ПропущеноДубликатов);

КонецФункции

&НаСервере
Функция ПолучитьСуществующиеНаименования()

	Результат = Новый Соответствие;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|Работы.Наименование
		|ИЗ
		|Справочник.АС_Работа КАК Работы");

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(СформироватьКлючНаименования(Выборка.Наименование), Истина);
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервере
Функция ОчиститьНаименованиеCSV(Значение)

	Результат = СокрЛП(Значение);
	Если СтрНачинаетсяС(Результат, """") И СтрЗаканчиваетсяНа(Результат, """") Тогда
		Результат = Сред(Результат, 2, СтрДлина(Результат) - 2);
		Результат = СтрЗаменить(Результат, """""", """");
	КонецЕсли;

	Возврат СокрЛП(Результат);

КонецФункции

&НаСервере
Функция СформироватьКлючНаименования(Значение)

	Возврат ВРег(СокрЛП(СтрЗаменить(Строка(Значение), Символы.НПП, " ")));

КонецФункции
