&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Реквизиты = Новый Массив;
	Реквизиты.Добавить(Новый РеквизитФормы("Покупатели", Новый ОписаниеТипов("ТаблицаЗначений")));
	Реквизиты.Добавить(Новый РеквизитФормы("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"), "Покупатели"));
	Реквизиты.Добавить(Новый РеквизитФормы("ИсходныйСписок", Новый ОписаниеТипов("Строка")));
	ИзменитьРеквизиты(Реквизиты);
	ТаблицаПокупателей = ПрочитатьСписок();
	ЗначениеВРеквизитФормы(ТаблицаПокупателей, "Покупатели");
	ЭтотОбъект.ИсходныйСписок = КлючСписка(ТаблицаПокупателей);

	Пояснение = Элементы.Добавить("Пояснение", Тип("ДекорацияФормы"));
	Пояснение.Вид = ВидДекорацииФормы.Надпись;
	Пояснение.Заголовок = "Покупателям из списка нельзя добавлять в заказ покупателя или заказ-наряд последнюю запчасть. "
		+ "После добавления должна оставаться хотя бы одна штука с учётом заказов. Список изменяет администратор.";
	Таблица = Элементы.Добавить("Покупатели", Тип("ТаблицаФормы"));
	Таблица.ПутьКДанным = "Покупатели";
	Таблица.ТолькоПросмотр = Не Пользователи.ЭтоПолноправныйПользователь();
	Поле = Элементы.Добавить("ПокупателиКонтрагент", Тип("ПолеФормы"), Таблица);
	Поле.Вид = ВидПоляФормы.ПолеВвода;
	Поле.ПутьКДанным = "Покупатели.Контрагент";
	Поле.Заголовок = "Покупатель";
	Команда = Команды.Добавить("Сохранить");
	Команда.Действие = "Сохранить";
	Команда.Заголовок = "Сохранить";
	Кнопка = Элементы.Добавить("Сохранить", Тип("КнопкаФормы"));
	Кнопка.ИмяКоманды = "Сохранить";
	Кнопка.Видимость = Пользователи.ЭтоПолноправныйПользователь();

КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)

	СохранитьНаСервере();
	Закрыть();

КонецПроцедуры

&НаСервере
Процедура СохранитьНаСервере()

	Если Не Пользователи.ЭтоПолноправныйПользователь() Тогда
		ВызватьИсключение "Изменять ограничения покупателей может только администратор.";
	КонецЕсли;
	ТаблицаПокупателей = РеквизитФормыВЗначение("Покупатели");
	Для Каждого СтрокаПокупателя Из ТаблицаПокупателей Цикл
		Если Не ЗначениеЗаполнено(СтрокаПокупателя.Контрагент) Тогда
			ВызватьИсключение "Выберите покупателя в каждой строке или удалите пустые строки.";
		КонецЕсли;
	КонецЦикла;
	ТаблицаПокупателей.Свернуть("Контрагент");
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.АС_ОграниченияПокупателей");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		Если КлючСписка(ПрочитатьСписок()) <> ЭтотОбъект.ИсходныйСписок Тогда
			ВызватьИсключение "Список ограничений уже изменён другим пользователем. Откройте форму заново.";
		КонецЕсли;
		Набор = РегистрыСведений.АС_ОграниченияПокупателей.СоздатьНаборЗаписей();
		Для Каждого СтрокаПокупателя Из ТаблицаПокупателей Цикл
			Запись = Набор.Добавить();
			Запись.Контрагент = СтрокаПокупателя.Контрагент;
		КонецЦикла;
		Набор.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

&НаСервере
Функция ПрочитатьСписок()

	Запрос = Новый Запрос("ВЫБРАТЬ Контрагент ИЗ РегистрСведений.АС_ОграниченияПокупателей УПОРЯДОЧИТЬ ПО Контрагент");
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

&НаСервере
Функция КлючСписка(ТаблицаПокупателей)

	// UUID не меняются при переименовании контрагента; порядок строк несущественен.
	Ключи = Новый ТаблицаЗначений;
	Ключи.Колонки.Добавить("Ключ", Новый ОписаниеТипов("Строка"));
	Для Каждого СтрокаПокупателя Из ТаблицаПокупателей Цикл
		Ключи.Добавить().Ключ = Строка(СтрокаПокупателя.Контрагент.УникальныйИдентификатор());
	КонецЦикла;
	Ключи.Сортировать("Ключ");
	Возврат СтрСоединить(Ключи.ВыгрузитьКолонку("Ключ"), ",");

КонецФункции
