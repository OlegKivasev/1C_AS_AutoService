		<Attribute name="АС_Товары" id="10">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<UseAlways>
				<Field>АС_Товары.Заказ</Field>
				<Field>АС_Товары.ЭтоЗаказНаряд</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ РАЗРЕШЕННЫЕ
    ДокументЗаказа.Ссылка КАК Заказ,
    ДокументЗаказа.Дата КАК Дата,
    ВЫБОР КОГДА ДокументЗаказа.ВидОперации =
        ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаряд)
        ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК ЭтоЗаказНаряд
ПОМЕСТИТЬ ВТЗаказыМодели
ИЗ
    Документ.ЗаказПокупателя КАК ДокументЗаказа
        ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорАвтомобиля
        ПО ДокументЗаказа.Договор = ДоговорАвтомобиля.Ссылка
        ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК ПокупательАвтомобиля
        ПО ДокументЗаказа.Контрагент = ПокупательАвтомобиля.Ссылка
ГДЕ
    НЕ ДокументЗаказа.ПометкаУдаления
    И ДокументЗаказа.Дата &gt;= &amp;ПримененноеНачалоПериода
    И ДокументЗаказа.Дата &lt;= &amp;ПримененныйКонецПериода
    И (ВЫБОР
        КОГДА ЕСТЬNULL(ДоговорАвтомобиля.АС_МодельАвтомобиляИзСправочника,
            ЗНАЧЕНИЕ(Справочник.АС_Автомобили.ПустаяСсылка))
            &lt;&gt; ЗНАЧЕНИЕ(Справочник.АС_Автомобили.ПустаяСсылка)
        ТОГДА ДоговорАвтомобиля.АС_МодельАвтомобиляИзСправочника
        ИНАЧЕ ПокупательАвтомобиля.АС_МодельАвтомобиляИзСправочника
    КОНЕЦ) = &amp;МодельФормы
ИНДЕКСИРОВАТЬ ПО
    Заказ
;

ВЫБРАТЬ РАЗРЕШЕННЫЕ
    ПРЕДСТАВЛЕНИЕ(СтрокиТоваров.Номенклатура) КАК НаименованиеТовара,
    ЗаказыМодели.Дата КАК Дата,
    ЗаказыМодели.Заказ КАК Заказ,
    ЗаказыМодели.ЭтоЗаказНаряд КАК ЭтоЗаказНаряд,
    СтрокиТоваров.НомерСтроки КАК НомерСтроки
ИЗ
    ВТЗаказыМодели КАК ЗаказыМодели
        ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя.Запасы КАК СтрокиТоваров
        ПО ЗаказыМодели.Заказ = СтрокиТоваров.Ссылка
ГДЕ
    НЕ СтрокиТоваров.ЭтоРазделитель
    И СтрокиТоваров.Номенклатура &lt;&gt; ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
    И СтрокиТоваров.Номенклатура &lt;&gt; &quot;&quot;</QueryText>
				<KeyType>RowKey</KeyType>
				<KeyField>Заказ</KeyField>
				<KeyField>НомерСтроки</KeyField>
				<ListSettings><dcsset:filter xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings"><dcsset:viewMode>Normal</dcsset:viewMode><dcsset:userSettingID>5070e3fa-88cb-46e6-a4ef-1cd959363aae</dcsset:userSettingID></dcsset:filter><dcsset:order xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings"><dcsset:item xsi:type="dcsset:OrderItemField" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><dcsset:field>Дата</dcsset:field><dcsset:orderType>Desc</dcsset:orderType></dcsset:item><dcsset:viewMode>Normal</dcsset:viewMode><dcsset:userSettingID>7eb3306a-cd88-4f54-819d-364ce3617bb5</dcsset:userSettingID></dcsset:order><dcsset:conditionalAppearance xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings"><dcsset:viewMode>Normal</dcsset:viewMode><dcsset:userSettingID>325b98a9-60e0-4a47-b175-97a6b3533596</dcsset:userSettingID></dcsset:conditionalAppearance><dcsset:itemsViewMode xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings">Normal</dcsset:itemsViewMode><dcsset:itemsUserSettingID xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings">9e920eed-fd7e-4643-8421-9de6bfa95403</dcsset:itemsUserSettingID></ListSettings>
			</Settings>
		</Attribute>
	</Attributes>
