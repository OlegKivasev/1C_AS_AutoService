			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>ВЫБРАТЬ РАЗРЕШЕННЫЕ
    СтрокиТоваров.Номенклатура КАК Номенклатура,
    СтрокиТоваров.Ссылка.Дата КАК Дата,
    СтрокиТоваров.Ссылка КАК Заказ,
    ВЫБОР КОГДА СтрокиТоваров.Ссылка.ВидОперации =
        ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаряд)
        ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК ЭтоЗаказНаряд,
    СтрокиТоваров.НомерСтроки КАК НомерСтроки
ИЗ Документ.ЗаказПокупателя.Запасы КАК СтрокиТоваров
ГДЕ ЛОЖЬ
    И НЕ СтрокиТоваров.Ссылка.ПометкаУдаления
    И НЕ СтрокиТоваров.ЭтоРазделитель
    И СтрокиТоваров.Номенклатура &lt;&gt; ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
    И СтрокиТоваров.Номенклатура &lt;&gt; ""</QueryText>
