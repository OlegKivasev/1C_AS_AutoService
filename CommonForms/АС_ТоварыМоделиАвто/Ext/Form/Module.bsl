&НаСервере
Процедура АС_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    Если НЕ Параметры.Свойство("Модель") Тогда
        Отказ = Истина;
        Возврат;
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Параметры.Модель) Тогда
        Отказ = Истина;
        Возврат;
    КонецЕсли;

    МодельФормы = Параметры.Модель;
    Если Параметры.Свойство("НачалоПериода") Тогда
        НачалоПериода = Параметры.НачалоПериода;
    КонецЕсли;
    Если Параметры.Свойство("КонецПериода") Тогда
        КонецПериода = Параметры.КонецПериода;
    КонецЕсли;
    АС_УстановитьПараметрыЗапросаНаСервере();

    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
    | Модели.Родитель.Наименование КАК Марка,
    | Модели.Наименование КАК Модель
    |ИЗ Справочник.АС_Автомобили КАК Модели
    |ГДЕ Модели.Ссылка = &Модель";
    Запрос.УстановитьПараметр("Модель", МодельФормы);
    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда
        Заголовок = СокрЛП(Выборка.Марка + " " + Выборка.Модель) + " — товары из заказов";
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_Обновить(Команда)

    Если ЗначениеЗаполнено(НачалоПериода) И ЗначениеЗаполнено(КонецПериода)
        И НачалоПериода > КонецПериода Тогда
        Сообщить("Начало периода не может быть позже окончания.");
        Возврат;
    КонецЕсли;

    АС_УстановитьПараметрыЗапросаНаСервере();
    Элементы.АС_Товары.Обновить();

КонецПроцедуры

&НаСервере
Процедура АС_УстановитьПараметрыЗапросаНаСервере()

    Если ЗначениеЗаполнено(НачалоПериода) Тогда
        ПримененноеНачалоПериода = НачалоДня(НачалоПериода);
    Иначе
        ПримененноеНачалоПериода = Дата(1, 1, 1);
    КонецЕсли;

    Если ЗначениеЗаполнено(КонецПериода) Тогда
        ПримененныйКонецПериода = КонецДня(КонецПериода);
    Иначе
        ПримененныйКонецПериода = Дата(3999, 12, 31, 23, 59, 59);
    КонецЕсли;

    ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
        АС_Товары, "ПримененноеНачалоПериода", ПримененноеНачалоПериода);
    ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
        АС_Товары, "ПримененныйКонецПериода", ПримененныйКонецПериода);
    ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
        АС_Товары, "МодельФормы", МодельФормы);

КонецПроцедуры

&НаКлиенте
Процедура АС_СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

    СтандартнаяОбработка = Ложь;
    ДанныеСтроки = Элемент.ТекущиеДанные;
    Если ДанныеСтроки = Неопределено Тогда
        Возврат;
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(ДанныеСтроки.Заказ) Тогда
        Возврат;
    КонецЕсли;

    ПараметрыЗаказа = Новый Структура("Ключ", ДанныеСтроки.Заказ);
    Если ДанныеСтроки.ЭтоЗаказНаряд Тогда
        ОткрытьФорму("Документ.ЗаказПокупателя.Форма.ФормаЗаказНаряда", ПараметрыЗаказа, ЭтаФорма);
    Иначе
        ОткрытьФорму("Документ.ЗаказПокупателя.Форма.ФормаДокумента", ПараметрыЗаказа, ЭтаФорма);
    КонецЕсли;

КонецПроцедуры
