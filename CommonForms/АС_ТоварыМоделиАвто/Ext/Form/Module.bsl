&НаСервере
Процедура АС_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    Если НЕ Параметры.Свойство("Модель") Тогда
        Отказ = Истина;
        Возврат;
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Параметры.Модель) Тогда
        Отказ = Истина;
        Возврат;
    КонецЕсли;
    МодельФормы = Параметры.Модель;
    Если Параметры.Свойство("НачалоПериода") Тогда
        НачалоПериода = НачалоДня(Параметры.НачалоПериода);
    КонецЕсли;
    Если Параметры.Свойство("КонецПериода") Тогда
        КонецПериода = НачалоДня(Параметры.КонецПериода);
    КонецЕсли;
    АС_ЗагрузитьДанныеНаСервере();

    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
    | Модели.Родитель.Наименование КАК Марка,
    | Модели.Наименование КАК Модель
    |ИЗ Справочник.АС_Автомобили КАК Модели
    |ГДЕ Модели.Ссылка = &Модель";
    Запрос.УстановитьПараметр("Модель", МодельФормы);
    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда
        Заголовок = СокрЛП(Выборка.Марка + " " + Выборка.Модель) + " — товары из заказов";
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_Обновить(Команда)

    Если ЗначениеЗаполнено(НачалоПериода) И ЗначениеЗаполнено(КонецПериода)
        И НачалоПериода > КонецПериода Тогда
        Сообщить("Начало периода не может быть позже окончания.");
        Возврат;
    КонецЕсли;
    АС_ЗагрузитьДанныеНаСервере();
    Элементы.АС_Товары.Обновить();

КонецПроцедуры

&НаСервере
Процедура АС_ЗагрузитьДанныеНаСервере()

    НовоеНачалоПериода = НачалоДня(НачалоПериода);
    НовыйКонецПериода = КонецПериода;
    Если ЗначениеЗаполнено(КонецПериода) Тогда
        НовыйКонецПериода = КонецДня(КонецПериода);
    КонецЕсли;

    // Подготовка выполняется только при открытии и явном обновлении формы.
    // Запрос динамического списка не содержит этого тяжёлого расчёта.
    Запрос = Новый Запрос;
    Запрос.Текст = АС_ТекстЗапросаДанных(ЗначениеЗаполнено(КонецПериода));
    Запрос.УстановитьПараметр("НачалоПериода", НовоеНачалоПериода);
    Запрос.УстановитьПараметр("КонецПериода", НовыйКонецПериода);
    Запрос.УстановитьПараметр("Модель", МодельФормы);
    ЗаказыМодели = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Заказ");
    АС_Товары.ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
    |    СтрокиТоваров.Номенклатура КАК Номенклатура,
    |    СтрокиТоваров.Ссылка.Дата КАК Дата,
    |    СтрокиТоваров.Ссылка КАК Заказ,
    |    ВЫБОР КОГДА СтрокиТоваров.Ссылка.ВидОперации =
    |        ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаряд)
    |        ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК ЭтоЗаказНаряд,
    |    СтрокиТоваров.НомерСтроки КАК НомерСтроки
    |ИЗ Документ.ЗаказПокупателя.Запасы КАК СтрокиТоваров
    |ГДЕ СтрокиТоваров.Ссылка В (&ЗаказыМодели)
    |    И НЕ СтрокиТоваров.Ссылка.ПометкаУдаления
    |    И НЕ СтрокиТоваров.ЭтоРазделитель
    |    И СтрокиТоваров.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
    |    И СтрокиТоваров.Номенклатура <> """"";
    АС_Товары.Параметры.УстановитьЗначениеПараметра("ЗаказыМодели", ЗаказыМодели);
    АС_Товары.УстановитьОбязательноеИспользование("Заказ", Истина);
    АС_Товары.УстановитьОбязательноеИспользование("ЭтоЗаказНаряд", Истина);
    АС_Товары.УстановитьОбязательноеИспользование("НомерСтроки", Истина);
    ПримененноеНачалоПериода = НовоеНачалоПериода;
    ПримененныйКонецПериода = НовыйКонецПериода;

КонецПроцедуры

&НаКлиенте
Процедура АС_СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

    СтандартнаяОбработка = Ложь;
    ДанныеСтроки = Элемент.ТекущиеДанные;
    Если ДанныеСтроки = Неопределено Тогда
        Возврат;
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(ДанныеСтроки.Заказ) Тогда
        Возврат;
    КонецЕсли;

    ПараметрыЗаказа = Новый Структура("Ключ", ДанныеСтроки.Заказ);
    Если ДанныеСтроки.ЭтоЗаказНаряд Тогда
        ОткрытьФорму("Документ.ЗаказПокупателя.Форма.ФормаЗаказНаряда", ПараметрыЗаказа, ЭтаФорма);
    Иначе
        ОткрытьФорму("Документ.ЗаказПокупателя.Форма.ФормаДокумента", ПараметрыЗаказа, ЭтаФорма);
    КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_ТекстЗапросаДанных(ОграничитьКонецПериода)

    ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
    |    ДокументЗаказа.Ссылка КАК Заказ,
    |    ДокументЗаказа.Дата КАК Дата,
    |    ВЫБОР КОГДА ДокументЗаказа.ВидОперации =
    |        ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаряд)
    |        ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК ЭтоЗаказНаряд
    |ИЗ
    |    Документ.ЗаказПокупателя КАК ДокументЗаказа
    |        ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорАвтомобиля
    |        ПО ДокументЗаказа.Договор = ДоговорАвтомобиля.Ссылка
    |        ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК ПокупательАвтомобиля
    |        ПО ДокументЗаказа.Контрагент = ПокупательАвтомобиля.Ссылка
    |ГДЕ
    |    НЕ ДокументЗаказа.ПометкаУдаления
    |    И ДокументЗаказа.Дата >= &НачалоПериода
    |    [УсловиеКонцаПериода]
    |    И (ВЫБОР
    |        КОГДА ЕСТЬNULL(ДоговорАвтомобиля.АС_МодельАвтомобиляИзСправочника,
    |            ЗНАЧЕНИЕ(Справочник.АС_Автомобили.ПустаяСсылка))
    |            <> ЗНАЧЕНИЕ(Справочник.АС_Автомобили.ПустаяСсылка)
    |        ТОГДА ДоговорАвтомобиля.АС_МодельАвтомобиляИзСправочника
    |        ИНАЧЕ ПокупательАвтомобиля.АС_МодельАвтомобиляИзСправочника
    |    КОНЕЦ) = &Модель";
    // Убираем OR с необязательной датой: период ограничивает документы до чтения строк.
    УсловиеКонцаПериода = "";
    Если ОграничитьКонецПериода Тогда
        УсловиеКонцаПериода = "И ДокументЗаказа.Дата <= &КонецПериода";
    КонецЕсли;
    Возврат СтрЗаменить(ТекстЗапроса, "[УсловиеКонцаПериода]", УсловиеКонцаПериода);

КонецФункции
