&НаСервере
Процедура АС_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если НЕ Параметры.Свойство("Номенклатура") Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Параметры.Номенклатура) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	НоменклатураФормы = Параметры.Номенклатура;
	Заголовок = "Продажи: " + Строка(НоменклатураФормы);
	НачалоПериода = Дата(1, 1, 1);
	КонецПериода = Дата(1, 1, 1);
	ТолькоПроведенные = Ложь;
	ПоказыватьОтмененные = Истина;
	АС_ИмяТаблицыПродаж = "АС_Продажи";
	АС_УстановитьПараметрыПродаж();

КонецПроцедуры

&НаКлиенте
Процедура АС_Обновить(Команда)

	АС_ОбновитьДанные();

КонецПроцедуры

&НаКлиенте
Процедура АС_ФильтрыПриИзменении(Элемент)

	АС_ОбновитьДанные();

КонецПроцедуры

&НаКлиенте
Процедура АС_ОбновитьДанные()

	Если ЗначениеЗаполнено(НачалоПериода) И ЗначениеЗаполнено(КонецПериода)
		И НачалоПериода > КонецПериода Тогда
		ПоказатьПредупреждение(Неопределено, "Начало периода не может быть позже окончания.");
		Возврат;
	КонецЕсли;
	АС_УстановитьПараметрыПродаж();
	Элементы[АС_ИмяТаблицыПродаж].Обновить();

КонецПроцедуры

&НаСервере
Процедура АС_УстановитьПараметрыПродаж()

	// Пустая граница означает отсутствие ограничения по периоду.
	ДатаНачала = ?(ЗначениеЗаполнено(НачалоПериода), НачалоДня(НачалоПериода), Дата(1, 1, 1));
	ДатаОкончания = ?(ЗначениеЗаполнено(КонецПериода), КонецДня(КонецПериода), Дата(3999, 12, 31, 23, 59, 59));
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
		АС_Продажи, "Номенклатура", НоменклатураФормы);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
		АС_Продажи, "НачалоПериода", ДатаНачала);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
		АС_Продажи, "КонецПериода", ДатаОкончания);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
		АС_Продажи, "ТолькоПроведенные", ТолькоПроведенные);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
		АС_Продажи, "ПоказыватьОтмененные", ПоказыватьОтмененные);

КонецПроцедуры

&НаКлиенте
Процедура АС_ПродажиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	// Группу раскрывает сама платформа; ссылка на документ есть только в детальной строке.
	Если ТипЗнч(ВыбраннаяСтрока) = Тип("СтрокаГруппировкиДинамическогоСписка") Тогда
		Возврат;
	КонецЕсли;
	ДанныеСтроки = Элемент.ДанныеСтроки(ВыбраннаяСтрока);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ДанныеСтроки.Заказ) Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;
	ПараметрыЗаказа = Новый Структура("Ключ", ДанныеСтроки.Заказ);
	Если ДанныеСтроки.ЭтоЗаказНаряд Тогда
		ОткрытьФорму("Документ.ЗаказПокупателя.Форма.ФормаЗаказНаряда", ПараметрыЗаказа, ЭтаФорма);
	Иначе
		ОткрытьФорму("Документ.ЗаказПокупателя.Форма.ФормаДокумента", ПараметрыЗаказа, ЭтаФорма);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_РазвернутьВсе(Команда)

	АС_ИзменитьРаскрытиеГрупп(Истина);

КонецПроцедуры

&НаКлиенте
Процедура АС_СвернутьВсе(Команда)

	АС_ИзменитьРаскрытиеГрупп(Ложь);

КонецПроцедуры

&НаСервере
Процедура АС_ИзменитьРаскрытиеГрупп(Раскрывать)

	Перем ПрежняяТаблица, НоваяТаблица, ИмяНовойТаблицы, ИсходнаяКолонка, НоваяКолонка;
	Перем ЭлементыДляУдаления, УдаляемыйЭлемент;

	ПрежняяТаблица = Элементы[АС_ИмяТаблицыПродаж];
	ИмяНовойТаблицы = "АС_СписокПродаж_" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	НоваяТаблица = Элементы.Добавить(ИмяНовойТаблицы, Тип("ТаблицаФормы"), ПрежняяТаблица.Родитель);
	НоваяТаблица.Отображение = ПрежняяТаблица.Отображение;
	НоваяТаблица.ТолькоПросмотр = Истина;
	НоваяТаблица.ИзменятьСоставСтрок = Ложь;
	НоваяТаблица.ИзменятьПорядокСтрок = Ложь;
	НоваяТаблица.РежимВыделенияСтроки = ПрежняяТаблица.РежимВыделенияСтроки;
	НоваяТаблица.ЧередованиеЦветовСтрок = ПрежняяТаблица.ЧередованиеЦветовСтрок;
	НоваяТаблица.РастягиватьПоГоризонтали = ПрежняяТаблица.РастягиватьПоГоризонтали;
	НоваяТаблица.РастягиватьПоВертикали = ПрежняяТаблица.РастягиватьПоВертикали;
	НоваяТаблица.ПоложениеСтрокиПоиска = ПрежняяТаблица.ПоложениеСтрокиПоиска;
	НоваяТаблица.ПоложениеУправленияПоиском = ПрежняяТаблица.ПоложениеУправленияПоиском;
	НоваяТаблица.ПоложениеСостоянияПросмотра = ПрежняяТаблица.ПоложениеСостоянияПросмотра;

	// Начальный вид задаётся новой таблице до привязки списка.
	// Обновление уже открытой таблицы сохраняет раскрытие прежних групп.
	НоваяТаблица.НачальноеОтображениеДерева = ?(Раскрывать,
		НачальноеОтображениеДерева.РаскрыватьВсеУровни,
		НачальноеОтображениеДерева.НеРаскрывать);
	НоваяТаблица.ПутьКДанным = "АС_Продажи";
	НоваяТаблица.ВосстанавливатьТекущуюСтроку = Ложь;
	НоваяТаблица.УстановитьДействие("Выбор", "АС_ПродажиВыбор");

	Для Каждого ИсходнаяКолонка Из ПрежняяТаблица.ПодчиненныеЭлементы Цикл
		Если ТипЗнч(ИсходнаяКолонка) <> Тип("ПолеФормы") Тогда
			Продолжить;
		КонецЕсли;
		НоваяКолонка = Элементы.Добавить(
			ИмяНовойТаблицы + "_" + СтрЗаменить(ИсходнаяКолонка.ПутьКДанным, ".", "_"),
			Тип("ПолеФормы"), НоваяТаблица);
		НоваяКолонка.Вид = ВидПоляФормы.ПолеВвода;
		НоваяКолонка.ПутьКДанным = ИсходнаяКолонка.ПутьКДанным;
		НоваяКолонка.Заголовок = ИсходнаяКолонка.Заголовок;
		НоваяКолонка.Ширина = ИсходнаяКолонка.Ширина;
		НоваяКолонка.Видимость = ИсходнаяКолонка.Видимость;
		НоваяКолонка.ТолькоПросмотр = Истина;
		НоваяКолонка.Формат = ИсходнаяКолонка.Формат;
	КонецЦикла;

	АС_ДобавитьКнопкуТаблицы(НоваяТаблица, "АС_РазвернутьВсе", Истина);
	АС_ДобавитьКнопкуТаблицы(НоваяТаблица, "АС_СвернутьВсе", Истина);
	АС_ДобавитьКнопкуТаблицы(НоваяТаблица, "АС_Обновить", Ложь);

	АС_ИмяТаблицыПродаж = ИмяНовойТаблицы;
	Если ПрежняяТаблица.Имя = "АС_Продажи" Тогда
		// Элементы, описанные в XML формы, платформа удалять не разрешает.
		ПрежняяТаблица.Видимость = Ложь;
	Иначе
		ЭлементыДляУдаления = Новый Массив;
		Для Каждого ИсходнаяКолонка Из ПрежняяТаблица.ПодчиненныеЭлементы Цикл
			Если ТипЗнч(ИсходнаяКолонка) = Тип("ПолеФормы") Тогда
				ЭлементыДляУдаления.Добавить(ИсходнаяКолонка);
			КонецЕсли;
		КонецЦикла;
		ЭлементыДляУдаления.Добавить(Элементы[ПрежняяТаблица.Имя + "_АС_РазвернутьВсе"]);
		ЭлементыДляУдаления.Добавить(Элементы[ПрежняяТаблица.Имя + "_АС_СвернутьВсе"]);
		ЭлементыДляУдаления.Добавить(Элементы[ПрежняяТаблица.Имя + "_АС_Обновить"]);
		Для Каждого УдаляемыйЭлемент Из ЭлементыДляУдаления Цикл
			Элементы.Удалить(УдаляемыйЭлемент);
		КонецЦикла;
		Элементы.Удалить(ПрежняяТаблица);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура АС_ДобавитьКнопкуТаблицы(ТаблицаПродаж, ИмяКомандыПродаж, ТолькоКартинка)

	Перем КнопкаПродаж;

	КнопкаПродаж = Элементы.Добавить(ТаблицаПродаж.Имя + "_" + ИмяКомандыПродаж,
		Тип("КнопкаФормы"), ТаблицаПродаж.КоманднаяПанель);
	КнопкаПродаж.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
	КнопкаПродаж.ИмяКоманды = ИмяКомандыПродаж;
	Если ТолькоКартинка Тогда
		КнопкаПродаж.Отображение = ОтображениеКнопки.Картинка;
	КонецЕсли;

КонецПроцедуры
