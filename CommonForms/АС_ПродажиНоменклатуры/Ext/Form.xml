		<Attribute name="АС_Продажи" id="8">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<UseAlways>
				<Field>АС_Продажи.Заказ</Field>
				<Field>АС_Продажи.ЭтоЗаказНаряд</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>ВЫБРАТЬ РАЗРЕШЕННЫЕ
 Продажи.Контрагент КАК Контрагент,
 Продажи.Заказ КАК Заказ,
 ВЫБОР
  КОГДА Продажи.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаряд)
   ТОГДА "Заказ-наряд № "
  ИНАЧЕ "Заказ покупателя № "
 КОНЕЦ + Продажи.Номер
 + ВЫБОР
  КОГДА Продажи.Договор = ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
   ИЛИ ОсновныеДоговоры.Договор ЕСТЬ НЕ NULL
   ТОГДА ""
  ИНАЧЕ " (" + Продажи.Договор.Наименование + ")"
 КОНЕЦ КАК Наименование,
 Продажи.Дата КАК Дата,
 Продажи.Количество КАК Количество,
 ВЫБОР
  КОГДА Продажи.Отменен ТОГДА "Отменён"
  КОГДА Продажи.Проведен ТОГДА "Проведён"
  ИНАЧЕ "Не проведён"
 КОНЕЦ КАК Состояние,
 Продажи.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаряд) КАК ЭтоЗаказНаряд
ИЗ
 (ВЫБРАТЬ
 ВЫБОР
  КОГДА Строки.Заказ.Контрагент &lt;&gt; ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
   ТОГДА Строки.Заказ.Контрагент
  ИНАЧЕ ЕСТЬNULL(ВЫРАЗИТЬ(Строки.Заказ.Договор.Владелец КАК Справочник.Контрагенты),
   ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
 КОНЕЦ КАК Контрагент,
 Строки.Заказ КАК Заказ,
 Строки.Заказ.Договор КАК Договор,
 Строки.Заказ.Номер КАК Номер,
 Строки.Заказ.Дата КАК Дата,
 Строки.Заказ.ВидОперации КАК ВидОперации,
 Строки.Заказ.Проведен КАК Проведен,
 Строки.Заказ.ВариантЗавершения = ЗНАЧЕНИЕ(Перечисление.ВариантыЗавершенияЗаказа.Отменен) КАК Отменен,
 СУММА(Строки.Количество) КАК Количество
ИЗ
 (ВЫБРАТЬ
  Запасы.Ссылка КАК Заказ,
  Запасы.Количество * ВЫБОР
   КОГДА Запасы.ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерения
    ТОГДА ВЫРАЗИТЬ(Запасы.ЕдиницаИзмерения КАК Справочник.ЕдиницыИзмерения).Коэффициент
   ИНАЧЕ 1
  КОНЕЦ КАК Количество
 ИЗ Документ.ЗаказПокупателя.Запасы КАК Запасы
 ГДЕ Запасы.Номенклатура = &amp;Номенклатура
  И Запасы.Количество &gt; 0
  И НЕ Запасы.ЭтоРазделитель
  И Запасы.НомерВариантаКП = Запасы.Ссылка.ОсновнойВариантКП
  И Запасы.Ссылка.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
  И НЕ Запасы.Ссылка.ПометкаУдаления
  И Запасы.Ссылка.ВидОперации В (
   ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаПродажу),
   ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаряд))
  И (НЕ &amp;ТолькоПроведенные ИЛИ Запасы.Ссылка.Проведен)
  И (&amp;ПоказыватьОтмененные ИЛИ Запасы.Ссылка.ВариантЗавершения
   &lt;&gt; ЗНАЧЕНИЕ(Перечисление.ВариантыЗавершенияЗаказа.Отменен))
 ОБЪЕДИНИТЬ ВСЕ
 ВЫБРАТЬ
  Работы.Ссылка,
  Работы.Количество * Работы.Кратность * Работы.Коэффициент
 ИЗ Документ.ЗаказПокупателя.Работы КАК Работы
 ГДЕ Работы.Номенклатура = &amp;Номенклатура
  И Работы.Количество &gt; 0
  И Работы.Ссылка.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
  И НЕ Работы.Ссылка.ПометкаУдаления
  И Работы.Ссылка.ВидОперации В (
   ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаПродажу),
   ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаряд))
  И (НЕ &amp;ТолькоПроведенные ИЛИ Работы.Ссылка.Проведен)
  И (&amp;ПоказыватьОтмененные ИЛИ Работы.Ссылка.ВариантЗавершения
   &lt;&gt; ЗНАЧЕНИЕ(Перечисление.ВариантыЗавершенияЗаказа.Отменен))
 ) КАК Строки
СГРУППИРОВАТЬ ПО
 ВЫБОР
  КОГДА Строки.Заказ.Контрагент &lt;&gt; ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
   ТОГДА Строки.Заказ.Контрагент
  ИНАЧЕ ЕСТЬNULL(ВЫРАЗИТЬ(Строки.Заказ.Договор.Владелец КАК Справочник.Контрагенты),
   ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
 КОНЕЦ,
 Строки.Заказ,
 Строки.Заказ.Договор,
 Строки.Заказ.Номер,
 Строки.Заказ.Дата,
 Строки.Заказ.ВидОперации,
 Строки.Заказ.Проведен,
 Строки.Заказ.ВариантЗавершения
ИМЕЮЩИЕ СУММА(Строки.Количество) &gt; 0) КАК Продажи
 ЛЕВОЕ СОЕДИНЕНИЕ
