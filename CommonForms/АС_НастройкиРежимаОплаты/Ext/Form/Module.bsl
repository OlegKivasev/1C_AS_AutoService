&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не Пользователи.ЭтоПолноправныйПользователь() Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	Реквизиты = Новый Массив;
	Для Каждого Имя Из СтрРазделить("НаличныйВидЦен,БезналичныйВидЦен,ВидЦенБезДополнительнойНаценки", ",") Цикл
		Реквизиты.Добавить(Новый РеквизитФормы(Имя, Новый ОписаниеТипов("СправочникСсылка.ВидыЦен")));
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("СкидкаНаличные,СкидкаКарта", ",") Цикл
		Реквизиты.Добавить(Новый РеквизитФормы(Имя, Новый ОписаниеТипов("Число",
			Новый КвалификаторыЧисла(5, 2, ДопустимыйЗнак.Неотрицательный))));
	КонецЦикла;
	Реквизиты.Добавить(Новый РеквизитФормы("ТоварыБезДополнительнойНаценки", Новый ОписаниеТипов("ТаблицаЗначений")));
	Реквизиты.Добавить(Новый РеквизитФормы("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"),
		"ТоварыБезДополнительнойНаценки"));
	ИзменитьРеквизиты(Реквизиты);
	Настройки = АС_ЦенообразованиеСервер.НастройкиРежимаОплаты();
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Настройки,
		"НаличныйВидЦен,БезналичныйВидЦен,СкидкаНаличные,СкидкаКарта,ВидЦенБезДополнительнойНаценки");
	Для Каждого Номенклатура Из Настройки.ТоварыБезДополнительнойНаценки Цикл
		СтрокаТовара = ЭтотОбъект.ТоварыБезДополнительнойНаценки.Добавить();
		СтрокаТовара.Номенклатура = Номенклатура;
	КонецЦикла;
	ДобавитьРежим("Карта", "Оплата картой — галочка снята", "БезналичныйВидЦен", "СкидкаКарта");
	ДобавитьРежим("Наличные", "Оплата наличными — галочка установлена", "НаличныйВидЦен", "СкидкаНаличные");
	ДобавитьНастройкиТоваровБезНаценки();
	Команда = Команды.Добавить("Сохранить");
	Команда.Действие = "Сохранить";
	Команда.Заголовок = "Сохранить";
	Кнопка = Элементы.Добавить("Сохранить", Тип("КнопкаФормы"));
	Кнопка.ИмяКоманды = "Сохранить";

КонецПроцедуры

&НаСервере
Процедура ДобавитьРежим(Имя, Заголовок, ПолеВидаЦен, ПолеСкидки)

	Группа = Элементы.Добавить(Имя, Тип("ГруппаФормы"));
	Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Группа.Заголовок = Заголовок;
	Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
	Поле = Элементы.Добавить(ПолеВидаЦен, Тип("ПолеФормы"), Группа);
	Поле.Вид = ВидПоляФормы.ПолеВвода;
	Поле.ПутьКДанным = ПолеВидаЦен;
	Поле.Заголовок = "Вид цен товаров";
	Поле = Элементы.Добавить(ПолеСкидки, Тип("ПолеФормы"), Группа);
	Поле.Вид = ВидПоляФормы.ПолеВвода;
	Поле.ПутьКДанным = ПолеСкидки;
	Поле.Заголовок = "Максимальная скидка в заказах, %";
	Поле.Подсказка = "Предел ручной скидки продавца в заказе покупателя и заказ-наряде. В РМК: наличные — 20%, карта — 23%.";

КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)

	СохранитьНаСервере();
	Закрыть(Истина);

КонецПроцедуры

&НаСервере
Процедура СохранитьНаСервере()

	Настройки = Новый Структура("НаличныйВидЦен,БезналичныйВидЦен,СкидкаНаличные,СкидкаКарта,ВидЦенБезДополнительнойНаценки");
	ЗаполнитьЗначенияСвойств(Настройки, ЭтотОбъект);
	Товары = Новый Массив;
	Для Каждого СтрокаТовара Из ЭтотОбъект.ТоварыБезДополнительнойНаценки Цикл
		Если ЗначениеЗаполнено(СтрокаТовара.Номенклатура) Тогда
			Товары.Добавить(СтрокаТовара.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	Настройки.Вставить("ТоварыБезДополнительнойНаценки", Товары);
	АС_ЦенообразованиеСервер.СохранитьНастройкиРежимаОплаты(Настройки);

КонецПроцедуры

&НаСервере
Процедура ДобавитьНастройкиТоваровБезНаценки()

	Группа = Элементы.Добавить("ГруппаТоваровБезНаценки", Тип("ГруппаФормы"));
	Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Группа.Заголовок = "Складские товары без дополнительной наценки";
	Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	Поле = Элементы.Добавить("ВидЦенБезДополнительнойНаценки", Тип("ПолеФормы"), Группа);
	Поле.Вид = ВидПоляФормы.ПолеВвода;
	Поле.ПутьКДанным = "ВидЦенБезДополнительнойНаценки";
	Поле.Заголовок = "Вид цен для выбранных товаров (35%)";
	Поле.Подсказка = "Выберите вид цен с наценкой 35% без дополнительной наценки 40%. Он применяется к складским товарам из списка при сканировании и подборе, при оплате наличными и картой. Товары из заказа поставщику рассчитываются как обычно. Скидки сохраняются.";
	Таблица = Элементы.Добавить("ТоварыБезДополнительнойНаценки", Тип("ТаблицаФормы"), Группа);
	Таблица.ПутьКДанным = "ТоварыБезДополнительнойНаценки";
	Таблица.Заголовок = "Товары: цена одинакова для наличных и карты";
	Поле = Элементы.Добавить("ТоварыБезНаценкиНоменклатура", Тип("ПолеФормы"), Таблица);
	Поле.Вид = ВидПоляФормы.ПолеВвода;
	Поле.ПутьКДанным = "ТоварыБезДополнительнойНаценки.Номенклатура";
	Поле.Заголовок = "Товар";

КонецПроцедуры
