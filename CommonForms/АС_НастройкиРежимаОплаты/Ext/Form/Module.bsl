&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не Пользователи.ЭтоПолноправныйПользователь() Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	Реквизиты = Новый Массив;
	Для Каждого Имя Из СтрРазделить("НаличныйВидЦен,БезналичныйВидЦен", ",") Цикл
		Реквизиты.Добавить(Новый РеквизитФормы(Имя, Новый ОписаниеТипов("СправочникСсылка.ВидыЦен")));
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("СкидкаНаличные,СкидкаКарта", ",") Цикл
		Реквизиты.Добавить(Новый РеквизитФормы(Имя, Новый ОписаниеТипов("Число",
			Новый КвалификаторыЧисла(5, 2, ДопустимыйЗнак.Неотрицательный))));
	КонецЦикла;
	ИзменитьРеквизиты(Реквизиты);
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, АС_ЦенообразованиеСервер.НастройкиРежимаОплаты());
	ДобавитьРежим("Карта", "Оплата картой — галочка снята", "БезналичныйВидЦен", "СкидкаКарта");
	ДобавитьРежим("Наличные", "Оплата наличными — галочка установлена", "НаличныйВидЦен", "СкидкаНаличные");
	Команда = Команды.Добавить("Сохранить");
	Команда.Действие = "Сохранить";
	Команда.Заголовок = "Сохранить";
	Кнопка = Элементы.Добавить("Сохранить", Тип("КнопкаФормы"));
	Кнопка.ИмяКоманды = "Сохранить";

КонецПроцедуры

&НаСервере
Процедура ДобавитьРежим(Имя, Заголовок, ПолеВидаЦен, ПолеСкидки)

	Группа = Элементы.Добавить(Имя, Тип("ГруппаФормы"));
	Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Группа.Заголовок = Заголовок;
	Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
	Поле = Элементы.Добавить(ПолеВидаЦен, Тип("ПолеФормы"), Группа);
	Поле.Вид = ВидПоляФормы.ПолеВвода;
	Поле.ПутьКДанным = ПолеВидаЦен;
	Поле.Заголовок = "Вид цен товаров";
	Поле = Элементы.Добавить(ПолеСкидки, Тип("ПолеФормы"), Группа);
	Поле.Вид = ВидПоляФормы.ПолеВвода;
	Поле.ПутьКДанным = ПолеСкидки;
	Поле.Заголовок = "Максимальная скидка в заказах, %";
	Поле.Подсказка = "Предел ручной скидки продавца в заказе покупателя и заказ-наряде. В РМК: наличные — 20%, карта — 23%.";

КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)

	СохранитьНаСервере();
	Закрыть(Истина);

КонецПроцедуры

&НаСервере
Процедура СохранитьНаСервере()

	Настройки = Новый Структура("НаличныйВидЦен,БезналичныйВидЦен,СкидкаНаличные,СкидкаКарта");
	ЗаполнитьЗначенияСвойств(Настройки, ЭтотОбъект);
	АС_ЦенообразованиеСервер.СохранитьНастройкиРежимаОплаты(Настройки);

КонецПроцедуры
