&НаСервере
Процедура АС_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЧекиПродажи = Неопределено;
	Если Не Параметры.Свойство("АС_ЧекиПродажи", ЧекиПродажи) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	Если ТипЗнч(ЧекиПродажи) <> Тип("Массив") Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	Если ЧекиПродажи.Количество() = 0 Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Попытка
		АС_ЗаполнитьОстатки(ЧекиПродажи);
		Если АС_Остатки.Количество() = 0 Тогда
			// Услуги и работы не требуют окна складских остатков.
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		АС_НастроитьОформление();
	Исключение
		// Продажа уже завершена: ошибка чтения остатков не должна повторять её.
		ЗаписьЖурналаРегистрации("АС_ОстаткиПослеПродажиРМК",
			УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибки());
		АС_Остатки.Очистить();
		Элементы.АС_Остатки.Видимость = Ложь;
		Элементы.АС_Описание.Видимость = Истина;
		Элементы.АС_НапоминаниеОЗаказе.Видимость = Ложь;
		Элементы.АС_Описание.Заголовок =
			"Продажа завершена. Получить остатки не удалось. Повторять продажу не нужно.";
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура АС_ЗаполнитьОстатки(ЧекиПродажи)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Чеки", ЧекиПродажи);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	| Чеки.Ссылка КАК Чек
	|ИЗ
	| Документ.ЧекККМ КАК Чеки
	|ГДЕ
	| Чеки.Ссылка В (&Чеки)
	| И Чеки.Проведен
	| И Чеки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЧековККМ.Пробит)
	| И НЕ Чеки.ОперацияСДенежнымиСредствами";
	ДоступныеЧеки = Запрос.Выполнить().Выгрузить();
	Если ДоступныеЧеки.Количество() <> ЧекиПродажи.Количество() Тогда
		ВызватьИсключение "Не все чеки продажи проведены или доступны текущему пользователю.";
	КонецЕсли;

	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	| Запасы.Ссылка.Организация КАК Организация,
	| Запасы.Номенклатура КАК Номенклатура,
	| Запасы.Характеристика КАК Характеристика,
	| Запасы.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	| СУММА(Запасы.Количество) КАК Продано
	|ИЗ
	| Документ.ЧекККМ.Запасы КАК Запасы
	|ГДЕ
	| Запасы.Ссылка В (&Чеки)
	| И Запасы.Номенклатура.ТипНоменклатуры =
	|  ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)
	| И Запасы.Количество > 0
	|СГРУППИРОВАТЬ ПО
	| Запасы.Ссылка.Организация,
	| Запасы.Номенклатура,
	| Запасы.Характеристика,
	| Запасы.ЕдиницаИзмерения
	|УПОРЯДОЧИТЬ ПО
	| Организация, Номенклатура, Характеристика, ЕдиницаИзмерения";
	Продажи = Запрос.Выполнить().Выгрузить();
	ОрганизацииПродажи = Продажи.Скопировать(, "Организация");
	ОрганизацииПродажи.Свернуть("Организация");
	ДанныеОкна = РеквизитФормыВЗначение("АС_Остатки");
	ДанныеОкна.Очистить();
	ЕстьХарактеристики = Ложь;

	Для Каждого ОрганизацияПродажи Из ОрганизацииПродажи Цикл
		СтрокиПродажи = Продажи.НайтиСтроки(
			Новый Структура("Организация", ОрганизацияПродажи.Организация));
		СтрокиДляРасчета = Новый Массив;
		Для Каждого СтрокаПродажи Из СтрокиПродажи Цикл
			// Чек уже списал запасы и погасил отгруженную часть заказа.
			// Передаём только ключи позиций, без новой потребности по продаже.
			СтрокиДляРасчета.Добавить(Новый Структура(
				"Номенклатура,Характеристика,ЕдиницаИзмерения,НеОтгружено,ИспользоватьВРасчете,УчитыватьВПотребности",
				СтрокаПродажи.Номенклатура, СтрокаПродажи.Характеристика,
				СтрокаПродажи.ЕдиницаИзмерения, 0, Истина, Ложь));
		КонецЦикла;

		// Пустая ссылка сохраняет в вычете ВСЮ оставшуюся потребность заказов.
		// Как в заказе покупателя, складом РМК расчёт не ограничиваем.
		РезультатРасчетаОстатков = АС_ДоступностьТоваровСервер.Рассчитать(
			СтрокиДляРасчета, ОрганизацияПродажи.Организация,
			Документы.ЗаказПокупателя.ПустаяСсылка());

		Для Индекс = 0 По СтрокиПродажи.Количество() - 1 Цикл
			СтрокаПродажи = СтрокиПродажи[Индекс];
			СтрокаОкна = ДанныеОкна.Добавить();
			СтрокаОкна.Товар = Строка(СтрокаПродажи.Номенклатура);
			СтрокаОкна.Номенклатура = СтрокаПродажи.Номенклатура;
			СтрокаОкна.Характеристика = Строка(СтрокаПродажи.Характеристика);
			СтрокаОкна.Организация = Строка(СтрокаПродажи.Организация);
			СтрокаОкна.Продано = СтрокаПродажи.Продано;
			СтрокаОкна.ОстатокСУчетомЗаказов = РезультатРасчетаОстатков[Индекс].Доступно;
			ЕстьХарактеристики = ЕстьХарактеристики
				Или ЗначениеЗаполнено(СтрокаПродажи.Характеристика);
		КонецЦикла;
	КонецЦикла;

	ЗначениеВРеквизитФормы(ДанныеОкна, "АС_Остатки");
	Элементы.АС_ОстаткиХарактеристика.Видимость = ЕстьХарактеристики;
	Элементы.АС_ОстаткиОрганизация.Видимость = ОрганизацииПродажи.Количество() > 1;

КонецПроцедуры

&НаСервере
Процедура АС_НастроитьОформление()

	ОформлениеНулевогоОстатка = УсловноеОформление.Элементы.Добавить();
	ОформлениеНулевогоОстатка.Использование = Истина;
	ПолеОстатка = ОформлениеНулевогоОстатка.Поля.Элементы.Добавить();
	ПолеОстатка.Поле = Новый ПолеКомпоновкиДанных("АС_ОстаткиОстатокСУчетомЗаказов");
	ПолеОстатка.Использование = Истина;
	ОтборОстатка = ОформлениеНулевогоОстатка.Отбор.Элементы.Добавить(
		Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборОстатка.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("АС_Остатки.ОстатокСУчетомЗаказов");
	ОтборОстатка.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборОстатка.ПравоеЗначение = 0;
	ОтборОстатка.Использование = Истина;
	ОформлениеНулевогоОстатка.Оформление.УстановитьЗначениеПараметра(
		"ЦветТекста", Новый Цвет(192, 0, 0));

	НастройкиОформления = АС_ИндикацияОстатковСервер.НастройкиОформления();
	Для Каждого ПравилоОформления Из НастройкиОформления.Правила Цикл
		АС_ДобавитьИндикациюОстатка(
			ПравилоОформления.ВерхняяГраница,
			ПравилоОформления.НижняяГраница,
			ПравилоОформления.ЦветФона,
			ПравилоОформления.Номенклатура,
			НастройкиОформления.ИсключенияОбщейИндикации);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура АС_ДобавитьИндикациюОстатка(
	ВерхняяГраница, НижняяГраница, ЦветФона, Номенклатура, ИсключенияОбщейИндикации)

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементОформления.Использование = Истина;
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
		ЭлементОформления.Отбор,
		"АС_Остатки.ОстатокСУчетомЗаказов",
		ВерхняяГраница,
		ВидСравненияКомпоновкиДанных.МеньшеИлиРавно);
	Если НижняяГраница <> Неопределено Тогда
		РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
			ЭлементОформления.Отбор,
			"АС_Остатки.ОстатокСУчетомЗаказов",
			НижняяГраница,
			ВидСравненияКомпоновкиДанных.Больше);
	КонецЕсли;
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
			ЭлементОформления.Отбор,
			"АС_Остатки.Номенклатура",
			Номенклатура);
	ИначеЕсли ИсключенияОбщейИндикации.Количество() > 0 Тогда
		РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
			ЭлементОформления.Отбор,
			"АС_Остатки.Номенклатура",
			ИсключенияОбщейИндикации,
			ВидСравненияКомпоновкиДанных.НеВСписке);
	КонецЕсли;
	РаботаСФормой.ДобавитьОформляемоеПоле(
		ЭлементОформления,
		"АС_ОстаткиОстатокСУчетомЗаказов");
	РаботаСФормой.ДобавитьЭлементУсловногоОформления(
		ЭлементОформления,
		"ЦветФона",
		ЦветФона);

КонецПроцедуры

&НаКлиенте
Процедура АС_Понятно(Команда)
	Закрыть();
КонецПроцедуры
