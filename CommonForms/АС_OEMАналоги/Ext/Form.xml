			</Type>
			<MainAttribute>true</MainAttribute>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ИндексИсходной.КлючOEM КАК OEM,
	Аналоги.Ссылка КАК Номенклатура,
	ЕСТЬNULL(Остатки.Количество, 0) КАК Количество
ИЗ
	РегистрСведений.АС_ИндексOEMНоменклатуры КАК ИндексИсходной
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.АС_ИндексOEMНоменклатуры КАК ИндексАналогов
		ПО ИндексАналогов.КлючOEM = ИндексИсходной.КлючOEM
			И ИндексАналогов.Номенклатура &lt;&gt; &amp;Номенклатура
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Аналоги
		ПО ИндексАналогов.Номенклатура = Аналоги.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ОстаткиТоваров.Номенклатура КАК Номенклатура,
			СУММА(ОстаткиТоваров.Количество) КАК Количество
		ИЗ
			РегистрСведений.ОстаткиТоваров КАК ОстаткиТоваров
		ГДЕ
			НЕ &amp;ОтборПоСкладу
				ИЛИ ОстаткиТоваров.СтруктурнаяЕдиница В ИЕРАРХИИ(&amp;Склад)
		СГРУППИРОВАТЬ ПО
			ОстаткиТоваров.Номенклатура) КАК Остатки
		ПО Аналоги.Ссылка = Остатки.Номенклатура
ГДЕ
	ИндексИсходной.Номенклатура = &amp;Номенклатура
	И НЕ Аналоги.ЭтоГруппа
	И НЕ Аналоги.ПометкаУдаления
	И НЕ Аналоги.Недействителен
	И Аналоги.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)

УПОРЯДОЧИТЬ ПО
	OEM,
	Аналоги.Наименование</QueryText>
