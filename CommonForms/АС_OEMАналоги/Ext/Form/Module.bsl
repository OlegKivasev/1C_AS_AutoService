&НаСервере
Процедура АС_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не Параметры.Свойство("Номенклатура")
		Или Не ЗначениеЗаполнено(Параметры.Номенклатура) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	АС_ИндексOEMСервер.ОбеспечитьИндекс();

	Склад = Справочники.СтруктурныеЕдиницы.ПустаяСсылка();
	Если Параметры.Свойство("Склад")
		И ЗначениеЗаполнено(Параметры.Склад) Тогда
		Склад = Параметры.Склад;
	КонецЕсли;

	АС_СписокOEMАналогов.Параметры.УстановитьЗначениеПараметра(
		"Номенклатура", Параметры.Номенклатура);
	АС_СписокOEMАналогов.Параметры.УстановитьЗначениеПараметра(
		"ОтборПоСкладу", ЗначениеЗаполнено(Склад));
	АС_СписокOEMАналогов.Параметры.УстановитьЗначениеПараметра("Склад", Склад);

	АвтоЗаголовок = Ложь;
	Заголовок = "OEM-аналоги: " + Строка(Параметры.Номенклатура);

КонецПроцедуры

&НаКлиенте
Процедура АС_СписокOEMАналоговВыбор(Элемент, ВыбраннаяСтрока, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено
		Или Не ЗначениеЗаполнено(ТекущиеДанные.Номенклатура) Тогда
		Возврат;
	КонецЕсли;

	ОткрытьФорму(
		"Справочник.Номенклатура.ФормаОбъекта",
		Новый Структура("Ключ", ТекущиеДанные.Номенклатура),
		ЭтаФорма);

КонецПроцедуры
