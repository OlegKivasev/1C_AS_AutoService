&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Настройки = АС_АгрегаторСервер.НастройкиДляФормы();
	Реквизиты = Новый Массив;
	Для Каждого Имя Из СтрРазделить("Включен,ТестоваяПлатформа,ФайловаяБаза", ",") Цикл
		Реквизиты.Добавить(Новый РеквизитФормы(Имя, Новый ОписаниеТипов("Булево")));
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("Адрес,НовыйСекрет,Состояние,РежимОбмена,ЭтапНастройки,ХодВыгрузки,НовыйКлючНоменклатуры,СостояниеНоменклатуры", ",") Цикл
		Реквизиты.Добавить(Новый РеквизитФормы(Имя, Новый ОписаниеТипов("Строка")));
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("ЗакупочныйВидЦен,РозничныйВидЦен,БезналичныйВидЦен", ",") Цикл
		Реквизиты.Добавить(Новый РеквизитФормы(Имя, Новый ОписаниеТипов("СправочникСсылка.ВидыЦен")));
	КонецЦикла;
	ИзменитьРеквизиты(Реквизиты);
	ЭтотОбъект.ФайловаяБаза = ОбщегоНазначения.ИнформационнаяБазаФайловая();
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Настройки, "Включен,Адрес,ТестоваяПлатформа,ЗакупочныйВидЦен,РозничныйВидЦен,БезналичныйВидЦен");
	Группа = Элементы.Добавить("ПараметрыИнтеграции", Тип("ГруппаФормы"));
	Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	Группа.ОтображатьЗаголовок = Ложь;
	Группа.Отображение = ОтображениеОбычнойГруппы.Нет;
	АС_ДобавитьПоле("Адрес", "Адрес агрегатора", ВидПоляФормы.ПолеВвода);
	АС_ДобавитьПоле("Включен", "Обмен заказ-нарядами включён", ВидПоляФормы.ПолеФлажка);
	АС_ДобавитьПоле("РежимОбмена", "Режим заказ-нарядов", ВидПоляФормы.ПолеНадписи);
	ЭтотОбъект.РежимОбмена = ?(Настройки.ТестоваяПлатформа, "Тестовый", "Рабочий");
	АС_ДобавитьПоле("НовыйСекрет", "Новый секрет заказ-нарядов", ВидПоляФормы.ПолеВвода);
	Элементы.НовыйСекрет.РежимПароля = Истина;
	Элементы.НовыйСекрет.Подсказка = "Только для обмена заказ-нарядами: значение ONEC_REPAIRS_INTEGRATION_SECRET с сервера агрегатора, без имени переменной, кавычек и пробелов. Для номенклатуры используется поле ниже. Пустое поле сохраняет ранее заданный секрет.";
	АС_ДобавитьПоле("Состояние", "Состояние обмена", ВидПоляФормы.ПолеНадписи);
	АС_ДобавитьПоле("НовыйКлючНоменклатуры", "Новый ключ номенклатуры", ВидПоляФормы.ПолеВвода);
	Элементы.НовыйКлючНоменклатуры.РежимПароля = Истина;
	Элементы.НовыйКлючНоменклатуры.Подсказка = "Сюда вставьте только ключ, созданный в разделе «Номенклатура» на сайте, без кавычек и пробелов. Секрет заказ-нарядов для поиска не нужен. Пустое поле сохраняет заданный ключ; после сохранения поиск работает автоматически.";
	АС_ДобавитьПоле("ЗакупочныйВидЦен", "Закупочный вид цен", ВидПоляФормы.ПолеВвода);
	АС_ДобавитьПоле("РозничныйВидЦен", "Розничный вид цен", ВидПоляФормы.ПолеВвода);
	АС_ДобавитьПоле("БезналичныйВидЦен", "Розничный безналичный вид цен", ВидПоляФормы.ПолеВвода);
	АС_ДобавитьПоле("СостояниеНоменклатуры", "Номенклатура", ВидПоляФормы.ПолеНадписи);
	ЭтотОбъект.СостояниеНоменклатуры = ?(Настройки.КлючНоменклатурыЗадан,
		?(ЭтотОбъект.ФайловаяБаза, "Локальная файловая база: для проверки поиска оставьте клиент 1С открытым.",
		"Ключ задан. После сохранения поиск выполняет серверное задание; открытый клиент не требуется."), "Укажите ключ и три вида цен, затем сохраните настройки.");
	Если Настройки.НужноПодтвердитьБазу Тогда
		ЭтотОбъект.Состояние = "Сохраните настройки для этой базы. После копирования автоматический обмен отключён.";
		ЭтотОбъект.СостояниеНоменклатуры = "Сохраните настройки для этой базы, чтобы подключить серверный поиск.";
	Иначе
		ЭтотОбъект.Состояние = ?(Настройки.СекретЗадан, "Секрет задан. ", "Секрет не задан. ")
			+ "Сохранение включённого обмена проверяет подключение и запускает обмен заказ-нарядами.";
	КонецЕсли;
	АС_ДобавитьКнопку("Сохранить", "Сохранить настройки");
	АС_ДобавитьКнопку("ОбновитьСостояние", "Обновить состояние");
	АС_ДобавитьКнопку("ДляРазработчиков", "Для разработчиков");
	ГруппаХода = Элементы.Добавить("ПервичнаяЗагрузка", Тип("ГруппаФормы"));
	ГруппаХода.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаХода.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	ГруппаХода.Заголовок = "Подключение к агрегатору";
	ГруппаХода.Видимость = Ложь;
	ПолеХода = Элементы.Добавить("ХодВыгрузки", Тип("ПолеФормы"), ГруппаХода);
	ПолеХода.Вид = ВидПоляФормы.ПолеНадписи;
	ПолеХода.ПутьКДанным = "ХодВыгрузки";
	ПолеХода.Заголовок = "Состояние";
	АС_ДобавитьКнопку("КНастройкам", "К настройкам", ГруппаХода);
КонецПроцедуры

&НаСервере
Процедура АС_ДобавитьПоле(Имя, Заголовок, Вид)
	Поле = Элементы.Добавить(Имя, Тип("ПолеФормы"), Элементы.ПараметрыИнтеграции);
	Поле.Вид = Вид;
	Поле.ПутьКДанным = Имя;
	Поле.Заголовок = Заголовок;
КонецПроцедуры

&НаСервере
Процедура АС_ДобавитьКнопку(Имя, Заголовок, Родитель = Неопределено)
	Если Родитель = Неопределено Тогда Родитель = Элементы.ПараметрыИнтеграции; КонецЕсли;
	Команда = Команды.Добавить(Имя);
	Команда.Заголовок = Заголовок;
	Команда.Действие = Имя;
	Кнопка = Элементы.Добавить(Имя, Тип("КнопкаФормы"), Родитель);
	Кнопка.ИмяКоманды = Имя;
	Кнопка.Заголовок = Заголовок;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если Не ЭтотОбъект.Включен Тогда Возврат; КонецЕсли;
	// Открытие формы только восстанавливает ход уже начатой выгрузки, без вопроса.
	Первичная = АС_АгрегаторСервер.СостояниеПервичнойВыгрузки();
	Если Первичная.ЕстьВыгрузка И Не Первичная.Завершена Тогда
		АС_ПоказатьХод("Выгрузка", "Восстанавливаем ход ранее начатой выгрузки…");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)
	СохранитьНаСервере();
	ЭтотОбъект.НовыйСекрет = "";
	Если ЭтотОбъект.Включен Тогда
		АС_ПоказатьХод("Проверка", "Настройки сохранены. Проверяем подключение к агрегатору…");
	Иначе
		ЭтотОбъект.Состояние = "Настройки сохранены. Обмен отключён.";
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура СохранитьНаСервере()
	// Режим меняется только в форме разработчика. Открытая ранее форма не возвращает старое значение.
	Сохраненные = АС_АгрегаторСервер.НастройкиДляФормы();
	ЭтотОбъект.ТестоваяПлатформа = Сохраненные.ТестоваяПлатформа;
	ЭтотОбъект.Адрес = СокрЛП(ЭтотОбъект.Адрес);
	Номенклатура = Новый Структура("ЗакупочныйВидЦен,РозничныйВидЦен,БезналичныйВидЦен,НовыйКлючНоменклатуры",
		ЭтотОбъект.ЗакупочныйВидЦен, ЭтотОбъект.РозничныйВидЦен, ЭтотОбъект.БезналичныйВидЦен, ЭтотОбъект.НовыйКлючНоменклатуры);
	АС_АгрегаторСервер.СохранитьНастройки(ЭтотОбъект.Включен, ЭтотОбъект.Адрес, ЭтотОбъект.ТестоваяПлатформа, ЭтотОбъект.НовыйСекрет, Номенклатура);
	ЭтотОбъект.НовыйКлючНоменклатуры = "";
	ЭтотОбъект.НовыйСекрет = "";
	Настройки = АС_АгрегаторСервер.НастройкиДляФормы();
	ЭтотОбъект.ТестоваяПлатформа = Настройки.ТестоваяПлатформа;
	ЭтотОбъект.РежимОбмена = ?(Настройки.ТестоваяПлатформа, "Тестовый", "Рабочий");
	ЭтотОбъект.СостояниеНоменклатуры = ?(Настройки.КлючНоменклатурыЗадан,
		?(ЭтотОбъект.ФайловаяБаза, "Локальный поиск настроен. Для проверки оставьте клиент 1С открытым.",
		"Серверный поиск настроен. Открытый клиент 1С не требуется."), "Ключ номенклатуры не задан.");
КонецПроцедуры

&НаКлиенте
Процедура АС_ПоказатьХод(Этап, Текст)
	ЭтотОбъект.ЭтапНастройки = Этап;
	ЭтотОбъект.ХодВыгрузки = Текст;
	Элементы.ПараметрыИнтеграции.Видимость = Ложь;
	Элементы.ПервичнаяЗагрузка.Видимость = Истина;
	ПодключитьОбработчикОжидания("АС_ПродолжитьНастройку", 1, Истина);
КонецПроцедуры

&НаКлиенте
Процедура АС_ПродолжитьНастройку() Экспорт
	Попытка
		Если ЭтотОбъект.ЭтапНастройки = "Проверка" Тогда
			Проверка = АС_АгрегаторСервер.ПроверитьНачалоОбмена(ЭтотОбъект.ТестоваяПлатформа);
			Если Проверка.НужнаВыгрузка Тогда
				ЭтотОбъект.ЭтапНастройки = "Вопрос";
				ЭтотОбъект.ХодВыгрузки = "Подключение проверено. В выбранном режиме на сайте нет карточек.";
				ПоказатьВопрос(Новый ОписаниеОповещения("АС_ОтветПервичнойВыгрузки", ЭтотОбъект),
					"В режиме «" + ЭтотОбъект.РежимОбмена + "» на сайте нет карточек. Выполнить первую выгрузку проведённых заказ-нарядов со статусом «В работе»? Последующие изменения будут передаваться автоматически.",
					РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Да);
				Возврат;
			ИначеЕсли Проверка.ЕстьВыгрузка И Не Проверка.Завершена Тогда
				ЭтотОбъект.ЭтапНастройки = "Выгрузка";
			Иначе
				АС_ВернутьсяКНастройкам("Подключение проверено. Автоматический обмен работает; повторная выгрузка не нужна.");
				Возврат;
			КонецЕсли;
		КонецЕсли;
		Если ЭтотОбъект.ЭтапНастройки = "Запуск" Тогда
			Если Не АС_АгрегаторСервер.НачатьПервичнуюВыгрузку(Ложь, ЭтотОбъект.ТестоваяПлатформа) Тогда
				ЭтотОбъект.ХодВыгрузки = "Ожидаем завершения предыдущей отправки…";
				ПодключитьОбработчикОжидания("АС_ПродолжитьНастройку", 1, Истина);
				Возврат;
			КонецЕсли;
			ЭтотОбъект.ЭтапНастройки = "Выгрузка";
		КонецЕсли;
		Если ЭтотОбъект.ЭтапНастройки = "Выгрузка" Тогда
			Первичная = АС_АгрегаторСервер.СостояниеПервичнойВыгрузки();
			Если Не Первичная.ЕстьВыгрузка Тогда
				АС_ВернутьсяКНастройкам("Выбранный режим уже заполнен другим сеансом. Повторная первая выгрузка не нужна.");
				Возврат;
			КонецЕсли;
			ЭтотОбъект.ХодВыгрузки = "Загружено " + Формат(Первичная.Загружено, "ЧГ=0")
				+ " из " + Формат(Первичная.Всего, "ЧГ=0") + " заказ-нарядов. Подтверждено сайтом.";
			Если Первичная.Завершена Тогда
				АС_ВернутьсяКНастройкам(ЭтотОбъект.ХодВыгрузки + " Автоматический обмен включён.");
				Возврат;
			КонецЕсли;
			Очередь = АС_АгрегаторСервер.СостояниеОчереди();
			Если ЗначениеЗаполнено(Очередь.Ошибка) Тогда
				ЭтотОбъект.ХодВыгрузки = ЭтотОбъект.ХодВыгрузки + " " + Очередь.Ошибка
					+ " Повторная отправка выполняется автоматически.";
			КонецЕсли;
			ПодключитьОбработчикОжидания("АС_ПродолжитьНастройку", 1, Истина);
		КонецЕсли;
	Исключение
		// Служебный модуль возвращает только безопасные сообщения без секретов.
		АС_ВернутьсяКНастройкам(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура АС_ОтветПервичнойВыгрузки(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		АС_ПоказатьХод("Запуск", "Подготовка первичной выгрузки проведённых заказ-нарядов…");
	Иначе
		АС_ВернутьсяКНастройкам("Первичная выгрузка не начата. Автоматический обмен ожидает настройки. Для продолжения сохраните настройки ещё раз.");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура АС_ВернутьсяКНастройкам(Текст)
	ОтключитьОбработчикОжидания("АС_ПродолжитьНастройку");
	ЭтотОбъект.ЭтапНастройки = "";
	Элементы.ПараметрыИнтеграции.Видимость = Истина;
	Элементы.ПервичнаяЗагрузка.Видимость = Ложь;
	ЭтотОбъект.Состояние = Текст;
КонецПроцедуры

&НаКлиенте
Процедура КНастройкам(Команда)
	АС_ВернутьсяКНастройкам("Настройки сохранены. Начатая выгрузка продолжится в фоне; её ход будет показан при следующем открытии. Если первая выгрузка не начата, сохраните настройки для её запуска.");
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	ОтключитьОбработчикОжидания("АС_ПродолжитьНастройку");
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСостояние(Команда)
	Очередь = АС_АгрегаторСервер.СостояниеОчереди();
	ЭтотОбъект.Состояние = "Ожидают передачи: " + Очередь.Количество + ". Повторные попытки выполняются автоматически.";
	Если ЗначениеЗаполнено(Очередь.Ошибка) Тогда
		ЭтотОбъект.Состояние = ЭтотОбъект.Состояние + " Есть ошибки передачи. Подробности в форме «Для разработчиков».";
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДляРазработчиков(Команда)
	ПроверитьСохраненныеНастройки();
	ОткрытьФорму("ОбщаяФорма.АС_ОтладкаАгрегатора", , ЭтотОбъект, , , ,
		Новый ОписаниеОповещения("ПослеЗакрытияОтладки", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаСервере
Процедура ПроверитьСохраненныеНастройки()
	Настройки = АС_АгрегаторСервер.НастройкиДляФормы();
	Если ЗначениеЗаполнено(ЭтотОбъект.НовыйСекрет) Или ЗначениеЗаполнено(ЭтотОбъект.НовыйКлючНоменклатуры) Тогда
		ВызватьИсключение "Сохраните настройки перед открытием формы разработчика.";
	КонецЕсли;
	Для Каждого Имя Из СтрРазделить("Включен,Адрес,ЗакупочныйВидЦен,РозничныйВидЦен,БезналичныйВидЦен", ",") Цикл
		Если ЭтотОбъект[Имя] <> Настройки[Имя] Тогда ВызватьИсключение "Сохраните настройки перед открытием формы разработчика."; КонецЕсли;
	КонецЦикла;
	ЭтотОбъект.ТестоваяПлатформа = Настройки.ТестоваяПлатформа;
	ЭтотОбъект.РежимОбмена = ?(Настройки.ТестоваяПлатформа, "Тестовый", "Рабочий");
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияОтладки(Результат, ДополнительныеПараметры) Экспорт
	Настройки = АС_АгрегаторСервер.НастройкиДляФормы();
	ЭтотОбъект.Включен = Настройки.Включен;
	ЭтотОбъект.ТестоваяПлатформа = Настройки.ТестоваяПлатформа;
	ЭтотОбъект.РежимОбмена = ?(Настройки.ТестоваяПлатформа, "Тестовый", "Рабочий");
	Если Не Настройки.Включен Тогда
		ЭтотОбъект.Состояние = "Сохранён режим «" + ЭтотОбъект.РежимОбмена + "». Обмен отключён. Для запуска включите обмен и сохраните настройки.";
	КонецЕсли;
КонецПроцедуры
