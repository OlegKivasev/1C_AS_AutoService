&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ИмяПоля = "";
	Если Не Параметры.Свойство("Поле", ИмяПоля)
		Или (ИмяПоля <> "Наименование" И ИмяПоля <> "Артикул") Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	Поле = ИмяПоля;
	Заголовок = ?(Поле = "Артикул", "Изменить артикул", "Переименовать товар");
	Элементы.НовоеЗначение.Заголовок = Поле;
	ПереданноеЗначение = "";
	БезЗаписи = Параметры.Свойство("Значение", ПереданноеЗначение);
	Если БезЗаписи Тогда
		ИсходноеЗначение = ПереданноеЗначение;
		ПереданныйБренд = Справочники.АС_БрендыТоваров.ПустаяСсылка();
		Если Параметры.Свойство("Бренд", ПереданныйБренд) Тогда ИсходныйБренд = ПереданныйБренд; КонецЕсли;
	Иначе
		Ссылка = Неопределено;
		Если Параметры.Свойство("Товар", Ссылка) Тогда Товар = Ссылка; КонецЕсли;
		Если Не МожноИзменитьТовар() Тогда
			Сообщить("Нет доступа к изменению выбранного товара.");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		Данные = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Товар, "Наименование,Артикул,ЭтоГруппа,ПометкаУдаления,АС_Бренд");
		Если Данные.ЭтоГруппа Или Данные.ПометкаУдаления Тогда
			Сообщить("Выберите действующую карточку товара.");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		ИсходноеЗначение = Данные[Поле];
		ИсходныйБренд = Данные.АС_Бренд;
		ОбаПоля = Ложь;
		Если Параметры.Свойство("ОбаПоля", ОбаПоля) И ОбаПоля Тогда
			ДополнительноеПоле = ?(Поле = "Артикул", "Наименование", "Артикул");
			ИсходноеДополнительноеЗначение = Данные[ДополнительноеПоле];
			ДополнительноеЗначение = ИсходноеДополнительноеЗначение;
			Элементы.ДополнительноеЗначение.Заголовок = ДополнительноеПоле;
			Элементы.ДополнительноеЗначение.Видимость = Истина;
		КонецЕсли;
	КонецЕсли;
	НовоеЗначение = ИсходноеЗначение;
	Бренд = ИсходныйБренд;

КонецПроцедуры

&НаКлиенте
Процедура БрендАвтоПодбор(
	Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Ожидание = Ложь;
	ДанныеВыбора = АС_НоменклатураСервер.ПолучитьБрендыДляАвтоПодбора(Текст);

КонецПроцедуры

&НаКлиенте
Процедура Переименовать(Команда)

	Значение = СокрЛП(НовоеЗначение);
	ВтороеЗначение = СокрЛП(ДополнительноеЗначение);
	Ошибка = ПроверитьПоле(Поле, Значение);
	Если ПустаяСтрока(Ошибка) И Не ПустаяСтрока(ДополнительноеПоле) Тогда
		Ошибка = ПроверитьПоле(ДополнительноеПоле, ВтороеЗначение);
	КонецЕсли;
	Если Не ПустаяСтрока(Ошибка) Тогда
		ПоказатьПредупреждение(, Ошибка);
		Возврат;
	КонецЕсли;
	Если БезЗаписи Тогда
		Закрыть(Новый Структура("Значение,Бренд", Значение, Бренд));
		Возврат;
	КонецЕсли;
	Если Значение = ИсходноеЗначение И ВтороеЗначение = ИсходноеДополнительноеЗначение И Бренд = ИсходныйБренд Тогда
		Закрыть();
		Возврат;
	КонецЕсли;
	Ошибка = ЗаписатьТоварНаСервере(Значение, ВтороеЗначение);
	Если Не ПустаяСтрока(Ошибка) Тогда
		ПоказатьПредупреждение(, Ошибка);
		Возврат;
	КонецЕсли;
	ОповеститьОбИзменении(Товар);
	Закрыть(Товар);

КонецПроцедуры

&НаКлиенте
Процедура Отменить(Команда)

	Закрыть();

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПроверитьПоле(ИмяПоля, Значение)

	Если ИмяПоля = "Артикул" И СтрДлина(Значение) > 50 Тогда
		Возврат "Артикул должен содержать не более 50 символов.";
	ИначеЕсли ИмяПоля = "Наименование" И (ПустаяСтрока(Значение) Или СтрДлина(Значение) > 100) Тогда
		Возврат "Укажите наименование товара длиной до 100 символов.";
	КонецЕсли;
	Возврат "";

КонецФункции

&НаСервере
Функция МожноИзменитьТовар()

	Возврат ЗначениеЗаполнено(Товар)
		И ПравоДоступа("Изменение", Метаданные.Справочники.Номенклатура);

КонецФункции

&НаСервере
Функция ЗаписатьТоварНаСервере(Значение, ВтороеЗначение)

	Если БезЗаписи Или Не МожноИзменитьТовар()
		Или (Поле <> "Наименование" И Поле <> "Артикул") Тогда
		Возврат "Нет доступа к изменению выбранного товара.";
	КонецЕсли;
	Если Не ПустаяСтрока(ДополнительноеПоле)
		И ДополнительноеПоле <> ?(Поле = "Артикул", "Наименование", "Артикул") Тогда
		Возврат "Не удалось определить второе поле товара.";
	КонецЕсли;
	Если Не ПустаяСтрока(ПроверитьПоле(Поле, Значение))
		Или Не ПустаяСтрока(ПроверитьПоле(ДополнительноеПоле, ВтороеЗначение)) Тогда
		Возврат "Проверьте длину и заполнение поля.";
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		СтрокаБлокировки = Блокировка.Добавить("Справочник.Номенклатура");
		СтрокаБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		СтрокаБлокировки.УстановитьЗначение("Ссылка", Товар);
		Блокировка.Заблокировать();
		Карточка = Товар.ПолучитьОбъект();
		Если Карточка = Неопределено Или Карточка.ЭтоГруппа Или Карточка.ПометкаУдаления Тогда
			ОтменитьТранзакцию();
			Возврат "Карточка товара больше недоступна.";
		КонецЕсли;
		ИзменилиПоле = Значение <> ИсходноеЗначение;
		ИзменилиДополнительноеПоле = Не ПустаяСтрока(ДополнительноеПоле)
			И ВтороеЗначение <> ИсходноеДополнительноеЗначение;
		ИзменилиБренд = Бренд <> ИсходныйБренд;
		Если (ИзменилиПоле И Карточка[Поле] <> ИсходноеЗначение)
			Или (ИзменилиДополнительноеПоле И Карточка[ДополнительноеПоле] <> ИсходноеДополнительноеЗначение)
			Или (ИзменилиБренд И Карточка.АС_Бренд <> ИсходныйБренд) Тогда
			ОтменитьТранзакцию();
			Возврат "Данные товара уже изменились. Откройте переименование снова.";
		КонецЕсли;
		Если Карточка.НаименованиеПолное = Карточка.Наименование Тогда
			Если ИзменилиПоле И Поле = "Наименование" Тогда
				Карточка.НаименованиеПолное = Значение;
			ИначеЕсли ИзменилиДополнительноеПоле И ДополнительноеПоле = "Наименование" Тогда
				Карточка.НаименованиеПолное = ВтороеЗначение;
			КонецЕсли;
		КонецЕсли;
		Если ИзменилиПоле Тогда Карточка[Поле] = Значение; КонецЕсли;
		Если ИзменилиДополнительноеПоле Тогда Карточка[ДополнительноеПоле] = ВтороеЗначение; КонецЕсли;
		Если ИзменилиБренд Тогда Карточка.АС_Бренд = Бренд; КонецЕсли;
		Карточка.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
		Возврат "Не удалось сохранить товар. Проверьте сообщения 1С.";
	КонецПопытки;
	Возврат "";

КонецФункции
