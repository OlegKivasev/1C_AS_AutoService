&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ИмяГруппы = "";
	ПереименованиеГруппы = Параметры.Свойство("НаименованиеГруппы", ИмяГруппы);
	Если ПереименованиеГруппы Тогда
		БезЗаписи = Истина;
		Наименование = ИмяГруппы;
		ИсходноеНаименование = Наименование;
		Элементы.Артикул.Видимость = Ложь;
		Элементы.Бренд.Видимость = Ложь;
		Заголовок = "Переименовать группу";
		Возврат;
	КонецЕсли;

	ДанныеТовара = Неопределено;
	БезЗаписи = Параметры.Свойство("ДанныеТовара", ДанныеТовара);
	Если БезЗаписи Тогда
		Наименование = ДанныеТовара.Наименование;
		Артикул = ДанныеТовара.Артикул;
		Бренд = ДанныеТовара.Бренд;
	Иначе
		Ссылка = Неопределено;
		Если Параметры.Свойство("Товар", Ссылка) Тогда Товар = Ссылка; КонецЕсли;
		Если Не МожноИзменитьТовар() Тогда
			Сообщить("Нет доступа к изменению выбранного товара.");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		Данные = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			Товар, "Наименование,Артикул,ЭтоГруппа,ПометкаУдаления,АС_Бренд");
		Если Данные.ЭтоГруппа Или Данные.ПометкаУдаления Тогда
			Сообщить("Выберите действующую карточку товара.");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		Наименование = Данные.Наименование;
		Артикул = Данные.Артикул;
		Бренд = Данные.АС_Бренд;
	КонецЕсли;
	ИсходноеНаименование = Наименование;
	ИсходныйАртикул = Артикул;
	ИсходныйБренд = Бренд;

КонецПроцедуры

&НаКлиенте
Процедура БрендАвтоПодбор(
	Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Ожидание = Ложь;
	ДанныеВыбора = АС_НоменклатураСервер.ПолучитьБрендыДляАвтоПодбора(Текст);

КонецПроцедуры

&НаКлиенте
Процедура Переименовать(Команда)

	Если Наименование <> ИсходноеНаименование Тогда Наименование = СокрЛП(Наименование); КонецЕсли;
	Если Артикул <> ИсходныйАртикул Тогда Артикул = СокрЛП(Артикул); КонецЕсли;
	Если Не ПереименованиеГруппы И Наименование = ИсходноеНаименование
		И Артикул = ИсходныйАртикул И Бренд = ИсходныйБренд Тогда
		Закрыть();
		Возврат;
	КонецЕсли;
	Ошибка = ПроверитьРеквизиты(Наименование, Артикул);
	Если Не ПустаяСтрока(Ошибка) Тогда
		ПоказатьПредупреждение(, Ошибка);
		Возврат;
	КонецЕсли;
	Если БезЗаписи Тогда
		Закрыть(Новый Структура("Наименование,Артикул,Бренд", Наименование, Артикул, Бренд));
		Возврат;
	КонецЕсли;
	Ошибка = ЗаписатьТоварНаСервере();
	Если Не ПустаяСтрока(Ошибка) Тогда
		ПоказатьПредупреждение(, Ошибка);
		Возврат;
	КонецЕсли;
	ОповеститьОбИзменении(Товар);
	Оповестить("Запись_Номенклатура", Товар);
	Закрыть(Товар);

КонецПроцедуры

&НаКлиенте
Процедура Отменить(Команда)

	Закрыть();

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПроверитьРеквизиты(Наименование, Артикул)

	Если ПустаяСтрока(Наименование) Или СтрДлина(Наименование) > 100 Тогда
		Возврат "Укажите наименование товара длиной до 100 символов.";
	КонецЕсли;
	Если СтрДлина(Артикул) > 50 Тогда
		Возврат "Артикул должен содержать не более 50 символов.";
	КонецЕсли;
	Возврат "";

КонецФункции

&НаСервере
Функция МожноИзменитьТовар()

	Возврат ЗначениеЗаполнено(Товар)
		И ПравоДоступа("Изменение", Метаданные.Справочники.Номенклатура);

КонецФункции

&НаСервере
Функция ЗаписатьТоварНаСервере()

	Если БезЗаписи Или Не МожноИзменитьТовар() Тогда
		Возврат "Нет доступа к изменению выбранного товара.";
	КонецЕсли;
	Ошибка = ПроверитьРеквизиты(Наименование, Артикул);
	Если Не ПустаяСтрока(Ошибка) Тогда
		Возврат Ошибка;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		СтрокаБлокировки = Блокировка.Добавить("Справочник.Номенклатура");
		СтрокаБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		СтрокаБлокировки.УстановитьЗначение("Ссылка", Товар);
		Блокировка.Заблокировать();
		Карточка = Товар.ПолучитьОбъект();
		Если Карточка = Неопределено Или Карточка.ЭтоГруппа Или Карточка.ПометкаУдаления Тогда
			ОтменитьТранзакцию();
			Возврат "Карточка товара больше недоступна.";
		КонецЕсли;
		ИзменилиНаименование = Наименование <> ИсходноеНаименование;
		ИзменилиАртикул = Артикул <> ИсходныйАртикул;
		ИзменилиБренд = Бренд <> ИсходныйБренд;
		Если (ИзменилиНаименование И Карточка.Наименование <> ИсходноеНаименование)
			Или (ИзменилиАртикул И Карточка.Артикул <> ИсходныйАртикул)
			Или (ИзменилиБренд И Карточка.АС_Бренд <> ИсходныйБренд) Тогда
			ОтменитьТранзакцию();
			Возврат "Данные товара уже изменились. Откройте переименование снова.";
		КонецЕсли;
		Если ИзменилиНаименование Тогда
			Если Карточка.НаименованиеПолное = Карточка.Наименование Тогда
				Карточка.НаименованиеПолное = Наименование;
			КонецЕсли;
			Карточка.Наименование = Наименование;
		КонецЕсли;
		Если ИзменилиАртикул Тогда Карточка.Артикул = Артикул; КонецЕсли;
		Если ИзменилиБренд Тогда Карточка.АС_Бренд = Бренд; КонецЕсли;
		Карточка.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
		Возврат "Не удалось сохранить товар. Проверьте сообщения 1С.";
	КонецПопытки;
	Возврат "";

КонецФункции
