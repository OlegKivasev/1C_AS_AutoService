&НаКлиенте
Процедура АС_Добавить(Команда)

	Результат = АС_ПодготовитьДобавлениеНаСервере();
	Если Не ПустаяСтрока(Результат.Ошибка) Тогда
		Сообщить(Результат.Ошибка);
		Возврат;
	КонецЕсли;
	Закрыть(Результат.Данные);

КонецПроцедуры

&НаКлиенте
Процедура АС_Отмена(Команда)

	Закрыть();

КонецПроцедуры

&НаСервере
Функция АС_ПодготовитьДобавлениеНаСервере()

	Результат = Новый Структура("Ошибка, Данные", "", Неопределено);
	Артикулы = Новый Массив;
	КлючиАртикулов = Новый Соответствие;
	ТекстАртикулов = СтрЗаменить(АС_Артикулы, ";", ",");
	ТекстАртикулов = СтрЗаменить(ТекстАртикулов, Символы.ВК, ",");
	ТекстАртикулов = СтрЗаменить(ТекстАртикулов, Символы.ПС, ",");
	Для Каждого ЧастьАртикула Из СтрРазделить(ТекстАртикулов, ",", Ложь) Цикл
		OEM = СокрЛП(ЧастьАртикула);
		Если ПустаяСтрока(OEM) Тогда
			Продолжить;
		КонецЕсли;
		Если СтрДлина(OEM) > 150 Тогда
			Результат.Ошибка = СтрШаблон("OEM «%1» длиннее 150 символов. Исправьте артикул.", OEM);
			Возврат Результат;
		КонецЕсли;
		КлючOEM = АС_ИндексOEMСервер.НормализоватьOEM(OEM);
		Если ПустаяСтрока(КлючOEM) Тогда
			Результат.Ошибка = СтрШаблон("OEM «%1» содержит недопустимые символы. Исправьте артикул.", OEM);
			Возврат Результат;
		КонецЕсли;
		Если КлючиАртикулов.Получить(КлючOEM) = Неопределено Тогда
			КлючиАртикулов.Вставить(КлючOEM, Истина);
			Артикулы.Добавить(OEM);
		КонецЕсли;
	КонецЦикла;
	Если Артикулы.Количество() = 0 Тогда
		Результат.Ошибка = "Введите хотя бы один OEM артикул.";
		Возврат Результат;
	КонецЕсли;

	Марки = Новый Массив;
	УникальныеМарки = Новый Соответствие;
	Для Каждого СтрокаМарки Из АС_Марки Цикл
		Если ЗначениеЗаполнено(СтрокаМарки.Марка)
			И УникальныеМарки.Получить(СтрокаМарки.Марка) = Неопределено Тогда
			УникальныеМарки.Вставить(СтрокаМарки.Марка, Истина);
			Марки.Добавить(СтрокаМарки.Марка);
		КонецЕсли;
	КонецЦикла;
	Если Марки.Количество() = 0 Тогда
		Результат.Ошибка = "Выберите хотя бы одну марку автомобиля.";
		Возврат Результат;
	КонецЕсли;

	// Проверяем ссылки до возврата результата: модель и удалённая марка не подходят.
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ Автомобили.Ссылка КАК Марка
		|ИЗ Справочник.АС_Автомобили КАК Автомобили
		|ГДЕ Автомобили.Ссылка В (&Марки)
		| И Автомобили.ЭтоГруппа
		| И НЕ Автомобили.ПометкаУдаления");
	Запрос.УстановитьПараметр("Марки", Марки);
	ДопустимыеМарки = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДопустимыеМарки.Вставить(Выборка.Марка, Истина);
	КонецЦикла;
	Для Каждого Марка Из Марки Цикл
		Если ДопустимыеМарки.Получить(Марка) = Неопределено Тогда
			Результат.Ошибка = СтрШаблон(
				"«%1» не является доступной маркой автомобиля. Выберите марку, а не модель; марка не должна быть помечена на удаление.",
				Строка(Марка));
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;

	Результат.Данные = Новый Структура("Артикулы, Марки", Артикулы, Марки);
	Возврат Результат;

КонецФункции
