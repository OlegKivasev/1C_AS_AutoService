&НаКлиенте
Процедура АС_МаркаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)

	// Обычная ссылка по-прежнему выбирает только одну марку.
	Если ТипЗнч(ВыбранноеЗначение) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	ЭтоГруппаМарок = Ложь;
	Если Не ВыбранноеЗначение.Свойство("АС_ГруппаМарок", ЭтоГруппаМарок)
		Или Не ЭтоГруппаМарок Тогда
		Возврат;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;

	ТекущаяСтрока = Элементы.АС_Марки.ТекущиеДанные;
	СтрокиПоМаркам = Новый Соответствие;
	Для Каждого СтрокаМарки Из АС_Марки Цикл
		Если ЗначениеЗаполнено(СтрокаМарки.Марка) Тогда
			СтрокиПоМаркам.Вставить(СтрокаМарки.Марка, СтрокаМарки);
		КонецЕсли;
	КонецЦикла;

	ПерваяСтрокаГруппы = Неопределено;
	Для Каждого Марка Из ВыбранноеЗначение.Марки Цикл
		СтрокаМарки = СтрокиПоМаркам.Получить(Марка);
		Если СтрокаМарки = Неопределено Тогда
			Если ТекущаяСтрока <> Неопределено
				И Не ЗначениеЗаполнено(ТекущаяСтрока.Марка) Тогда
				СтрокаМарки = ТекущаяСтрока;
			Иначе
				СтрокаМарки = АС_Марки.Добавить();
			КонецЕсли;
			СтрокаМарки.Марка = Марка;
			СтрокиПоМаркам.Вставить(Марка, СтрокаМарки);
		КонецЕсли;
		Если ПерваяСтрокаГруппы = Неопределено Тогда
			ПерваяСтрокаГруппы = СтрокаМарки;
		КонецЕсли;
	КонецЦикла;

	Если ПерваяСтрокаГруппы <> Неопределено Тогда
		// При повторном выборе группы убираем оставшуюся пустую строку ввода.
		Если ТекущаяСтрока <> Неопределено
			И Не ЗначениеЗаполнено(ТекущаяСтрока.Марка) Тогда
			АС_Марки.Удалить(ТекущаяСтрока);
		КонецЕсли;
		Элементы.АС_Марки.ТекущаяСтрока = ПерваяСтрокаГруппы.ПолучитьИдентификатор();
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_КлючСинонимаМарки(Текст)

	Возврат ВРег(СокрЛП(СтрЗаменить(Текст, Символы.НПП, " ")));

КонецФункции

&НаСервереБезКонтекста
Функция АС_ПолучитьМаркиДляАвтоПодбора(Текст)

	Результат = Новый СписокЗначений;
	ТекстПоиска = СокрЛП(Текст);
	Если ПустаяСтрока(ТекстПоиска) Тогда
		Возврат Результат;
	КонецЕсли;
	КлючПоиска = АС_КлючСинонимаМарки(ТекстПоиска);

	// Группу нельзя обрезать лимитом обычных подсказок: нужны все её марки.
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		| Автомобили.Ссылка КАК Ссылка,
		| Автомобили.Наименование КАК Наименование,
		| Автомобили.АС_Синонимы КАК Синонимы
		|ИЗ
		| Справочник.АС_Автомобили КАК Автомобили
		|ГДЕ
		| Автомобили.ЭтоГруппа
		| И НЕ Автомобили.ПометкаУдаления
		| И (Автомобили.Наименование ПОДОБНО &СтрокаПоиска
		|  ИЛИ Автомобили.АС_Синонимы ПОДОБНО &СтрокаПоиска)
		|УПОРЯДОЧИТЬ ПО Автомобили.Наименование";
	Запрос.УстановитьПараметр("СтрокаПоиска", "%" + ТекстПоиска + "%");

	ОбычныеМарки = Новый СписокЗначений;
	ГруппыПоСинонимам = Новый Соответствие;
	ГруппыМарок = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ОбычныеМарки.Количество() < 20 Тогда
			ОбычныеМарки.Добавить(Выборка.Ссылка, Выборка.Наименование);
		КонецЕсли;

		Синонимы = СтрРазделить(Выборка.Синонимы, ",", Ложь);
		// В группу GM включается и сама марка GM, даже без синонима GM.
		Синонимы.Добавить(Выборка.Наименование);
		Для Каждого Синоним Из Синонимы Цикл
			КлючСинонима = АС_КлючСинонимаМарки(Синоним);
			Если ПустаяСтрока(КлючСинонима) Или СтрНайти(КлючСинонима, КлючПоиска) = 0 Тогда
				Продолжить;
			КонецЕсли;

			ГруппаМарок = ГруппыПоСинонимам.Получить(КлючСинонима);
			Если ГруппаМарок = Неопределено Тогда
				ГруппаМарок = Новый Структура("АС_ГруппаМарок, Синоним, Ключ, Марки",
					Истина, СокрЛП(Синоним), КлючСинонима, Новый Массив);
				ГруппыПоСинонимам.Вставить(КлючСинонима, ГруппаМарок);
				ГруппыМарок.Добавить(ГруппаМарок);
			КонецЕсли;
			Если ГруппаМарок.Марки.Найти(Выборка.Ссылка) = Неопределено Тогда
				ГруппаМарок.Марки.Добавить(Выборка.Ссылка);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	ДругиеГруппы = Новый СписокЗначений;
	Для Каждого ГруппаМарок Из ГруппыМарок Цикл
		Если ГруппаМарок.Марки.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;
		Представление = Новый ФорматированнаяСтрока(
			СтрШаблон("Бренд: %1 — все марки (%2)", ГруппаМарок.Синоним, ГруппаМарок.Марки.Количество()),
			,
			Новый Цвет(0, 128, 0));
		Если ГруппаМарок.Ключ = КлючПоиска Тогда
			Результат.Добавить(ГруппаМарок, Представление);
		Иначе
			ДругиеГруппы.Добавить(ГруппаМарок, Представление);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ЭлементГруппы Из ДругиеГруппы Цикл
		Результат.Добавить(ЭлементГруппы.Значение, ЭлементГруппы.Представление);
	КонецЦикла;
	Для Каждого ЭлементМарки Из ОбычныеМарки Цикл
		Результат.Добавить(ЭлементМарки.Значение, ЭлементМарки.Представление);
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервере
Функция АС_ПодготовитьДобавлениеНаСервере()

	Результат = Новый Структура("Ошибка, Данные", "", Неопределено);
	Артикулы = Новый Массив;
	КлючиАртикулов = Новый Соответствие;
	ТекстАртикулов = СтрЗаменить(АС_Артикулы, ";", ",");
	ТекстАртикулов = СтрЗаменить(ТекстАртикулов, Символы.ВК, ",");
	ТекстАртикулов = СтрЗаменить(ТекстАртикулов, Символы.ПС, ",");
	Для Каждого ЧастьАртикула Из СтрРазделить(ТекстАртикулов, ",", Ложь) Цикл
		OEM = СокрЛП(ЧастьАртикула);
		Если ПустаяСтрока(OEM) Тогда
			Продолжить;
		КонецЕсли;
		Если СтрДлина(OEM) > 150 Тогда
			Результат.Ошибка = СтрШаблон("OEM «%1» длиннее 150 символов. Исправьте артикул.", OEM);
			Возврат Результат;
		КонецЕсли;
		КлючOEM = АС_ИндексOEMСервер.НормализоватьOEM(OEM);
		Если ПустаяСтрока(КлючOEM) Тогда
			Результат.Ошибка = СтрШаблон("OEM «%1» содержит недопустимые символы. Исправьте артикул.", OEM);
			Возврат Результат;
		КонецЕсли;
		Если КлючиАртикулов.Получить(КлючOEM) = Неопределено Тогда
			КлючиАртикулов.Вставить(КлючOEM, Истина);
			Артикулы.Добавить(OEM);
		КонецЕсли;
	КонецЦикла;
	Если Артикулы.Количество() = 0 Тогда
		Результат.Ошибка = "Введите хотя бы один OEM артикул.";
		Возврат Результат;
	КонецЕсли;

	Марки = Новый Массив;
	УникальныеМарки = Новый Соответствие;
	Для Каждого СтрокаМарки Из АС_Марки Цикл
		Если ЗначениеЗаполнено(СтрокаМарки.Марка)
			И УникальныеМарки.Получить(СтрокаМарки.Марка) = Неопределено Тогда
			УникальныеМарки.Вставить(СтрокаМарки.Марка, Истина);
			Марки.Добавить(СтрокаМарки.Марка);
		КонецЕсли;
	КонецЦикла;
	Если Марки.Количество() = 0 Тогда
		Результат.Ошибка = "Выберите хотя бы одну марку автомобиля.";
		Возврат Результат;
	КонецЕсли;

	// Проверяем ссылки до возврата результата: модель и удалённая марка не подходят.
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ Автомобили.Ссылка КАК Марка
		|ИЗ Справочник.АС_Автомобили КАК Автомобили
		|ГДЕ Автомобили.Ссылка В (&Марки)
		| И Автомобили.ЭтоГруппа
		| И НЕ Автомобили.ПометкаУдаления");
	Запрос.УстановитьПараметр("Марки", Марки);
	ДопустимыеМарки = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДопустимыеМарки.Вставить(Выборка.Марка, Истина);
	КонецЦикла;
	Для Каждого Марка Из Марки Цикл
		Если ДопустимыеМарки.Получить(Марка) = Неопределено Тогда
			Результат.Ошибка = СтрШаблон(
				"«%1» не является доступной маркой автомобиля. Выберите марку, а не модель; марка не должна быть помечена на удаление.",
				Строка(Марка));
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;

	Результат.Данные = Новый Структура("Артикулы, Марки", Артикулы, Марки);
	Возврат Результат;

КонецФункции
