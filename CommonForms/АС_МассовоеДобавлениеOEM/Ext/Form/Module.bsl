&НаКлиенте
Процедура АС_Добавить(Команда)

	Результат = АС_ПодготовитьДобавлениеНаСервере();
	Если Не ПустаяСтрока(Результат.Ошибка) Тогда
		Сообщить(Результат.Ошибка);
		Возврат;
	КонецЕсли;
	Закрыть(Результат.Данные);

КонецПроцедуры

&НаКлиенте
Процедура АС_Отмена(Команда)

	Закрыть();

КонецПроцедуры

&НаКлиенте
Процедура АС_МаркаАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Ожидание = Ложь;
