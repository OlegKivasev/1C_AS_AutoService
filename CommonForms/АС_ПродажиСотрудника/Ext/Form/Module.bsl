&НаСервере
Процедура АС_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если НЕ Параметры.Свойство("Сотрудник")
		Или НЕ ЗначениеЗаполнено(Параметры.Сотрудник) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	СотрудникФормы = Параметры.Сотрудник;
	НачалоПериода = НачалоМесяца(ТекущаяДата());
	КонецПериода = КонецМесяца(ТекущаяДата());
	ПлоскийСписок = Ложь;
	ПоказыватьНеподтвержденныеПродажи = Ложь;
	ПоказыватьОтмененныеЗаказы = Ложь;
	ОтчетСформирован = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура АС_ОбновитьПродажи(Команда)

	АС_ОбновитьДанныеНаСервере();
	Элементы.АС_Итоги.Видимость = Истина;
	АС_УстановитьПредставлениеПродаж();

КонецПроцедуры

&НаКлиенте
Процедура АС_РазвернутьВсе(Команда)

	Для Каждого СтрокаПервогоУровня Из АС_Продажи.ПолучитьЭлементы() Цикл
		ИдентификаторСтроки = СтрокаПервогоУровня.ПолучитьИдентификатор();
		Элементы.АС_Продажи.Развернуть(ИдентификаторСтроки, Истина);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура АС_СвернутьВсе(Команда)

	Для Каждого СтрокаПервогоУровня Из АС_Продажи.ПолучитьЭлементы() Цикл
		ИдентификаторСтроки = СтрокаПервогоУровня.ПолучитьИдентификатор();
		Элементы.АС_Продажи.Свернуть(ИдентификаторСтроки);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура АС_ПереключитьПредставлениеПродаж(Команда)

	ПлоскийСписок = НЕ ПлоскийСписок;
	АС_ОбновитьДанныеНаСервере();
	АС_УстановитьПредставлениеПродаж();

КонецПроцедуры

&НаКлиенте
Процедура АС_УстановитьПредставлениеПродаж()

	Элементы.АС_Продажи.Видимость = НЕ ПлоскийСписок;
	Элементы.АС_ПродажиСписок.Видимость = ПлоскийСписок;

	Если НЕ ПлоскийСписок Тогда
		АС_РазвернутьВсе(Неопределено);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура АС_ОбновитьДанныеНаСервере()

	НачалоПериода = НачалоДня(НачалоПериода);
	КонецПериода = КонецДня(КонецПериода);
	АС_ЗаполнитьДеревоПродаж();
	ОтчетСформирован = Истина;

КонецПроцедуры

&НаСервере
Процедура АС_ЗаполнитьДеревоПродаж()

	ДеревоПродаж = РеквизитФормыВЗначение("АС_Продажи");
	ДеревоПродаж.Строки.Очистить();
	КоличествоПродаж = 0;
	СуммаПродаж = 0;
	СебестоимостьПродаж = 0;
	ВаловаяПрибыльПродаж = 0;

	Запрос = Новый Запрос(АС_ТекстЗапросаПродаж());
	Запрос.УстановитьПараметр("Сотрудник", СотрудникФормы);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("ПоказыватьНеподтвержденныеПродажи", ПоказыватьНеподтвержденныеПродажи);
	Запрос.УстановитьПараметр("ПоказыватьОтмененныеЗаказы", ПоказыватьОтмененныеЗаказы);
	Выборка = Запрос.Выполнить().Выбрать();

	ТаблицаПродаж = Новый ТаблицаЗначений;
	ТаблицаПродаж.Колонки.Добавить("Дата");
	ТаблицаПродаж.Колонки.Добавить("Заказ");
	ТаблицаПродаж.Колонки.Добавить("Номенклатура");
	ТаблицаПродаж.Колонки.Добавить("Количество");
	ТаблицаПродаж.Колонки.Добавить("Сумма");
	ТаблицаПродаж.Колонки.Добавить("Себестоимость");
	ТаблицаПродаж.Колонки.Добавить("НеподтвержденнаяПродажа");
	ТаблицаПродаж.Колонки.Добавить("ОтмененЗаказ");
	ПродажиПоКлючу = Новый Соответствие;

	Пока Выборка.Следующий() Цикл
		КлючПродажи = Строка(Выборка.Заказ)
			+ "|" + Строка(Выборка.Номенклатура)
			+ "|" + Строка(Выборка.Характеристика)
			+ "|" + ?(Выборка.НеподтвержденнаяПродажа, "Неподтвержденная", "Подтвержденная")
			+ "|" + ?(Выборка.ОтмененЗаказ, "Отмененная", "НеОтмененная");
		СтрокаПродажи = ПродажиПоКлючу.Получить(КлючПродажи);

		Если СтрокаПродажи = Неопределено Тогда
			СтрокаПродажи = ТаблицаПродаж.Добавить();
			СтрокаПродажи.Дата = Выборка.Дата;
			СтрокаПродажи.Заказ = Выборка.Заказ;
			СтрокаПродажи.Номенклатура = Выборка.Номенклатура;
			СтрокаПродажи.Количество = 0;
			СтрокаПродажи.Сумма = 0;
			СтрокаПродажи.Себестоимость = 0;
			СтрокаПродажи.НеподтвержденнаяПродажа = Ложь;
			СтрокаПродажи.ОтмененЗаказ = Ложь;
			ПродажиПоКлючу.Вставить(КлючПродажи, СтрокаПродажи);
		ИначеЕсли Выборка.Дата < СтрокаПродажи.Дата Тогда
			СтрокаПродажи.Дата = Выборка.Дата;
		КонецЕсли;

		СтрокаПродажи.Количество = СтрокаПродажи.Количество + Выборка.Количество;
		СтрокаПродажи.Сумма = СтрокаПродажи.Сумма + Выборка.Сумма;
		СтрокаПродажи.Себестоимость = СтрокаПродажи.Себестоимость + Выборка.Себестоимость;
		Если Выборка.ОтмененЗаказ Тогда
			СтрокаПродажи.ОтмененЗаказ = Истина;
			СтрокаПродажи.НеподтвержденнаяПродажа = Ложь;
		ИначеЕсли Выборка.НеподтвержденнаяПродажа
			И НЕ СтрокаПродажи.ОтмененЗаказ Тогда
			СтрокаПродажи.НеподтвержденнаяПродажа = Истина;
		КонецЕсли;
	КонецЦикла;

	ТаблицаПродаж.Сортировать("Дата УБЫВ, Заказ, Номенклатура");

	ТекущийЗаказ = Неопределено;
	СтрокаЗаказа = Неопределено;
	Для Каждого СтрокаПродажи Из ТаблицаПродаж Цикл
		Если СтрокаПродажи.Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;

		Если НЕ ПлоскийСписок
			И (ТекущийЗаказ = Неопределено Или ТекущийЗаказ <> СтрокаПродажи.Заказ) Тогда
			ТекущийЗаказ = СтрокаПродажи.Заказ;
			СтрокаЗаказа = ДеревоПродаж.Строки.Добавить();
			СтрокаЗаказа.Дата = СтрокаПродажи.Дата;
			СтрокаЗаказа.ВидЗаказа = СтрокаПродажи.Заказ;
			СтрокаЗаказа.НеподтвержденнаяПродажа = СтрокаПродажи.НеподтвержденнаяПродажа;
			СтрокаЗаказа.ОтмененЗаказ = СтрокаПродажи.ОтмененЗаказ;
		КонецЕсли;

		Если ПлоскийСписок Тогда
			СтрокаТовара = ДеревоПродаж.Строки.Добавить();
			СтрокаТовара.Дата = СтрокаПродажи.Дата;
			СтрокаТовара.ВидЗаказа = СтрокаПродажи.Заказ;
		Иначе
			СтрокаТовара = СтрокаЗаказа.Строки.Добавить();
		КонецЕсли;
		СтрокаТовара.Номенклатура = СтрокаПродажи.Номенклатура;
		СтрокаТовара.Цена = СтрокаПродажи.Сумма / СтрокаПродажи.Количество;
		СтрокаТовара.Количество = СтрокаПродажи.Количество;
		СтрокаТовара.Сумма = СтрокаПродажи.Сумма;
		СтрокаТовара.НеподтвержденнаяПродажа = СтрокаПродажи.НеподтвержденнаяПродажа;
		СтрокаТовара.ОтмененЗаказ = СтрокаПродажи.ОтмененЗаказ;
		Если НЕ ПлоскийСписок Тогда
			Если СтрокаПродажи.ОтмененЗаказ Тогда
				СтрокаЗаказа.ОтмененЗаказ = Истина;
				СтрокаЗаказа.НеподтвержденнаяПродажа = Ложь;
			ИначеЕсли СтрокаПродажи.НеподтвержденнаяПродажа
				И НЕ СтрокаЗаказа.ОтмененЗаказ Тогда
				СтрокаЗаказа.НеподтвержденнаяПродажа = Истина;
			КонецЕсли;
		КонецЕсли;
		Если НЕ СтрокаПродажи.НеподтвержденнаяПродажа
			И НЕ СтрокаПродажи.ОтмененЗаказ Тогда
			КоличествоПродаж = КоличествоПродаж + СтрокаПродажи.Количество;
			СуммаПродаж = СуммаПродаж + СтрокаПродажи.Сумма;
			СебестоимостьПродаж = СебестоимостьПродаж + СтрокаПродажи.Себестоимость;
			ВаловаяПрибыльПродаж = ВаловаяПрибыльПродаж
				+ СтрокаПродажи.Сумма - СтрокаПродажи.Себестоимость;
		КонецЕсли;
	КонецЦикла;

	ЗначениеВРеквизитФормы(ДеревоПродаж, "АС_Продажи");

КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_ТекстЗапросаПродаж()

	Возврат "ВЫБРАТЬ
	| СтрокиЗаказов.Ссылка КАК ЗаказПокупателя,
	| СтрокиЗаказов.Номенклатура КАК Номенклатура,
	| СтрокиЗаказов.Характеристика КАК Характеристика,
	| СУММА(СтрокиЗаказов.Количество) КАК КоличествоЗаказа,
	| СУММА(СтрокиЗаказов.Сумма) КАК СуммаЗаказа
	|ПОМЕСТИТЬ СтрокиЗаказовПродавца
	|ИЗ
	| Документ.ЗаказПокупателя.Запасы КАК СтрокиЗаказов
	|ГДЕ
	| СтрокиЗаказов.АС_Продавец = &Сотрудник
	|СГРУППИРОВАТЬ ПО
	| СтрокиЗаказов.Ссылка,
	| СтрокиЗаказов.Номенклатура,
	| СтрокиЗаказов.Характеристика
	|;
	|
	|ВЫБРАТЬ
	|СтрокиОтмены.Ссылка КАК ЗаказПокупателя,
	|СтрокиОтмены.АС_Номенклатура КАК Номенклатура,
	|СтрокиОтмены.Характеристика КАК Характеристика,
	|СУММА(СтрокиОтмены.Количество) КАК КоличествоЗаказа,
	|СУММА(СтрокиОтмены.Количество * СтрокиОтмены.Цена) КАК СуммаЗаказа
	|ПОМЕСТИТЬ ОтмененныеСтрокиЗаказовПродавца
	|ИЗ
	|Документ.ЗаказПокупателя.ОтмененныеЗапасы КАК СтрокиОтмены
	|ГДЕ
	|СтрокиОтмены.АС_Продавец = &Сотрудник
	|СГРУППИРОВАТЬ ПО
	|СтрокиОтмены.Ссылка,
	|СтрокиОтмены.АС_Номенклатура,
	|СтрокиОтмены.Характеристика
	|;
	|
	|ВЫБРАТЬ
	| ОплатаСчетовИЗаказовОбороты.СчетНаОплату КАК ЗаказПокупателя
	|ПОМЕСТИТЬ ОплаченныеЗаказы
	|ИЗ
	| РегистрНакопления.ОплатаСчетовИЗаказов.Обороты(, , , ) КАК ОплатаСчетовИЗаказовОбороты
	|СГРУППИРОВАТЬ ПО
	| ОплатаСчетовИЗаказовОбороты.СчетНаОплату
	|ИМЕЮЩИЕ
	| СУММА(ОплатаСчетовИЗаказовОбороты.СуммаАвансаОборот
	| 	+ ОплатаСчетовИЗаказовОбороты.СуммаОплатыОборот) > 0
	|;
	|
	|ВЫБРАТЬ
	| ПродажиОбороты.ЗаказПокупателя КАК ЗаказПокупателя,
	| ПродажиОбороты.Номенклатура КАК Номенклатура,
	| ПродажиОбороты.Характеристика КАК Характеристика,
	| МАКСИМУМ(ВЫБОР
	| 	КОГДА РасходнаяНакладная.Ссылка ЕСТЬ НЕ NULL
	| 		И РасходнаяНакладная.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРасходнаяНакладная.ПродажаПокупателю)
	| 	ТОГДА 1
	| 	ИНАЧЕ 0
	| КОНЕЦ) КАК ЕстьРасходнаяНакладная,
	| МАКСИМУМ(ВЫБОР
	| 	КОГДА ПродажиОбороты.Регистратор = ПродажиОбороты.ЗаказПокупателя ТОГДА 1
	| 	ИНАЧЕ 0
	| КОНЕЦ) КАК ЕстьДвижениеЗаказНаряда
	|ПОМЕСТИТЬ ПодтвержденныеСтрокиЗаказов
	|ИЗ
	| РегистрНакопления.Продажи.Обороты(, , Регистратор, ) КАК ПродажиОбороты
	| 	ВНУТРЕННЕЕ СОЕДИНЕНИЕ СтрокиЗаказовПродавца КАК СтрокиЗаказовПродавца
	| 	ПО ПродажиОбороты.ЗаказПокупателя = СтрокиЗаказовПродавца.ЗаказПокупателя
	| 		И ПродажиОбороты.Номенклатура = СтрокиЗаказовПродавца.Номенклатура
	| 		И ПродажиОбороты.Характеристика = СтрокиЗаказовПродавца.Характеристика
	| 	ЛЕВОЕ СОЕДИНЕНИЕ Документ.РасходнаяНакладная КАК РасходнаяНакладная
	| 	ПО ПродажиОбороты.Регистратор = РасходнаяНакладная.Ссылка
	|ГДЕ
	| (РасходнаяНакладная.Ссылка ЕСТЬ НЕ NULL
	| 	И РасходнаяНакладная.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРасходнаяНакладная.ПродажаПокупателю))
	| 	ИЛИ ПродажиОбороты.Регистратор = ПродажиОбороты.ЗаказПокупателя
	|СГРУППИРОВАТЬ ПО
	| ПродажиОбороты.ЗаказПокупателя,
	| ПродажиОбороты.Номенклатура,
	| ПродажиОбороты.Характеристика
	|;
	|
	|ВЫБРАТЬ
	| ПродажиОбороты.Период КАК Дата,
	| ПродажиОбороты.ЗаказПокупателя КАК Заказ,
	| ПродажиОбороты.Номенклатура КАК Номенклатура,
	| ПродажиОбороты.Характеристика КАК Характеристика,
	| ВЫБОР
	| 	КОГДА ПродажиОбороты.КоличествоОборот = 0 ТОГДА 0
	| 	ИНАЧЕ ПродажиОбороты.СуммаОборот / ПродажиОбороты.КоличествоОборот
	| КОНЕЦ КАК Цена,
	| ПродажиОбороты.КоличествоОборот КАК Количество,
	| ПродажиОбороты.СуммаОборот КАК Сумма,
	| ПродажиОбороты.СебестоимостьОборот КАК Себестоимость,
	| ЛОЖЬ КАК НеподтвержденнаяПродажа,
	| ЛОЖЬ КАК ОтмененЗаказ
	|ИЗ
	| РегистрНакопления.Продажи.Обороты(&НачалоПериода, &КонецПериода, Регистратор, ) КАК ПродажиОбороты
	| 	ЛЕВОЕ СОЕДИНЕНИЕ Документ.РасходнаяНакладная КАК РасходнаяНакладная
	| 	ПО ПродажиОбороты.Регистратор = РасходнаяНакладная.Ссылка
	| 	ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПриходнаяНакладная КАК ПриходнаяНакладная
	| 	ПО ПродажиОбороты.Регистратор = ПриходнаяНакладная.Ссылка
	| 	ВНУТРЕННЕЕ СОЕДИНЕНИЕ СтрокиЗаказовПродавца КАК СтрокиЗаказовПродавца
	| 	ПО ПродажиОбороты.ЗаказПокупателя = СтрокиЗаказовПродавца.ЗаказПокупателя
	| 		И ПродажиОбороты.Номенклатура = СтрокиЗаказовПродавца.Номенклатура
	| 		И ПродажиОбороты.Характеристика = СтрокиЗаказовПродавца.Характеристика
	| 	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОплаченныеЗаказы КАК ОплаченныеЗаказы
	| 	ПО ПродажиОбороты.ЗаказПокупателя = ОплаченныеЗаказы.ЗаказПокупателя
	| 	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя КАК ДокументЗаказа
	| 	ПО ПродажиОбороты.ЗаказПокупателя = ДокументЗаказа.Ссылка
	|ГДЕ
	| ((РасходнаяНакладная.Ссылка ЕСТЬ НЕ NULL
	| 	И РасходнаяНакладная.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРасходнаяНакладная.ПродажаПокупателю))
	| 	ИЛИ (ПриходнаяНакладная.Ссылка ЕСТЬ НЕ NULL
	| 	И ПриходнаяНакладная.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПриходнаяНакладная.ВозвратОтПокупателя))
	| 	ИЛИ (ПродажиОбороты.Регистратор = ПродажиОбороты.ЗаказПокупателя
	| 	И ДокументЗаказа.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаряд)))
	| И НЕ ДокументЗаказа.ПометкаУдаления
	| И ДокументЗаказа.ВариантЗавершения <> ЗНАЧЕНИЕ(Перечисление.ВариантыЗавершенияЗаказа.Отменен)
	| И ((ДокументЗаказа.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаряд)
	| 	И ДокументЗаказа.СостояниеЗаказа = ЗНАЧЕНИЕ(Справочник.СостоянияЗаказНарядов.Завершен))
	| 	ИЛИ (ДокументЗаказа.ВидОперации <> ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаряд)
	| 	И ДокументЗаказа.СостояниеЗаказа = ЗНАЧЕНИЕ(Справочник.СостоянияЗаказовПокупателей.Завершен)))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	| ДокументЗаказа.Дата КАК Дата,
	| СтрокиЗаказовПродавца.ЗаказПокупателя КАК Заказ,
	| СтрокиЗаказовПродавца.Номенклатура КАК Номенклатура,
	| СтрокиЗаказовПродавца.Характеристика КАК Характеристика,
	| ВЫБОР
	| 	КОГДА СтрокиЗаказовПродавца.КоличествоЗаказа = 0 ТОГДА 0
	| 	ИНАЧЕ СтрокиЗаказовПродавца.СуммаЗаказа / СтрокиЗаказовПродавца.КоличествоЗаказа
	| КОНЕЦ КАК Цена,
	| СтрокиЗаказовПродавца.КоличествоЗаказа КАК Количество,
	| СтрокиЗаказовПродавца.СуммаЗаказа КАК Сумма,
	| 0 КАК Себестоимость,
	| ИСТИНА КАК НеподтвержденнаяПродажа,
	| ЛОЖЬ КАК ОтмененЗаказ
	|ИЗ
	| СтрокиЗаказовПродавца КАК СтрокиЗаказовПродавца
	| 	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя КАК ДокументЗаказа
	| 	ПО СтрокиЗаказовПродавца.ЗаказПокупателя = ДокументЗаказа.Ссылка
	| 	ЛЕВОЕ СОЕДИНЕНИЕ ОплаченныеЗаказы КАК ОплаченныеЗаказы
	| 	ПО СтрокиЗаказовПродавца.ЗаказПокупателя = ОплаченныеЗаказы.ЗаказПокупателя
	| 	ЛЕВОЕ СОЕДИНЕНИЕ ПодтвержденныеСтрокиЗаказов КАК ПодтвержденныеСтрокиЗаказов
	| 	ПО СтрокиЗаказовПродавца.ЗаказПокупателя = ПодтвержденныеСтрокиЗаказов.ЗаказПокупателя
	| 		И СтрокиЗаказовПродавца.Номенклатура = ПодтвержденныеСтрокиЗаказов.Номенклатура
	| 		И СтрокиЗаказовПродавца.Характеристика = ПодтвержденныеСтрокиЗаказов.Характеристика
	|ГДЕ
	| &ПоказыватьНеподтвержденныеПродажи
	| И НЕ ДокументЗаказа.ПометкаУдаления
	| И ДокументЗаказа.ВариантЗавершения <> ЗНАЧЕНИЕ(Перечисление.ВариантыЗавершенияЗаказа.Отменен)
	| И ДокументЗаказа.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	| И ((ДокументЗаказа.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаряд)
	| 	И (ОплаченныеЗаказы.ЗаказПокупателя ЕСТЬ NULL
	| 		ИЛИ ДокументЗаказа.СостояниеЗаказа <> ЗНАЧЕНИЕ(Справочник.СостоянияЗаказНарядов.Завершен)
	| 		ИЛИ ЕСТЬNULL(ПодтвержденныеСтрокиЗаказов.ЕстьДвижениеЗаказНаряда, 0) = 0))
	| 	ИЛИ (ДокументЗаказа.ВидОперации <> ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаряд)
	| 	И (ОплаченныеЗаказы.ЗаказПокупателя ЕСТЬ NULL
	| 		ИЛИ ДокументЗаказа.СостояниеЗаказа <> ЗНАЧЕНИЕ(Справочник.СостоянияЗаказовПокупателей.Завершен)
	| 		ИЛИ ЕСТЬNULL(ПодтвержденныеСтрокиЗаказов.ЕстьРасходнаяНакладная, 0) = 0)))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|ПродажиОбороты.Период КАК Дата,
	|ПродажиОбороты.ЗаказПокупателя КАК Заказ,
	|ПродажиОбороты.Номенклатура КАК Номенклатура,
	|ПродажиОбороты.Характеристика КАК Характеристика,
	|ВЫБОР
	|	КОГДА ПродажиОбороты.КоличествоОборот = 0 ТОГДА 0
	|	ИНАЧЕ ПродажиОбороты.СуммаОборот / ПродажиОбороты.КоличествоОборот
	|КОНЕЦ КАК Цена,
	|-ПродажиОбороты.КоличествоОборот КАК Количество,
	|-ПродажиОбороты.СуммаОборот КАК Сумма,
	|0 КАК Себестоимость,
	|ЛОЖЬ КАК НеподтвержденнаяПродажа,
	|ИСТИНА КАК ОтмененЗаказ
	|ИЗ
	|РегистрНакопления.Продажи.Обороты(&НачалоПериода, &КонецПериода, Регистратор, ) КАК ПродажиОбороты
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПриходнаяНакладная КАК ПриходнаяНакладная
	|	ПО ПродажиОбороты.Регистратор = ПриходнаяНакладная.Ссылка
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ СтрокиЗаказовПродавца КАК СтрокиЗаказовПродавца
	|	ПО ПродажиОбороты.ЗаказПокупателя = СтрокиЗаказовПродавца.ЗаказПокупателя
	|		И ПродажиОбороты.Номенклатура = СтрокиЗаказовПродавца.Номенклатура
	|		И ПродажиОбороты.Характеристика = СтрокиЗаказовПродавца.Характеристика
	|ГДЕ
	| &ПоказыватьОтмененныеЗаказы
	|И ПриходнаяНакладная.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПриходнаяНакладная.ВозвратОтПокупателя)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|ДокументЗаказа.Дата КАК Дата,
	|ОтмененныеСтрокиЗаказовПродавца.ЗаказПокупателя КАК Заказ,
	|ОтмененныеСтрокиЗаказовПродавца.Номенклатура КАК Номенклатура,
	|ОтмененныеСтрокиЗаказовПродавца.Характеристика КАК Характеристика,
	|ВЫБОР
	|	КОГДА ОтмененныеСтрокиЗаказовПродавца.КоличествоЗаказа = 0 ТОГДА 0
	|	ИНАЧЕ ОтмененныеСтрокиЗаказовПродавца.СуммаЗаказа / ОтмененныеСтрокиЗаказовПродавца.КоличествоЗаказа
	|КОНЕЦ КАК Цена,
	|ОтмененныеСтрокиЗаказовПродавца.КоличествоЗаказа КАК Количество,
	|ОтмененныеСтрокиЗаказовПродавца.СуммаЗаказа КАК Сумма,
	|0 КАК Себестоимость,
	|ЛОЖЬ КАК НеподтвержденнаяПродажа,
	|ИСТИНА КАК ОтмененЗаказ
	|ИЗ
	|ОтмененныеСтрокиЗаказовПродавца КАК ОтмененныеСтрокиЗаказовПродавца
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя КАК ДокументЗаказа
	|	ПО ОтмененныеСтрокиЗаказовПродавца.ЗаказПокупателя = ДокументЗаказа.Ссылка
	|ГДЕ
	|&ПоказыватьОтмененныеЗаказы
	|И НЕ ДокументЗаказа.ПометкаУдаления
	|И ДокументЗаказа.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	| ДокументЗаказа.Дата,
	| СтрокиЗаказовПродавца.ЗаказПокупателя,
	| СтрокиЗаказовПродавца.Номенклатура,
	| СтрокиЗаказовПродавца.Характеристика,
	| ВЫБОР
	| 	КОГДА СтрокиЗаказовПродавца.КоличествоЗаказа = 0 ТОГДА 0
	| 	ИНАЧЕ СтрокиЗаказовПродавца.СуммаЗаказа / СтрокиЗаказовПродавца.КоличествоЗаказа
	| КОНЕЦ,
	| СтрокиЗаказовПродавца.КоличествоЗаказа,
	| СтрокиЗаказовПродавца.СуммаЗаказа,
	| 0,
	| ЛОЖЬ,
	| ИСТИНА
	|ИЗ
	| СтрокиЗаказовПродавца КАК СтрокиЗаказовПродавца
	| 	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя КАК ДокументЗаказа
	| 	ПО СтрокиЗаказовПродавца.ЗаказПокупателя = ДокументЗаказа.Ссылка
	|ГДЕ
	| &ПоказыватьОтмененныеЗаказы
	| И НЕ ДокументЗаказа.ПометкаУдаления
	| И ДокументЗаказа.ВариантЗавершения = ЗНАЧЕНИЕ(Перечисление.ВариантыЗавершенияЗаказа.Отменен)
	| И ДокументЗаказа.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|
	|УПОРЯДОЧИТЬ ПО
	| Дата УБЫВ,
	| Заказ,
	| Номенклатура";

КонецФункции

&НаКлиенте
Процедура АС_ПродажиВыбор(Элемент, ВыбраннаяСтрока, Колонка, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Если Элемент.ТекущиеДанные = Неопределено Или Колонка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если СтрЗаканчиваетсяНа(Колонка.Имя, "ВидЗаказа") Тогда
		Если ЗначениеЗаполнено(Элемент.ТекущиеДанные.ВидЗаказа) Тогда
			ОткрытьФорму("Документ.ЗаказПокупателя.ФормаОбъекта",
				Новый Структура("Ключ", Элемент.ТекущиеДанные.ВидЗаказа));
		КонецЕсли;
	ИначеЕсли СтрЗаканчиваетсяНа(Колонка.Имя, "Номенклатура") Тогда
		Если ЗначениеЗаполнено(Элемент.ТекущиеДанные.Номенклатура) Тогда
			ОткрытьФорму("Справочник.Номенклатура.ФормаОбъекта",
				Новый Структура("Ключ", Элемент.ТекущиеДанные.Номенклатура));
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры
