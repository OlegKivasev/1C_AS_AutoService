&НаСервере
Процедура АС_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если НЕ Параметры.Свойство("Сотрудник")
		Или НЕ ЗначениеЗаполнено(Параметры.Сотрудник) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	СотрудникФормы = Параметры.Сотрудник;
	НачалоПериода = НачалоМесяца(ТекущаяДата());
	КонецПериода = КонецМесяца(ТекущаяДата());
	СортировкаПоВозрастанию = Ложь;
	ОтчетСформирован = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура АС_СортироватьПоДатеПоВозрастанию(Команда)

	СортировкаПоВозрастанию = Истина;
	АС_ПересортироватьПродажиНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура АС_СортироватьПоДатеПоУбыванию(Команда)

	СортировкаПоВозрастанию = Ложь;
	АС_ПересортироватьПродажиНаСервере();

КонецПроцедуры

&НаСервере
Процедура АС_ПересортироватьПродажиНаСервере()

	Если НЕ ОтчетСформирован Тогда
		Возврат;
	КонецЕсли;

	АС_ЗаполнитьДеревоПродаж();

КонецПроцедуры

&НаКлиенте
Процедура АС_ОбновитьПродажи(Команда)

	АС_ОбновитьДанныеНаСервере();
	Элементы.АС_Итоги.Видимость = Истина;
	Элементы.АС_Продажи.Видимость = Истина;

КонецПроцедуры

&НаСервере
Процедура АС_ОбновитьДанныеНаСервере()

	НачалоПериода = НачалоДня(НачалоПериода);
	КонецПериода = КонецДня(КонецПериода);
	АС_ЗаполнитьДеревоПродаж();
	ОтчетСформирован = Истина;

	Запрос = Новый Запрос(АС_ТекстЗапросаИтогов());
	Запрос.УстановитьПараметр("Сотрудник", СотрудникФормы);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		КоличествоПродаж = Выборка.КоличествоПродаж;
		СуммаПродаж = Выборка.СуммаПродаж;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура АС_ЗаполнитьДеревоПродаж()

	ДеревоПродаж = РеквизитФормыВЗначение("АС_Продажи");
	ДеревоПродаж.Строки.Очистить();

	Запрос = Новый Запрос(АС_ТекстЗапросаПродаж(СортировкаПоВозрастанию));
	Запрос.УстановитьПараметр("Сотрудник", СотрудникФормы);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Выборка = Запрос.Выполнить().Выбрать();

	ТекущийЗаказ = Неопределено;
	СтрокаЗаказа = Неопределено;
	Пока Выборка.Следующий() Цикл
		Если ТекущийЗаказ = Неопределено Или ТекущийЗаказ <> Выборка.Заказ Тогда
			ТекущийЗаказ = Выборка.Заказ;
			СтрокаЗаказа = ДеревоПродаж.Строки.Добавить();
			СтрокаЗаказа.Дата = Выборка.Дата;
			СтрокаЗаказа.ВидЗаказа = Выборка.Заказ;
		КонецЕсли;

		СтрокаТовара = СтрокаЗаказа.Строки.Добавить();
		СтрокаТовара.Дата = Выборка.Дата;
		СтрокаТовара.ВидЗаказа = Выборка.Заказ;
		СтрокаТовара.Номенклатура = Выборка.Номенклатура;
		СтрокаТовара.Цена = Выборка.Цена;
		СтрокаТовара.Количество = Выборка.Количество;
		СтрокаТовара.Сумма = Выборка.Сумма;
	КонецЦикла;

	ЗначениеВРеквизитФормы(ДеревоПродаж, "АС_Продажи");

КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_ТекстЗапросаПродаж(СортировкаПоВозрастанию)

	Если СортировкаПоВозрастанию Тогда
		НаправлениеСортировки = "ВОЗР";
	Иначе
		НаправлениеСортировки = "УБЫВ";
	КонецЕсли;

	Возврат "ВЫБРАТЬ
	| Заказ.Дата КАК Дата,
	| Заказ.Ссылка КАК Заказ,
	| СтрокиТоваров.Номенклатура КАК Номенклатура,
	| СтрокиТоваров.Цена КАК Цена,
	| СтрокиТоваров.Количество КАК Количество,
	| СтрокиТоваров.Сумма КАК Сумма
	|ИЗ
	| Документ.ЗаказПокупателя.Запасы КАК СтрокиТоваров
	|  ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя КАК Заказ
	|  ПО СтрокиТоваров.Ссылка = Заказ.Ссылка
	|ГДЕ
	| НЕ Заказ.ПометкаУдаления
	| И СтрокиТоваров.АС_Продавец = &Сотрудник
	| И Заказ.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|УПОРЯДОЧИТЬ ПО
	| Заказ.Дата " + НаправлениеСортировки + ",
	| Заказ, Номенклатура";

КонецФункции

&НаСервереБезКонтекста
Функция АС_ТекстЗапросаИтогов()

	Возврат "ВЫБРАТЬ
	| ЕСТЬNULL(СУММА(СтрокиТоваров.Количество), 0) КАК КоличествоПродаж,
	| ЕСТЬNULL(СУММА(СтрокиТоваров.Сумма), 0) КАК СуммаПродаж
	|ИЗ
	| Документ.ЗаказПокупателя.Запасы КАК СтрокиТоваров
	|  ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя КАК Заказ
	|  ПО СтрокиТоваров.Ссылка = Заказ.Ссылка
	|ГДЕ
	| НЕ Заказ.ПометкаУдаления
	| И СтрокиТоваров.АС_Продавец = &Сотрудник
	| И Заказ.Дата МЕЖДУ &НачалоПериода И &КонецПериода";

КонецФункции

&НаКлиенте
Процедура АС_ПродажиВыбор(Элемент, ВыбраннаяСтрока, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Если Элемент.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Документ = Элемент.ТекущиеДанные.ВидЗаказа;

	Если ЗначениеЗаполнено(Документ) Тогда
		ОткрытьЗначение(Документ);
	КонецЕсли;

КонецПроцедуры
