&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Настройки = АС_АгрегаторСервер.НастройкиДляФормы();
	Реквизиты = Новый Массив;
	Для Каждого Имя Из СтрРазделить("Штрихкод,Результат,ОтветJSON,Подсказка,СостояниеРежима,ПодсказкаРежима", ",") Цикл
		Реквизиты.Добавить(Новый РеквизитФормы(Имя, Новый ОписаниеТипов("Строка")));
	КонецЦикла;
	Реквизиты.Добавить(Новый РеквизитФормы("ТестоваяПлатформа", Новый ОписаниеТипов("Булево")));
	Реквизиты.Добавить(Новый РеквизитФормы("ЗаказНаряд", Новый ОписаниеТипов("ДокументСсылка.ЗаказПокупателя")));
	Для Каждого Имя Из СтрРазделить("ЗакупочныйВидЦен,РозничныйВидЦен,БезналичныйВидЦен", ",") Цикл
		Реквизиты.Добавить(Новый РеквизитФормы(Имя, Новый ОписаниеТипов("СправочникСсылка.ВидыЦен")));
	КонецЦикла;
	ИзменитьРеквизиты(Реквизиты);
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Настройки, "ТестоваяПлатформа,ЗакупочныйВидЦен,РозничныйВидЦен,БезналичныйВидЦен");
	ЭтотОбъект.Подсказка = "Проверки используют сохранённое подключение. Тестовые виды цен и карточки не меняют рабочие настройки и ничего не отправляют на сайт. Ключи и секреты в JSON не выводятся.";
	Группа = АС_Группа("Информация", "Для разработчиков");
	АС_Поле("Подсказка", "", ВидПоляФормы.ПолеНадписи, Группа);
	АС_Кнопка("ОбновитьДиагностику", "Состояние сервера и очереди — JSON", Группа);
	Группа = АС_Группа("Номенклатура", "Номенклатура");
	АС_Кнопка("ПроверитьПодключениеНоменклатуры", "Проверить ключ и HTTPS — JSON", Группа);
	АС_Поле("Штрихкод", "Штрихкод", ВидПоляФормы.ПолеВвода, Группа);
	АС_Поле("ЗакупочныйВидЦен", "Тестовый закупочный вид цен", ВидПоляФормы.ПолеВвода, Группа);
	АС_Поле("РозничныйВидЦен", "Тестовый розничный вид цен", ВидПоляФормы.ПолеВвода, Группа);
	АС_Поле("БезналичныйВидЦен", "Тестовый безналичный вид цен", ВидПоляФормы.ПолеВвода, Группа);
	АС_Кнопка("ПроверитьКарточкуНоменклатуры", "Прочитать карточку — JSON", Группа);
	Группа = АС_Группа("ЗаказНаряды", "Заказ-наряды");
	АС_ОбновитьСостояниеРежима(Настройки);
	ЭтотОбъект.ПодсказкаРежима = "Смена режима отключает обмен. После применения закройте эту форму, включите обмен и сохраните настройки в основной форме.";
	АС_Поле("СостояниеРежима", "Сохранённый режим", ВидПоляФормы.ПолеНадписи, Группа);
	АС_Поле("ПодсказкаРежима", "", ВидПоляФормы.ПолеНадписи, Группа);
	АС_Поле("ТестоваяПлатформа", "Тестовый режим заказ-нарядов", ВидПоляФормы.ПолеФлажка, Группа);
	АС_Кнопка("ПрименитьРежим", "Применить режим заказ-нарядов", Группа);
	АС_Поле("ЗаказНаряд", "Заказ-наряд для проверки", ВидПоляФормы.ПолеВвода, Группа);
	АС_Кнопка("ПроверитьЗаказНаряд", "Прочитать заказ-наряд — JSON", Группа);
	АС_Кнопка("ПроверитьПодключение", "Проверить подключение заказ-нарядов", Группа);
	АС_Кнопка("ПроверитьДанные", "Повторно выгрузить заказ-наряды выбранного режима", Группа);
	АС_Кнопка("УдалитьКарточки", "Удалить карточки выбранного режима", Группа);
	Группа = АС_Группа("Результаты", "Результат проверки");
	АС_Поле("Результат", "Состояние и этап", ВидПоляФормы.ПолеВвода, Группа, 3);
	АС_Поле("ОтветJSON", "JSON", ВидПоляФормы.ПолеВвода, Группа, 12);
	ЭтотОбъект.Результат = "Выберите проверку. Состояние сервера обновляется по кнопке; открытая форма для работы поиска не нужна.";
КонецПроцедуры

&НаСервере
Функция АС_Группа(Имя, Заголовок)
	Группа = Элементы.Добавить(Имя, Тип("ГруппаФормы"));
	Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	Группа.Заголовок = Заголовок;
	Возврат Группа;
КонецФункции

&НаСервере
Процедура АС_Поле(Имя, Заголовок, Вид, Родитель, Высота = 0)
	Поле = Элементы.Добавить(Имя, Тип("ПолеФормы"), Родитель);
	Поле.Вид = Вид;
	Поле.ПутьКДанным = Имя;
	Поле.Заголовок = Заголовок;
	Если Высота > 0 Тогда
		Поле.ТолькоПросмотр = Истина;
		Поле.МногострочныйРежим = Истина;
		Поле.Высота = Высота;
		Поле.РастягиватьПоГоризонтали = Истина;
		Поле.РастягиватьПоВертикали = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура АС_Кнопка(Имя, Заголовок, Родитель)
	Команда = Команды.Добавить(Имя);
	Команда.Заголовок = Заголовок;
	Команда.Действие = Имя;
	Кнопка = Элементы.Добавить(Имя, Тип("КнопкаФормы"), Родитель);
	Кнопка.ИмяКоманды = Имя;
	Кнопка.Заголовок = Заголовок;
КонецПроцедуры

&НаСервере
Процедура АС_ПоказатьРезультат(Данные, Текст)
	ЭтотОбъект.ОтветJSON = АС_АгрегаторСервер.JSONДляРазработчика(Данные);
	ЭтотОбъект.Результат = Текст;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДиагностику(Команда)
	АС_ВыполнитьПроверку("Состояние");
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПодключениеНоменклатуры(Команда)
	АС_ВыполнитьПроверку("Ключ");
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьКарточкуНоменклатуры(Команда)
	АС_ВыполнитьПроверку("Номенклатура");
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗаказНаряд(Команда)
	АС_ВыполнитьПроверку("ЗаказНаряд");
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПодключение(Команда)
	АС_ВыполнитьПроверку("Подключение");
КонецПроцедуры

&НаСервере
Процедура АС_ВыполнитьПроверку(Вид)
	// Проверка выполняется до перехвата ошибок и любых операций с данными.
	Настройки = АС_АгрегаторСервер.НастройкиДляФормы();
	ЭтотОбъект.ОтветJSON = "";
	Попытка
		Если Вид = "Состояние" Тогда
			АС_ПоказатьРезультат(АС_АгрегаторСервер.ДиагностикаАгрегатора(), "Снимок серверного задания и очереди. enabled не подтверждает запуск: проверьте recentRuns и связь на сайте.");
		ИначеЕсли Вид = "Ключ" Тогда
			АС_ПоказатьРезультат(АС_АгрегаторСервер.ПроверитьПодключениеНоменклатуры(), "Ключ принят. Проверка HTTPS не подтверждает запуск серверного задания и чтение карточки.");
		ИначеЕсли Вид = "Номенклатура" Тогда
			ВидыЦен = Новый Структура("ЗакупочныйВидЦен,РозничныйВидЦен,БезналичныйВидЦен",
				ЭтотОбъект.ЗакупочныйВидЦен, ЭтотОбъект.РозничныйВидЦен, ЭтотОбъект.БезналичныйВидЦен);
			Ответ = АС_АгрегаторСервер.ПроверитьКарточкуНоменклатуры(ЭтотОбъект.Штрихкод, ВидыЦен);
			АС_ПоказатьРезультат(Ответ, Ответ.stage + Символы.ПС + Ответ.message);
		ИначеЕсли Вид = "ЗаказНаряд" Тогда
			Ответ = АС_АгрегаторСервер.ПроверитьКарточкуЗаказНаряда(ЭтотОбъект.ЗаказНаряд, ЭтотОбъект.ТестоваяПлатформа);
			АС_ПоказатьРезультат(Ответ, "Локальная проверка заказ-наряда. На сайт ничего не отправлено. " + Ответ.message);
		ИначеЕсли Вид = "Подключение" Тогда
			АС_ПроверитьСохраненныйРежим();
			Текст = АС_АгрегаторСервер.ПроверитьПодключение();
			АС_ПоказатьРезультат(Новый Структура("message", Текст), Текст);
		КонецЕсли;
	Исключение
		Текст = Лев(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), 3000);
		АС_ПоказатьРезультат(Новый Структура("ok,message", Ложь, Текст), Текст);
	КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура АС_ПроверитьСохраненныйРежим()
	Настройки = АС_АгрегаторСервер.НастройкиДляФормы();
	Если Настройки.НужноПодтвердитьБазу Или ЭтотОбъект.ТестоваяПлатформа <> Настройки.ТестоваяПлатформа Тогда
		ВызватьИсключение "Сначала сохраните настройки базы и примените выбранный режим заказ-нарядов.";
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура АС_ОбновитьСостояниеРежима(Настройки)
	ЭтотОбъект.СостояниеРежима = ?(Настройки.ТестоваяПлатформа, "Тестовый", "Рабочий")
		+ ?(Настройки.Включен, ". Обмен включён.", ". Обмен отключён.");
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьРежим(Команда)
	ПрименитьРежимНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПрименитьРежимНаСервере()
	// Контекстный вызов передаёт текущее значение флажка с клиента на сервер формы.
	НовыйРежим = ЭтотОбъект.ТестоваяПлатформа;
	ЭтотОбъект.ОтветJSON = "";
	Попытка
		Настройки = АС_АгрегаторСервер.СохранитьРежимОбменаДляРазработчика(НовыйРежим);
		Если Настройки.ТестоваяПлатформа <> НовыйРежим Тогда
			ВызватьИсключение "Сохранённый режим не совпадает с выбранным. Выгрузку не запускайте.";
		КонецЕсли;
		ЭтотОбъект.ТестоваяПлатформа = Настройки.ТестоваяПлатформа;
		АС_ОбновитьСостояниеРежима(Настройки);
		Текст = "Сохранён режим «" + ?(Настройки.ТестоваяПлатформа, "Тестовый", "Рабочий") + "». "
			+ ?(Настройки.Включен, "Обмен уже работает в этом режиме.",
			"Обмен отключён. Закройте эту форму, включите обмен и сохраните настройки в основной форме.")
			+ " На номенклатуру этот режим не влияет.";
		АС_ПоказатьРезультат(Новый Структура("testPlatform,enabled", Настройки.ТестоваяПлатформа, Настройки.Включен), Текст);
	Исключение
		Текст = Лев(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), 3000);
		ЭтотОбъект.СостояниеРежима = "Не удалось подтвердить выбранный режим. " + Текст;
		АС_ПоказатьРезультат(Новый Структура("ok,message", Ложь, Текст), Текст);
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьДанные(Команда)
	ПоказатьВопрос(Новый ОписаниеОповещения("ПодтвердитьВыгрузку", ЭтотОбъект),
		"Повторно выгрузить заказ-наряды в режиме «" + ?(ЭтотОбъект.ТестоваяПлатформа, "Тестовый", "Рабочий") + "»? Эта команда отправит реальные данные на сайт.", РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Нет);
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьВыгрузку(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда ПовторитьВыгрузкуНаСервере(); КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПовторитьВыгрузкуНаСервере()
	АС_ПроверитьСохраненныйРежим();
	Начата = АС_АгрегаторСервер.НачатьПервичнуюВыгрузку(Истина, ЭтотОбъект.ТестоваяПлатформа);
	АС_ПоказатьРезультат(Новый Структура("started", Начата), ?(Начата,
		"Повторная выгрузка запущена. Ход и ошибки доступны по кнопке состояния.", "Предыдущая отправка ещё выполняется. Повторите позже."));
КонецПроцедуры

&НаКлиенте
Процедура УдалитьКарточки(Команда)
	Режим = ?(ЭтотОбъект.ТестоваяПлатформа, "ТЕСТОВОГО", "РАБОЧЕГО");
	ПоказатьВопрос(Новый ОписаниеОповещения("ПодтвердитьУдаление", ЭтотОбъект),
		"Удалить ВСЕ карточки " + Режим + " режима из агрегатора и его очередь в этой базе 1С? Документы 1С сохранятся. Обмен должен быть отключён.",
		РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Нет);
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьУдаление(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда УдалитьНаСервере(); КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УдалитьНаСервере()
	АС_ПроверитьСохраненныйРежим();
	Количество = АС_АгрегаторСервер.УдалитьКарточки();
	АС_ПоказатьРезультат(Новый Структура("deleted", Количество), "Удалено карточек выбранного режима: " + Количество);
КонецПроцедуры
