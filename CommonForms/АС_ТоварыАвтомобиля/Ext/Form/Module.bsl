&НаСервере
Процедура АС_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЭтоОткрытиеИзДоговора = Ложь;

	Если Параметры.Свойство("Договор")
		И ЗначениеЗаполнено(Параметры.Договор) Тогда

		ДоговорФормы = Параметры.Договор;
		ЭтоОткрытиеИзДоговора = Истина;
		АС_ТоварыАвтомобиля.ТекстЗапроса = АС_ТекстЗапросаИстории(Ложь, Истина);
		АС_РаботыСписок.ТекстЗапроса = АС_ТекстЗапросаИстории(Истина, Истина);
		АС_ТоварыАвтомобиля.Параметры.УстановитьЗначениеПараметра("Договор", ДоговорФормы);
		АС_РаботыСписок.Параметры.УстановитьЗначениеПараметра("Договор", ДоговорФормы);
		Элементы.АС_СтраницаТовары.Заголовок = "Товары (" + АС_КоличествоСтрокЗаказНаряда(ДоговорФормы, Ложь) + ")";
		Элементы.АС_СтраницаРаботы.Заголовок = "Работы (" + АС_КоличествоСтрокЗаказНаряда(ДоговорФормы, Истина) + ")";

	ИначеЕсли Параметры.Свойство("Контрагент")
		И ЗначениеЗаполнено(Параметры.Контрагент) Тогда

		КонтрагентФормы = Параметры.Контрагент;
		ЭтоОткрытиеИзДоговора = Ложь;
		АС_ТоварыАвтомобиля.ТекстЗапроса = АС_ТекстЗапросаКонтрагента(Ложь);
		АС_РаботыСписок.ТекстЗапроса = АС_ТекстЗапросаКонтрагента(Истина);
		АС_ТоварыАвтомобиля.Параметры.УстановитьЗначениеПараметра("Контрагент", Параметры.Контрагент);
		АС_РаботыСписок.Параметры.УстановитьЗначениеПараметра("Контрагент", Параметры.Контрагент);
		Элементы.АС_СтраницаТовары.Заголовок = "Товары (" + АС_КоличествоСтрокКонтрагента(Параметры.Контрагент, Ложь) + ")";
		Элементы.АС_СтраницаРаботы.Заголовок = "Работы (" + АС_КоличествоСтрокКонтрагента(Параметры.Контрагент, Истина) + ")";
	КонецЕсли;

	АС_НастроитьПоискИстории();
	АС_НастроитьКолонкиИстории();
	АС_УстановитьОформлениеВременныхТоваров();

КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_КоличествоСтрокЗаказНаряда(Договор, ЭтоРаботы)

	Возврат АС_КоличествоСтрокИстории(Договор, Истина, ЭтоРаботы);

КонецФункции

&НаСервереБезКонтекста
Функция АС_ТекстЗапросаКонтрагента(ЭтоРаботы)

	Возврат АС_ТекстЗапросаИстории(ЭтоРаботы, Ложь);

КонецФункции

&НаСервереБезКонтекста
Функция АС_КоличествоСтрокКонтрагента(Контрагент, ЭтоРаботы)

	Возврат АС_КоличествоСтрокИстории(Контрагент, Ложь, ЭтоРаботы);

КонецФункции

&НаСервере
Процедура АС_НастроитьКолонкиИстории()

	Элементы.АС_ТоварыАвтомобиляДатаЗаказНаряда.Заголовок = "Дата документа";
	Элементы.АС_РаботыСписокДатаЗаказНаряда.Заголовок = "Дата документа";
	Для Каждого ИмяСписка Из СтрРазделить("АС_ТоварыАвтомобиля,АС_РаботыСписок", ",") Цикл
		ИмяКолонки = ИмяСписка + "Документ";
		Если Элементы.Найти(ИмяКолонки) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Колонка = Элементы.Добавить(ИмяКолонки, Тип("ПолеФормы"), Элементы.Найти(ИмяСписка));
		Колонка.Вид = ВидПоляФормы.ПолеНадписи;
		Колонка.ПутьКДанным = ИмяСписка + ".ЗаказПокупателя";
		Колонка.Заголовок = "Документ";
		Колонка.Гиперссылка = Истина;
		Колонка.ГиперссылкаЯчейки = Истина;
		Колонка.Ширина = 30;
		КолонкаДоговора = Элементы.Добавить(ИмяСписка + "Договор", Тип("ПолеФормы"), Элементы.Найти(ИмяСписка));
		КолонкаДоговора.Вид = ВидПоляФормы.ПолеНадписи;
		КолонкаДоговора.ПутьКДанным = ИмяСписка + ".Договор";
		КолонкаДоговора.Заголовок = "Договор";
		КолонкаДоговора.Ширина = 30;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура АС_УстановитьОформлениеВременныхТоваров()

	Для Каждого ИмяСписка Из СтрРазделить("АС_ТоварыАвтомобиля,АС_РаботыСписок", ",") Цикл
		Оформление = УсловноеОформление.Элементы.Добавить();
		РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
			Оформление.Отбор, ИмяСписка + ".ЭтоВременныйТовар", Истина);
		Для Каждого Колонка Из Элементы.Найти(ИмяСписка).ПодчиненныеЭлементы Цикл
			Если ТипЗнч(Колонка) = Тип("ПолеФормы") Тогда
				РаботаСФормой.ДобавитьОформляемоеПоле(Оформление, Колонка.Имя);
			КонецЕсли;
		КонецЦикла;
		РаботаСФормой.ДобавитьЭлементУсловногоОформления(
			Оформление, "ЦветФона", Новый Цвет(237, 230, 255));
		РаботаСФормой.ДобавитьЭлементУсловногоОформления(
			Оформление, "ЦветТекста", Новый Цвет(76, 45, 120));
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_ТекстЗапросаИстории(ЭтоРаботы, ПоДоговору,
	УсловиеПоискаЗаказа = "", УсловиеПоискаЧека = "")

	ТабличнаяЧастьЗаказа = ?(ЭтоРаботы, "Работы", "Запасы");
	Если ПоДоговору Тогда
		УсловиеЗаказа = "Заказ.Договор = &Договор";
		УсловиеЧека = "Чек.Договор = &Договор";
		УсловиеСвязанногоЗаказа = "УчтенныеСтрокиЗаказа.Ссылка.Договор = &Договор";
	Иначе
		УсловиеЗаказа = "(Заказ.Контрагент = &Контрагент ИЛИ ДоговорКонтрагента.Владелец = &Контрагент)";
		УсловиеЧека = "(Чек.Контрагент = &Контрагент ИЛИ Чек.Договор.Владелец = &Контрагент)";
		УсловиеСвязанногоЗаказа = "(УчтенныеСтрокиЗаказа.Ссылка.Контрагент = &Контрагент ИЛИ УчтенныеСтрокиЗаказа.Ссылка.Договор.Владелец = &Контрагент)";
	КонецЕсли;
	Если ЭтоРаботы Тогда
		УсловиеТипаЧека = "СтрокиЧека.Номенклатура.ТипНоменклатуры В (ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга), ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа))";
	Иначе
		УсловиеТипаЧека = "СтрокиЧека.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)";
	КонецЕсли;

	// Имя поля ссылки сохраняем: оно входит в составной ключ динамических списков.
	Возврат "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	| Заказ.Дата КАК ДатаЗаказНаряда,
	| СтрокиЗаказа.Номенклатура КАК Номенклатура,
	| Заказ.Ссылка КАК ЗаказПокупателя,
	| СтрокиЗаказа.НомерСтроки КАК НомерСтроки,
	| ВЫБОР КОГДА Заказ.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ВидыКонтрагентов.ЮридическоеЛицо)
	|  ТОГДА Заказ.Договор
	|  ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка) КОНЕЦ КАК Договор,
	| Заказ.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаряд) КАК ЭтоЗаказНаряд,
	| ТИПЗНАЧЕНИЯ(СтрокиЗаказа.Номенклатура) = ТИП(Строка) КАК ЭтоВременныйТовар
	|ИЗ
	| Документ.ЗаказПокупателя." + ТабличнаяЧастьЗаказа + " КАК СтрокиЗаказа
	|  ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя КАК Заказ
	|  ПО СтрокиЗаказа.Ссылка = Заказ.Ссылка
	|  ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорКонтрагента
	|  ПО Заказ.Договор = ДоговорКонтрагента.Ссылка
	|ГДЕ
	| НЕ Заказ.ПометкаУдаления
	| И " + УсловиеЗаказа + ?(ПустаяСтрока(УсловиеПоискаЗаказа), "", " И (" + УсловиеПоискаЗаказа + ")") + "
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	| Чек.Дата,
	| СтрокиЧека.Номенклатура,
	| Чек.Ссылка,
	| СтрокиЧека.НомерСтроки,
	| ВЫБОР КОГДА Чек.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ВидыКонтрагентов.ЮридическоеЛицо)
	|  ТОГДА Чек.Договор
	|  ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка) КОНЕЦ,
	| ЛОЖЬ,
	| ТИПЗНАЧЕНИЯ(СтрокиЧека.Номенклатура) = ТИП(Строка)
	|ИЗ
	| Документ.ЧекККМ.Запасы КАК СтрокиЧека
	|  ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЧекККМ КАК Чек
	|  ПО СтрокиЧека.Ссылка = Чек.Ссылка
	|  ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя." + ТабличнаяЧастьЗаказа + " КАК УчтенныеСтрокиЗаказа
	|  ПО СтрокиЧека.Заказ = УчтенныеСтрокиЗаказа.Ссылка
	|   И СтрокиЧека.Номенклатура = УчтенныеСтрокиЗаказа.Номенклатура
	|   И НЕ УчтенныеСтрокиЗаказа.Ссылка.ПометкаУдаления
	|   И " + УсловиеСвязанногоЗаказа + "
	|ГДЕ
	| Чек.Проведен
	| И НЕ Чек.ПометкаУдаления
	| И Чек.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЧековККМ.Пробит)
	| И НЕ Чек.ОперацияСДенежнымиСредствами
	| И " + УсловиеЧека + "
	| И " + УсловиеТипаЧека + "
	| И УчтенныеСтрокиЗаказа.Ссылка ЕСТЬ NULL"
		+ ?(ПустаяСтрока(УсловиеПоискаЧека), "", " И (" + УсловиеПоискаЧека + ")");

КонецФункции

&НаСервереБезКонтекста
Функция АС_КоличествоСтрокИстории(ЗначениеОтбора, ПоДоговору, ЭтоРаботы)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр(?(ПоДоговору, "Договор", "Контрагент"), ЗначениеОтбора);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ КОЛИЧЕСТВО(*) КАК Количество ИЗ ("
		+ СтрЗаменить(АС_ТекстЗапросаИстории(ЭтоРаботы, ПоДоговору),
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ", "ВЫБРАТЬ") + ") КАК История";
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Количество;

КонецФункции

&НаКлиенте
Процедура АС_РаботыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	АС_ОткрытьДокументИстории(Элемент, СтандартнаяОбработка);

КонецПроцедуры

&НаКлиенте
Процедура АС_ТоварыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	АС_ОткрытьДокументИстории(Элемент, СтандартнаяОбработка);

КонецПроцедуры

&НаКлиенте
Процедура АС_ОткрытьДокументИстории(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ДокументИстории = ТекущиеДанные.ЗаказПокупателя;
	Если Не ЗначениеЗаполнено(ДокументИстории) Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(ДокументИстории) = Тип("ДокументСсылка.ЧекККМ") Тогда
		ПоказатьЗначение(Неопределено, ДокументИстории);
		Возврат;
	КонецЕсли;

	ПараметрыФормыЗаказа = Новый Структура("Ключ", ДокументИстории);
	// Форму определяет сам документ, а не карточка, из которой открыта история.
	Если ТекущиеДанные.ЭтоЗаказНаряд Тогда
		ОткрытьФорму("Документ.ЗаказПокупателя.Форма.ФормаЗаказНаряда",
			ПараметрыФормыЗаказа, ЭтаФорма);
	Иначе
		ОткрытьФорму("Документ.ЗаказПокупателя.Форма.ФормаДокумента",
			ПараметрыФормыЗаказа, ЭтаФорма);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура АС_НастроитьПоискИстории()

	РеквизитыПоиска = Новый Массив;
	РеквизитыПоиска.Добавить(Новый РеквизитФормы("АС_СтрокаПоискаИстории", Новый ОписаниеТипов("Строка")));
	ИзменитьРеквизиты(РеквизитыПоиска);
	ПолеПоиска = Элементы.Добавить("АС_ПоискИстории", Тип("ПолеФормы"));
	ПолеПоиска.Вид = ВидПоляФормы.ПолеВвода;
	ПолеПоиска.ПутьКДанным = "АС_СтрокаПоискаИстории";
	ПолеПоиска.Заголовок = "Поиск";
	ПолеПоиска.Подсказка = "Поиск товаров и работ по наименованию, артикулу и синонимам.";
	ПолеПоиска.КнопкаОчистки = Истина;
	ПолеПоиска.УстановитьДействие("ПриИзменении", "АС_ПоискИсторииПриИзменении");
	ПолеПоиска.УстановитьДействие("Очистка", "АС_ПоискИсторииОчистка");
	Элементы.Переместить(ПолеПоиска, ЭтотОбъект, Элементы.АС_СтраницыТоваровИРабот);
	Для Каждого ИмяСписка Из СтрРазделить("АС_ТоварыАвтомобиля,АС_РаботыСписок", ",") Цикл
		Элементы.Найти(ИмяСписка + "СтрокаПоиска").Видимость = Ложь;
		Элементы.Найти(ИмяСписка + "УправлениеПоиском").Видимость = Ложь;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура АС_ПоискИсторииПриИзменении(Элемент)

	АС_ПрименитьПоискИстории();
	Элементы.АС_ТоварыАвтомобиля.Обновить();
	Элементы.АС_РаботыСписок.Обновить();

КонецПроцедуры

&НаКлиенте
Процедура АС_ПоискИсторииОчистка(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ЭтотОбъект.АС_СтрокаПоискаИстории = "";
	Элемент.ОбновитьТекстРедактирования();
	АС_ПоискИсторииПриИзменении(Элемент);

КонецПроцедуры

&НаСервере
Процедура АС_ПрименитьПоискИстории()

	ВариантыПоиска = АС_СинонимыПоискаСервер.ВариантыСтрокиПоиска(ЭтотОбъект.АС_СтрокаПоискаИстории);
	ПараметрыПоиска = Новый Структура;
	Если ВариантыПоиска.Количество() > 0 Тогда
		ПараметрыПоиска.Вставить("АС_НайденнаяНоменклатура",
			АС_СинонимыПоискаСервер.НайтиНоменклатуруПоВариантам(ВариантыПоиска));
	КонецЕсли;
	ТипНоменклатурыЧека = Метаданные.Документы.ЧекККМ.ТабличныеЧасти.Запасы.Реквизиты.Номенклатура.Тип;
	УсловиеЧека = АС_УсловиеПоискаИстории("СтрокиЧека.Номенклатура", ВариантыПоиска,
		ПараметрыПоиска, ТипНоменклатурыЧека.СодержитТип(Тип("Строка")));

	Для Каждого ИмяСписка Из СтрРазделить("АС_ТоварыАвтомобиля,АС_РаботыСписок", ",") Цикл
		ЭтоРаботы = ИмяСписка = "АС_РаботыСписок";
		ИмяТабличнойЧасти = ?(ЭтоРаботы, "Работы", "Запасы");
		ТипНоменклатурыЗаказа = Метаданные.Документы.ЗаказПокупателя.ТабличныеЧасти[ИмяТабличнойЧасти].Реквизиты.Номенклатура.Тип;
		УсловиеЗаказа = АС_УсловиеПоискаИстории("СтрокиЗаказа.Номенклатура", ВариантыПоиска,
			ПараметрыПоиска, ТипНоменклатурыЗаказа.СодержитТип(Тип("Строка")));
		СписокИстории = ЭтотОбъект[ИмяСписка];
		СписокИстории.ТекстЗапроса = АС_ТекстЗапросаИстории(ЭтоРаботы,
			ЭтоОткрытиеИзДоговора, УсловиеЗаказа, УсловиеЧека);
		Если ЭтоОткрытиеИзДоговора Тогда
			СписокИстории.Параметры.УстановитьЗначениеПараметра("Договор", ДоговорФормы);
		Иначе
			СписокИстории.Параметры.УстановитьЗначениеПараметра("Контрагент", КонтрагентФормы);
		КонецЕсли;
		Для Каждого ПараметрПоиска Из ПараметрыПоиска Цикл
			СписокИстории.Параметры.УстановитьЗначениеПараметра(ПараметрПоиска.Ключ, ПараметрПоиска.Значение);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_УсловиеПоискаИстории(ПолеНоменклатуры, ВариантыПоиска, ПараметрыПоиска,
	ДобавлятьСтроковоеПоле = Ложь)

	Если ВариантыПоиска.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Условия = Новый Массив;
	Условия.Добавить(ПолеНоменклатуры + " В (&АС_НайденнаяНоменклатура)");
	НомерВарианта = 0;
	Для Каждого ВариантПоиска Из ВариантыПоиска Цикл
		НомерВарианта = НомерВарианта + 1;
		ПоляПоиска = Новый Массив;
		ПоляПоиска.Добавить(ПолеНоменклатуры + ".Наименование");
		ПоляПоиска.Добавить(ПолеНоменклатуры + ".НаименованиеПолное");
		ПоляПоиска.Добавить(ПолеНоменклатуры + ".Артикул");
		// ВЫРАЗИТЬ в строку допустимо только если строковый тип входит в состав поля.
		Если ДобавлятьСтроковоеПоле Тогда
			ПоляПоиска.Добавить("ВЫРАЗИТЬ(" + ПолеНоменклатуры + " КАК СТРОКА(150))");
		КонецЕсли;
		Для Каждого ПолеПоиска Из ПоляПоиска Цикл
			УсловияСлов = Новый Массив;
			НомерСлова = 0;
			Для Каждого СловоПоиска Из СтрРазделить(ВариантПоиска, " ", Ложь) Цикл
				НомерСлова = НомерСлова + 1;
				ИмяПараметра = "АС_Поиск" + Строка(НомерВарианта) + "_" + Строка(НомерСлова);
				Шаблон = СтрЗаменить(СловоПоиска, "~", "~~");
				Шаблон = СтрЗаменить(Шаблон, "%", "~%");
				Шаблон = СтрЗаменить(Шаблон, "_", "~_");
				Шаблон = СтрЗаменить(Шаблон, "[", "~[");
				Шаблон = СтрЗаменить(Шаблон, "]", "~]");
				ПараметрыПоиска.Вставить(ИмяПараметра, "%" + Шаблон + "%");
				УсловияСлов.Добавить(ПолеПоиска + " ПОДОБНО &" + ИмяПараметра + " СПЕЦСИМВОЛ ""~""");
			КонецЦикла;
			Если УсловияСлов.Количество() > 0 Тогда
				Условия.Добавить("(" + СтрСоединить(УсловияСлов, " И ") + ")");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат СтрСоединить(Условия, " ИЛИ ");

КонецФункции
