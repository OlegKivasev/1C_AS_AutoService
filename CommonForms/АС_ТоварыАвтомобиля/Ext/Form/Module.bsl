&НаСервере
Процедура АС_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЭтоОткрытиеИзДоговора = Ложь;

	Если Параметры.Свойство("Договор")
		И ЗначениеЗаполнено(Параметры.Договор) Тогда

		ДоговорФормы = Параметры.Договор;
		ЭтоОткрытиеИзДоговора = Истина;
		АС_ТоварыАвтомобиля.ТекстЗапроса = АС_ТекстЗапросаИстории(Ложь, Истина);
		АС_РаботыСписок.ТекстЗапроса = АС_ТекстЗапросаИстории(Истина, Истина);
		АС_ТоварыАвтомобиля.Параметры.УстановитьЗначениеПараметра("Договор", ДоговорФормы);
		АС_РаботыСписок.Параметры.УстановитьЗначениеПараметра("Договор", ДоговорФормы);
		Элементы.АС_СтраницаТовары.Заголовок = "Товары (" + АС_КоличествоСтрокЗаказНаряда(ДоговорФормы, Ложь) + ")";
		Элементы.АС_СтраницаРаботы.Заголовок = "Работы (" + АС_КоличествоСтрокЗаказНаряда(ДоговорФормы, Истина) + ")";

	ИначеЕсли Параметры.Свойство("Контрагент")
		И ЗначениеЗаполнено(Параметры.Контрагент) Тогда

		КонтрагентФормы = Параметры.Контрагент;
		ЭтоОткрытиеИзДоговора = Ложь;
		АС_ТоварыАвтомобиля.ТекстЗапроса = АС_ТекстЗапросаКонтрагента(Ложь);
		АС_РаботыСписок.ТекстЗапроса = АС_ТекстЗапросаКонтрагента(Истина);
		АС_ТоварыАвтомобиля.Параметры.УстановитьЗначениеПараметра("Контрагент", Параметры.Контрагент);
		АС_РаботыСписок.Параметры.УстановитьЗначениеПараметра("Контрагент", Параметры.Контрагент);
		Элементы.АС_СтраницаТовары.Заголовок = "Товары (" + АС_КоличествоСтрокКонтрагента(Параметры.Контрагент, Ложь) + ")";
		Элементы.АС_СтраницаРаботы.Заголовок = "Работы (" + АС_КоличествоСтрокКонтрагента(Параметры.Контрагент, Истина) + ")";
	КонецЕсли;

	АС_НастроитьКолонкиИстории();

КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_КоличествоСтрокЗаказНаряда(Договор, ЭтоРаботы)

	Возврат АС_КоличествоСтрокИстории(Договор, Истина, ЭтоРаботы);

КонецФункции

&НаСервереБезКонтекста
Функция АС_ТекстЗапросаКонтрагента(ЭтоРаботы)

	Возврат АС_ТекстЗапросаИстории(ЭтоРаботы, Ложь);

КонецФункции

&НаСервереБезКонтекста
Функция АС_КоличествоСтрокКонтрагента(Контрагент, ЭтоРаботы)

	Возврат АС_КоличествоСтрокИстории(Контрагент, Ложь, ЭтоРаботы);

КонецФункции

&НаСервере
Процедура АС_НастроитьКолонкиИстории()

	Элементы.АС_ТоварыАвтомобиляДатаЗаказНаряда.Заголовок = "Дата документа";
	Элементы.АС_РаботыСписокДатаЗаказНаряда.Заголовок = "Дата документа";
	Для Каждого ИмяСписка Из СтрРазделить("АС_ТоварыАвтомобиля,АС_РаботыСписок", ",") Цикл
		ИмяКолонки = ИмяСписка + "Документ";
		Если Элементы.Найти(ИмяКолонки) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Колонка = Элементы.Добавить(ИмяКолонки, Тип("ПолеФормы"), Элементы.Найти(ИмяСписка));
		Колонка.Вид = ВидПоляФормы.ПолеНадписи;
		Колонка.ПутьКДанным = ИмяСписка + ".ЗаказПокупателя";
		Колонка.Заголовок = "Документ";
		Колонка.Гиперссылка = Истина;
		Колонка.ГиперссылкаЯчейки = Истина;
		Колонка.Ширина = 30;
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_ТекстЗапросаИстории(ЭтоРаботы, ПоДоговору)

	ТабличнаяЧастьЗаказа = ?(ЭтоРаботы, "Работы", "Запасы");
	Если ПоДоговору Тогда
		УсловиеЗаказа = "Заказ.Договор = &Договор";
		УсловиеЧека = "Чек.Договор = &Договор";
		УсловиеСвязанногоЗаказа = "УчтенныеСтрокиЗаказа.Ссылка.Договор = &Договор";
	Иначе
		УсловиеЗаказа = "(Заказ.Контрагент = &Контрагент ИЛИ ДоговорКонтрагента.Владелец = &Контрагент)";
		УсловиеЧека = "(Чек.Контрагент = &Контрагент ИЛИ Чек.Договор.Владелец = &Контрагент)";
		УсловиеСвязанногоЗаказа = "(УчтенныеСтрокиЗаказа.Ссылка.Контрагент = &Контрагент ИЛИ УчтенныеСтрокиЗаказа.Ссылка.Договор.Владелец = &Контрагент)";
	КонецЕсли;
	Если ЭтоРаботы Тогда
		УсловиеТипаЧека = "СтрокиЧека.Номенклатура.ТипНоменклатуры В (ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга), ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа))";
	Иначе
		УсловиеТипаЧека = "СтрокиЧека.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)";
	КонецЕсли;

	// Имя поля ссылки сохраняем: оно входит в составной ключ динамических списков.
	Возврат "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	| Заказ.Дата КАК ДатаЗаказНаряда,
	| СтрокиЗаказа.Номенклатура КАК Номенклатура,
	| Заказ.Ссылка КАК ЗаказПокупателя,
	| СтрокиЗаказа.НомерСтроки КАК НомерСтроки
	|ИЗ
	| Документ.ЗаказПокупателя." + ТабличнаяЧастьЗаказа + " КАК СтрокиЗаказа
	|  ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя КАК Заказ
	|  ПО СтрокиЗаказа.Ссылка = Заказ.Ссылка
	|  ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорКонтрагента
	|  ПО Заказ.Договор = ДоговорКонтрагента.Ссылка
	|ГДЕ
	| НЕ Заказ.ПометкаУдаления
	| И " + УсловиеЗаказа + "
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	| Чек.Дата,
	| СтрокиЧека.Номенклатура,
	| Чек.Ссылка,
	| СтрокиЧека.НомерСтроки
	|ИЗ
	| Документ.ЧекККМ.Запасы КАК СтрокиЧека
	|  ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЧекККМ КАК Чек
	|  ПО СтрокиЧека.Ссылка = Чек.Ссылка
	|  ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя." + ТабличнаяЧастьЗаказа + " КАК УчтенныеСтрокиЗаказа
	|  ПО СтрокиЧека.Заказ = УчтенныеСтрокиЗаказа.Ссылка
	|   И СтрокиЧека.Номенклатура = УчтенныеСтрокиЗаказа.Номенклатура
	|   И НЕ УчтенныеСтрокиЗаказа.Ссылка.ПометкаУдаления
	|   И " + УсловиеСвязанногоЗаказа + "
	|ГДЕ
	| Чек.Проведен
	| И НЕ Чек.ПометкаУдаления
	| И Чек.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЧековККМ.Пробит)
	| И НЕ Чек.ОперацияСДенежнымиСредствами
	| И " + УсловиеЧека + "
	| И " + УсловиеТипаЧека + "
	| И УчтенныеСтрокиЗаказа.Ссылка ЕСТЬ NULL";

КонецФункции

&НаСервереБезКонтекста
Функция АС_КоличествоСтрокИстории(ЗначениеОтбора, ПоДоговору, ЭтоРаботы)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр(?(ПоДоговору, "Договор", "Контрагент"), ЗначениеОтбора);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ КОЛИЧЕСТВО(*) КАК Количество ИЗ ("
		+ СтрЗаменить(АС_ТекстЗапросаИстории(ЭтоРаботы, ПоДоговору),
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ", "ВЫБРАТЬ") + ") КАК История";
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Количество;

КонецФункции

&НаКлиенте
Процедура АС_РаботыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	АС_ОткрытьДокументИстории(Элемент, СтандартнаяОбработка);

КонецПроцедуры

&НаКлиенте
Процедура АС_ТоварыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	АС_ОткрытьДокументИстории(Элемент, СтандартнаяОбработка);

КонецПроцедуры

&НаКлиенте
Процедура АС_ОткрытьДокументИстории(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ДокументИстории = ТекущиеДанные.ЗаказПокупателя;
	Если Не ЗначениеЗаполнено(ДокументИстории) Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(ДокументИстории) = Тип("ДокументСсылка.ЧекККМ") Тогда
		ПоказатьЗначение(Неопределено, ДокументИстории);
		Возврат;
	КонецЕсли;

	ПараметрыФормыЗаказа = Новый Структура("Ключ", ДокументИстории);
	Если ЭтоОткрытиеИзДоговора Тогда
		ОткрытьФорму("Документ.ЗаказПокупателя.Форма.ФормаЗаказНаряда",
			ПараметрыФормыЗаказа, ЭтаФорма);
	Иначе
		ОткрытьФорму("Документ.ЗаказПокупателя.Форма.ФормаДокумента",
			ПараметрыФормыЗаказа, ЭтаФорма);
	КонецЕсли;

КонецПроцедуры
