&НаСервере
Процедура АС_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЭтоОткрытиеИзДоговора = Ложь;

	Если Параметры.Свойство("Договор")
		И ЗначениеЗаполнено(Параметры.Договор) Тогда

		ДоговорФормы = Параметры.Договор;
		ЭтоОткрытиеИзДоговора = Истина;
		АС_ТоварыАвтомобиля.Параметры.УстановитьЗначениеПараметра("Договор", ДоговорФормы);
		АС_РаботыСписок.Параметры.УстановитьЗначениеПараметра("Договор", ДоговорФормы);
		Элементы.АС_СтраницаТовары.Заголовок = "Товары (" + АС_КоличествоСтрокЗаказНаряда(ДоговорФормы, Ложь) + ")";
		Элементы.АС_СтраницаРаботы.Заголовок = "Работы (" + АС_КоличествоСтрокЗаказНаряда(ДоговорФормы, Истина) + ")";

	ИначеЕсли Параметры.Свойство("Контрагент")
		И ЗначениеЗаполнено(Параметры.Контрагент) Тогда

		КонтрагентФормы = Параметры.Контрагент;
		ЭтоОткрытиеИзДоговора = Ложь;
		АС_ТоварыАвтомобиля.ТекстЗапроса = АС_ТекстЗапросаКонтрагента(Ложь);
		АС_РаботыСписок.ТекстЗапроса = АС_ТекстЗапросаКонтрагента(Истина);
		АС_ТоварыАвтомобиля.Параметры.УстановитьЗначениеПараметра("Контрагент", Параметры.Контрагент);
		АС_РаботыСписок.Параметры.УстановитьЗначениеПараметра("Контрагент", Параметры.Контрагент);
		Элементы.АС_СтраницаТовары.Заголовок = "Товары (" + АС_КоличествоСтрокКонтрагента(Параметры.Контрагент, Ложь) + ")";
		Элементы.АС_СтраницаРаботы.Заголовок = "Работы (" + АС_КоличествоСтрокКонтрагента(Параметры.Контрагент, Истина) + ")";
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_КоличествоСтрокЗаказНаряда(Договор, ЭтоРаботы)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Договор", Договор);
	Если ЭтоРаботы Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		| 	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		| 	Документ.ЗаказПокупателя.Работы КАК СтрокиЗаказа
		|ГДЕ
		| 	СтрокиЗаказа.Ссылка.Договор = &Договор
		| 	И НЕ СтрокиЗаказа.Ссылка.ПометкаУдаления";
	Иначе
		Запрос.Текст =
		"ВЫБРАТЬ
		| 	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		| 	Документ.ЗаказПокупателя.Запасы КАК СтрокиЗаказа
		|ГДЕ
		| 	СтрокиЗаказа.Ссылка.Договор = &Договор
		| 	И НЕ СтрокиЗаказа.Ссылка.ПометкаУдаления";
	КонецЕсли;

	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Количество;

КонецФункции

&НаСервереБезКонтекста
Функция АС_ТекстЗапросаКонтрагента(ЭтоРаботы)

	Если ЭтоРаботы Тогда
		Возврат "ВЫБРАТЬ
		| Заказ.Дата КАК ДатаЗаказНаряда,
		| СтрокиРабот.Номенклатура КАК Номенклатура,
		| Заказ.Ссылка КАК ЗаказПокупателя
		|ИЗ
		| Документ.ЗаказПокупателя.Работы КАК СтрокиРабот
		|  ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя КАК Заказ
		|  ПО СтрокиРабот.Ссылка = Заказ.Ссылка
		|  ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорКонтрагента
		|  ПО Заказ.Договор = ДоговорКонтрагента.Ссылка
		|ГДЕ
		| НЕ Заказ.ПометкаУдаления
		| И (Заказ.Контрагент = &Контрагент
		|  ИЛИ ДоговорКонтрагента.Владелец = &Контрагент)";
	КонецЕсли;

	Возврат "ВЫБРАТЬ
	| Заказ.Дата КАК ДатаЗаказНаряда,
	| СтрокиТоваров.Номенклатура КАК Номенклатура,
	| Заказ.Ссылка КАК ЗаказПокупателя
	|ИЗ
	| Документ.ЗаказПокупателя.Запасы КАК СтрокиТоваров
	|  ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя КАК Заказ
	|  ПО СтрокиТоваров.Ссылка = Заказ.Ссылка
	|  ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорКонтрагента
	|  ПО Заказ.Договор = ДоговорКонтрагента.Ссылка
	|ГДЕ
	| НЕ Заказ.ПометкаУдаления
	| И (Заказ.Контрагент = &Контрагент
	|  ИЛИ ДоговорКонтрагента.Владелец = &Контрагент)";

КонецФункции

&НаСервереБезКонтекста
Функция АС_КоличествоСтрокКонтрагента(Контрагент, ЭтоРаботы)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Если ЭтоРаботы Тогда
		Запрос.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ Документ.ЗаказПокупателя.Работы КАК СтрокиЗаказа ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорКонтрагента ПО СтрокиЗаказа.Ссылка.Договор = ДоговорКонтрагента.Ссылка ГДЕ (СтрокиЗаказа.Ссылка.Контрагент = &Контрагент ИЛИ ДоговорКонтрагента.Владелец = &Контрагент) И НЕ СтрокиЗаказа.Ссылка.ПометкаУдаления";
	Иначе
		Запрос.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ Документ.ЗаказПокупателя.Запасы КАК СтрокиЗаказа ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорКонтрагента ПО СтрокиЗаказа.Ссылка.Договор = ДоговорКонтрагента.Ссылка ГДЕ (СтрокиЗаказа.Ссылка.Контрагент = &Контрагент ИЛИ ДоговорКонтрагента.Владелец = &Контрагент) И НЕ СтрокиЗаказа.Ссылка.ПометкаУдаления";
	КонецЕсли;
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Количество;

КонецФункции

&НаКлиенте
Процедура АС_РаботыВыбор(Элемент, ВыбраннаяСтрока, СтандартнаяОбработка)

	АС_ОткрытьЗаказПокупателя(Элемент, Истина, СтандартнаяОбработка);

КонецПроцедуры

&НаКлиенте
Процедура АС_ТоварыВыбор(Элемент, ВыбраннаяСтрока, СтандартнаяОбработка)

	АС_ОткрытьЗаказПокупателя(Элемент, Ложь, СтандартнаяОбработка);

КонецПроцедуры

&НаКлиенте
Процедура АС_ОткрытьЗаказПокупателя(Элемент, ЭтоРаботы, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.Номенклатура)
		ИЛИ НЕ ЗначениеЗаполнено(ТекущиеДанные.ДатаЗаказНаряда) Тогда
		Возврат;
	КонецЕсли;

	ЗаказПокупателя = АС_НайтиЗаказПокупателяНаСервере(
		ДоговорФормы, КонтрагентФормы, ТекущиеДанные.Номенклатура,
		ТекущиеДанные.ДатаЗаказНаряда, ЭтоРаботы);
	Если НЕ ЗначениеЗаполнено(ЗаказПокупателя) Тогда
		Возврат;
	КонецЕсли;

	ПараметрыФормыЗаказа = Новый Структура("Ключ", ЗаказПокупателя);
	Если ЭтоОткрытиеИзДоговора Тогда
		ОткрытьФорму("Документ.ЗаказПокупателя.Форма.ФормаЗаказНаряда",
			ПараметрыФормыЗаказа, ЭтаФорма);
	Иначе
		ОткрытьФорму("Документ.ЗаказПокупателя.Форма.ФормаДокумента",
			ПараметрыФормыЗаказа, ЭтаФорма);
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_НайтиЗаказПокупателяНаСервере(Договор, Контрагент, Номенклатура, ДатаЗаказа, ЭтоРаботы)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Договор", Договор);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("ДатаЗаказа", ДатаЗаказа);

	Если ЭтоРаботы Тогда
		ТабличнаяЧасть = "Документ.ЗаказПокупателя.Работы";
	Иначе
		ТабличнаяЧасть = "Документ.ЗаказПокупателя.Запасы";
	КонецЕсли;

	Если ЗначениеЗаполнено(Договор) Тогда
		УсловиеОтбора = "СтрокиЗаказа.Ссылка.Договор = &Договор";
	Иначе
		УсловиеОтбора = "(СтрокиЗаказа.Ссылка.Контрагент = &Контрагент ИЛИ ДоговорКонтрагента.Владелец = &Контрагент)";
	КонецЕсли;

	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	| СтрокиЗаказа.Ссылка КАК ЗаказПокупателя
	|ИЗ
	| " + ТабличнаяЧасть + " КАК СтрокиЗаказа
	| ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорКонтрагента
	| ПО СтрокиЗаказа.Ссылка.Договор = ДоговорКонтрагента.Ссылка
	|ГДЕ
	| НЕ СтрокиЗаказа.Ссылка.ПометкаУдаления
	| И СтрокиЗаказа.Номенклатура = &Номенклатура
	| И СтрокиЗаказа.Ссылка.Дата = &ДатаЗаказа
	| И " + УсловиеОтбора;

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ЗаказПокупателя;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции
