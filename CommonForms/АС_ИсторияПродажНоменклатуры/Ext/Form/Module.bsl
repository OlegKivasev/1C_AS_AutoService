&НаСервере
Процедура АС_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не Параметры.Свойство("Номенклатура") Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Параметры.Номенклатура) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	НоменклатураФормы = Параметры.Номенклатура;
	АС_История.ТекстЗапроса = АС_ПродажиНоменклатурыСервер.ТекстЗапросаПолнойИстории();
	Элементы.АС_ИсторияДата.Заголовок = "Дата события";
	Элементы.АС_ОписаниеИстории.Заголовок =
		"Добавление товара в заказы, продажи по чекам ККМ, списания и перемещения. Количество в единицах хранения.";
	КолонкаПокупателя = Элементы.Добавить("АС_ИсторияПокупатель", Тип("ПолеФормы"), Элементы.АС_История);
	КолонкаПокупателя.Вид = ВидПоляФормы.ПолеНадписи;
	КолонкаПокупателя.ПутьКДанным = "АС_История.Контрагент";
	КолонкаПокупателя.Заголовок = "Покупатель";
	КолонкаПокупателя.Ширина = 30;
	Заголовок = "История продажи: " + Строка(НоменклатураФормы);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
		АС_История, "Номенклатура", НоменклатураФормы);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
		АС_История, "НачалоПериода", Дата(1, 1, 1));
	АС_УстановитьКонецИстории();

КонецПроцедуры

&НаСервере
Процедура АС_УстановитьКонецИстории()

	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
		АС_История, "КонецПериода", КонецДня(ТекущаяДатаСеанса()));

КонецПроцедуры

&НаКлиенте
Процедура АС_Обновить(Команда)

	АС_УстановитьКонецИстории();
	Элементы.АС_История.Обновить();

КонецПроцедуры

&НаКлиенте
Процедура АС_ИсторияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ДанныеСтроки = Элемент.ТекущиеДанные;
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(ДанныеСтроки.Заказ) <> Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		ПоказатьЗначение(Неопределено, ДанныеСтроки.Заказ);
		Возврат;
	КонецЕсли;
	ПараметрыЗаказа = Новый Структура("Ключ", ДанныеСтроки.Заказ);
	Если ДанныеСтроки.ЭтоЗаказНаряд Тогда
		ОткрытьФорму("Документ.ЗаказПокупателя.Форма.ФормаЗаказНаряда", ПараметрыЗаказа, ЭтаФорма);
	Иначе
		ОткрытьФорму("Документ.ЗаказПокупателя.Форма.ФормаДокумента", ПараметрыЗаказа, ЭтаФорма);
	КонецЕсли;

КонецПроцедуры
