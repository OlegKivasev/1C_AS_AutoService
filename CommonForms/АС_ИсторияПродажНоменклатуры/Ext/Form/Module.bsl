&НаСервере
Процедура АС_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не Параметры.Свойство("Номенклатура") Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Параметры.Номенклатура) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	НоменклатураФормы = Параметры.Номенклатура;
	Заголовок = "История продажи: " + Строка(НоменклатураФормы);
	АС_ЗаполнитьИсториюНаСервере();

КонецПроцедуры

&НаСервере
Процедура АС_ЗаполнитьИсториюНаСервере()

	// Схема колонок задана в XML формы. Пакет общего запроса выполняется
	// обычным запросом и не используется как источник схемы динамического списка.
	Запрос = Новый Запрос(АС_ПродажиНоменклатурыСервер.ТекстЗапросаПолнойИстории());
	Запрос.УстановитьПараметр("Номенклатура", НоменклатураФормы);
	Запрос.УстановитьПараметр("НачалоПериода", Дата(1, 1, 1));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ТекущаяДатаСеанса()));
	История = Запрос.Выполнить().Выгрузить();
	История.Сортировать("Дата УБЫВ, НаименованиеЗаказа, Операция");
	ТекущаяИстория = РеквизитФормыВЗначение("АС_История");
	Если АС_ИсторияСовпадает(История, ТекущаяИстория) Тогда
		Возврат;
	КонецЕсли;
	ЗначениеВРеквизитФормы(История, "АС_История");

КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_ИсторияСовпадает(История, ТекущаяИстория)

	Если История.Количество() <> ТекущаяИстория.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	Для ИндексСтроки = 0 По История.Количество() - 1 Цикл
		Для Каждого Колонка Из История.Колонки Цикл
			Если История[ИндексСтроки][Колонка.Имя] <> ТекущаяИстория[ИндексСтроки][Колонка.Имя] Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Истина;

КонецФункции

&НаКлиенте
Процедура АС_ПриОткрытии(Отказ)

	Если Не Отказ Тогда
		ПодключитьОбработчикОжидания("АС_ОбновитьИсторию", 5);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_ПриЗакрытии()

	ОтключитьОбработчикОжидания("АС_ОбновитьИсторию");

КонецПроцедуры

&НаКлиенте
Процедура АС_Обновить(Команда)

	АС_ОбновитьИсторию();

КонецПроцедуры

&НаКлиенте
Процедура АС_ОбновитьИсторию() Экспорт

	ТекущиеДанные = Элементы.АС_История.ТекущиеДанные;
	КлючТекущейСтроки = Неопределено;
	Если ТекущиеДанные <> Неопределено Тогда
		КлючТекущейСтроки = Новый Структура("Заказ,Дата,Операция",
			ТекущиеДанные.Заказ, ТекущиеДанные.Дата, ТекущиеДанные.Операция);
	КонецЕсли;
	АС_ЗаполнитьИсториюНаСервере();
	Если КлючТекущейСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого СтрокаИстории Из АС_История Цикл
		Если СтрокаИстории.Заказ = КлючТекущейСтроки.Заказ
			И СтрокаИстории.Дата = КлючТекущейСтроки.Дата
			И СтрокаИстории.Операция = КлючТекущейСтроки.Операция Тогда
			Элементы.АС_История.ТекущаяСтрока = СтрокаИстории.ПолучитьИдентификатор();
			Прервать;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура АС_ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "Запись_ЗаказПокупателя"
		Или ИмяСобытия = "ИзменениеСостояния_ЗаказПокупателя"
		Или ИмяСобытия = "Запись_ЗаказНаряды"
		Или ИмяСобытия = "ПроведениеЗаказНаряда"
		Или ИмяСобытия = "Запись_ЧекККМ"
		Или ИмяСобытия = "Запись_СписаниеЗапасов"
		Или ИмяСобытия = "Запись_ПеремещениеЗапасов" Тогда
		АС_ОбновитьИсторию();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_ИсторияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ДанныеСтроки = Элемент.ТекущиеДанные;
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(ДанныеСтроки.Заказ) <> Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		ПоказатьЗначение(Неопределено, ДанныеСтроки.Заказ);
		Возврат;
	КонецЕсли;
	ПараметрыЗаказа = Новый Структура("Ключ", ДанныеСтроки.Заказ);
	Если ДанныеСтроки.ЭтоЗаказНаряд Тогда
		ОткрытьФорму("Документ.ЗаказПокупателя.Форма.ФормаЗаказНаряда", ПараметрыЗаказа, ЭтаФорма);
	Иначе
		ОткрытьФорму("Документ.ЗаказПокупателя.Форма.ФормаДокумента", ПараметрыЗаказа, ЭтаФорма);
	КонецЕсли;

КонецПроцедуры
