		<Attribute name="АС_Модели" id="10">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<UseAlways>
				<Field>АС_Модели.Модель</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ РАЗРЕШЕННЫЕ
    ДокументЗаказа.Ссылка КАК Заказ,
    ВЫБОР
        КОГДА ЕСТЬNULL(ДоговорАвтомобиля.АС_МодельАвтомобиляИзСправочника,
            ЗНАЧЕНИЕ(Справочник.АС_Автомобили.ПустаяСсылка))
            &lt;&gt; ЗНАЧЕНИЕ(Справочник.АС_Автомобили.ПустаяСсылка)
        ТОГДА ДоговорАвтомобиля.АС_МодельАвтомобиляИзСправочника
        ИНАЧЕ ПокупательАвтомобиля.АС_МодельАвтомобиляИзСправочника
    КОНЕЦ КАК Модель
ПОМЕСТИТЬ ВТЗаказыПериода
ИЗ
    Документ.ЗаказПокупателя КАК ДокументЗаказа
        ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорАвтомобиля
        ПО ДокументЗаказа.Договор = ДоговорАвтомобиля.Ссылка
        ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК ПокупательАвтомобиля
        ПО ДокументЗаказа.Контрагент = ПокупательАвтомобиля.Ссылка
ГДЕ
    НЕ ДокументЗаказа.ПометкаУдаления
    И ДокументЗаказа.Дата &gt;= &amp;ПримененноеНачалоПериода
    И ДокументЗаказа.Дата &lt;= &amp;ПримененныйКонецПериода
ИНДЕКСИРОВАТЬ ПО
    Заказ
;

ВЫБРАТЬ РАЗРЕШЕННЫЕ
    ЗаказыПериода.Заказ КАК Заказ,
    ЗаказыПериода.Модель КАК Модель
ПОМЕСТИТЬ ВТЗаказыПоМоделям
ИЗ
    ВТЗаказыПериода КАК ЗаказыПериода
        ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.АС_Автомобили КАК ДанныеМоделей
        ПО ЗаказыПериода.Модель = ДанныеМоделей.Ссылка
ГДЕ
    ДанныеМоделей.Ссылка &lt;&gt; ЗНАЧЕНИЕ(Справочник.АС_Автомобили.ПустаяСсылка)
    И НЕ ДанныеМоделей.ЭтоГруппа
ИНДЕКСИРОВАТЬ ПО
    Заказ
;

ВЫБРАТЬ РАЗРЕШЕННЫЕ
    ОбращенияПоМоделям.Модель КАК Модель,
    КОЛИЧЕСТВО(ОбращенияПоМоделям.Заказ) КАК КоличествоОбращений
ПОМЕСТИТЬ ВТКоличествоОбращений
ИЗ
    (ВЫБРАТЬ РАЗЛИЧНЫЕ
        ЗаказыПоМоделям.Модель КАК Модель,
        ЗаказыПоМоделям.Заказ КАК Заказ
    ИЗ
        ВТЗаказыПоМоделям КАК ЗаказыПоМоделям
            ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя.Запасы КАК СтрокиТоваров
            ПО ЗаказыПоМоделям.Заказ = СтрокиТоваров.Ссылка
    ГДЕ
        НЕ СтрокиТоваров.ЭтоРазделитель
        И СтрокиТоваров.Номенклатура &lt;&gt; ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
        И СтрокиТоваров.Номенклатура &lt;&gt; &quot;&quot;

    ОБЪЕДИНИТЬ

    ВЫБРАТЬ РАЗЛИЧНЫЕ
        ЗаказыПоМоделям.Модель,
        ЗаказыПоМоделям.Заказ
    ИЗ
        ВТЗаказыПоМоделям КАК ЗаказыПоМоделям
            ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя.Работы КАК СтрокиРабот
            ПО ЗаказыПоМоделям.Заказ = СтрокиРабот.Ссылка
    ГДЕ
        СтрокиРабот.Номенклатура &lt;&gt; ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
    ) КАК ОбращенияПоМоделям
СГРУППИРОВАТЬ ПО
    ОбращенияПоМоделям.Модель
;

ВЫБРАТЬ РАЗРЕШЕННЫЕ
    ИтогиОбращений.Модель КАК Модель,
    ВЫРАЗИТЬ(ЕСТЬNULL(ДанныеМоделей.Родитель.Наименование, &quot;&quot;) + &quot; &quot;
        + ДанныеМоделей.Наименование КАК СТРОКА(500)) КАК Автомобиль,
    ИтогиОбращений.КоличествоОбращений КАК КоличествоОбращений
ИЗ
    ВТКоличествоОбращений КАК ИтогиОбращений
        ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.АС_Автомобили КАК ДанныеМоделей
        ПО ИтогиОбращений.Модель = ДанныеМоделей.Ссылка</QueryText>
				<KeyType>RowKey</KeyType>
				<KeyField>Модель</KeyField>
				<ListSettings><dcsset:filter xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings"><dcsset:viewMode>Normal</dcsset:viewMode><dcsset:userSettingID>10b96357-4d21-4a82-9c2c-96ba270d92a9</dcsset:userSettingID></dcsset:filter><dcsset:order xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings"><dcsset:item xsi:type="dcsset:OrderItemField" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><dcsset:field>КоличествоОбращений</dcsset:field><dcsset:orderType>Desc</dcsset:orderType></dcsset:item><dcsset:viewMode>Normal</dcsset:viewMode><dcsset:userSettingID>0f24a075-7d26-49f7-8758-0eec62a057f7</dcsset:userSettingID></dcsset:order><dcsset:conditionalAppearance xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings"><dcsset:viewMode>Normal</dcsset:viewMode><dcsset:userSettingID>125602a1-c768-4627-875d-ecba2dd50b6d</dcsset:userSettingID></dcsset:conditionalAppearance><dcsset:itemsViewMode xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings">Normal</dcsset:itemsViewMode><dcsset:itemsUserSettingID xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings">caefafa5-0c4b-42ac-8dfb-fe49f9adbaf9</dcsset:itemsUserSettingID></ListSettings>
			</Settings>
		</Attribute>
