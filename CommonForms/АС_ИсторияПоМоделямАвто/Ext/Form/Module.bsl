&НаСервере
Процедура АС_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    АС_ЗагрузитьДанныеНаСервере();
    АС_НачальнаяСортировкаНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура АС_Обновить(Команда)

    Если ЗначениеЗаполнено(НачалоПериода) И ЗначениеЗаполнено(КонецПериода)
        И НачалоПериода > КонецПериода Тогда
        Сообщить("Начало периода не может быть позже окончания.");
        Возврат;
    КонецЕсли;
    АС_ЗагрузитьДанныеНаСервере();
    Элементы.АС_Модели.Обновить();

КонецПроцедуры

&НаСервере
Процедура АС_ЗагрузитьДанныеНаСервере()

    НовоеНачалоПериода = НачалоДня(НачалоПериода);
    НовыйКонецПериода = КонецПериода;
    Если ЗначениеЗаполнено(КонецПериода) Тогда
        НовыйКонецПериода = КонецДня(КонецПериода);
    КонецЕсли;

    // Подготовка выполняется только при открытии и явном обновлении формы.
    // Запрос динамического списка не содержит этого тяжёлого расчёта.
    Запрос = Новый Запрос;
    Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
    Запрос.Текст = АС_ТекстЗапросаДанных(ЗначениеЗаполнено(КонецПериода));
    Запрос.УстановитьПараметр("НачалоПериода", НовоеНачалоПериода);
    Запрос.УстановитьПараметр("КонецПериода", НовыйКонецПериода);
    Результаты = Запрос.ВыполнитьПакет();
    Данные = Результаты[Результаты.Количество() - 1].Выгрузить();
    Запрос.МенеджерВременныхТаблиц.Закрыть();
    АС_ПодготовитьСписокМоделей(Данные);
    ПримененноеНачалоПериода = НовоеНачалоПериода;
    ПримененныйКонецПериода = НовыйКонецПериода;

КонецПроцедуры

&НаСервере
Процедура АС_ПодготовитьСписокМоделей(Данные)

    // Кэш чисел в параметрах списка. Сортировка читает только небольшой справочник.
    ГруппыПоКоличеству = Новый Соответствие;
    Для Каждого СтрокаДанных Из Данные Цикл
        МоделиГруппы = ГруппыПоКоличеству.Получить(СтрокаДанных.КоличествоОбращений);
        Если МоделиГруппы = Неопределено Тогда
            МоделиГруппы = Новый Массив;
            ГруппыПоКоличеству.Вставить(СтрокаДанных.КоличествоОбращений, МоделиГруппы);
        КонецЕсли;
        МоделиГруппы.Добавить(СтрокаДанных.Модель);
    КонецЦикла;

    ПараметрыСписка = Новый Структура;
    ПараметрыСписка.Вставить("Модели", Данные.ВыгрузитьКолонку("Модель"));
    ВыражениеКоличества = "0";
    Если ГруппыПоКоличеству.Количество() > 0 Тогда
        ВыражениеКоличества = "ВЫБОР";
        ИндексГруппы = 0;
        Для Каждого ГруппаПоКоличеству Из ГруппыПоКоличеству Цикл
            Суффикс = Формат(ИндексГруппы, "ЧГ=0; ЧДЦ=0");
            ИмяМоделей = "МоделиГруппы" + Суффикс;
            ИмяКоличества = "КоличествоГруппы" + Суффикс;
            ВыражениеКоличества = ВыражениеКоличества + Символы.ПС
                + " КОГДА ДанныеМоделей.Ссылка В (&" + ИмяМоделей + ")"
                + " ТОГДА &" + ИмяКоличества;
            ПараметрыСписка.Вставить(ИмяМоделей, ГруппаПоКоличеству.Значение);
            ПараметрыСписка.Вставить(ИмяКоличества, ГруппаПоКоличеству.Ключ);
            ИндексГруппы = ИндексГруппы + 1;
        КонецЦикла;
        ВыражениеКоличества = ВыражениеКоличества + " ИНАЧЕ 0 КОНЕЦ";
    КонецЕсли;

    АС_Модели.ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
    | ДанныеМоделей.Ссылка КАК Модель,
    | ВЫРАЗИТЬ(ЕСТЬNULL(ДанныеМоделей.Родитель.Наименование, """") + "" ""
    |     + ДанныеМоделей.Наименование КАК СТРОКА(500)) КАК Автомобиль,
    | ВЫРАЗИТЬ(" + ВыражениеКоличества + " КАК ЧИСЛО(10, 0)) КАК КоличествоОбращений
    |ИЗ Справочник.АС_Автомобили КАК ДанныеМоделей
    |ГДЕ ДанныеМоделей.Ссылка В (&Модели)";
    Для Каждого ПараметрСписка Из ПараметрыСписка Цикл
        АС_Модели.Параметры.УстановитьЗначениеПараметра(
            ПараметрСписка.Ключ, ПараметрСписка.Значение);
    КонецЦикла;
    АС_Модели.УстановитьОбязательноеИспользование("Модель", Истина);

КонецПроцедуры

&НаСервере
Процедура АС_НачальнаяСортировкаНаСервере()

    АС_Модели.Порядок.Элементы.Очистить();
    ПорядокКоличества = АС_Модели.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
    ПорядокКоличества.Использование = Истина;
    ПорядокКоличества.Поле = Новый ПолеКомпоновкиДанных("КоличествоОбращений");
    ПорядокКоличества.ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Убыв;
    ПорядокАвтомобиля = АС_Модели.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
    ПорядокАвтомобиля.Использование = Истина;
    ПорядокАвтомобиля.Поле = Новый ПолеКомпоновкиДанных("Автомобиль");
    ПорядокАвтомобиля.ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Возр;

КонецПроцедуры

&НаСервере
Процедура АС_ПриЗагрузкеПользовательскихНастроекНаСервере(Элемент, Настройки, ИспользуютсяСтандартныеНастройки)

    // Начальный порядок применяется после восстановления сохранённых настроек.
    АС_НачальнаяСортировкаНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура АС_СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

    СтандартнаяОбработка = Ложь;
    ДанныеСтроки = Элемент.ТекущиеДанные;
    Если ДанныеСтроки = Неопределено Тогда
        Возврат;
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(ДанныеСтроки.Модель) Тогда
        Возврат;
    КонецЕсли;

    ПараметрыФормы = Новый Структура("Модель,НачалоПериода,КонецПериода",
        ДанныеСтроки.Модель, ПримененноеНачалоПериода, ПримененныйКонецПериода);
    ОткрытьФорму("ОбщаяФорма.АС_ТоварыМоделиАвто", ПараметрыФормы, ЭтаФорма,
        Новый УникальныйИдентификатор);

КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_ТекстЗапросаДанных(ОграничитьКонецПериода)

    ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
    |    ДокументЗаказа.Ссылка КАК Заказ,
    |    ВЫБОР
    |        КОГДА ЕСТЬNULL(ДоговорАвтомобиля.АС_МодельАвтомобиляИзСправочника,
    |            ЗНАЧЕНИЕ(Справочник.АС_Автомобили.ПустаяСсылка))
    |            <> ЗНАЧЕНИЕ(Справочник.АС_Автомобили.ПустаяСсылка)
    |        ТОГДА ДоговорАвтомобиля.АС_МодельАвтомобиляИзСправочника
    |        ИНАЧЕ ПокупательАвтомобиля.АС_МодельАвтомобиляИзСправочника
    |    КОНЕЦ КАК Модель
    |ПОМЕСТИТЬ ВТЗаказыПериода
    |ИЗ
    |    Документ.ЗаказПокупателя КАК ДокументЗаказа
    |        ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорАвтомобиля
    |        ПО ДокументЗаказа.Договор = ДоговорАвтомобиля.Ссылка
    |        ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК ПокупательАвтомобиля
    |        ПО ДокументЗаказа.Контрагент = ПокупательАвтомобиля.Ссылка
    |ГДЕ
    |    НЕ ДокументЗаказа.ПометкаУдаления
    |    И ДокументЗаказа.Дата >= &НачалоПериода
    |    [УсловиеКонцаПериода]
    |ИНДЕКСИРОВАТЬ ПО
    |    Заказ
    |;
    |
    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
    |    ЗаказыПериода.Заказ КАК Заказ,
    |    ЗаказыПериода.Модель КАК Модель
    |ПОМЕСТИТЬ ВТЗаказыПоМоделям
    |ИЗ
    |    ВТЗаказыПериода КАК ЗаказыПериода
    |        ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.АС_Автомобили КАК ДанныеМоделей
    |        ПО ЗаказыПериода.Модель = ДанныеМоделей.Ссылка
    |ГДЕ
    |    ДанныеМоделей.Ссылка <> ЗНАЧЕНИЕ(Справочник.АС_Автомобили.ПустаяСсылка)
    |    И НЕ ДанныеМоделей.ЭтоГруппа
    |ИНДЕКСИРОВАТЬ ПО
    |    Заказ
    |;
    |
    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
    |    ОбращенияПоМоделям.Модель КАК Модель,
    |    КОЛИЧЕСТВО(ОбращенияПоМоделям.Заказ) КАК КоличествоОбращений
    |ПОМЕСТИТЬ ВТКоличествоОбращений
    |ИЗ
    |    (ВЫБРАТЬ РАЗЛИЧНЫЕ
    |        ЗаказыПоМоделям.Модель КАК Модель,
    |        ЗаказыПоМоделям.Заказ КАК Заказ
    |    ИЗ
    |        ВТЗаказыПоМоделям КАК ЗаказыПоМоделям
    |            ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя.Запасы КАК СтрокиТоваров
    |            ПО ЗаказыПоМоделям.Заказ = СтрокиТоваров.Ссылка
    |    ГДЕ
    |        НЕ СтрокиТоваров.ЭтоРазделитель
    |    И СтрокиТоваров.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
    |    И СтрокиТоваров.Номенклатура <> """"
    |
    |    ОБЪЕДИНИТЬ
    |
    |    ВЫБРАТЬ РАЗЛИЧНЫЕ
    |        ЗаказыПоМоделям.Модель,
    |        ЗаказыПоМоделям.Заказ
    |    ИЗ
    |        ВТЗаказыПоМоделям КАК ЗаказыПоМоделям
    |            ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя.Работы КАК СтрокиРабот
    |            ПО ЗаказыПоМоделям.Заказ = СтрокиРабот.Ссылка
    |    ГДЕ
    |        СтрокиРабот.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
    |    ) КАК ОбращенияПоМоделям
    |СГРУППИРОВАТЬ ПО
    |    ОбращенияПоМоделям.Модель
    |;
    |
    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
    |    ИтогиОбращений.Модель КАК Модель,
    |    ВЫРАЗИТЬ(ЕСТЬNULL(ДанныеМоделей.Родитель.Наименование, """") + "" ""
    |        + ДанныеМоделей.Наименование КАК СТРОКА(500)) КАК Автомобиль,
    |    ИтогиОбращений.КоличествоОбращений КАК КоличествоОбращений
    |ИЗ
    |    ВТКоличествоОбращений КАК ИтогиОбращений
    |        ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.АС_Автомобили КАК ДанныеМоделей
    |        ПО ИтогиОбращений.Модель = ДанныеМоделей.Ссылка";
    // Убираем OR с необязательной датой: период ограничивает документы до чтения строк.
    УсловиеКонцаПериода = "";
    Если ОграничитьКонецПериода Тогда
        УсловиеКонцаПериода = "И ДокументЗаказа.Дата <= &КонецПериода";
    КонецЕсли;
    Возврат СтрЗаменить(ТекстЗапроса, "[УсловиеКонцаПериода]", УсловиеКонцаПериода);

КонецФункции
