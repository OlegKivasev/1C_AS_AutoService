&НаКлиенте
Перем СостояниеДиалога;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не ПравоДоступа("Добавление", Метаданные.Документы.ЗаказПоставщику) Тогда
		Сообщить("У вас нет права создавать заказы поставщикам.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	Попытка
		Пакет = ПрочитатьЗаказ(Параметры.ТекстЗаказа);
	Исключение
		Сообщить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Отказ = Истина;
		Возврат;
	КонецПопытки;
	Таблица = ТаблицаСтрокЗаказа();
	НастроитьРеквизиты(Таблица);
	ЭтотОбъект.Заголовок = "Тестовый заказ · " + Пакет.ИмяПоставщика + " · " + Пакет.ИсходныйНомер;
	ЭтотОбъект.НомерПоставщика = Пакет.Номер;
	ЭтотОбъект.ИсходныйНомер = Пакет.ИсходныйНомер;
	ЭтотОбъект.СсылкаЗаказа = Пакет.Ссылка;
	ЭтотОбъект.СохраненныйЗаказ = НайтиСохраненныйЗаказ(ЭтотОбъект.СсылкаЗаказа, ЭтотОбъект.НомерПоставщика, ЭтотОбъект.ИсходныйНомер);
	Если ЗначениеЗаполнено(ЭтотОбъект.СохраненныйЗаказ) Тогда Возврат; КонецЕсли;
	ЭтотОбъект.Контрагент = Пакет.Контрагент;
	ЭтотОбъект.Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
	ЭтотОбъект.Склад = Справочники.СтруктурныеЕдиницы.ОсновнойСклад;
	ФиксированныйСрокВозврата = АС_УсловияВозвратаПоставщикамСервер.ФиксированныйСрокВозврата(ЭтотОбъект.Контрагент);
	Для Каждого ДанныеСтроки Из Пакет.Строки Цикл
		Позиция = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(Позиция, ДанныеСтроки);
		Позиция.Наименование = ДанныеСтроки.НазваниеПоставщика;
		ПересчитатьСумму(Позиция);
		Если ФиксированныйСрокВозврата > 0 Тогда
			Позиция.Дней = ФиксированныйСрокВозврата;
		КонецЕсли;
	КонецЦикла;
	ПодобратьТовары(Таблица, ЭтотОбъект.Контрагент);
	Таблица.Сортировать("ТоварНайден УБЫВ, Номер");
	ЗначениеВРеквизитФормы(Таблица, "Строки");
	НастроитьЭлементы(ФиксированныйСрокВозврата);

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если ЗначениеЗаполнено(ЭтотОбъект.СохраненныйЗаказ) Тогда
		ОткрытьЗаказ(ЭтотОбъект.СохраненныйЗаказ);
		Возврат;
	КонецЕсли;
	ОбновитьИтог();
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЗаказ(Ссылка)
	ОповеститьОбИзменении(Ссылка);
	Закрыть();
	ОткрытьФорму("Документ.ЗаказПоставщику.Форма.ФормаДокумента", Новый Структура("Ключ", Ссылка));
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПрочитатьЗаказ(Текст)

	Если ТипЗнч(Текст) <> Тип("Строка") Или СтрДлина(Текст) > 3000000 Тогда
		ВызватьИсключение "Скопируйте тестовый заказ кнопкой «В 1С» в агрегаторе.";
	КонецЕсли;
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Текст);
		Данные = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();
	Исключение
		ВызватьИсключение "В буфере нет JSON заказа. Скопируйте заказ кнопкой «В 1С» в агрегаторе.";
	КонецПопытки;
	Если ТипЗнч(Данные) <> Тип("Структура") Или Не Данные.Свойство("format")
		Или Данные.format <> "aggregator.supplier-order" Тогда
		ВызватьИсключение "В буфере нет маркера заказа агрегатора. Скопируйте заказ кнопкой «В 1С».";
	КонецЕсли;
	Если Не Данные.Свойство("version") Или Данные.version <> 1
		Или Не Данные.Свойство("testOnly") Или Данные.testOnly <> Истина
		Или Не Данные.Свойство("currency") Или Данные.currency <> "RUB" Тогда
		ВызватьИсключение "Поддерживается тестовый заказ агрегатора версии 1 в рублях.";
	КонецЕсли;
	Если Не Данные.Свойство("counterpartyId") Или ТипЗнч(Данные.counterpartyId) <> Тип("Строка")
		Или СтрДлина(Данные.counterpartyId) <> 36 Тогда
		ВызватьИсключение "В пакете нет контрагента 1С. Выберите его в настройках поставщика и скопируйте заказ заново.";
	КонецЕсли;
	Если Не Данные.Свойство("id") Или ТипЗнч(Данные.id) <> Тип("Строка") Или СтрДлина(Данные.id) <> 36
		Или Не Данные.Свойство("number") Или ТипЗнч(Данные.number) <> Тип("Строка")
		Или Данные.number <> "TEST-" + ВРег(Лев(СтрЗаменить(Данные.id, "-", ""), 20))
		Или Не Данные.Свойство("supplier") Или ТипЗнч(Данные.supplier) <> Тип("Строка")
		Или Не Данные.Свойство("createdAt") Или Не Данные.Свойство("items")
		Или ТипЗнч(Данные.items) <> Тип("Массив") Или Данные.items.Количество() = 0 Или Данные.items.Количество() > 500 Тогда
		ВызватьИсключение "В JSON заказа отсутствуют обязательные данные или превышен лимит в 500 строк.";
	КонецЕсли;
	Попытка
		Идентификатор = Новый УникальныйИдентификатор(Данные.id);
		Контрагент = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(Данные.counterpartyId));
	Исключение
		ВызватьИсключение "Некорректный идентификатор тестового заказа.";
	КонецПопытки;
	Если Строка(Идентификатор) = "00000000-0000-0000-0000-000000000000" Тогда
		ВызватьИсключение "Некорректный идентификатор тестового заказа.";
	КонецЕсли;
	Имена = Новый Соответствие;
	Имена.Вставить("armtek", "Armtek");
	Имена.Вставить("autopiter", "Автопитер");
	Имена.Вставить("forum-auto", "Forum Auto");
	Имена.Вставить("part-kom", "PartKOM");
	Имена.Вставить("rossko", "Rossko");
	ИмяПоставщика = Имена.Получить(Данные.supplier);
	Если ИмяПоставщика = Неопределено Тогда
		ВызватьИсключение "В JSON указан неизвестный поставщик.";
	КонецЕсли;
	Если Не КонтрагентДоступен(Контрагент) Тогда
		ВызватьИсключение "Выбранный на сайте контрагент не найден среди поставщиков этой базы 1С. Проверьте настройки агрегатора.";
	КонецЕсли;
	СтрокиЗаказа = Новый Массив;
	Для Каждого Позиция Из Данные.items Цикл
		НомерСтроки = СтрокиЗаказа.Количество() + 1;
		Если ТипЗнч(Позиция) <> Тип("Структура") Или Не Позиция.Свойство("article")
			Или ТипЗнч(Позиция.article) <> Тип("Строка") Или ПустаяСтрока(Позиция.article) Или СтрДлина(Позиция.article) > 128
			Или Не Позиция.Свойство("brand") Или ТипЗнч(Позиция.brand) <> Тип("Строка")
			Или СтрДлина(Позиция.brand) > 128
			Или Не Позиция.Свойство("title") Или ТипЗнч(Позиция.title) <> Тип("Строка") Или СтрДлина(Позиция.title) > 4000
			Или Не Позиция.Свойство("quantity") Или ТипЗнч(Позиция.quantity) <> Тип("Число")
			Или Позиция.quantity <= 0 Или Позиция.quantity > 1000000 Или Окр(Позиция.quantity, 3) <> Позиция.quantity
			Или Не Позиция.Свойство("price")
			Или Не Позиция.Свойство("deliveryDate") Тогда
			ВызватьИсключение СтрШаблон("Некорректные данные товара в строке %1.", НомерСтроки);
		КонецЕсли;
		Цена = Позиция.price;
		Если Цена = Неопределено Или Цена = Null Тогда
			Цена = 0;
		ИначеЕсли ТипЗнч(Цена) <> Тип("Число") Или Цена < 0 Или Цена >= 1000000000000 Или Цена * Позиция.quantity >= 1000000000000 Тогда
			ВызватьИсключение СтрШаблон("Некорректная цена товара в строке %1.", НомерСтроки);
		КонецЕсли;
		Дней = Неопределено;
		Позиция.Свойство("returnDays", Дней);
		Если Дней = Неопределено Или Дней = Null Тогда
			Дней = 14;
		ИначеЕсли ТипЗнч(Дней) <> Тип("Число") Или Дней < 0 Или Дней > 9999 Или Цел(Дней) <> Дней Тогда
			ВызватьИсключение СтрШаблон("Некорректный срок возврата в строке %1.", НомерСтроки);
		КонецЕсли;
		Поставка = ?(Позиция.deliveryDate = Неопределено Или Позиция.deliveryDate = Null,
			Дата(1, 1, 1), ДатаИзПакета(Позиция.deliveryDate));
		СтрокиЗаказа.Добавить(Новый Структура("Номер,Артикул,БрендПоставщика,НазваниеПоставщика,Количество,Цена,Поставка,Дней",
			НомерСтроки, СокрЛП(Позиция.article), СокрЛП(Позиция.brand), СокрЛП(Позиция.title),
			Позиция.quantity, Окр(Цена, 2), Поставка, Дней));
	КонецЦикла;
	Если ТипЗнч(Данные.createdAt) = Тип("Строка") И СтрДлина(Данные.createdAt) = 24 Тогда
		ДатаИзПакета(Лев(Данные.createdAt, 10));
	ИначеЕсли Данные.createdAt <> Неопределено И Данные.createdAt <> Null Тогда
		ВызватьИсключение "Некорректная дата тестового заказа.";
	КонецЕсли;
	ИсходныйНомер = Данные.number;
	Если Данные.Свойство("sourceOrderNumber") Тогда
		Если ТипЗнч(Данные.sourceOrderNumber) <> Тип("Строка") Или ПустаяСтрока(Данные.sourceOrderNumber)
			Или СтрДлина(Данные.sourceOrderNumber) > 100 Тогда
			ВызватьИсключение "Некорректный номер исходного заказа.";
		КонецЕсли;
		ИсходныйНомер = Данные.sourceOrderNumber;
	КонецЕсли;
	Возврат Новый Структура("Ссылка,Номер,ИсходныйНомер,ИмяПоставщика,Контрагент,Строки",
		Документы.ЗаказПоставщику.ПолучитьСсылку(Идентификатор), Данные.number, ИсходныйНомер,
		ИмяПоставщика, Контрагент, СтрокиЗаказа);

КонецФункции

&НаСервереБезКонтекста
Функция ДатаИзПакета(Текст)
	Если ТипЗнч(Текст) <> Тип("Строка") Или СтрДлина(Текст) <> 10
		Или Сред(Текст, 5, 1) <> "-" Или Сред(Текст, 8, 1) <> "-" Тогда
		ВызватьИсключение "В заказе указана некорректная дата.";
	КонецЕсли;
	Попытка
		Возврат Дата(СтрЗаменить(Текст, "-", ""));
	Исключение
		ВызватьИсключение "В заказе указана некорректная дата.";
	КонецПопытки;
КонецФункции

&НаСервереБезКонтекста
Функция КонтрагентДоступен(Контрагент)
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ Ссылка
		|ИЗ Справочник.Контрагенты
		|ГДЕ НЕ ПометкаУдаления И НЕ ЭтоГруппа И Поставщик И Ссылка = &Контрагент");
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Возврат Не Запрос.Выполнить().Пустой();
КонецФункции

&НаСервереБезКонтекста
Функция НайтиСохраненныйЗаказ(Ссылка, Номер, ИсходныйНомер)
	Запрос = Новый Запрос("ВЫБРАТЬ Ссылка, НомерВходящегоДокумента, Комментарий
		|ИЗ Документ.ЗаказПоставщику ГДЕ Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда Возврат Документы.ЗаказПоставщику.ПустаяСсылка(); КонецЕсли;
	// Старые импорты также определяются по служебному входящему номеру.
	Если Выборка.Комментарий <> КомментарийИмпорта(ИсходныйНомер) И Выборка.НомерВходящегоДокумента <> Номер Тогда
		ВызватьИсключение "Этот идентификатор уже принадлежит другому заказу в 1С.";
	КонецЕсли;
	Возврат Выборка.Ссылка;
КонецФункции

&НаСервереБезКонтекста
Функция КомментарийИмпорта(ИсходныйНомер)
	Возврат "Тестовый заказ из агрегатора · номер поставщика " + ИсходныйНомер;
КонецФункции

&НаСервереБезКонтекста
Функция ТаблицаСтрокЗаказа()
	Таблица = Новый ТаблицаЗначений;
	Для Каждого Имя Из СтрРазделить("Наименование,Артикул,БрендПоставщика", ",") Цикл
		Таблица.Колонки.Добавить(Имя, Новый ОписаниеТипов("Строка"));
	КонецЦикла;
	Таблица.Колонки.Добавить("Номер", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Дней", Новый ОписаниеТипов("Число",
		Новый КвалификаторыЧисла(4, 0, ДопустимыйЗнак.Неотрицательный)));
	Таблица.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число",
		Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Неотрицательный)));
	ТипДенег = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Неотрицательный));
	Таблица.Колонки.Добавить("Цена", ТипДенег);
	Таблица.Колонки.Добавить("Сумма", ТипДенег);
	Таблица.Колонки.Добавить("ТоварНайден", Новый ОписаниеТипов("Булево"));
	ТипБренда = Новый ОписаниеТипов("СправочникСсылка.АС_БрендыТоваров");
	Таблица.Колонки.Добавить("БрендКарточки", ТипБренда);
	Таблица.Колонки.Добавить("БрендИзЗаказа", ТипБренда);
	Таблица.Колонки.Добавить("ТоварБезБренда", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("НуженВыбор", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("ЕстьКарточкиБезБренда", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("НужнаХарактеристика", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("Поставка", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	Таблица.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Таблица.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	Возврат Таблица;
КонецФункции

&НаСервереБезКонтекста
Функция КлючАртикула(Артикул)
	Возврат НРег(АС_НоменклатураСервер.КомпактныйКлючАртикула(Артикул));
КонецФункции

&НаСервереБезКонтекста
Процедура ПодобратьТовары(Таблица, Поставщик)
	ИндексБрендов = АС_НоменклатураСервер.ИндексНаименованийБрендов();
	Ключи = Новый Соответствие;
	БрендыСтрок = Новый Массив;
	// Карточки без бренда ищем даже при неизвестном бренде поставщика.
	БрендыСтрок.Добавить(Справочники.АС_БрендыТоваров.ПустаяСсылка());
	Для Каждого Позиция Из Таблица Цикл
		Бренд = АС_НоменклатураСервер.БрендПоНаименованию(Позиция.БрендПоставщика, ИндексБрендов);
		Если ЗначениеЗаполнено(Бренд) Тогда
			Позиция.БрендКарточки = Бренд;
			Позиция.БрендИзЗаказа = Бренд;
			Если БрендыСтрок.Найти(Бренд) = Неопределено Тогда
				БрендыСтрок.Добавить(Бренд);
			КонецЕсли;
		КонецЕсли;
		Позиция.Наименование = АС_НоменклатураСервер.НаименованиеТовараИзИмпорта(
			Позиция.Наименование, Позиция.Артикул, Позиция.БрендКарточки, Позиция.БрендПоставщика);
		Для Каждого Ключ Из АС_НоменклатураСервер.КомпактныеВариантыАртикула(Позиция.Артикул) Цикл
			Ключи.Вставить(Ключ, Истина);
		КонецЦикла;
	КонецЦикла;
	Если Ключи.Количество() = 0 Тогда Возврат; КонецЕсли;
	КлючиДляПоиска = Новый Массив;
	Для Каждого Пара Из Ключи Цикл
		КлючиДляПоиска.Добавить(Пара.Ключ);
	КонецЦикла;

	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ Товары.Ссылка КАК Товар, Товары.Артикул КАК Артикул,
		|Товары.АС_Бренд КАК Бренд, Товары.ЕдиницаИзмерения КАК Единица, Товары.Наименование КАК Наименование,
		|Товары.ИспользоватьХарактеристики КАК ЕстьХарактеристики,
		|ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК Характеристика, ЛОЖЬ КАК ОтПоставщика
		|ИЗ Справочник.Номенклатура КАК Товары
		|ГДЕ НЕ Товары.ПометкаУдаления И НЕ Товары.ЭтоГруппа
		|И Товары.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)
		|И Товары.АС_Бренд В (&Бренды)
		|И (Товары.АС_АртикулДляПоиска В (&Ключи)
		|	ИЛИ (Товары.АС_АртикулДляПоиска = """" И Товары.Артикул <> """"))
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ Сопоставления.Номенклатура, Сопоставления.Артикул, Сопоставления.Номенклатура.АС_Бренд,
		|Сопоставления.Номенклатура.ЕдиницаИзмерения, Сопоставления.Номенклатура.Наименование,
		|Сопоставления.Номенклатура.ИспользоватьХарактеристики,
		|Сопоставления.Характеристика, ИСТИНА
		|ИЗ Справочник.НоменклатураПоставщиков КАК Сопоставления
		|ГДЕ Сопоставления.Владелец = &Поставщик И НЕ Сопоставления.ПометкаУдаления
		|И Сопоставления.Артикул <> """" И НЕ Сопоставления.Номенклатура.ПометкаУдаления
		|И НЕ Сопоставления.Номенклатура.ЭтоГруппа
		|И Сопоставления.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)
		|И Сопоставления.Номенклатура.АС_Бренд В (&Бренды)");
	Запрос.УстановитьПараметр("Ключи", КлючиДляПоиска);
	Запрос.УстановитьПараметр("Поставщик", Поставщик);
	Запрос.УстановитьПараметр("Бренды", БрендыСтрок);
	Кандидаты = Запрос.Выполнить().Выгрузить();
	Кандидаты.Колонки.Добавить("Ключ");
	Кандидаты.Колонки.Добавить("КлючВАЗ");
	Для Каждого Кандидат Из Кандидаты Цикл
		Кандидат.Ключ = КлючАртикула(Кандидат.Артикул);
		Кандидат.КлючВАЗ = КлючАртикулаВАЗ(Кандидат.Артикул);
	КонецЦикла;
	Кандидаты.Индексы.Добавить("Ключ");
	Кандидаты.Индексы.Добавить("КлючВАЗ");

	Штука = Справочники.КлассификаторЕдиницИзмерения.шт;
	Для Каждого Позиция Из Таблица Цикл
		Ключ = КлючАртикула(Позиция.Артикул);
		Если ПустаяСтрока(Ключ) Тогда Продолжить; КонецЕсли;
		Совпадения = Кандидаты.НайтиСтроки(Новый Структура("Ключ", Ключ));
		КлючВАЗ = КлючАртикулаВАЗ(Позиция.Артикул);
		Если Не ПустаяСтрока(КлючВАЗ) Тогда
			Для Каждого Кандидат Из Кандидаты.НайтиСтроки(Новый Структура("КлючВАЗ", КлючВАЗ)) Цикл
				Если Кандидат.Ключ <> Ключ Тогда Совпадения.Добавить(Кандидат); КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		СвязиПоставщика = Новый Соответствие;
		ТочныеТовары = Новый Соответствие;
		ТоварыВАЗ = Новый Соответствие;
		ТоварыБезБренда = Новый Соответствие;
		Для Каждого Кандидат Из Совпадения Цикл
			Если Не ЗначениеЗаполнено(Кандидат.Бренд) Тогда
				Если Не Кандидат.ОтПоставщика Тогда
					ТоварыБезБренда.Вставить(Кандидат.Товар, Кандидат);
				КонецЕсли;
			ИначеЕсли Кандидат.Бренд <> Позиция.БрендИзЗаказа Тогда
				Продолжить;
			ИначеЕсли Кандидат.ОтПоставщика Тогда
				КлючСвязи = Строка(Кандидат.Товар.УникальныйИдентификатор()) + "/"
					+ Строка(Кандидат.Характеристика.УникальныйИдентификатор());
				СвязиПоставщика.Вставить(КлючСвязи, Кандидат);
			ИначеЕсли Кандидат.Ключ = Ключ Тогда
				ТочныеТовары.Вставить(Кандидат.Товар, Кандидат);
			Иначе
				ТоварыВАЗ.Вставить(Кандидат.Товар, Кандидат);
			КонецЕсли;
		КонецЦикла;
		Варианты = СвязиПоставщика;
		Если Варианты.Количество() = 0 Тогда Варианты = ТочныеТовары; КонецЕсли;
		Если Варианты.Количество() = 0 Тогда Варианты = ТоварыВАЗ; КонецЕсли;
		Если Варианты.Количество() = 0 Тогда
			Варианты = ТоварыБезБренда;
			Позиция.ЕстьКарточкиБезБренда = Варианты.Количество() > 0;
		КонецЕсли;
		Если Варианты.Количество() = 0 Тогда Продолжить; КонецЕсли;
		Позиция.НуженВыбор = Истина;
		Если Варианты.Количество() <> 1 Тогда Продолжить; КонецЕсли;
		Для Каждого Пара Из Варианты Цикл
			Кандидат = Пара.Значение;
		КонецЦикла;
		// Количество из агрегатора указано в штуках. Иную единицу подтверждают выбором товара.
		Если Кандидат.Единица <> Штука Тогда Продолжить; КонецЕсли;
		Позиция.Номенклатура = Кандидат.Товар;
		Позиция.Наименование = Кандидат.Наименование;
		Позиция.Характеристика = Кандидат.Характеристика;
		Позиция.НужнаХарактеристика = Кандидат.ЕстьХарактеристики;
		Позиция.ТоварБезБренда = Не ЗначениеЗаполнено(Кандидат.Бренд);
		Позиция.НуженВыбор = Позиция.ТоварБезБренда;
		Позиция.ТоварНайден = Не Позиция.НуженВыбор;
	КонецЦикла;
КонецПроцедуры

&НаСервереБезКонтекста
Функция КлючАртикулаВАЗ(Артикул)
	Ключ = АС_НоменклатураСервер.КлючВзаимозаменяемостиАртикула(Артикул);
	Возврат ?(Лев(Ключ, 5) = "LADA:", Ключ, "");
КонецФункции

&НаСервереБезКонтекста
Функция АртикулыСовпадают(АртикулЗаказа, АртикулКарточки)
	Ключ = КлючАртикула(АртикулЗаказа);
	Если ПустаяСтрока(Ключ) Тогда Возврат Ложь; КонецЕсли;
	Если Ключ = КлючАртикула(АртикулКарточки) Тогда Возврат Истина; КонецЕсли;
	КлючВАЗ = КлючАртикулаВАЗ(АртикулЗаказа);
	Возврат Не ПустаяСтрока(КлючВАЗ) И КлючВАЗ = КлючАртикулаВАЗ(АртикулКарточки);
КонецФункции

&НаСервере
Процедура НастроитьРеквизиты(Таблица)
	Реквизиты = Новый Массив;
	Типы = Новый Структура;
	Типы.Вставить("Строки", "ТаблицаЗначений");
	Типы.Вставить("СсылкаЗаказа", "ДокументСсылка.ЗаказПоставщику");
	Типы.Вставить("СохраненныйЗаказ", "ДокументСсылка.ЗаказПоставщику");
	Типы.Вставить("Организация", "СправочникСсылка.Организации");
	Типы.Вставить("Контрагент", "СправочникСсылка.Контрагенты");
	Типы.Вставить("Склад", "СправочникСсылка.СтруктурныеЕдиницы");
	Типы.Вставить("ЗаказПокупателя", "ДокументСсылка.ЗаказПокупателя");
	Для Каждого Имя Из СтрРазделить("НомерПоставщика,ИсходныйНомер,Итог,ПредупреждениеПодбора", ",") Цикл
		Типы.Вставить(Имя, "Строка");
	КонецЦикла;
	Для Каждого Поле Из Типы Цикл
		Реквизиты.Добавить(Новый РеквизитФормы(Поле.Ключ, Новый ОписаниеТипов(Поле.Значение)));
	КонецЦикла;
	Для Каждого Колонка Из Таблица.Колонки Цикл
		Реквизиты.Добавить(Новый РеквизитФормы(Колонка.Имя, Колонка.ТипЗначения, "Строки"));
	КонецЦикла;
	ИзменитьРеквизиты(Реквизиты);
КонецПроцедуры

&НаСервере
Процедура НастроитьЭлементы(ФиксированныйСрокВозврата)
	Шапка = ДобавитьГруппу("РеквизитыЗаказа", "Реквизиты заказа");
	ДобавитьПоле("Организация", "Организация", Шапка);
	ПолеПоставщика = ДобавитьПоле("Контрагент", "Контрагент", Шапка);
	ПолеПоставщика.ТолькоПросмотр = Истина;
	ДобавитьПоле("Склад", "Склад", Шапка);
	ПолеЗаказа = ДобавитьПоле("ЗаказПокупателя", "Заказ покупателя", Шапка);
	ПолеЗаказа.КнопкаВыбора = Истина;
	ПолеЗаказа.КнопкаСоздания = Ложь;
	ПолеЗаказа.КнопкаОчистки = Истина;
	ПараметрыПоляЗаказа = Новый Массив;
	ПараметрыПоляЗаказа.Добавить(Новый ПараметрВыбора("АС_ВыборВидаПриСоздании", Истина));
	ПолеЗаказа.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыПоляЗаказа);
	ПолеЗаказа.ПодсказкаВвода = "Введите госномер автомобиля";
	ПолеЗаказа.УстановитьДействие("НачалоВыбора", "ЗаказПокупателяНачалоВыбора");
	ПолеЗаказа.УстановитьДействие("АвтоПодбор", "ЗаказПокупателяАвтоПодбор");
	ПолеЗаказа.УстановитьДействие("ОкончаниеВводаТекста", "ЗаказПокупателяОкончаниеВводаТекста");
	ДобавитьПоле("Итог", "", Неопределено, ВидПоляФормы.ПолеНадписи);
	ДобавитьПоле("ПредупреждениеПодбора", "", Неопределено, ВидПоляФормы.ПолеНадписи);

	Список = Элементы.Добавить("Позиции", Тип("ТаблицаФормы"));
	Список.ПутьКДанным = "Строки";
	Список.ИзменятьСоставСтрок = Ложь;
	Список.Высота = 12;
	Список.РастягиватьПоГоризонтали = Истина;
	Колонки = Новый Структура("Наименование,Артикул,Цена,Количество,Сумма,Поставка,Дней",
		"Наименование", "Артикул", "Цена", "Количество", "Сумма", "Поставка", "Дней на возврат");
	Оформление = УсловноеОформление.Элементы.Добавить();
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(Оформление.Отбор, "Строки.ТоварНайден", Истина);
	РаботаСФормой.ДобавитьЭлементУсловногоОформления(Оформление, "ЦветФона", Новый Цвет(232, 248, 237));
	ОформлениеПроверки = УсловноеОформление.Элементы.Добавить();
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(ОформлениеПроверки.Отбор, "Строки.НуженВыбор", Истина);
	РаботаСФормой.ДобавитьЭлементУсловногоОформления(ОформлениеПроверки, "ЦветФона", Новый Цвет(255, 242, 205));
	Действия = Новый Структура("Наименование,Цена,Количество,Сумма",
		"НаименованиеПриИзменении", "ЦенаПриИзменении", "КоличествоИлиСуммаПриИзменении",
		"КоличествоИлиСуммаПриИзменении");
	Для Каждого Колонка Из Колонки Цикл
		Поле = Элементы.Добавить("Позиции" + Колонка.Ключ, Тип("ПолеФормы"), Список);
		Поле.Вид = ВидПоляФормы.ПолеВвода;
		Поле.ПутьКДанным = "Строки." + Колонка.Ключ;
		Поле.Заголовок = Колонка.Значение;
		Поле.ТолькоПросмотр = Колонка.Ключ = "Артикул"
			Или (Колонка.Ключ = "Дней" И ФиксированныйСрокВозврата > 0);
		Если Не Поле.ТолькоПросмотр Тогда
			Поле.РежимРедактирования = РежимРедактированияКолонки.ВходПриВводе;
		КонецЕсли;
		ИмяДействия = "";
		Если Действия.Свойство(Колонка.Ключ, ИмяДействия) Тогда
			Поле.УстановитьДействие("ПриИзменении", ИмяДействия);
		КонецЕсли;
		РаботаСФормой.ДобавитьОформляемоеПоле(Оформление, Поле.Имя);
		РаботаСФормой.ДобавитьОформляемоеПоле(ОформлениеПроверки, Поле.Имя);
	КонецЦикла;
	ПолеТовара = Элементы.ПозицииНаименование;
	ПолеТовара.КнопкаВыбора = Истина;
	ПолеТовара.УстановитьДействие("НачалоВыбора", "ТоварНачалоВыбора");
	ПолеТовара.УстановитьДействие("АвтоПодбор", "ТоварАвтоПодбор");
	ПолеТовара.УстановитьДействие("ОбработкаВыбора", "ТоварОбработкаВыбора");
	ПолеТовара.Подсказка = "Введите название нового товара или выберите карточку в 1С.";
	ДобавитьКнопку("ПереименоватьТовар", "Переименовать", Список.КонтекстноеМеню);
	ДобавитьКнопку("ПрименитьБрендИзЗаказа", "Использовать бренд из заказа", Список.КонтекстноеМеню);
	Элементы.ПрименитьБрендИзЗаказа.Видимость = Ложь;
	ДобавитьКнопку("ВыбратьХарактеристику", "Выбрать характеристику", Список.КонтекстноеМеню);
	Элементы.ВыбратьХарактеристику.Видимость = Ложь;
	ДобавитьКнопку("АС_ПродолжитьИмпорт", "Продолжить", Неопределено);
КонецПроцедуры

&НаСервере
Функция ДобавитьГруппу(Имя, Заголовок)
	Группа = Элементы.Добавить(Имя, Тип("ГруппаФормы"));
	Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	Группа.Заголовок = Заголовок;
	Возврат Группа;
КонецФункции

&НаСервере
Функция ДобавитьПоле(Имя, Заголовок, Родитель, Вид = Неопределено)
	Поле = Элементы.Добавить(Имя, Тип("ПолеФормы"), Родитель);
	Поле.Вид = ?(Вид = Неопределено, ВидПоляФормы.ПолеВвода, Вид);
	Поле.ПутьКДанным = Имя;
	Поле.Заголовок = Заголовок;
	Возврат Поле;
КонецФункции

&НаСервере
Процедура ДобавитьКнопку(Имя, Заголовок, Родитель)
	Команда = Команды.Добавить(Имя);
	Команда.Заголовок = Заголовок;
	Команда.Действие = Имя;
	Кнопка = Элементы.Добавить(Имя, Тип("КнопкаФормы"), Родитель);
	Кнопка.ИмяКоманды = Имя;
КонецПроцедуры

&НаКлиенте
Процедура ЗаказПокупателяНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Настройки = Новый НастройкиКомпоновкиДанных;
	ЗавершенныеСостояния = Новый Массив;
	ЗавершенныеСостояния.Добавить(ПредопределенноеЗначение("Справочник.СостоянияЗаказовПокупателей.Завершен"));
	ЗавершенныеСостояния.Добавить(ПредопределенноеЗначение("Справочник.СостоянияЗаказНарядов.Завершен"));
	Для Каждого Состояние Из ЗавершенныеСостояния Цикл
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(Настройки.Отбор, "СостояниеЗаказа",
			ВидСравненияКомпоновкиДанных.НеРавно, Состояние, , Истина,
			РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	КонецЦикла;
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(Настройки.Отбор, "ПометкаУдаления",
		ВидСравненияКомпоновкиДанных.Равно, Ложь, , Истина,
		РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(Настройки.Отбор, "ВидОперации",
		ВидСравненияКомпоновкиДанных.ВСписке, ВидыПодбираемыхЗаказов(), , Истина,
		РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	ПараметрыВыбора = Новый Структура("ФиксированныеНастройки,РежимВыбора,МножественныйВыбор,ЗакрыватьПриВыборе",
		Настройки, Истина, Ложь, Истина);
	ПараметрыВыбора.Вставить("АС_ВыборВидаПриСоздании", Истина);
	СтандартнаяОбработка = Ложь;
	ОткрытьФорму("Документ.ЗаказПокупателя.Форма.ФормаВыбора", ПараметрыВыбора, Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ЗаказПокупателяАвтоПодбор(
	Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	Если ПустаяСтрока(СокрЛП(Текст)) Тогда Возврат; КонецЕсли;
	ДанныеВыбора = НайтиЗаказыПокупателей(Текст);
	СтандартнаяОбработка = Ложь;
	Ожидание = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ЗаказПокупателяОкончаниеВводаТекста(
	Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	Если ПустаяСтрока(СокрЛП(Текст)) Тогда Возврат; КонецЕсли;
	ДанныеВыбора = НайтиЗаказыПокупателей(Текст);
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ВидыПодбираемыхЗаказов()
	ВидыЗаказов = Новый СписокЗначений;
	ВидыЗаказов.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаПродажу"));
	ВидыЗаказов.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаПереработку"));
	ВидыЗаказов.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаряд"));
	Возврат ВидыЗаказов;
КонецФункции

&НаСервереБезКонтекста
Функция НайтиЗаказыПокупателей(Текст)
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 50
		|Открытые.Заказ КАК Заказ, Открытые.Покупатель КАК Покупатель, Открытые.ГосНомер КАК ГосНомер
		|ИЗ (ВЫБРАТЬ Заказы.Ссылка КАК Заказ, Заказы.Дата КАК Дата,
		|	ЕСТЬNULL(Заказы.Контрагент.Наименование, """") КАК Покупатель,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(Заказы.Договор.АС_ГосНомерАвтомобиля, """") <> """"
		|			ТОГДА Заказы.Договор.АС_ГосНомерАвтомобиля
		|		ИНАЧЕ ЕСТЬNULL(Заказы.Контрагент.АС_ГосНомерАвтомобиля, """")
		|	КОНЕЦ КАК ГосНомер
		|	ИЗ Документ.ЗаказПокупателя КАК Заказы
		|	ГДЕ НЕ Заказы.ПометкаУдаления И Заказы.ВидОперации В (&ВидыЗаказов)
		|	И Заказы.СостояниеЗаказа <> ЗНАЧЕНИЕ(Справочник.СостоянияЗаказовПокупателей.Завершен)
		|	И Заказы.СостояниеЗаказа <> ЗНАЧЕНИЕ(Справочник.СостоянияЗаказНарядов.Завершен)) КАК Открытые
		|ГДЕ Открытые.ГосНомер ПОДОБНО &Текст СПЕЦСИМВОЛ ""~""
		|ИЛИ (Открытые.ГосНомер = """" И Открытые.Покупатель ПОДОБНО &Текст СПЕЦСИМВОЛ ""~"")
		|УПОРЯДОЧИТЬ ПО Открытые.Дата УБЫВ");
	Запрос.УстановитьПараметр("ВидыЗаказов", ВидыПодбираемыхЗаказов());
	Запрос.УстановитьПараметр("Текст", "%" + ОбщегоНазначения.СформироватьСтрокуДляПоискаВЗапросе(СокрЛП(Текст)) + "%");
	Список = Новый СписокЗначений;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Представление = Строка(Выборка.Заказ) + " · " + Выборка.Покупатель;
		Если Не ПустаяСтрока(Выборка.ГосНомер) И СтрНайти(ВРег(Представление), ВРег(Выборка.ГосНомер)) = 0 Тогда
			Представление = Представление + " · " + Выборка.ГосНомер;
		КонецЕсли;
		Список.Добавить(Выборка.Заказ, Представление);
	КонецЦикла;
	Возврат Список;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьСумму(Позиция)
	Сумма = Окр(Позиция.Цена * Позиция.Количество, 2);
	Позиция.Сумма = ?(Сумма < 10000000000000, Сумма, 0);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция СтрокаГотова(Позиция)
	Если Позиция.НуженВыбор Тогда Возврат Ложь; КонецЕсли;
	Если ЗначениеЗаполнено(Позиция.Номенклатура) Тогда
		ТоварГотов = Позиция.ТоварНайден
			И (Не Позиция.НужнаХарактеристика Или ЗначениеЗаполнено(Позиция.Характеристика));
	Иначе
		ТоварГотов = Не ПустаяСтрока(СокрЛП(Позиция.Наименование)) И СтрДлина(Позиция.Наименование) <= 100
			И СтрДлина(Позиция.Артикул) <= 50;
	КонецЕсли;
	Возврат ТоварГотов И Позиция.Цена > 0 И Позиция.Количество > 0 И Позиция.Количество <= 1000000
		И Позиция.Сумма > 0;
КонецФункции

&НаКлиенте
Процедура ОбновитьИтог()
	Всего = ЭтотОбъект.Строки.Количество();
	Готово = 0;
	СуммаЗаказа = 0;
	НужнаХарактеристика = Ложь;
	ЕстьТоварыБезБренда = Ложь;
	НужноНазначитьБренд = Ложь;
	НужноВыбратьКарточку = Ложь;
	Для Каждого Позиция Из ЭтотОбъект.Строки Цикл
		Если СтрокаГотова(Позиция) Тогда Готово = Готово + 1; КонецЕсли;
		СуммаЗаказа = СуммаЗаказа + Позиция.Сумма;
		НужнаХарактеристика = НужнаХарактеристика Или Позиция.НужнаХарактеристика;
		ЕстьТоварыБезБренда = ЕстьТоварыБезБренда Или Позиция.ТоварБезБренда;
		НужноНазначитьБренд = НужноНазначитьБренд
			Или Позиция.НуженВыбор И (Позиция.ТоварБезБренда Или Позиция.ЕстьКарточкиБезБренда);
		НужноВыбратьКарточку = НужноВыбратьКарточку
			Или Позиция.НуженВыбор И Не Позиция.ТоварБезБренда;
	КонецЦикла;
	Элементы.ВыбратьХарактеристику.Видимость = НужнаХарактеристика;
	Элементы.ПрименитьБрендИзЗаказа.Видимость = ЕстьТоварыБезБренда;
	Подсказки = Новый Массив;
	Если НужноВыбратьКарточку Тогда
		Подсказки.Добавить("В отмеченных строках выберите карточку в колонке «Наименование».");
	КонецЕсли;
	Если НужноНазначитьБренд Тогда
		Подсказки.Добавить("Найдены карточки без бренда. В меню строки выберите существующий бренд через «Переименовать» "
			+ "или нажмите «Использовать бренд из заказа», чтобы подставить или создать его.");
	КонецЕсли;
	ЭтотОбъект.ПредупреждениеПодбора = СтрСоединить(Подсказки, " ");
	Элементы.ПредупреждениеПодбора.Видимость = Подсказки.Количество() > 0;
	ЭтотОбъект.Итог = СтрШаблон("Итого %1 ₽ · Готово %2 из %3", Формат(СуммаЗаказа, "ЧДЦ=2"), Готово, Всего);
	Элементы.АС_ПродолжитьИмпорт.Доступность = Всего > 0 И Готово = Всего;
КонецПроцедуры

&НаКлиенте
Процедура НаименованиеПриИзменении(Элемент)
	Позиция = Элементы.Позиции.ТекущиеДанные;
	Если Позиция = Неопределено Тогда Возврат; КонецЕсли;
	Если ЗначениеЗаполнено(Позиция.Номенклатура) Тогда
		Позиция.Наименование = НаименованиеКарточки(Позиция.Номенклатура);
	Иначе
		Позиция.Наименование = АС_НоменклатураСервер.НаименованиеТовараИзИмпорта(
			Позиция.Наименование, Позиция.Артикул, Позиция.БрендКарточки, Позиция.БрендПоставщика);
	КонецЕсли;
	ОбновитьИтог();
КонецПроцедуры

&НаСервереБезКонтекста
Функция НаименованиеКарточки(Товар)
	Возврат Товар.Наименование;
КонецФункции

&НаКлиенте
Процедура ТоварНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Отбор = Новый Структура("ТипНоменклатуры,ПометкаУдаления",
		ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Запас"), Ложь);
	ПараметрыВыбора = Новый Структура("Отбор,ВыборГруппИЭлементов,РежимВыбора,ЗакрыватьПриВыборе",
		Отбор, ИспользованиеГруппИЭлементов.Элементы, Истина, Истина);
	СтандартнаяОбработка = Ложь;
	ОткрытьФорму("Справочник.Номенклатура.ФормаВыбора", ПараметрыВыбора, Элемент,
		, , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ТоварАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	Если ПустаяСтрока(СокрЛП(Текст)) Тогда Возврат; КонецЕсли;
	ДанныеВыбора = НайтиКарточки(СокрЛП(Текст));
	Ожидание = Ложь;
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаСервереБезКонтекста
Функция НайтиКарточки(Текст)
	Отбор = Новый Структура("ТипНоменклатуры,ЭтоГруппа,ПометкаУдаления",
		Перечисления.ТипыНоменклатуры.Запас, Ложь, Ложь);
	ПараметрыВыбора = Новый Структура("СтрокаПоиска,Отбор", Текст, Отбор);
	Возврат Справочники.Номенклатура.ПолучитьДанныеВыбора(ПараметрыВыбора);
КонецФункции

&НаКлиенте
Процедура ТоварОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Товар = ВыбранноеЗначение;
	Если ТипЗнч(Товар) = Тип("ЭлементСпискаЗначений") Тогда Товар = Товар.Значение; КонецЕсли;
	Если ТипЗнч(Товар) <> Тип("СправочникСсылка.Номенклатура") Тогда Возврат; КонецЕсли;
	СтандартнаяОбработка = Ложь;
	Позиция = Элементы.Позиции.ТекущиеДанные;
	Если Позиция = Неопределено Или Позиция.Номенклатура = Товар И Не Позиция.НуженВыбор Тогда Возврат; КонецЕсли;
	ДанныеТовара = ПолучитьДанныеКарточки(Товар, Позиция.Артикул, Позиция.БрендИзЗаказа);
	Если Не ПустаяСтрока(ДанныеТовара.Ошибка) Тогда
		Сообщить(ДанныеТовара.Ошибка);
		Возврат;
	КонецЕсли;
	Позиция.Номенклатура = Товар;
	Позиция.Наименование = ДанныеТовара.Наименование;
	Позиция.Характеристика = ПредопределенноеЗначение("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка");
	Позиция.ТоварБезБренда = ДанныеТовара.БезБренда;
	Позиция.НуженВыбор = ДанныеТовара.БезБренда;
	Позиция.ТоварНайден = Не Позиция.НуженВыбор;
	Позиция.НужнаХарактеристика = ДанныеТовара.НужнаХарактеристика;
	Позиция.БрендКарточки = Позиция.БрендИзЗаказа;
	ОбновитьИтог();
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеКарточки(Товар, Артикул, БрендИзЗаказа)
	Ошибка = ПроверитьКарточкуТовара(Товар);
	Если Не ПустаяСтрока(Ошибка) Тогда
		Возврат Новый Структура("Ошибка", Ошибка);
	КонецЕсли;
	БрендТовара = Товар.АС_Бренд;
	БезБренда = Не ЗначениеЗаполнено(БрендТовара);
	Если БезБренда И Не АртикулыСовпадают(Артикул, Товар.Артикул) Тогда
		Возврат Новый Структура("Ошибка", "Выберите карточку без бренда с тем же артикулом или его вариантом ВАЗ.");
	КонецЕсли;
	Если Не БезБренда И (БрендТовара <> БрендИзЗаказа Или БрендТовара.ПометкаУдаления) Тогда
		Возврат Новый Структура("Ошибка", "У этой карточки другой бренд. Выберите товар с брендом из заказа.");
	КонецЕсли;
	Возврат Новый Структура("Ошибка,Наименование,НужнаХарактеристика,БезБренда",
		"", Товар.Наименование, Товар.ИспользоватьХарактеристики, БезБренда);
КонецФункции

&НаКлиенте
Процедура ПрименитьБрендИзЗаказа(Команда)
	Позиция = Элементы.Позиции.ТекущиеДанные;
	Если Позиция = Неопределено Или Не Позиция.ТоварБезБренда Тогда Возврат; КонецЕсли;
	Если ПустаяСтрока(СокрЛП(Позиция.БрендПоставщика)) Тогда
		Сообщить("Поставщик не указал бренд. Выберите его через «Переименовать».");
		Возврат;
	КонецЕсли;
	Позиция.БрендКарточки = Позиция.БрендИзЗаказа;
	Позиция.НуженВыбор = Ложь;
	Позиция.ТоварНайден = Истина;
	ОбновитьИтог();
КонецПроцедуры

&НаКлиенте
Процедура ПереименоватьТовар(Команда)
	Позиция = Элементы.Позиции.ТекущиеДанные;
	Если Позиция = Неопределено Тогда Возврат; КонецЕсли;
	Если Позиция.НуженВыбор И Не ЗначениеЗаполнено(Позиция.Номенклатура) Тогда
		Сообщить("Сначала выберите карточку товара в колонке «Наименование».");
		Возврат;
	КонецЕсли;
	Если Позиция.ТоварБезБренда Тогда
		Бренд = ?(Позиция.НуженВыбор, ПредопределенноеЗначение("Справочник.АС_БрендыТоваров.ПустаяСсылка"),
			Позиция.БрендКарточки);
		Данные = Новый Структура("Наименование,Артикул,Бренд", Позиция.Наименование, Позиция.Артикул, Бренд);
		ПараметрыФормы = Новый Структура("ДанныеТовара,НазначениеБренда", Данные, Истина);
	ИначеЕсли ЗначениеЗаполнено(Позиция.Номенклатура) Тогда
		ПараметрыФормы = Новый Структура("Товар", Позиция.Номенклатура);
	Иначе
		Данные = Новый Структура("Наименование,Артикул,Бренд", Позиция.Наименование, Позиция.Артикул, Позиция.БрендКарточки);
		ПараметрыФормы = Новый Структура("ДанныеТовара", Данные);
	КонецЕсли;
	ПараметрыФормы.Вставить("БрендДляИмпорта", Позиция.БрендИзЗаказа);
	Оповещение = Новый ОписаниеОповещения("ПереименованиеЗавершено", ЭтотОбъект, Позиция.Номер);
	АС_БезопасноеОбновлениеКлиент.ОткрытьБлокирующийДиалогОдинРаз(
		СостояниеДиалога, ЭтотОбъект, "ОбщаяФорма.АС_ПереименованиеНоменклатуры", ПараметрыФормы, Оповещение);
КонецПроцедуры

&НаКлиенте
Процедура ПереименованиеЗавершено(Результат, НомерСтроки) Экспорт
	СостояниеДиалога.БлокирующийДиалогОткрыт = Ложь;
	Если ТипЗнч(Результат) = Тип("СправочникСсылка.Номенклатура") Тогда
		ИмяКарточки = НаименованиеКарточки(Результат);
		Для Каждого Позиция Из ЭтотОбъект.Строки Цикл
			Если Позиция.Номенклатура <> Результат Тогда Продолжить; КонецЕсли;
			Позиция.Наименование = ИмяКарточки;
			ДанныеТовара = ПолучитьДанныеКарточки(Результат, Позиция.Артикул, Позиция.БрендИзЗаказа);
			Если Не ПустаяСтрока(ДанныеТовара.Ошибка) Тогда
				Позиция.НуженВыбор = Истина;
				Позиция.ТоварНайден = Ложь;
				Сообщить(ДанныеТовара.Ошибка);
			Иначе
				Позиция.ТоварБезБренда = ДанныеТовара.БезБренда;
				Позиция.НуженВыбор = ДанныеТовара.БезБренда;
				Позиция.ТоварНайден = Не Позиция.НуженВыбор;
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(Результат) = Тип("Структура") Тогда
		Для Каждого Позиция Из ЭтотОбъект.Строки Цикл
			Если Позиция.Номер <> НомерСтроки Тогда Продолжить; КонецЕсли;
			Если ЗначениеЗаполнено(Позиция.БрендИзЗаказа) И ЗначениеЗаполнено(Результат.Бренд)
				И Результат.Бренд <> Позиция.БрендИзЗаказа Тогда
				Сообщить(СтрШаблон("В заказе указан бренд «%1». Выберите этот бренд.", Позиция.БрендПоставщика));
				Прервать;
			КонецЕсли;
			Если Позиция.ТоварБезБренда Тогда
				Позиция.БрендКарточки = Результат.Бренд;
				Позиция.НуженВыбор = Не ЗначениеЗаполнено(Результат.Бренд);
				Позиция.ТоварНайден = Не Позиция.НуженВыбор;
				Прервать;
			КонецЕсли;
			Позиция.Наименование = АС_НоменклатураСервер.НаименованиеТовараИзИмпорта(
				Результат.Наименование, Результат.Артикул, Результат.Бренд, Позиция.БрендПоставщика, Позиция.БрендКарточки);
			Позиция.Артикул = Результат.Артикул;
			Позиция.БрендКарточки = Результат.Бренд;
			Прервать;
		КонецЦикла;
	КонецЕсли;
	ОбновитьИтог();
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьХарактеристику(Команда)
	Позиция = Элементы.Позиции.ТекущиеДанные;
	Если Позиция = Неопределено Или Не Позиция.НужнаХарактеристика Тогда Возврат; КонецЕсли;
	Характеристики = ХарактеристикиТовара(Позиция.Номенклатура);
	Если Характеристики.Количество() = 0 Тогда
		Сообщить("У товара нет доступных характеристик.");
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ХарактеристикаВыбрана", ЭтотОбъект, Позиция.Номер);
	ПоказатьВыборИзСписка(Оповещение, Характеристики, Элементы.ПозицииНаименование);
КонецПроцедуры

&НаСервереБезКонтекста
Функция ХарактеристикиТовара(Товар)
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ Ссылка, Наименование
		|ИЗ Справочник.ХарактеристикиНоменклатуры
		|ГДЕ НЕ ПометкаУдаления И (Владелец = &Товар ИЛИ Владелец = &Категория)
		|УПОРЯДОЧИТЬ ПО Наименование");
	Запрос.УстановитьПараметр("Товар", Товар);
	Запрос.УстановитьПараметр("Категория", Товар.КатегорияНоменклатуры);
	Список = Новый СписокЗначений;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Список.Добавить(Выборка.Ссылка, Выборка.Наименование);
	КонецЦикла;
	Возврат Список;
КонецФункции

&НаКлиенте
Процедура ХарактеристикаВыбрана(Результат, НомерСтроки) Экспорт
	Если Результат = Неопределено Тогда Возврат; КонецЕсли;
	Для Каждого Позиция Из ЭтотОбъект.Строки Цикл
		Если Позиция.Номер <> НомерСтроки Тогда Продолжить; КонецЕсли;
		Ошибка = ПроверитьВыборТовара(Позиция.Номенклатура, Результат.Значение);
		Если Не ПустаяСтрока(Ошибка) Тогда
			Сообщить(Ошибка);
			Возврат;
		КонецЕсли;
		Позиция.Характеристика = Результат.Значение;
		Прервать;
	КонецЦикла;
	ОбновитьИтог();
КонецПроцедуры

&НаКлиенте
Процедура ЦенаПриИзменении(Элемент)
	ПересчитатьСумму(Элементы.Позиции.ТекущиеДанные);
	ОбновитьИтог();
КонецПроцедуры

&НаКлиенте
Процедура КоличествоИлиСуммаПриИзменении(Элемент)
	Позиция = Элементы.Позиции.ТекущиеДанные;
	Цена = ?(Позиция.Количество > 0, Окр(Позиция.Сумма / Позиция.Количество, 2), 0);
	Позиция.Цена = ?(Цена < 10000000000000, Цена, 0);
	ОбновитьИтог();
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьКарточкуТовара(Товар)
	Если Не ЗначениеЗаполнено(Товар) Или Товар.ПометкаУдаления Или Товар.ЭтоГруппа
		Или Товар.ТипНоменклатуры <> Перечисления.ТипыНоменклатуры.Запас Тогда
		Возврат "Выберите действующую карточку товара в 1С.";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Товар.ЕдиницаИзмерения) Тогда
		Возврат "В выбранной карточке товара не заполнена единица измерения.";
	КонецЕсли;
	Возврат "";
КонецФункции

&НаСервереБезКонтекста
Функция ПроверитьВыборТовара(Товар, Характеристика)
	Ошибка = ПроверитьКарточкуТовара(Товар);
	Если Не ПустаяСтрока(Ошибка) Тогда Возврат Ошибка; КонецЕсли;
	Если Товар.ИспользоватьХарактеристики И Не ЗначениеЗаполнено(Характеристика) Тогда
		Возврат "Выберите характеристику товара.";
	КонецЕсли;
	Если ЗначениеЗаполнено(Характеристика) И (Характеристика.ПометкаУдаления
		Или Не Товар.ИспользоватьХарактеристики
		Или (Характеристика.Владелец <> Товар И Характеристика.Владелец <> Товар.КатегорияНоменклатуры)) Тогда
		Возврат "Выбранная характеристика не относится к этому товару.";
	КонецЕсли;
	Возврат "";
КонецФункции

&НаКлиенте
Процедура АС_ПродолжитьИмпорт(Команда)
	Элементы.АС_ПродолжитьИмпорт.Доступность = Ложь;
	Попытка
		Ссылка = СохранитьЗаказНаСервере();
	Исключение
		Сообщить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ОбновитьИтог();
		Возврат;
	КонецПопытки;
	ОткрытьЗаказ(Ссылка);
КонецПроцедуры

&НаСервере
Функция СохранитьЗаказНаСервере()
	Таблица = РеквизитФормыВЗначение("Строки");
	Если Таблица.Количество() = 0 Тогда
		ВызватьИсключение "В заказе нет товаров.";
	КонецЕсли;
	Для Каждого Позиция Из Таблица Цикл
		Если Не СтрокаГотова(Позиция) Тогда
			ВызватьИсключение СтрШаблон("Проверьте товар, цену и количество в строке %1.", Позиция.Номер);
		КонецЕсли;
	КонецЦикла;
	Таблица.Сортировать("Номер");
	Заказ = ПодготовитьШапкуЗаказа();
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("Документ.ЗаказПоставщику");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Ссылка", ЭтотОбъект.СсылкаЗаказа);
		Блокировка.Заблокировать();
		Ссылка = НайтиСохраненныйЗаказ(ЭтотОбъект.СсылкаЗаказа, ЭтотОбъект.НомерПоставщика, ЭтотОбъект.ИсходныйНомер);
		Если Не ЗначениеЗаполнено(Ссылка) Тогда
			Заказ.УстановитьСсылкуНового(ЭтотОбъект.СсылкаЗаказа);
			ЗаполнитьТоварыЗаказа(Заказ, Таблица);
			Заказ.Записать(РежимЗаписиДокумента.Запись);
			Ссылка = Заказ.Ссылка;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Ссылка;
КонецФункции

&НаСервере
Функция ПодготовитьШапкуЗаказа()
	Контрагент = ЭтотОбъект.Контрагент;
	Организация = ЭтотОбъект.Организация;
	Склад = ЭтотОбъект.Склад;
	ЗаказПокупателя = ЭтотОбъект.ЗаказПокупателя;
	Если ЗначениеЗаполнено(ЗаказПокупателя)
		И (ЗаказПокупателя.ПометкаУдаления
			Или ЗаказПокупателя.СостояниеЗаказа = Справочники.СостоянияЗаказовПокупателей.Завершен
			Или ЗаказПокупателя.СостояниеЗаказа = Справочники.СостоянияЗаказНарядов.Завершен
			Или ВидыПодбираемыхЗаказов().НайтиПоЗначению(ЗаказПокупателя.ВидОперации) = Неопределено) Тогда
		ВызватьИсключение "Выберите незавершённый заказ покупателя или заказ-наряд.";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Контрагент) Или Не Контрагент.Поставщик Или Контрагент.ПометкаУдаления
		Или Не ЗначениеЗаполнено(Организация) Или Организация.ПометкаУдаления
		Или Не ЗначениеЗаполнено(Склад) Или Склад.ПометкаУдаления
		Или Склад.ТипСтруктурнойЕдиницы <> Перечисления.ТипыСтруктурныхЕдиниц.Склад Тогда
		ВызватьИсключение "Выберите действующие организацию, контрагента-поставщика и склад.";
	КонецЕсли;
	Договор = ОсновнойДоговорПоставщика(Контрагент, Организация);
	Если Контрагент.ВестиРасчетыПоДоговорам И Не ЗначениеЗаполнено(Договор) Тогда
		ВызватьИсключение "У поставщика не настроен основной договор для выбранной организации.";
	КонецЕсли;
	Рубль = Справочники.Валюты.НайтиПоКоду("643");
	Если Не ЗначениеЗаполнено(Рубль) Тогда ВызватьИсключение "В справочнике валют отсутствует рубль (643)."; КонецЕсли;
	Заказ = Документы.ЗаказПоставщику.СоздатьДокумент();
	ВидОперации = Перечисления.ВидыОперацийЗаказПоставщику.ЗаказНаЗакупку;
	Если ЗначениеЗаполнено(Договор) Тогда
		Заказ.Заполнить(Договор);
		Если ЗначениеЗаполнено(Заказ.ВалютаДокумента) И Заказ.ВалютаДокумента <> Рубль Тогда
			ВызватьИсключение "Основной договор поставщика должен быть с расчётами в рублях.";
		КонецЕсли;
	Иначе
		Заказ.Заполнить(Новый Структура("Контрагент,Организация,ВидОперации", Контрагент, Организация, ВидОперации));
	КонецЕсли;
	Заказ.Дата = ТекущаяДатаСеанса();
	Заказ.ВидОперации = ВидОперации;
	Заказ.Контрагент = Контрагент;
	Заказ.Договор = Договор;
	Заказ.Организация = Организация;
	Заказ.СтруктурнаяЕдиница = Склад;
	Заказ.СтруктурнаяЕдиницаРезерв = Склад;
	Заказ.ПоложениеСклада = Перечисления.ПоложениеРеквизитаНаФорме.ВШапке;
	Заказ.ПоложениеДатыПоступления = Перечисления.ПоложениеРеквизитаНаФорме.ВТабличнойЧасти;
	Заказ.ПоложениеЗаказаПокупателя = Перечисления.ПоложениеРеквизитаНаФорме.ВШапке;
	Заказ.ЗаказПокупателя = ЗаказПокупателя;
	Заказ.ВалютаДокумента = Рубль;
	Заказ.Курс = 1;
	Заказ.Кратность = 1;
	Заказ.СуммаВключаетНДС = Истина;
	Заказ.Комментарий = КомментарийИмпорта(ЭтотОбъект.ИсходныйНомер);
	Заказ.ЗапланироватьОплату = Ложь;
	Заказ.РезервироватьДенежныеСредства = Ложь;
	Заказ.РегистрироватьЦеныПоставщика = Ложь;
	Возврат Заказ;
КонецФункции

&НаСервереБезКонтекста
Функция ОсновнойДоговорПоставщика(Контрагент, Организация)
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|Основные.Договор КАК Договор,
		|ВЫБОР КОГДА Основные.Организация = &Организация ТОГДА 0 ИНАЧЕ 1 КОНЕЦ КАК ПриоритетОрганизации,
		|ВЫБОР КОГДА Основные.Договор.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.СПоставщиком)
		|	ТОГДА 0 ИНАЧЕ 1 КОНЕЦ КАК ПриоритетВида
		|ИЗ РегистрСведений.ОсновныеДоговорыКонтрагента КАК Основные
		|ГДЕ Основные.Контрагент = &Контрагент
		|И Основные.Договор.Владелец = &Контрагент И НЕ Основные.Договор.ПометкаУдаления
		|И Основные.Договор.ВидДоговора В (
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.СПоставщиком),
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.СКомитентом),
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.ПустаяСсылка))
		|И (Основные.Организация = &Организация
		|	ИЛИ Основные.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
		|И (Основные.Договор.Организация = &Организация
		|	ИЛИ Основные.Договор.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
		|УПОРЯДОЧИТЬ ПО ПриоритетОрганизации, ПриоритетВида, Основные.Договор");
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Организация", Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда Возврат Выборка.Договор; КонецЕсли;
	Возврат Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаполнитьТоварыЗаказа(Заказ, Таблица)
	ИндексБрендов = Неопределено;
	Для Каждого Позиция Из Таблица Цикл
		Если (Не ЗначениеЗаполнено(Позиция.Номенклатура) Или Позиция.ТоварБезБренда)
			И Не ЗначениеЗаполнено(Позиция.БрендКарточки) Тогда
			// Два импорта с одним новым брендом должны использовать одну запись справочника.
			БлокировкаБрендов = Новый БлокировкаДанных;
			ЭлементБлокировки = БлокировкаБрендов.Добавить("Справочник.АС_БрендыТоваров");
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			БлокировкаБрендов.Заблокировать();
			ИндексБрендов = АС_НоменклатураСервер.ИндексНаименованийБрендов();
			Прервать;
		КонецЕсли;
	КонецЦикла;
	НовыеТовары = Новый Соответствие;
	Для Каждого Позиция Из Таблица Цикл
		Товар = Позиция.Номенклатура;
		Если Не ЗначениеЗаполнено(Товар) Тогда
			Товар = СоздатьТоварДляСтроки(Позиция, НовыеТовары, ИндексБрендов);
		ИначеЕсли Позиция.ТоварБезБренда Тогда
			НазначитьБрендКарточке(Товар, Позиция, ИндексБрендов);
		ИначеЕсли Не ЗначениеЗаполнено(Товар.АС_Бренд) Или Товар.АС_Бренд.ПометкаУдаления
			Или Товар.АС_Бренд <> Позиция.БрендИзЗаказа Тогда
			ВызватьИсключение СтрШаблон("У карточки в строке %1 изменился бренд. Выберите товар заново.", Позиция.Номер);
		КонецЕсли;
		Ошибка = ПроверитьВыборТовара(Товар, Позиция.Характеристика);
		Если Не ПустаяСтрока(Ошибка) Тогда
			ВызватьИсключение СтрШаблон("Проверьте товар в строке %1. %2", Позиция.Номер, Ошибка);
		КонецЕсли;
		СтрокаЗаказа = Заказ.Запасы.Добавить();
		СтрокаЗаказа.Номенклатура = Товар;
		СтрокаЗаказа.Характеристика = Позиция.Характеристика;
		СтрокаЗаказа.ЕдиницаИзмерения = Товар.ЕдиницаИзмерения;
		СтрокаЗаказа.Количество = Позиция.Количество;
		СтрокаЗаказа.Цена = Позиция.Цена;
		СтрокаЗаказа.Сумма = Позиция.Сумма;
		СтрокаЗаказа.ДатаПоступления = Позиция.Поставка;
		СтрокаЗаказа.СтруктурнаяЕдиницаРезерв = Заказ.СтруктурнаяЕдиницаРезерв;
		СтрокаЗаказа.ЗаказПокупателя = Заказ.ЗаказПокупателя;
		СтрокаЗаказа.АС_КоличествоДнейНаВозврат = Позиция.Дней;
	КонецЦикла;
	НоменклатураВДокументахСервер.ОбновитьСтавкуНДСТабличнойЧасти(Заказ, "Запасы", Ложь,
		Заказ.Организация.ВидСтавкиНДСПоУмолчанию);
КонецПроцедуры

&НаСервереБезКонтекста
Функция СоздатьТоварДляСтроки(Позиция, НовыеТовары, ИндексБрендов)
	Если Не ПравоДоступа("Добавление", Метаданные.Справочники.Номенклатура) Тогда
		ВызватьИсключение "У вас нет права создавать карточки номенклатуры.";
	КонецЕсли;
	Ключ = АС_НоменклатураСервер.КлючВзаимозаменяемостиАртикула(Позиция.Артикул);
	Если ПустаяСтрока(Ключ) Тогда
		ВызватьИсключение СтрШаблон("Укажите артикул нового товара в строке %1 через «Переименовать».", Позиция.Номер);
	КонецЕсли;
	Бренд = ОпределитьБрендСтроки(Позиция, ИндексБрендов);
	Наименование = Позиция.Наименование;
	Если Бренд <> Позиция.БрендКарточки Тогда
		Наименование = АС_НоменклатураСервер.НаименованиеТовараИзИмпорта(
			Наименование, Позиция.Артикул, Бренд, Позиция.БрендПоставщика);
	КонецЕсли;
	Ключ = Строка(Бренд.УникальныйИдентификатор()) + "/" + Ключ;
	НовыйТовар = НовыеТовары.Получить(Ключ);
	Если НовыйТовар <> Неопределено Тогда
		Если НовыйТовар.ИмяВведено <> Наименование Тогда
			ВызватьИсключение СтрШаблон("В строке %1 тот же артикул и бренд указаны с другим наименованием.", Позиция.Номер);
		КонецЕсли;
		Возврат НовыйТовар.Ссылка;
	КонецЕсли;
	Карточка = Справочники.Номенклатура.СоздатьЭлемент();
	Карточка.Заполнить(Новый Структура("ТипНоменклатуры,Наименование,НаименованиеПолное,Артикул,ЕдиницаИзмерения",
		Перечисления.ТипыНоменклатуры.Запас, Наименование, Наименование, Позиция.Артикул,
		Справочники.КлассификаторЕдиницИзмерения.шт));
	Карточка.АС_Бренд = Бренд;
	Карточка.Записать();
	НовыеТовары.Вставить(Ключ, Новый Структура("Ссылка,ИмяВведено", Карточка.Ссылка, Наименование));
	Возврат Карточка.Ссылка;
КонецФункции

&НаСервереБезКонтекста
Функция ОпределитьБрендСтроки(Позиция, ИндексБрендов)
	Бренд = Позиция.БрендКарточки;
	Если Не ЗначениеЗаполнено(Бренд) Тогда
		Бренд = НайтиИлиСоздатьБренд(Позиция, ИндексБрендов);
	ИначеЕсли Бренд.ПометкаУдаления Тогда
		ВызватьИсключение СтрШаблон("Бренд в строке %1 помечен на удаление. Выберите бренд через «Переименовать».", Позиция.Номер);
	КонецЕсли;
	Если ЗначениеЗаполнено(Позиция.БрендИзЗаказа) И Бренд <> Позиция.БрендИзЗаказа Тогда
		ВызватьИсключение СтрШаблон("В строке %1 выбран бренд, который отличается от бренда заказа.", Позиция.Номер);
	КонецЕсли;
	Возврат Бренд;
КонецФункции

&НаСервереБезКонтекста
Процедура НазначитьБрендКарточке(Товар, Позиция, ИндексБрендов)
	Бренд = ОпределитьБрендСтроки(Позиция, ИндексБрендов);
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("Справочник.Номенклатура");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("Ссылка", Товар);
	Блокировка.Заблокировать();
	Карточка = Товар.ПолучитьОбъект();
	Если Карточка = Неопределено Или Карточка.ПометкаУдаления Или Карточка.ЭтоГруппа
		Или Карточка.ТипНоменклатуры <> Перечисления.ТипыНоменклатуры.Запас
		Или Не АртикулыСовпадают(Позиция.Артикул, Карточка.Артикул) Тогда
		ВызватьИсключение СтрШаблон("Карточка без бренда в строке %1 изменилась. Выберите товар заново.", Позиция.Номер);
	КонецЕсли;
	Если Карточка.АС_Бренд = Бренд Тогда Возврат; КонецЕсли;
	Если ЗначениеЗаполнено(Карточка.АС_Бренд) Тогда
		ВызватьИсключение СтрШаблон("Карточке в строке %1 уже назначен другой бренд.", Позиция.Номер);
	КонецЕсли;
	Если Не ПравоДоступа("Изменение", Метаданные.Справочники.Номенклатура) Тогда
		ВызватьИсключение СтрШаблон("У вас нет права изменить бренд карточки в строке %1.", Позиция.Номер);
	КонецЕсли;
	Карточка.АС_Бренд = Бренд;
	Карточка.Записать();
КонецПроцедуры

&НаСервереБезКонтекста
Функция НайтиИлиСоздатьБренд(Позиция, ИндексБрендов)
	ИмяБренда = Позиция.БрендПоставщика;
	КлючБренда = КлючАртикула(ИмяБренда);
	Если ПустаяСтрока(КлючБренда) Тогда
		ВызватьИсключение СтрШаблон("Укажите бренд в строке %1 через «Переименовать».", Позиция.Номер);
	КонецЕсли;
	Бренд = АС_НоменклатураСервер.БрендПоНаименованию(ИмяБренда, ИндексБрендов);
	Если Бренд = Null Тогда
		ВызватьИсключение СтрШаблон(
			"Для бренда «%1» в строке %2 найдено несколько совпадений. Выберите бренд через «Переименовать».",
			ИмяБренда, Позиция.Номер);
	КонецЕсли;
	Если ЗначениеЗаполнено(Бренд) Тогда Возврат Бренд; КонецЕсли;
	Если СтрДлина(ИмяБренда) > Метаданные.Справочники.АС_БрендыТоваров.ДлинаНаименования Тогда
		ВызватьИсключение СтрШаблон("Слишком длинное имя бренда в строке %1. Выберите бренд через «Переименовать».", Позиция.Номер);
	КонецЕсли;
	Если Не ПравоДоступа("Добавление", Метаданные.Справочники.АС_БрендыТоваров) Тогда
		ВызватьИсключение СтрШаблон("Нет права создать бренд «%1» из строки %2.", ИмяБренда, Позиция.Номер);
	КонецЕсли;
	КарточкаБренда = Справочники.АС_БрендыТоваров.СоздатьЭлемент();
	КарточкаБренда.АС_УсловноИспользоватьОбработчик = Ложь;
	КарточкаБренда.Наименование = ИмяБренда;
	КарточкаБренда.Записать();
	ИндексБрендов.ОсновныеИмена.Вставить(КлючБренда, КарточкаБренда.Ссылка);
	Возврат КарточкаБренда.Ссылка;
КонецФункции
