&После("ПриНачалеРаботыСистемы")
Процедура АС_АгрегаторПриНачалеРаботыСистемы()

	// Серверная база обрабатывает очередь независимо от открытых клиентов.
	// Таймер нужен только для локального тестирования файловой базы.
	Если Не АС_АгрегаторСервер.ИспользоватьКлиентскийТаймерОбмена() Тогда Возврат; КонецЕсли;
	ПодключитьОбработчикОжидания("АС_АгрегаторПроверитьОчередь", 60);
	ПодключитьОбработчикОжидания("АС_АгрегаторОтправитьОчередь", 10);
	АС_АгрегаторПроверитьОчередь();

КонецПроцедуры

Процедура АС_АгрегаторПроверитьОчередь() Экспорт

	Попытка
		АС_АгрегаторСервер.ЗапуститьОтправку();
	Исключение
		// Потеря связи сеанса с 1С не должна мешать работе пользователя.
		// Очередь хранится в базе; следующий тик снова попробует запустить обработку.
		Возврат;
	КонецПопытки;

КонецПроцедуры

Процедура АС_АгрегаторОтправитьОчередь() Экспорт

	Попытка
		// Только запуск фонового задания: HTTP не задерживает запись формы.
		РезультатЗапуска = "";
		АС_АгрегаторСервер.ЗапуститьОтправку(РезультатЗапуска, Истина);
	Исключение
		// Документ уже записан, очередь сохранена; повторим через 10 секунд.
		Возврат;
	КонецПопытки;

КонецПроцедуры
