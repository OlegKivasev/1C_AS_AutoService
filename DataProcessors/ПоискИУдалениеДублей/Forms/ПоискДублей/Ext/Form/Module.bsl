&НаСервере
&После("ПриСозданииНаСервере")
Процедура АС_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)

	ТипКоличества = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3));
	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
		"АС_ОстатокСУчетомЗаказов", ТипКоличества, "НайденныеДубли", "С учётом заказов"));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
		"АС_Артикул", Метаданные.Справочники.Номенклатура.Реквизиты.Артикул.Тип, "НайденныеДубли", "Артикул"));
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);

	Колонка = Элементы.Добавить(
		"АС_ОстатокСУчетомЗаказов", Тип("ПолеФормы"), Элементы.НайденныеДубли);
	Колонка.Вид = ВидПоляФормы.ПолеВвода;
	Колонка.ПутьКДанным = "НайденныеДубли.АС_ОстатокСУчетомЗаказов";
	Колонка.Заголовок = "С учётом заказов";
	Колонка.Подсказка = "Физический остаток на всех складах за вычетом незакрытой потребности заказов покупателей и заказ-нарядов";
	Колонка.ТолькоПросмотр = Истина;
	Колонка.Ширина = 14;
	Колонка.Формат = "ЧН=0; ЧДЦ=3";
	Колонка.Видимость = ОбластьПоискаДублей = "Справочник.Номенклатура";
	Элементы.Переместить(Колонка, Элементы.НайденныеДубли, Элементы.НайденныеДублиКоличество);

	КолонкаАртикула = Элементы.Добавить(
		"АС_Артикул", Тип("ПолеФормы"), Элементы.НайденныеДубли);
	КолонкаАртикула.Вид = ВидПоляФормы.ПолеВвода;
	КолонкаАртикула.ПутьКДанным = "НайденныеДубли.АС_Артикул";
	КолонкаАртикула.Заголовок = "Артикул";
	КолонкаАртикула.Подсказка = "Исходный артикул карточки номенклатуры";
	КолонкаАртикула.ТолькоПросмотр = Истина;
	КолонкаАртикула.Ширина = 20;
	КолонкаАртикула.Видимость = ОбластьПоискаДублей = "Справочник.Номенклатура";
	Элементы.Переместить(КолонкаАртикула, Элементы.НайденныеДубли, Элементы.АС_ОстатокСУчетомЗаказов);

КонецПроцедуры

&НаСервере
&Вместо("ЗаполнитьРезультатыПоискаДублей")
Функция АС_ЗаполнитьРезультатыПоискаДублей(Знач АдресРезультата)

	ВсегоНайденоДублей = ПродолжитьВызов(АдресРезультата);
	ЭтоНоменклатура = ОбластьПоискаДублей = "Справочник.Номенклатура";
	Элементы.АС_ОстатокСУчетомЗаказов.Видимость = ЭтоНоменклатура;
	Элементы.АС_Артикул.Видимость = ЭтоНоменклатура;
	Если Не ЭтоНоменклатура Или ВсегоНайденоДублей = 0 Тогда
		Возврат ВсегоНайденоДублей;
	КонецЕсли;

	ДеревоДублей = РеквизитФормыВЗначение("НайденныеДубли");
	СписокНоменклатуры = Новый Массив;
	Для Каждого ГруппаДублей Из ДеревоДублей.Строки Цикл
		Для Каждого Кандидат Из ГруппаДублей.Строки Цикл
			СписокНоменклатуры.Добавить(Кандидат.Ссылка);
		КонецЦикла;
	КонецЦикла;
	Если СписокНоменклатуры.Количество() = 0 Тогда
		Возврат ВсегоНайденоДублей;
	КонецЕсли;

	ДанныеНоменклатуры = АС_ПолучитьДанныеНоменклатуры(СписокНоменклатуры);
	Для Каждого ГруппаДублей Из ДеревоДублей.Строки Цикл
		ДоступныйОригинал = Неопределено;
		Для Каждого Кандидат Из ГруппаДублей.Строки Цикл
			ДанныеКандидата = ДанныеНоменклатуры.Получить(Кандидат.Ссылка);
			Кандидат.АС_Артикул = ?(ДанныеКандидата = Неопределено, "", ДанныеКандидата.Артикул);
			Кандидат.АС_ОстатокСУчетомЗаказов = ?(ДанныеКандидата = Неопределено, 0, ДанныеКандидата.Остаток);
			Если Кандидат.Основной Тогда
				ГруппаДублей.АС_Артикул = Кандидат.АС_Артикул;
			КонецЕсли;
			// При равном использовании сохраняем штатный оригинал, если он доступен.
			Если Кандидат.Основной И Кандидат.АС_ОстатокСУчетомЗаказов > 0 Тогда
				ДоступныйОригинал = Кандидат;
			КонецЕсли;
		КонецЦикла;

		Для Каждого Кандидат Из ГруппаДублей.Строки Цикл
			Если Кандидат.АС_ОстатокСУчетомЗаказов <= 0 Тогда
				Продолжить;
			КонецЕсли;
			Если ДоступныйОригинал = Неопределено Тогда
				ДоступныйОригинал = Кандидат;
			ИначеЕсли Кандидат.Количество > ДоступныйОригинал.Количество Тогда
				ДоступныйОригинал = Кандидат;
			КонецЕсли;
		КонецЦикла;

		// Без доступных товаров штатный выбор и пометки остаются прежними.
		Если ДоступныйОригинал = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Кандидат Из ГруппаДублей.Строки Цикл
			Кандидат.Основной = Кандидат.Ссылка = ДоступныйОригинал.Ссылка;
		КонецЦикла;
		ДоступныйОригинал.Пометка = 1;
		ГруппаДублей.АС_Артикул = ДоступныйОригинал.АС_Артикул;
		ГруппаДублей.Пометка = 0;
		Для Каждого Кандидат Из ГруппаДублей.Строки Цикл
			Если Не Кандидат.Основной И Кандидат.Пометка > 0 Тогда
				ГруппаДублей.Пометка = 1;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		ГруппаДублей.Наименование = ДоступныйОригинал.Наименование + " (" + ГруппаДублей.Количество + ")";
	КонецЦикла;
	ЗначениеВРеквизитФормы(ДеревоДублей, "НайденныеДубли");

	Возврат ВсегоНайденоДублей;

КонецФункции

&НаСервереБезКонтекста
Функция АС_ПолучитьДанныеНоменклатуры(СписокНоменклатуры)

	// Сначала суммируем каждый регистр отдельно, чтобы соединение не умножало остатки.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Номенклатура", СписокНоменклатуры);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|    ЗапасыОстатки.Номенклатура КАК Номенклатура,
	|    СУММА(ЗапасыОстатки.КоличествоОстаток) КАК Количество
	|ПОМЕСТИТЬ АС_ФизическиеОстатки
	|ИЗ
	|    РегистрНакопления.Запасы.Остатки(
	|            ,
	|            Номенклатура В (&Номенклатура)
	|                И ТИПЗНАЧЕНИЯ(СтруктурнаяЕдиница) = ТИП(Справочник.СтруктурныеЕдиницы)) КАК ЗапасыОстатки
	|СГРУППИРОВАТЬ ПО
	|    ЗапасыОстатки.Номенклатура
	|;
	|
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|    ЗаказыПокупателейОстатки.Номенклатура КАК Номенклатура,
	|    СУММА(ЗаказыПокупателейОстатки.КоличествоОстаток) КАК Количество
	|ПОМЕСТИТЬ АС_АктивныеЗаказыДублей
	|ИЗ
	|    РегистрНакопления.ЗаказыПокупателей.Остатки(
	|            ,
	|            Номенклатура В (&Номенклатура)) КАК ЗаказыПокупателейОстатки
	|ГДЕ
	|    ЗаказыПокупателейОстатки.КоличествоОстаток > 0
	|СГРУППИРОВАТЬ ПО
	|    ЗаказыПокупателейОстатки.Номенклатура
	|;
	|
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|    СправочникНоменклатура.Ссылка КАК Номенклатура,
	|    СправочникНоменклатура.Артикул КАК Артикул,
	|    ВЫБОР
	|        КОГДА ЕСТЬNULL(Остатки.Количество, 0) - ЕСТЬNULL(Заказы.Количество, 0) > 0
	|            ТОГДА ЕСТЬNULL(Остатки.Количество, 0) - ЕСТЬNULL(Заказы.Количество, 0)
	|        ИНАЧЕ 0
	|    КОНЕЦ КАК Остаток
	|ИЗ
	|    Справочник.Номенклатура КАК СправочникНоменклатура
	|        ЛЕВОЕ СОЕДИНЕНИЕ АС_ФизическиеОстатки КАК Остатки
	|        ПО СправочникНоменклатура.Ссылка = Остатки.Номенклатура
	|        ЛЕВОЕ СОЕДИНЕНИЕ АС_АктивныеЗаказыДублей КАК Заказы
	|        ПО СправочникНоменклатура.Ссылка = Заказы.Номенклатура
	|ГДЕ
	|    СправочникНоменклатура.Ссылка В (&Номенклатура)";

	ДанныеНоменклатуры = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДанныеНоменклатуры.Вставить(Выборка.Номенклатура,
			Новый Структура("Артикул, Остаток", Выборка.Артикул, Выборка.Остаток));
	КонецЦикла;
	Возврат ДанныеНоменклатуры;

КонецФункции

&НаКлиенте
&После("ОтметитьЭлементКакОригинал")
Процедура АС_ОбновитьАртикулОригинала(Знач ДанныеСтроки, Знач Родитель)

	Если ОбластьПоискаДублей = "Справочник.Номенклатура" Тогда
		Родитель.АС_Артикул = ДанныеСтроки.АС_Артикул;
	КонецЕсли;

КонецПроцедуры

&НаСервере
&После("ИнициализироватьКомпоновщикОтбораИПравила")
Процедура АС_ДополнитьПравилаСравнениемАртикула(Знач НастройкиФормы)

	Если ОбластьПоискаДублей <> "Справочник.Номенклатура" Тогда
		Возврат;
	КонецЕсли;

	НовоеПравило = "РавноБезСимволов";
	ПредставлениеПравила = НСтр("ru = 'Совпадает без символов'");
	Если ВсеВариантыСравнения.НайтиПоЗначению(НовоеПравило) = Неопределено Тогда
		ВсеВариантыСравнения.Добавить(НовоеПравило, ПредставлениеПравила);
	КонецЕсли;

	ТаблицаПравил = РеквизитФормыВЗначение("ПравилаПоиска");
	ПравилоАртикула = ТаблицаПравил.Найти("Артикул", "Реквизит");
	Если ПравилоАртикула = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ПравилоАртикула.ВариантыСравнения.НайтиПоЗначению(НовоеПравило) = Неопределено Тогда
		ПравилоАртикула.ВариантыСравнения.Добавить(НовоеПравило, ПредставлениеПравила);
	КонецЕсли;

	// Штатное восстановление выполнено до добавления нового варианта.
	СохраненныеПравила = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиФормы, "ПравилаПоиска");
	Если ТипЗнч(СохраненныеПравила) = Тип("ТаблицаЗначений") Тогда
		СохраненныйАртикул = СохраненныеПравила.Найти("Артикул", "Реквизит");
		Если СохраненныйАртикул <> Неопределено И СохраненныйАртикул.Правило = НовоеПравило Тогда
			ПравилоАртикула.Правило = НовоеПравило;
		КонецЕсли;
	КонецЕсли;
	ЗначениеВРеквизитФормы(ТаблицаПравил, "ПравилаПоиска");

КонецПроцедуры

&НаКлиенте
&После("ПриАктивацииШагаМастера")
Процедура АС_ПоказатьПравилоАртикулаБезСимволов()

	Если ОбластьПоискаДублей <> "Справочник.Номенклатура"
		Или Элементы.ШагиМастера.ТекущаяСтраница <> Элементы.ШагПоискНеВыполнялся Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Правило Из ПравилаПоиска Цикл
		Если Правило.Реквизит <> "Артикул" Или Правило.Правило <> "РавноБезСимволов" Тогда
			Продолжить;
		КонецЕсли;
		Союз = " " + НСтр("ru = 'И'") + " ";
		ОстальныеПравила = ПредставлениеПравилПоиска;
		ПустыеПравила = НСтр("ru = 'Правила не заданы'");
		Если Лев(ОстальныеПравила, СтрДлина(ПустыеПравила)) = ПустыеПравила Тогда
			ОстальныеПравила = Сред(ОстальныеПравила, СтрДлина(ПустыеПравила) + 1);
			Если Лев(ОстальныеПравила, СтрДлина(Союз)) = Союз Тогда
				ОстальныеПравила = Сред(ОстальныеПравила, СтрДлина(Союз) + 1);
			КонецЕсли;
		КонецЕсли;
		ПредставлениеПравилПоиска = Правило.ПредставлениеРеквизита + " "
			+ НСтр("ru = 'совпадает без символов'")
			+ ?(ПустаяСтрока(ОстальныеПравила), "", Союз + ОстальныеПравила);
		Прервать;
	КонецЦикла;

КонецПроцедуры
