Перем АС_КонтекстСравненияАртикулов;

&Вместо("ГруппыДублей")
Функция АС_ГруппыДублей(Знач ПараметрыПоиска, Знач ЭталонныйОбъект = Неопределено)

	ПредыдущийКонтекст = АС_КонтекстСравненияАртикулов;
	АС_КонтекстСравненияАртикулов = Неопределено;
	Попытка
		Если АС_СравниватьАртикулыБезСимволов(ПараметрыПоиска) Тогда
			АС_КонтекстСравненияАртикулов = Новый Структура("ВариантыАртикулов, СхемаКД, ОтборАртикула",
				АС_ВариантыАртикуловБезСимволов(), Неопределено, Неопределено);
		КонецЕсли;
		Результат = ПродолжитьВызов(ПараметрыПоиска, ЭталонныйОбъект);
	Исключение
		АС_КонтекстСравненияАртикулов = ПредыдущийКонтекст;
		ВызватьИсключение;
	КонецПопытки;
	АС_КонтекстСравненияАртикулов = ПредыдущийКонтекст;
	Возврат Результат;

КонецФункции

&Вместо("ТекстЗапросаПоискаДублей")
Функция АС_ТекстЗапросаПоискаДублей(ПараметрыПоиска, Характеристики, ИменаДополнительныхПолей)

	Если Не АС_СравниватьАртикулыБезСимволов(ПараметрыПоиска) Тогда
		Возврат ПродолжитьВызов(ПараметрыПоиска, Характеристики, ИменаДополнительныхПолей);
	КонецЕсли;

	// Равенство сохраняет исходный артикул в колонках результатов.
	// В отборе кандидатов оно ниже заменяется списком нормализованных вариантов.
	ПараметрыЗапроса = Новый Структура;
	Для Каждого Свойство Из ПараметрыПоиска Цикл
		ПараметрыЗапроса.Вставить(Свойство.Ключ, Свойство.Значение);
	КонецЦикла;
	ПравилаЗапроса = ПараметрыПоиска.ПравилаПоиска.Скопировать();
	Для Каждого Правило Из ПравилаЗапроса Цикл
		Если Правило.Реквизит = "Артикул" И Правило.Правило = "РавноБезСимволов" Тогда
			Правило.Правило = "Равно";
		КонецЕсли;
	КонецЦикла;
	ПараметрыЗапроса.Вставить("ПравилаПоиска", ПравилаЗапроса);
	Возврат ПродолжитьВызов(ПараметрыЗапроса, Характеристики, ИменаДополнительныхПолей);

КонецФункции

&Вместо("СхемаКомпоновкиДанныхПоискаДублей")
Функция АС_СхемаКомпоновкиДанныхПоискаДублей(ПараметрыПоиска, Характеристики, СтруктураЗапроса, ЭталонныйОбъект)

	Результат = ПродолжитьВызов(ПараметрыПоиска, Характеристики, СтруктураЗапроса, ЭталонныйОбъект);
	Если АС_КонтекстСравненияАртикулов <> Неопределено
		И АС_СравниватьАртикулыБезСимволов(ПараметрыПоиска) Тогда
		ОтборАртикула = Результат.ОтборыКандидатов.Получить("Артикул");
		ОтборАртикула.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		АС_КонтекстСравненияАртикулов.СхемаКД = Результат.СхемаКД;
		АС_КонтекстСравненияАртикулов.ОтборАртикула = ОтборАртикула;
	КонецЕсли;
	Возврат Результат;

КонецФункции

&Вместо("ИнициализироватьВыборкуКД")
Функция АС_ИнициализироватьВыборкуКД(СхемаКД, НастройкиКД)

	Если АС_КонтекстСравненияАртикулов <> Неопределено
		И АС_КонтекстСравненияАртикулов.СхемаКД = СхемаКД Тогда
		// Штатный цикл перед каждой выборкой записывает сюда сырой артикул эталона.
		ОтборАртикула = АС_КонтекстСравненияАртикулов.ОтборАртикула;
		КлючАртикула = АС_КлючАртикулаБезСимволов(ОтборАртикула.ПравоеЗначение);
		ВариантыАртикула = АС_КонтекстСравненияАртикулов.ВариантыАртикулов.Получить(КлючАртикула);
		Если ВариантыАртикула = Неопределено Тогда
			ВариантыАртикула = Новый Массив;
		КонецЕсли;
		ОтборАртикула.ПравоеЗначение = ВариантыАртикула;
	КонецЕсли;
	Возврат ПродолжитьВызов(СхемаКД, НастройкиКД);

КонецФункции

Функция АС_СравниватьАртикулыБезСимволов(ПараметрыПоиска)

	Если ПараметрыПоиска.ОбластьПоискаДублей <> "Справочник.Номенклатура" Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Правило Из ПараметрыПоиска.ПравилаПоиска Цикл
		Если Правило.Реквизит = "Артикул" И Правило.Правило = "РавноБезСимволов" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция АС_ВариантыАртикуловБезСимволов()

	// Ключ строится при каждом поиске: старые карточки не требуется перезаписывать.
	// Предварительный отбор и остальные правила применяются штатной СКД.
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		| Номенклатура.Артикул КАК Артикул
		|ИЗ Справочник.Номенклатура КАК Номенклатура
		|ГДЕ НЕ Номенклатура.ЭтоГруппа");
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		КлючАртикула = АС_КлючАртикулаБезСимволов(Выборка.Артикул);
		// Пустые артикулы и строки только из разделителей не образуют группу дублей.
		Если ПустаяСтрока(КлючАртикула) Тогда
			Продолжить;
		КонецЕсли;
		Варианты = Результат.Получить(КлючАртикула);
		Если Варианты = Неопределено Тогда
			Варианты = Новый Массив;
			Результат.Вставить(КлючАртикула, Варианты);
		КонецЕсли;
		Варианты.Добавить(Выборка.Артикул);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция АС_КлючАртикулаБезСимволов(ЗначениеАртикула)

	// Совпадает с правилами проверки артикула при записи номенклатуры.
	ИсходныйАртикул = СтрЗаменить(ВРег(Строка(ЗначениеАртикула)), "Ё", "Е");
	ДопустимыеСимволы = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZАБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ";
	Результат = "";
	Для Позиция = 1 По СтрДлина(ИсходныйАртикул) Цикл
		СимволАртикула = Сред(ИсходныйАртикул, Позиция, 1);
		Если СтрНайти(ДопустимыеСимволы, СимволАртикула) > 0 Тогда
			Результат = Результат + СимволАртикула;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции
