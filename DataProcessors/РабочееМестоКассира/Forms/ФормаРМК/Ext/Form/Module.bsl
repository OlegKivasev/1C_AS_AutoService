&НаКлиенте
Перем АС_ЧекиДляОстатковПослеПродажи;
&НаКлиенте
Перем АС_ОжидатьКопииДляОстатков;
&НаКлиенте
Перем АС_ЧекиПоследнегоОкнаОстатков;
&НаКлиенте
Перем АС_ПродажаЗавершенаДляОстатков;

&НаКлиенте
Перем АС_ВыборПоступленияКартыОткрыт;
&НаКлиенте
Перем АС_ПродолжитьПробитиеПослеВыбора;
&НаКлиенте
Перем АС_ПометкаОплатыКартой;
&НаКлиенте
Перем АС_ПодтверждаетсяАвтономныйЧек;

&НаКлиенте
&Вместо("ПробитьЧек")
Процедура АС_ВыбратьПоступлениеПередПробитием(Команда)

	Если АС_ПродолжитьПробитиеПослеВыбора = Истина Тогда
		АС_ПродолжитьПробитиеПослеВыбора = Ложь;
		ПродолжитьВызов(Команда);
		Возврат;
	КонецЕсли;
	Если Не Элементы.ПробитьЧек.Доступность
		Или АС_ВыборПоступленияКартыОткрыт = Истина Тогда
		Возврат;
	КонецЕсли;

	Если СуммаОплаченоБН <= 0
		Или РежимКассыСамообслуживания
		Или ЭтоЧекКоррекции
		Или Не ОбщегоНазначенияРМККлиент.ЭтоВидОперацииПродажа(Объект.ВидОперации) Тогда
		АС_УстановитьПометкуОплатыКартой("");
		ПродолжитьВызов(Команда);
		Возврат;
	КонецЕсли;

	АС_ВыборПоступленияКартыОткрыт = Истина;
	Попытка
		ПоказатьВопрос(
			Новый ОписаниеОповещения(
				"АС_ВыборПоступленияКартыЗавершение", ЭтотОбъект, Команда),
			НСтр("ru = 'Выберите, куда поступит оплата картой.'"),
			АС_ПлатежиЗаказовКлиент.ВариантыПоступленияОплаты(),
			,
			"Счет");
	Исключение
		АС_ВыборПоступленияКартыОткрыт = Ложь;
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура АС_ВыборПоступленияКартыЗавершение(Ответ, Команда) Экспорт

	Если АС_ВыборПоступленияКартыОткрыт <> Истина Тогда
		Возврат;
	КонецЕсли;
	АС_ВыборПоступленияКартыОткрыт = Ложь;
	Если Ответ <> "Счет" И Ответ <> "Озон" И Ответ <> "Сбербанк" Тогда
		Возврат;
	КонецЕсли;
	Если Не Элементы.ПробитьЧек.Доступность Или СуммаОплаченоБН <= 0 Тогда
		Возврат;
	КонецЕсли;

	ПометкаПлатежа = АС_ПлатежиЗаказовКлиент.КомментарийПоступленияОплаты(Ответ);
	АС_УстановитьПометкуОплатыКартой(ПометкаПлатежа);

	АС_ПродолжитьПробитиеПослеВыбора = Истина;
	Попытка
		ПробитьЧек(Команда);
	Исключение
		АС_ПродолжитьПробитиеПослеВыбора = Ложь;
		ВызватьИсключение;
	КонецПопытки;
	АС_ПродолжитьПробитиеПослеВыбора = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура АС_УстановитьПометкуОплатыКартой(ПометкаПлатежа)

	Если ЗначениеЗаполнено(АС_ПометкаОплатыКартой) Тогда
		ПрефиксПометки = АС_ПометкаОплатыКартой + "; ";
		Если КомментарийКЧеку = АС_ПометкаОплатыКартой Тогда
			КомментарийКЧеку = "";
		ИначеЕсли Лев(КомментарийКЧеку, СтрДлина(ПрефиксПометки)) = ПрефиксПометки Тогда
			КомментарийКЧеку = Сред(КомментарийКЧеку, СтрДлина(ПрефиксПометки) + 1);
		КонецЕсли;
	КонецЕсли;

	АС_ПометкаОплатыКартой = ПометкаПлатежа;
	Если ЗначениеЗаполнено(ПометкаПлатежа) Тогда
		КомментарийКЧеку = ПометкаПлатежа
			+ ?(ЗначениеЗаполнено(КомментарийКЧеку), "; " + КомментарийКЧеку, "");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&После("СоздатьНовыйНабор")
Процедура АС_СброситьВыборПоступленияКарты(ПараметрыЗавершения = Неопределено)

	АС_ВыборПоступленияКартыОткрыт = Ложь;
	АС_ПродолжитьПробитиеПослеВыбора = Ложь;
	АС_ПометкаОплатыКартой = "";

КонецПроцедуры

&НаКлиенте
&Перед("ПробитьЧекНаКлиентеЗавершение")
Процедура АС_ПробитьЧекНаКлиентеЗавершение(РезультатВыполнения, Параметры)

	ЧекККМ = Неопределено;
	Если ЕстьСвойство(РезультатВыполнения, "ФискализированныйЧек") Тогда
		ЧекККМ = РезультатВыполнения.ФискализированныйЧек;
	Иначе
		ЧекККМ = ЧекККМВОбработке;
	КонецЕсли;
	Если ЕстьСвойство(РезультатВыполнения, "Результат")
		И РезультатВыполнения.Результат = Истина
		И ЗначениеЗаполнено(ЧекККМ) Тогда
		ТекстОшибкиПереноса = АС_ПеренестиВыручкуНаСервере(ЧекККМ);
		Если ЗначениеЗаполнено(ТекстОшибкиПереноса) Тогда
			Сообщить("Чек пробит, но автоматическое отражение оплаты не выполнено полностью: "
				+ ТекстОшибкиПереноса);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&Вместо("СкорректироватьНаличныеДенежныеСредстваВКассеККМКлиент")
Процедура АС_СкорректироватьНаличныеДенежныеСредстваВКассеККМКлиент(
	Отказ, Организация, КассаККМ, Знач Сумма, ЭтоВнесениеВыемка = Ложь)

	Если ЭтоВнесениеВыемка Или Не ЗначениеЗаполнено(ТекущаяНастройкаРМК) Тогда
		ПродолжитьВызов(Отказ, Организация, КассаККМ, Сумма, ЭтоВнесениеВыемка);
		Возврат;
	КонецЕсли;

	НастройкаКассы = АС_ПолучитьНастройкуОсновнойКассыНаСервере(ТекущаяНастройкаРМК);
	Если ЗначениеЗаполнено(НастройкаКассы.Ошибка) Тогда
		Сообщить(НастройкаКассы.Ошибка);
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	Если Не НастройкаКассы.Использовать
		Или Не ОбщегоНазначенияРМККлиент.ЭтоВидОперацииПродажа(Объект.ВидОперации)
		Или Сумма < Сдача Тогда
		ПродолжитьВызов(Отказ, Организация, КассаККМ, Сумма, ЭтоВнесениеВыемка);
		Возврат;
	КонецЕсли;

	// При продаже наличные покупателя уже покрывают сдачу.
	// Учетный остаток ККМ при этом не отражает деньги в основной кассе.
	КонтрольОстаткаДоВызова = КонтролироватьОстатокНаличных;
	КонтролироватьОстатокНаличных = Ложь;
	Попытка
		ПродолжитьВызов(Отказ, Организация, КассаККМ, Сумма, ЭтоВнесениеВыемка);
	Исключение
		КонтролироватьОстатокНаличных = КонтрольОстаткаДоВызова;
		ВызватьИсключение;
	КонецПопытки;
	КонтролироватьОстатокНаличных = КонтрольОстаткаДоВызова;

КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_ПолучитьНастройкуОсновнойКассыНаСервере(СсылкаНастройки)
	Попытка
		Возврат АС_ПереносВыручкиРМКСервер.НастройкаОсновнойКассы(СсылкаНастройки);
	Исключение
		Возврат Новый Структура("Использовать, Касса, Ошибка", Ложь, Неопределено,
			"Не удалось прочитать настройку основной кассы РМК: " + ОписаниеОшибки());
	КонецПопытки;
КонецФункции

&НаСервере
Функция АС_ПеренестиВыручкуНаСервере(ЧекККМ)

	Если Не ЗначениеЗаполнено(ТекущаяНастройкаРМК) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		НастройкаКассы = АС_ПереносВыручкиРМКСервер.НастройкаОсновнойКассы(ТекущаяНастройкаРМК);
		Если ЗначениеЗаполнено(НастройкаКассы.Ошибка) Тогда
			Возврат НастройкаКассы.Ошибка;
		КонецЕсли;
		Если НастройкаКассы.Использовать Тогда
			АС_ПереносВыручкиРМКСервер.ОтразитьОплатуВОсновнойКассе(
				ЧекККМ, НастройкаКассы.Касса);
		КонецЕсли;
		Если НастройкаКассы.АвтоКарты Тогда
			АС_ПереносВыручкиРМКСервер.ОтразитьОплатуКартойНаСчете(
				ЧекККМ, НастройкаКассы.БанковскийСчет);
		КонецЕсли;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("АС_ПереносВыручкиРМК", УровеньЖурналаРегистрации.Ошибка,
			, ЧекККМ, ТекстОшибки);
		Возврат ТекстОшибки;
	КонецПопытки;

	Возврат "";

КонецФункции


&НаКлиенте
&Перед("ВыполнитьДействияПослеПробитияПоследнегоЧека")
Процедура АС_СохранитьЧекиДляОстатков(НужноЗаморозитьФорму, РезультатВыполнения)

	АС_ЧекиДляОстатковПослеПродажи = Неопределено;
	АС_ОжидатьКопииДляОстатков = Ложь;
	АС_ПродажаЗавершенаДляОстатков = Ложь;
	Если РежимКассыСамообслуживания Или ЭтоЧекКоррекции
		Или Не ОбщегоНазначенияРМККлиент.ЭтоВидОперацииПродажа(Объект.ВидОперации) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ЧекиПродажи = Новый Массив;
		Если ПробитыеЧеки.Количество() > 0 Тогда
			Для Каждого СтрокаЧека Из ПробитыеЧеки Цикл
				АС_ДобавитьЧекДляОстатков(ЧекиПродажи, СтрокаЧека.ЧекККМ);
			КонецЦикла;
		ИначеЕсли ЕстьСвойство(РезультатВыполнения, "ФискализированныйЧек") Тогда
			АС_ДобавитьЧекДляОстатков(ЧекиПродажи, РезультатВыполнения.ФискализированныйЧек);
		КонецЕсли;
		Если ЧекиПродажи.Количество() > 0 Тогда
			АС_ЧекиДляОстатковПослеПродажи = ЧекиПродажи;
			АС_ОжидатьКопииДляОстатков = ТекущийЧекЭлектронный И ХочуБумажныйЧек;
		КонецЕсли;
	Исключение
		АС_ЧекиДляОстатковПослеПродажи = Неопределено;
		Сообщить("Чек пробит. Подготовить окно остатков не удалось: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура АС_ДобавитьЧекДляОстатков(ЧекиПродажи, Чек)

	Если ТипЗнч(Чек) = Тип("ДокументСсылка.ЧекККМ")
		И ЗначениеЗаполнено(Чек) И ЧекиПродажи.Найти(Чек) = Неопределено Тогда
		ЧекиПродажи.Добавить(Чек);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&После("ПробитьЧекНаКлиентеЗавершение")
Процедура АС_ПоказатьОстаткиПослеЗавершенияПродажи(РезультатВыполнения, Параметры)

	Если АС_ЧекиДляОстатковПослеПродажи <> Неопределено Тогда
		АС_ПродажаЗавершенаДляОстатков = Истина;
		Если Не АС_ОжидатьКопииДляОстатков Тогда
			АС_ОткрытьОстаткиПослеПродажи();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&После("ЗавершитьПовторнуюПечатьФискальногоЧека")
Процедура АС_ПоказатьОстаткиПослеКопийЧека(РезультатВыполнения, ПараметрДействия)

	Если АС_ЧекиДляОстатковПослеПродажи = Неопределено
		Или Не АС_ОжидатьКопииДляОстатков Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(ПараметрДействия) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	Если Не ПараметрДействия.Свойство("ПечатьПослеПробития") Тогда
		Возврат;
	КонецЕсли;
	Если ЕстьСвойство(РезультатВыполнения, "Результат") И Не РезультатВыполнения.Результат Тогда
		// Не перекрываем штатное предупреждение об ошибке печати копии.
		АС_ЧекиДляОстатковПослеПродажи = Неопределено;
		АС_ОжидатьКопииДляОстатков = Ложь;
		Возврат;
	КонецЕсли;
	Если ПараметрДействия.ИндексЧека >= ПараметрДействия.МассивЧеков.Количество() Тогда
		АС_ОжидатьКопииДляОстатков = Ложь;
		Если АС_ПродажаЗавершенаДляОстатков = Истина Тогда
			АС_ОткрытьОстаткиПослеПродажи();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_ОткрытьОстаткиПослеПродажи()

	ЧекиПродажи = АС_ЧекиДляОстатковПослеПродажи;
	АС_ЧекиДляОстатковПослеПродажи = Неопределено;
	АС_ОжидатьКопииДляОстатков = Ложь;
	АС_ПродажаЗавершенаДляОстатков = Ложь;
	Если ЧекиПродажи = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИдентификаторыЧеков = Новый Массив;
	Для Каждого Чек Из ЧекиПродажи Цикл
		ИдентификаторыЧеков.Добавить(Строка(Чек.УникальныйИдентификатор()));
	КонецЦикла;
	КлючПродажи = СтрСоединить(ИдентификаторыЧеков, ";");
	Если АС_ЧекиПоследнегоОкнаОстатков <> Неопределено Тогда
		ВсеЧекиУжеПоказаны = Истина;
		Для Каждого Чек Из ЧекиПродажи Цикл
			Если АС_ЧекиПоследнегоОкнаОстатков.Найти(Чек) = Неопределено Тогда
				ВсеЧекиУжеПоказаны = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ВсеЧекиУжеПоказаны Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	АС_ЧекиПоследнегоОкнаОстатков = ЧекиПродажи;

	Попытка
		ОткрытьФорму("ОбщаяФорма.АС_ОстаткиПослеПродажиРМК",
			Новый Структура("АС_ЧекиПродажи", ЧекиПродажи), ЭтаФорма,
			КлючПродажи, , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Исключение
		Сообщить("Продажа завершена. Открыть остатки не удалось: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
&После("ПерейтиНаСтраницуВопросЭквайринговаяОперация")
Процедура АС_ПодтвердитьРучнуюОплатуКартой(ДанныеЭТ)

	Если Не ДанныеЭТ.ИспользоватьБезПодключенияОборудования
		Или ЗначениеЗаполнено(ДанныеЭТ.ПодключаемоеОборудование)
		Или СуммаТекущейОплатыКартой <= 0 Тогда
		Возврат;
	КонецЕсли;
	ТекущийСлойОплаты = ИнтерфейсРМКСлужебныйКлиентСервер.ПолучитьТекущийСлойГруппы(
		Элементы.ГруппаСлоевСлужебнаяИнформацияЧека);
	Если ТекущийСлойОплаты <> Элементы.ГруппаВопросЭквайринговаяОперация Тогда
		Возврат;
	КонецЕсли;

	ОтветДа(Команды.ОтветДа);

КонецПроцедуры

&НаКлиенте
Процедура АС_ПодтвердитьАвтономныйЧекРМК() Экспорт

	Если АС_ПодтверждаетсяАвтономныйЧек = Истина Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(ОповещениеАвтономнойКассы) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	Если ОповещениеАвтономнойКассы.Команда <> "CheckFiscalization" Тогда
		Возврат;
	КонецЕсли;
	Если ИнтерфейсРМКСлужебныйКлиентСервер.ИспользоватьСлои(ЭтотОбъект) Тогда
		ТекущийСлойЧека = ИнтерфейсРМКСлужебныйКлиентСервер.ПолучитьТекущийСлойГруппы(
			Элементы.ГруппаСлоевСлужебнаяИнформацияЧека);
		Если ТекущийСлойЧека <> Элементы.ГруппаВопросАвтономнаяКасса Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	АС_ПодтверждаетсяАвтономныйЧек = Истина;
	Попытка
		ОтветДаАвтономнаяКасса(Команды.ОтветДаАвтономнаяКасса);
	Исключение
		АС_ПодтверждаетсяАвтономныйЧек = Ложь;
		ВызватьИсключение;
	КонецПопытки;
	АС_ПодтверждаетсяАвтономныйЧек = Ложь;

КонецПроцедуры
