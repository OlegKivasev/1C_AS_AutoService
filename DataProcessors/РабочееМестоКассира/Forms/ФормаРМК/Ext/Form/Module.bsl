&НаСервере
Процедура АС_ПрочитатьИсходныеЦеныОтложенногоЧека()

	Если Не ЗначениеЗаполнено(ОтложенныйЧек)
		Или ТипЗнч(ОтложенныйЧек) <> Тип("ДокументСсылка.ЧекККМ") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого СтрокаДокумента Из ОтложенныйЧек.Запасы Цикл
		Если СтрокаДокумента.АС_ЦенаДоОкругленияРМК <= 0 Тогда
			Продолжить;
		КонецЕсли;
		СтрокиИсточника = Новый Массив;
		ОбщееКоличество = 0;
		Для Каждого СтрокаЧека Из Объект.Товары Цикл
			Если (ЗначениеЗаполнено(СтрокаЧека.АС_ИсходныйКлючОкругленияРМК)
				И СтрокаЧека.АС_ИсходныйКлючОкругленияРМК = СтрокаДокумента.КлючСвязи + 1)
				Или (Не ЗначениеЗаполнено(СтрокаЧека.АС_ИсходныйКлючОкругленияРМК)
					И СтрокаЧека.КлючСвязиЧекаПродажи = СтрокаДокумента.КлючСвязи) Тогда
				СтрокиИсточника.Добавить(СтрокаЧека);
				ОбщееКоличество = ОбщееКоличество + СтрокаЧека.Количество;
			КонецЕсли;
		КонецЦикла;
		КоэффициентПереноса = 1;
		Если СтрокиИсточника.Количество() > 1
			И СтрокиИсточника[0].АС_КоэффициентИсточникаОкругленияРМК > 0 Тогда
			// База переводит упаковки в базовые единицы только при разделении по сериям.
			КоэффициентПереноса = СтрокиИсточника[0].АС_КоэффициентИсточникаОкругленияРМК;
		КонецЕсли;
		Если ОбщееКоличество <= 0 Или ОбщееКоличество <> СтрокаДокумента.Количество * КоэффициентПереноса Тогда
			Продолжить;
		КонецЕсли;
		ОсталосьКоличество = ОбщееКоличество;
		ОсталасьСуммаДоОкругления = СтрокаДокумента.АС_СуммаДоОкругленияРМК;
		ОсталасьСкидкаДоОкругления = СтрокаДокумента.АС_СкидкаДоОкругленияРМК;
		ОсталасьСкидкаПослеОкругления = СтрокаДокумента.АС_СкидкаПослеОкругленияРМК;
		ОсталасьСуммаПослеОкругления = СтрокаДокумента.АС_СуммаПослеОкругленияРМК;
		Для Каждого СтрокаЧека Из СтрокиИсточника Цикл
			Если СтрокаЧека.Цена <> Окр(СтрокаДокумента.АС_ЦенаПослеОкругленияРМК / КоэффициентПереноса, 2) Тогда
				Продолжить;
			КонецЕсли;
			СтрокаЧека.АС_ЦенаДоОкругленияРМК = Окр(СтрокаДокумента.АС_ЦенаДоОкругленияРМК / КоэффициентПереноса, 2);
			СтрокаЧека.АС_ЦенаПослеОкругленияРМК = СтрокаЧека.Цена;
			Если СтрокаДокумента.АС_КоличествоПриОкругленииРМК > 0 Тогда
				СтрокаЧека.АС_СкидкаДоОкругленияРМК = Окр(ОсталасьСкидкаДоОкругления
					* СтрокаЧека.Количество / ОсталосьКоличество, 2);
				СтрокаЧека.АС_СкидкаПослеОкругленияРМК = Окр(ОсталасьСкидкаПослеОкругления
					* СтрокаЧека.Количество / ОсталосьКоличество, 2);
				СтрокаЧека.АС_ПроцентСкидкиДоОкругленияРМК = СтрокаДокумента.АС_ПроцентСкидкиДоОкругленияРМК;
				СтрокаЧека.АС_ПроцентСкидкиПослеОкругленияРМК = СтрокаДокумента.АС_ПроцентСкидкиПослеОкругленияРМК;
				Если СтрокаЧека.СуммаСкидкиНаценки = СтрокаЧека.АС_СкидкаПослеОкругленияРМК Тогда
					// Сохраняем изменённую при загрузке скидку, если штатный расчёт её заменил.
					СтрокаЧека.ПроцентСкидкиНаценки = СтрокаЧека.АС_ПроцентСкидкиПослеОкругленияРМК;
				КонецЕсли;
				СтрокаЧека.АС_СуммаДоОкругленияРМК = Окр(ОсталасьСуммаДоОкругления
					* СтрокаЧека.Количество / ОсталосьКоличество, 2);
				СтрокаЧека.АС_СуммаПослеОкругленияРМК = Окр(ОсталасьСуммаПослеОкругления
					* СтрокаЧека.Количество / ОсталосьКоличество, 2);
			КонецЕсли;
			// У старых отложенных чеков сохранены только две цены.
			Если СтрокаДокумента.АС_КоличествоПриОкругленииРМК > 0 Тогда
				СтрокаЧека.АС_КоличествоПриОкругленииРМК = СтрокаЧека.Количество;
				СтрокаЧека.АС_УпаковокПриОкругленииРМК = СтрокаЧека.КоличествоУпаковок;
			Иначе
				СтрокаЧека.АС_КоличествоПриОкругленииРМК = 0;
				СтрокаЧека.АС_УпаковокПриОкругленииРМК = 0;
			КонецЕсли;
			ОсталосьКоличество = ОсталосьКоличество - СтрокаЧека.Количество;
			ОсталасьСуммаДоОкругления = ОсталасьСуммаДоОкругления - СтрокаЧека.АС_СуммаДоОкругленияРМК;
			ОсталасьСкидкаДоОкругления = ОсталасьСкидкаДоОкругления - СтрокаЧека.АС_СкидкаДоОкругленияРМК;
			ОсталасьСкидкаПослеОкругления = ОсталасьСкидкаПослеОкругления - СтрокаЧека.АС_СкидкаПослеОкругленияРМК;
			ОсталасьСуммаПослеОкругления = ОсталасьСуммаПослеОкругления - СтрокаЧека.АС_СуммаПослеОкругленияРМК;
			СтрокаЧека.СуммаСкидокОбщая = СтрокаЧека.СуммаСкидкиНаценки
				+ СтрокаЧека.СуммаАвтоматическойСкидки + СтрокаЧека.СуммаСкидкиОплатыБонусом;
			СтрокаЧека.СуммаБезСкидки = СтрокаЧека.Сумма + СтрокаЧека.СуммаСкидокОбщая;
			ОбщегоНазначенияРМККлиентСервер.РассчитатьСуммуНДС(Объект, СтрокаЧека);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
&После("ПродолжитьЧекКлиентЗавершение")
Процедура АС_ОкруглитьВозобновленныйЧек()
	ПересчитатьИтогиТабличнойЧастиТовары(Ложь, Ложь);
КонецПроцедуры

&НаКлиенте
Функция АС_НужноОбрабатыватьОкругление()

	Возврат Не ЭтоЧекКоррекции
		И ОбщегоНазначенияРМККлиент.ЭтоВидОперацииПродажа(Объект.ВидОперации);

КонецФункции

&НаКлиенте
Функция АС_НачатьИзменениеСтоимости(СтрокаБезПересчета = Неопределено)

	Если АС_ПересчитываетсяОкруглениеЦен = Истина Или Не АС_НужноОбрабатыватьОкругление() Тогда
		Возврат Ложь;
	КонецЕсли;
	Если АС_ГлубинаИзмененияСтоимости = Неопределено Тогда
		АС_ГлубинаИзмененияСтоимости = 0;
	КонецЕсли;
	АС_ГлубинаИзмененияСтоимости = АС_ГлубинаИзмененияСтоимости + 1;
	Если АС_ГлубинаИзмененияСтоимости = 1 Тогда
		Попытка
			АС_ВосстановитьЦеныДоОкругления(СтрокаБезПересчета);
		Исключение
			АС_ГлубинаИзмененияСтоимости = 0;
			ВызватьИсключение;
		КонецПопытки;
	КонецЕсли;
	Возврат Истина;

КонецФункции

&НаКлиенте
Процедура АС_ЗавершитьИзменениеСтоимости(ИзменениеНачато, ПересчитатьИтог = Истина,
	ОбнулитьСуммыОплат = Ложь, ОбнулитьПодарочныеСертификаты = Ложь)

	Если Не ИзменениеНачато Тогда
		Возврат;
	КонецЕсли;
	АС_ГлубинаИзмененияСтоимости = АС_ГлубинаИзмененияСтоимости - 1;
	Если АС_ГлубинаИзмененияСтоимости = 0 И ПересчитатьИтог Тогда
		ПересчитатьИтогиТабличнойЧастиТовары(ОбнулитьСуммыОплат, ОбнулитьПодарочныеСертификаты);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&Вместо("ПересчитатьИтогиТабличнойЧастиТовары")
Процедура АС_ПересчитатьИтогиСОкруглениемЦены(ОбнулитьСуммыОплат = Истина,
	ОбнулитьПодарочныеСертификаты = Истина, ПослеУдаленияСтроки = Ложь)

	Если АС_ПересчитываетсяОкруглениеЦен = Истина
		Или (АС_ГлубинаИзмененияСтоимости <> Неопределено И АС_ГлубинаИзмененияСтоимости > 0)
		Или Не АС_НужноОбрабатыватьОкругление() Тогда
		Если Объект.ЦенаВключаетНДС Или Не АС_НужноОбрабатыватьОкругление() Тогда
			ПродолжитьВызов(ОбнулитьСуммыОплат, ОбнулитьПодарочныеСертификаты, ПослеУдаленияСтроки);
		Иначе
			АС_ПересчитатьИтогиСНДС(ОбнулитьСуммыОплат, ОбнулитьПодарочныеСертификаты, ПослеУдаленияСтроки);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	ОбновлятьЦенуВКарточке = Ложь;
	Если ТекущаяСтрока <> Неопределено Тогда
		ОбновлятьЦенуВКарточке = ТекущийТоварЦенаИзКарточки = ТекущаяСтрока.Цена;
	КонецЕсли;
	АС_ПересчитываетсяОкруглениеЦен = Истина;
	Попытка
		АС_ВосстановитьЦеныДоОкругления();
		АС_ОкруглитьИтогИзменениемЦены();
		ОбщегоНазначенияРМККлиентСервер.СуммаДокумента(Объект);
		Если Объект.ЦенаВключаетНДС Или Не АС_НужноОбрабатыватьОкругление() Тогда
			ПродолжитьВызов(ОбнулитьСуммыОплат, ОбнулитьПодарочныеСертификаты, ПослеУдаленияСтроки);
		Иначе
			АС_ПересчитатьИтогиСНДС(ОбнулитьСуммыОплат, ОбнулитьПодарочныеСертификаты, ПослеУдаленияСтроки);
		КонецЕсли;
		ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
		Если ОбновлятьЦенуВКарточке И ТекущаяСтрока <> Неопределено Тогда
			ТекущийТоварЦенаИзКарточки = ТекущаяСтрока.Цена;
		КонецЕсли;
	Исключение
		АС_ПересчитываетсяОкруглениеЦен = Ложь;
		ВызватьИсключение;
	КонецПопытки;
	АС_ПересчитываетсяОкруглениеЦен = Ложь;

КонецПроцедуры

&НаКлиенте
Функция АС_ИтогДляОкругления()

	Результат = 0;
	СтрокиТоваров = Объект.Товары.НайтиСтроки(Новый Структура(Элементы.Товары.ОтборСтрок));
	Для Каждого СтрокаЧека Из СтрокиТоваров Цикл
		Если Не СтрокаЧека.ТоварКЗамене Тогда
			Результат = Результат + СтрокаЧека.Сумма
				+ ?(Объект.ЦенаВключаетНДС, 0, СтрокаЧека.СуммаНДС);
		КонецЕсли;
	КонецЦикла;
	Возврат Окр(Результат, 2);

КонецФункции

&НаКлиенте
Функция АС_СуммаБезСкидкиСтроки(СтрокаЧека)
	Возврат СтрокаЧека.Цена * СтрокаЧека.Количество;
КонецФункции

&НаКлиенте
Процедура АС_СогласоватьСуммыСтроки(СтрокаЧека)

	СтрокаЧека.СуммаСкидокОбщая = СтрокаЧека.СуммаСкидкиНаценки
		+ СтрокаЧека.СуммаАвтоматическойСкидки + СтрокаЧека.СуммаСкидкиОплатыБонусом;
	СтрокаЧека.СуммаБезСкидки = СтрокаЧека.Сумма + СтрокаЧека.СуммаСкидокОбщая;
	СтрокаЧека.ПроцентСкидкиОбщий = ?(СтрокаЧека.СуммаБезСкидки = 0, 0,
		СтрокаЧека.СуммаСкидокОбщая / СтрокаЧека.СуммаБезСкидки * 100);
	ОбщегоНазначенияРМККлиентСервер.РассчитатьСуммуНДС(Объект, СтрокаЧека);

КонецПроцедуры

&НаКлиенте
Процедура АС_РассчитатьСтрокуПриОкруглении(СтрокаЧека, СохранитьСуммуСкидки = Неопределено)

	СуммаБезСкидки = Окр(АС_СуммаБезСкидкиСтроки(СтрокаЧека), 2);
	Если СохранитьСуммуСкидки = Неопределено Тогда
		СохранитьСуммуСкидки = СтрокаЧека.ПроцентСкидкиНаценки = 0;
		Если СуммаБезСкидки > 0 Тогда
			СохранитьСуммуСкидки = СохранитьСуммуСкидки
				Или Окр(СтрокаЧека.СуммаСкидкиНаценки / СуммаБезСкидки * 100, 2)
					= СтрокаЧека.ПроцентСкидкиНаценки;
		КонецЕсли;
	КонецЕсли;
	Если Не СохранитьСуммуСкидки Тогда
		СтрокаЧека.СуммаСкидкиНаценки = Окр(СуммаБезСкидки * СтрокаЧека.ПроцентСкидкиНаценки / 100, 2);
	КонецЕсли;
	СтрокаЧека.Сумма = Окр(СуммаБезСкидки - СтрокаЧека.СуммаСкидкиНаценки
		- СтрокаЧека.СуммаАвтоматическойСкидки - СтрокаЧека.СуммаСкидкиОплатыБонусом, 2);
	АС_СогласоватьСуммыСтроки(СтрокаЧека);

КонецПроцедуры

&НаКлиенте
Процедура АС_ВосстановитьЦеныДоОкругления(СтрокаБезПересчета = Неопределено)

	Для Каждого СтрокаЧека Из Объект.Товары Цикл
		Если СтрокаЧека.АС_ЦенаДоОкругленияРМК <= 0 Или СтрокаЧека.Оплачена Тогда
			Продолжить;
		КонецЕсли;
		ИсходнаяЦена = СтрокаЧека.АС_ЦенаДоОкругленияРМК;
		ОкругленнаяЦена = СтрокаЧека.АС_ЦенаПослеОкругленияРМК;
		ИсходнаяСумма = СтрокаЧека.АС_СуммаДоОкругленияРМК;
		ИсходнаяСкидка = СтрокаЧека.АС_СкидкаДоОкругленияРМК;
		ИсходныйПроцентСкидки = СтрокаЧека.АС_ПроцентСкидкиДоОкругленияРМК;
		КоличествоНеИзменено = СтрокаЧека.АС_КоличествоПриОкругленииРМК = 0
			Или (СтрокаЧека.Количество = СтрокаЧека.АС_КоличествоПриОкругленииРМК
				И СтрокаЧека.КоличествоУпаковок = СтрокаЧека.АС_УпаковокПриОкругленииРМК);
		СуммаНеИзменена = СтрокаЧека.АС_КоличествоПриОкругленииРМК > 0
			И КоличествоНеИзменено
			И СтрокаЧека.Сумма = СтрокаЧека.АС_СуммаПослеОкругленияРМК;
		СкидкаНеИзменена = СтрокаЧека.СуммаСкидкиНаценки = СтрокаЧека.АС_СкидкаПослеОкругленияРМК
			И СтрокаЧека.ПроцентСкидкиНаценки = СтрокаЧека.АС_ПроцентСкидкиПослеОкругленияРМК;
		Если СтрокаЧека.Цена = ОкругленнаяЦена И СкидкаНеИзменена Тогда
			СтрокаЧека.СуммаСкидкиНаценки = СтрокаЧека.АС_СкидкаДоОкругленияРМК;
			СтрокаЧека.ПроцентСкидкиНаценки = СтрокаЧека.АС_ПроцентСкидкиДоОкругленияРМК;
		КонецЕсли;
		СтрокаЧека.АС_ЦенаДоОкругленияРМК = 0;
		СтрокаЧека.АС_ЦенаПослеОкругленияРМК = 0;
		СтрокаЧека.АС_СкидкаДоОкругленияРМК = 0;
		СтрокаЧека.АС_СкидкаПослеОкругленияРМК = 0;
		СтрокаЧека.АС_ПроцентСкидкиДоОкругленияРМК = 0;
		СтрокаЧека.АС_ПроцентСкидкиПослеОкругленияРМК = 0;
		СтрокаЧека.АС_СуммаДоОкругленияРМК = 0;
		СтрокаЧека.АС_СуммаПослеОкругленияРМК = 0;
		СтрокаЧека.АС_КоличествоПриОкругленииРМК = 0;
		СтрокаЧека.АС_УпаковокПриОкругленииРМК = 0;
		// Введённая вручную или полученная по виду цен цена становится новой исходной.
		Если СтрокаЧека.Цена <> ОкругленнаяЦена Тогда
			Продолжить;
		КонецЕсли;
		СтрокаЧека.Цена = ИсходнаяЦена;
		Если СтрокаБезПересчета <> Неопределено Тогда
			Если СтрокаЧека.ПолучитьИдентификатор() = СтрокаБезПересчета.ПолучитьИдентификатор() Тогда
				// Введённую скидку/сумму текущей строки рассчитает вызывающий обработчик.
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Если Не СтрокаЧека.Подарок Тогда
			ИсходнаяАвтоСкидка = СтрокаЧека.СуммаАвтоматическойСкидки;
			ИсходнаяБонуснаяСкидка = СтрокаЧека.СуммаСкидкиОплатыБонусом;
			АС_РассчитатьСтрокуПриОкруглении(СтрокаЧека, СкидкаНеИзменена И КоличествоНеИзменено);
			Если СкидкаНеИзменена И КоличествоНеИзменено
				И СтрокаЧека.СуммаСкидкиНаценки = ИсходнаяСкидка Тогда
				// Не выводим исходный процент заново из округлённой денежной скидки:
				// при дробном количестве это превращало, например, 20% в 20,02%.
				СтрокаЧека.ПроцентСкидкиНаценки = ИсходныйПроцентСкидки;
				Если СуммаНеИзменена
					И АС_СуммаСтрокиНеНижеМинимальной(СтрокаЧека, ИсходнаяСумма)
					И СтрокаЧека.СуммаАвтоматическойСкидки = ИсходнаяАвтоСкидка
					И СтрокаЧека.СуммаСкидкиОплатыБонусом = ИсходнаяБонуснаяСкидка Тогда
					// Сохраняем точный ручной ввод суммы, если скидки не урезаны минимумом.
					СтрокаЧека.Сумма = ИсходнаяСумма;
					АС_СогласоватьСуммыСтроки(СтрокаЧека);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура АС_ОкруглитьИтогИзменениемЦены()

	ИсходныйИтог = АС_ИтогДляОкругления();
	Если ИсходныйИтог <= 200 Тогда
		АС_ПоследнийНеокругленныйИтог = Неопределено;
		Возврат;
	КонецЕсли;
	ПравилоОкругления = ПредопределенноеЗначение("Перечисление.ПорядкиОкругления.Окр50");
	ЦелевойИтог = ЦенообразованиеКлиентСервер.ОкруглитьЦену(ИсходныйИтог, ПравилоОкругления, Ложь);
	Если ЦелевойИтог = ИсходныйИтог Тогда
		АС_ПоследнийНеокругленныйИтог = Неопределено;
		Возврат;
	КонецЕсли;
	// Сначала проверяем все цены; сумма служит только запасным способом.
	Для СпособОкругления = 1 По 2 Цикл
		Для ПриоритетКоличество = 1 По 2 Цикл
			Для Каждого СтрокаЧека Из Объект.Товары Цикл
				Если (ПриоритетКоличество = 1 И СтрокаЧека.Количество <> 1)
					Или (ПриоритетКоличество = 2 И СтрокаЧека.Количество = 1)
					Или Не АС_МожноОкруглитьЦенуСтроки(СтрокаЧека) Тогда
					Продолжить;
				КонецЕсли;
				Если АС_ПодобратьЦенуДляИтога(СтрокаЧека, ИсходныйИтог, ЦелевойИтог,
					СпособОкругления = 2) Тогда
					АС_ПоследнийНеокругленныйИтог = Неопределено;
					Возврат;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Если АС_ПоследнийНеокругленныйИтог <> ИсходныйИтог Тогда
		Сообщить("Итог чека не округлена: нет подходящего позиции, цену или сумму которой можно изменить до точного итога с сохранением скидок и минимальной цены.");
		АС_ПоследнийНеокругленныйИтог = ИсходныйИтог;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция АС_МожноОкруглитьЦенуСтроки(СтрокаЧека)

	Если СтрокаЧека.Количество <= 0 Или СтрокаЧека.Цена <= 0
		Или СтрокаЧека.Оплачена Или СтрокаЧека.Подарок Или СтрокаЧека.ТоварКЗамене
		Или СтрокаЧека.ЭтоНабор Или СтрокаЧека.НомерНабора <> 0
		Или СтрокаЧека.ЭтоПодарочныйСертификат Или СтрокаЧека.ЭтоТабачнаяПродукция
		Или ЗначениеЗаполнено(СтрокаЧека.МРЦ) Или ЗначениеЗаполнено(СтрокаЧека.ЕМРЦ) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СтрокаЧека.КоличествоУпаковок <> СтрокаЧека.Количество Тогда
		// Штатная касса использует разные количества для цены и суммы упаковки.
		Возврат Ложь;
	КонецЕсли;
	СтрокиТоваров = Объект.Товары.НайтиСтроки(Новый Структура(Элементы.Товары.ОтборСтрок));
	Возврат СтрокиТоваров.Найти(СтрокаЧека) <> Неопределено;

КонецФункции

&НаКлиенте
Функция АС_ПодобратьЦенуДляИтога(СтрокаЧека, ИсходныйИтог, ЦелевойИтог, КорректироватьСумму = Ложь)

	ИсходныеЗначения = Новый Структура(
		"Цена,Сумма,СуммаНДС,СуммаБезСкидки,СуммаСкидокОбщая,ПроцентСкидкиОбщий,ПроцентСкидкиНаценки,СуммаСкидкиНаценки,"
		+ "ПроцентАвтоматическойСкидки,СуммаАвтоматическойСкидки,СуммаСкидкиОплатыБонусом");
	ЗаполнитьЗначенияСвойств(ИсходныеЗначения, СтрокаЧека);
	МинимальнаяЦена = 0;
	Если СтрокаЧека.Свойство("МинимальнаяЦена") Тогда
		МинимальнаяЦена = СтрокаЧека.МинимальнаяЦена;
	КонецЕсли;
	ИсходнаяЦена = ИсходныеЗначения.Цена;
	НоваяЦена = Окр(ИсходнаяЦена + (ЦелевойИтог - ИсходныйИтог) / СтрокаЧека.Количество, 2);
	ПроверенныеЦены = Новый Массив;
	Для НомерПопытки = 1 По 4 Цикл
		Если НоваяЦена <= 0 Или НоваяЦена < МинимальнаяЦена
			Или Окр(НоваяЦена * СтрокаЧека.Количество, 2) <= 0
			Или (НоваяЦена = ИсходнаяЦена И Не КорректироватьСумму)
			Или ПроверенныеЦены.Найти(НоваяЦена) <> Неопределено Тогда
			Прервать;
		КонецЕсли;
		ПроверенныеЦены.Добавить(НоваяЦена);
		ЗаполнитьЗначенияСвойств(СтрокаЧека, ИсходныеЗначения);
		СтрокаЧека.Цена = НоваяЦена;
		Попытка
			АС_РассчитатьСтрокуПриОкруглении(СтрокаЧека);
		Исключение
			ЗаполнитьЗначенияСвойств(СтрокаЧека, ИсходныеЗначения);
			ВызватьИсключение;
		КонецПопытки;
		ФактическийИтог = АС_ИтогДляОкругления();
		// Пределы кассовой скидки проверены штатным вводом. Округление её не увеличивает.
		СкидкаДопустима = СтрокаЧека.СуммаСкидкиНаценки = ИсходныеЗначения.СуммаСкидкиНаценки
			Или СтрокаЧека.ПроцентСкидкиНаценки = ИсходныеЗначения.ПроцентСкидкиНаценки;
		// Не принимаем цену, из-за которой штатный контроль минимальной цены урезал скидки.
		АвтоСкидкаСохранена = СтрокаЧека.СуммаАвтоматическойСкидки = ИсходныеЗначения.СуммаАвтоматическойСкидки;
		СуммаБезСкидки = Окр(НоваяЦена * СтрокаЧека.Количество, 2);
		СохраняласьДенежнаяСкидка = ИсходныеЗначения.ПроцентСкидкиНаценки = 0
			Или Окр(ИсходныеЗначения.СуммаСкидкиНаценки / СуммаБезСкидки * 100, 2)
				= ИсходныеЗначения.ПроцентСкидкиНаценки;
		РучнаяСкидкаСохранена = ?(СохраняласьДенежнаяСкидка,
			СтрокаЧека.СуммаСкидкиНаценки = ИсходныеЗначения.СуммаСкидкиНаценки,
			СтрокаЧека.ПроцентСкидкиНаценки = ИсходныеЗначения.ПроцентСкидкиНаценки);
		Если КорректироватьСумму И ФактическийИтог <> ЦелевойИтог
			И СкидкаДопустима И АвтоСкидкаСохранена И РучнаяСкидкаСохранена Тогда
			Попытка
				СуммаПодобрана = АС_ПодобратьСуммуДляИтога(СтрокаЧека, ФактическийИтог, ЦелевойИтог, МинимальнаяЦена);
			Исключение
				ЗаполнитьЗначенияСвойств(СтрокаЧека, ИсходныеЗначения);
				ВызватьИсключение;
			КонецПопытки;
			Если СуммаПодобрана Тогда
				ФактическийИтог = АС_ИтогДляОкругления();
			КонецЕсли;
		КонецЕсли;
		Если ФактическийИтог = ЦелевойИтог И СкидкаДопустима И АвтоСкидкаСохранена И РучнаяСкидкаСохранена
			И СтрокаЧека.Сумма >= Окр(МинимальнаяЦена * СтрокаЧека.Количество, 2) Тогда
			АС_ЗапомнитьОкруглениеСтроки(СтрокаЧека, ИсходныеЗначения);
			Возврат Истина;
		КонецЕсли;
		ИзменениеИтога = ФактическийИтог - ИсходныйИтог;
		Если НоваяЦена = ИсходнаяЦена Тогда
			// Ручная сумма могла отличаться от цены на копейки. При той же цене
			// делитель для оценки влияния равен нулю: проверяем соседнюю копейку.
			НоваяЦена = Окр(НоваяЦена + ?(ЦелевойИтог > ФактическийИтог, 0.01, -0.01), 2);
			Продолжить;
		КонецЕсли;
		Если ИзменениеИтога = 0 Тогда
			Прервать;
		КонецЕсли;
		ВлияниеЦеныНаИтог = ИзменениеИтога / (НоваяЦена - ИсходнаяЦена);
		НоваяЦена = Окр(НоваяЦена + (ЦелевойИтог - ФактическийИтог) / ВлияниеЦеныНаИтог, 2);
	КонецЦикла;
	ЗаполнитьЗначенияСвойств(СтрокаЧека, ИсходныеЗначения);
	Возврат Ложь;

КонецФункции

&НаКлиенте
Функция АС_СуммаСтрокиНеНижеМинимальной(СтрокаЧека, ПроверяемаяСумма)

	Если ПроверяемаяСумма <= 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СтрокаЧека.Свойство("МинимальнаяЦена") И СтрокаЧека.Цена > 0 Тогда
		КоличествоДляЦены = АС_СуммаБезСкидкиСтроки(СтрокаЧека) / СтрокаЧека.Цена;
		Возврат ПроверяемаяСумма >= Окр(СтрокаЧека.МинимальнаяЦена * КоличествоДляЦены, 2);
	КонецЕсли;
	Возврат Истина;

КонецФункции

&НаКлиенте
Функция АС_ПодобратьСуммуДляИтога(СтрокаЧека, ИсходныйИтог, ЦелевойИтог, МинимальнаяЦена)

	ИсходныеСуммы = Новый Структура("Сумма,СуммаНДС,СуммаБезСкидки,СуммаСкидокОбщая,ПроцентСкидкиОбщий");
	ЗаполнитьЗначенияСвойств(ИсходныеСуммы, СтрокаЧека);
	СуммаСНДС = ИсходныеСуммы.Сумма + ?(Объект.ЦенаВключаетНДС, 0, ИсходныеСуммы.СуммаНДС);
	Если ИсходныеСуммы.Сумма <= 0 Или СуммаСНДС <= 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	КоличествоДляЦены = АС_СуммаБезСкидкиСтроки(СтрокаЧека) / СтрокаЧека.Цена;
	КоэффициентСуммы = ИсходныеСуммы.Сумма / СуммаСНДС;
	НоваяСумма = Окр(ИсходныеСуммы.Сумма + (ЦелевойИтог - ИсходныйИтог) * КоэффициентСуммы, 2);
	ПроверенныеСуммы = Новый Массив;
	Для НомерПопытки = 1 По 4 Цикл
		Если НоваяСумма <= 0 Или НоваяСумма < Окр(МинимальнаяЦена * СтрокаЧека.Количество, 2)
			Или ПроверенныеСуммы.Найти(НоваяСумма) <> Неопределено Тогда
			Прервать;
		КонецЕсли;
		// Поправляем лишь остаток округления: цена согласована с точной суммой
		// и уже рассчитанными скидками. Дополнительную ручную скидку не создаём.
		ЦенаИзСуммы = Окр((НоваяСумма + СтрокаЧека.СуммаСкидкиНаценки
			+ СтрокаЧека.СуммаАвтоматическойСкидки + СтрокаЧека.СуммаСкидкиОплатыБонусом)
			/ КоличествоДляЦены, 2);
		ПроверенныеСуммы.Добавить(НоваяСумма);
		СтрокаЧека.Сумма = НоваяСумма;
		Попытка
			АС_СогласоватьСуммыСтроки(СтрокаЧека);
		Исключение
			ЗаполнитьЗначенияСвойств(СтрокаЧека, ИсходныеСуммы);
			ВызватьИсключение;
		КонецПопытки;
		ФактическийИтог = АС_ИтогДляОкругления();
		Если ФактическийИтог = ЦелевойИтог И ЦенаИзСуммы = СтрокаЧека.Цена Тогда
			Возврат Истина;
		КонецЕсли;
		НоваяСумма = Окр(НоваяСумма + (ЦелевойИтог - ФактическийИтог) * КоэффициентСуммы, 2);
	КонецЦикла;
	ЗаполнитьЗначенияСвойств(СтрокаЧека, ИсходныеСуммы);
	Возврат Ложь;

КонецФункции

&НаКлиенте
Процедура АС_ЗапомнитьОкруглениеСтроки(СтрокаЧека, ИсходныеЗначения)

	СтрокаЧека.АС_ЦенаДоОкругленияРМК = ИсходныеЗначения.Цена;
	СтрокаЧека.АС_ЦенаПослеОкругленияРМК = СтрокаЧека.Цена;
	СтрокаЧека.АС_СкидкаДоОкругленияРМК = ИсходныеЗначения.СуммаСкидкиНаценки;
	СтрокаЧека.АС_ПроцентСкидкиДоОкругленияРМК = ИсходныеЗначения.ПроцентСкидкиНаценки;
	СтрокаЧека.АС_СкидкаПослеОкругленияРМК = СтрокаЧека.СуммаСкидкиНаценки;
	СтрокаЧека.АС_ПроцентСкидкиПослеОкругленияРМК = СтрокаЧека.ПроцентСкидкиНаценки;
	СтрокаЧека.АС_СуммаДоОкругленияРМК = ИсходныеЗначения.Сумма;
	СтрокаЧека.АС_СуммаПослеОкругленияРМК = СтрокаЧека.Сумма;
	СтрокаЧека.АС_КоличествоПриОкругленииРМК = СтрокаЧека.Количество;
	СтрокаЧека.АС_УпаковокПриОкругленииРМК = СтрокаЧека.КоличествоУпаковок;

КонецПроцедуры

&НаКлиенте
Процедура АС_ПересчитатьИтогиСНДС(ОбнулитьСуммыОплат, ОбнулитьПодарочныеСертификаты, ПослеУдаленияСтроки)

	ПересчитатьКоличествоВПлитках();
	СуммаБезСкидки = 0;
	СуммаСкидкиДоПересчета = СуммаСкидки;
	СуммаСкидки = 0;
	СуммаОплаченоБонусами = 0;
	СтрокиТоваров = Объект.Товары.НайтиСтроки(Новый Структура(Элементы.Товары.ОтборСтрок));
	Для Каждого СтрокаТовары Из СтрокиТоваров Цикл
		Если СтрокаТовары.ТоварКЗамене Тогда
			Продолжить;
		КонецЕсли;
		СуммаБезСкидки = СуммаБезСкидки + СтрокаТовары.СуммаБезСкидки;
		СуммаСкидки = СуммаСкидки + СтрокаТовары.СуммаАвтоматическойСкидки + СтрокаТовары.СуммаСкидкиНаценки;
		СуммаОплаченоБонусами = СуммаОплаченоБонусами + СтрокаТовары.СуммаСкидкиОплатыБонусом;
		СтрокаТовары.СуммаСкидокОбщая = СтрокаТовары.СуммаСкидкиНаценки
			+ СтрокаТовары.СуммаАвтоматическойСкидки + СтрокаТовары.СуммаСкидкиОплатыБонусом;
		СтрокаТовары.ПроцентСкидкиОбщий = ?(СтрокаТовары.СуммаБезСкидки = 0, 0,
			СтрокаТовары.СуммаСкидокОбщая / СтрокаТовары.СуммаБезСкидки) * 100;
		СтрокаТовары.ИндексКартинкиПроцентов = ?(СтрокаТовары.ПроцентСкидкиОбщий = 0, -1, 0);
	КонецЦикла;
	СуммаКОплате = АС_ИтогДляОкругления();
	СуммаИтого = СуммаКОплате;
	ЭтоОперацияВозврат = ОбщегоНазначенияРМККлиент.ЭтоВидОперацииВозврат(Объект.ВидОперации);
	Если ОбнулитьСуммыОплат И Не ОтложенныйЧекПолностьюОплачен Тогда
		Если РежимРаботыСЧеком = РежимыРаботыСЧеком.Оплата
			Или РежимРаботыСЧеком = РежимыРаботыСЧеком.ВозвратКоррекция Тогда
			ОбнулитьПеременныеСуммОплат(ОбнулитьПодарочныеСертификаты);
		ИначеЕсли ПослеУдаленияСтроки И ЭтоОперацияВозврат Тогда
			ОтменитьВведенныеОплаты();
		КонецЕсли;
	КонецЕсли;
	ПроверитьПревышениеСуммыЗачетаАванса();
	НастроитьДоступностьПробитьЧек();
	НастроитьЗаголовокКнопкиОплаты();
	Если СуммаСкидкиДоПересчета <> СуммаСкидки Тогда
		НастроитьЗаголовокКнопкиСкидки();
	КонецЕсли;
	НастроитьШиринуКолонкиНомерСтроки();

КонецПроцедуры

&НаКлиенте
&Вместо("РассчитатьСуммыОплаты")
Процедура АС_РассчитатьОплатуПоТочнымСуммам()

	Если Объект.ЦенаВключаетНДС Или Не АС_НужноОбрабатыватьОкругление() Тогда
		ПродолжитьВызов();
		Возврат;
	КонецЕсли;
	СуммаИтого = АС_ИтогДляОкругления();
	СуммаЗаполненныхОплат = СуммаОплаченоНал + СуммаОплаченоБН + СуммаОплаченоБезнал + СуммаОплаченоВРассрочку
		+ СуммаОплаченоЗачетАванса + СуммаОплаченоСертификатами + СуммаОплаченоСБП + СуммаОплаченоЮКасса
		+ СуммаОплаченоСертификатамиНСПК + СуммаТоваровКЗамене + СуммаОплаченоКредитом;
	СуммаКОплатеВсего = СуммаИтого - СуммаЗаполненныхОплат;
	СуммаКОплате = СуммаКОплатеВсего;
	Сдача = ?(СуммаОплаченоНал = 0, 0, ?(СуммаКОплатеВсего > 0, 0, -СуммаКОплатеВсего));
	ОбновитьМаксимальныеСуммыСертификатов();
	АктуализироватьИзменениеЭтапаРаботыСЧекомПриИзмененииОплаты();

КонецПроцедуры

&НаКлиенте
&Вместо("ПересчитатьСуммы")
Процедура АС_ИзменитьСтоимостьРМК1(ТекущаяСтрока, ОбнулитьСуммыОплат = Ложь, ОбнулитьПодарочныеСертификаты = Истина)

	ИзменениеНачато = АС_НачатьИзменениеСтоимости(ТекущаяСтрока);
	Попытка
		ПродолжитьВызов(ТекущаяСтрока, ОбнулитьСуммыОплат, ОбнулитьПодарочныеСертификаты);
	Исключение
		АС_ЗавершитьИзменениеСтоимости(ИзменениеНачато, Ложь);
		ВызватьИсключение;
	КонецПопытки;
	АС_ЗавершитьИзменениеСтоимости(ИзменениеНачато, Истина, ОбнулитьСуммыОплат, ОбнулитьПодарочныеСертификаты);

КонецПроцедуры

&НаКлиенте
&Вместо("ПересчитатьСуммыТаблицыТоваров")
Процедура АС_ИзменитьСтоимостьРМК2(ОбнулитьСуммыОплат = Ложь)

	ИзменениеНачато = АС_НачатьИзменениеСтоимости(Неопределено);
	Попытка
		ПродолжитьВызов(ОбнулитьСуммыОплат);
	Исключение
		АС_ЗавершитьИзменениеСтоимости(ИзменениеНачато, Ложь);
		ВызватьИсключение;
	КонецПопытки;
	АС_ЗавершитьИзменениеСтоимости(ИзменениеНачато, Истина, ОбнулитьСуммыОплат, Ложь);

КонецПроцедуры

&НаКлиенте
&Вместо("РучнаяСкидкаПроцентомПоСтроке")
Процедура АС_ИзменитьСтоимостьРМК3(СтрокаЧека)

	ИзменениеНачато = АС_НачатьИзменениеСтоимости(Неопределено);
	Попытка
		ПродолжитьВызов(СтрокаЧека);
	Исключение
