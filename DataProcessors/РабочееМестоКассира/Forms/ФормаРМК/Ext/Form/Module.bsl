&НаСервере
Функция АС_ПеренестиВыручкуНаСервере(ЧекККМ)

	Если Не ЗначениеЗаполнено(ТекущаяНастройкаРМК) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		НастройкаКассы = АС_ПереносВыручкиРМКСервер.НастройкаОсновнойКассы(ТекущаяНастройкаРМК);
		Если ЗначениеЗаполнено(НастройкаКассы.Ошибка) Тогда
			Возврат НастройкаКассы.Ошибка;
		КонецЕсли;
		Если НастройкаКассы.Использовать Тогда
			АС_ПереносВыручкиРМКСервер.ОтразитьОплатуВОсновнойКассе(
				ЧекККМ, НастройкаКассы.Касса);
		КонецЕсли;
		Если НастройкаКассы.АвтоКарты Тогда
			АС_ПереносВыручкиРМКСервер.ОтразитьОплатуКартойНаСчете(
				ЧекККМ, НастройкаКассы.БанковскийСчет);
		КонецЕсли;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("АС_ПереносВыручкиРМК", УровеньЖурналаРегистрации.Ошибка,
			, ЧекККМ, ТекстОшибки);
		Возврат ТекстОшибки;
	КонецПопытки;

	Возврат "";

