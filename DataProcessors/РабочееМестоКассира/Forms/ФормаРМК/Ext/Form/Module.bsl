КонецПроцедуры

&НаКлиенте
&После("УстановитьВыбранногоКонтрагента")
Процедура АС_НастроитьПолучениеЧекаПослеВыбораПокупателя(Результат, ДополнительныеПараметры)

	Если Результат = Неопределено
		Или Не ЗначениеЗаполнено(Объект.Контрагент)
		Или ИспользоватьДисконтныеКарты
		Или ХочуБумажныйЧек Тогда
		Возврат;
	КонецЕсли;

	Если Не ИнтерфейсРМКСлужебныйКлиент.ЗаполненаКонтактнаяИнформацияДляОтправкиЧека(ЭтотОбъект) Тогда
		// Без контактов чек всё равно бумажный: согласуем с этим штатную доступность оплаты.
		УстановитьПризнакХочуБумажныйЧек(Истина);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_ТоварыРМКВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Если Поле = Неопределено
		Или Поле.Имя <> "ТоварыПредставлениеНоменклатураХарактеристика" Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено
		Или Не ЗначениеЗаполнено(ТекущиеДанные.Номенклатура) Тогда
		Возврат;
	КонецЕсли;

	ПоказатьЗначение(Неопределено, ТекущиеДанные.Номенклатура);

КонецПроцедуры

&НаКлиенте
&Вместо("ПробитьЧек")
Процедура АС_ВыбратьПоступлениеПередПробитием(Команда)

	Если АС_ПродолжитьПробитиеПослеВыбора = Истина Тогда
		АС_ПродолжитьПробитиеПослеВыбора = Ложь;
		ПродолжитьВызов(Команда);
		Возврат;
	КонецЕсли;
	Если Не Элементы.ПробитьЧек.Доступность
		Или АС_ВыборПоступленияКартыОткрыт = Истина Тогда
		Возврат;
	КонецЕсли;

	Если СуммаОплаченоБН <= 0
		Или РежимКассыСамообслуживания
		Или ЭтоЧекКоррекции
		Или Не ОбщегоНазначенияРМККлиент.ЭтоВидОперацииПродажа(Объект.ВидОперации) Тогда
		АС_УстановитьПометкуОплатыКартой("");
		ПродолжитьВызов(Команда);
		Возврат;
	КонецЕсли;

	АС_ВыборПоступленияКартыОткрыт = Истина;
	Попытка
		ПоказатьВопрос(
			Новый ОписаниеОповещения(
				"АС_ВыборПоступленияКартыЗавершение", ЭтотОбъект, Команда),
			НСтр("ru = 'Выберите, куда поступит оплата картой.'"),
			АС_ПлатежиЗаказовКлиент.ВариантыПоступленияОплаты(),
			,
			"Счет");
	Исключение
		АС_ВыборПоступленияКартыОткрыт = Ложь;
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура АС_ВыборПоступленияКартыЗавершение(Ответ, Команда) Экспорт

	Если АС_ВыборПоступленияКартыОткрыт <> Истина Тогда
		Возврат;
	КонецЕсли;
	АС_ВыборПоступленияКартыОткрыт = Ложь;
	Если Ответ <> "Счет" И Ответ <> "Озон" И Ответ <> "Сбербанк" Тогда
		Возврат;
	КонецЕсли;
	Если Не Элементы.ПробитьЧек.Доступность Или СуммаОплаченоБН <= 0 Тогда
		Возврат;
	КонецЕсли;

	ПометкаПлатежа = АС_ПлатежиЗаказовКлиент.КомментарийПоступленияОплаты(Ответ);
	АС_УстановитьПометкуОплатыКартой(ПометкаПлатежа);

	АС_ПродолжитьПробитиеПослеВыбора = Истина;
	Попытка
		ПробитьЧек(Команда);
	Исключение
		АС_ПродолжитьПробитиеПослеВыбора = Ложь;
		ВызватьИсключение;
	КонецПопытки;
	АС_ПродолжитьПробитиеПослеВыбора = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура АС_УстановитьПометкуОплатыКартой(ПометкаПлатежа)

	Если ЗначениеЗаполнено(АС_ПометкаОплатыКартой) Тогда
		ПрефиксПометки = АС_ПометкаОплатыКартой + "; ";
		Если КомментарийКЧеку = АС_ПометкаОплатыКартой Тогда
			КомментарийКЧеку = "";
		ИначеЕсли Лев(КомментарийКЧеку, СтрДлина(ПрефиксПометки)) = ПрефиксПометки Тогда
			КомментарийКЧеку = Сред(КомментарийКЧеку, СтрДлина(ПрефиксПометки) + 1);
		КонецЕсли;
	КонецЕсли;

	АС_ПометкаОплатыКартой = ПометкаПлатежа;
	Если ЗначениеЗаполнено(ПометкаПлатежа) Тогда
		КомментарийКЧеку = ПометкаПлатежа
			+ ?(ЗначениеЗаполнено(КомментарийКЧеку), "; " + КомментарийКЧеку, "");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_СброситьВыборПоступленияКарты(ПараметрыЗавершения = Неопределено)

	АС_ВыборПоступленияКартыОткрыт = Ложь;
	АС_ПродолжитьПробитиеПослеВыбора = Ложь;
	АС_ПометкаОплатыКартой = "";
	АС_ПоследнийНеокругленныйИтог = Неопределено;

КонецПроцедуры

&НаКлиенте
&Перед("ПробитьЧекНаКлиентеЗавершение")
Процедура АС_ПробитьЧекНаКлиентеЗавершение(РезультатВыполнения, Параметры)

	ЧекККМ = Неопределено;
	Если ЕстьСвойство(РезультатВыполнения, "ФискализированныйЧек") Тогда
		ЧекККМ = РезультатВыполнения.ФискализированныйЧек;
	Иначе
		ЧекККМ = ЧекККМВОбработке;
	КонецЕсли;
	Если ЕстьСвойство(РезультатВыполнения, "Результат")
		И РезультатВыполнения.Результат = Истина
		И ЗначениеЗаполнено(ЧекККМ) Тогда
		ТекстОшибкиПереноса = АС_ПеренестиВыручкуНаСервере(ЧекККМ);
		Если ЗначениеЗаполнено(ТекстОшибкиПереноса) Тогда
			Сообщить("Чек пробит, но автоматическое отражение оплаты не выполнено полностью: "
				+ ТекстОшибкиПереноса);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&Вместо("СкорректироватьНаличныеДенежныеСредстваВКассеККМКлиент")
Процедура АС_СкорректироватьНаличныеДенежныеСредстваВКассеККМКлиент(
	Отказ, Организация, КассаККМ, Знач Сумма, ЭтоВнесениеВыемка = Ложь)

	Если ЭтоВнесениеВыемка Или Не ЗначениеЗаполнено(ТекущаяНастройкаРМК) Тогда
		ПродолжитьВызов(Отказ, Организация, КассаККМ, Сумма, ЭтоВнесениеВыемка);
		Возврат;
	КонецЕсли;

	НастройкаКассы = АС_ПолучитьНастройкуОсновнойКассыНаСервере(ТекущаяНастройкаРМК);
	Если ЗначениеЗаполнено(НастройкаКассы.Ошибка) Тогда
		Сообщить(НастройкаКассы.Ошибка);
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	Если Не НастройкаКассы.Использовать
		Или Не ОбщегоНазначенияРМККлиент.ЭтоВидОперацииПродажа(Объект.ВидОперации)
		Или Сумма < Сдача Тогда
		ПродолжитьВызов(Отказ, Организация, КассаККМ, Сумма, ЭтоВнесениеВыемка);
		Возврат;
	КонецЕсли;

	// При продаже наличные покупателя уже покрывают сдачу.
	// Учетный остаток ККМ при этом не отражает деньги в основной кассе.
	КонтрольОстаткаДоВызова = КонтролироватьОстатокНаличных;
	КонтролироватьОстатокНаличных = Ложь;
	Попытка
		ПродолжитьВызов(Отказ, Организация, КассаККМ, Сумма, ЭтоВнесениеВыемка);
	Исключение
		КонтролироватьОстатокНаличных = КонтрольОстаткаДоВызова;
