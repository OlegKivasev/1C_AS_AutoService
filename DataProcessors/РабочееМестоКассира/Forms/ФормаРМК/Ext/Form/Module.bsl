&НаКлиенте
&Перед("ВыполнитьДействияПослеПробитияПоследнегоЧека")
Процедура АС_СохранитьЧекиДляОстатков(НужноЗаморозитьФорму, РезультатВыполнения)

	АС_ЧекиДляОстатковПослеПродажи = Неопределено;
	АС_ОжидатьКопииДляОстатков = Ложь;
	АС_ПродажаЗавершенаДляОстатков = Ложь;
	Если РежимКассыСамообслуживания Или ЭтоЧекКоррекции
		Или Не ОбщегоНазначенияРМККлиент.ЭтоВидОперацииПродажа(Объект.ВидОперации) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ЧекиПродажи = Новый Массив;
		Если ПробитыеЧеки.Количество() > 0 Тогда
			Для Каждого СтрокаЧека Из ПробитыеЧеки Цикл
				АС_ДобавитьЧекДляОстатков(ЧекиПродажи, СтрокаЧека.ЧекККМ);
			КонецЦикла;
		ИначеЕсли ЕстьСвойство(РезультатВыполнения, "ФискализированныйЧек") Тогда
			АС_ДобавитьЧекДляОстатков(ЧекиПродажи, РезультатВыполнения.ФискализированныйЧек);
		КонецЕсли;
		Если ЧекиПродажи.Количество() > 0 Тогда
			АС_ЧекиДляОстатковПослеПродажи = ЧекиПродажи;
			АС_ОжидатьКопииДляОстатков = ТекущийЧекЭлектронный И ХочуБумажныйЧек;
		КонецЕсли;
	Исключение
		АС_ЧекиДляОстатковПослеПродажи = Неопределено;
		Сообщить("Чек пробит. Подготовить окно остатков не удалось: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура АС_ДобавитьЧекДляОстатков(ЧекиПродажи, Чек)

	Если ТипЗнч(Чек) = Тип("ДокументСсылка.ЧекККМ")
		И ЗначениеЗаполнено(Чек) И ЧекиПродажи.Найти(Чек) = Неопределено Тогда
		ЧекиПродажи.Добавить(Чек);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&После("ПробитьЧекНаКлиентеЗавершение")
Процедура АС_ПоказатьОстаткиПослеЗавершенияПродажи(РезультатВыполнения, Параметры)

	Если АС_ЧекиДляОстатковПослеПродажи <> Неопределено Тогда
		АС_ПродажаЗавершенаДляОстатков = Истина;
		Если Не АС_ОжидатьКопииДляОстатков Тогда
			АС_ОткрытьОстаткиПослеПродажи();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&После("ЗавершитьПовторнуюПечатьФискальногоЧека")
Процедура АС_ПоказатьОстаткиПослеКопийЧека(РезультатВыполнения, ПараметрДействия)

	Если АС_ЧекиДляОстатковПослеПродажи = Неопределено
		Или Не АС_ОжидатьКопииДляОстатков Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(ПараметрДействия) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	Если Не ПараметрДействия.Свойство("ПечатьПослеПробития") Тогда
		Возврат;
	КонецЕсли;
	Если ЕстьСвойство(РезультатВыполнения, "Результат") И Не РезультатВыполнения.Результат Тогда
		// Не перекрываем штатное предупреждение об ошибке печати копии.
		АС_ЧекиДляОстатковПослеПродажи = Неопределено;
		АС_ОжидатьКопииДляОстатков = Ложь;
		Возврат;
	КонецЕсли;
	Если ПараметрДействия.ИндексЧека >= ПараметрДействия.МассивЧеков.Количество() Тогда
		АС_ОжидатьКопииДляОстатков = Ложь;
		Если АС_ПродажаЗавершенаДляОстатков = Истина Тогда
			АС_ОткрытьОстаткиПослеПродажи();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_ОткрытьОстаткиПослеПродажи()

	ЧекиПродажи = АС_ЧекиДляОстатковПослеПродажи;
	АС_ЧекиДляОстатковПослеПродажи = Неопределено;
	АС_ОжидатьКопииДляОстатков = Ложь;
	АС_ПродажаЗавершенаДляОстатков = Ложь;
	Если ЧекиПродажи = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИдентификаторыЧеков = Новый Массив;
	Для Каждого Чек Из ЧекиПродажи Цикл
		ИдентификаторыЧеков.Добавить(Строка(Чек.УникальныйИдентификатор()));
	КонецЦикла;
	КлючПродажи = СтрСоединить(ИдентификаторыЧеков, ";");
	Если АС_ЧекиПоследнегоОкнаОстатков <> Неопределено Тогда
		ВсеЧекиУжеПоказаны = Истина;
		Для Каждого Чек Из ЧекиПродажи Цикл
			Если АС_ЧекиПоследнегоОкнаОстатков.Найти(Чек) = Неопределено Тогда
				ВсеЧекиУжеПоказаны = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ВсеЧекиУжеПоказаны Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	АС_ЧекиПоследнегоОкнаОстатков = ЧекиПродажи;

	Попытка
		ОткрытьФорму("ОбщаяФорма.АС_ОстаткиПослеПродажиРМК",
			Новый Структура("АС_ЧекиПродажи", ЧекиПродажи), ЭтаФорма,
			КлючПродажи, , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Исключение
		Сообщить("Продажа завершена. Открыть остатки не удалось: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
&После("ПерейтиНаСтраницуВопросЭквайринговаяОперация")
Процедура АС_ПодтвердитьРучнуюОплатуКартой(ДанныеЭТ)

	Если Не ДанныеЭТ.ИспользоватьБезПодключенияОборудования
		Или ЗначениеЗаполнено(ДанныеЭТ.ПодключаемоеОборудование)
		Или СуммаТекущейОплатыКартой <= 0 Тогда
		Возврат;
	КонецЕсли;
	ТекущийСлойОплаты = ИнтерфейсРМКСлужебныйКлиентСервер.ПолучитьТекущийСлойГруппы(
		Элементы.ГруппаСлоевСлужебнаяИнформацияЧека);
	Если ТекущийСлойОплаты <> Элементы.ГруппаВопросЭквайринговаяОперация Тогда
		Возврат;
	КонецЕсли;

	ОтветДа(Команды.ОтветДа);

КонецПроцедуры

&НаКлиенте
Процедура АС_ПодтвердитьАвтономныйЧекРМК() Экспорт

	Если АС_ПодтверждаетсяАвтономныйЧек = Истина Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(ОповещениеАвтономнойКассы) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	Если ОповещениеАвтономнойКассы.Команда <> "CheckFiscalization" Тогда
		Возврат;
	КонецЕсли;
	Если ИнтерфейсРМКСлужебныйКлиентСервер.ИспользоватьСлои(ЭтотОбъект) Тогда
		ТекущийСлойЧека = ИнтерфейсРМКСлужебныйКлиентСервер.ПолучитьТекущийСлойГруппы(
			Элементы.ГруппаСлоевСлужебнаяИнформацияЧека);
		Если ТекущийСлойЧека <> Элементы.ГруппаВопросАвтономнаяКасса Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	АС_ПодтверждаетсяАвтономныйЧек = Истина;
	Попытка
		ОтветДаАвтономнаяКасса(Команды.ОтветДаАвтономнаяКасса);
	Исключение
		АС_ПодтверждаетсяАвтономныйЧек = Ложь;
		ВызватьИсключение;
	КонецПопытки;
	АС_ПодтверждаетсяАвтономныйЧек = Ложь;

КонецПроцедуры

