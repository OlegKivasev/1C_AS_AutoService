&НаСервере
Процедура АС_НастроитьТаблицуТоваровРМК()

	Элементы.Товары.Шапка = Истина;
	Элементы.ТоварыИндексКартинки.Видимость = Ложь;
	Элементы.ТоварыГруппаПредставлениеНоменклатура.Заголовок = "Товар";
	Элементы.ТоварыГруппаПредставлениеНоменклатура.ОтображатьВШапке = Истина;
	Элементы.ТоварыПредставлениеНоменклатураХарактеристика.ОтображатьВШапке = Ложь;
	Элементы.ТоварыПредставлениеКодАртикул.ОтображатьВШапке = Ложь;
	Элементы.ТоварыЦена.Заголовок = "Цена";
	Элементы.ТоварыГруппаКоличествоЕдиниц.Заголовок = "Количество";
	Элементы.ТоварыГруппаКоличествоЕдиниц.ОтображатьВШапке = Истина;
	Элементы.ТоварыКоличество.ОтображатьВШапке = Ложь;
	Элементы.ТоварыКоличествоСобрано.ОтображатьВШапке = Ложь;
	Элементы.ТоварыПредставлениеЕдиницыИзмерения.ОтображатьВШапке = Ложь;
	Элементы.ТоварыПредставлениеЕдиницыИзмерения.Видимость = Ложь;
	Элементы.ТоварыСуммаСкидокОбщая.Заголовок = "Скидка";
	Элементы.ТоварыСумма.Заголовок = "Сумма";

	Элементы.ТоварыПредставлениеНоменклатураХарактеристика.Гиперссылка = Истина;
	Элементы.ТоварыПредставлениеНоменклатураХарактеристика.ГиперссылкаЯчейки = Истина;
	Элементы.Товары.УстановитьДействие("Выбор", "АС_ТоварыРМКВыбор");

КонецПроцедуры

&НаСервере
Процедура АС_СкрытьЛишниеЭлементыРМК()

	// Скрываем содержимое QR-групп: штатные процедуры повторно включают их родителей.
	Элементы.ОплатаНаличнымиВТихомРежиме.Видимость = Ложь;
	Элементы.ДекорацияОплатаНаличными.Видимость = Ложь;
	Элементы.ГруппаQRCodeНаличныеПодсказка.Видимость = Ложь;
	Элементы.ДекорацияОтступQRНаличными.Видимость = Ложь;
	Элементы.ОплатаКартойВТихомРежиме.Видимость = Ложь;
	Элементы.ДекорацияОплатаКартой.Видимость = Ложь;
	Элементы.ГруппаQRCodeКартаПодсказка.Видимость = Ложь;
	Элементы.ДекорацияОтступQRКартой.Видимость = Ложь;
	Элементы.ГруппаЧекЛес.Видимость = Ложь;

КонецПроцедуры

&НаКлиенте
&После("УстановитьВыбранногоКонтрагента")
Процедура АС_НастроитьПолучениеЧекаПослеВыбораПокупателя(Результат, ДополнительныеПараметры)

	Если Результат = Неопределено
		Или Не ЗначениеЗаполнено(Объект.Контрагент)
		Или ИспользоватьДисконтныеКарты
		Или ХочуБумажныйЧек Тогда
		Возврат;
	КонецЕсли;

	Если Не ИнтерфейсРМКСлужебныйКлиент.ЗаполненаКонтактнаяИнформацияДляОтправкиЧека(ЭтотОбъект) Тогда
		// Без контактов чек всё равно бумажный: согласуем с этим штатную доступность оплаты.
		УстановитьПризнакХочуБумажныйЧек(Истина);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_ТоварыРМКВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Если Поле = Неопределено
		Или Поле.Имя <> "ТоварыПредставлениеНоменклатураХарактеристика" Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено
		Или Не ЗначениеЗаполнено(ТекущиеДанные.Номенклатура) Тогда
		Возврат;
	КонецЕсли;

	ПоказатьЗначение(Неопределено, ТекущиеДанные.Номенклатура);

КонецПроцедуры

&НаКлиенте
&Вместо("ПробитьЧек")
Процедура АС_ВыбратьПоступлениеПередПробитием(Команда)

	Если АС_ПродолжитьПробитиеПослеВыбора = Истина Тогда
		АС_ПродолжитьПробитиеПослеВыбора = Ложь;
		ПродолжитьВызов(Команда);
		Возврат;
	КонецЕсли;
	Если Не Элементы.ПробитьЧек.Доступность
		Или АС_ВыборПоступленияКартыОткрыт = Истина Тогда
		Возврат;
	КонецЕсли;

	Если СуммаОплаченоБН <= 0
		Или РежимКассыСамообслуживания
		Или ЭтоЧекКоррекции
		Или Не ОбщегоНазначенияРМККлиент.ЭтоВидОперацииПродажа(Объект.ВидОперации) Тогда
		АС_УстановитьПометкуОплатыКартой("");
		ПродолжитьВызов(Команда);
		Возврат;
	КонецЕсли;

	АС_ВыборПоступленияКартыОткрыт = Истина;
	Попытка
		ПоказатьВопрос(
			Новый ОписаниеОповещения(
				"АС_ВыборПоступленияКартыЗавершение", ЭтотОбъект, Команда),
			НСтр("ru = 'Выберите, куда поступит оплата картой.'"),
			АС_ПлатежиЗаказовКлиент.ВариантыПоступленияОплаты(),
			,
			"Счет");
	Исключение
		АС_ВыборПоступленияКартыОткрыт = Ложь;
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура АС_ВыборПоступленияКартыЗавершение(Ответ, Команда) Экспорт

	Если АС_ВыборПоступленияКартыОткрыт <> Истина Тогда
		Возврат;
	КонецЕсли;
	АС_ВыборПоступленияКартыОткрыт = Ложь;
	Если Ответ <> "Счет" И Ответ <> "Озон" И Ответ <> "Сбербанк" Тогда
		Возврат;
	КонецЕсли;
	Если Не Элементы.ПробитьЧек.Доступность Или СуммаОплаченоБН <= 0 Тогда
		Возврат;
	КонецЕсли;

	ПометкаПлатежа = АС_ПлатежиЗаказовКлиент.КомментарийПоступленияОплаты(Ответ);
	АС_УстановитьПометкуОплатыКартой(ПометкаПлатежа);

	АС_ПродолжитьПробитиеПослеВыбора = Истина;
	Попытка
		ПробитьЧек(Команда);
	Исключение
		АС_ПродолжитьПробитиеПослеВыбора = Ложь;
		ВызватьИсключение;
	КонецПопытки;
	АС_ПродолжитьПробитиеПослеВыбора = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура АС_УстановитьПометкуОплатыКартой(ПометкаПлатежа)

	Если ЗначениеЗаполнено(АС_ПометкаОплатыКартой) Тогда
		ПрефиксПометки = АС_ПометкаОплатыКартой + "; ";
		Если КомментарийКЧеку = АС_ПометкаОплатыКартой Тогда
			КомментарийКЧеку = "";
		ИначеЕсли Лев(КомментарийКЧеку, СтрДлина(ПрефиксПометки)) = ПрефиксПометки Тогда
			КомментарийКЧеку = Сред(КомментарийКЧеку, СтрДлина(ПрефиксПометки) + 1);
		КонецЕсли;
	КонецЕсли;

	АС_ПометкаОплатыКартой = ПометкаПлатежа;
	Если ЗначениеЗаполнено(ПометкаПлатежа) Тогда
		КомментарийКЧеку = ПометкаПлатежа
			+ ?(ЗначениеЗаполнено(КомментарийКЧеку), "; " + КомментарийКЧеку, "");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&После("СоздатьНовыйНабор")
Процедура АС_СброситьВыборПоступленияКарты(ПараметрыЗавершения = Неопределено)

	АС_ВыборПоступленияКартыОткрыт = Ложь;
	АС_ПродолжитьПробитиеПослеВыбора = Ложь;
	АС_ПометкаОплатыКартой = "";
	АС_ПоследнийНеокругленныйИтог = Неопределено;

КонецПроцедуры

&НаКлиенте
&Перед("ПробитьЧекНаКлиентеЗавершение")
Процедура АС_ПробитьЧекНаКлиентеЗавершение(РезультатВыполнения, Параметры)

	ЧекККМ = Неопределено;
	Если ЕстьСвойство(РезультатВыполнения, "ФискализированныйЧек") Тогда
		ЧекККМ = РезультатВыполнения.ФискализированныйЧек;
	Иначе
		ЧекККМ = ЧекККМВОбработке;
	КонецЕсли;
	Если ЕстьСвойство(РезультатВыполнения, "Результат")
		И РезультатВыполнения.Результат = Истина
		И ЗначениеЗаполнено(ЧекККМ) Тогда
		ТекстОшибкиПереноса = АС_ПеренестиВыручкуНаСервере(ЧекККМ);
		Если ЗначениеЗаполнено(ТекстОшибкиПереноса) Тогда
			Сообщить("Чек пробит, но автоматическое отражение оплаты не выполнено полностью: "
				+ ТекстОшибкиПереноса);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&Вместо("СкорректироватьНаличныеДенежныеСредстваВКассеККМКлиент")
Процедура АС_СкорректироватьНаличныеДенежныеСредстваВКассеККМКлиент(
	Отказ, Организация, КассаККМ, Знач Сумма, ЭтоВнесениеВыемка = Ложь)

	Если ЭтоВнесениеВыемка Или Не ЗначениеЗаполнено(ТекущаяНастройкаРМК) Тогда
		ПродолжитьВызов(Отказ, Организация, КассаККМ, Сумма, ЭтоВнесениеВыемка);
		Возврат;
	КонецЕсли;

	НастройкаКассы = АС_ПолучитьНастройкуОсновнойКассыНаСервере(ТекущаяНастройкаРМК);
	Если ЗначениеЗаполнено(НастройкаКассы.Ошибка) Тогда
		Сообщить(НастройкаКассы.Ошибка);
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	Если Не НастройкаКассы.Использовать
		Или Не ОбщегоНазначенияРМККлиент.ЭтоВидОперацииПродажа(Объект.ВидОперации)
		Или Сумма < Сдача Тогда
		ПродолжитьВызов(Отказ, Организация, КассаККМ, Сумма, ЭтоВнесениеВыемка);
		Возврат;
	КонецЕсли;

	// При продаже наличные покупателя уже покрывают сдачу.
	// Учетный остаток ККМ при этом не отражает деньги в основной кассе.
	КонтрольОстаткаДоВызова = КонтролироватьОстатокНаличных;
	КонтролироватьОстатокНаличных = Ложь;
	Попытка
		ПродолжитьВызов(Отказ, Организация, КассаККМ, Сумма, ЭтоВнесениеВыемка);
	Исключение
		КонтролироватьОстатокНаличных = КонтрольОстаткаДоВызова;
		ВызватьИсключение;
	КонецПопытки;
	КонтролироватьОстатокНаличных = КонтрольОстаткаДоВызова;

КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_ПолучитьНастройкуОсновнойКассыНаСервере(СсылкаНастройки)
	Попытка
		Возврат АС_ПереносВыручкиРМКСервер.НастройкаОсновнойКассы(СсылкаНастройки);
	Исключение
		Возврат Новый Структура("Использовать, Касса, Ошибка", Ложь, Неопределено,
			"Не удалось прочитать настройку основной кассы РМК: " + ОписаниеОшибки());
	КонецПопытки;
КонецФункции

&НаСервере
Функция АС_ПеренестиВыручкуНаСервере(ЧекККМ)

	Если Не ЗначениеЗаполнено(ТекущаяНастройкаРМК) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		НастройкаКассы = АС_ПереносВыручкиРМКСервер.НастройкаОсновнойКассы(ТекущаяНастройкаРМК);
		Если ЗначениеЗаполнено(НастройкаКассы.Ошибка) Тогда
			Возврат НастройкаКассы.Ошибка;
		КонецЕсли;
		Если НастройкаКассы.Использовать Тогда
			АС_ПереносВыручкиРМКСервер.ОтразитьОплатуВОсновнойКассе(
				ЧекККМ, НастройкаКассы.Касса);
		КонецЕсли;
		Если НастройкаКассы.АвтоКарты Тогда
			АС_ПереносВыручкиРМКСервер.ОтразитьОплатуКартойНаСчете(
				ЧекККМ, НастройкаКассы.БанковскийСчет);
		КонецЕсли;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("АС_ПереносВыручкиРМК", УровеньЖурналаРегистрации.Ошибка,
			, ЧекККМ, ТекстОшибки);
		Возврат ТекстОшибки;
	КонецПопытки;

	Возврат "";

КонецФункции


&НаКлиенте
&Перед("ВыполнитьДействияПослеПробитияПоследнегоЧека")
Процедура АС_СохранитьЧекиДляОстатков(НужноЗаморозитьФорму, РезультатВыполнения)

	АС_ЧекиДляОстатковПослеПродажи = Неопределено;
	АС_ОжидатьКопииДляОстатков = Ложь;
	АС_ПродажаЗавершенаДляОстатков = Ложь;
	Если РежимКассыСамообслуживания Или ЭтоЧекКоррекции
		Или Не ОбщегоНазначенияРМККлиент.ЭтоВидОперацииПродажа(Объект.ВидОперации) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ЧекиПродажи = Новый Массив;
		Если ПробитыеЧеки.Количество() > 0 Тогда
			Для Каждого СтрокаЧека Из ПробитыеЧеки Цикл
				АС_ДобавитьЧекДляОстатков(ЧекиПродажи, СтрокаЧека.ЧекККМ);
			КонецЦикла;
		ИначеЕсли ЕстьСвойство(РезультатВыполнения, "ФискализированныйЧек") Тогда
			АС_ДобавитьЧекДляОстатков(ЧекиПродажи, РезультатВыполнения.ФискализированныйЧек);
		КонецЕсли;
		Если ЧекиПродажи.Количество() > 0 Тогда
			АС_ЧекиДляОстатковПослеПродажи = ЧекиПродажи;
			АС_ОжидатьКопииДляОстатков = ТекущийЧекЭлектронный И ХочуБумажныйЧек;
		КонецЕсли;
	Исключение
		АС_ЧекиДляОстатковПослеПродажи = Неопределено;
		Сообщить("Чек пробит. Подготовить окно остатков не удалось: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура АС_ДобавитьЧекДляОстатков(ЧекиПродажи, Чек)

	Если ТипЗнч(Чек) = Тип("ДокументСсылка.ЧекККМ")
		И ЗначениеЗаполнено(Чек) И ЧекиПродажи.Найти(Чек) = Неопределено Тогда
		ЧекиПродажи.Добавить(Чек);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&После("ПробитьЧекНаКлиентеЗавершение")
Процедура АС_ПоказатьОстаткиПослеЗавершенияПродажи(РезультатВыполнения, Параметры)

	Если АС_ЧекиДляОстатковПослеПродажи <> Неопределено Тогда
		АС_ПродажаЗавершенаДляОстатков = Истина;
		Если Не АС_ОжидатьКопииДляОстатков Тогда
			АС_ОткрытьОстаткиПослеПродажи();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&После("ЗавершитьПовторнуюПечатьФискальногоЧека")
Процедура АС_ПоказатьОстаткиПослеКопийЧека(РезультатВыполнения, ПараметрДействия)

	Если АС_ЧекиДляОстатковПослеПродажи = Неопределено
		Или Не АС_ОжидатьКопииДляОстатков Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(ПараметрДействия) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	Если Не ПараметрДействия.Свойство("ПечатьПослеПробития") Тогда
		Возврат;
	КонецЕсли;
	Если ЕстьСвойство(РезультатВыполнения, "Результат") И Не РезультатВыполнения.Результат Тогда
		// Не перекрываем штатное предупреждение об ошибке печати копии.
		АС_ЧекиДляОстатковПослеПродажи = Неопределено;
		АС_ОжидатьКопииДляОстатков = Ложь;
		Возврат;
	КонецЕсли;
	Если ПараметрДействия.ИндексЧека >= ПараметрДействия.МассивЧеков.Количество() Тогда
		АС_ОжидатьКопииДляОстатков = Ложь;
		Если АС_ПродажаЗавершенаДляОстатков = Истина Тогда
			АС_ОткрытьОстаткиПослеПродажи();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_ОткрытьОстаткиПослеПродажи()

	ЧекиПродажи = АС_ЧекиДляОстатковПослеПродажи;
	АС_ЧекиДляОстатковПослеПродажи = Неопределено;
	АС_ОжидатьКопииДляОстатков = Ложь;
	АС_ПродажаЗавершенаДляОстатков = Ложь;
	Если ЧекиПродажи = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИдентификаторыЧеков = Новый Массив;
	Для Каждого Чек Из ЧекиПродажи Цикл
		ИдентификаторыЧеков.Добавить(Строка(Чек.УникальныйИдентификатор()));
	КонецЦикла;
	КлючПродажи = СтрСоединить(ИдентификаторыЧеков, ";");
	Если АС_ЧекиПоследнегоОкнаОстатков <> Неопределено Тогда
		ВсеЧекиУжеПоказаны = Истина;
		Для Каждого Чек Из ЧекиПродажи Цикл
			Если АС_ЧекиПоследнегоОкнаОстатков.Найти(Чек) = Неопределено Тогда
				ВсеЧекиУжеПоказаны = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ВсеЧекиУжеПоказаны Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	АС_ЧекиПоследнегоОкнаОстатков = ЧекиПродажи;

	Попытка
		ОткрытьФорму("ОбщаяФорма.АС_ОстаткиПослеПродажиРМК",
			Новый Структура("АС_ЧекиПродажи", ЧекиПродажи), ЭтаФорма,
			КлючПродажи, , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Исключение
		Сообщить("Продажа завершена. Открыть остатки не удалось: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
&После("ПерейтиНаСтраницуВопросЭквайринговаяОперация")
Процедура АС_ПодтвердитьРучнуюОплатуКартой(ДанныеЭТ)

	Если Не ДанныеЭТ.ИспользоватьБезПодключенияОборудования
		Или ЗначениеЗаполнено(ДанныеЭТ.ПодключаемоеОборудование)
		Или СуммаТекущейОплатыКартой <= 0 Тогда
		Возврат;
	КонецЕсли;
	ТекущийСлойОплаты = ИнтерфейсРМКСлужебныйКлиентСервер.ПолучитьТекущийСлойГруппы(
		Элементы.ГруппаСлоевСлужебнаяИнформацияЧека);
	Если ТекущийСлойОплаты <> Элементы.ГруппаВопросЭквайринговаяОперация Тогда
		Возврат;
	КонецЕсли;

	ОтветДа(Команды.ОтветДа);

КонецПроцедуры

&НаКлиенте
Процедура АС_ПодтвердитьАвтономныйЧекРМК() Экспорт

	Если АС_ПодтверждаетсяАвтономныйЧек = Истина Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(ОповещениеАвтономнойКассы) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	Если ОповещениеАвтономнойКассы.Команда <> "CheckFiscalization" Тогда
		Возврат;
	КонецЕсли;
	Если ИнтерфейсРМКСлужебныйКлиентСервер.ИспользоватьСлои(ЭтотОбъект) Тогда
		ТекущийСлойЧека = ИнтерфейсРМКСлужебныйКлиентСервер.ПолучитьТекущийСлойГруппы(
			Элементы.ГруппаСлоевСлужебнаяИнформацияЧека);
		Если ТекущийСлойЧека <> Элементы.ГруппаВопросАвтономнаяКасса Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	АС_ПодтверждаетсяАвтономныйЧек = Истина;
	Попытка
		ОтветДаАвтономнаяКасса(Команды.ОтветДаАвтономнаяКасса);
	Исключение
		АС_ПодтверждаетсяАвтономныйЧек = Ложь;
		ВызватьИсключение;
	КонецПопытки;
	АС_ПодтверждаетсяАвтономныйЧек = Ложь;

КонецПроцедуры

&НаСервере
&После("ПриСозданииНаСервере")
Процедура АС_СоздатьКолонкиОкругленияЦен(Отказ, СтандартнаяОбработка)

	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	ТипЦены = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Неотрицательный));
	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("АС_ЦенаДоОкругленияРМК", ТипЦены, "Объект.Товары"));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("АС_ЦенаПослеОкругленияРМК", ТипЦены, "Объект.Товары"));
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	АС_ПрочитатьИсходныеЦеныОтложенногоЧека();
	АС_НастроитьТаблицуТоваровРМК();
	АС_СкрытьЛишниеЭлементыРМК();

КонецПроцедуры

&НаСервере
&После("ПродолжитьЧек")
Процедура АС_ПослеЗагрузкиОтложенногоЧека(ДанныеКонтроляПродаж)
	АС_ПрочитатьИсходныеЦеныОтложенногоЧека();
КонецПроцедуры

&НаСервере
Процедура АС_ПрочитатьИсходныеЦеныОтложенногоЧека()

	Если Не ЗначениеЗаполнено(ОтложенныйЧек)
		Или ТипЗнч(ОтложенныйЧек) <> Тип("ДокументСсылка.ЧекККМ") Тогда
		Возврат;
	КонецЕсли;
	ЦеныСтрок = Новый Соответствие;
	Для Каждого СтрокаДокумента Из ОтложенныйЧек.Запасы Цикл
		ЦеныСтрок.Вставить(СтрокаДокумента.КлючСвязи,
			Новый Структура("ИсходнаяЦена, ОкругленнаяЦена",
				СтрокаДокумента.АС_ЦенаДоОкругленияРМК, СтрокаДокумента.АС_ЦенаПослеОкругленияРМК));
	КонецЦикла;
	Для Каждого СтрокаЧека Из Объект.Товары Цикл
		ЦеныСтроки = ЦеныСтрок.Получить(СтрокаЧека.КлючСвязиЧекаПродажи);
		Если ЦеныСтроки <> Неопределено Тогда
			СтрокаЧека.АС_ЦенаДоОкругленияРМК = ЦеныСтроки.ИсходнаяЦена;
			СтрокаЧека.АС_ЦенаПослеОкругленияРМК = ЦеныСтроки.ОкругленнаяЦена;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
&После("ПродолжитьЧекКлиентЗавершение")
Процедура АС_ОкруглитьВозобновленныйЧек()
	ПересчитатьИтогиТабличнойЧастиТовары(Ложь, Ложь);
КонецПроцедуры

&НаКлиенте
&Вместо("ПересчитатьСуммыТаблицыТоваров")
Процедура АС_ПересчитатьТоварыБезПромежуточногоОкругления(ОбнулитьСуммыОплат = Ложь)

	Если АС_ПересчитываетсяОкруглениеЦен = Истина Тогда
		ПродолжитьВызов(ОбнулитьСуммыОплат);
		Возврат;
	КонецЕсли;
	АС_ПересчитываетсяОкруглениеЦен = Истина;
	Попытка
		АС_ВосстановитьЦеныДоОкругления();
		ПродолжитьВызов(ОбнулитьСуммыОплат);
	Исключение
		АС_ПересчитываетсяОкруглениеЦен = Ложь;
		ВызватьИсключение;
	КонецПопытки;
	АС_ПересчитываетсяОкруглениеЦен = Ложь;
	ПересчитатьИтогиТабличнойЧастиТовары(ОбнулитьСуммыОплат, Ложь);

КонецПроцедуры

&НаКлиенте
&Вместо("ПересчитатьИтогиТабличнойЧастиТовары")
Процедура АС_ПересчитатьИтогиСОкруглениемЦены(ОбнулитьСуммыОплат = Истина,
	ОбнулитьПодарочныеСертификаты = Истина, ПослеУдаленияСтроки = Ложь)

	Если АС_ПересчитываетсяОкруглениеЦен = Истина
		Или ЭтоЧекКоррекции
		Или Не ОбщегоНазначенияРМККлиент.ЭтоВидОперацииПродажа(Объект.ВидОперации) Тогда
		ПродолжитьВызов(ОбнулитьСуммыОплат, ОбнулитьПодарочныеСертификаты, ПослеУдаленияСтроки);
		Возврат;
	КонецЕсли;

	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	ОбновлятьЦенуВКарточке = Ложь;
	Если ТекущаяСтрока <> Неопределено Тогда
		ОбновлятьЦенуВКарточке = ТекущийТоварЦенаИзКарточки = ТекущаяСтрока.Цена;
	КонецЕсли;
	АС_ПересчитываетсяОкруглениеЦен = Истина;
	Попытка
		АС_ВосстановитьЦеныДоОкругления();
		АС_ОкруглитьИтогИзменениемЦены();
		ПродолжитьВызов(ОбнулитьСуммыОплат, ОбнулитьПодарочныеСертификаты, ПослеУдаленияСтроки);
		ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
		Если ОбновлятьЦенуВКарточке И ТекущаяСтрока <> Неопределено Тогда
			ТекущийТоварЦенаИзКарточки = ТекущаяСтрока.Цена;
		КонецЕсли;
	Исключение
		АС_ПересчитываетсяОкруглениеЦен = Ложь;
		ВызватьИсключение;
	КонецПопытки;
	АС_ПересчитываетсяОкруглениеЦен = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура АС_ВосстановитьЦеныДоОкругления()

	Для Каждого СтрокаЧека Из Объект.Товары Цикл
		Если СтрокаЧека.АС_ЦенаДоОкругленияРМК <= 0 Или СтрокаЧека.Оплачена Тогда
			Продолжить;
		КонецЕсли;
		ИсходнаяЦена = СтрокаЧека.АС_ЦенаДоОкругленияРМК;
		ОкругленнаяЦена = СтрокаЧека.АС_ЦенаПослеОкругленияРМК;
		СтрокаЧека.АС_ЦенаДоОкругленияРМК = 0;
		СтрокаЧека.АС_ЦенаПослеОкругленияРМК = 0;
		// Новая цена, введенная пользователем или заполненная по виду цен,
		// становится исходной и не затирается предыдущим округлением.
		Если СтрокаЧека.Цена = ОкругленнаяЦена Тогда
			СтрокаЧека.Цена = ИсходнаяЦена;
			ПересчитатьСуммы(СтрокаЧека, Ложь, Ложь);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура АС_ОкруглитьИтогИзменениемЦены()

	ИсходныйИтог = Окр(Объект.Товары.Итог("Сумма"), 2);
	Если ИсходныйИтог <= 200 Тогда
		АС_ПоследнийНеокругленныйИтог = Неопределено;
		Возврат;
	КонецЕсли;
	ПравилоОкругления = ПредопределенноеЗначение("Перечисление.ПорядкиОкругления.Окр50");
	ЦелевойИтог = ЦенообразованиеКлиентСервер.ОкруглитьЦену(ИсходныйИтог, ПравилоОкругления, Ложь);
	Если ЦелевойИтог = ИсходныйИтог Тогда
		АС_ПоследнийНеокругленныйИтог = Неопределено;
		Возврат;
	КонецЕсли;

	// Сначала пробуем количество 1: цена с двумя знаками позволяет
	// точно перенести на такую строку любую рублевую поправку итога.
	Для ПриоритетКоличество = 1 По 2 Цикл
		Для Каждого СтрокаЧека Из Объект.Товары Цикл
			Если Не АС_МожноОкруглитьЦенуСтроки(СтрокаЧека) Тогда
				Продолжить;
			КонецЕсли;
			Если (ПриоритетКоличество = 1 И СтрокаЧека.Количество <> 1)
				Или (ПриоритетКоличество = 2 И СтрокаЧека.Количество = 1) Тогда
				Продолжить;
			КонецЕсли;
			Если АС_ПодобратьЦенуДляИтога(СтрокаЧека, ИсходныйИтог, ЦелевойИтог) Тогда
				АС_ПоследнийНеокругленныйИтог = Неопределено;
				Возврат;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Если АС_ПоследнийНеокругленныйИтог <> ИсходныйИтог Тогда
		Сообщить("Итог чека не округлён: нет подходящей позиции, цену которой можно изменить до точной суммы чека.");
		АС_ПоследнийНеокругленныйИтог = ИсходныйИтог;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция АС_МожноОкруглитьЦенуСтроки(СтрокаЧека)

	Возврат СтрокаЧека.Количество > 0 И СтрокаЧека.Цена > 0
		И Не СтрокаЧека.Оплачена И Не СтрокаЧека.Подарок
		И Не СтрокаЧека.ЭтоНабор И СтрокаЧека.НомерНабора = 0
		И Не СтрокаЧека.ЭтоПодарочныйСертификат И Не СтрокаЧека.ЭтоТабачнаяПродукция
		И Не ЗначениеЗаполнено(СтрокаЧека.МРЦ) И Не ЗначениеЗаполнено(СтрокаЧека.ЕМРЦ);

КонецФункции

&НаКлиенте
Функция АС_ПодобратьЦенуДляИтога(СтрокаЧека, ИсходныйИтог, ЦелевойИтог)

	ИсходнаяЦена = СтрокаЧека.Цена;
	НоваяЦена = Окр(ИсходнаяЦена + (ЦелевойИтог - ИсходныйИтог) / СтрокаЧека.Количество, 2);
	ПроверенныеЦены = Новый Массив;
	Для НомерПопытки = 1 По 4 Цикл
		Если НоваяЦена <= 0 Или НоваяЦена < СтрокаЧека.МинимальнаяЦена
			Или НоваяЦена = ИсходнаяЦена
			Или ПроверенныеЦены.Найти(НоваяЦена) <> Неопределено Тогда
			Прервать;
		КонецЕсли;
		ПроверенныеЦены.Добавить(НоваяЦена);
		СтрокаЧека.Цена = НоваяЦена;
		ПересчитатьСуммы(СтрокаЧека, Ложь, Ложь);
		ФактическийИтог = Окр(Объект.Товары.Итог("Сумма"), 2);
		Если ФактическийИтог = ЦелевойИтог
			И СтрокаЧека.Сумма >= Окр(СтрокаЧека.МинимальнаяЦена * СтрокаЧека.Количество, 2) Тогда
			СтрокаЧека.АС_ЦенаДоОкругленияРМК = ИсходнаяЦена;
			СтрокаЧека.АС_ЦенаПослеОкругленияРМК = НоваяЦена;
			Возврат Истина;
		КонецЕсли;

		ИзменениеИтога = ФактическийИтог - ИсходныйИтог;
		Если ИзменениеИтога = 0 Тогда
			Прервать;
		КонецЕсли;
		ВлияниеЦеныНаИтог = ИзменениеИтога / (НоваяЦена - ИсходнаяЦена);
		НоваяЦена = Окр(НоваяЦена + (ЦелевойИтог - ФактическийИтог) / ВлияниеЦеныНаИтог, 2);
	КонецЦикла;

	СтрокаЧека.Цена = ИсходнаяЦена;
	ПересчитатьСуммы(СтрокаЧека, Ложь, Ложь);
	Возврат Ложь;

КонецФункции
