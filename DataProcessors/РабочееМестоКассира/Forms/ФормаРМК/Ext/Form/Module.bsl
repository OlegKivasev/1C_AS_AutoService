&НаСервере
Процедура АС_НастроитьОтборНаличияРМК()

	ТекстЗапроса = СписокТоваров.ТекстЗапроса;
	Если СтрНайти(ТекстЗапроса, "&АС_ТолькоЗапасыВНаличии") = 0 Тогда
		НачалоДоРазвертки = СтрНайти(ТекстЗапроса, "ПОМЕСТИТЬ ДоРазвертки");
		Если НачалоДоРазвертки = 0 Тогда
			ВызватьИсключение "Не удалось настроить отбор запасов в наличии для поиска РМК.";
		КонецЕсли;
		ТекстДоРазвертки = Сред(ТекстЗапроса, НачалоДоРазвертки);
		ДлинаДоРазвертки = СтрНайти(ТекстДоРазвертки, ";");
		Если ДлинаДоРазвертки = 0 Тогда
			ВызватьИсключение "Не удалось настроить отбор запасов в наличии для поиска РМК.";
		КонецЕсли;
		БлокДоРазвертки = Лев(ТекстДоРазвертки, ДлинаДоРазвертки - 1);
		Если СтрНайти(ВРег(БлокДоРазвертки), "ГДЕ") > 0 Тогда
			ВызватьИсключение "Изменилась структура поиска РМК. Требуется обновить отбор наличия.";
		КонецЕсли;

		// Отбираем варианты до свертки по номенклатуре, сохраняя характеристики и упаковки.
		УсловиеНаличия =
			"ГДЕ
			| НЕ &АС_ТолькоЗапасыВНаличии
			| ИЛИ (ТаблицаКоэффициентыУпаковок.Номенклатура.ТипНоменклатуры
			|     = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)
			|   И ЕСТЬNULL(ТаблицаОстатки.Количество, 0) > 0)";
		ПозицияРазделителя = НачалоДоРазвертки + ДлинаДоРазвертки - 1;
		НовыйТекстЗапроса = Лев(ТекстЗапроса, ПозицияРазделителя - 1)
			+ Символы.ПС + УсловиеНаличия + Символы.ПС
			+ Сред(ТекстЗапроса, ПозицияРазделителя);

		СохраненныеПараметры = Новый Массив;
		Для Каждого ПараметрСписка Из СписокТоваров.Параметры.Элементы Цикл
			СохраненныеПараметры.Добавить(
				Новый Структура("Имя, Значение, Использование",
					Строка(ПараметрСписка.Параметр),
					ПараметрСписка.Значение, ПараметрСписка.Использование));
		КонецЦикла;

		СписокТоваров.ТекстЗапроса = НовыйТекстЗапроса;
		Для Каждого СохраненныйПараметр Из СохраненныеПараметры Цикл
			ПараметрСписка = СписокТоваров.Параметры.Элементы.Найти(СохраненныйПараметр.Имя);
			Если ПараметрСписка <> Неопределено Тогда
				ПараметрСписка.Значение = СохраненныйПараметр.Значение;
				ПараметрСписка.Использование = СохраненныйПараметр.Использование;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	ИспользоватьОтбор = ОбщегоНазначенияРМК.ЭтоВидОперацииПродажа(Объект.ВидОперации)
		И Не РежимВыбораПодарка
		И Не РежимВыбораПодарочногоСертификата
		И Не РежимВыбораХарактеристики
		И Не РучноеСопоставлениеТовара;
	СписокТоваров.Параметры.УстановитьЗначениеПараметра(
		"АС_ТолькоЗапасыВНаличии", ИспользоватьОтбор);

КонецПроцедуры

