&НаКлиенте
&Перед("ПробитьЧекНаКлиентеЗавершение")
Процедура АС_ПробитьЧекНаКлиентеЗавершение(РезультатВыполнения, Параметры)

	ЧекККМ = Неопределено;
	Если ЕстьСвойство(РезультатВыполнения, "ФискализированныйЧек") Тогда
		ЧекККМ = РезультатВыполнения.ФискализированныйЧек;
	Иначе
		ЧекККМ = ЧекККМВОбработке;
	КонецЕсли;
	Если ЕстьСвойство(РезультатВыполнения, "Результат")
		И РезультатВыполнения.Результат = Истина
		И ЗначениеЗаполнено(ЧекККМ) Тогда
		ТекстОшибкиПереноса = АС_ПеренестиВыручкуНаСервере(ЧекККМ);
		Если ЗначениеЗаполнено(ТекстОшибкиПереноса) Тогда
			Сообщить("Чек пробит, но автоматическое отражение оплаты не выполнено полностью: "
				+ ТекстОшибкиПереноса);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&Вместо("СкорректироватьНаличныеДенежныеСредстваВКассеККМКлиент")
Процедура АС_СкорректироватьНаличныеДенежныеСредстваВКассеККМКлиент(
	Отказ, Организация, КассаККМ, Знач Сумма, ЭтоВнесениеВыемка = Ложь)

	Если ЭтоВнесениеВыемка Или Не ЗначениеЗаполнено(ТекущаяНастройкаРМК) Тогда
		ПродолжитьВызов(Отказ, Организация, КассаККМ, Сумма, ЭтоВнесениеВыемка);
		Возврат;
	КонецЕсли;

	НастройкаКассы = АС_ПолучитьНастройкуОсновнойКассыНаСервере(ТекущаяНастройкаРМК);
	Если ЗначениеЗаполнено(НастройкаКассы.Ошибка) Тогда
		Сообщить(НастройкаКассы.Ошибка);
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	Если Не НастройкаКассы.Использовать
		Или Не ОбщегоНазначенияРМККлиент.ЭтоВидОперацииПродажа(Объект.ВидОперации)
		Или Сумма < Сдача Тогда
		ПродолжитьВызов(Отказ, Организация, КассаККМ, Сумма, ЭтоВнесениеВыемка);
		Возврат;
	КонецЕсли;

	// При продаже наличные покупателя уже покрывают сдачу.
	// Учетный остаток ККМ при этом не отражает деньги в основной кассе.
	КонтрольОстаткаДоВызова = КонтролироватьОстатокНаличных;
	КонтролироватьОстатокНаличных = Ложь;
	Попытка
		ПродолжитьВызов(Отказ, Организация, КассаККМ, Сумма, ЭтоВнесениеВыемка);
	Исключение
		КонтролироватьОстатокНаличных = КонтрольОстаткаДоВызова;
		ВызватьИсключение;
	КонецПопытки;
	КонтролироватьОстатокНаличных = КонтрольОстаткаДоВызова;

КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_ПолучитьНастройкуОсновнойКассыНаСервере(СсылкаНастройки)
	Попытка
		Возврат АС_ПереносВыручкиРМКСервер.НастройкаОсновнойКассы(СсылкаНастройки);
	Исключение
		Возврат Новый Структура("Использовать, Касса, Ошибка", Ложь, Неопределено,
			"Не удалось прочитать настройку основной кассы РМК: " + ОписаниеОшибки());
	КонецПопытки;
КонецФункции

&НаСервере
Функция АС_ПеренестиВыручкуНаСервере(ЧекККМ)

	Если Не ЗначениеЗаполнено(ТекущаяНастройкаРМК) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		НастройкаКассы = АС_ПереносВыручкиРМКСервер.НастройкаОсновнойКассы(ТекущаяНастройкаРМК);
		Если ЗначениеЗаполнено(НастройкаКассы.Ошибка) Тогда
			Возврат НастройкаКассы.Ошибка;
		КонецЕсли;
		Если НастройкаКассы.Использовать Тогда
			АС_ПереносВыручкиРМКСервер.ОтразитьОплатуВОсновнойКассе(
				ЧекККМ, НастройкаКассы.Касса);
		КонецЕсли;
		Если НастройкаКассы.АвтоКарты Тогда
			АС_ПереносВыручкиРМКСервер.ОтразитьОплатуКартойНаСчете(
				ЧекККМ, НастройкаКассы.БанковскийСчет);
		КонецЕсли;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("АС_ПереносВыручкиРМК", УровеньЖурналаРегистрации.Ошибка,
			, ЧекККМ, ТекстОшибки);
		Возврат ТекстОшибки;
	КонецПопытки;

	Возврат "";

КонецФункции
