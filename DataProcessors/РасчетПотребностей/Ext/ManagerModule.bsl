#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

&После("ДобавитьОтборПоСоставуЗаказов")
Процедура АС_ВключитьИсточникиПокрытияЗакупки(Параметры)

	Если Не Параметры.Свойство("АС_ЗаменыЗакупки") Тогда
		Возврат;
	КонецЕсли;
	// Состав товаров уже ограничен СКД. Способ пополнения аналога не ограничивает покрытие.
	СпособыПополнения = Новый СписокЗначений;
	Для Каждого Способ Из Перечисления.СпособыПополненияЗапасов Цикл
		СпособыПополнения.Добавить(Способ);
	КонецЦикла;
	СпособыПополнения.Добавить(Перечисления.СпособыПополненияЗапасов.ПустаяСсылка());
	УстановитьПараметр(Параметры.Настройки, "СпособПополнения", СпособыПополнения);

КонецПроцедуры

&После("УчестьРазмещенныеЗаказы")
Процедура АС_УчестьАктивныеЗаказыИЗамены(ТаблицаРезультат, Параметры)

	Контексты = Неопределено;
	Если Параметры.Свойство("АС_АктивныеЗаказыСписка", Контексты) Тогда
		АС_ПродажиНоменклатурыСервер.УчестьАктивныеЗаказыСписка(
			ТаблицаРезультат, Контексты, НачалоДня(Параметры.Период.ДатаНачала));
	КонецЕсли;
	Замены = Неопределено;
	Если Параметры.Свойство("АС_ЗаменыЗакупки", Замены) Тогда
		АС_ПродажиНоменклатурыСервер.УчестьВзаимозаменяемыеТоварыВЗакупке(ТаблицаРезультат, Замены);
	КонецЕсли;

КонецПроцедуры

#КонецЕсли
