#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

&После("УчестьРазмещенныеЗаказы")
Процедура АС_УчестьАктивныеЗаказыКарточки(ТаблицаРезультат, Параметры)

	// Обычный расчёт УНФ без контекста расширения не меняется.
	Контексты = Неопределено;
	Если Параметры.Свойство("АС_АктивныеЗаказыСписка", Контексты) Тогда
		АС_ПродажиНоменклатурыСервер.УчестьАктивныеЗаказыСписка(
			ТаблицаРезультат, Контексты, НачалоДня(Параметры.Период.ДатаНачала));
		Возврат;
	КонецЕсли;
	Контекст = Неопределено;
	Если Не Параметры.Свойство("АС_АктивныеЗаказыКарточки", Контекст) Тогда
		Возврат;
	КонецЕсли;
	АС_ПродажиНоменклатурыСервер.УчестьАктивныеЗаказыКарточки(
		ТаблицаРезультат, Контекст, НачалоДня(Параметры.Период.ДатаНачала));

КонецПроцедуры

#КонецЕсли
