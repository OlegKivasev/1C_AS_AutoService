&НаСервере
&Вместо("ПриСозданииНаСервере")
Процедура АС_ПередПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// В рабочей конфигурации штатная инициализация формы уже была выполнена
	// другим слоем расширения. Повторный запуск добавляет те же реквизиты,
	// повторно загружает товары и второй раз дописывает "по объекту" в заголовок.
	ПартияСоздана = Ложь;
	СерияСоздана = Ложь;
	ШтрихАвтопроверкиСоздан = Ложь;
	Для Каждого РеквизитФормы Из ПолучитьРеквизиты("Объект.Товары") Цикл
		Если РеквизитФормы.Имя = "Партия" Тогда
			ПартияСоздана = Истина;
		ИначеЕсли РеквизитФормы.Имя = "Серия" Тогда
			СерияСоздана = Истина;
		ИначеЕсли РеквизитФормы.Имя = "ШтрихАвтопроверки" Тогда
			ШтрихАвтопроверкиСоздан = Истина;
		КонецЕсли;
	КонецЦикла;
	Если ПартияСоздана И СерияСоздана И ШтрихАвтопроверкиСоздан Тогда
		Возврат;
	КонецЕсли;

	ПродолжитьВызов(Отказ, СтандартнаяОбработка);

КонецПроцедуры

&НаКлиенте
&Вместо("ПодобратьТовары")
Процедура АС_ПодобратьТовары(Команда)

	Если АС_ОткрытаФормаПодбора = Истина Тогда
		Возврат;
	КонецЕсли;

	АС_ОткрытаФормаПодбора = Истина;
	ПродолжитьВызов(Команда);
	ПодключитьОбработчикОжидания("АС_СброситьФлагФормыПодбора", 60, Истина);

КонецПроцедуры

&НаКлиенте
Процедура АС_СброситьФлагФормыПодбора()
	АС_ОткрытаФормаПодбора = Ложь;
КонецПроцедуры

&НаКлиенте
&Вместо("ЗаполнитьПоОтбору")
Процедура АС_ЗаполнитьПоОтбору(Команда)

	Если АС_ВыполняетсяЗаполнениеПоОтбору = Истина Тогда
		Возврат;
	КонецЕсли;

	АС_ВыполняетсяЗаполнениеПоОтбору = Истина;
	Если Объект.Товары.Количество() = 0 Тогда
		ЗаполнитьПоОтборуНаКлиенте();
		ПодключитьОбработчикОжидания("АС_СброситьФлагЗаполненияПоОтбору", 1, Истина);
		Возврат;
	КонецЕсли;

	ОписаниеОповещения = Новый ОписаниеОповещения(
		"АС_ОповещениеЗаполнитьТаблицуТоваров", ЭтотОбъект);
	ПоказатьВопрос(
		ОписаниеОповещения,
		НСтр("ru = 'Сохранить данные о количестве, шаблонах в табличной части при перезаполнении?'"),
		РежимДиалогаВопрос.ДаНетОтмена,
		,
		КодВозвратаДиалога.Да);
	ПодключитьОбработчикОжидания("АС_СброситьФлагЗаполненияПоОтбору", 60, Истина);

КонецПроцедуры

&НаКлиенте
Процедура АС_ОповещениеЗаполнитьТаблицуТоваров(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Отмена Тогда
		АС_ВыполняетсяЗаполнениеПоОтбору = Ложь;
		Возврат;
	КонецЕсли;

	Если Результат = КодВозвратаДиалога.Нет Тогда
		Объект.Товары.Очистить();
	КонецЕсли;

	ЗаполнитьПоОтборуНаКлиенте();
	ПодключитьОбработчикОжидания("АС_СброситьФлагЗаполненияПоОтбору", 1, Истина);

КонецПроцедуры

