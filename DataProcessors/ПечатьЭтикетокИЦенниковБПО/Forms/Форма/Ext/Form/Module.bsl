&НаКлиенте
&Вместо("ВнешнееСобытие")
Процедура АС_ВнешнееСобытие(Источник, Событие, Данные)

	// На разных драйверах рабочим может оказаться любой из двух штатных
	// маршрутов сканирования. Не блокируем его здесь: дубли отсеиваются ниже,
	// в событии, которое непосредственно добавляет товар в таблицу.
	ПродолжитьВызов(Источник, Событие, Данные);

КонецПроцедуры

&НаКлиенте
&Вместо("ОбработкаОповещения")
Процедура АС_ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "ЗаполнитьДанныеЭтикетокИЦенников" Тогда
		Если АС_ЭтоПовторноеОповещениеДобавленияПоШтрихкоду(Параметр) Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ПродолжитьВызов(ИмяСобытия, Параметр, Источник);

КонецПроцедуры

&НаКлиенте
Функция АС_ЭтоПовторноеОповещениеДобавленияПоШтрихкоду(Параметр)

	Если Параметр.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Штрихкод = Параметр[0].Штрихкод;
	Если АС_ОбрабатываетсяДобавлениеПоШтрихкоду = Истина
		И АС_ПоследнийШтрихкодСканера = Штрихкод Тогда
		Возврат Истина;
	КонецЕсли;

	АС_ОбрабатываетсяДобавлениеПоШтрихкоду = Истина;
	АС_ПоследнийШтрихкодСканера = Штрихкод;
	ПодключитьОбработчикОжидания("АС_СброситьФлагДобавленияПоШтрихкоду", 0.3, Истина);
	Возврат Ложь;

КонецФункции

&НаКлиенте
Процедура АС_СброситьФлагДобавленияПоШтрихкоду()

	АС_ОбрабатываетсяДобавлениеПоШтрихкоду = Ложь;
	АС_ПоследнийШтрихкодСканера = "";

КонецПроцедуры

