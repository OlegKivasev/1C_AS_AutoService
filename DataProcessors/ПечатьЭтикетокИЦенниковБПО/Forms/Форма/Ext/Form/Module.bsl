&НаКлиенте
&Вместо("ОбработчикУстановкиШаблона")
Процедура АС_ОбработчикУстановкиШаблона(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт

	АС_ОткрытаФормаШаблонов = Ложь;
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	КоличествоИзмененныхСтрок = 0;
	Для Каждого СтрокаТовара Из Объект.Товары Цикл
		Если СтрокаТовара.Выбран = Истина Тогда
			СтрокаТовара.ШаблонЦенникаЭтикетки = ВыбранноеЗначение;
			Если Не ЗначениеЗаполнено(СтрокаТовара.Количество) Тогда
				СтрокаТовара.Количество = 1;
			КонецЕсли;
			КоличествоИзмененныхСтрок = КоличествоИзмененныхСтрок + 1;
		КонецЕсли;
	КонецЦикла;

	Если КоличествоИзмененныхСтрок > 0 Тогда
		Текст = НСтр("ru = 'Установлен шаблон ""%Шаблон%"".'");
		Текст = СтрЗаменить(Текст, "%Шаблон%", ВыбранноеЗначение);
		ПоказатьОповещениеПользователюОВозможнойОшибке(
			Текст, КоличествоИзмененныхСтрок, КоличествоИзмененныхСтрок);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&Вместо("ОповещениеУстановитьКоличествоЦенников")
Процедура АС_ОповещениеУстановитьКоличествоЦенников(ВыбранноеЗначение, ДополнительныеПараметры)

	АС_ОжидаетсяВводКоличество = Ложь;

	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	КоличествоИзмененныхСтрок = 0;
	Для Каждого СтрокаТовара Из Объект.Товары Цикл
		Если СтрокаТовара.Выбран = Истина Тогда
			СтрокаТовара.Количество = ВыбранноеЗначение;
			КоличествоИзмененныхСтрок = КоличествоИзмененныхСтрок + 1;
		КонецЕсли;
	КонецЦикла;

	Если КоличествоИзмененныхСтрок > 0 Тогда
		Текст = НСтр("ru = 'Установлено количество ценников %Количество%.'");
		Текст = СтрЗаменить(Текст, "%Количество%", ВыбранноеЗначение);
		ПоказатьОповещениеПользователюОВозможнойОшибке(
			Текст, КоличествоИзмененныхСтрок, КоличествоИзмененныхСтрок);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&После("ПодобратьТоварыЗавершение")
Процедура АС_ПодобратьТоварыЗавершениеПосле(Результат, ПараметрыОперации)
	АС_ОткрытаФормаПодбора = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура АС_Печать(Команда)

	Для Каждого СтрокаТовара Из Объект.Товары Цикл
		Если СтрокаТовара.Выбран И Не ЗначениеЗаполнено(СтрокаТовара.Штрихкод) Тогда
			Оповещение = Новый ОписаниеОповещения(
				"АС_ПечатьПослеПредупреждения", ЭтотОбъект);
			ПоказатьВопрос(
				Оповещение,
				НСтр("ru = 'Для одного или нескольких выбранных товаров не указан штрихкод. Продолжить печать?'"),
				РежимДиалогаВопрос.ДаНет,
				0,
				КодВозвратаДиалога.Нет);
			Возврат;
		КонецЕсли;
	КонецЦикла;

	Печать(Команда);

КонецПроцедуры

&НаКлиенте
Процедура АС_ПечатьПослеПредупреждения(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		Печать(Неопределено);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_ОтметитьВсе(Команда)

	КоличествоОтмеченных = 0;
	Для Каждого СтрокаТовара Из Объект.Товары Цикл
		СтрокаТовара.Выбран = ПроверитьВозможностьВыбораТовара(СтрокаТовара);
		Если СтрокаТовара.Выбран Тогда
			КоличествоОтмеченных = КоличествоОтмеченных + 1;
		КонецЕсли;
	КонецЦикла;

	ПоказатьОповещениеПользователюОВозможнойОшибке(
		"", КоличествоОтмеченных, Объект.Товары.Количество());

КонецПроцедуры

&НаКлиенте
Процедура АС_СнятьВсеОтметки(Команда)

	Для Каждого СтрокаТовара Из Объект.Товары Цикл
		СтрокаТовара.Выбран = Ложь;
	КонецЦикла;

КонецПроцедуры
