&НаКлиенте
&Вместо("УстановитьШтрихкодНоменклатуры")
Процедура АС_УстановитьШтрихкодНоменклатуры(Команда)

	Если АС_ОжидаетсяУстановкаШтрихкода = Истина Тогда
		Возврат;
	КонецЕсли;

	АС_ОжидаетсяУстановкаШтрихкода = Истина;
	ВыбранныеСтроки = АС_ВыбранныеСтрокиТоваров();
	НетОтмеченныхТоваров = ВыбранныеСтроки.Количество() = 0;
	Если НетОтмеченныхТоваров Тогда
		ВыбранныеСтроки = АС_ВыбранныеСтрокиТоваров(Ложь, Истина);
	КонецЕсли;
	Если ВыбранныеСтроки.Количество() = 0 Тогда
		АС_ОжидаетсяУстановкаШтрихкода = Ложь;
		ОбщегоНазначенияБПОКлиент.СообщитьПользователю(
			НСтр("ru = 'В списке нет товаров для установки штрихкода.'"));
		Возврат;
	КонецЕсли;

	СтрокиБезШтрихкода = АС_ВыбранныеСтрокиТоваров(Истина, НетОтмеченныхТоваров);
	Если Не НетОтмеченныхТоваров
		И СтрокиБезШтрихкода.Количество() = ВыбранныеСтроки.Количество() Тогда
		АС_УстановитьНовыеШтрихкоды(СтрокиБезШтрихкода);
		// Команда формы может вызвать обработчик повторно в рамках одного нажатия.
		// До завершения этого вызова сохраняем защиту: штрихкоды уже заполнены.
		ПодключитьОбработчикОжидания("АС_СброситьФлагУстановкиШтрихкода", 1, Истина);
		Возврат;
	КонецЕсли;

	ПараметрыОповещения = Новый Структура;
	ПараметрыОповещения.Вставить("ВсеВыбранныеСтроки", ВыбранныеСтроки);
	ПараметрыОповещения.Вставить("СтрокиБезШтрихкода", СтрокиБезШтрихкода);
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"АС_ПослеВыбораВариантаУстановкиШтрихкодов", ЭтотОбъект, ПараметрыОповещения);
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить("ТолькоБезШтрихкода", НСтр("ru = 'Только без штрихкода'"));
	Если НетОтмеченныхТоваров Тогда
		Кнопки.Добавить("ВсеВыбранные", НСтр("ru = 'Для всех товаров'"));
		ТекстВопроса = НСтр("ru = 'Товары не отмечены галочками. Для каких товаров из списка создать новый EAN-13?'");
	Иначе
		Кнопки.Добавить("ВсеВыбранные", НСтр("ru = 'Для всех выбранных'"));
		ТекстВопроса = НСтр("ru = 'Среди отмеченных товаров есть позиции с заполненным штрихкодом. Для каких товаров создать новый EAN-13?'");
	КонецЕсли;
	Кнопки.Добавить("Отмена", НСтр("ru = 'Отмена'"));
	ПоказатьВопрос(
		ОписаниеОповещения,
		ТекстВопроса,
		Кнопки);
	ПодключитьОбработчикОжидания("АС_СброситьФлагУстановкиШтрихкода", 60, Истина);

КонецПроцедуры

&НаКлиенте
Процедура АС_ПослеВыбораВариантаУстановкиШтрихкодов(Ответ, ДополнительныеПараметры) Экспорт

	АС_ОжидаетсяУстановкаШтрихкода = Ложь;
	Если Ответ = "ВсеВыбранные" Тогда
		АС_УстановитьНовыеШтрихкоды(ДополнительныеПараметры.ВсеВыбранныеСтроки);
	ИначеЕсли Ответ = "ТолькоБезШтрихкода" Тогда
		Если ДополнительныеПараметры.СтрокиБезШтрихкода.Количество() = 0 Тогда
			ОбщегоНазначенияБПОКлиент.СообщитьПользователю(
				НСтр("ru = 'Нет товаров без штрихкода для выбранного варианта установки.'"));
		Иначе
			АС_УстановитьНовыеШтрихкоды(ДополнительныеПараметры.СтрокиБезШтрихкода);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_СброситьФлагУстановкиШтрихкода()
	АС_ОжидаетсяУстановкаШтрихкода = Ложь;
КонецПроцедуры

&НаКлиенте
Функция АС_ВыбранныеСтрокиТоваров(ТолькоБезШтрихкода = Ложь, ВсеТовары = Ложь)

	Результат = Новый Массив;
	Для Каждого СтрокаТовара Из Объект.Товары Цикл
		Если (ВсеТовары Или СтрокаТовара.Выбран = Истина)
			И (Не ТолькоБезШтрихкода Или Не ЗначениеЗаполнено(СтрокаТовара.Штрихкод)) Тогда
			Результат.Добавить(СтрокаТовара.ПолучитьИдентификатор());
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура АС_УстановитьНовыеШтрихкоды(СтрокиТоваров)

	Штрихкоды = Новый Соответствие;
	Товары = Объект.Товары;
	ПечатьДокументовУНФВызовСервера.УстановитьШтрихкодыНоменклатуры(
		СтрокиТоваров, Товары, Штрихкоды);

	Для Каждого ПараШтрихкода Из Штрихкоды Цикл
		СтрокаТовара = Объект.Товары.НайтиПоИдентификатору(ПараШтрихкода.Ключ);
		Если СтрокаТовара <> Неопределено Тогда
			СтрокаТовара.Штрихкод = ПараШтрихкода.Значение;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

