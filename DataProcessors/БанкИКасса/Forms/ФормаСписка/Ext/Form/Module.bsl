&НаКлиенте
Процедура АС_СписокБанковскиеВыпискиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Если Не АС_ЗапрещеноРедактированиеСозданныхПоступлений()
		Или Элемент.ТекущиеДанные = Неопределено
		Или Не ЗначениеЗаполнено(Элемент.ТекущиеДанные.Ссылка) Тогда
		Возврат;
	КонецЕсли;

	СсылкаДокумента = Элемент.ТекущиеДанные.Ссылка;
	Если ТипЗнч(СсылкаДокумента) <> Тип("ДокументСсылка.ПоступлениеВКассу")
		И ТипЗнч(СсылкаДокумента) <> Тип("ДокументСсылка.ПоступлениеНаСчет") Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;
	Если ТипЗнч(СсылкаДокумента) = Тип("ДокументСсылка.ПоступлениеВКассу") Тогда
		АС_ИмяФормыДокумента = "Документ.ПоступлениеВКассу.ФормаОбъекта";
	Иначе
		АС_ИмяФормыДокумента = "Документ.ПоступлениеНаСчет.ФормаОбъекта";
	КонецЕсли;

	ПараметрыФормы = Новый Структура("Ключ", СсылкаДокумента);
	ФормаДокумента = ПолучитьФорму(
		АС_ИмяФормыДокумента,
		ПараметрыФормы,
		ЭтотОбъект);
	ФормаДокумента.ТолькоПросмотр = Истина;
	ФормаДокумента.Открыть();

КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_ЗапрещеноРедактированиеСозданныхПоступлений()

	Возврат РольДоступна(Метаданные.Роли.АС_ЗапретитьРедактированиеПоступлений);

КонецФункции

&НаСервереБезКонтекста
Процедура АС_СписокПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)

	Если Не ПравоДоступа("Чтение", Метаданные.Документы.ПоступлениеВКассу) Тогда
		Возврат;
	КонецЕсли;
	Ссылки = Строки.ПолучитьКлючи();
	Если Ссылки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|  Поступление.Ссылка КАК Ссылка,
		|  Поступление.Контрагент КАК Контрагент
		|ИЗ Документ.ПоступлениеВКассу КАК Поступление
		|ГДЕ Поступление.Ссылка В (&Ссылки)
		|  И Поступление.Контрагент.ЮридическоеФизическоеЛицо
		|    = ЗНАЧЕНИЕ(Перечисление.ЮридическоеФизическоеЛицо.ЮридическоеЛицо)");
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаСписка = Строки[Выборка.Ссылка];
		Если СтрокаСписка = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ОформлениеЯчейки Из СтрокаСписка.Оформление Цикл
			ОформлениеЯчейки.Значение.УстановитьЗначениеПараметра(
				"ЦветФона", Новый Цвет(255, 225, 225));
			ОформлениеЯчейки.Значение.УстановитьЗначениеПараметра(
				"ЦветТекста", Новый Цвет(180, 0, 0));
		КонецЦикла;
		ОформлениеКонтрагента = СтрокаСписка.Оформление.Получить("Контрагент");
		Если ОформлениеКонтрагента <> Неопределено Тогда
			ОформлениеКонтрагента.УстановитьЗначениеПараметра("Текст",
				"ПРОВЕРИТЬ: наличные от юрлица — " + Строка(Выборка.Контрагент));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры
