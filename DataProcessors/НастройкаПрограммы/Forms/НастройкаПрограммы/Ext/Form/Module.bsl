&НаСервере
&После("ПриСозданииНаСервере")
Процедура АС_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)

	РежимАвтоТеста = Ложь;
	Если Параметры.Свойство("АвтоТест", РежимАвтоТеста) И РежимАвтоТеста Тогда
		Возврат;
	КонецЕсли;

	Если ПравоДоступа("Изменение", Метаданные.Справочники.АС_ГруппыСинонимовПоиска) Тогда
		АС_ДобавитьНастройкуСинонимов();
	КонецЕсли;

	Если ПравоДоступа("Изменение", Метаданные.Справочники.АС_НастройкиИндикацииОстатков) Тогда
		АС_ДобавитьНастройкуИндикацииОстатков();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура АС_ДобавитьНастройкуСинонимов()

	Если Элементы.Найти("АС_ГруппаСинонимыПоиска") <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	ГруппаСинонимов = Элементы.Добавить(
		"АС_ГруппаСинонимыПоиска",
		Тип("ГруппаФормы"),
		Элементы.СтраницаГлавное);
	ГруппаСинонимов.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаСинонимов.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	ГруппаСинонимов.Поведение = ПоведениеОбычнойГруппы.Свертываемая;
	ГруппаСинонимов.ОтображениеУправления = ОтображениеУправленияОбычнойГруппы.Картинка;
	ГруппаСинонимов.Отображение = ОтображениеОбычнойГруппы.ОбычноеВыделение;
	ГруппаСинонимов.ОтображатьЗаголовок = Истина;
	ГруппаСинонимов.Заголовок = "Синонимы";

	СсылкаСинонимов = Элементы.Добавить(
		"АС_СинонимыДляПоиска",
		Тип("ДекорацияФормы"),
		ГруппаСинонимов);
	СсылкаСинонимов.Вид = ВидДекорацииФормы.Надпись;
	СсылкаСинонимов.Заголовок = "Синонимы для поиска";
	СсылкаСинонимов.Гиперссылка = Истина;
	СсылкаСинонимов.УстановитьДействие("Нажатие", "АС_СинонимыДляПоискаНажатие");

КонецПроцедуры

&НаСервере
Процедура АС_ДобавитьНастройкуИндикацииОстатков()

	Если Элементы.Найти("АС_ГруппаИндикацияОстатков") <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	ГруппаИндикации = Элементы.Добавить(
		"АС_ГруппаИндикацияОстатков",
		Тип("ГруппаФормы"),
		Элементы.СтраницаГлавное);
	ГруппаИндикации.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаИндикации.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	ГруппаИндикации.Поведение = ПоведениеОбычнойГруппы.Свертываемая;
	ГруппаИндикации.ОтображениеУправления = ОтображениеУправленияОбычнойГруппы.Картинка;
	ГруппаИндикации.Отображение = ОтображениеОбычнойГруппы.ОбычноеВыделение;
	ГруппаИндикации.ОтображатьЗаголовок = Истина;
	ГруппаИндикации.Заголовок = "Остатки";

	СсылкаИндикации = Элементы.Добавить(
		"АС_ДинамическаяИндикацияОстатков",
		Тип("ДекорацияФормы"),
		ГруппаИндикации);
	СсылкаИндикации.Вид = ВидДекорацииФормы.Надпись;
	СсылкаИндикации.Заголовок = "Динамическая индикация остатков";
	СсылкаИндикации.Гиперссылка = Истина;
	СсылкаИндикации.УстановитьДействие("Нажатие", "АС_ДинамическаяИндикацияОстатковНажатие");

КонецПроцедуры

&НаКлиенте
Процедура АС_СинонимыДляПоискаНажатие(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ОткрытьФорму("Справочник.АС_ГруппыСинонимовПоиска.ФормаСписка");

КонецПроцедуры

&НаКлиенте
Процедура АС_ДинамическаяИндикацияОстатковНажатие(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ОткрытьФорму(
		"Справочник.АС_НастройкиИндикацииОстатков.ФормаСписка",
		,,,,,,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры
