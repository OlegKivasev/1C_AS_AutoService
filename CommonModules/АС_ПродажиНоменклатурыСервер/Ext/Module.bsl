Функция ПолучитьПериод() Экспорт

	Сегодня = НачалоДня(ТекущаяДатаСеанса());
	Период = ХранилищеОбщихНастроек.Загрузить("АС_ПродажиНоменклатуры", "Период");
	Если ТипЗнч(Период) = Тип("Структура") Тогда
		Если Период.Свойство("НачалоПериода") И Период.Свойство("КонецПериода") Тогда
			Если ТипЗнч(Период.НачалоПериода) = Тип("Дата")
				И ТипЗнч(Период.КонецПериода) = Тип("Дата") Тогда
				Если ЗначениеЗаполнено(Период.НачалоПериода)
					И ЗначениеЗаполнено(Период.КонецПериода)
					И Период.НачалоПериода <= Период.КонецПериода Тогда
					Возврат Период;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат Новый Структура("НачалоПериода, КонецПериода", НачалоМесяца(Сегодня), Сегодня);

КонецФункции

Функция СохранитьПериод(НачалоПериода, КонецПериода) Экспорт

	Если Не ЗначениеЗаполнено(НачалоПериода) Или Не ЗначениеЗаполнено(КонецПериода)
		Или НачалоДня(НачалоПериода) > НачалоДня(КонецПериода) Тогда
		ВызватьИсключение "Укажите обе даты; дата с должна быть не позже даты по.";
	КонецЕсли;
	Период = Новый Структура("НачалоПериода, КонецПериода",
		НачалоДня(НачалоПериода), НачалоДня(КонецПериода));
	ХранилищеОбщихНастроек.Сохранить("АС_ПродажиНоменклатуры", "Период", Период);
	Возврат Период;

КонецФункции

Функция ПолучитьСведения(Номенклатура, НачалоПериода, КонецПериода) Экспорт

	Результат = Новый Структура("Доступно, КоличествоЗаказовПокупателя, КоличествоЗаказНарядов, КоличествоЧековККМ, КоличествоСписаний, КоличествоПеремещений",
		ПравоДоступа("Чтение", Метаданные.Документы.ЗаказПокупателя), 0, 0, 0, 0, 0);
	Если Не Результат.Доступно Или Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос(ТекстЗапросаПолнойИстории());
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(КонецПериода));
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.ЭтоСписание Тогда
			Результат.КоличествоСписаний = Результат.КоличествоСписаний + Выборка.Количество;
		ИначеЕсли Выборка.ЭтоПеремещение Тогда
			Результат.КоличествоПеремещений = Результат.КоличествоПеремещений + Выборка.Количество;
		ИначеЕсли Выборка.ЭтоЧекККМ Тогда
			Результат.КоличествоЧековККМ = Результат.КоличествоЧековККМ + Выборка.Количество;
		ИначеЕсли Выборка.ЭтоЗаказНаряд Тогда
			Результат.КоличествоЗаказНарядов = Результат.КоличествоЗаказНарядов + Выборка.Количество;
		Иначе
			Результат.КоличествоЗаказовПокупателя = Результат.КоличествоЗаказовПокупателя + Выборка.Количество;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// История добавления в проведённые заказы и продажи пробитыми чеками.
// Количества заказов и чеков считаются раздельно: это разные события.
// Строки «Не списывать» исключаются из истории и показателей продаж.
// Порции прежних версий агрегированы по товару, характеристике и варианту КП.
// Раскладываем их по строкам в порядке дат добавления и номеров строк.
// Так смешанные строки с «Не списывать» не возвращают в продажи полную порцию.
// Даты и операции самих порций сохраняются; историческую принадлежность
// прибавок одинаковым строкам прежняя модель не хранит.
Функция ТекстЗапросаУчитываемыхДобавлений(ОтборПоНоменклатуре = Ложь) Экспорт

	Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|    Строки.Заказ, Строки.Номер, Строки.ВидОперации, Строки.ВидСтроки, Строки.НеСписывать, Строки.Номенклатура, Строки.Характеристика, Строки.НомерСтроки, Строки.НомерВариантаКП, Строки.Дата, Строки.Количество
	|ПОМЕСТИТЬ АС_СтрокиИсторииПродаж
	|ИЗ (ВЫБРАТЬ
	|    Строки.Ссылка КАК Заказ,
	|    Строки.Ссылка.Номер КАК Номер,
	|    Строки.Ссылка.ВидОперации КАК ВидОперации,
	|    ""Запасы"" КАК ВидСтроки,
	|    Строки.АС_НеСписывать КАК НеСписывать,
	|    ВЫРАЗИТЬ(Строки.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
	|    Строки.Характеристика КАК Характеристика,
	|    Строки.НомерСтроки КАК НомерСтроки,
	|    Строки.НомерВариантаКП КАК НомерВариантаКП,
	|    ВЫБОР КОГДА Строки.АС_ДатаДобавления = ДАТАВРЕМЯ(1, 1, 1)
	|        ТОГДА Строки.Ссылка.Дата ИНАЧЕ Строки.АС_ДатаДобавления КОНЕЦ КАК Дата,
	|    Строки.Количество * ВЫБОР КОГДА Строки.ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерения
	|        ТОГДА ВЫРАЗИТЬ(Строки.ЕдиницаИзмерения КАК Справочник.ЕдиницыИзмерения).Коэффициент ИНАЧЕ 1 КОНЕЦ КАК Количество
	|ИЗ Документ.ЗаказПокупателя.Запасы КАК Строки
	|ГДЕ Строки.Номенклатура ССЫЛКА Справочник.Номенклатура /*НОМЕНКЛАТУРА*/
	|    И Строки.Количество > 0
	|    И Строки.Ссылка.Проведен
	|    И НЕ Строки.Ссылка.ПометкаУдаления
	|    И Строки.Ссылка.ВариантЗавершения <> ЗНАЧЕНИЕ(Перечисление.ВариантыЗавершенияЗаказа.Отменен)
	|    И Строки.Ссылка.ВидОперации В (
	|        ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаПродажу),
	|        ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаряд))
	|    И НЕ Строки.ЭтоРазделитель
	|    И (Строки.Ссылка.ОсновнойВариантКП = 0
	|        ИЛИ Строки.НомерВариантаКП = Строки.Ссылка.ОсновнойВариантКП)
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ
	|    Строки.Ссылка КАК Заказ,
	|    Строки.Ссылка.Номер КАК Номер,
	|    Строки.Ссылка.ВидОперации КАК ВидОперации,
	|    ""Работы"" КАК ВидСтроки,
	|    ЛОЖЬ КАК НеСписывать,
	|    ВЫРАЗИТЬ(Строки.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
	|    Строки.Характеристика КАК Характеристика,
	|    Строки.НомерСтроки КАК НомерСтроки,
	|    0 КАК НомерВариантаКП,
	|    ВЫБОР КОГДА Строки.АС_ДатаДобавления = ДАТАВРЕМЯ(1, 1, 1)
	|        ТОГДА Строки.Ссылка.Дата ИНАЧЕ Строки.АС_ДатаДобавления КОНЕЦ КАК Дата,
	|    Строки.Количество * Строки.Кратность * Строки.Коэффициент КАК Количество
	|ИЗ Документ.ЗаказПокупателя.Работы КАК Строки
	|ГДЕ Строки.Номенклатура ССЫЛКА Справочник.Номенклатура /*НОМЕНКЛАТУРА*/
	|    И Строки.Количество > 0
	|    И Строки.Ссылка.Проведен
	|    И НЕ Строки.Ссылка.ПометкаУдаления
	|    И Строки.Ссылка.ВариантЗавершения <> ЗНАЧЕНИЕ(Перечисление.ВариантыЗавершенияЗаказа.Отменен)
	|    И Строки.Ссылка.ВидОперации В (
	|        ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаПродажу),
	|        ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаряд))
	|) КАК Строки
	|ИНДЕКСИРОВАТЬ ПО Заказ, ВидСтроки, Номенклатура, Характеристика, НомерВариантаКП;
	|ВЫБРАТЬ Строки.Заказ, Строки.Номер, Строки.ВидОперации, Строки.ВидСтроки, Строки.НеСписывать, Строки.Номенклатура, Строки.Характеристика, Строки.НомерСтроки, Строки.НомерВариантаКП, Строки.Дата, Строки.Количество,
	|    СУММА(ЕСТЬNULL(Предыдущие.Количество, 0)) КАК НачалоИнтервала
	|ПОМЕСТИТЬ АС_ИнтервалыСтрокПродаж
	|ИЗ АС_СтрокиИсторииПродаж КАК Строки
	|    ЛЕВОЕ СОЕДИНЕНИЕ АС_СтрокиИсторииПродаж КАК Предыдущие
	|    ПО Строки.Заказ = Предыдущие.Заказ
	|    И Строки.ВидСтроки = Предыдущие.ВидСтроки
	|    И Строки.Номенклатура = Предыдущие.Номенклатура
	|    И Строки.Характеристика = Предыдущие.Характеристика
	|    И Строки.НомерВариантаКП = Предыдущие.НомерВариантаКП
	|    И (Предыдущие.Дата < Строки.Дата
	|        ИЛИ (Предыдущие.Дата = Строки.Дата И Предыдущие.НомерСтроки < Строки.НомерСтроки))
	|СГРУППИРОВАТЬ ПО Строки.Заказ, Строки.Номер, Строки.ВидОперации, Строки.ВидСтроки, Строки.НеСписывать, Строки.Номенклатура, Строки.Характеристика, Строки.НомерСтроки, Строки.НомерВариантаКП, Строки.Дата, Строки.Количество;
	|ВЫБРАТЬ РАЗЛИЧНЫЕ Заказ, ВидСтроки, Номенклатура, Характеристика, НомерВариантаКП
	|ПОМЕСТИТЬ АС_ГруппыИсторииПродаж
	|ИЗ АС_СтрокиИсторииПродаж;
	|ВЫБРАТЬ Порции.Ссылка КАК Заказ, Порции.ВидСтроки, Порции.Номенклатура,
	|    Порции.Характеристика, Порции.НомерВариантаКП, Порции.НомерСтроки,
	|    Порции.ДатаДобавления КАК Дата, Порции.Операция, Порции.Количество
	|ПОМЕСТИТЬ АС_ПорцииИсторииПродаж
	|ИЗ Документ.ЗаказПокупателя.АС_ПорцииНоменклатуры КАК Порции
	|    ВНУТРЕННЕЕ СОЕДИНЕНИЕ АС_ГруппыИсторииПродаж КАК Группы
	|    ПО Группы.Заказ = Порции.Ссылка
	|    И Группы.ВидСтроки = Порции.ВидСтроки
	|    И Группы.Номенклатура = Порции.Номенклатура
	|    И Группы.Характеристика = Порции.Характеристика
	|    И Группы.НомерВариантаКП = Порции.НомерВариантаКП
	|ГДЕ Порции.Количество > 0;
	|ВЫБРАТЬ Порции.Заказ, Порции.ВидСтроки, Порции.Номенклатура,
	|    Порции.Характеристика, Порции.НомерВариантаКП, Порции.НомерСтроки,
	|    Порции.Дата, Порции.Операция, Порции.Количество,
	|    СУММА(ЕСТЬNULL(Предыдущие.Количество, 0)) КАК НачалоИнтервала
	|ПОМЕСТИТЬ АС_ИнтервалыПорцийПродаж
	|ИЗ АС_ПорцииИсторииПродаж КАК Порции
	|    ЛЕВОЕ СОЕДИНЕНИЕ АС_ПорцииИсторииПродаж КАК Предыдущие
	|    ПО Порции.Заказ = Предыдущие.Заказ
	|    И Порции.ВидСтроки = Предыдущие.ВидСтроки
	|    И Порции.Номенклатура = Предыдущие.Номенклатура
	|    И Порции.Характеристика = Предыдущие.Характеристика
	|    И Порции.НомерВариантаКП = Предыдущие.НомерВариантаКП
	|    И (Предыдущие.Дата < Порции.Дата
	|        ИЛИ (Предыдущие.Дата = Порции.Дата И Предыдущие.НомерСтроки < Порции.НомерСтроки))
	|СГРУППИРОВАТЬ ПО Порции.Заказ, Порции.ВидСтроки, Порции.Номенклатура,
	|    Порции.Характеристика, Порции.НомерВариантаКП, Порции.НомерСтроки,
	|    Порции.Дата, Порции.Операция, Порции.Количество;
	|ВЫБРАТЬ Строки.Заказ, Строки.Номер, Строки.ВидОперации,
	|    Строки.ВидСтроки, Строки.Номенклатура, Строки.Характеристика,
	|    Строки.НомерВариантаКП, Порции.Дата, Порции.Операция,
	|    ВЫБОР
	|        КОГДА Строки.НачалоИнтервала + Строки.Количество < Порции.НачалоИнтервала + Порции.Количество
	|            ТОГДА Строки.НачалоИнтервала + Строки.Количество
	|        ИНАЧЕ Порции.НачалоИнтервала + Порции.Количество
	|    КОНЕЦ - ВЫБОР
	|        КОГДА Строки.НачалоИнтервала > Порции.НачалоИнтервала ТОГДА Строки.НачалоИнтервала
	|        ИНАЧЕ Порции.НачалоИнтервала
	|    КОНЕЦ КАК Количество
	|ПОМЕСТИТЬ АС_УчитываемыеДобавления
	|ИЗ АС_ИнтервалыСтрокПродаж КАК Строки
	|    ВНУТРЕННЕЕ СОЕДИНЕНИЕ АС_ИнтервалыПорцийПродаж КАК Порции
	|    ПО Строки.Заказ = Порции.Заказ
	|    И Строки.ВидСтроки = Порции.ВидСтроки
	|    И Строки.Номенклатура = Порции.Номенклатура
	|    И Строки.Характеристика = Порции.Характеристика
	|    И Строки.НомерВариантаКП = Порции.НомерВариантаКП
	|    И Строки.НачалоИнтервала < Порции.НачалоИнтервала + Порции.Количество
	|    И Строки.НачалоИнтервала + Строки.Количество > Порции.НачалоИнтервала
	|ГДЕ НЕ Строки.НеСписывать
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ Строки.Заказ, Строки.Номер, Строки.ВидОперации,
	|    Строки.ВидСтроки, Строки.Номенклатура, Строки.Характеристика,
	|    Строки.НомерВариантаКП, Строки.Дата, ""Добавление товара"", Строки.Количество
	|ИЗ АС_СтрокиИсторииПродаж КАК Строки
	|    ЛЕВОЕ СОЕДИНЕНИЕ АС_ПорцииИсторииПродаж КАК Порции
	|    ПО Строки.Заказ = Порции.Заказ
	|    И Строки.ВидСтроки = Порции.ВидСтроки
	|    И Строки.Номенклатура = Порции.Номенклатура
	|    И Строки.Характеристика = Порции.Характеристика
	|    И Строки.НомерВариантаКП = Порции.НомерВариантаКП
	|ГДЕ НЕ Строки.НеСписывать И Порции.Заказ ЕСТЬ NULL;";
	Возврат СтрЗаменить(Текст, "/*НОМЕНКЛАТУРА*/",
		?(ОтборПоНоменклатуре, "И Строки.Номенклатура = &Номенклатура", ""));

КонецФункции

Функция ТекстЗапросаИстории() Экспорт

	Возврат ТекстЗапросаУчитываемыхДобавлений(Истина) + Символы.ПС +
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|    История.Заказ КАК Заказ,
	|    ВЫБОР КОГДА История.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаряд)
	|        ТОГДА ""Заказ-наряд № "" ИНАЧЕ ""Заказ покупателя № "" КОНЕЦ + История.Номер КАК НаименованиеЗаказа,
	|    История.Дата КАК Дата,
	|    История.Операция КАК Операция,
	|    ВЫБОР КОГДА История.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаряд)
	|        ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК ЭтоЗаказНаряд,
	|    СУММА(История.Количество) КАК Количество,
	|    ЛОЖЬ КАК ЭтоЧекККМ,
	|    История.Заказ.Контрагент КАК Контрагент,
	|    ЛОЖЬ КАК ЭтоСписание,
	|    ЛОЖЬ КАК ЭтоПеремещение,
	|    ВЫБОР КОГДА История.Заказ.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ВидыКонтрагентов.ЮридическоеЛицо)
	|  ТОГДА История.Заказ.Договор
	|  ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка) КОНЕЦ КАК Договор,
	|    История.Заказ.Дата КАК ДатаДокумента
	|ИЗ АС_УчитываемыеДобавления КАК История
	|ГДЕ История.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|СГРУППИРОВАТЬ ПО История.Заказ, История.Номер, История.ВидОперации, История.Дата, История.Операция, История.Заказ.Контрагент,
	|    История.Заказ.Договор, История.Заказ.Контрагент.ВидКонтрагента, История.Заказ.Дата
	|ИМЕЮЩИЕ СУММА(История.Количество) > 0
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ
	|    Чек.Ссылка,
	|    ""Чек ККМ № "" + Чек.Номер,
	|    Чек.Дата,
	|    ""Продажа по чеку ККМ"",
	|    ЛОЖЬ,
	|    СУММА(СтрокиЧека.Количество * ВЫБОР
	|        КОГДА СтрокиЧека.ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерения
	|        ТОГДА ВЫРАЗИТЬ(СтрокиЧека.ЕдиницаИзмерения КАК Справочник.ЕдиницыИзмерения).Коэффициент
	|        ИНАЧЕ 1 КОНЕЦ),
	|    ИСТИНА,
	|    Чек.Контрагент,
	|    ЛОЖЬ,
	|    ЛОЖЬ,
	|    ВЫБОР КОГДА Чек.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ВидыКонтрагентов.ЮридическоеЛицо)
	|  ТОГДА Чек.Договор
	|  ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка) КОНЕЦ,
	|    Чек.Дата
	|ИЗ Документ.ЧекККМ.Запасы КАК СтрокиЧека
	|    ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЧекККМ КАК Чек
	|    ПО СтрокиЧека.Ссылка = Чек.Ссылка
	|ГДЕ СтрокиЧека.Номенклатура = &Номенклатура
	|    И СтрокиЧека.Количество > 0
	|    И Чек.Проведен
	|    И НЕ Чек.ПометкаУдаления
	|    И Чек.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЧековККМ.Пробит)
	|    И НЕ Чек.ОперацияСДенежнымиСредствами
	|    И Чек.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|СГРУППИРОВАТЬ ПО Чек.Ссылка, Чек.Номер, Чек.Дата, Чек.Контрагент, Чек.Договор, Чек.Контрагент.ВидКонтрагента";

КонецФункции


// Полная история для таблицы и сводки карточки включает списания и перемещения.
// Табличные части документа работают и на ордерных складах; два плеча
// перемещения не складываются. Списание на расходы учитывается как списание.
Функция ТекстЗапросаПолнойИстории() Экспорт

	ТекстИстории = ТекстЗапросаИстории();
	Если ПравоДоступа("Чтение", Метаданные.Документы.СписаниеЗапасов) Тогда
		ТекстИстории = ТекстИстории + "
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ
	|    Строки.Ссылка,
	|    ""Списание запасов № "" + Строки.Ссылка.Номер,
	|    Строки.Ссылка.Дата,
	|    ""Списание запасов"",
	|    ЛОЖЬ,
	|    СУММА(Строки.Количество),
	|    ЛОЖЬ,
	|    ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка),
	|    ИСТИНА,
	|    ЛОЖЬ,
	|    ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка),
	|    Строки.Ссылка.Дата
	|ИЗ (ВЫБРАТЬ Строки.Ссылка КАК Ссылка, Строки.Номенклатура КАК Номенклатура,
	|    Строки.Количество * ВЫБОР
	|        КОГДА Строки.ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерения
	|        ТОГДА ВЫРАЗИТЬ(Строки.ЕдиницаИзмерения КАК Справочник.ЕдиницыИзмерения).Коэффициент
	|        ИНАЧЕ 1 КОНЕЦ КАК Количество
	|ИЗ Документ.СписаниеЗапасов.Запасы КАК Строки
	|ГДЕ Строки.Номенклатура = &Номенклатура
	|    И Строки.Количество > 0
	|    И Строки.Ссылка.Проведен
	|    И НЕ Строки.Ссылка.ПометкаУдаления
	|    И Строки.Ссылка.Дата МЕЖДУ &НачалоПериода И &КонецПериода) КАК Строки
	|СГРУППИРОВАТЬ ПО Строки.Ссылка, Строки.Ссылка.Номер, Строки.Ссылка.Дата";
	КонецЕсли;
	Если ПравоДоступа("Чтение", Метаданные.Документы.ПеремещениеЗапасов) Тогда
		ТекстИстории = ТекстИстории + "
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ
	|    Строки.Ссылка,
	|    ""Перемещение запасов № "" + Строки.Ссылка.Номер,
	|    Строки.Ссылка.Дата,
	|    ВЫБОР
	|        КОГДА Строки.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПеремещениеЗапасов.Перемещение)
	|            ТОГДА ""Перемещение""
	|        КОГДА Строки.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПеремещениеЗапасов.СписаниеНаРасходы)
	|            ТОГДА ""Списание на расходы""
	|        КОГДА Строки.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПеремещениеЗапасов.ПередачаВЭксплуатацию)
	|            ТОГДА ""Передача в эксплуатацию""
	|        КОГДА Строки.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПеремещениеЗапасов.ВозвратИзЭксплуатации)
	|            ТОГДА ""Возврат из эксплуатации""
	|        ИНАЧЕ ""Перемещение запасов""
	|    КОНЕЦ,
	|    ЛОЖЬ,
	|    СУММА(Строки.Количество),
	|    ЛОЖЬ,
	|    ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка),
	|    ВЫБОР КОГДА Строки.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПеремещениеЗапасов.СписаниеНаРасходы)
	|        ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ,
	|    ВЫБОР КОГДА Строки.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПеремещениеЗапасов.СписаниеНаРасходы)
	|        ТОГДА ЛОЖЬ ИНАЧЕ ИСТИНА КОНЕЦ,
	|    ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка),
	|    Строки.Ссылка.Дата
	|ИЗ (ВЫБРАТЬ Строки.Ссылка КАК Ссылка, Строки.Номенклатура КАК Номенклатура,
	|    Строки.Количество * ВЫБОР
	|        КОГДА Строки.ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерения
	|        ТОГДА ВЫРАЗИТЬ(Строки.ЕдиницаИзмерения КАК Справочник.ЕдиницыИзмерения).Коэффициент
	|        ИНАЧЕ 1 КОНЕЦ КАК Количество
	|ИЗ Документ.ПеремещениеЗапасов.Запасы КАК Строки
	|ГДЕ Строки.Номенклатура = &Номенклатура
	|    И Строки.Количество > 0
	|    И Строки.Ссылка.Проведен
	|    И НЕ Строки.Ссылка.ПометкаУдаления
	|    И Строки.Ссылка.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ Строки.Ссылка КАК Ссылка, Строки.Номенклатура КАК Номенклатура,
	|    Строки.Количество * ВЫБОР
	|        КОГДА Строки.ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерения
	|        ТОГДА ВЫРАЗИТЬ(Строки.ЕдиницаИзмерения КАК Справочник.ЕдиницыИзмерения).Коэффициент
	|        ИНАЧЕ 1 КОНЕЦ КАК Количество
	|ИЗ Документ.ПеремещениеЗапасов.Спецоснастка КАК Строки
	|ГДЕ Строки.Номенклатура = &Номенклатура
	|    И Строки.Количество > 0
	|    И Строки.Ссылка.Проведен
	|    И НЕ Строки.Ссылка.ПометкаУдаления
	|    И Строки.Ссылка.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ Строки.Ссылка КАК Ссылка, Строки.Номенклатура КАК Номенклатура,
	|    Строки.Количество * ВЫБОР
	|        КОГДА Строки.ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерения
	|        ТОГДА ВЫРАЗИТЬ(Строки.ЕдиницаИзмерения КАК Справочник.ЕдиницыИзмерения).Коэффициент
	|        ИНАЧЕ 1 КОНЕЦ КАК Количество
	|ИЗ Документ.ПеремещениеЗапасов.ИнвентарьИХозяйственныеПринадлежности КАК Строки
	|ГДЕ Строки.Номенклатура = &Номенклатура
	|    И Строки.Количество > 0
	|    И Строки.Ссылка.Проведен
	|    И НЕ Строки.Ссылка.ПометкаУдаления
	|    И Строки.Ссылка.Дата МЕЖДУ &НачалоПериода И &КонецПериода) КАК Строки
	|СГРУППИРОВАТЬ ПО Строки.Ссылка, Строки.Ссылка.Номер, Строки.Ссылка.Дата, Строки.Ссылка.ВидОперации";
	КонецЕсли;
	Возврат ТекстИстории;

КонецФункции

// Порции сравниваются с сохранённым состоянием при записи объекта.
// Одинаковые позиции объединяются по товару, характеристике и варианту КП:
// перемещение или свёртка строк без роста количества сохраняют прежние даты.
Процедура ЗафиксироватьДатыДобавления(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт

	Если Отказ Или Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Если Источник.ВидОперации <> Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаПродажу
		И Источник.ВидОперации <> Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаряд Тогда
		Возврат;
	КонецЕсли;
	СохраненныеСтроки = ПолучитьСохраненныеСтроки(Источник.Ссылка);
	СохраненныеСтроки.Колонки.Добавить("Использована", Новый ОписаниеТипов("Булево"));
	СохраненныеСтроки.Колонки.Добавить("ПредыдущийНомерВариантаКП");
	Для Каждого Строка Из СохраненныеСтроки Цикл
		Строка.ПредыдущийНомерВариантаКП = Строка.НомерВариантаКП;
	КонецЦикла;
	ТекущиеГруппы = Новый ТаблицаЗначений;
	Для Каждого ИмяКолонки Из СтрРазделить(
		"ВидСтроки,Номенклатура,Характеристика,НомерВариантаКП,Количество,Добавление,Прибавка", ",") Цикл
		Если ИмяКолонки = "Количество" Или ИмяКолонки = "Добавление" Или ИмяКолонки = "Прибавка" Тогда
			ТекущиеГруппы.Колонки.Добавить(ИмяКолонки,
				Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(22, 6)));
		Иначе
			ТекущиеГруппы.Колонки.Добавить(ИмяКолонки);
		КонецЕсли;
	КонецЦикла;
	МоментДобавления = ТекущаяДатаСеанса();
	ЗаполнитьДатыТабличнойЧасти(Источник.Запасы, "Запасы", СохраненныеСтроки, ТекущиеГруппы, МоментДобавления);
	ЗаполнитьДатыТабличнойЧасти(Источник.Работы, "Работы", СохраненныеСтроки, ТекущиеГруппы, МоментДобавления);
	ТекущиеГруппы.Свернуть("ВидСтроки,Номенклатура,Характеристика,НомерВариантаКП", "Количество,Добавление,Прибавка");
	Порции = ПолучитьСохраненныеПорции(Источник.Ссылка);
	ПеренестиНомераВариантовПорций(Порции, СохраненныеСтроки);
	Результат = Порции.СкопироватьКолонки();
	Для Каждого Группа Из ТекущиеГруппы Цикл
		Если Группа.Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Отбор = Новый Структура("ВидСтроки,Номенклатура,Характеристика,НомерВариантаКП",
			Группа.ВидСтроки, Группа.Номенклатура, Группа.Характеристика, Группа.НомерВариантаКП);
		ПорцииГруппы = Порции.Скопировать(Отбор);
		Если ПорцииГруппы.Количество() = 0 Тогда
			// Первичная история строится из ПРЕЖНЕГО количества, а не уже увеличенного.
			Для Каждого СтараяСтрока Из СохраненныеСтроки.НайтиСтроки(Отбор) Цикл
				Если СтараяСтрока.Количество > 0 Тогда
					ДатаНачальнойПорции = ?(ЗначениеЗаполнено(СтараяСтрока.ДатаДобавления),
						СтараяСтрока.ДатаДобавления, СтараяСтрока.ДатаДокумента);
					ДобавитьПорцию(ПорцииГруппы, Группа, ДатаНачальнойПорции,
						СтараяСтрока.Количество, "Добавление товара");
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		ИзменитьКоличествоПорций(ПорцииГруппы, Группа, МоментДобавления);
		Для Каждого Порция Из ПорцииГруппы Цикл
			Если Порция.Количество > 0 Тогда
				ЗаполнитьЗначенияСвойств(Результат.Добавить(), Порция);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Результат.Свернуть("ВидСтроки,Номенклатура,Характеристика,НомерВариантаКП,ДатаДобавления,Операция", "Количество");
	Источник.АС_ПорцииНоменклатуры.Загрузить(Результат);

КонецПроцедуры

Процедура ИзменитьКоличествоПорций(Порции, Группа, МоментДобавления)

	Разница = Окр(Группа.Количество - Порции.Итог("Количество"), 6);
	Если Разница > 0 Тогда
		КоличествоПрибавки = Мин(Разница, Группа.Прибавка);
		Если КоличествоПрибавки > 0 Тогда
			ДобавитьПорцию(Порции, Группа, МоментДобавления,
				КоличествоПрибавки, "Прибавка к существующей позиции");
		КонецЕсли;
		Если Разница > КоличествоПрибавки Тогда
			ДобавитьПорцию(Порции, Группа, МоментДобавления,
				Разница - КоличествоПрибавки, "Добавление товара");
		КонецЕсли;
	ИначеЕсли Разница < 0 Тогда
		// Уменьшение корректирует последние добавленные количества.
		ОсталосьУменьшить = -Разница;
		Порции.Сортировать("ДатаДобавления УБЫВ");
		Для Каждого Порция Из Порции Цикл
			Уменьшение = Мин(ОсталосьУменьшить, Порция.Количество);
			Порция.Количество = Окр(Порция.Количество - Уменьшение, 6);
			ОсталосьУменьшить = Окр(ОсталосьУменьшить - Уменьшение, 6);
			Если ОсталосьУменьшить <= 0 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьПорцию(Порции, Группа, ДатаДобавления, Количество, Операция)

	НоваяПорция = Порции.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяПорция, Группа);
	НоваяПорция.ДатаДобавления = ДатаДобавления;
	НоваяПорция.Количество = Окр(Количество, 6);
	НоваяПорция.Операция = Операция;

КонецПроцедуры

Процедура ПеренестиНомераВариантовПорций(Порции, СохраненныеСтроки)

	Для Каждого Порция Из Порции Цикл
		Отбор = Новый Структура("ВидСтроки,Номенклатура,Характеристика,ПредыдущийНомерВариантаКП,Использована",
			Порция.ВидСтроки, Порция.Номенклатура, Порция.Характеристика, Порция.НомерВариантаКП, Истина);
		НомераВариантов = Новый Массив;
		Для Каждого Строка Из СохраненныеСтроки.НайтиСтроки(Отбор) Цикл
			Если НомераВариантов.Найти(Строка.НомерВариантаКП) = Неопределено Тогда
				НомераВариантов.Добавить(Строка.НомерВариантаКП);
			КонецЕсли;
		КонецЦикла;
		Если НомераВариантов.Количество() = 1 Тогда
			Порция.НомерВариантаКП = НомераВариантов[0];
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьДатыТабличнойЧасти(ТабличнаяЧасть, ВидСтроки, СохраненныеСтроки, ТекущиеГруппы, МоментДобавления)

	Для Каждого СтрокаТовара Из ТабличнаяЧасть Цикл
		Если Не ЗначениеЗаполнено(СтрокаТовара.Номенклатура)
			Или ТипЗнч(СтрокаТовара.Номенклатура) <> Тип("СправочникСсылка.Номенклатура") Тогда
			Продолжить;
		КонецЕсли;
		Если ВидСтроки = "Запасы" Тогда
			Если СтрокаТовара.ЭтоРазделитель Тогда
				Продолжить;
			КонецЕсли;
			НомерВарианта = СтрокаТовара.НомерВариантаКП;
			Коэффициент = 1;
			Если ТипЗнч(СтрокаТовара.ЕдиницаИзмерения) = Тип("СправочникСсылка.ЕдиницыИзмерения") Тогда
				Коэффициент = СтрокаТовара.ЕдиницаИзмерения.Коэффициент;
			КонецЕсли;
			Количество = Окр(СтрокаТовара.Количество * Коэффициент, 6);
		Иначе
			НомерВарианта = 0;
			Количество = Окр(СтрокаТовара.Количество * СтрокаТовара.Кратность * СтрокаТовара.Коэффициент, 6);
		КонецЕсли;
		Количество = Макс(0, Количество);
		Отбор = Новый Структура("ВидСтроки,Номенклатура,Характеристика,Использована",
			ВидСтроки, СтрокаТовара.Номенклатура, СтрокаТовара.Характеристика, Ложь);
		Отбор.Вставить("Идентификатор", СтрокаТовара.АС_ИдентификаторСтрокиПродажи);
		Если ПустаяСтрока(СтрокаТовара.АС_ИдентификаторСтрокиПродажи) Тогда
			Отбор.Вставить("КлючСвязи", СтрокаТовара.КлючСвязи);
		КонецЕсли;
		ПредыдущаяСтрока = Неопределено;
		Для Каждого Кандидат Из СохраненныеСтроки.НайтиСтроки(Отбор) Цикл
			Если Кандидат.КлючСвязи = СтрокаТовара.КлючСвязи Или Кандидат.КлючСвязи = 0 Тогда
				ПредыдущаяСтрока = Кандидат;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ПредыдущаяСтрока = Неопределено
			И ПустаяСтрока(СтрокаТовара.АС_ИдентификаторСтрокиПродажи) Тогда
			Отбор.Вставить("КлючСвязи", 0);
			Кандидаты = СохраненныеСтроки.НайтиСтроки(Отбор);
			Если Кандидаты.Количество() > 0 Тогда
				ПредыдущаяСтрока = Кандидаты[0];
			КонецЕсли;
		КонецЕсли;
		Группа = ТекущиеГруппы.Добавить();
		ЗаполнитьЗначенияСвойств(Группа, СтрокаТовара);
		Группа.ВидСтроки = ВидСтроки;
		Группа.НомерВариантаКП = НомерВарианта;
		Группа.Количество = Количество;
		Группа.Добавление = 0;
		Группа.Прибавка = 0;
		Если ПредыдущаяСтрока = Неопределено Тогда
			СтрокаТовара.АС_ИдентификаторСтрокиПродажи = Строка(Новый УникальныйИдентификатор);
			СтрокаТовара.АС_ДатаДобавления = МоментДобавления;
			Группа.Добавление = Количество;
		Иначе
			ПредыдущаяСтрока.Использована = Истина;
			ПредыдущаяСтрока.НомерВариантаКП = НомерВарианта;
			Если ПустаяСтрока(ПредыдущаяСтрока.Идентификатор) Тогда
				СтрокаТовара.АС_ИдентификаторСтрокиПродажи = Строка(Новый УникальныйИдентификатор);
			Иначе
				СтрокаТовара.АС_ИдентификаторСтрокиПродажи = ПредыдущаяСтрока.Идентификатор;
			КонецЕсли;
			Если Не ЗначениеЗаполнено(СтрокаТовара.АС_ДатаДобавления) Тогда
				СтрокаТовара.АС_ДатаДобавления = ?(ЗначениеЗаполнено(ПредыдущаяСтрока.ДатаДобавления),
					ПредыдущаяСтрока.ДатаДобавления, ПредыдущаяСтрока.ДатаДокумента);
			КонецЕсли;
			// Позволяет уточнить неизвестную первую дату архивной позиции при инициализации.
			ПредыдущаяСтрока.ДатаДобавления = СтрокаТовара.АС_ДатаДобавления;
			Группа.Прибавка = Макс(0, Окр(Количество - ПредыдущаяСтрока.Количество, 6));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ПолучитьСохраненныеСтроки(Ссылка)

	Запрос = Новый Запрос("ВЫБРАТЬ
	|    ""Запасы"" КАК ВидСтроки,
	|    Строки.КлючСвязи КАК КлючСвязи,
	|    Строки.Номенклатура КАК Номенклатура,
	|    Строки.Характеристика КАК Характеристика,
	|    Строки.НомерВариантаКП КАК НомерВариантаКП,
	|    Строки.АС_ИдентификаторСтрокиПродажи КАК Идентификатор,
	|    Строки.АС_ДатаДобавления КАК ДатаДобавления,
	|    Строки.Ссылка.Дата КАК ДатаДокумента,
	|    Строки.Количество * ВЫБОР КОГДА Строки.ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерения
	|        ТОГДА ВЫРАЗИТЬ(Строки.ЕдиницаИзмерения КАК Справочник.ЕдиницыИзмерения).Коэффициент ИНАЧЕ 1 КОНЕЦ КАК Количество
	|ИЗ
	|    Документ.ЗаказПокупателя.Запасы КАК Строки
	|ГДЕ
	|    Строки.Ссылка = &Ссылка
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ
	|    ""Работы"" КАК ВидСтроки,
	|    Строки.КлючСвязи КАК КлючСвязи,
	|    Строки.Номенклатура КАК Номенклатура,
	|    Строки.Характеристика КАК Характеристика,
	|    0 КАК НомерВариантаКП,
	|    Строки.АС_ИдентификаторСтрокиПродажи КАК Идентификатор,
	|    Строки.АС_ДатаДобавления КАК ДатаДобавления,
	|    Строки.Ссылка.Дата КАК ДатаДокумента,
	|    Строки.Количество * Строки.Кратность * Строки.Коэффициент КАК Количество
	|ИЗ
	|    Документ.ЗаказПокупателя.Работы КАК Строки
	|ГДЕ
	|    Строки.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ПолучитьСохраненныеПорции(Ссылка)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|Порции.ВидСтроки КАК ВидСтроки,
		|Порции.Номенклатура КАК Номенклатура,
		|Порции.Характеристика КАК Характеристика,
		|Порции.НомерВариантаКП КАК НомерВариантаКП,
		|Порции.ДатаДобавления КАК ДатаДобавления,
		|Порции.Количество КАК Количество,
		|Порции.Операция КАК Операция
		|ИЗ Документ.ЗаказПокупателя.АС_ПорцииНоменклатуры КАК Порции
		|ГДЕ Порции.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ПолучитьСостояниеКарточки(Номенклатура) Экспорт

	Период = ПолучитьПериод();
	Возврат Новый Структура("Период,Сведения", Период,
		ПолучитьСведения(Номенклатура, Период.НачалоПериода, Период.КонецПериода));

КонецФункции

Функция ПолучитьЗаказыЗаПериод(Номенклатура, НачалоПериода, КонецПериода, ЭтоЗаказНаряд) Экспорт

	Результат = Новый СписокЗначений;
	Если Не ЗначениеЗаполнено(Номенклатура)
		Или Не ПравоДоступа("Чтение", Метаданные.Документы.ЗаказПокупателя) Тогда
		Возврат Результат;
	КонецЕсли;
	// Тот же запрос обеспечивает совпадение списка заказов со счётчиком.
	Запрос = Новый Запрос(ТекстЗапросаИстории());
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(КонецПериода));
	История = Запрос.Выполнить().Выгрузить();
	Возврат СписокЗаказовИзИстории(История, ЭтоЗаказНаряд);

КонецФункции

Функция СписокЗаказовИзИстории(История, ЭтоЗаказНаряд)

	История.Сортировать("Дата УБЫВ, НаименованиеЗаказа ВОЗР");
	ИтогиЗаказов = Новый Соответствие;
	Заказы = Новый Массив;
	Для Каждого СтрокаИстории Из История Цикл
		Если СтрокаИстории.ЭтоЧекККМ
			Или СтрокаИстории.ЭтоЗаказНаряд <> ЭтоЗаказНаряд Тогда
			Продолжить;
		КонецЕсли;
		ДанныеЗаказа = ИтогиЗаказов.Получить(СтрокаИстории.Заказ);
		Если ДанныеЗаказа = Неопределено Тогда
			ДанныеЗаказа = Новый Структура("Заказ, Количество", СтрокаИстории.Заказ, 0);
			ИтогиЗаказов.Вставить(СтрокаИстории.Заказ, ДанныеЗаказа);
			Заказы.Добавить(ДанныеЗаказа);
		КонецЕсли;
		ДанныеЗаказа.Количество = ДанныеЗаказа.Количество + СтрокаИстории.Количество;
	КонецЦикла;
	Результат = Новый СписокЗначений;
	Для Каждого ДанныеЗаказа Из Заказы Цикл
		ПредставлениеЗаказа = Строка(ДанныеЗаказа.Заказ) + " — количество за период: "
			+ Формат(ДанныеЗаказа.Количество, "ЧДЦ=3; ЧН=0; ЧГ=");
		Результат.Добавить(ДанныеЗаказа.Заказ, ПредставлениеЗаказа);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Один источник свободного поступления для списка и карточки товара.
// У поставок есть измерение Склад, у размещений — ЗаказПокупателя.
// Сначала сворачиваем обе стороны по общим ключам, чтобы JOIN не умножал остатки.
Функция ТекстЗапросаПоступления(ОтборПоНоменклатуре = Ложь, ОтборПоОрганизации = Ложь) Экспорт

	УсловиеОтбора = "ИСТИНА";
	Если ОтборПоНоменклатуре Тогда
		УсловиеОтбора = УсловиеОтбора + " И Номенклатура = &Номенклатура";
	КонецЕсли;
	Если ОтборПоОрганизации Тогда
		УсловиеОтбора = УсловиеОтбора + " И (&ВсеОрганизации ИЛИ Организация В (&Организация))";
	КонецЕсли;
	Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|    Поставки.Организация, Поставки.ЗаказПоставщику, Поставки.Номенклатура, Поставки.Характеристика,
	|    СУММА(Поставки.КоличествоОстаток) КАК Количество
	|ПОМЕСТИТЬ АС_ПоставкиДляПоступления
	|ИЗ РегистрНакопления.ЗаказыПоставщикам.Остатки(, /*ОТБОР*/) КАК Поставки
	|СГРУППИРОВАТЬ ПО Поставки.Организация, Поставки.ЗаказПоставщику, Поставки.Номенклатура, Поставки.Характеристика
	|;
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|    Размещения.Организация, Размещения.ИсточникОбеспечения, Размещения.Номенклатура, Размещения.Характеристика,
	|    СУММА(Размещения.КоличествоОстаток) КАК Количество
	|ПОМЕСТИТЬ АС_РазмещенияДляПоступления
	|ИЗ РегистрНакопления.РазмещениеЗаказов.Остатки(, /*ОТБОР*/) КАК Размещения
	|СГРУППИРОВАТЬ ПО Размещения.Организация, Размещения.ИсточникОбеспечения, Размещения.Номенклатура, Размещения.Характеристика
	|;
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|    Поставки.Номенклатура КАК Номенклатура,
	|    СУММА(ВЫБОР КОГДА Поставки.Количество - ЕСТЬNULL(Размещения.Количество, 0) > 0
	|        ТОГДА Поставки.Количество - ЕСТЬNULL(Размещения.Количество, 0) ИНАЧЕ 0 КОНЕЦ) КАК Количество,
	|    СУММА(Поставки.Количество) КАК ВсегоКПоступлению
	|ПОМЕСТИТЬ АС_КПоступлению
	|ИЗ АС_ПоставкиДляПоступления КАК Поставки
	|    ЛЕВОЕ СОЕДИНЕНИЕ АС_РазмещенияДляПоступления КАК Размещения
	|    ПО Поставки.Организация = Размещения.Организация
	|        И Поставки.ЗаказПоставщику = Размещения.ИсточникОбеспечения
	|        И Поставки.Номенклатура = Размещения.Номенклатура
	|        И Поставки.Характеристика = Размещения.Характеристика
	|ГДЕ Поставки.Количество > 0
	|СГРУППИРОВАТЬ ПО Поставки.Номенклатура
	|;
	|";
	Возврат СтрЗаменить(Текст, "/*ОТБОР*/", УсловиеОтбора);

КонецФункции

Функция ПолучитьПоказателиЗакупки(Номенклатура, ФизическийОстаток, ПотребностьПоЗаказам,
	ЗапретитьВводДробногоКоличества, АдресКэша = "", ВладелецКэша = Неопределено) Экспорт

	НачалоТекущегоМесяца = НачалоМесяца(ТекущаяДатаСеанса());
	НачалоПериода = ДобавитьМесяц(НачалоТекущегоМесяца, -4);
	КонецПериода = НачалоТекущегоМесяца - 1;
	Месяцы = Новый Массив;
	Для Индекс = 0 По 3 Цикл
		Месяцы.Добавить(Новый Структура("Месяц,Количество", ДобавитьМесяц(НачалоПериода, Индекс), 0));
	КонецЦикла;
	Результат = Новый Структура(
		"Месяцы,ПродажиДоступны,ПоступлениеДоступно,РасчетДоступен,СреднемесячныеПродажи,КПоступлению,ВсегоКПоступлению,РекомендованнаяЗакупка,АдресКэша,СообщениеРасчета",
		Месяцы, Ложь, Ложь, Ложь, 0, 0, 0, 0, АдресКэша, "");
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.ПродажиДоступны = ПравоДоступа("Чтение", Метаданные.РегистрыНакопления.Продажи);
	Результат.ПоступлениеДоступно = ПравоДоступа("Чтение", Метаданные.РегистрыНакопления.ЗаказыПоставщикам)
		И ПравоДоступа("Чтение", Метаданные.РегистрыНакопления.РазмещениеЗаказов);
	Результат.РасчетДоступен = Результат.ПродажиДоступны И Результат.ПоступлениеДоступно
		И ПравоДоступа("Чтение", Метаданные.РегистрыНакопления.Запасы)
		И ПравоДоступа("Чтение", Метаданные.РегистрыНакопления.ЗаказыПокупателей)
		И ПравоДоступа("Чтение", Метаданные.РегистрыНакопления.ПотребностьВЗапасах)
		И ПравоДоступа("Чтение", Метаданные.РегистрыНакопления.ГрафикДвиженияЗапасов)
		И ПравоДоступа("Чтение", Метаданные.РегистрыСведений.УправлениеЗапасами);

	Если Результат.ПродажиДоступны Тогда
		// Фактические продажи: возвраты уже отрицательные; межфирменные передачи
		// исключаем так же, как штатный отчёт Продажи. Заказы и чеки не складываем.
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|    Продажи.Период КАК Месяц,
		|    СУММА(Продажи.КоличествоОборот - Продажи.КоличествоИнтОборот) КАК Количество
		|ИЗ РегистрНакопления.Продажи.Обороты(
		|    &НачалоПериода, &КонецПериода, Месяц, Номенклатура = &Номенклатура) КАК Продажи
		|СГРУППИРОВАТЬ ПО Продажи.Период";
		Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
		Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
		Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
		Выборка = Запрос.Выполнить().Выбрать();
		ВсегоПродано = 0;
		Пока Выборка.Следующий() Цикл
			Для Каждого ДанныеМесяца Из Месяцы Цикл
				Если ДанныеМесяца.Месяц = Выборка.Месяц Тогда
					ДанныеМесяца.Количество = Выборка.Количество;
					ВсегоПродано = ВсегоПродано + Выборка.Количество;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		// Нулевые месяцы также входят в знаменатель. Среднее не округляем до расчёта закупки.
		Результат.СреднемесячныеПродажи = ВсегоПродано / 4;
	КонецЕсли;

	Если Результат.ПоступлениеДоступно Тогда
		Запрос = Новый Запрос(ТекстЗапросаПоступления(Истина) +
			"ВЫБРАТЬ
		|    ЕСТЬNULL(СУММА(Поступление.Количество), 0) КАК КПоступлению,
		|    ЕСТЬNULL(СУММА(Поступление.ВсегоКПоступлению), 0) КАК ВсегоКПоступлению
		|ИЗ АС_КПоступлению КАК Поступление");
		Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Результат.КПоступлению = Выборка.КПоступлению;
			Результат.ВсегоКПоступлению = Выборка.ВсегоКПоступлению;
		КонецЕсли;
	КонецЕсли;

	Если Результат.РасчетДоступен Тогда
		ПредыдущийРасчет = Неопределено;
		Если Не ПустаяСтрока(АдресКэша) Тогда
			Попытка
				ПредыдущийРасчет = ПолучитьИзВременногоХранилища(АдресКэша);
			Исключение
				АдресКэша = "";
			КонецПопытки;
			Если ТипЗнч(ПредыдущийРасчет) <> Тип("Структура") Тогда
				АдресКэша = "";
			КонецЕсли;
		КонецЕсли;
		КлючОстатков = Строка(ФизическийОстаток) + "|" + Строка(ПотребностьПоЗаказам)
			+ "|" + Строка(Результат.ВсегоКПоступлению) + "|" + Строка(Результат.СреднемесячныеПродажи);
		Расчет = ПолучитьШтатнуюРекомендациюЗакупки(Номенклатура, НачалоПериода, КонецПериода,
			ЗапретитьВводДробногоКоличества, ПредыдущийРасчет, КлючОстатков);
		Результат.РасчетДоступен = Расчет.Доступно;
		Результат.РекомендованнаяЗакупка = Расчет.Количество;
		Результат.СообщениеРасчета = Расчет.Сообщение;
		Результат.АдресКэша = ПоместитьВоВременноеХранилище(Расчет,
			?(ПустаяСтрока(АдресКэша), ВладелецКэша, АдресКэша));
	КонецЕсли;
	Возврат Результат;

КонецФункции


Функция ПолучитьЗаказыКПоступлению(Номенклатура, ЕдиницаИзмерения) Экспорт

	Результат = Новый СписокЗначений;
	Если Не ЗначениеЗаполнено(Номенклатура)
		Или Не ПравоДоступа("Чтение", Метаданные.РегистрыНакопления.ЗаказыПоставщикам)
		Или Не ПравоДоступа("Чтение", Метаданные.РегистрыНакопления.РазмещениеЗаказов)
		Или Не ПравоДоступа("Чтение", Метаданные.Документы.ЗаказПоставщику) Тогда
		Возврат Результат;
	КонецЕсли;
	// Те же свёрнутые остатки, общий ключ и положительная разность, что у
	// показателя КПоступлению. Расшифровка не включает уже размещённый приход.
	Запрос = Новый Запрос(ТекстЗапросаПоступления(Истина) +
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|    Поставки.ЗаказПоставщику КАК ЗаказПоставщику,
	|    Поставки.ЗаказПоставщику.Контрагент КАК Поставщик,
	|    СУММА(Поставки.Количество - ЕСТЬNULL(Размещения.Количество, 0)) КАК Количество
	|ИЗ АС_ПоставкиДляПоступления КАК Поставки
	|    ЛЕВОЕ СОЕДИНЕНИЕ АС_РазмещенияДляПоступления КАК Размещения
	|    ПО Поставки.Организация = Размещения.Организация
	|        И Поставки.ЗаказПоставщику = Размещения.ИсточникОбеспечения
	|        И Поставки.Номенклатура = Размещения.Номенклатура
	|        И Поставки.Характеристика = Размещения.Характеристика
	|ГДЕ Поставки.Количество > 0
	|    И Поставки.Количество - ЕСТЬNULL(Размещения.Количество, 0) > 0
	|СГРУППИРОВАТЬ ПО Поставки.ЗаказПоставщику, Поставки.ЗаказПоставщику.Контрагент
	|УПОРЯДОЧИТЬ ПО Поставщик, ЗаказПоставщику");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Выборка = Запрос.Выполнить().Выбрать();
	Единица = СокрЛП(Строка(ЕдиницаИзмерения));
	Суффикс = ?(ПустаяСтрока(Единица), "", " " + Единица);
	Пока Выборка.Следующий() Цикл
		Представление = Строка(Выборка.Поставщик) + " — "
			+ Формат(Выборка.Количество, "ЧДЦ=3; ЧН=0; ЧГ=") + Суффикс
			+ " — " + Строка(Выборка.ЗаказПоставщику);
		Результат.Добавить(Выборка.ЗаказПоставщику, Представление);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Штатный прогноз УНФ дополняется зарегистрированной незавершённой потребностью
// активных заказов. Занятое для ремонта не считается свободным запасом.
Функция ПолучитьШтатнуюРекомендациюЗакупки(Номенклатура, НачалоИстории, КонецИстории,
	ЗапретитьВводДробногоКоличества, ПредыдущийРасчет, КлючОстатков)

	Сейчас = ТекущаяДатаСеанса();
	Ключ = "АктивныеЗаказыИПрогноз|" + Строка(Номенклатура.УникальныйИдентификатор()) + "|"
		+ Формат(НачалоДня(Сейчас), "ДФ=yyyyMMdd") + "|"
		+ Строка(ЗапретитьВводДробногоКоличества) + "|" + КлючОстатков;
	Если ТипЗнч(ПредыдущийРасчет) = Тип("Структура") Тогда
		Если ПредыдущийРасчет.Свойство("Ключ") И ПредыдущийРасчет.Свойство("ДатаРасчета")
			И ПредыдущийРасчет.Свойство("Количество") И ПредыдущийРасчет.Свойство("Доступно")
			И ПредыдущийРасчет.Свойство("Сообщение") Тогда
			Если ПредыдущийРасчет.Ключ = Ключ И Сейчас >= ПредыдущийРасчет.ДатаРасчета
				И Сейчас - ПредыдущийРасчет.ДатаРасчета < 60 Тогда
				Возврат ПредыдущийРасчет;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Расчет = Новый Структура("Ключ,ДатаРасчета,Количество,Доступно,Сообщение", Ключ, Сейчас, 0, Истина, "");
	Попытка
		СообщениеРасчета = "";
		Области = ОбластиШтатногоРасчетаЗакупки(Номенклатура, НачалоИстории, КонецИстории, СообщениеРасчета);
		Если Не ПустаяСтрока(СообщениеРасчета) Тогда
			Расчет.Доступно = Ложь;
			Расчет.Сообщение = СообщениеРасчета;
			Возврат Расчет;
		КонецЕсли;
		Для Каждого Область Из Области Цикл
			Количество = ШтатнаяПотребностьВОбласти(Номенклатура, Область.Организация,
				Область.Склад, Область.Характеристика, НачалоИстории, КонецИстории, НачалоДня(Сейчас));
			// Разные характеристики/организации не покрывают дефицит друг друга.
			// Целое количество также округляется по каждой характеристике до сложения.
			Расчет.Количество = Расчет.Количество
				+ ОкруглитьКоличествоЗакупки(Количество);
		КонецЦикла;
	Исключение
		// Штатный расчёт может отказать по RLS. Не повышаем привилегии,
		// не показываем частичную сумму или фиктивный ноль при отказе.
		Расчет.Количество = 0;
		Расчет.Доступно = Ложь;
		Расчет.Сообщение = "Штатный расчёт закупки недоступен; подробности в журнале регистрации";
		ЗаписьЖурналаРегистрации("АС.Закупки.Расчет", УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Справочники.Номенклатура, Номенклатура, ОписаниеОшибки());
	КонецПопытки;
	Возврат Расчет;

КонецФункции

Функция ОбластиШтатногоРасчетаЗакупки(Номенклатура, НачалоИстории, КонецИстории, СообщениеРасчета)

	// Набор областей берём из фактических данных, а не из всех складов базы.
	// Способ «Закупка» исключает товары собственного производства/перемещения.
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|    Данные.Организация, Данные.Характеристика, Данные.Склад, Данные.ОбщаяНорма, Данные.ЕстьНорма
	|ИЗ (
	|    ВЫБРАТЬ Запасы.Организация КАК Организация, Запасы.Характеристика КАК Характеристика,
	|        Запасы.СтруктурнаяЕдиница КАК Склад, ЛОЖЬ КАК ОбщаяНорма, ЛОЖЬ КАК ЕстьНорма
	|    ИЗ РегистрНакопления.Запасы.Остатки(, Номенклатура = &Номенклатура
	|        И ТИПЗНАЧЕНИЯ(СтруктурнаяЕдиница) = ТИП(Справочник.СтруктурныеЕдиницы)) КАК Запасы
	|    ОБЪЕДИНИТЬ
	|    ВЫБРАТЬ Продажи.Организация, Продажи.Характеристика, Продажи.Склад, ЛОЖЬ, ЛОЖЬ
	|    ИЗ РегистрНакопления.Продажи.Обороты(&НачалоИстории, &КонецИстории, День,
	|        Номенклатура = &Номенклатура) КАК Продажи
	|    ОБЪЕДИНИТЬ
	|    ВЫБРАТЬ Покупатели.Организация, Покупатели.Характеристика, Покупатели.Склад, ЛОЖЬ, ЛОЖЬ
	|    ИЗ РегистрНакопления.ЗаказыПокупателей.Остатки(, Номенклатура = &Номенклатура) КАК Покупатели
	|    ОБЪЕДИНИТЬ
	|    ВЫБРАТЬ Материалы.Организация, Материалы.Характеристика, Материалы.Склад, ЛОЖЬ, ЛОЖЬ
	|    ИЗ РегистрНакопления.ПотребностьВЗапасах.Остатки(, Номенклатура = &Номенклатура
	|        И ЗаказНаПроизводство = ЗНАЧЕНИЕ(Документ.ЗаказНаПроизводство.ПустаяСсылка)
	|        И ТипДвижения = ЗНАЧЕНИЕ(Перечисление.ТипыДвиженийЗапасов.Отгрузка)) КАК Материалы
	|    ОБЪЕДИНИТЬ
	|    ВЫБРАТЬ Поставщики.Организация, Поставщики.Характеристика, Поставщики.Склад, ЛОЖЬ, ЛОЖЬ
	|    ИЗ РегистрНакопления.ЗаказыПоставщикам.Остатки(, Номенклатура = &Номенклатура) КАК Поставщики
	|    ОБЪЕДИНИТЬ
	|    ВЫБРАТЬ Нормы.Организация, Нормы.Характеристика, Нормы.Склад,
	|        Нормы.Склад = ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка), ИСТИНА
	|    ИЗ РегистрСведений.УправлениеЗапасами КАК Нормы
	|    ГДЕ Нормы.Номенклатура = &Номенклатура
	|        И (Нормы.МинимальныйУровеньЗапаса > 0 ИЛИ Нормы.МаксимальныйУровеньЗапаса > 0)
	|) КАК Данные
	|ГДЕ &СпособПополнения = ЗНАЧЕНИЕ(Перечисление.СпособыПополненияЗапасов.Закупка)";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("НачалоИстории", НачалоИстории);
	Запрос.УстановитьПараметр("КонецИстории", КонецИстории);
	Запрос.УстановитьПараметр("СпособПополнения",
		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "СпособПополнения"));
	ФиксированнаяОрганизация = Неопределено;
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьНесколькоОрганизаций") Тогда
		ФиксированнаяОрганизация = Справочники.Организации.ОсновнаяОрганизация;
	ИначеЕсли ЗначениеЗаполнено(Константы.Компания.Получить()) Тогда
		ФиксированнаяОрганизация = Константы.Компания.Получить();
	КонецЕсли;
	Области = Новый Массив;
	ПоКлючу = Новый Соответствие;
	ИспользоватьХарактеристики = ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристики");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Организация = Выборка.Организация;
		Если ЗначениеЗаполнено(ФиксированнаяОрганизация) Тогда
			Если Организация <> ФиксированнаяОрганизация Тогда
				Продолжить;
			КонецЕсли;
			Организация = ФиксированнаяОрганизация;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Организация) Тогда
			Продолжить;
		КонецЕсли;
		Характеристика = ?(ИспользоватьХарактеристики, Выборка.Характеристика,
			Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
		Ключ = Строка(Организация.УникальныйИдентификатор()) + "|"
			+ Строка(Характеристика.УникальныйИдентификатор());
		Область = ПоКлючу.Получить(Ключ);
		Если Область = Неопределено Тогда
			Область = Новый Структура("Организация,Характеристика,Склад,Склады,ОбщаяНорма,БезСклада,СкладскиеНормы",
				Организация, Характеристика, Справочники.СтруктурныеЕдиницы.ПустаяСсылка(),
				Новый Соответствие, Ложь, Ложь, Ложь);
			ПоКлючу.Вставить(Ключ, Область);
			Области.Добавить(Область);
		КонецЕсли;
		Область.ОбщаяНорма = Область.ОбщаяНорма Или Выборка.ОбщаяНорма;
		Если ЗначениеЗаполнено(Выборка.Склад) Тогда
			Область.Склады.Вставить(Выборка.Склад, Истина);
			Область.СкладскиеНормы = Область.СкладскиеНормы Или Выборка.ЕстьНорма;
		ИначеЕсли Не Выборка.ОбщаяНорма Тогда
			Область.БезСклада = Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат РаскрытьОбластиШтатногоРасчета(Области, СообщениеРасчета);

КонецФункции

Функция ОкруглитьКоличествоЗакупки(Потребность)

	Если Потребность <= 0 Тогда
		Возврат 0;
	КонецЕсли;
	Количество = Цел(Потребность);
	Если Количество < Потребность Тогда
		Количество = Количество + 1;
	КонецЕсли;
	Возврат Количество;

КонецФункции

Функция ШтатнаяПотребностьВОбласти(Номенклатура, Организация, Склад, Характеристика,
	ДатаНачалаИстории, ДатаКонцаИстории, Сегодня)

	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		ВызватьИсключение "Для расчёта требуется номенклатура";
	КонецЕсли;
	Товары = Новый Массив;
	Товары.Добавить(Номенклатура);
	Дефициты = ШтатныеПотребностиВОбласти(Товары, Организация, Склад, Характеристика,
		ДатаНачалаИстории, ДатаКонцаИстории, Сегодня);
	Возврат Дефициты.Получить(Номенклатура);

КонецФункции

Функция ШтатныеПотребностиВОбласти(Товары, Организация, Склад, Характеристика,
	ДатаНачалаИстории, ДатаКонцаИстории, Сегодня, Пары = Неопределено)

	Если Товары.Количество() = 0 Или Не ЗначениеЗаполнено(Организация) Тогда
		ВызватьИсключение "Для расчёта требуются номенклатура и организация";
	КонецЕсли;
	Если Склад = Неопределено Тогда
		Склад = Справочники.СтруктурныеЕдиницы.ПустаяСсылка();
	КонецЕсли;
	ГрафикРаботы = Справочники.ГрафикиРаботы.ПустаяСсылка();
	Сегодня = НачалоДня(Сегодня);
	ПериодПродаж = Новый СтандартныйПериод(НачалоДня(ДатаНачалаИстории), КонецДня(ДатаКонцаИстории));
	ПериодПланирования = Новый СтандартныйПериод(Сегодня, ДобавитьМесяц(Сегодня, 1) - 1);

	Схема = Обработки.РасчетПотребностей.ПолучитьМакет("СхемаКомпоновкиДанных");
	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
	Компоновщик.ЗагрузитьНастройки(Схема.НастройкиПоУмолчанию);
	Настройки = Компоновщик.Настройки;
	Настройки.Отбор.Элементы.Очистить();
	Отбор = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Номенклатура");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	Отбор.ПравоеЗначение = Товары;
	Отбор.Использование = Истина;
	Если Пары = Неопределено Тогда
		ОтборХарактеристики = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборХарактеристики.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Характеристика");
		ОтборХарактеристики.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ОтборХарактеристики.ПравоеЗначение = Характеристика;
		ОтборХарактеристики.Использование = Истина;
	КонецЕсли;

	Значения = Новый Структура;
	Значения.Вставить("Организация", Организация);
	Значения.Вставить("Склад", Склад);
	Значения.Вставить("ГрафикРаботы", ГрафикРаботы);
	Значения.Вставить("ЗаданГрафикРаботы", Ложь);
	Значения.Вставить("Контрагент", Справочники.Контрагенты.ПустаяСсылка());
	Значения.Вставить("ИспользуетсяОтборПоСегментуНоменклатуры", Ложь);
	Для Каждого Значение Из Значения Цикл
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра(Значение.Ключ, Значение.Значение);
		Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных(Значение.Ключ));
		Параметр.Использование = Истина;
	КонецЦикла;

	Параметры = Новый Структура;
	Параметры.Вставить("Период", ПериодПланирования);
	Параметры.Вставить("Периодичность", Перечисления.Периодичность.День);
	Параметры.Вставить("ПоВсемПериодам", Ложь);
	Параметры.Вставить("Рассчитывать", "ПоПродажам");
	Параметры.Вставить("ПериодПродаж", ПериодПродаж);
	Параметры.Вставить("Группировать", "НоменклатураДень");
	Параметры.Вставить("Склад", Склад);
	Параметры.Вставить("ГрафикРаботы", ГрафикРаботы);
	Параметры.Вставить("ПоЗаказам", Ложь);
	Параметры.Вставить("СпособПополнения", "Закупка");
	Параметры.Вставить("ТолькоДефицит", Ложь);
	Параметры.Вставить("Настройки", Настройки);
	Параметры.Вставить("УчитыватьСрокПоставки", Ложь);
	Параметры.Вставить("МетодРасчетаСтраховогоЗапаса", "");
	Параметры.Вставить("СтраховойЗапас", 0);
	Параметры.Вставить("МетодПрогноза", "");
	Параметры.Вставить("ОбеспечениеЗаСчетОстатка", Ложь);
	Параметры.Вставить("ДополнительныеПоля", Новый Структура);
	Параметры.Вставить("Организация", Организация);
	Если Пары = Неопределено Тогда
		Контексты = Новый Массив;
		Для Каждого Товар Из Товары Цикл
			Контексты.Добавить(Новый Структура("Номенклатура,Характеристика,Склад,Потребность",
				Товар, Характеристика, Склад,
				НепокрытаяПотребностьАктивныхЗаказов(Товар, Организация, Склад, Характеристика)));
		КонецЦикла;
	Иначе
		Контексты = КонтекстыПотребностиСписка(Товары, Организация, Склад, Пары);
	КонецЕсли;
	Параметры.Вставить("АС_АктивныеЗаказыСписка", Контексты);

	Адрес = ПоместитьВоВременноеХранилище(Новый Структура, Новый УникальныйИдентификатор);
	Попытка
		Обработки.РасчетПотребностей.ПолучитьДанные(Параметры, Адрес);
		Данные = ПолучитьИзВременногоХранилища(Адрес);
	Исключение
		УдалитьИзВременногоХранилища(Адрес);
		ВызватьИсключение;
	КонецПопытки;
	УдалитьИзВременногоХранилища(Адрес);
	Если ЗначениеЗаполнено(Данные.ОшибкаРасчета) Тогда
		ВызватьИсключение Данные.ОшибкаРасчета;
	КонецЕсли;

	Возврат ДефицитыПоИтогамЗакупки(Данные.Дерево.Строки, Товары, Пары,
		ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристики"));

КонецФункции

Функция РаскрытьОбластиШтатногоРасчета(Области, СообщениеРасчета)

	Результат = Новый Массив;
	Для Каждого Область Из Области Цикл
		Если Область.БезСклада И Область.СкладскиеНормы И Не Область.ОбщаяНорма Тогда
			// Не распределяем общую поставку между складами произвольно и не
			// теряем локальные нормы, схлопывая их в отсутствующую общую норму.
			СообщениеРасчета = "Для расчёта закупки уточните склад: есть данные без склада и отдельные складские нормы";
			Возврат Новый Массив;
		КонецЕсли;
		Если Область.ОбщаяНорма Или Область.БезСклада Или Область.Склады.Количество() = 0 Тогда
			// Общая политика/безскладские данные: ровно один сводный вызов.
			Результат.Добавить(Область);
		Иначе
			// Локальные нормы и спрос считаем в их настоящих складских областях.
			// Неоформленное перемещение не покрывает дефицит другого склада.
			Для Каждого Пара Из Область.Склады Цикл
				Результат.Добавить(Новый Структура("Организация,Характеристика,Склад",
					Область.Организация, Область.Характеристика, Пара.Ключ));
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция НепокрытаяПотребностьАктивныхЗаказов(Номенклатура, Организация, Склад, Характеристика)

	// Остатки обязательств, а не количество из табличной части: исполненная,
	// отменённая потребность и строки АС_НеСписывать повторно сюда не попадают.
	// Товары и материалы объединяем ДО вычета общего резерва одного заказа.
	Запрос = Новый Запрос(ТекстЗапросаПотребностиАктивныхЗаказов());
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Характеристика", Характеристика);
	Запрос.УстановитьПараметр("ИспользоватьХарактеристики", ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристики"));
	Запрос.УстановитьПараметр("ДатаОстатков", ТекущаяДатаСеанса());
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ТекстЗапросаПотребностиАктивныхЗаказов()

	// Явный резерв уже исключён из начального свободного остатка штатной СКД.
	// Повторно требовать его к закупке нельзя. Резерв другого заказа не покрывает
	// этот заказ, даже если для него больше не осталось незавершённой потребности.
	Возврат "ВЫБРАТЬ
	|    Обязательства.Заказ, СУММА(Обязательства.Количество) КАК Количество
	|ПОМЕСТИТЬ АС_ОбязательстваЗаказов
	|ИЗ (
	|    ВЫБРАТЬ Покупатели.ЗаказПокупателя КАК Заказ, Покупатели.КоличествоОстаток КАК Количество
	|    ИЗ РегистрНакопления.ЗаказыПокупателей.Остатки(&ДатаОстатков,
	|        Организация = &Организация И Номенклатура = &Номенклатура
	|        И (Характеристика = &Характеристика ИЛИ НЕ &ИспользоватьХарактеристики)
	|        И (Склад = &Склад ИЛИ &Склад = ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка))) КАК Покупатели
	|    ОБЪЕДИНИТЬ ВСЕ
	|    ВЫБРАТЬ Материалы.ЗаказПокупателя, Материалы.КоличествоОстаток
	|    ИЗ РегистрНакопления.ПотребностьВЗапасах.Остатки(&ДатаОстатков,
	|        Организация = &Организация И Номенклатура = &Номенклатура
	|        И (Характеристика = &Характеристика ИЛИ НЕ &ИспользоватьХарактеристики)
	|        И ТипДвижения = ЗНАЧЕНИЕ(Перечисление.ТипыДвиженийЗапасов.Отгрузка)
	|        И ЗаказНаПроизводство = ЗНАЧЕНИЕ(Документ.ЗаказНаПроизводство.ПустаяСсылка)
	|        И (Склад = &Склад ИЛИ &Склад = ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка))) КАК Материалы
	|) КАК Обязательства
	|СГРУППИРОВАТЬ ПО Обязательства.Заказ
	|ИМЕЮЩИЕ СУММА(Обязательства.Количество) > 0
	|;
	|ВЫБРАТЬ Запасы.ЗаказПокупателя КАК Заказ, СУММА(Запасы.КоличествоОстаток) КАК Количество
	|ПОМЕСТИТЬ АС_РезервыЗаказов
	|ИЗ РегистрНакопления.Запасы.Остатки(&ДатаОстатков,
	|    Организация = &Организация И Номенклатура = &Номенклатура
	|    И (Характеристика = &Характеристика ИЛИ НЕ &ИспользоватьХарактеристики)
	|    И ЗаказПокупателя <> ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
	|    И ТИПЗНАЧЕНИЯ(СтруктурнаяЕдиница) = ТИП(Справочник.СтруктурныеЕдиницы)
	|    И (СтруктурнаяЕдиница = &Склад ИЛИ &Склад = ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка))) КАК Запасы
	|СГРУППИРОВАТЬ ПО Запасы.ЗаказПокупателя
	|ИМЕЮЩИЕ СУММА(Запасы.КоличествоОстаток) > 0
	|;
	|ВЫБРАТЬ Обязательства.Заказ,
	|    Обязательства.Количество - ЕСТЬNULL(Резервы.Количество, 0) КАК Количество
	|ИЗ АС_ОбязательстваЗаказов КАК Обязательства
	|    ЛЕВОЕ СОЕДИНЕНИЕ АС_РезервыЗаказов КАК Резервы ПО Обязательства.Заказ = Резервы.Заказ
	|ГДЕ Обязательства.Количество > ЕСТЬNULL(Резервы.Количество, 0)";

КонецФункции

Процедура УчестьАктивныеЗаказыКарточки(ТаблицаРезультат, Контекст, Сегодня) Экспорт

	Контексты = Новый Массив;
	Контексты.Добавить(Контекст);
	УчестьАктивныеЗаказыСписка(ТаблицаРезультат, Контексты, Сегодня);

КонецПроцедуры

// Список и карточка используют один штатный расчёт и одинаковые области.
Функция ДоступенРасчетЗакупки() Экспорт

	Возврат ПравоДоступа("Чтение", Метаданные.РегистрыНакопления.Продажи)
		И ПравоДоступа("Чтение", Метаданные.РегистрыНакопления.ЗаказыПоставщикам)
		И ПравоДоступа("Чтение", Метаданные.РегистрыНакопления.РазмещениеЗаказов)
		И ПравоДоступа("Чтение", Метаданные.РегистрыНакопления.Запасы)
		И ПравоДоступа("Чтение", Метаданные.РегистрыНакопления.ЗаказыПокупателей)
		И ПравоДоступа("Чтение", Метаданные.РегистрыНакопления.ПотребностьВЗапасах)
		И ПравоДоступа("Чтение", Метаданные.РегистрыНакопления.ГрафикДвиженияЗапасов)
		И ПравоДоступа("Чтение", Метаданные.РегистрыСведений.УправлениеЗапасами);

КонецФункции



Функция ТекстОбластейСпискаЗакупки(ОграничитьТовары = Ложь)

	Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|    Данные.Номенклатура, Данные.Организация, Данные.Характеристика, Данные.Склад, Данные.ОбщаяНорма, Данные.ЕстьНорма
	|ИЗ (
	|    ВЫБРАТЬ Запасы.Номенклатура КАК Номенклатура, Запасы.Организация КАК Организация, Запасы.Характеристика КАК Характеристика,
	|        Запасы.СтруктурнаяЕдиница КАК Склад, ЛОЖЬ КАК ОбщаяНорма, ЛОЖЬ КАК ЕстьНорма
	|    ИЗ РегистрНакопления.Запасы.Остатки(, ТИПЗНАЧЕНИЯ(СтруктурнаяЕдиница) = ТИП(Справочник.СтруктурныеЕдиницы) И {ОтборТоваров}) КАК Запасы
	|    ОБЪЕДИНИТЬ
	|    ВЫБРАТЬ Продажи.Номенклатура, Продажи.Организация, Продажи.Характеристика, Продажи.Склад, ЛОЖЬ, ЛОЖЬ
	|    ИЗ РегистрНакопления.Продажи.Обороты(&НачалоИстории, &КонецИстории, День,
	|        {ОтборТоваров}) КАК Продажи
	|    ОБЪЕДИНИТЬ
	|    ВЫБРАТЬ Покупатели.Номенклатура, Покупатели.Организация, Покупатели.Характеристика, Покупатели.Склад, ЛОЖЬ, ЛОЖЬ
	|    ИЗ РегистрНакопления.ЗаказыПокупателей.Остатки(, {ОтборТоваров}) КАК Покупатели
	|    ОБЪЕДИНИТЬ
	|    ВЫБРАТЬ Материалы.Номенклатура, Материалы.Организация, Материалы.Характеристика, Материалы.Склад, ЛОЖЬ, ЛОЖЬ
	|    ИЗ РегистрНакопления.ПотребностьВЗапасах.Остатки(, ЗаказНаПроизводство = ЗНАЧЕНИЕ(Документ.ЗаказНаПроизводство.ПустаяСсылка)
	|        И ТипДвижения = ЗНАЧЕНИЕ(Перечисление.ТипыДвиженийЗапасов.Отгрузка) И {ОтборТоваров}) КАК Материалы
	|    ОБЪЕДИНИТЬ
	|    ВЫБРАТЬ Поставщики.Номенклатура, Поставщики.Организация, Поставщики.Характеристика, Поставщики.Склад, ЛОЖЬ, ЛОЖЬ
	|    ИЗ РегистрНакопления.ЗаказыПоставщикам.Остатки(, {ОтборТоваров}) КАК Поставщики
	|    ОБЪЕДИНИТЬ
	|    ВЫБРАТЬ Нормы.Номенклатура, Нормы.Организация, Нормы.Характеристика, Нормы.Склад,
	|        Нормы.Склад = ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка), ИСТИНА
	|    ИЗ РегистрСведений.УправлениеЗапасами КАК Нормы
	|    ГДЕ (Нормы.МинимальныйУровеньЗапаса > 0 ИЛИ Нормы.МаксимальныйУровеньЗапаса > 0) И {ОтборТоваров}
	|) КАК Данные
	|    ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Товар
	|    ПО Данные.Номенклатура = Товар.Ссылка
	|ГДЕ НЕ Товар.ЭтоГруппа И НЕ Товар.ПометкаУдаления
	|    И Товар.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)
	|    И Товар.СпособПополнения = ЗНАЧЕНИЕ(Перечисление.СпособыПополненияЗапасов.Закупка)";

	Возврат СтрЗаменить(Текст, "{ОтборТоваров}",
		?(ОграничитьТовары, "Номенклатура В (&ТоварыОтбора)", "ИСТИНА"));

КонецФункции

Функция ТекстПотребностиСпискаЗакупки()

	Возврат "ВЫБРАТЬ
	|    Обязательства.Номенклатура, Обязательства.Характеристика, Обязательства.Заказ, СУММА(Обязательства.Количество) КАК Количество
	|ПОМЕСТИТЬ АС_ОбязательстваЗаказов
	|ИЗ (
	|    ВЫБРАТЬ Покупатели.Номенклатура КАК Номенклатура, ВЫБОР КОГДА &ИспользоватьХарактеристики ТОГДА Покупатели.Характеристика ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КОНЕЦ КАК Характеристика,
	|        Покупатели.ЗаказПокупателя КАК Заказ, Покупатели.КоличествоОстаток КАК Количество
	|    ИЗ РегистрНакопления.ЗаказыПокупателей.Остатки(&ДатаОстатков,
	|        Организация = &Организация И Номенклатура В (&Товары)
	|        И (Склад = &Склад ИЛИ &Склад = ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка))) КАК Покупатели
	|    ОБЪЕДИНИТЬ ВСЕ
	|    ВЫБРАТЬ Материалы.Номенклатура, ВЫБОР КОГДА &ИспользоватьХарактеристики ТОГДА Материалы.Характеристика ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КОНЕЦ,
	|        Материалы.ЗаказПокупателя, Материалы.КоличествоОстаток
	|    ИЗ РегистрНакопления.ПотребностьВЗапасах.Остатки(&ДатаОстатков,
	|        Организация = &Организация И Номенклатура В (&Товары)
	|        И ТипДвижения = ЗНАЧЕНИЕ(Перечисление.ТипыДвиженийЗапасов.Отгрузка)
	|        И ЗаказНаПроизводство = ЗНАЧЕНИЕ(Документ.ЗаказНаПроизводство.ПустаяСсылка)
	|        И (Склад = &Склад ИЛИ &Склад = ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка))) КАК Материалы
	|) КАК Обязательства
	|СГРУППИРОВАТЬ ПО Обязательства.Номенклатура, Обязательства.Характеристика, Обязательства.Заказ
	|ИМЕЮЩИЕ СУММА(Обязательства.Количество) > 0
	|;
	|ВЫБРАТЬ Запасы.Номенклатура КАК Номенклатура, ВЫБОР КОГДА &ИспользоватьХарактеристики ТОГДА Запасы.Характеристика ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КОНЕЦ КАК Характеристика,
	|    Запасы.ЗаказПокупателя КАК Заказ, СУММА(Запасы.КоличествоОстаток) КАК Количество
	|ПОМЕСТИТЬ АС_РезервыЗаказов
	|ИЗ РегистрНакопления.Запасы.Остатки(&ДатаОстатков,
	|    Организация = &Организация И Номенклатура В (&Товары)
	|    И ЗаказПокупателя <> ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
	|    И ТИПЗНАЧЕНИЯ(СтруктурнаяЕдиница) = ТИП(Справочник.СтруктурныеЕдиницы)
	|    И (СтруктурнаяЕдиница = &Склад ИЛИ &Склад = ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка))) КАК Запасы
	|СГРУППИРОВАТЬ ПО Запасы.Номенклатура, ВЫБОР КОГДА &ИспользоватьХарактеристики ТОГДА Запасы.Характеристика ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КОНЕЦ, Запасы.ЗаказПокупателя
	|ИМЕЮЩИЕ СУММА(Запасы.КоличествоОстаток) > 0
	|;
	|ВЫБРАТЬ Обязательства.Номенклатура, Обязательства.Характеристика, Обязательства.Заказ,
	|    Обязательства.Количество - ЕСТЬNULL(Резервы.Количество, 0) КАК Количество
	|ИЗ АС_ОбязательстваЗаказов КАК Обязательства
	|    ЛЕВОЕ СОЕДИНЕНИЕ АС_РезервыЗаказов КАК Резервы ПО Обязательства.Заказ = Резервы.Заказ
	|        И Обязательства.Номенклатура = Резервы.Номенклатура
	|        И Обязательства.Характеристика = Резервы.Характеристика
	|ГДЕ Обязательства.Количество > ЕСТЬNULL(Резервы.Количество, 0)";

КонецФункции

Функция КлючПарыЗакупки(Номенклатура, Характеристика)

	// Служебные строки штатной СКД не являются товарами для закупки.
	Если ТипЗнч(Номенклатура) <> Тип("СправочникСсылка.Номенклатура")
		Или Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат "";
	КонецЕсли;
	ХарактеристикаДляКлюча = ХарактеристикаЗакупки(Характеристика, Истина);
	Возврат Строка(Номенклатура.УникальныйИдентификатор()) + "|"
		+ Строка(ХарактеристикаДляКлюча.УникальныйИдентификатор());

КонецФункции

Функция ПодготовитьОбластиСпискаЗакупки(НачалоИстории, КонецИстории, ТоварыОтбора = Неопределено)

	Запрос = Новый Запрос(ТекстОбластейСпискаЗакупки(ТоварыОтбора <> Неопределено));
	Запрос.УстановитьПараметр("НачалоИстории", НачалоИстории);
	Запрос.УстановитьПараметр("КонецИстории", КонецИстории);
	Запрос.УстановитьПараметр("ТоварыОтбора", ТоварыОтбора);
	ФиксированнаяОрганизация = Неопределено;
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьНесколькоОрганизаций") Тогда
		ФиксированнаяОрганизация = Справочники.Организации.ОсновнаяОрганизация;
	ИначеЕсли ЗначениеЗаполнено(Константы.Компания.Получить()) Тогда
		ФиксированнаяОрганизация = Константы.Компания.Получить();
	КонецЕсли;
	ИспользоватьХарактеристики = ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристики");
	ПоТоварам = Новый Соответствие;
	ПоОбластям = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Товар = ПоТоварам.Получить(Выборка.Номенклатура);
		Если Товар = Неопределено Тогда
			Товар = Новый Структура("Области,Показатель", Новый Массив,
				Новый Структура("Количество,Доступно,Сообщение", 0, Истина, ""));
			ПоТоварам.Вставить(Выборка.Номенклатура, Товар);
		КонецЕсли;
		Организация = Выборка.Организация;
		Если ЗначениеЗаполнено(ФиксированнаяОрганизация) И Организация <> ФиксированнаяОрганизация Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Организация) Тогда
			Продолжить;
		КонецЕсли;
		Характеристика = ?(ИспользоватьХарактеристики, Выборка.Характеристика,
			Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
		Ключ = КлючПарыЗакупки(Выборка.Номенклатура, Характеристика) + "|"
			+ Строка(Организация.УникальныйИдентификатор());
		Область = ПоОбластям.Получить(Ключ);
		Если Область = Неопределено Тогда
			Область = Новый Структура("Организация,Характеристика,Склад,Склады,ОбщаяНорма,БезСклада,СкладскиеНормы",
				Организация, Характеристика, Справочники.СтруктурныеЕдиницы.ПустаяСсылка(),
				Новый Соответствие, Ложь, Ложь, Ложь);
			ПоОбластям.Вставить(Ключ, Область);
			Товар.Области.Добавить(Область);
		КонецЕсли;
		Область.ОбщаяНорма = Область.ОбщаяНорма Или Выборка.ОбщаяНорма;
		Если ЗначениеЗаполнено(Выборка.Склад) Тогда
			Область.Склады.Вставить(Выборка.Склад, Истина);
			Область.СкладскиеНормы = Область.СкладскиеНормы Или Выборка.ЕстьНорма;
		ИначеЕсли Не Выборка.ОбщаяНорма Тогда
			Область.БезСклада = Истина;
		КонецЕсли;
	КонецЦикла;
	Группы = Новый Соответствие;
	Результат = Новый Соответствие;
	Для Каждого ПараТовара Из ПоТоварам Цикл
		Товар = ПараТовара.Значение;
		Результат.Вставить(ПараТовара.Ключ, Товар.Показатель);
		Сообщение = "";
		Области = РаскрытьОбластиШтатногоРасчета(Товар.Области, Сообщение);
		Если Не ПустаяСтрока(Сообщение) Тогда
			Товар.Показатель.Доступно = Ложь;
			Товар.Показатель.Сообщение = Сообщение;
			Продолжить;
		КонецЕсли;
		Для Каждого Область Из Области Цикл
			Ключ = Строка(Область.Организация.УникальныйИдентификатор()) + "|"
				+ Строка(Область.Склад.УникальныйИдентификатор());
			Группа = Группы.Получить(Ключ);
			Если Группа = Неопределено Тогда
				Группа = Новый Структура("Организация,Склад,Товары,Пары", Область.Организация,
					Область.Склад, Новый Соответствие, Новый Соответствие);
				Группы.Вставить(Ключ, Группа);
			КонецЕсли;
			Группа.Товары.Вставить(ПараТовара.Ключ, Истина);
			Группа.Пары.Вставить(КлючПарыЗакупки(ПараТовара.Ключ, Область.Характеристика),
				Новый Структура("Номенклатура,Характеристика", ПараТовара.Ключ, Область.Характеристика));
		КонецЦикла;
	КонецЦикла;
	Возврат Новый Структура("Группы,Результат", Группы, Результат);

КонецФункции

Процедура РассчитатьЗакупкуВФоне(Параметры, АдресРезультата) Экспорт

	Если Не ДоступенРасчетЗакупки() Тогда
		ВызватьИсключение "Недостаточно прав для расчёта рекомендаций по закупке";
	КонецЕсли;
	Сегодня = НачалоДня(ТекущаяДатаСеанса());
	НачалоИстории = ДобавитьМесяц(НачалоМесяца(Сегодня), -4);
	КонецИстории = НачалоМесяца(Сегодня) - 1;
	ТоварыОтбора = Параметры.ТоварыОтбора;
	Если ТоварыОтбора <> Неопределено Тогда
		Если ТоварыОтбора.Количество() = 0 Тогда
			// Пустой отбор продаж означает отсутствие товаров, а не весь справочник.
			Итог = Новый Структура("БезИзменений,Результат,Подпись,ДатаРасчета,КлючОбласти",
				Ложь, Новый Соответствие, Параметры.КлючОбласти, ТекущаяДатаСеанса(), Параметры.КлючОбласти);
			ПоместитьВоВременноеХранилище(Итог, АдресРезультата);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Подпись = ПодписьИсточниковЗакупки(НачалоИстории, КонецИстории, ТоварыОтбора, Параметры.КлючОбласти);
	Если Подпись = Параметры.ПредыдущаяПодпись Тогда
		ПоместитьВоВременноеХранилище(Новый Структура("БезИзменений", Истина), АдресРезультата);
		Возврат;
	КонецЕсли;
	Расчет = ПодготовитьОбластиСпискаЗакупки(НачалоИстории, КонецИстории, ТоварыОтбора);
	Для Каждого ПараГруппы Из Расчет.Группы Цикл
		Группа = ПараГруппы.Значение;
		Товары = Новый Массив;
		Для Каждого ПараТовара Из Группа.Товары Цикл
			Товары.Добавить(ПараТовара.Ключ);
		КонецЦикла;
		Попытка
			Дефициты = ШтатныеПотребностиВОбласти(Товары, Группа.Организация,
				Группа.Склад, Неопределено, НачалоИстории, КонецИстории, Сегодня, Группа.Пары);
			Для Каждого ПараПозиции Из Группа.Пары Цикл
				Показатель = Расчет.Результат.Получить(ПараПозиции.Значение.Номенклатура);
				// Округляем каждую характеристику в каждой области, затем складываем.
				Показатель.Количество = Показатель.Количество
					+ ОкруглитьКоличествоЗакупки(Дефициты.Получить(ПараПозиции.Ключ));
			КонецЦикла;
		Исключение
			Для Каждого Товар Из Товары Цикл
				Показатель = Расчет.Результат.Получить(Товар);
				Показатель.Доступно = Ложь;
				Показатель.Сообщение = "Штатный расчёт недоступен; подробности в журнале регистрации";
			КонецЦикла;
			ЗаписьЖурналаРегистрации("АС.Закупки.Список", УровеньЖурналаРегистрации.Ошибка,
				, , ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
	Для Каждого Пара Из Расчет.Результат Цикл
		Если Не Пара.Значение.Доступно Тогда
			Пара.Значение.Количество = 0;
		КонецЕсли;
	КонецЦикла;
	Итог = Новый Структура("БезИзменений,Результат,Подпись,ДатаРасчета", Ложь,
		Расчет.Результат, Подпись, ТекущаяДатаСеанса());
	Итог.Вставить("КлючОбласти", Параметры.КлючОбласти);
	ПоместитьВоВременноеХранилище(Итог, АдресРезультата);

КонецПроцедуры

Функция КонтекстыПотребностиСписка(Товары, Организация, Склад, Пары)

	Запрос = Новый Запрос(ТекстПотребностиСпискаЗакупки());
	Запрос.УстановитьПараметр("Товары", Товары);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("ИспользоватьХарактеристики", ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристики"));
	Запрос.УстановитьПараметр("ДатаОстатков", ТекущаяДатаСеанса());
	ПоПарам = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключ = КлючПарыЗакупки(Выборка.Номенклатура, Выборка.Характеристика);
		Если Пары.Получить(Ключ) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Контекст = ПоПарам.Получить(Ключ);
		Если Контекст = Неопределено Тогда
			Контекст = Новый Структура("Номенклатура,Характеристика,Склад,Потребность",
				Выборка.Номенклатура, Выборка.Характеристика, Склад, Новый Массив);
			ПоПарам.Вставить(Ключ, Контекст);
		КонецЕсли;
		Контекст.Потребность.Добавить(Новый Структура("Заказ,Количество", Выборка.Заказ, Выборка.Количество));
	КонецЦикла;
	Контексты = Новый Массив;
	Для Каждого Пара Из ПоПарам Цикл
		Контексты.Добавить(Пара.Значение);
	КонецЦикла;
	Возврат Контексты;

КонецФункции

Процедура УчестьАктивныеЗаказыСписка(ТаблицаРезультат, Контексты, Сегодня) Экспорт

	// Коллекция СКД не гарантирует числовые значения по умолчанию у новой
	// строки. Набор соответствует штатной ДобавитьСтрокуДерева; необязательные
	// колонки не добавляем. Исходные строки остатков и прогноза не меняем.
	ЧисловыеКолонки = Новый Массив;
	Для Каждого ИмяКолонки Из СтрРазделить(
		"ЗаказОстаток,НачальныйОстаток,Поступление,ПоступлениеПросрочено,Потребность,ПотребностьПросрочено,"
		+ "МинимальныйЗапас,МаксимальныйЗапас,КонечныйОстаток,Просрочено,Дефицит,НевозможноОбеспечить", ",") Цикл
		Если ТаблицаРезультат.Колонки.Найти(ИмяКолонки) <> Неопределено Тогда
			ЧисловыеКолонки.Добавить(ИмяКолонки);
		КонецЕсли;
	КонецЦикла;
	// Один индекс вместо полного обхода таблицы для каждого товара/заказа.
	ЕстьКолонкаСклада = ТаблицаРезультат.Колонки.Найти("Склад") <> Неопределено;
	ИспользоватьХарактеристики = ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристики");
	ПоПарам = Новый Соответствие;
	Для Каждого Строка Из ТаблицаРезультат Цикл
		Если Строка.Поступление <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(Строка.Номенклатура) <> Тип("СправочникСсылка.Номенклатура")
			Или Не ЗначениеЗаполнено(Строка.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		Ключ = КлючПарыЗакупки(Строка.Номенклатура,
			ХарактеристикаЗакупки(Строка.Характеристика, ИспользоватьХарактеристики));
		ПоЗаказам = ПоПарам.Получить(Ключ);
		Если ПоЗаказам = Неопределено Тогда
			ПоЗаказам = Новый Соответствие;
			ПоПарам.Вставить(Ключ, ПоЗаказам);
		КонецЕсли;
		СтрокиЗаказа = ПоЗаказам.Получить(Строка.Заказ);
		Если СтрокиЗаказа = Неопределено Тогда
			СтрокиЗаказа = Новый Массив;
			ПоЗаказам.Вставить(Строка.Заказ, СтрокиЗаказа);
		КонецЕсли;
		СтрокиЗаказа.Добавить(Строка);
	КонецЦикла;
	Для Каждого Контекст Из Контексты Цикл
		ХарактеристикаКонтекста = ХарактеристикаЗакупки(Контекст.Характеристика, ИспользоватьХарактеристики);
		ПоЗаказам = ПоПарам.Получить(КлючПарыЗакупки(Контекст.Номенклатура, ХарактеристикаКонтекста));
		Для Каждого Потребность Из Контекст.Потребность Цикл
			Осталось = Потребность.Количество;
			СтрокиЗаказа = Неопределено;
			Если ПоЗаказам <> Неопределено Тогда
				СтрокиЗаказа = ПоЗаказам.Получить(Потребность.Заказ);
			КонецЕсли;
			Если СтрокиЗаказа <> Неопределено Тогда
				Для Каждого Поступление Из СтрокиЗаказа Цикл
					Обеспечено = Мин(Осталось, Поступление.Поступление);
					Поступление.Поступление = Поступление.Поступление - Обеспечено;
					Осталось = Осталось - Обеспечено;
					Если Осталось = 0 Тогда
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			Если Осталось > 0 Тогда
				Строка = ТаблицаРезультат.Добавить();
				Для Каждого ИмяКолонки Из ЧисловыеКолонки Цикл
					Строка[ИмяКолонки] = 0;
				КонецЦикла;
				Строка.Период = Сегодня;
				Если ЕстьКолонкаСклада Тогда
					Строка.Склад = Контекст.Склад;
				КонецЕсли;
				Строка.Номенклатура = Контекст.Номенклатура;
				Строка.ЕдиницаИзмерения = Контекст.Номенклатура.ЕдиницаИзмерения;
				Строка.Характеристика = ХарактеристикаКонтекста;
				Строка.Заказ = Потребность.Заказ;
				Строка.ТипДвижения = Перечисления.ТипыДвиженийЗапасов.Отгрузка;
				Строка.Потребность = Осталось;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция ПодписьИсточниковЗакупки(НачалоИстории, КонецИстории, ТоварыОтбора = Неопределено, КлючОбласти = "")

	// Проверка выполняется в фоне. Полная СКД запускается только при изменении
	// входных данных; порядок чтения строк СУБД на подпись не влияет.
	Части = Новый Массив;
	// Не используем кэш ошибочного результата прежней реализации.
	Части.Добавить("АС_ЗакупкиСписок_4");
	Части.Добавить(КлючОбласти);
	УсловиеТоваров = ?(ТоварыОтбора = Неопределено, "", "Номенклатура В (&ТоварыОтбора)");
	Части.Добавить(ЗначениеВСтрокуВнутр(НачалоДня(ТекущаяДатаСеанса())));
	Части.Добавить(Строка(ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристики")));
	Части.Добавить(Строка(ПолучитьФункциональнуюОпцию("ИспользоватьНесколькоОрганизаций")));
	Части.Добавить(ЗначениеВСтрокуВнутр(Константы.Компания.Получить()));
	Части.Добавить(ЗначениеВСтрокуВнутр(Справочники.Организации.ОсновнаяОрганизация));
	Источники = Новый Массив;
	Для Каждого Имя Из СтрРазделить("Запасы,ЗаказыПокупателей,ПотребностьВЗапасах,ЗаказыПоставщикам,РазмещениеЗаказов", ",") Цикл
		Источники.Добавить(Новый Структура("Метаданные,Текст",
			Метаданные.РегистрыНакопления[Имя],
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ Данные.* ИЗ РегистрНакопления." + Имя + ".Остатки(, " + УсловиеТоваров + ") КАК Данные"));
	КонецЦикла;
	Источники.Добавить(Новый Структура("Метаданные,Текст", Метаданные.РегистрыНакопления.Продажи,
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ Данные.* ИЗ РегистрНакопления.Продажи.Обороты(&НачалоИстории, &КонецИстории, День, " + УсловиеТоваров + ") КАК Данные"));
	// Дни наличия тоже входят в прогноз: текущего остатка для подписи мало.
	Источники.Добавить(Новый Структура("Метаданные,Текст", Метаданные.РегистрыНакопления.Запасы,
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ Данные.* ИЗ РегистрНакопления.Запасы.ОстаткиИОбороты(&НачалоИстории, &КонецИстории, День, ДвиженияИГраницыПериода, " + УсловиеТоваров + ") КАК Данные"));
	Для Каждого Имя Из СтрРазделить("ЗаказыНаПроизводство,ЗаказыНаПеремещение", ",") Цикл
		Описание = Метаданные.РегистрыНакопления[Имя];
		Если ПравоДоступа("Чтение", Описание) Тогда
			ДатаОстатков = ?(Имя = "ЗаказыНаПеремещение", "&КонецПланирования", "");
			Источники.Добавить(Новый Структура("Метаданные,Текст", Описание,
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ Данные.* ИЗ РегистрНакопления." + Имя + ".Остатки(" + ДатаОстатков + ", " + УсловиеТоваров + ") КАК Данные"));
		Иначе
			Части.Добавить(Имя + ":нет доступа");
		КонецЕсли;
	КонецЦикла;
	ТекстГрафика = "ВЫБРАТЬ РАЗРЕШЕННЫЕ Данные.* ИЗ РегистрНакопления.ГрафикДвиженияЗапасов КАК Данные";
	Если ПравоДоступа("Чтение", Метаданные.РегистрыНакопления.ЗаказыНаПроизводство)
		И ПравоДоступа("Чтение", Метаданные.РегистрыНакопления.ЗаказыНаПеремещение) Тогда
		// Raw даты за пределами плана тоже значимы. Отсекаем только историю
		// уже закрытых заказов, которую штатная СКД больше не соединяет.
		ТекстГрафика = ТекстГрафика + " ГДЕ Данные.Заказ В (
		| ВЫБРАТЬ ЗаказПоставщику ИЗ РегистрНакопления.ЗаказыПоставщикам.Остатки()
		| ОБЪЕДИНИТЬ
		| ВЫБРАТЬ ЗаказНаПроизводство ИЗ РегистрНакопления.ЗаказыНаПроизводство.Остатки()
		| ОБЪЕДИНИТЬ
		| ВЫБРАТЬ ЗаказНаПеремещение ИЗ РегистрНакопления.ЗаказыНаПеремещение.Остатки(&КонецПланирования))";
	КонецЕсли;
	Если ТоварыОтбора <> Неопределено Тогда
		Если СтрНайти(ТекстГрафика, " ГДЕ ") > 0 Тогда
			ТекстГрафика = ТекстГрафика + " И Данные.Номенклатура В (&ТоварыОтбора)";
		Иначе
			ТекстГрафика = ТекстГрафика + " ГДЕ Данные.Номенклатура В (&ТоварыОтбора)";
		КонецЕсли;
		ТекстГрафика = СтрЗаменить(ТекстГрафика, ".Остатки()", ".Остатки(, " + УсловиеТоваров + ")");
		ТекстГрафика = СтрЗаменить(ТекстГрафика, ".Остатки(&КонецПланирования)",
			".Остатки(&КонецПланирования, " + УсловиеТоваров + ")");
	КонецЕсли;
	Источники.Добавить(Новый Структура("Метаданные,Текст", Метаданные.РегистрыНакопления.ГрафикДвиженияЗапасов, ТекстГрафика));
	Для Каждого Имя Из СтрРазделить("УправлениеЗапасами,ГрафикиРаботыСтруктурныхЕдиниц,ГрафикиРаботы,ОтклоненияОтГрафиковРаботыРесурсов", ",") Цикл
		Описание = Метаданные.РегистрыСведений.Найти(Имя);
		Если Описание <> Неопределено Тогда
			Если ПравоДоступа("Чтение", Описание) Тогда
				Источники.Добавить(Новый Структура("Метаданные,Текст", Описание,
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ Данные.* ИЗ РегистрСведений." + Имя + " КАК Данные"));
			Иначе
				Части.Добавить(Имя + ":нет доступа");
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Источник Из Источники Цикл
		ТекстИсточника = Источник.Текст;
		Если ТоварыОтбора <> Неопределено И Источник.Метаданные = Метаданные.РегистрыСведений.УправлениеЗапасами Тогда
			ТекстИсточника = ТекстИсточника + " ГДЕ Номенклатура В (&ТоварыОтбора)";
		КонецЕсли;
		Запрос = Новый Запрос(ТекстИсточника);
		Запрос.УстановитьПараметр("ТоварыОтбора", ТоварыОтбора);
		Запрос.УстановитьПараметр("НачалоИстории", НачалоИстории);
		Запрос.УстановитьПараметр("КонецИстории", КонецИстории);
		Запрос.УстановитьПараметр("КонецПланирования", ДобавитьМесяц(НачалоДня(ТекущаяДатаСеанса()), 1) - 1);
		Таблица = Запрос.Выполнить().Выгрузить();
		Порядок = Новый Массив;
		Для Каждого Измерение Из Источник.Метаданные.Измерения Цикл
			Если Таблица.Колонки.Найти(Измерение.Имя) <> Неопределено Тогда
				Порядок.Добавить(Измерение.Имя);
			КонецЕсли;
		КонецЦикла;
		Для Каждого Имя Из СтрРазделить("Период,Регистратор,НомерСтроки", ",") Цикл
			Если Таблица.Колонки.Найти(Имя) <> Неопределено И Порядок.Найти(Имя) = Неопределено Тогда
				Порядок.Добавить(Имя);
			КонецЕсли;
		КонецЦикла;
		Если Порядок.Количество() > 0 Тогда
			Таблица.Сортировать(СтрСоединить(Порядок, ","));
		КонецЕсли;
		Части.Добавить(ОбщегоНазначенияИС.ХэшСуммаСтроки(ЗначениеВСтрокуВнутр(Таблица)));
	КонецЦикла;
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ Ссылка, ТипНоменклатуры, СпособПополнения,
	| ПометкаУдаления, ЭтоГруппа, ЕдиницаИзмерения, Недействителен, ТолькоПоддержкаОстаткаПриРасчетеПотребностей ИЗ Справочник.Номенклатура УПОРЯДОЧИТЬ ПО Ссылка");
	Если ТоварыОтбора <> Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, " УПОРЯДОЧИТЬ ПО Ссылка",
			" ГДЕ Ссылка В (&ТоварыОтбора) УПОРЯДОЧИТЬ ПО Ссылка");
		Запрос.УстановитьПараметр("ТоварыОтбора", ТоварыОтбора);
	КонецЕсли;
	Части.Добавить(ОбщегоНазначенияИС.ХэшСуммаСтроки(ЗначениеВСтрокуВнутр(Запрос.Выполнить().Выгрузить())));
	Возврат ОбщегоНазначенияИС.ХэшСуммаСтроки(СтрСоединить(Части, "|"));

КонецФункции

Функция ХарактеристикаЗакупки(Характеристика, ИспользоватьХарактеристики)

	// Без группировки по характеристике native оставляет в итоге
	// Неопределено/Null. Такой итог относится к пустой характеристике.
	Если Не ИспользоватьХарактеристики
		Или ТипЗнч(Характеристика) = Тип("Неопределено")
		Или ТипЗнч(Характеристика) = Тип("Null") Тогда
		Возврат Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	КонецЕсли;
	Если ТипЗнч(Характеристика) <> Тип("СправочникСсылка.ХарактеристикиНоменклатуры") Тогда
		ВызватьИсключение "Некорректный тип характеристики в данных расчёта закупки";
	КонецЕсли;
	Возврат Характеристика;

КонецФункции

Функция ДефицитыПоИтогамЗакупки(СтрокиИтогов, Товары, Пары, ИспользоватьХарактеристики)

	Дефициты = Новый Соответствие;
	Если Пары = Неопределено Тогда
		Для Каждого Товар Из Товары Цикл
			Дефициты.Вставить(Товар, 0);
		КонецЦикла;
	Иначе
		Для Каждого Пара Из Пары Цикл
			Дефициты.Вставить(Пара.Ключ, 0);
		КонецЦикла;
	КонецЕсли;
	Для Каждого Строка Из СтрокиИтогов Цикл
		// Берём корневые итоги товаров, не вложенные дни и служебные строки.
		Если Строка.ИмяГруппировки <> "Номенклатура"
			Или ТипЗнч(Строка.Номенклатура) <> Тип("СправочникСсылка.Номенклатура")
			Или Не ЗначениеЗаполнено(Строка.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		Если Пары = Неопределено Тогда
			Ключ = Строка.Номенклатура;
		Иначе
			Ключ = КлючПарыЗакупки(Строка.Номенклатура,
				ХарактеристикаЗакупки(Строка.Характеристика, ИспользоватьХарактеристики));
		КонецЕсли;
		Дефицит = Дефициты.Получить(Ключ);
		Если Дефицит <> Неопределено Тогда
			Дефициты.Вставить(Ключ, Дефицит + Макс(Строка.Дефицит, 0));
		КонецЕсли;
	КонецЦикла;
	Возврат Дефициты;

КонецФункции
