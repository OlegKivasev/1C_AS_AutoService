Функция ПокупательИзСписка(Контрагент)

	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Ложь;
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		| Ограничения.Контрагент
		|ИЗ РегистрСведений.АС_ОграниченияПокупателей КАК Ограничения
		|ГДЕ Ограничения.Контрагент = &Контрагент");
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

// В уже записанных заказах проверяем увеличение потребности, а не правку цены/комментария.
Функция ТекстОшибкиЗаказа(Заказ, ПроверятьВсеСтроки = Ложь,
	ПроверяемаяНоменклатура = Неопределено, ПроверяемаяХарактеристика = Неопределено,
	ПроверяемыйВариантКП = Неопределено)

	Если Не ПокупательИзСписка(Заказ.Контрагент) Или Заказ.ПометкаУдаления Тогда
		Возврат "";
	КонецЕсли;
	Если Не РаботаСЗаявкамиКлиентСервер.ЭтоТипЗаказаНаПродажу(Заказ.ВидОперации)
		И Заказ.ВидОперации <> Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаряд Тогда
		Возврат "";
	КонецЕсли;

	Строки = КоличестваЗаказа(Заказ, Истина);
	Если Строки.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	ПредыдущийЗаказ = Неопределено;
	Если ЗначениеЗаполнено(Заказ.Ссылка) Тогда
		ПредыдущийЗаказ = Заказ.Ссылка.ПолучитьОбъект();
	КонецЕсли;
	ПредыдущиеСтроки = Строки.СкопироватьКолонки();
	ТотЖеУчет = Ложь;
	ТотЖеПокупатель = Ложь;
	Если ПредыдущийЗаказ <> Неопределено Тогда
		ТотЖеУчет = ПредыдущийЗаказ.Организация = Заказ.Организация
			И ПредыдущийЗаказ.ВидОперации = Заказ.ВидОперации;
		ТотЖеПокупатель = ТотЖеУчет И ПредыдущийЗаказ.Контрагент = Заказ.Контрагент
			И Не ПредыдущийЗаказ.ПометкаУдаления
			И (ПредыдущийЗаказ.ВариантЗавершения <> Перечисления.ВариантыЗавершенияЗаказа.Отменен
				Или Заказ.ВариантЗавершения = Перечисления.ВариантыЗавершенияЗаказа.Отменен);
		Если ТотЖеУчет Тогда
			ПредыдущиеСтроки = КоличестваЗаказа(ПредыдущийЗаказ, Истина);
		КонецЕсли;
	КонецЕсли;
	ОтгруженныеТовары = ОтгруженоПоЗаказу(Заказ.Ссылка);

	Варианты = Строки.Скопировать();
	Варианты.Свернуть("НомерВариантаКП");
	Для Каждого Вариант Из Варианты Цикл
		Если ПроверяемыйВариантКП <> Неопределено
			И Вариант.НомерВариантаКП <> ПроверяемыйВариантКП Тогда
			Продолжить;
		КонецЕсли;
		СтрокиРасчета = Новый Массив;
		ТоварыРасчета = Новый Массив;
		Отбор = Новый Структура("НомерВариантаКП", Вариант.НомерВариантаКП);
		Для Каждого СтрокаТовара Из Строки.НайтиСтроки(Отбор) Цикл
			Если СтрокаТовара.Количество <= 0 Тогда
				Продолжить;
			КонецЕсли;
			Если ПроверяемаяНоменклатура <> Неопределено
				И (СтрокаТовара.Номенклатура <> ПроверяемаяНоменклатура
					Или СтрокаТовара.Характеристика <> ПроверяемаяХарактеристика) Тогда
				Продолжить;
			КонецЕсли;
			Ключ = Новый Структура("Номенклатура,Характеристика,НомерВариантаКП",
				СтрокаТовара.Номенклатура, СтрокаТовара.Характеристика, СтрокаТовара.НомерВариантаКП);
			СтароеКоличество = КоличествоПоКлючу(ПредыдущиеСтроки, Ключ);
			ПрежняяПотребность = ТотЖеПокупатель;
			Если ПредыдущийЗаказ <> Неопределено Тогда
				// Выбор другого основного варианта не должен обходить ограничение.
				ПрежняяПотребность = ПрежняяПотребность
					И (ПредыдущийЗаказ.ОсновнойВариантКП = Заказ.ОсновнойВариантКП
						Или СтрокаТовара.НомерВариантаКП <> Заказ.ОсновнойВариантКП);
			КонецЕсли;
			Если Не ПроверятьВсеСтроки И ПрежняяПотребность
				И СтрокаТовара.Количество <= СтароеКоличество Тогда
				Продолжить;
			КонецЕсли;

			Потребность = СтрокаТовара.Количество;
			Если ТотЖеУчет И ПредыдущийЗаказ.Проведен И Не ПредыдущийЗаказ.ПометкаУдаления
				И ПредыдущийЗаказ.ВариантЗавершения <> Перечисления.ВариантыЗавершенияЗаказа.Отменен
				И СтрокаТовара.НомерВариантаКП = ПредыдущийЗаказ.ОсновнойВариантКП Тогда
				// Отгруженная часть уже уменьшила физический остаток. Повторно её не вычитаем.
				КлючПотребности = Новый Структура("Номенклатура,Характеристика",
					СтрокаТовара.Номенклатура, СтрокаТовара.Характеристика);
				// Уже отгруженное количество под поставку не уменьшает складскую потребность второй раз.
				Отгружено = КоличествоПоКлючу(ОтгруженныеТовары, КлючПотребности);
				ОтгрузкаИзПоставки = Мин(СтрокаТовара.КоличествоИзПоставки,
					КоличествоПоКлючу(ПредыдущиеСтроки, Ключ, "КоличествоИзПоставки"));
				Потребность = Макс(0, Потребность - Макс(0, Отгружено - ОтгрузкаИзПоставки));
			КонецЕсли;
			Если Потребность <= 0 Тогда
				Продолжить;
			КонецЕсли;
			// Все количества уже приведены к базовой единице: сохранить нужно одну штуку,
			// а не одну упаковку. Одинаковые строки предварительно суммируются.
			СтрокиРасчета.Добавить(Новый Структура(
				"Номенклатура,Характеристика,ЕдиницаИзмерения,НеОтгружено,ИспользоватьВРасчете",
				СтрокаТовара.Номенклатура, СтрокаТовара.Характеристика,
				Справочники.ЕдиницыИзмерения.ПустаяСсылка(), Потребность, Истина));
			ТоварыРасчета.Добавить(СтрокаТовара);
		КонецЦикла;

		Остатки = АС_ДоступностьТоваровСервер.Рассчитать(
			СтрокиРасчета, Заказ.Организация, Заказ.Ссылка, , Ложь);
		Для Индекс = 0 По Остатки.Количество() - 1 Цикл
			Если Остатки[Индекс].Доступно < 1 Тогда
				Товар = ТоварыРасчета[Индекс];
				Возврат "Запрещено добавлять последнюю запчасть покупателям из списка «Ограничение покупателей». "
					+ "Согласовать с администратором." + Символы.ПС
					+ СтрШаблон("Покупатель: %1. Товар: %2%3.", Заказ.Контрагент, Товар.Номенклатура,
						?(ЗначениеЗаполнено(Товар.Характеристика), " (" + Строка(Товар.Характеристика) + ")", ""));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат "";

КонецФункции

Процедура ЗаблокироватьТовары(Заказ)

	Если Не ПокупательИзСписка(Заказ.Контрагент) Или Заказ.ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;
	Строки = КоличестваЗаказа(Заказ);
	Если Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Блокировка = Новый БлокировкаДанных;
	Для Каждого ИмяРегистра Из СтрРазделить("Запасы,ЗаказыПокупателей", ",") Цикл
		Элемент = Блокировка.Добавить("РегистрНакопления." + ИмяРегистра);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Элемент.ИсточникДанных = Строки;
		Элемент.ИспользоватьИзИсточникаДанных("Номенклатура", "Номенклатура");
		Элемент.ИспользоватьИзИсточникаДанных("Характеристика", "Характеристика");
	КонецЦикла;
	Блокировка.Заблокировать();

КонецПроцедуры

Функция КоличестваЗаказа(Заказ, УчестьПоставки = Ложь)

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Результат.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	Результат.Колонки.Добавить("НомерВариантаКП", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3)));
	Результат.Колонки.Добавить("КоличествоИзПоставки", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3)));
	Поставки = Неопределено;
	Если УчестьПоставки И ЗначениеЗаполнено(Заказ.Ссылка) Тогда
		Поставки = ТоварыПодЗаказПокупателя(Заказ);
		Если Поставки <> Неопределено Тогда
			ИсточникиПоставок = Заказ.АС_ИсточникиПоставок.Выгрузить();
			ИсточникиПоставок.Индексы.Добавить("ИдентификаторСтрокиПокупателя");
		КонецЕсли;
	КонецЕсли;
	ТипыТоваров = Новый Соответствие;
	// Материалы исполнителя и подарки также расходуют собственные запасы.
	// Материалы заказчика в ограничение не входят.
	Для Каждого ИмяТаблицы Из СтрРазделить("Запасы,Материалы,Подарки", ",") Цикл
		Для Каждого СтрокаЗаказа Из Заказ[ИмяТаблицы] Цикл
			Если ТипЗнч(СтрокаЗаказа.Номенклатура) <> Тип("СправочникСсылка.Номенклатура")
				Или Не ЗначениеЗаполнено(СтрокаЗаказа.Номенклатура)
				Или СтрокаЗаказа.Количество <= 0 Тогда
				Продолжить;
			КонецЕсли;
			Если (ИмяТаблицы = "Запасы" И СтрокаЗаказа.ЭтоРазделитель)
				Или (ИмяТаблицы = "Подарки" И СтрокаЗаказа.ВыдачаПодаркаОтменена) Тогда
				Продолжить;
			КонецЕсли;
			ТипТовара = ТипыТоваров.Получить(СтрокаЗаказа.Номенклатура);
			Если ТипТовара = Неопределено Тогда
				ТипТовара = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаЗаказа.Номенклатура, "ТипНоменклатуры");
				ТипыТоваров.Вставить(СтрокаЗаказа.Номенклатура, ТипТовара);
			КонецЕсли;
			Если ТипТовара <> Перечисления.ТипыНоменклатуры.Запас Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрока = Результат.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаЗаказа, "Номенклатура,Характеристика");
			НоваяСтрока.НомерВариантаКП = ?(ИмяТаблицы = "Материалы",
				Заказ.ОсновнойВариантКП, СтрокаЗаказа.НомерВариантаКП);
			Коэффициент = 1;
			Если ТипЗнч(СтрокаЗаказа.ЕдиницаИзмерения) = Тип("СправочникСсылка.ЕдиницыИзмерения")
				И ЗначениеЗаполнено(СтрокаЗаказа.ЕдиницаИзмерения) Тогда
				Коэффициент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаЗаказа.ЕдиницаИзмерения, "Коэффициент");
				Если Коэффициент <= 0 Тогда Коэффициент = 1; КонецЕсли;
			КонецЕсли;
			НоваяСтрока.Количество = Окр(СтрокаЗаказа.Количество * Коэффициент, 3);
			Если ИмяТаблицы = "Запасы" И Поставки <> Неопределено Тогда
				НоваяСтрока.КоличествоИзПоставки = КоличествоИзПоставки(
					СтрокаЗаказа, НоваяСтрока.Количество, ИсточникиПоставок, Поставки);
				НоваяСтрока.Количество = НоваяСтрока.Количество - НоваяСтрока.КоличествоИзПоставки;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Результат.Свернуть("Номенклатура,Характеристика,НомерВариантаКП", "Количество,КоличествоИзПоставки");
	Возврат Результат;

КонецФункции

Функция ТоварыПодЗаказПокупателя(Заказ)

	ЗаказыПоставщикам = Новый Массив;
	Для Каждого Источник Из Заказ.АС_ИсточникиПоставок Цикл
		Если ЗначениеЗаполнено(Источник.ЗаказПоставщику) Тогда
			ЗаказыПоставщикам.Добавить(Источник.ЗаказПоставщику);
		КонецЕсли;
	КонецЦикла;
	Для Каждого СтрокаЗаказа Из Заказ.Запасы Цикл
		Если ЗначениеЗаполнено(СтрокаЗаказа.АС_ЗаказПоставщику) Тогда
			ЗаказыПоставщикам.Добавить(СтрокаЗаказа.АС_ЗаказПоставщику);
		КонецЕсли;
	КонецЦикла;
	Если ЗаказыПоставщикам.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		| Запасы.Ссылка КАК ЗаказПоставщику,
		| Запасы.КлючСвязи КАК КлючСвязи,
		| Запасы.Номенклатура КАК Номенклатура,
		| Запасы.Характеристика КАК Характеристика,
		| Запасы.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		| СУММА(Запасы.Количество) КАК Количество,
		| МАКСИМУМ(ЕСТЬNULL(ВЫРАЗИТЬ(Запасы.ЕдиницаИзмерения КАК Справочник.ЕдиницыИзмерения).Коэффициент, 1)) КАК Коэффициент
		|ИЗ Документ.ЗаказПоставщику.Запасы КАК Запасы
		|ГДЕ Запасы.Ссылка В (&ЗаказыПоставщикам)
		| И Запасы.Количество > 0
		| И НЕ Запасы.Ссылка.ПометкаУдаления
		| И Запасы.Ссылка.ВариантЗавершения <> ЗНАЧЕНИЕ(Перечисление.ВариантыЗавершенияЗаказа.Отменен)
		| И (ВЫБОР
		|   КОГДА Запасы.Ссылка.ПоложениеЗаказаПокупателя = ЗНАЧЕНИЕ(Перечисление.ПоложениеРеквизитаНаФорме.ВТабличнойЧасти)
		|    ТОГДА Запасы.ЗаказПокупателя
		|   ИНАЧЕ Запасы.Ссылка.ЗаказПокупателя
		|  КОНЕЦ) = &ЗаказПокупателя
		|СГРУППИРОВАТЬ ПО Запасы.Ссылка, Запасы.КлючСвязи, Запасы.Номенклатура,
		| Запасы.Характеристика, Запасы.ЕдиницаИзмерения");
	Запрос.УстановитьПараметр("ЗаказыПоставщикам", ЗаказыПоставщикам);
	Запрос.УстановитьПараметр("ЗаказПокупателя", Заказ.Ссылка);
	Поставки = Запрос.Выполнить().Выгрузить();
	Если Поставки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Поставки.Индексы.Добавить("ЗаказПоставщику,КлючСвязи,Номенклатура,Характеристика");
	Поставки.Колонки.Добавить("Нераспределено");
	Для Каждого Поставка Из Поставки Цикл
		Если Поставка.Коэффициент <= 0 Тогда
			Поставка.Коэффициент = 1;
		КонецЕсли;
		Поставка.Нераспределено = Окр(Поставка.Количество * Поставка.Коэффициент, 3);
	КонецЦикла;
	Возврат Поставки;

КонецФункции

Функция КоличествоИзПоставки(СтрокаЗаказа, Количество, ИсточникиПоставок, Поставки)

	Связи = Новый Массив;
	Если ЗначениеЗаполнено(СтрокаЗаказа.АС_ИдентификаторГруппыПоставок) Тогда
		Связи = ИсточникиПоставок.НайтиСтроки(Новый Структура("ИдентификаторСтрокиПокупателя",
			СтрокаЗаказа.АС_ИдентификаторГруппыПоставок));
	КонецЕсли;
	Если Связи.Количество() = 0 И ЗначениеЗаполнено(СтрокаЗаказа.АС_ЗаказПоставщику) Тогда
		// Прямая связь используется до регистрации вкладов и в старых заказах.
		Связи.Добавить(Новый Структура("ЗаказПоставщику,КлючСвязиЗаказаПоставщику,Количество",
			СтрокаЗаказа.АС_ЗаказПоставщику, СтрокаЗаказа.АС_КлючСвязиЗаказаПоставщику, СтрокаЗаказа.Количество));
	КонецЕсли;

	Осталось = Количество;
	Для Каждого Связь Из Связи Цикл
		Ключ = Новый Структура("ЗаказПоставщику,КлючСвязи,Номенклатура,Характеристика",
			Связь.ЗаказПоставщику, Связь.КлючСвязиЗаказаПоставщику, СтрокаЗаказа.Номенклатура, СтрокаЗаказа.Характеристика);
		СтрокиПоставки = Поставки.НайтиСтроки(Ключ);
		Для Каждого Поставка Из СтрокиПоставки Цикл
			// У старых строк возможен нулевой ключ. При нескольких единицах используем совпадающую.
			Если СтрокиПоставки.Количество() > 1 И Поставка.ЕдиницаИзмерения <> СтрокаЗаказа.ЕдиницаИзмерения Тогда
				Продолжить;
			КонецЕсли;
			КоличествоПоставки = Мин(Осталось, Поставка.Нераспределено,
				Окр(Макс(0, Связь.Количество) * Поставка.Коэффициент, 3));
			Поставка.Нераспределено = Поставка.Нераспределено - КоличествоПоставки;
			Осталось = Осталось - КоличествоПоставки;
		КонецЦикла;
		Если Осталось = 0 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Количество - Осталось;

КонецФункции

Функция ОтгруженоПоЗаказу(Ссылка)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		| Запасы.Номенклатура КАК Номенклатура,
		| Запасы.Характеристика КАК Характеристика,
		| СУММА(Запасы.Количество) КАК Количество
		|ИЗ РегистрНакопления.Запасы КАК Запасы
		|ГДЕ Запасы.ЗаказПокупателя = &Ссылка
		| И Запасы.Активность
		| И Запасы.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		| И ТИПЗНАЧЕНИЯ(Запасы.СтруктурнаяЕдиница) = ТИП(Справочник.СтруктурныеЕдиницы)
		| И ТИПЗНАЧЕНИЯ(Запасы.Регистратор) <> ТИП(Документ.РезервированиеЗапасов)
		| И ТИПЗНАЧЕНИЯ(Запасы.Регистратор) <> ТИП(Документ.СборкаЗапасов)
		|СГРУППИРОВАТЬ ПО Запасы.Номенклатура, Запасы.Характеристика");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция КоличествоПоКлючу(Таблица, Ключ, ИмяКолонки = "Количество")

	Строки = Таблица.НайтиСтроки(Ключ);
	Возврат ?(Строки.Количество() = 0, 0, Строки[0][ИмяКолонки]);

КонецФункции

Функция КонтрагентОграничен(Контрагент) Экспорт

	Если Пользователи.ЭтоПолноправныйПользователь(, , Ложь) Тогда
		Возврат Ложь;
	КонецЕсли;

	БылПривилегированныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Результат = ПокупательИзСписка(Контрагент);
	Исключение
		УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
	Возврат Результат;

