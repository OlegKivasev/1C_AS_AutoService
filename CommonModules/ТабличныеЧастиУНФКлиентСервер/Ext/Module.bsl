&Вместо("РассчитатьСуммыВСтрокеТЧ")
Процедура АС_РассчитатьСуммыБезЗапрещенныхСкидок(СтрокаТабличнойЧасти, ПараметрыРасчета)

	Если АС_ЭтоСтрокаБезСкидки(СтрокаТабличнойЧасти) Тогда
		АС_РассчитатьСтрокуБезСкидки(СтрокаТабличнойЧасти, ПараметрыРасчета);
	Иначе
		ПродолжитьВызов(СтрокаТабличнойЧасти, ПараметрыРасчета);
	КонецЕсли;

КонецПроцедуры

Функция АС_ЭтоСтрокаБезСкидки(СтрокаТабличнойЧасти) Экспорт

	Возврат СтрокаТабличнойЧасти <> Неопределено
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(
			СтрокаТабличнойЧасти, "АС_БезСкидки")
		И СтрокаТабличнойЧасти.АС_БезСкидки;

КонецФункции

Процедура АС_РассчитатьСтрокуБезСкидки(СтрокаТабличнойЧасти, ПараметрыРасчета) Экспорт

	// Цена уже назначена администратором. Ни скидки, ни минимальные цены
	// не должны менять её при пересчете защищенной строки.
	СтрокаТабличнойЧасти.ПроцентСкидкиНаценки = 0;
	СтрокаТабличнойЧасти.СуммаСкидкиНаценки = 0;
	СтрокаТабличнойЧасти.ПроцентАвтоматическойСкидки = 0;
	СтрокаТабличнойЧасти.СуммаАвтоматическойСкидки = 0;
	// Оплата бонусами является платежом, уже отраженным в Предоплата.
	// Ее сохраняем, чтобы запрет скидок не изменял зачтенную оплату.
	КоличествоСтроки = СтрокаТабличнойЧасти.Количество;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(
		СтрокаТабличнойЧасти, "Кратность") Тогда
		КоличествоСтроки = КоличествоСтроки * СтрокаТабличнойЧасти.Кратность;
	КонецЕсли;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(
		СтрокаТабличнойЧасти, "Коэффициент") Тогда
		КоличествоСтроки = КоличествоСтроки * СтрокаТабличнойЧасти.Коэффициент;
	КонецЕсли;
	СтрокаТабличнойЧасти.Сумма = Макс(0, КоличествоСтроки * СтрокаТабличнойЧасти.Цена
		- СтрокаТабличнойЧасти.СуммаСкидкиОплатыБонусом);
	РассчитатьСуммуНДСИВсего(СтрокаТабличнойЧасти, ПараметрыРасчета);

КонецПроцедуры

Функция АС_ОтборСтрокСоСкидкой(Таблица, ПараметрыОтбора) Экспорт

	Если Таблица.Количество() = 0 Тогда
		Возврат ПараметрыОтбора;
	КонецЕсли;
	Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(
		Таблица[0], "АС_БезСкидки") Тогда
		Возврат ПараметрыОтбора;
	КонецЕсли;
	Если Таблица.НайтиСтроки(Новый Структура("АС_БезСкидки", Истина)).Количество() = 0 Тогда
		Возврат ПараметрыОтбора;
	КонецЕсли;
	// Копия сохраняет отбор варианта КП, отмененные строки и остальные
	// условия вызывающей формы; исходный отбор не изменяем.
	Результат = Новый Соответствие;
	Если ПараметрыОтбора <> Неопределено Тогда
		Для Каждого Условие Из ПараметрыОтбора Цикл
			Результат.Вставить(Условие.Ключ, Условие.Значение);
		КонецЦикла;
	КонецЕсли;
	Результат.Вставить("АС_БезСкидки", Ложь);
	Возврат Результат;

КонецФункции

Функция АС_НормализоватьСкидкиЗаказа(ОбъектЗаказа) Экспорт

	ПараметрыРасчета = Новый Структура("СуммаВключаетНДС", ОбъектЗаказа.СуммаВключаетНДС);
	ДетализацияОднозначна = Истина;
	Для Каждого СтрокаЗапаса Из ОбъектЗаказа.Запасы Цикл
		Если Не АС_ЭтоСтрокаБезСкидки(СтрокаЗапаса) Тогда
			Продолжить;
		КонецЕсли;
		АС_РассчитатьСтрокуБезСкидки(СтрокаЗапаса, ПараметрыРасчета);
		Если ОбъектЗаказа.ВидОперации = ПредопределенноеЗначение(
			"Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаряд") И СтрокаЗапаса.АС_НеУчитывать Тогда
			СтрокаЗапаса.Сумма = 0;
			СтрокаЗапаса.СуммаНДС = 0;
			СтрокаЗапаса.Всего = 0;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаЗапаса.КлючСвязи) Тогда
			Продолжить;
		КонецЕсли;
		Детализация = ОбъектЗаказа.СкидкиНаценки.НайтиСтроки(
			Новый Структура("КлючСвязи", СтрокаЗапаса.КлючСвязи));
		РаботыСКлючом = ОбъектЗаказа.Работы.НайтиСтроки(
			Новый Структура("КлючСвязиДляСкидокНаценок", СтрокаЗапаса.КлючСвязи));
		Если Детализация.Количество() > 0 И РаботыСКлючом.Количество() > 0 Тогда
			// До перерасчета новый товар может получить старый ключ работы.
			// У детализации нет признака ТЧ: чужую скидку не удаляем.
			ДетализацияОднозначна = Ложь;
			Продолжить;
		КонецЕсли;
		Для Каждого СтрокаСкидки Из Детализация Цикл
			ОбъектЗаказа.СкидкиНаценки.Удалить(СтрокаСкидки);
		КонецЦикла;
	КонецЦикла;
	Если Не ДетализацияОднозначна Тогда
		ОбъектЗаказа.СкидкиРассчитаны = Ложь;
	КонецЕсли;
	Возврат ДетализацияОднозначна;

КонецФункции
