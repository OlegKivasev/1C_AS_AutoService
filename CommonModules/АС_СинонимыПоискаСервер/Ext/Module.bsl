Функция ВариантыСтрокиПоиска(СтрокаПоиска) Экспорт

	Результат = Новый Массив;
	АС_ДобавитьУникальнуюСтроку(Результат, СокрЛП(Строка(СтрокаПоиска)));
	АС_ДобавитьВариантТочкиИЗапятой(Результат, СтрокаПоиска);
	НормализованнаяСтрока = НормализоватьСтроку(СтрокаПоиска);
	Если ПустаяСтрока(НормализованнаяСтрока) Тогда
		Возврат Результат;
	КонецЕсли;
	АС_ДобавитьУникальнуюСтроку(Результат, НормализованнаяСтрока);
	Если СтрНайти(НормализованнаяСтрока, "x") > 0 Тогда
		// Добавляем один альтернативный вариант, чтобы для латинского «x»
		// также запускался расширенный поиск. Все комбинации строятся ниже,
		// на уровне отдельных слов.
		АС_ДобавитьУникальнуюСтроку(
			Результат, СтрЗаменить(НормализованнаяСтрока, "x", "х"));
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|Группы.Ссылка КАК Группа,
		|Группы.Наименование КАК Синоним,
		|0 КАК НомерСтроки
		|ИЗ
		|Справочник.АС_ГруппыСинонимовПоиска КАК Группы
		|ГДЕ
		|НЕ Группы.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|Группы.Ссылка,
		|ГруппыСинонимы.Синоним,
		|ГруппыСинонимы.НомерСтроки
		|ИЗ
		|Справочник.АС_ГруппыСинонимовПоиска КАК Группы
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.АС_ГруппыСинонимовПоиска.Синонимы КАК ГруппыСинонимы
		|ПО Группы.Ссылка = ГруппыСинонимы.Ссылка
		|ГДЕ
		|НЕ Группы.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|Группа,
		|НомерСтроки;
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|Автомобили.Наименование КАК Наименование,
		|Автомобили.АС_Синонимы КАК Синонимы
		|ИЗ Справочник.АС_Автомобили КАК Автомобили
		|ГДЕ НЕ Автомобили.ПометкаУдаления
		|И Автомобили.АС_Синонимы <> """"");

	ПакетСинонимов = Запрос.ВыполнитьПакет();
	ТаблицаСинонимов = ПакетСинонимов[0].Выгрузить();
	ТаблицаСинонимов.Индексы.Добавить("Группа");
	ГруппыДляЗамены = Новый Массив;
	Для Каждого СтрокаСинонима Из ТаблицаСинонимов Цикл
		НормализованныйСиноним = НормализоватьСтроку(СтрокаСинонима.Синоним);
		Если Не ПустаяСтрока(НормализованныйСиноним)
			И АС_СодержитФразу(НормализованнаяСтрока, НормализованныйСиноним)
			И ГруппыДляЗамены.Найти(СтрокаСинонима.Группа) = Неопределено Тогда
			ГруппыДляЗамены.Добавить(СтрокаСинонима.Группа);
		КонецЕсли;
	КонецЦикла;

	Для Каждого ГруппаСинонимов Из ГруппыДляЗамены Цикл
		СинонимыГруппы = ТаблицаСинонимов.НайтиСтроки(Новый Структура("Группа", ГруппаСинонимов));
		Для Каждого ИсходныйСиноним Из СинонимыГруппы Цикл
			НормализованныйИсходный = НормализоватьСтроку(ИсходныйСиноним.Синоним);
			Если Не АС_СодержитФразу(НормализованнаяСтрока, НормализованныйИсходный) Тогда
				Продолжить;
			КонецЕсли;

			Для Каждого НовыйСиноним Из СинонимыГруппы Цикл
				НормализованныйНовый = НормализоватьСтроку(НовыйСиноним.Синоним);
				Если ПустаяСтрока(НормализованныйНовый)
					Или НРег(СокрЛП(Строка(НовыйСиноним.Синоним)))
						= НРег(СокрЛП(Строка(ИсходныйСиноним.Синоним))) Тогда
					Продолжить;
				КонецЕсли;

				НоваяСтрока = АС_ЗаменитьФразу(
					НормализованнаяСтрока,
					НормализованныйИсходный,
					СокрЛП(Строка(НовыйСиноним.Синоним)));
				АС_ДобавитьУникальнуюСтроку(Результат, НоваяСтрока);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	АС_ДобавитьВариантыМарокИМоделей(Результат, НормализованнаяСтрока, ПакетСинонимов[1].Выбрать());
	Возврат Результат;

КонецФункции

Процедура АС_ДобавитьВариантыМарокИМоделей(Результат, СтрокаПоиска, Выборка)

	ЗаменыПоФразам = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Названия = СтрРазделить(Выборка.Синонимы, ",;" + Символы.ПС + Символы.ВК, Ложь);
		Названия.Добавить(Выборка.Наименование);
		Для Каждого Название Из Названия Цикл
			Ключ = НормализоватьСтроку(Название);
			Если ПустаяСтрока(Ключ) Или Не АС_СодержитФразу(СтрокаПоиска, Ключ) Тогда
				Продолжить;
			КонецЕсли;
			Варианты = ЗаменыПоФразам.Получить(Ключ);
			Если Варианты = Неопределено Тогда
				Варианты = Новый Массив;
				Варианты.Добавить(Ключ);
				ЗаменыПоФразам.Вставить(Ключ, Варианты);
			КонецЕсли;
			Для Каждого Вариант Из Названия Цикл
				АС_ДобавитьУникальнуюСтроку(Варианты, Вариант);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Если ЗаменыПоФразам.Количество() = 0 Тогда Возврат; КонецЕсли;

	// Сопоставляем только фразы исходного запроса. Сгенерированные слова не раскрываются повторно.
	// Из совпадающих фраз выбираем самую длинную: например, «гранта фл» раньше «гранта».
	Слова = СтрРазделить(СтрокаПоиска, " ", Ложь);
	ПределВариантов = Мин(128, Макс(8, Цел(256 / Слова.Количество())));
	Собранные = Новый Массив;
	Собранные.Добавить("");
	НачалоФразы = 0;
	Пока НачалоФразы < Слова.Количество() Цикл
		Фраза = "";
		Варианты = Новый Массив;
		Варианты.Добавить(Слова[НачалоФразы]);
		СледующееСлово = НачалоФразы + 1;
		Для Индекс = НачалоФразы По Слова.ВГраница() Цикл
			Фраза = СокрЛП(Фраза + " " + Слова[Индекс]);
			Замены = ЗаменыПоФразам.Получить(Фраза);
			Если Замены <> Неопределено Тогда
				Варианты = Замены;
				СледующееСлово = Индекс + 1;
			КонецЕсли;
		КонецЦикла;
		Новые = Новый Массив;
		Для Каждого Префикс Из Собранные Цикл
			Для Каждого Вариант Из Варианты Цикл
				АС_ДобавитьУникальнуюСтроку(Новые, Префикс + " " + Вариант);
				Если Новые.Количество() >= ПределВариантов Тогда Прервать; КонецЕсли;
			КонецЦикла;
			Если Новые.Количество() >= ПределВариантов Тогда Прервать; КонецЕсли;
		КонецЦикла;
		Собранные = Новые;
		НачалоФразы = СледующееСлово;
	КонецЦикла;
	Для Каждого Вариант Из Собранные Цикл
		АС_ДобавитьУникальнуюСтроку(Результат, Вариант);
	КонецЦикла;

КонецПроцедуры

Процедура АС_ДобавитьВариантТочкиИЗапятой(МассивСтрок, Знач СтрокаПоиска)

	СтрокаПоиска = СокрЛП(Строка(СтрокаПоиска));
	Если СтрНайти(СтрокаПоиска, ".") > 0 Тогда
		АС_ДобавитьУникальнуюСтроку(
			МассивСтрок, СтрЗаменить(СтрокаПоиска, ".", ","));
	КонецЕсли;
	Если СтрНайти(СтрокаПоиска, ",") > 0 Тогда
		АС_ДобавитьУникальнуюСтроку(
			МассивСтрок, СтрЗаменить(СтрокаПоиска, ",", "."));
	КонецЕсли;

КонецПроцедуры

Процедура ДополнитьПоискСинонимами(Номенклатура, СтрокаПоиска) Экспорт

	ВариантыПоиска = ВариантыСтрокиПоиска(СтрокаПоиска);
	Если ВариантыПоиска.Количество() <= 1 Тогда Возврат; КонецЕсли;
	УжеНайденные = Новый Соответствие;
	Для Каждого Ссылка Из Номенклатура Цикл
		УжеНайденные.Вставить(Ссылка, Истина);
	КонецЦикла;
	Для Каждого Ссылка Из НайтиНоменклатуруПоВариантам(ВариантыПоиска, УжеНайденные) Цикл
		Номенклатура.Добавить(Ссылка);
	КонецЦикла;

КонецПроцедуры

Функция НайтиНоменклатуруПоВариантам(ВариантыПоиска, УжеНайденные = Неопределено) Экспорт

	Поиск = ПодготовитьПоискСинонимов(ВариантыПоиска, Новый Структура);
	Если ПустаяСтрока(Поиск.Условие) Тогда Возврат Новый Массив; КонецЕсли;
	Поля = "Найденные.Ссылка КАК Номенклатура";
	Если Поиск.ПроверятьКандидатов Тогда
		Поля = Поля + ", Найденные.Наименование КАК Наименование, Найденные.НаименованиеПолное КАК НаименованиеПолное";
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ " + Поля + "
		|ИЗ Справочник.Номенклатура КАК Найденные
		|ГДЕ НЕ Найденные.ЭтоГруппа И НЕ Найденные.ПометкаУдаления И НЕ Найденные.Недействителен
		|И " + Поиск.Условие);
	Для Каждого Параметр Из Поиск.Параметры Цикл
		Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Поиск.ПроверятьКандидатов Тогда
		Возврат ПроверенныеСинонимы(Выборка, Поиск.Варианты, УжеНайденные);
	КонецЕсли;
	Результат = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Если УжеНайденные = Неопределено Или УжеНайденные.Получить(Выборка.Номенклатура) = Неопределено Тогда
			Результат.Добавить(Выборка.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Простые подстроки сопоставляются в запросе без учёта регистра.
// Варианты с границами, специальными символами и нормализацией проверяются в BSL.
Функция ПодготовитьПоискСинонимов(ВариантыПоиска, Параметры) Экспорт

	Поиск = Новый Структура("Условие,Параметры,Варианты,ПроверятьКандидатов", "", Параметры, Новый Массив, Ложь);
	Если ВариантыПоиска = Неопределено Тогда Возврат Поиск; КонецЕсли;
	УсловияПоиска = Новый Массив;
	НормализованныеВарианты = Новый Соответствие;
	ОбработанныеВарианты = Новый Соответствие;
	ПодготовленныеСлова = Новый Соответствие;
	ИменаШаблонов = Новый Соответствие;
	Для Каждого Вариант Из ВариантыПоиска Цикл
		ИсходныйВариант = СокрЛП(Строка(Вариант));
		КлючВарианта = НРег(ИсходныйВариант);
		Если ПустаяСтрока(КлючВарианта) Или ОбработанныеВарианты.Получить(КлючВарианта) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ОбработанныеВарианты.Вставить(КлючВарианта, Истина);
		НормализованныйВариант = НормализоватьСтроку(ИсходныйВариант);
		Если Не ПустаяСтрока(НормализованныйВариант)
			И НормализованныеВарианты.Получить(НормализованныйВариант) = Неопределено Тогда
			НормализованныеВарианты.Вставить(НормализованныйВариант, Истина);
			Поиск.Варианты.Добавить(СтрРазделить(НормализованныйВариант, " ", Ложь));
		КонецЕсли;
		УсловияНаименования = Новый Массив;
		УсловияПолногоНаименования = Новый Массив;
		СловаВарианта = Новый Соответствие;
		Для Каждого Слово Из СтрРазделить(ИсходныйВариант, " ", Ложь) Цикл
			Если СловаВарианта.Получить(Слово) <> Неопределено Тогда Продолжить; КонецЕсли;
			СловаВарианта.Вставить(Слово, Истина);
			УсловияСлова = ПодготовленныеСлова.Получить(Слово);
			Если УсловияСлова = Неопределено Тогда
				УсловияСлова = АС_ПодготовитьУсловияСлова(Слово, Параметры, ИменаШаблонов);
				ПодготовленныеСлова.Вставить(Слово, УсловияСлова);
			КонецЕсли;
			Если Не УсловияСлова.ПростоеСлово Тогда Поиск.ПроверятьКандидатов = Истина; КонецЕсли;
			УсловияНаименования.Добавить(УсловияСлова.Наименование);
			УсловияПолногоНаименования.Добавить(УсловияСлова.НаименованиеПолное);
		КонецЦикла;
		УсловияПоиска.Добавить(
			"(" + СтрСоединить(УсловияНаименования, " И ") + ") ИЛИ ("
			+ СтрСоединить(УсловияПолногоНаименования, " И ") + ")");
	КонецЦикла;
	Если Поиск.Варианты.Количество() > 0 Тогда Поиск.Условие = "(" + СтрСоединить(УсловияПоиска, " ИЛИ ") + ")"; КонецЕсли;
	Возврат Поиск;

КонецФункции

Функция АС_ПодготовитьУсловияСлова(Слово, Параметры, ИменаШаблонов)

	КраткиеУсловия = Новый Массив;
	ПолныеУсловия = Новый Массив;
	СловоБезРегистра = НРег(Слово);
	ПростоеСлово = АС_ПростоеСловоПоиска(СловоБезРегистра);
	Если ПростоеСлово Тогда
		Написания = Новый Массив;
		Написания.Добавить(СловоБезРегистра);
	Иначе
		Написания = АС_ВариантыНаписанияСлова(Слово);
	КонецЕсли;
	Для Каждого Написание Из Написания Цикл
		Шаблон = АС_ШаблонПоиска(Написание);
		ИмяПараметра = ИменаШаблонов.Получить(Шаблон);
		Если ИмяПараметра = Неопределено Тогда
			ИмяПараметра = "СинонимШаблон" + Формат(ИменаШаблонов.Количество(), "ЧГ=0");
			ИменаШаблонов.Вставить(Шаблон, ИмяПараметра);
			Параметры.Вставить(ИмяПараметра, Шаблон);
		КонецЕсли;
		АС_ДобавитьУникальнуюСтроку(КраткиеУсловия, "Найденные.Наименование ПОДОБНО &" + ИмяПараметра);
		АС_ДобавитьУникальнуюСтроку(ПолныеУсловия, "Найденные.НаименованиеПолное ПОДОБНО &" + ИмяПараметра);
	КонецЦикла;
	Возврат Новый Структура("Наименование,НаименованиеПолное,ПростоеСлово",
		"(" + СтрСоединить(КраткиеУсловия, " ИЛИ ") + ")", "(" + СтрСоединить(ПолныеУсловия, " ИЛИ ") + ")", ПростоеСлово);

КонецФункции

// Три символа и более: BSL проверяет такую подстроку без границ слова.
// Буквы ё, х и x остаются в проверке BSL из-за специальных правил написания.
Функция АС_ПростоеСловоПоиска(Слово)

	Если СтрДлина(Слово) < 3 Тогда Возврат Ложь; КонецЕсли;
	ДопустимыеСимволыСинонима = "abcdefghijklmnopqrstuvwyzабвгдежзийклмнопрстуфцчшщъыьэюя0123456789";
	Для Позиция = 1 По СтрДлина(Слово) Цикл
		Если СтрНайти(ДопустимыеСимволыСинонима, Сред(Слово, Позиция, 1)) = 0 Тогда Возврат Ложь; КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция ПроверенныеСинонимы(Выборка, ПодготовленныеВарианты, УжеНайденные = Неопределено) Экспорт

	Результат = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Если УжеНайденные <> Неопределено И УжеНайденные.Получить(Выборка.Номенклатура) <> Неопределено Тогда Продолжить; КонецЕсли;
		Имя = Выборка.Наименование;
		ПолноеИмя = Выборка.НаименованиеПолное;
		Если АС_ИмяСоответствуетВариантам(Имя, ПодготовленныеВарианты)
			Или (Имя <> ПолноеИмя И АС_ИмяСоответствуетВариантам(ПолноеИмя, ПодготовленныеВарианты)) Тогда
			Результат.Добавить(Выборка.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция АС_ИмяСоответствуетВариантам(Имя, ПодготовленныеВарианты)

	НормализованноеИмя = " " + НормализоватьСтроку(Имя) + " ";
	Для Каждого СловаПоиска Из ПодготовленныеВарианты Цикл
		Если АС_СтрокаСодержитВсеСлова(Имя, НормализованноеИмя, СловаПоиска) Тогда Возврат Истина; КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Для уже выбранной строки страницы передаём только слова, которые добавило раскрытие синонимов.
Функция СловаСинонимовДляПодсветки(Имя, Варианты, ИсходныеСлова) Экспорт

	Результат = Новый Массив;
	НормализованноеИмя = " " + НормализоватьСтроку(Имя) + " ";
	ДлинаСлов = 0;
	Для Каждого СловаПоиска Из Варианты Цикл
		Если Не АС_СтрокаСодержитВсеСлова(Имя, НормализованноеИмя, СловаПоиска) Тогда Продолжить; КонецЕсли;
		Для Каждого Слово Из СловаПоиска Цикл
			Если ИсходныеСлова.Получить(Слово) <> Неопределено Или Результат.Найти(Слово) <> Неопределено
				Или ДлинаСлов + СтрДлина(Слово) > 100 Тогда Продолжить; КонецЕсли;
			Результат.Добавить(Слово);
			ДлинаСлов = ДлинаСлов + СтрДлина(Слово);
			Если Результат.Количество() = 16 Тогда Возврат Результат; КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция НормализоватьСтроку(Значение) Экспорт

	Результат = НРег(СокрЛП(Строка(Значение)));
	Результат = СтрЗаменить(Результат, Символы.НПП, " ");
	Результат = СтрЗаменить(Результат, "ё", "е");
	// В размерностях символы «*», «х», «Х», «x» и «X» считаются одним разделителем.
	Результат = СтрЗаменить(Результат, "х", "x");
	Результат = СтрЗаменить(Результат, "*", "x");
	Разделители = ".,;:-–—_/\()[]{}+|%";
	Для Позиция = 1 По СтрДлина(Разделители) Цикл
		Результат = СтрЗаменить(Результат, Сред(Разделители, Позиция, 1), "");
	КонецЦикла;
	Результат = СтрЗаменить(Результат, Символы.Таб, " ");
	Результат = СтрЗаменить(Результат, Символы.ВК, " ");
	Результат = СтрЗаменить(Результат, Символы.ПС, " ");
	Пока СтрНайти(Результат, "  ") > 0 Цикл
		Результат = СтрЗаменить(Результат, "  ", " ");
	КонецЦикла;
	Возврат СокрЛП(Результат);

КонецФункции

Функция СоответствуетОтборуНоменклатуры(Номенклатура, Отбор) Экспорт

	Если ТипЗнч(Отбор) <> Тип("Структура")
		И ТипЗнч(Отбор) <> Тип("ФиксированнаяСтруктура") Тогда
		Возврат Истина;
	КонецЕсли;

	Если Отбор.Свойство("ТипНоменклатуры")
		И ЗначениеЗаполнено(Отбор.ТипНоменклатуры)
		И Номенклатура.ТипНоменклатуры <> Отбор.ТипНоменклатуры Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Отбор.Свойство("Недействителен")
		И Номенклатура.Недействителен <> Отбор.Недействителен Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

Функция АС_СтрокаСодержитВсеСлова(ИсходнаяПроверяемаяСтрока, ПроверяемаяСтрока, СловаПоиска)
	Для Каждого СловоПоиска Из СловаПоиска Цикл
		// Как в обычном поиске: «сцеп» находит «сцепления», в том числе после замены синонима.
		// Короткие сокращения по-прежнему проверяем отдельно: «РК» не равно «6РК2100».
		Если СтрДлина(СловоПоиска) > 2
			И СтрНайти(ПроверяемаяСтрока, СловоПоиска) > 0 Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНайти(ПроверяемаяСтрока, " " + СловоПоиска + " ") = 0
			И Не АС_СтрокаСодержитСокращениеСКомплектом(
				ИсходнаяПроверяемаяСтрока, СловоПоиска) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат СловаПоиска.Количество() > 0;

КонецФункции

Функция АС_ШаблонПоиска(Знач СтрокаПоиска)

	СтрокаПоиска = СокрЛП(СтрЗаменить(Строка(СтрокаПоиска), "%", ""));
	Если ПустаяСтрока(СтрокаПоиска) Тогда
		Возврат "";
	КонецЕсли;
	Возврат "%" + СтрокаПоиска + "%";

КонецФункции

Функция АС_ВариантыНаписанияСлова(Слово)

	Результат = Новый Массив;
	АС_ДобавитьУникальнуюСтроку(Результат, Слово);
	НормализованноеСлово = НормализоватьСтроку(Слово);
	АС_ДобавитьУникальнуюСтроку(Результат, НормализованноеСлово);
	АС_ДобавитьВариантыСимволаИкс(Результат, НормализованноеСлово);

	// Для двухбуквенных сокращений учитываем обычные разделители.
	// Так «РК» находит «Р/К», но не совпадает с кодом «6РК2100».
	Если СтрДлина(НормализованноеСлово) = 2 Тогда
		ПерваяБуква = Лев(НормализованноеСлово, 1);
		ВтораяБуква = Прав(НормализованноеСлово, 1);
		АС_ДобавитьУникальнуюСтроку(Результат, ПерваяБуква + "/" + ВтораяБуква);
		АС_ДобавитьУникальнуюСтроку(Результат, ПерваяБуква + "-" + ВтораяБуква);
		АС_ДобавитьУникальнуюСтроку(Результат, ПерваяБуква + "." + ВтораяБуква);
		АС_ДобавитьУникальнуюСтроку(Результат, ПерваяБуква + "/" + ВтораяБуква + "-т");
		АС_ДобавитьУникальнуюСтроку(Результат, ПерваяБуква + "-" + ВтораяБуква + "-т");
		АС_ДобавитьУникальнуюСтроку(Результат, ПерваяБуква + "." + ВтораяБуква + "-т");
	КонецЕсли;

	Возврат Результат;

КонецФункции

Процедура АС_ДобавитьВариантыСимволаИкс(МассивСтрок, Знач СтрокаПоиска)

	Если СтрНайти(СтрокаПоиска, "x") = 0 Тогда
		Возврат;
	КонецЕсли;

	Варианты = Новый Массив;
	Варианты.Добавить("");
	Для Позиция = 1 По СтрДлина(СтрокаПоиска) Цикл
		СимволСтроки = Сред(СтрокаПоиска, Позиция, 1);
		НовыеВарианты = Новый Массив;
		Для Каждого Вариант Из Варианты Цикл
			Если СимволСтроки = "x" Тогда
				НовыеВарианты.Добавить(Вариант + "x");
				НовыеВарианты.Добавить(Вариант + "х");
				НовыеВарианты.Добавить(Вариант + "*");
			Иначе
				НовыеВарианты.Добавить(Вариант + СимволСтроки);
			КонецЕсли;
		КонецЦикла;
		Варианты = НовыеВарианты;
	КонецЦикла;

	Для Каждого Вариант Из Варианты Цикл
		АС_ДобавитьУникальнуюСтроку(МассивСтрок, Вариант);
	КонецЦикла;

КонецПроцедуры

Функция АС_СтрокаСодержитСокращениеСКомплектом(ПроверяемаяСтрока, СловоПоиска)

	Если СтрДлина(СловоПоиска) <> 2 Тогда
		Возврат Ложь;
	КонецЕсли;

	ПодготовленнаяСтрока = НРег(Строка(ПроверяемаяСтрока));
	Для Каждого Разделитель Из СтрРазделить(", ; : ( ) [ ] { }", " ", Ложь) Цикл
		ПодготовленнаяСтрока = СтрЗаменить(ПодготовленнаяСтрока, Разделитель, " ");
	КонецЦикла;
	ПодготовленнаяСтрока = СтрЗаменить(ПодготовленнаяСтрока, Символы.Таб, " ");
	ПодготовленнаяСтрока = СтрЗаменить(ПодготовленнаяСтрока, Символы.ВК, " ");
	ПодготовленнаяСтрока = СтрЗаменить(ПодготовленнаяСтрока, Символы.ПС, " ");
	Пока СтрНайти(ПодготовленнаяСтрока, "  ") > 0 Цикл
		ПодготовленнаяСтрока = СтрЗаменить(ПодготовленнаяСтрока, "  ", " ");
	КонецЦикла;
	ПодготовленнаяСтрока = " " + СокрЛП(ПодготовленнаяСтрока) + " ";

	ПерваяБуква = Лев(СловоПоиска, 1);
	ВтораяБуква = Прав(СловоПоиска, 1);
	Возврат СтрНайти(ПодготовленнаяСтрока, " " + ПерваяБуква + "/" + ВтораяБуква + "-т ") > 0
		Или СтрНайти(ПодготовленнаяСтрока, " " + ПерваяБуква + "-" + ВтораяБуква + "-т ") > 0
		Или СтрНайти(ПодготовленнаяСтрока, " " + ПерваяБуква + "." + ВтораяБуква + "-т ") > 0;

КонецФункции

Функция АС_СодержитФразу(СтрокаПоиска, Фраза)

	Возврат СтрНайти(" " + СтрокаПоиска + " ", " " + Фраза + " ") > 0;

КонецФункции

Функция АС_ЗаменитьФразу(СтрокаПоиска, ИсходнаяФраза, НоваяФраза)

	СтрокаСГраницами = " " + СтрокаПоиска + " ";
	СтрокаСГраницами = СтрЗаменить(
		СтрокаСГраницами,
		" " + ИсходнаяФраза + " ",
		" " + НоваяФраза + " ");
	Возврат СокрЛП(СтрокаСГраницами);

КонецФункции

Процедура АС_ДобавитьУникальнуюСтроку(МассивСтрок, Знач Значение)

	Значение = СокрЛП(Строка(Значение));
	Если Не ПустаяСтрока(Значение) И МассивСтрок.Найти(Значение) = Неопределено Тогда
		МассивСтрок.Добавить(Значение);
	КонецЕсли;

КонецПроцедуры
