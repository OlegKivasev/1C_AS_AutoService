Функция ВариантыСтрокиПоиска(СтрокаПоиска) Экспорт

	Результат = Новый Массив;
	АС_ДобавитьУникальнуюСтроку(Результат, СокрЛП(Строка(СтрокаПоиска)));
	НормализованнаяСтрока = НормализоватьСтроку(СтрокаПоиска);
	Если ПустаяСтрока(НормализованнаяСтрока) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|Группы.Ссылка КАК Группа,
		|Группы.Наименование КАК Синоним,
		|0 КАК НомерСтроки
		|ИЗ
		|Справочник.АС_ГруппыСинонимовПоиска КАК Группы
		|ГДЕ
		|НЕ Группы.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|Группы.Ссылка,
		|ГруппыСинонимы.Синоним,
		|ГруппыСинонимы.НомерСтроки
		|ИЗ
		|Справочник.АС_ГруппыСинонимовПоиска КАК Группы
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.АС_ГруппыСинонимовПоиска.Синонимы КАК ГруппыСинонимы
		|ПО Группы.Ссылка = ГруппыСинонимы.Ссылка
		|ГДЕ
		|НЕ Группы.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|Группа,
		|НомерСтроки");

	ТаблицаСинонимов = Запрос.Выполнить().Выгрузить();
	ГруппыДляЗамены = Новый Массив;
	Для Каждого СтрокаСинонима Из ТаблицаСинонимов Цикл
		НормализованныйСиноним = НормализоватьСтроку(СтрокаСинонима.Синоним);
		Если Не ПустаяСтрока(НормализованныйСиноним)
			И АС_СодержитФразу(НормализованнаяСтрока, НормализованныйСиноним)
			И ГруппыДляЗамены.Найти(СтрокаСинонима.Группа) = Неопределено Тогда
			ГруппыДляЗамены.Добавить(СтрокаСинонима.Группа);
		КонецЕсли;
	КонецЦикла;

	Для Каждого ГруппаСинонимов Из ГруппыДляЗамены Цикл
		СинонимыГруппы = ТаблицаСинонимов.НайтиСтроки(Новый Структура("Группа", ГруппаСинонимов));
		Для Каждого ИсходныйСиноним Из СинонимыГруппы Цикл
			НормализованныйИсходный = НормализоватьСтроку(ИсходныйСиноним.Синоним);
			Если Не АС_СодержитФразу(НормализованнаяСтрока, НормализованныйИсходный) Тогда
				Продолжить;
			КонецЕсли;

			Для Каждого НовыйСиноним Из СинонимыГруппы Цикл
				НормализованныйНовый = НормализоватьСтроку(НовыйСиноним.Синоним);
				Если ПустаяСтрока(НормализованныйНовый)
					Или НРег(СокрЛП(Строка(НовыйСиноним.Синоним)))
						= НРег(СокрЛП(Строка(ИсходныйСиноним.Синоним))) Тогда
					Продолжить;
				КонецЕсли;

				НоваяСтрока = АС_ЗаменитьФразу(
					НормализованнаяСтрока,
					НормализованныйИсходный,
					СокрЛП(Строка(НовыйСиноним.Синоним)));
				АС_ДобавитьУникальнуюСтроку(Результат, НоваяСтрока);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция НайтиНоменклатуруПоВариантам(ВариантыПоиска) Экспорт

	Результат = Новый Массив;
	Если ВариантыПоиска = Неопределено Или ВариантыПоиска.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	УсловияПоиска = Новый Массив;
	НормализованныеВарианты = Новый Массив;
	ОбработанныеВарианты = Новый Соответствие;
	Для Индекс = 0 По ВариантыПоиска.ВГраница() Цикл
		ИсходныйВариант = СокрЛП(Строка(ВариантыПоиска[Индекс]));
		КлючВарианта = НРег(ИсходныйВариант);
		Если ПустаяСтрока(КлючВарианта)
			Или ОбработанныеВарианты.Получить(КлючВарианта) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ОбработанныеВарианты.Вставить(КлючВарианта, Истина);

		НормализованныйВариант = НормализоватьСтроку(ИсходныйВариант);
		Если НормализованныеВарианты.Найти(НормализованныйВариант) = Неопределено Тогда
			НормализованныеВарианты.Добавить(НормализованныйВариант);
		КонецЕсли;
		УсловияНаименования = Новый Массив;
		УсловияПолногоНаименования = Новый Массив;
		СловаВарианта = СтрРазделить(ИсходныйВариант, " ", Ложь);
		Для ИндексСлова = 0 По СловаВарианта.ВГраница() Цикл
			УсловияНаписанийНаименования = Новый Массив;
			УсловияНаписанийПолногоНаименования = Новый Массив;
			ВариантыНаписания = АС_ВариантыНаписанияСлова(СловаВарианта[ИндексСлова]);
			Для ИндексНаписания = 0 По ВариантыНаписания.ВГраница() Цикл
				ИмяПараметра = "Вариант" + Строка(Индекс)
					+ "Слово" + Строка(ИндексСлова)
					+ "Написание" + Строка(ИндексНаписания);
				Запрос.УстановитьПараметр(
					ИмяПараметра,
					АС_ШаблонПоиска(ВариантыНаписания[ИндексНаписания]));
				УсловияНаписанийНаименования.Добавить(
					"Номенклатура.Наименование ПОДОБНО &" + ИмяПараметра);
				УсловияНаписанийПолногоНаименования.Добавить(
					"Номенклатура.НаименованиеПолное ПОДОБНО &" + ИмяПараметра);
			КонецЦикла;
			УсловияНаименования.Добавить(
				"(" + СтрСоединить(УсловияНаписанийНаименования, " ИЛИ ") + ")");
			УсловияПолногоНаименования.Добавить(
				"(" + СтрСоединить(УсловияНаписанийПолногоНаименования, " ИЛИ ") + ")");
		КонецЦикла;
		УсловияПоиска.Добавить(
			"(" + СтрСоединить(УсловияНаименования, " И ") + ") ИЛИ ("
			+ СтрСоединить(УсловияПолногоНаименования, " И ") + ")");
	КонецЦикла;

	Если УсловияПоиска.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|Номенклатура.Ссылка КАК Номенклатура,
		|Номенклатура.Наименование КАК Наименование,
		|Номенклатура.НаименованиеПолное КАК НаименованиеПолное
		|ИЗ
		|Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|НЕ Номенклатура.ЭтоГруппа
		|И НЕ Номенклатура.ПометкаУдаления
		|И НЕ Номенклатура.Недействителен
		|И (" + СтрСоединить(УсловияПоиска, " ИЛИ ") + ")";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Для Каждого ВариантПоиска Из НормализованныеВарианты Цикл
			Если АС_СтрокаСодержитВсеСлова(Выборка.Наименование, ВариантПоиска)
				Или АС_СтрокаСодержитВсеСлова(Выборка.НаименованиеПолное, ВариантПоиска) Тогда
				Результат.Добавить(Выборка.Номенклатура);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция НормализоватьСтроку(Значение) Экспорт

	Результат = НРег(СокрЛП(Строка(Значение)));
	Результат = СтрЗаменить(Результат, Символы.НПП, " ");
	Результат = СтрЗаменить(Результат, "ё", "е");
	Разделители = ".,;:-–—_/\()[]{}+|%";
	Для Позиция = 1 По СтрДлина(Разделители) Цикл
		Результат = СтрЗаменить(Результат, Сред(Разделители, Позиция, 1), "");
	КонецЦикла;
	Результат = СтрЗаменить(Результат, Символы.Таб, " ");
	Результат = СтрЗаменить(Результат, Символы.ВК, " ");
	Результат = СтрЗаменить(Результат, Символы.ПС, " ");
	Пока СтрНайти(Результат, "  ") > 0 Цикл
		Результат = СтрЗаменить(Результат, "  ", " ");
	КонецЦикла;
	Возврат СокрЛП(Результат);

КонецФункции

Функция СоответствуетОтборуНоменклатуры(Номенклатура, Отбор) Экспорт

	Если ТипЗнч(Отбор) <> Тип("Структура")
		И ТипЗнч(Отбор) <> Тип("ФиксированнаяСтруктура") Тогда
		Возврат Истина;
	КонецЕсли;

	Если Отбор.Свойство("ТипНоменклатуры")
		И ЗначениеЗаполнено(Отбор.ТипНоменклатуры)
		И Номенклатура.ТипНоменклатуры <> Отбор.ТипНоменклатуры Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Отбор.Свойство("Недействителен")
		И Номенклатура.Недействителен <> Отбор.Недействителен Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

Функция АС_СтрокаСодержитВсеСлова(Знач ПроверяемаяСтрока, Знач СтрокаПоиска)

	ИсходнаяПроверяемаяСтрока = Строка(ПроверяемаяСтрока);
	ПроверяемаяСтрока = " " + НормализоватьСтроку(ИсходнаяПроверяемаяСтрока) + " ";
	СловаПоиска = СтрРазделить(НормализоватьСтроку(СтрокаПоиска), " ", Ложь);
	Для Каждого СловоПоиска Из СловаПоиска Цикл
		Если СтрНайти(ПроверяемаяСтрока, " " + СловоПоиска + " ") = 0
			И Не АС_СтрокаСодержитСокращениеСКомплектом(
				ИсходнаяПроверяемаяСтрока, СловоПоиска) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат СловаПоиска.Количество() > 0;

КонецФункции

Функция АС_ШаблонПоиска(Знач СтрокаПоиска)

	СтрокаПоиска = СокрЛП(СтрЗаменить(Строка(СтрокаПоиска), "%", ""));
	Если ПустаяСтрока(СтрокаПоиска) Тогда
		Возврат "";
	КонецЕсли;
	Возврат "%" + СтрокаПоиска + "%";

КонецФункции

Функция АС_ВариантыНаписанияСлова(Слово)

	Результат = Новый Массив;
	АС_ДобавитьУникальнуюСтроку(Результат, Слово);
	НормализованноеСлово = НормализоватьСтроку(Слово);
	АС_ДобавитьУникальнуюСтроку(Результат, НормализованноеСлово);

	// Для двухбуквенных сокращений учитываем обычные разделители.
	// Так «РК» находит «Р/К», но не совпадает с кодом «6РК2100».
	Если СтрДлина(НормализованноеСлово) = 2 Тогда
		ПерваяБуква = Лев(НормализованноеСлово, 1);
		ВтораяБуква = Прав(НормализованноеСлово, 1);
		АС_ДобавитьУникальнуюСтроку(Результат, ПерваяБуква + "/" + ВтораяБуква);
		АС_ДобавитьУникальнуюСтроку(Результат, ПерваяБуква + "-" + ВтораяБуква);
		АС_ДобавитьУникальнуюСтроку(Результат, ПерваяБуква + "." + ВтораяБуква);
		АС_ДобавитьУникальнуюСтроку(Результат, ПерваяБуква + "/" + ВтораяБуква + "-т");
		АС_ДобавитьУникальнуюСтроку(Результат, ПерваяБуква + "-" + ВтораяБуква + "-т");
		АС_ДобавитьУникальнуюСтроку(Результат, ПерваяБуква + "." + ВтораяБуква + "-т");
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция АС_СтрокаСодержитСокращениеСКомплектом(ПроверяемаяСтрока, СловоПоиска)

	Если СтрДлина(СловоПоиска) <> 2 Тогда
		Возврат Ложь;
	КонецЕсли;

	ПодготовленнаяСтрока = НРег(Строка(ПроверяемаяСтрока));
	Для Каждого Разделитель Из СтрРазделить(", ; : ( ) [ ] { }", " ", Ложь) Цикл
		ПодготовленнаяСтрока = СтрЗаменить(ПодготовленнаяСтрока, Разделитель, " ");
	КонецЦикла;
	ПодготовленнаяСтрока = СтрЗаменить(ПодготовленнаяСтрока, Символы.Таб, " ");
	ПодготовленнаяСтрока = СтрЗаменить(ПодготовленнаяСтрока, Символы.ВК, " ");
	ПодготовленнаяСтрока = СтрЗаменить(ПодготовленнаяСтрока, Символы.ПС, " ");
	Пока СтрНайти(ПодготовленнаяСтрока, "  ") > 0 Цикл
		ПодготовленнаяСтрока = СтрЗаменить(ПодготовленнаяСтрока, "  ", " ");
	КонецЦикла;
	ПодготовленнаяСтрока = " " + СокрЛП(ПодготовленнаяСтрока) + " ";

	ПерваяБуква = Лев(СловоПоиска, 1);
	ВтораяБуква = Прав(СловоПоиска, 1);
	Возврат СтрНайти(ПодготовленнаяСтрока, " " + ПерваяБуква + "/" + ВтораяБуква + "-т ") > 0
		Или СтрНайти(ПодготовленнаяСтрока, " " + ПерваяБуква + "-" + ВтораяБуква + "-т ") > 0
		Или СтрНайти(ПодготовленнаяСтрока, " " + ПерваяБуква + "." + ВтораяБуква + "-т ") > 0;

КонецФункции

Функция АС_СодержитФразу(СтрокаПоиска, Фраза)

	Возврат СтрНайти(" " + СтрокаПоиска + " ", " " + Фраза + " ") > 0;

КонецФункции

Функция АС_ЗаменитьФразу(СтрокаПоиска, ИсходнаяФраза, НоваяФраза)

	СтрокаСГраницами = " " + СтрокаПоиска + " ";
	СтрокаСГраницами = СтрЗаменить(
		СтрокаСГраницами,
		" " + ИсходнаяФраза + " ",
		" " + НоваяФраза + " ");
	Возврат СокрЛП(СтрокаСГраницами);

КонецФункции

Процедура АС_ДобавитьУникальнуюСтроку(МассивСтрок, Знач Значение)

	Значение = СокрЛП(Строка(Значение));
	Если Не ПустаяСтрока(Значение) И МассивСтрок.Найти(Значение) = Неопределено Тогда
		МассивСтрок.Добавить(Значение);
	КонецЕсли;

КонецПроцедуры
