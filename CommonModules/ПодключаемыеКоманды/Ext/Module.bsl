&После("ПриСозданииНаСервере")
Процедура АС_ВосстановитьПоложениеПоступленияИзРасходной(
	Форма, Знач ПараметрыРазмещения = Неопределено)

	Если Не ПодключаемыеКомандыПереопределяемый.АС_ПоступлениеИзРасходнойСВыборомДоступно(
		Форма.ИмяФормы) Тогда
		Возврат;
	КонецЕсли;

	// Здесь БСП уже создала кнопки. Заменяем исходную на том же месте и в той же ветви меню.
	Для Каждого ИмяКнопки Из СтрРазделить(
		"ФормаДокументПоступлениеНаСчетСоздатьНаОсновании,ФормаДокументПоступлениеНаСчетСоздатьНаОсновании1", ",") Цикл
		ШтатнаяКнопка = Форма.Элементы.Найти(ИмяКнопки);
		Если ШтатнаяКнопка = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		НоваяКнопка = АС_НайтиПоступлениеВВетвиМеню(Форма, ШтатнаяКнопка.Родитель);
		Если НоваяКнопка = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ПрежняяГруппа = НоваяКнопка.Родитель;
		Форма.Элементы.Переместить(НоваяКнопка, ШтатнаяКнопка.Родитель, ШтатнаяКнопка);
		НоваяКнопка.Заголовок = ШтатнаяКнопка.Заголовок;
		НоваяКнопка.Видимость = ШтатнаяКнопка.Видимость;
		НоваяКнопка.Доступность = ШтатнаяКнопка.Доступность;
		ШтатнаяКнопка.Видимость = Ложь;
		Если ПрежняяГруппа <> ШтатнаяКнопка.Родитель Тогда
			АС_СкрытьПустуюГруппуКоманд(Форма, ПрежняяГруппа);
		КонецЕсли;
	КонецЦикла;

	АС_СкрытьПустуюГруппуКоманд(Форма,
		Форма.Элементы.Найти("ПодменюСоздатьНаОсновании"));

КонецПроцедуры

Функция АС_НайтиПоступлениеВВетвиМеню(Форма, ВетвьМеню)

	Для Каждого ЭлементФормы Из Форма.Элементы Цикл
		Если ТипЗнч(ЭлементФормы) <> Тип("КнопкаФормы") Тогда
			Продолжить;
		КонецЕсли;
		Если Не СтрЗаканчиваетсяНа(ЭлементФормы.Имя,
			"_АС_ПоступлениеНаСчетИзРасходнойНакладной") Тогда
			Продолжить;
		КонецЕсли;
		Родитель = ЭлементФормы.Родитель;
		Пока Родитель <> Неопределено Цикл
			Если Родитель = ВетвьМеню Тогда
				Возврат ЭлементФормы;
			КонецЕсли;
			Родитель = Родитель.Родитель;
		КонецЦикла;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Процедура АС_СкрытьПустуюГруппуКоманд(Форма, ГруппаКоманд)

	Если ГруппаКоманд = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого ЭлементФормы Из Форма.Элементы Цикл
		// Расширенные подсказки тоже входят в Элементы, но их Видимость недоступна.
		Если ТипЗнч(ЭлементФормы) <> Тип("КнопкаФормы")
			И ТипЗнч(ЭлементФормы) <> Тип("ГруппаФормы") Тогда
			Продолжить;
		КонецЕсли;
		Если ЭлементФормы.Родитель = ГруппаКоманд И ЭлементФормы.Видимость Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	ГруппаКоманд.Видимость = Ложь;

КонецПроцедуры
