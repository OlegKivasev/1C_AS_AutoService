// Только чтение складских регистров. Временные форменные колонки «К поступлению»
// не используются: они содержат также чужие свободные ожидаемые поставки.
Функция Рассчитать(Документ) Экспорт
	Организация = Константы.УчетПоКомпании.Компания(Документ.Организация);
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Документ", Документ);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ИспользоватьХарактеристики", ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристики"));
	Запрос.УстановитьПараметр("ИспользоватьПартии", ПолучитьФункциональнуюОпцию("ИспользоватьПартии"));
	Запрос.Текст =
	"ВЫБРАТЬ Товары.Номенклатура, Товары.Характеристика, Товары.Партия,
	|СУММА(Товары.Количество) КАК Количество
	|ИЗ (
	|ВЫБРАТЬ Строки.Номенклатура,
	|ВЫБОР КОГДА &ИспользоватьХарактеристики ТОГДА Строки.Характеристика
	|ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КОНЕЦ КАК Характеристика,
	|ВЫБОР КОГДА &ИспользоватьПартии ТОГДА Строки.Партия
	|ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ПартииНоменклатуры.ПустаяСсылка) КОНЕЦ КАК Партия,
	|Строки.Количество * ВЫБОР КОГДА ТИПЗНАЧЕНИЯ(Строки.ЕдиницаИзмерения) = ТИП(Справочник.ЕдиницыИзмерения)
	|ТОГДА ВЫРАЗИТЬ(Строки.ЕдиницаИзмерения КАК Справочник.ЕдиницыИзмерения).Коэффициент ИНАЧЕ 1 КОНЕЦ КАК Количество
	|ИЗ Документ.ЗаказПокупателя.Запасы КАК Строки
	|ГДЕ Строки.Ссылка = &Документ И Строки.Количество > 0
	|И Строки.НомерВариантаКП = 0
	|И НЕ Строки.АС_НеСписывать
	|И Строки.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ Строки.Номенклатура,
	|ВЫБОР КОГДА &ИспользоватьХарактеристики ТОГДА Строки.Характеристика
	|ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КОНЕЦ,
	|ВЫБОР КОГДА &ИспользоватьПартии ТОГДА Строки.Партия
	|ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ПартииНоменклатуры.ПустаяСсылка) КОНЕЦ,
	|Строки.Количество * ВЫБОР КОГДА ТИПЗНАЧЕНИЯ(Строки.ЕдиницаИзмерения) = ТИП(Справочник.ЕдиницыИзмерения)
	|ТОГДА ВЫРАЗИТЬ(Строки.ЕдиницаИзмерения КАК Справочник.ЕдиницыИзмерения).Коэффициент ИНАЧЕ 1 КОНЕЦ
	|ИЗ Документ.ЗаказПокупателя.Материалы КАК Строки
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ Ссылка, КлючСвязи
	|ИЗ Документ.ЗаказПокупателя.Работы ГДЕ Ссылка = &Документ) КАК Работы
	|ПО Работы.Ссылка = Строки.Ссылка И Работы.КлючСвязи = Строки.КлючСвязи
	|ГДЕ Строки.Ссылка = &Документ И Строки.Количество > 0
	|И Строки.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)) КАК Товары
	|СГРУППИРОВАТЬ ПО Товары.Номенклатура, Товары.Характеристика, Товары.Партия";
	Потребность = Запрос.Выполнить().Выгрузить();
	Результат = Новый Структура("totalPositions,availablePositions", Потребность.Количество(), 0);
	Если Потребность.Количество() = 0 Тогда Возврат Результат; КонецЕсли;
	Если Потребность.Количество() > 100000 Тогда ВызватьИсключение "Превышено число товарных позиций карточки."; КонецЕсли;

	Номенклатура = Потребность.ВыгрузитьКолонку("Номенклатура");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.Текст =
	"ВЫБРАТЬ Номенклатура, Характеристика, СУММА(КоличествоОстаток) КАК Количество
	|ИЗ РегистрНакопления.РазмещениеЗаказов.Остатки(,
	|ЗаказПокупателя = &Документ И Организация = &Организация
	|И Номенклатура В (&Номенклатура)) КАК Размещение
	|СГРУППИРОВАТЬ ПО Номенклатура, Характеристика
	|ИМЕЮЩИЕ СУММА(КоличествоОстаток) > 0";
	Ожидается = Запрос.Выполнить().Выгрузить();

	// Учетное наличие включает свободный запас и резерв этой машины.
	// Физическое наличие ограничивает его для ордерных складов: накладной
	// до проведения приходного ордера недостаточно для зеленой отметки.
	Запрос.Текст =
	"ВЫБРАТЬ Данные.Номенклатура, Данные.Характеристика, Данные.Партия, Данные.Склад,
	|СУММА(Данные.УчетноеКоличество) КАК УчетноеКоличество,
	|СУММА(Данные.ФизическоеКоличество) КАК ФизическоеКоличество,
	|СУММА(Данные.ЧужойРезерв) КАК ЧужойРезерв
	|ИЗ (
	|ВЫБРАТЬ Остатки.Номенклатура, Остатки.Характеристика, Остатки.Партия,
	|Остатки.СтруктурнаяЕдиница КАК Склад,
	|ВЫБОР КОГДА Остатки.ЗаказПокупателя В (&Документ, ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка))
	|ТОГДА Остатки.КоличествоОстаток ИНАЧЕ 0 КОНЕЦ КАК УчетноеКоличество,
	|0 КАК ФизическоеКоличество,
	|ВЫБОР КОГДА НЕ Остатки.ЗаказПокупателя В (&Документ, ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка))
	|И Остатки.КоличествоОстаток > 0 ТОГДА Остатки.КоличествоОстаток ИНАЧЕ 0 КОНЕЦ КАК ЧужойРезерв
	|ИЗ РегистрНакопления.Запасы.Остатки(,
	|Организация = &Организация И Номенклатура В (&Номенклатура)
	|И СтруктурнаяЕдиница ССЫЛКА Справочник.СтруктурныеЕдиницы) КАК Остатки
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ Движения.Номенклатура, Движения.Характеристика, Движения.Партия,
	|Движения.СтруктурнаяЕдиница,
	|ВЫБОР КОГДА Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|ТОГДА Движения.Количество ИНАЧЕ -Движения.Количество КОНЕЦ, 0, 0
	|ИЗ РегистрНакопления.Запасы КАК Движения
	|ГДЕ Движения.Активность И Движения.Регистратор = &Документ
	|И Движения.Организация = &Организация И Движения.Номенклатура В (&Номенклатура)
	|И Движения.СтруктурнаяЕдиница ССЫЛКА Справочник.СтруктурныеЕдиницы
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ Остатки.Номенклатура, Остатки.Характеристика, Остатки.Партия,
	|Остатки.СтруктурнаяЕдиница, 0, Остатки.КоличествоОстаток, 0
	|ИЗ РегистрНакопления.ЗапасыНаСкладах.Остатки(,
	|Организация = &Организация И Номенклатура В (&Номенклатура)) КАК Остатки
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ Движения.Номенклатура, Движения.Характеристика, Движения.Партия,
	|Движения.СтруктурнаяЕдиница, 0,
	|ВЫБОР КОГДА Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|ТОГДА Движения.Количество ИНАЧЕ -Движения.Количество КОНЕЦ, 0
	|ИЗ РегистрНакопления.ЗапасыНаСкладах КАК Движения
	|ГДЕ Движения.Активность И Движения.Организация = &Организация
	|И Движения.Номенклатура В (&Номенклатура)
	|И (Движения.Регистратор = &Документ
	|ИЛИ Движения.Регистратор ССЫЛКА Документ.РасходныйОрдер
	|И ВЫРАЗИТЬ(Движения.Регистратор КАК Документ.РасходныйОрдер).ДокументОснование = &Документ)) КАК Данные
	|СГРУППИРОВАТЬ ПО Данные.Номенклатура, Данные.Характеристика, Данные.Партия, Данные.Склад";
	Остатки = Запрос.Выполнить().Выгрузить();

	Для Каждого Позиция Из Потребность Цикл
		Если Позиция.Количество <= 0 Тогда ВызватьИсключение "Некорректный коэффициент единицы товара."; КонецЕсли;
		ОтборПоставок = Новый Структура("Номенклатура,Характеристика", Позиция.Номенклатура, Позиция.Характеристика);
		Если Ожидается.НайтиСтроки(ОтборПоставок).Количество() > 0 Тогда Продолжить; КонецЕсли;
		ОтборОстатков = Новый Структура("Номенклатура,Характеристика,Партия",
			Позиция.Номенклатура, Позиция.Характеристика, Позиция.Партия);
		Доступно = 0;
		Для Каждого Остаток Из Остатки.НайтиСтроки(ОтборОстатков) Цикл
			Доступно = Доступно + Макс(0, Мин(Остаток.УчетноеКоличество, Остаток.ФизическоеКоличество - Остаток.ЧужойРезерв));
		КонецЦикла;
		// Частичное количество внутри одной позиции не считается готовой позицией.
		Если Окр(Доступно, 3) >= Окр(Позиция.Количество, 3) Тогда
			Результат.availablePositions = Результат.availablePositions + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции
