// Только чтение складских регистров. Временные форменные колонки «К поступлению»
// не используются: они содержат также чужие свободные ожидаемые поставки.
Функция Рассчитать(Документ) Экспорт
	Организация = Константы.УчетПоКомпании.Компания(Документ.Организация);
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Документ", Документ);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ИспользоватьХарактеристики", ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристики"));
	Запрос.УстановитьПараметр("ИспользоватьПартии", ПолучитьФункциональнуюОпцию("ИспользоватьПартии"));
	Запрос.Текст =
	"ВЫБРАТЬ Товары.Номенклатура, Товары.Характеристика, Товары.Партия,
	|СУММА(Товары.Количество) КАК Количество
	|ИЗ (
	|ВЫБРАТЬ Строки.Номенклатура,
	|ВЫБОР КОГДА &ИспользоватьХарактеристики ТОГДА Строки.Характеристика
	|ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КОНЕЦ КАК Характеристика,
	|ВЫБОР КОГДА &ИспользоватьПартии ТОГДА Строки.Партия
	|ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ПартииНоменклатуры.ПустаяСсылка) КОНЕЦ КАК Партия,
	|Строки.Количество * ВЫБОР КОГДА ТИПЗНАЧЕНИЯ(Строки.ЕдиницаИзмерения) = ТИП(Справочник.ЕдиницыИзмерения)
	|ТОГДА ВЫРАЗИТЬ(Строки.ЕдиницаИзмерения КАК Справочник.ЕдиницыИзмерения).Коэффициент ИНАЧЕ 1 КОНЕЦ КАК Количество
	|ИЗ Документ.ЗаказПокупателя.Запасы КАК Строки
	|ГДЕ Строки.Ссылка = &Документ И Строки.Количество > 0
	|И Строки.НомерВариантаКП = 0
	|И НЕ Строки.АС_НеСписывать
	|И Строки.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ Строки.Номенклатура,
	|ВЫБОР КОГДА &ИспользоватьХарактеристики ТОГДА Строки.Характеристика
	|ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КОНЕЦ,
	|ВЫБОР КОГДА &ИспользоватьПартии ТОГДА Строки.Партия
	|ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ПартииНоменклатуры.ПустаяСсылка) КОНЕЦ,
	|Строки.Количество * ВЫБОР КОГДА ТИПЗНАЧЕНИЯ(Строки.ЕдиницаИзмерения) = ТИП(Справочник.ЕдиницыИзмерения)
	|ТОГДА ВЫРАЗИТЬ(Строки.ЕдиницаИзмерения КАК Справочник.ЕдиницыИзмерения).Коэффициент ИНАЧЕ 1 КОНЕЦ
	|ИЗ Документ.ЗаказПокупателя.Материалы КАК Строки
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ Ссылка, КлючСвязи
	|ИЗ Документ.ЗаказПокупателя.Работы ГДЕ Ссылка = &Документ) КАК Работы
	|ПО Работы.Ссылка = Строки.Ссылка И Работы.КлючСвязи = Строки.КлючСвязи
	|ГДЕ Строки.Ссылка = &Документ И Строки.Количество > 0
	|И Строки.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)) КАК Товары
	|СГРУППИРОВАТЬ ПО Товары.Номенклатура, Товары.Характеристика, Товары.Партия";
	Потребность = Запрос.Выполнить().Выгрузить();
	Результат = Новый Структура("totalPositions,availablePositions", Потребность.Количество(), 0);
	Если Потребность.Количество() = 0 Тогда Возврат Результат; КонецЕсли;
	Если Потребность.Количество() > 100000 Тогда ВызватьИсключение "Превышено число товарных позиций карточки."; КонецЕсли;

	Номенклатура = Потребность.ВыгрузитьКолонку("Номенклатура");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.Текст =
	"ВЫБРАТЬ Номенклатура, Характеристика, СУММА(КоличествоОстаток) КАК Количество
	|ИЗ РегистрНакопления.РазмещениеЗаказов.Остатки(,
	|ЗаказПокупателя = &Документ И Организация = &Организация
	|И Номенклатура В (&Номенклатура)) КАК Размещение
	|СГРУППИРОВАТЬ ПО Номенклатура, Характеристика
	|ИМЕЮЩИЕ СУММА(КоличествоОстаток) > 0";
	Ожидается = Запрос.Выполнить().Выгрузить();

	// Учетное наличие включает свободный запас и резерв этой машины.
	// Физическое наличие ограничивает его для ордерных складов: накладной
	// до проведения приходного ордера недостаточно для зеленой отметки.
	Запрос.Текст =
	"ВЫБРАТЬ Данные.Номенклатура, Данные.Характеристика, Данные.Партия, Данные.Склад,
	|СУММА(Данные.УчетноеКоличество) КАК УчетноеКоличество,
	|СУММА(Данные.ФизическоеКоличество) КАК ФизическоеКоличество,
	|СУММА(Данные.ЧужойРезерв) КАК ЧужойРезерв
	|ИЗ (
	|ВЫБРАТЬ Остатки.Номенклатура, Остатки.Характеристика, Остатки.Партия,
	|Остатки.СтруктурнаяЕдиница КАК Склад,
	|ВЫБОР КОГДА Остатки.ЗаказПокупателя В (&Документ, ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка))
	|ТОГДА Остатки.КоличествоОстаток ИНАЧЕ 0 КОНЕЦ КАК УчетноеКоличество,
	|0 КАК ФизическоеКоличество,
	|ВЫБОР КОГДА НЕ Остатки.ЗаказПокупателя В (&Документ, ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка))
	|И Остатки.КоличествоОстаток > 0 ТОГДА Остатки.КоличествоОстаток ИНАЧЕ 0 КОНЕЦ КАК ЧужойРезерв
	|ИЗ РегистрНакопления.Запасы.Остатки(,
	|Организация = &Организация И Номенклатура В (&Номенклатура)
	|И СтруктурнаяЕдиница ССЫЛКА Справочник.СтруктурныеЕдиницы) КАК Остатки
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ Движения.Номенклатура, Движения.Характеристика, Движения.Партия,
	|Движения.СтруктурнаяЕдиница,
	|ВЫБОР КОГДА Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|ТОГДА Движения.Количество ИНАЧЕ -Движения.Количество КОНЕЦ, 0, 0
	|ИЗ РегистрНакопления.Запасы КАК Движения
	|ГДЕ Движения.Активность И Движения.Регистратор = &Документ
	|И Движения.Организация = &Организация И Движения.Номенклатура В (&Номенклатура)
	|И Движения.СтруктурнаяЕдиница ССЫЛКА Справочник.СтруктурныеЕдиницы
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ Остатки.Номенклатура, Остатки.Характеристика, Остатки.Партия,
	|Остатки.СтруктурнаяЕдиница, 0, Остатки.КоличествоОстаток, 0
	|ИЗ РегистрНакопления.ЗапасыНаСкладах.Остатки(,
	|Организация = &Организация И Номенклатура В (&Номенклатура)) КАК Остатки
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ Движения.Номенклатура, Движения.Характеристика, Движения.Партия,
	|Движения.СтруктурнаяЕдиница, 0,
	|ВЫБОР КОГДА Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|ТОГДА Движения.Количество ИНАЧЕ -Движения.Количество КОНЕЦ, 0
	|ИЗ РегистрНакопления.ЗапасыНаСкладах КАК Движения
	|ГДЕ Движения.Активность И Движения.Организация = &Организация
	|И Движения.Номенклатура В (&Номенклатура)
	|И (Движения.Регистратор = &Документ
	|ИЛИ Движения.Регистратор ССЫЛКА Документ.РасходныйОрдер
	|И ВЫРАЗИТЬ(Движения.Регистратор КАК Документ.РасходныйОрдер).ДокументОснование = &Документ)) КАК Данные
	|СГРУППИРОВАТЬ ПО Данные.Номенклатура, Данные.Характеристика, Данные.Партия, Данные.Склад";
	Остатки = Запрос.Выполнить().Выгрузить();

	Для Каждого Позиция Из Потребность Цикл
		Если Позиция.Количество <= 0 Тогда ВызватьИсключение "Некорректный коэффициент единицы товара."; КонецЕсли;
		ОтборПоставок = Новый Структура("Номенклатура,Характеристика", Позиция.Номенклатура, Позиция.Характеристика);
		Если Ожидается.НайтиСтроки(ОтборПоставок).Количество() > 0 Тогда Продолжить; КонецЕсли;
		ОтборОстатков = Новый Структура("Номенклатура,Характеристика,Партия",
			Позиция.Номенклатура, Позиция.Характеристика, Позиция.Партия);
		Доступно = 0;
		Для Каждого Остаток Из Остатки.НайтиСтроки(ОтборОстатков) Цикл
			Доступно = Доступно + Макс(0, Мин(Остаток.УчетноеКоличество, Остаток.ФизическоеКоличество - Остаток.ЧужойРезерв));
		КонецЦикла;
		// Частичное количество внутри одной позиции не считается готовой позицией.
		Если Окр(Доступно, 3) >= Окр(Позиция.Количество, 3) Тогда
			Результат.availablePositions = Результат.availablePositions + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции


// Общие складские данные читаются один раз на нажатие, без сохранения между обновлениями.
// Резерв и восстановление движений всегда относятся к конкретному документу.
Функция РассчитатьПакет(Документы, ШапкиДокументов = Неопределено, Замеры = Неопределено) Экспорт
	НачалоЭтапа = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Результаты = Новый Соответствие;
	ОрганизацииДокументов = Новый Соответствие;
	Организации = Новый Массив;
	УчетныеОрганизации = Новый Соответствие;
	Для Каждого Документ Из Документы Цикл
		Результаты.Вставить(Документ, Новый Структура("totalPositions,availablePositions", 0, 0));
		Если ШапкиДокументов = Неопределено Тогда
			ИсходнаяОрганизация = Документ.Организация;
		Иначе
			Шапка = ШапкиДокументов.Получить(Документ);
			Если Шапка = Неопределено Тогда ВызватьИсключение "Не получена организация заказ-наряда в пакете."; КонецЕсли;
			ИсходнаяОрганизация = Шапка.Организация;
		КонецЕсли;
		Организация = УчетныеОрганизации.Получить(ИсходнаяОрганизация);
		Если Организация = Неопределено Тогда
			Организация = Константы.УчетПоКомпании.Компания(ИсходнаяОрганизация);
			УчетныеОрганизации.Вставить(ИсходнаяОрганизация, Организация);
		КонецЕсли;
		ОрганизацииДокументов.Вставить(Документ, Организация);
		Если Организации.Найти(Организация) = Неопределено Тогда Организации.Добавить(Организация); КонецЕсли;
	КонецЦикла;
	Если Замеры <> Неопределено Тогда Замеры.Организации = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЭтапа; КонецЕсли;
	Если Документы.Количество() = 0 Тогда Возврат Результаты; КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Документы", Документы);
	Запрос.УстановитьПараметр("Организации", Организации);
	Запрос.УстановитьПараметр("ИспользоватьХарактеристики", ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристики"));
	Запрос.УстановитьПараметр("ИспользоватьПартии", ПолучитьФункциональнуюОпцию("ИспользоватьПартии"));
	Запрос.Текст = ТекстПотребностиПакета();
	НачалоЭтапа = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Потребность = Запрос.Выполнить().Выгрузить();
	Если Замеры <> Неопределено Тогда Замеры.Потребность = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЭтапа; КонецЕсли;
	Если Потребность.Количество() = 0 Тогда Возврат Результаты; КонецЕсли;
	Номенклатура = Новый Соответствие;
	Для Каждого Позиция Из Потребность Цикл Номенклатура.Вставить(Позиция.Номенклатура, Истина); КонецЦикла;
	СписокНоменклатуры = Новый Массив;
	Для Каждого Элемент Из Номенклатура Цикл СписокНоменклатуры.Добавить(Элемент.Ключ); КонецЦикла;
	Запрос.УстановитьПараметр("Номенклатура", СписокНоменклатуры);
	Запрос.Текст =
	"ВЫБРАТЬ Размещение.ЗаказПокупателя КАК Документ, Размещение.Организация,
	|Размещение.Номенклатура, Размещение.Характеристика,
	|СУММА(Размещение.КоличествоОстаток) КАК Количество
	|ИЗ РегистрНакопления.РазмещениеЗаказов.Остатки(,
	|ЗаказПокупателя В (&Документы) И Организация В (&Организации)
	|И Номенклатура В (&Номенклатура)) КАК Размещение
	|СГРУППИРОВАТЬ ПО Размещение.ЗаказПокупателя, Размещение.Организация,
	|Размещение.Номенклатура, Размещение.Характеристика
	|ИМЕЮЩИЕ СУММА(Размещение.КоличествоОстаток) > 0
	|;
	|ВЫБРАТЬ Остатки.ЗаказПокупателя КАК Документ, Остатки.Организация,
	|Остатки.Номенклатура, Остатки.Характеристика, Остатки.Партия,
	|Остатки.СтруктурнаяЕдиница КАК Склад,
	|СУММА(Остатки.КоличествоОстаток) КАК Количество,
	|СУММА(ВЫБОР КОГДА Остатки.КоличествоОстаток > 0
	|ТОГДА Остатки.КоличествоОстаток ИНАЧЕ 0 КОНЕЦ) КАК ПоложительноеКоличество
	|ИЗ РегистрНакопления.Запасы.Остатки(,
	|Организация В (&Организации) И Номенклатура В (&Номенклатура)
	|И СтруктурнаяЕдиница ССЫЛКА Справочник.СтруктурныеЕдиницы) КАК Остатки
	|СГРУППИРОВАТЬ ПО Остатки.ЗаказПокупателя, Остатки.Организация,
	|Остатки.Номенклатура, Остатки.Характеристика, Остатки.Партия, Остатки.СтруктурнаяЕдиница
	|;
	|ВЫБРАТЬ Остатки.Организация, Остатки.Номенклатура, Остатки.Характеристика,
	|Остатки.Партия, Остатки.СтруктурнаяЕдиница КАК Склад,
	|СУММА(Остатки.КоличествоОстаток) КАК Количество
	|ИЗ РегистрНакопления.ЗапасыНаСкладах.Остатки(,
	|Организация В (&Организации) И Номенклатура В (&Номенклатура)) КАК Остатки
	|СГРУППИРОВАТЬ ПО Остатки.Организация, Остатки.Номенклатура,
	|Остатки.Характеристика, Остатки.Партия, Остатки.СтруктурнаяЕдиница
	|;
	|ВЫБРАТЬ Движения.Регистратор КАК Документ, Движения.Организация,
	|Движения.Номенклатура, Движения.Характеристика, Движения.Партия,
	|Движения.СтруктурнаяЕдиница КАК Склад,
	|СУММА(ВЫБОР КОГДА Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|ТОГДА Движения.Количество ИНАЧЕ -Движения.Количество КОНЕЦ) КАК Количество
	|ИЗ РегистрНакопления.Запасы КАК Движения
	|ГДЕ Движения.Активность И Движения.Регистратор В (&Документы)
	|И Движения.Организация В (&Организации) И Движения.Номенклатура В (&Номенклатура)
	|И Движения.СтруктурнаяЕдиница ССЫЛКА Справочник.СтруктурныеЕдиницы
	|СГРУППИРОВАТЬ ПО Движения.Регистратор, Движения.Организация,
	|Движения.Номенклатура, Движения.Характеристика, Движения.Партия, Движения.СтруктурнаяЕдиница
	|;
	|ВЫБРАТЬ ВЫБОР КОГДА Движения.Регистратор ССЫЛКА Документ.РасходныйОрдер
	|ТОГДА ВЫРАЗИТЬ(Движения.Регистратор КАК Документ.РасходныйОрдер).ДокументОснование
	|ИНАЧЕ Движения.Регистратор КОНЕЦ КАК Документ,
	|Движения.Организация, Движения.Номенклатура, Движения.Характеристика,
	|Движения.Партия, Движения.СтруктурнаяЕдиница КАК Склад,
	|ВЫБОР КОГДА Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|ТОГДА Движения.Количество ИНАЧЕ -Движения.Количество КОНЕЦ КАК Количество
	|ИЗ РегистрНакопления.ЗапасыНаСкладах КАК Движения
	|ГДЕ Движения.Активность И Движения.Организация В (&Организации)
	|И Движения.Номенклатура В (&Номенклатура)
	|И (Движения.Регистратор В (&Документы)
	|ИЛИ Движения.Регистратор ССЫЛКА Документ.РасходныйОрдер
	|И ВЫРАЗИТЬ(Движения.Регистратор КАК Документ.РасходныйОрдер).ДокументОснование В (&Документы))";
	НачалоЭтапа = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Пакет = Запрос.ВыполнитьПакет();
	Если Замеры <> Неопределено Тогда Замеры.Выборки = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЭтапа; КонецЕсли;
	НачалоЭтапа = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Ожидается = Пакет[0].Выгрузить();
	Ожидается.Индексы.Добавить("Документ,Организация,Номенклатура,Характеристика");
	Общие = ТаблицаОстатковПакета(Ложь);
	Свои = ТаблицаОстатковПакета(Истина);
	Для Каждого Остаток Из Пакет[1].Выгрузить() Цикл
		Общий = Общие.Добавить();
		ЗаполнитьЗначенияСвойств(Общий, Остаток);
		Если Не ЗначениеЗаполнено(Остаток.Документ) Тогда
			Общий.УчетноеКоличество = Остаток.Количество;
		Иначе
			Общий.ЧужойРезерв = Остаток.ПоложительноеКоличество;
			Если ОрганизацииДокументов.Получить(Остаток.Документ) = Остаток.Организация Тогда
				Свой = Свои.Добавить();
				ЗаполнитьЗначенияСвойств(Свой, Остаток);
				Свой.УчетноеКоличество = Остаток.Количество;
				Свой.ЧужойРезерв = -Остаток.ПоложительноеКоличество;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Остаток Из Пакет[2].Выгрузить() Цикл
		Общий = Общие.Добавить();
		ЗаполнитьЗначенияСвойств(Общий, Остаток);
		Общий.ФизическоеКоличество = Остаток.Количество;
	КонецЦикла;
	Для ИндексПакета = 3 По 4 Цикл
		Для Каждого Движение Из Пакет[ИндексПакета].Выгрузить() Цикл
			Свой = Свои.Добавить();
			ЗаполнитьЗначенияСвойств(Свой, Движение);
			Если ИндексПакета = 3 Тогда
				Свой.УчетноеКоличество = Движение.Количество;
			Иначе
				Свой.ФизическоеКоличество = Движение.Количество;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Измерения = "Организация,Номенклатура,Характеристика,Партия,Склад";
	Ресурсы = "УчетноеКоличество,ФизическоеКоличество,ЧужойРезерв";
	Общие.Свернуть(Измерения, Ресурсы);
	Свои.Свернуть("Документ," + Измерения, Ресурсы);
	Общие.Индексы.Добавить("Организация,Номенклатура,Характеристика,Партия");
	Свои.Индексы.Добавить("Документ,Организация,Номенклатура,Характеристика,Партия");
	Для Каждого Позиция Из Потребность Цикл
		Результат = Результаты.Получить(Позиция.Документ);
		Результат.totalPositions = Результат.totalPositions + 1;
		Если Результат.totalPositions > 100000 Тогда ВызватьИсключение "Превышено число товарных позиций карточки."; КонецЕсли;
		Если Позиция.Количество <= 0 Тогда ВызватьИсключение "Некорректный коэффициент единицы товара."; КонецЕсли;
		Организация = ОрганизацииДокументов.Получить(Позиция.Документ);
		Отбор = Новый Структура("Документ,Организация,Номенклатура,Характеристика",
			Позиция.Документ, Организация, Позиция.Номенклатура, Позиция.Характеристика);
		Если Ожидается.НайтиСтроки(Отбор).Количество() > 0 Тогда Продолжить; КонецЕсли;
		Отбор.Вставить("Партия", Позиция.Партия);
		ОстаткиПозиции = ТаблицаОстатковПакета(Ложь);
		Для Каждого Остаток Из Свои.НайтиСтроки(Отбор) Цикл
			ЗаполнитьЗначенияСвойств(ОстаткиПозиции.Добавить(), Остаток);
		КонецЦикла;
		Отбор.Удалить("Документ");
		Для Каждого Остаток Из Общие.НайтиСтроки(Отбор) Цикл
			ЗаполнитьЗначенияСвойств(ОстаткиПозиции.Добавить(), Остаток);
		КонецЦикла;
		ОстаткиПозиции.Свернуть("Склад", Ресурсы);
		Доступно = 0;
		Для Каждого Остаток Из ОстаткиПозиции Цикл
			Доступно = Доступно + Макс(0, Мин(Остаток.УчетноеКоличество, Остаток.ФизическоеКоличество - Остаток.ЧужойРезерв));
		КонецЦикла;
		Если Окр(Доступно, 3) >= Окр(Позиция.Количество, 3) Тогда
			Результат.availablePositions = Результат.availablePositions + 1;
		КонецЕсли;
	КонецЦикла;
	Если Замеры <> Неопределено Тогда Замеры.Расчет = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЭтапа; КонецЕсли;
	Возврат Результаты;
КонецФункции

Функция ТаблицаОстатковПакета(ПоДокументам)
	Таблица = Новый ТаблицаЗначений;
	Если ПоДокументам Тогда Таблица.Колонки.Добавить("Документ"); КонецЕсли;
	Для Каждого Имя Из СтрРазделить("Организация,Номенклатура,Характеристика,Партия,Склад", ",") Цикл
		Таблица.Колонки.Добавить(Имя);
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("УчетноеКоличество,ФизическоеКоличество,ЧужойРезерв", ",") Цикл
		Таблица.Колонки.Добавить(Имя, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(31, 10)));
	КонецЦикла;
	Возврат Таблица;
КонецФункции

Функция ТекстПотребностиПакета()
	Возврат "ВЫБРАТЬ Товары.Документ, Товары.Номенклатура, Товары.Характеристика, Товары.Партия,
	|СУММА(Товары.Количество) КАК Количество
	|ИЗ (
	|ВЫБРАТЬ Строки.Ссылка КАК Документ, Строки.Номенклатура,
	|ВЫБОР КОГДА &ИспользоватьХарактеристики ТОГДА Строки.Характеристика
	|ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КОНЕЦ КАК Характеристика,
	|ВЫБОР КОГДА &ИспользоватьПартии ТОГДА Строки.Партия
	|ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ПартииНоменклатуры.ПустаяСсылка) КОНЕЦ КАК Партия,
	|Строки.Количество * ВЫБОР КОГДА ТИПЗНАЧЕНИЯ(Строки.ЕдиницаИзмерения) = ТИП(Справочник.ЕдиницыИзмерения)
	|ТОГДА ВЫРАЗИТЬ(Строки.ЕдиницаИзмерения КАК Справочник.ЕдиницыИзмерения).Коэффициент ИНАЧЕ 1 КОНЕЦ КАК Количество
	|ИЗ Документ.ЗаказПокупателя.Запасы КАК Строки
	|ГДЕ Строки.Ссылка В (&Документы) И Строки.Количество > 0
	|И Строки.НомерВариантаКП = 0
	|И НЕ Строки.АС_НеСписывать
	|И Строки.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ Строки.Ссылка КАК Документ, Строки.Номенклатура,
	|ВЫБОР КОГДА &ИспользоватьХарактеристики ТОГДА Строки.Характеристика
	|ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КОНЕЦ,
	|ВЫБОР КОГДА &ИспользоватьПартии ТОГДА Строки.Партия
	|ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ПартииНоменклатуры.ПустаяСсылка) КОНЕЦ,
	|Строки.Количество * ВЫБОР КОГДА ТИПЗНАЧЕНИЯ(Строки.ЕдиницаИзмерения) = ТИП(Справочник.ЕдиницыИзмерения)
	|ТОГДА ВЫРАЗИТЬ(Строки.ЕдиницаИзмерения КАК Справочник.ЕдиницыИзмерения).Коэффициент ИНАЧЕ 1 КОНЕЦ
	|ИЗ Документ.ЗаказПокупателя.Материалы КАК Строки
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ Ссылка, КлючСвязи
	|ИЗ Документ.ЗаказПокупателя.Работы ГДЕ Ссылка В (&Документы)) КАК Работы
	|ПО Работы.Ссылка = Строки.Ссылка И Работы.КлючСвязи = Строки.КлючСвязи
	|ГДЕ Строки.Ссылка В (&Документы) И Строки.Количество > 0
	|И Строки.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)) КАК Товары
	|СГРУППИРОВАТЬ ПО Товары.Документ, Товары.Номенклатура, Товары.Характеристика, Товары.Партия";
КонецФункции
