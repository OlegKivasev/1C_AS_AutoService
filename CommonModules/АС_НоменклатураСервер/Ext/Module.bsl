Функция ПолучитьСледующийВнутреннийАртикул() Экспорт

	КлючСчетчика = "Номенклатура";
	ТранзакцияНачата = Ложь;

	Попытка
		Если Не ТранзакцияАктивна() Тогда
			НачатьТранзакцию();
			ТранзакцияНачата = Истина;
		КонецЕсли;

		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить(
			"РегистрСведений.АС_СчетчикВнутреннихАртикулов");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Ключ", КлючСчетчика);
		Блокировка.Заблокировать();

		ПоследнийНомер = 0;
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|Счетчик.ПоследнийНомер КАК ПоследнийНомер
			|ИЗ
			|РегистрСведений.АС_СчетчикВнутреннихАртикулов КАК Счетчик
			|ГДЕ
			|Счетчик.Ключ = &Ключ";
		Запрос.УстановитьПараметр("Ключ", КлючСчетчика);

		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ПоследнийНомер = Выборка.ПоследнийНомер;
		КонецЕсли;

		НовыйНомер = ПоследнийНомер + 1;
		Пока Истина Цикл
			Если НовыйНомер > 99999999 Тогда
				ВызватьИсключение "Нельзя выдать внутренний артикул: исчерпан диапазон INT-00000001 — INT-99999999.";
			КонецЕсли;

			ВнутреннийАртикул = "INT-" + Формат(
				НовыйНомер, "ЧЦ=8; ЧН=00000000; ЧВН=; ЧГ=");
			Если Не ЕстьАртикул(ВнутреннийАртикул) Тогда
				Прервать;
			КонецЕсли;

			НовыйНомер = НовыйНомер + 1;
		КонецЦикла;

		ЗаписьСчетчика = РегистрыСведений.АС_СчетчикВнутреннихАртикулов.СоздатьМенеджерЗаписи();
		ЗаписьСчетчика.Ключ = КлючСчетчика;
		ЗаписьСчетчика.ПоследнийНомер = НовыйНомер;
		ЗаписьСчетчика.Записать();

		Если ТранзакцияНачата Тогда
			ЗафиксироватьТранзакцию();
			ТранзакцияНачата = Ложь;
		КонецЕсли;

		Возврат ВнутреннийАртикул;
	Исключение
		Если ТранзакцияНачата И ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

КонецФункции

// Проверяет наличие аналогов без полного подсчета и без построения индекса.
Функция СостояниеOEMАналогов(Номенклатура) Экспорт

	Результат = Новый Структура("ИндексГотов, ЕстьКлючиOEM, ЕстьАналоги", Ложь, Ложь, Ложь);
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Результат;
	КонецЕсли;
	Результат.ИндексГотов = Константы.АС_ИндексOEMИнициализирован.Получить();
	Если Не Результат.ИндексГотов Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|ИндексИсходной.КлючOEM
		|ИЗ РегистрСведений.АС_ИндексOEMНоменклатуры КАК ИндексИсходной
		|ГДЕ ИндексИсходной.Номенклатура = &Номенклатура");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Результат.ЕстьКлючиOEM = Не Запрос.Выполнить().Пустой();
	Если Не Результат.ЕстьКлючиOEM Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|Аналоги.Ссылка
		|ИЗ РегистрСведений.АС_ИндексOEMНоменклатуры КАК ИндексИсходной
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.АС_ИндексOEMНоменклатуры КАК ИндексАналогов
		|ПО ИндексАналогов.КлючOEM = ИндексИсходной.КлючOEM
		|И ИндексАналогов.Номенклатура <> &Номенклатура
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Аналоги
		|ПО ИндексАналогов.Номенклатура = Аналоги.Ссылка
		|ГДЕ ИндексИсходной.Номенклатура = &Номенклатура
		|И НЕ Аналоги.ЭтоГруппа
		|И НЕ Аналоги.ПометкаУдаления
		|И НЕ Аналоги.Недействителен
		|И Аналоги.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)";
	Результат.ЕстьАналоги = Не Запрос.Выполнить().Пустой();
	Возврат Результат;

КонецФункции

Функция ЕстьАртикул(Артикул)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|Номенклатура.Ссылка
		|ИЗ
		|Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|Номенклатура.Артикул = &Артикул
		|ИЛИ Номенклатура.АС_ВнутреннийАртикул = &Артикул";
	Запрос.УстановитьПараметр("Артикул", Артикул);

	Выборка = Запрос.Выполнить().Выбрать();
	Возврат Выборка.Следующий();

КонецФункции

Функция ЭтоВнутреннийАртикул(Артикул) Экспорт

	Значение = СокрЛП(Строка(Артикул));
	Если СтрДлина(Значение) <> 12 ИЛИ Лев(Значение, 4) <> "INT-" Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Индекс = 5 По 12 Цикл
		Если СтрНайти("0123456789", Сред(Значение, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Сред(Значение, 5) <> "00000000";

КонецФункции

// Возвращает единый ключ для поиска артикула без типовых разделителей.
// Буквы и цифры сохраняются, чтобы не смешивать буквенно-цифровые артикулы.
Функция КомпактныйКлючАртикула(Артикул) Экспорт

	ИсходныйАртикул = ВРег(СокрЛП(Строка(Артикул)));
	ИсходныйАртикул = СтрЗаменить(ИсходныйАртикул, "Ё", "Е");
	ДопустимыеСимволы = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZАБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ";
	Результат = "";
	Для Позиция = 1 По СтрДлина(ИсходныйАртикул) Цикл
		СимволАртикула = Сред(ИсходныйАртикул, Позиция, 1);
		Если СтрНайти(ДопустимыеСимволы, СимволАртикула) > 0 Тогда
			Результат = Результат + СимволАртикула;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Четыре формы номера: 4/5 цифр модели, 7 цифр детали, без суффикса / с 2 цифрами.
// Пропущенные цифры неизвестны. Это кандидаты поиска, а не правило взаимозаменяемости.
// Указанные пятая цифра и суффикс сохраняются; 00 автоматически не подставляется.
Функция ШаблоныПоискаАвтоАртикула(Артикул) Экспорт

	Результат = Новый Массив;
	КлючАртикула = КомпактныйКлючАртикула(Артикул);
	ДлинаКлюча = СтрДлина(КлючАртикула);
	Если ДлинаКлюча < 11 Или ДлинаКлюча > 14 Тогда
		Возврат Результат;
	КонецЕсли;
	Для Позиция = 1 По ДлинаКлюча Цикл
		Если СтрНайти("0123456789", Сред(КлючАртикула, Позиция, 1)) = 0 Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;

	Модель = Лев(КлючАртикула, 4);
	ПолнаяМодель = Модель + "[0-9]";
	Если ДлинаКлюча = 12 Или ДлинаКлюча = 14 Тогда
		ПолнаяМодель = Лев(КлючАртикула, 5);
		НомерДетали = Сред(КлючАртикула, 6, 7);
	Иначе
		НомерДетали = Сред(КлючАртикула, 5, 7);
	КонецЕсли;
	Суффикс = "[0-9][0-9]";
	Если ДлинаКлюча = 13 Или ДлинаКлюча = 14 Тогда
		Суффикс = Прав(КлючАртикула, 2);
	КонецЕсли;

	Модели = Новый Массив;
	Модели.Добавить(Модель);
	Модели.Добавить(ПолнаяМодель);
	Суффиксы = Новый Массив;
	Суффиксы.Добавить("");
	Суффиксы.Добавить(Суффикс);
	Для Каждого МодельШаблона Из Модели Цикл
		Для Каждого СуффиксШаблона Из Суффиксы Цикл
			БезРазделителей = МодельШаблона + НомерДетали + СуффиксШаблона;
			СДефисами = МодельШаблона + "-" + НомерДетали;
			СПробелами = МодельШаблона + " " + НомерДетали;
			Если Не ПустаяСтрока(СуффиксШаблона) Тогда
				СДефисами = СДефисами + "-" + СуффиксШаблона;
				СПробелами = СПробелами + " " + СуффиксШаблона;
			КонецЕсли;
			Результат.Добавить(Новый Структура(
				"БезРазделителей,СДефисами,СПробелами,НомерДетали",
				БезРазделителей, СДефисами, СПробелами, НомерДетали));
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Общее условие для списка и автоподбора документов. Псевдоним: Номенклатура.
Функция УсловиеПоискаПоАртикулу(Запрос, Артикул) Экспорт

	Шаблоны = ШаблоныПоискаАвтоАртикула(Артикул);
	Если Шаблоны.Количество() = 0 Тогда
		// Обычные артикулы и неполный ввод сохраняют поиск по подстроке.
		КлючАртикула = КомпактныйКлючАртикула(Артикул);
		Шаблон = СтрЗаменить(КлючАртикула, "~", "~~");
		Шаблон = СтрЗаменить(Шаблон, "%", "~%");
		Шаблон = СтрЗаменить(Шаблон, "_", "~_");
		Шаблон = СтрЗаменить(Шаблон, "[", "~[");
		Шаблон = СтрЗаменить(Шаблон, "]", "~]");
		Запрос.УстановитьПараметр("АС_АртикулПодстрока", "%" + Шаблон + "%");
		Возврат "Номенклатура.АС_АртикулДляПоиска ПОДОБНО &АС_АртикулПодстрока СПЕЦСИМВОЛ ""~""";
	КонецЕсли;

	Условия = Новый Массив;
	Для Индекс = 0 По Шаблоны.ВГраница() Цикл
		Шаблон = Шаблоны[Индекс];
		ИмяПараметра = "АС_АртикулКомпактный" + Строка(Индекс);
		Запрос.УстановитьПараметр(ИмяПараметра, Шаблон.БезРазделителей);
		Условия.Добавить("Номенклатура.АС_АртикулДляПоиска ПОДОБНО &" + ИмяПараметра);
		// Прямые шаблоны находят старые карточки без технического ключа.
		Условия.Добавить("Номенклатура.Артикул ПОДОБНО &" + ИмяПараметра);
		ИмяПараметра = "АС_АртикулДефисы" + Строка(Индекс);
		Запрос.УстановитьПараметр(ИмяПараметра, Шаблон.СДефисами);
		Условия.Добавить("Номенклатура.Артикул ПОДОБНО &" + ИмяПараметра);
		ИмяПараметра = "АС_АртикулПробелы" + Строка(Индекс);
		Запрос.УстановитьПараметр(ИмяПараметра, Шаблон.СПробелами);
		Условия.Добавить("Номенклатура.Артикул ПОДОБНО &" + ИмяПараметра);
	КонецЦикла;
	Возврат "(" + СтрСоединить(Условия, " ИЛИ ") + ")";

КонецФункции


// Ключ взаимозаменяемости: сравнение артикула без разделителей и знаков.
// Короткий номер Lada (4 цифры модели + 7 цифр детали) соответствует только
// базовому полному номеру с пятой цифрой 0 и исполнением 00.
Функция КлючВзаимозаменяемостиАртикула(Артикул) Экспорт

	ИсходныйАртикул = ВРег(Строка(Артикул));
	ИсходныйАртикул = СтрЗаменить(ИсходныйАртикул, "Ё", "Е");
	ДопустимыеСимволы = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZАБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ";
	КомпактныйАртикул = "";
	Для Позиция = 1 По СтрДлина(ИсходныйАртикул) Цикл
		СимволАртикула = Сред(ИсходныйАртикул, Позиция, 1);
		Если СтрНайти(ДопустимыеСимволы, СимволАртикула) > 0 Тогда
			КомпактныйАртикул = КомпактныйАртикул + СимволАртикула;
		КонецЕсли;
	КонецЦикла;

	Если ПустаяСтрока(КомпактныйАртикул) Тогда
		Возврат "";
	КонецЕсли;

	ЭтоЧисловойАртикул = Истина;
	Для Позиция = 1 По СтрДлина(КомпактныйАртикул) Цикл
		Если СтрНайти("0123456789", Сред(КомпактныйАртикул, Позиция, 1)) = 0 Тогда
			ЭтоЧисловойАртикул = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ЭтоЧисловойАртикул И СтрДлина(КомпактныйАртикул) = 11 Тогда
		Возврат "LADA:" + Лев(КомпактныйАртикул, 4) + "0" + Сред(КомпактныйАртикул, 5, 7) + "00";
	КонецЕсли;

	Если ЭтоЧисловойАртикул И СтрДлина(КомпактныйАртикул) = 12 Тогда
		Если Сред(КомпактныйАртикул, 5, 1) = "0" Тогда
			Возврат "LADA:" + КомпактныйАртикул + "00";
		КонецЕсли;
	КонецЕсли;

	Если ЭтоЧисловойАртикул И СтрДлина(КомпактныйАртикул) = 13 Тогда
		Возврат "LADA:" + Лев(КомпактныйАртикул, 4) + "0"
			+ Сред(КомпактныйАртикул, 5, 7) + Прав(КомпактныйАртикул, 2);
	КонецЕсли;

	Если ЭтоЧисловойАртикул И СтрДлина(КомпактныйАртикул) = 14 Тогда
		Возврат "LADA:" + КомпактныйАртикул;
	КонецЕсли;

	Возврат "АРТИКУЛ:" + КомпактныйАртикул;

КонецФункции

Функция УсловиеПоискаКандидатовВзаимозаменяемости(Запрос, Артикул) Экспорт

	Шаблоны = ШаблоныПоискаАвтоАртикула(Артикул);
	Если Шаблоны.Количество() = 0 Тогда
		Ключ = КомпактныйКлючАртикула(Артикул);
		Запрос.УстановитьПараметр("АС_ВзаимозаменяемыйКлюч0", Ключ);
		Возврат "Номенклатура.АС_АртикулДляПоиска = &АС_ВзаимозаменяемыйКлюч0";
	КонецЕсли;

	Условия = Новый Массив;
	ПоляАртикула = Новый Массив;
	ПоляАртикула.Добавить("СДефисами");
	ПоляАртикула.Добавить("СПробелами");
	Для Индекс = 0 По Шаблоны.ВГраница() Цикл
		Шаблон = Шаблоны[Индекс];
		ИмяПараметра = "АС_ВзаимозаменяемыйКлюч" + Строка(Индекс);
		Запрос.УстановитьПараметр(ИмяПараметра, Шаблон.БезРазделителей);
		Условия.Добавить("Номенклатура.АС_АртикулДляПоиска = &" + ИмяПараметра);
		ИмяПараметра = "АС_ВзаимозаменяемыйБезРазделителей" + Строка(Индекс);
		Запрос.УстановитьПараметр(ИмяПараметра, Шаблон.БезРазделителей);
		Условия.Добавить("Номенклатура.Артикул ПОДОБНО &" + ИмяПараметра);
		Для Каждого ИмяПоля Из ПоляАртикула Цикл
			ИмяПараметра = "АС_Взаимозаменяемый" + ИмяПоля + Строка(Индекс);
			Запрос.УстановитьПараметр(ИмяПараметра, Шаблон[ИмяПоля]);
			Условия.Добавить("Номенклатура.Артикул ПОДОБНО &" + ИмяПараметра);
		КонецЦикла;
	КонецЦикла;

	Возврат "(" + СтрСоединить(Условия, " ИЛИ ") + ")";

КонецФункции

Функция ПолучитьПредставлениеВзаимозаменяемогоТовара(Номенклатура) Экспорт

	Результат = Новый Структура("Наименование,Артикул,Бренд", "", "", "");
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		| Номенклатура.Наименование КАК Наименование,
		| Номенклатура.Артикул КАК Артикул,
		| Номенклатура.АС_Бренд КАК Бренд
		|ИЗ Справочник.Номенклатура КАК Номенклатура
		|ГДЕ Номенклатура.Ссылка = &Номенклатура");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.Наименование = Выборка.Наименование;
		Результат.Артикул = Выборка.Артикул;
		Результат.Бренд = Строка(Выборка.Бренд);
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЭтоДопустимыйВзаимозаменяемыйТовар(Номенклатура) Экспорт

	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Ложь;
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1 Номенклатура.Ссылка
		|ИЗ Справочник.Номенклатура КАК Номенклатура
		|ГДЕ Номенклатура.Ссылка = &Номенклатура
		| И НЕ Номенклатура.ЭтоГруппа
		| И НЕ Номенклатура.ПометкаУдаления
		| И НЕ Номенклатура.Недействителен
		| И Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

Функция ПолучитьВзаимозаменяемыеТовары(Номенклатура) Экспорт

	Результат = Новый ТаблицаЗначений;
	ТипСтроки = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150));
	Результат.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Результат.Колонки.Добавить("Наименование", ТипСтроки);
	Результат.Колонки.Добавить("Артикул", ТипСтроки);
	Результат.Колонки.Добавить("Бренд", ТипСтроки);
	Результат.Колонки.Добавить("Автоматически", Новый ОписаниеТипов("Булево"));
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		| Связи.Номенклатура КАК Номенклатура,
		| Товары.Наименование КАК Наименование,
		| Товары.Артикул КАК Артикул,
		| Товары.АС_Бренд КАК Бренд,
		| Связи.АвтоматическиДобавлено КАК Автоматически
		|ИЗ
		| (
		|  ВЫБРАТЬ Рег.ВзаимозаменяемыйТовар КАК Номенклатура, Рег.АвтоматическиДобавлено КАК АвтоматическиДобавлено
		|  ИЗ РегистрСведений.АС_ВзаимозаменяемыеТовары КАК Рег
		|  ГДЕ Рег.Номенклатура = &Номенклатура
		|  ОБЪЕДИНИТЬ ВСЕ
		|  ВЫБРАТЬ Рег.Номенклатура, Рег.АвтоматическиДобавлено
		|  ИЗ РегистрСведений.АС_ВзаимозаменяемыеТовары КАК Рег
		|  ГДЕ Рег.ВзаимозаменяемыйТовар = &Номенклатура
		| ) КАК Связи
		| ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Товары
		| ПО Товары.Ссылка = Связи.Номенклатура
		|ГДЕ Товары.Ссылка <> &Номенклатура
		| И НЕ Товары.ЭтоГруппа
		| И НЕ Товары.ПометкаУдаления
		| И НЕ Товары.Недействителен
		|УПОРЯДОЧИТЬ ПО Товары.Наименование");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);

	Строки = Запрос.Выполнить().Выбрать();
	ИндексСтрок = Новый Соответствие;
	Пока Строки.Следующий() Цикл
		СуществующаяСтрока = ИндексСтрок.Получить(Строки.Номенклатура);
		Если СуществующаяСтрока <> Неопределено ИЛИ СуществующаяСтрока = Ложь Тогда
			Если СуществующаяСтрока <> Неопределено И Не Строки.Автоматически Тогда
				СуществующаяСтрока.Автоматически = Ложь;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.Номенклатура = Строки.Номенклатура;
		НоваяСтрока.Наименование = Строки.Наименование;
		НоваяСтрока.Артикул = Строки.Артикул;
		НоваяСтрока.Бренд = Строка(Строки.Бренд);
		НоваяСтрока.Автоматически = Строки.Автоматически;
		ИндексСтрок.Вставить(Строки.Номенклатура, НоваяСтрока);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ЗаписатьВзаимозаменяемуюСвязь(Номенклатура, ВзаимозаменяемыйТовар, Автоматически) Экспорт

	Если Номенклатура = ВзаимозаменяемыйТовар Тогда
		Возврат;
	КонецЕсли;
	ПарыСвязи = Новый Массив;
	ПарыСвязи.Добавить(Новый Структура("Номенклатура,Товар", Номенклатура, ВзаимозаменяемыйТовар));
	ПарыСвязи.Добавить(Новый Структура("Номенклатура,Товар", ВзаимозаменяемыйТовар, Номенклатура));
	Для Каждого Пара Из ПарыСвязи Цикл
		Запись = РегистрыСведений.АС_ВзаимозаменяемыеТовары.СоздатьМенеджерЗаписи();
		Запись.Номенклатура = Пара.Номенклатура;
		Запись.ВзаимозаменяемыйТовар = Пара.Товар;
		Запись.АвтоматическиДобавлено = Автоматически;
		Запись.Записать();
	КонецЦикла;

КонецПроцедуры

Функция ЕстьРучнаяВзаимозаменяемаяСвязь(Номенклатура, ВзаимозаменяемыйТовар) Экспорт

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1 Рег.Номенклатура
		|ИЗ РегистрСведений.АС_ВзаимозаменяемыеТовары КАК Рег
		|ГДЕ Рег.Номенклатура = &Номенклатура
		| И Рег.ВзаимозаменяемыйТовар = &Товар
		| И НЕ Рег.АвтоматическиДобавлено");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Товар", ВзаимозаменяемыйТовар);
	Возврат Не Запрос.Выполнить().Пустой();

