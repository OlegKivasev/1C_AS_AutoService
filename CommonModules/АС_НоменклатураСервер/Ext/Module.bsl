Функция ПолучитьСледующийВнутреннийАртикул() Экспорт

	КлючСчетчика = "Номенклатура";
	ТранзакцияНачата = Ложь;

	Попытка
		Если Не ТранзакцияАктивна() Тогда
			НачатьТранзакцию();
			ТранзакцияНачата = Истина;
		КонецЕсли;

		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить(
			"РегистрСведений.АС_СчетчикВнутреннихАртикулов");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Ключ", КлючСчетчика);
		Блокировка.Заблокировать();

		ПоследнийНомер = 0;
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|Счетчик.ПоследнийНомер КАК ПоследнийНомер
			|ИЗ
			|РегистрСведений.АС_СчетчикВнутреннихАртикулов КАК Счетчик
			|ГДЕ
			|Счетчик.Ключ = &Ключ";
		Запрос.УстановитьПараметр("Ключ", КлючСчетчика);

		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ПоследнийНомер = Выборка.ПоследнийНомер;
		КонецЕсли;

		НовыйНомер = ПоследнийНомер + 1;
		Пока Истина Цикл
			Если НовыйНомер > 99999999 Тогда
				ВызватьИсключение "Нельзя выдать внутренний артикул: исчерпан диапазон INT-00000001 — INT-99999999.";
			КонецЕсли;

			ВнутреннийАртикул = "INT-" + Формат(
				НовыйНомер, "ЧЦ=8; ЧН=00000000; ЧВН=; ЧГ=");
			Если Не ЕстьАртикул(ВнутреннийАртикул) Тогда
				Прервать;
			КонецЕсли;

			НовыйНомер = НовыйНомер + 1;
		КонецЦикла;

		ЗаписьСчетчика = РегистрыСведений.АС_СчетчикВнутреннихАртикулов.СоздатьМенеджерЗаписи();
		ЗаписьСчетчика.Ключ = КлючСчетчика;
		ЗаписьСчетчика.ПоследнийНомер = НовыйНомер;
		ЗаписьСчетчика.Записать();

		Если ТранзакцияНачата Тогда
			ЗафиксироватьТранзакцию();
			ТранзакцияНачата = Ложь;
		КонецЕсли;

		Возврат ВнутреннийАртикул;
	Исключение
		Если ТранзакцияНачата И ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

КонецФункции

// Возвращает состояние и количество найденных аналогов для подписи в форме.
Функция ИнформацияПоOEMАналогам(Номенклатура) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("ЕстьOEM", Ложь);
	Результат.Вставить("ЕстьКлючиOEM", Ложь);
	Результат.Вставить("Количество", 0);

	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Результат;
	КонецЕсли;

	ЗапросOEM = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|Номенклатура.АС_OEM КАК OEM
		|ИЗ
		|Справочник.Номенклатура КАК Номенклатура
		|ГДЕ Номенклатура.Ссылка = &Номенклатура");
	ЗапросOEM.УстановитьПараметр("Номенклатура", Номенклатура);
	ВыборкаOEM = ЗапросOEM.Выполнить().Выбрать();
	Если Не ВыборкаOEM.Следующий() Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.ЕстьOEM = Не ПустаяСтрока(СокрЛП(ВыборкаOEM.OEM));
	Если Не Результат.ЕстьOEM Тогда
		Возврат Результат;
	КонецЕсли;

	АС_ИндексOEMСервер.ОбеспечитьИндекс();

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Аналоги.Ссылка) КАК Количество,
		|КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ИндексИсходной.КлючOEM) КАК КоличествоКлючейOEM
		|ИЗ
		|РегистрСведений.АС_ИндексOEMНоменклатуры КАК ИндексИсходной
		|ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АС_ИндексOEMНоменклатуры КАК ИндексАналогов
		|ПО ИндексАналогов.КлючOEM = ИндексИсходной.КлючOEM
		|И НЕ ИндексАналогов.Номенклатура = &Номенклатура
		|ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Аналоги
		|ПО ИндексАналогов.Номенклатура = Аналоги.Ссылка
		|И НЕ Аналоги.ЭтоГруппа
		|И НЕ Аналоги.ПометкаУдаления
		|И НЕ Аналоги.Недействителен
		|И Аналоги.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)
		|ГДЕ
		|ИндексИсходной.Номенклатура = &Номенклатура");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.Количество = Выборка.Количество;
		Результат.ЕстьКлючиOEM = Выборка.КоличествоКлючейOEM > 0;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращает товары, имеющие хотя бы один общий нормализованный OEM.
Функция ПолучитьOEMАналоги(Номенклатура) Экспорт

	Результат = Новый СписокЗначений;
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Результат;
	КонецЕсли;

	АС_ИндексOEMСервер.ОбеспечитьИндекс();

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|Аналоги.Ссылка КАК Номенклатура,
		|Аналоги.Наименование КАК Наименование,
		|Аналоги.Артикул КАК Артикул,
		|Аналоги.АС_OEM КАК OEM
		|ИЗ
		|РегистрСведений.АС_ИндексOEMНоменклатуры КАК ИндексИсходной
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.АС_ИндексOEMНоменклатуры КАК ИндексАналогов
		|ПО ИндексАналогов.КлючOEM = ИндексИсходной.КлючOEM
		|И НЕ ИндексАналогов.Номенклатура = &Номенклатура
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Аналоги
		|ПО ИндексАналогов.Номенклатура = Аналоги.Ссылка
		|ГДЕ
		|ИндексИсходной.Номенклатура = &Номенклатура
		|И НЕ Аналоги.ЭтоГруппа
		|И НЕ Аналоги.ПометкаУдаления
		|И НЕ Аналоги.Недействителен
		|И Аналоги.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)
		|УПОРЯДОЧИТЬ ПО Аналоги.Наименование");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);

	ДобавленныеАналоги = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ДобавленныеАналоги.Получить(Выборка.Номенклатура) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ДобавленныеАналоги.Вставить(Выборка.Номенклатура, Истина);

		Представление = Выборка.Наименование;
		Если Не ПустаяСтрока(СокрЛП(Выборка.Артикул)) Тогда
			Представление = Представление + " | арт. " + Выборка.Артикул;
		КонецЕсли;
		Если Не ПустаяСтрока(СокрЛП(Выборка.OEM)) Тогда
			Представление = Представление + " | OEM: " + Выборка.OEM;
		КонецЕсли;
		Результат.Добавить(Выборка.Номенклатура, Представление);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЕстьАртикул(Артикул)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|Номенклатура.Ссылка
		|ИЗ
		|Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|Номенклатура.Артикул = &Артикул
		|ИЛИ Номенклатура.АС_ВнутреннийАртикул = &Артикул";
	Запрос.УстановитьПараметр("Артикул", Артикул);

	Выборка = Запрос.Выполнить().Выбрать();
	Возврат Выборка.Следующий();

КонецФункции

Функция ЭтоВнутреннийАртикул(Артикул) Экспорт

	Значение = СокрЛП(Строка(Артикул));
	Если СтрДлина(Значение) <> 12 ИЛИ Лев(Значение, 4) <> "INT-" Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Индекс = 5 По 12 Цикл
		Если СтрНайти("0123456789", Сред(Значение, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Сред(Значение, 5) <> "00000000";

КонецФункции

// Возвращает единый ключ для поиска артикула без типовых разделителей.
// Буквы и цифры сохраняются, чтобы не смешивать буквенно-цифровые артикулы.
Функция КомпактныйКлючАртикула(Артикул) Экспорт

	Результат = ВРег(СокрЛП(Строка(Артикул)));
	Результат = СтрЗаменить(Результат, Символы.НПП, " ");
	Результат = СтрЗаменить(Результат, "Ё", "Е");

	Разделители = Новый Массив;
	Разделители.Добавить(" ");
	Разделители.Добавить("-");
	Разделители.Добавить("–");
	Разделители.Добавить("—");
	Разделители.Добавить("_");
	Разделители.Добавить(".");
	Разделители.Добавить(",");
	Разделители.Добавить("/");
	Разделители.Добавить("\");
	Разделители.Добавить("(");
	Разделители.Добавить(")");
	Разделители.Добавить("[");
	Разделители.Добавить("]");
	Разделители.Добавить(":");
	Разделители.Добавить(";");
	Разделители.Добавить("+");

	Для Каждого Разделитель Из Разделители Цикл
		Результат = СтрЗаменить(Результат, Разделитель, "");
	КонецЦикла;

	Возврат Результат;

КонецФункции
