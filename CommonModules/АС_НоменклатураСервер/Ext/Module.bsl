Функция ПолучитьБрендыДляАвтоПодбора(Текст) Экспорт

	Результат = Новый СписокЗначений;
	Если ПустаяСтрока(СокрЛП(Текст)) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 20
		| Бренды.Ссылка КАК Ссылка,
		| Бренды.Наименование КАК Наименование
		|ИЗ
		| Справочник.АС_БрендыТоваров КАК Бренды
		|ГДЕ
		| НЕ Бренды.ПометкаУдаления
		| И (Бренды.Наименование ПОДОБНО &СтрокаПоиска
		|  ИЛИ Бренды.АС_Синонимы ПОДОБНО &СтрокаПоиска)
		|УПОРЯДОЧИТЬ ПО Бренды.Наименование";
	Запрос.УстановитьПараметр("СтрокаПоиска", "%" + СокрЛП(Текст) + "%");

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Ссылка, Выборка.Наименование);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПолучитьСледующийВнутреннийАртикул() Экспорт

	КлючСчетчика = "Номенклатура";
	ТранзакцияНачата = Ложь;

	Попытка
		Если Не ТранзакцияАктивна() Тогда
			НачатьТранзакцию();
			ТранзакцияНачата = Истина;
		КонецЕсли;

		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить(
			"РегистрСведений.АС_СчетчикВнутреннихАртикулов");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Ключ", КлючСчетчика);
		Блокировка.Заблокировать();

		ПоследнийНомер = 0;
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|Счетчик.ПоследнийНомер КАК ПоследнийНомер
			|ИЗ
			|РегистрСведений.АС_СчетчикВнутреннихАртикулов КАК Счетчик
			|ГДЕ
			|Счетчик.Ключ = &Ключ";
		Запрос.УстановитьПараметр("Ключ", КлючСчетчика);

		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ПоследнийНомер = Выборка.ПоследнийНомер;
		КонецЕсли;

		НовыйНомер = ПоследнийНомер + 1;
		Пока Истина Цикл
			Если НовыйНомер > 99999999 Тогда
				ВызватьИсключение "Нельзя выдать внутренний артикул: исчерпан диапазон INT-00000001 — INT-99999999.";
			КонецЕсли;

			ВнутреннийАртикул = "INT-" + Формат(
				НовыйНомер, "ЧЦ=8; ЧН=00000000; ЧВН=; ЧГ=");
			Если Не ЕстьАртикул(ВнутреннийАртикул) Тогда
				Прервать;
			КонецЕсли;

			НовыйНомер = НовыйНомер + 1;
		КонецЦикла;

		ЗаписьСчетчика = РегистрыСведений.АС_СчетчикВнутреннихАртикулов.СоздатьМенеджерЗаписи();
		ЗаписьСчетчика.Ключ = КлючСчетчика;
		ЗаписьСчетчика.ПоследнийНомер = НовыйНомер;
		ЗаписьСчетчика.Записать();

		Если ТранзакцияНачата Тогда
			ЗафиксироватьТранзакцию();
			ТранзакцияНачата = Ложь;
		КонецЕсли;

		Возврат ВнутреннийАртикул;
	Исключение
		Если ТранзакцияНачата И ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

КонецФункции

// Проверяет наличие аналогов без полного подсчета и без построения индекса.
Функция СостояниеOEMАналогов(Номенклатура) Экспорт

	Результат = Новый Структура("ИндексГотов, ЕстьКлючиOEM, ЕстьАналоги", Ложь, Ложь, Ложь);
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Результат;
	КонецЕсли;
	Результат.ИндексГотов = Константы.АС_ИндексOEMИнициализирован.Получить();
	Если Не Результат.ИндексГотов Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|ИндексИсходной.КлючOEM
		|ИЗ РегистрСведений.АС_ИндексOEMНоменклатуры КАК ИндексИсходной
		|ГДЕ ИндексИсходной.Номенклатура = &Номенклатура");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Результат.ЕстьКлючиOEM = Не Запрос.Выполнить().Пустой();
	Если Не Результат.ЕстьКлючиOEM Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|Аналоги.Ссылка
		|ИЗ РегистрСведений.АС_ИндексOEMНоменклатуры КАК ИндексИсходной
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.АС_ИндексOEMНоменклатуры КАК ИндексАналогов
		|ПО ИндексАналогов.КлючOEM = ИндексИсходной.КлючOEM
		|И ИндексАналогов.Номенклатура <> &Номенклатура
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Аналоги
		|ПО ИндексАналогов.Номенклатура = Аналоги.Ссылка
		|ГДЕ ИндексИсходной.Номенклатура = &Номенклатура
		|И НЕ Аналоги.ЭтоГруппа
		|И НЕ Аналоги.ПометкаУдаления
		|И НЕ Аналоги.Недействителен
		|И Аналоги.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)";
	Результат.ЕстьАналоги = Не Запрос.Выполнить().Пустой();
	Возврат Результат;

КонецФункции

Функция ЕстьАртикул(Артикул)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|Номенклатура.Ссылка
		|ИЗ
		|Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|Номенклатура.Артикул = &Артикул
		|ИЛИ Номенклатура.АС_ВнутреннийАртикул = &Артикул";
	Запрос.УстановитьПараметр("Артикул", Артикул);

	Выборка = Запрос.Выполнить().Выбрать();
	Возврат Выборка.Следующий();

КонецФункции

Функция ЭтоВнутреннийАртикул(Артикул) Экспорт

	Значение = СокрЛП(Строка(Артикул));
	Если СтрДлина(Значение) <> 12 ИЛИ Лев(Значение, 4) <> "INT-" Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Индекс = 5 По 12 Цикл
		Если СтрНайти("0123456789", Сред(Значение, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Сред(Значение, 5) <> "00000000";

КонецФункции

// Возвращает единый ключ для поиска артикула без типовых разделителей.
// Буквы и цифры сохраняются, чтобы не смешивать буквенно-цифровые артикулы.
Функция КомпактныйКлючАртикула(Артикул, ПозицииСимволов = Неопределено) Экспорт

	ИсходныйАртикул = ВРег(Строка(Артикул));
	ИсходныйАртикул = СтрЗаменить(ИсходныйАртикул, "Ё", "Е");
	ДопустимыеСимволы = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZАБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ";
	Результат = "";
	Для Позиция = 1 По СтрДлина(ИсходныйАртикул) Цикл
		СимволАртикула = Сред(ИсходныйАртикул, Позиция, 1);
		Если СтрНайти(ДопустимыеСимволы, СимволАртикула) > 0 Тогда
			Результат = Результат + СимволАртикула;
			Если ПозицииСимволов <> Неопределено Тогда ПозицииСимволов.Добавить(Позиция); КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Запасы формы могут содержать и ссылки на товары, и разовые позиции в виде строк.
Функция РеквизитыНаименованияТовара(Наименование, НаименованиеПолное, КлючАртикула) Экспорт

	Бренды = Новый Соответствие;
	ДлинаКлюча = СтрДлина(КлючАртикула);
	Если ЗначениеЗаполнено(Наименование) Или ЗначениеЗаполнено(НаименованиеПолное) Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ Бренды.Ссылка, Бренды.Наименование, Бренды.АС_Синонимы
			|ИЗ Справочник.АС_БрендыТоваров КАК Бренды
			|ГДЕ НЕ Бренды.ПометкаУдаления");
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Варианты = СтрРазделить(Выборка.АС_Синонимы, ",;" + Символы.ПС + Символы.ВК, Ложь);
			Варианты.Добавить(Выборка.Наименование);
			Для Каждого Вариант Из Варианты Цикл
				Ключ = НРег(КомпактныйКлючАртикула(Вариант));
				Если ПустаяСтрока(Ключ) Тогда Продолжить; КонецЕсли;
				ЗначениеКлюча = Бренды.Получить(Ключ);
				Бренды.Вставить(Ключ, ?(ЗначениеКлюча = Неопределено Или ЗначениеКлюча = Выборка.Ссылка, Выборка.Ссылка, Null));
				ДлинаКлюча = Макс(ДлинаКлюча, СтрДлина(Ключ));
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;

	КлючАртикула = НРег(КлючАртикула);
	Совпадения = СовпаденияНаименования(Наименование, КлючАртикула, Бренды, ДлинаКлюча);
	СовпаденияПолного = Совпадения;
	Если НаименованиеПолное <> Наименование Тогда
		СовпаденияПолного = СовпаденияНаименования(НаименованиеПолное, КлючАртикула, Бренды, ДлинаКлюча);
	КонецЕсли;
	Бренд = БрендИзНаименований(Наименование, НаименованиеПолное, Бренды, Совпадения, СовпаденияПолного);
	Возврат Новый Структура("Наименование,НаименованиеПолное,Бренд",
		НаименованиеБезСовпадений(Наименование, Совпадения, Бренд),
		НаименованиеБезСовпадений(НаименованиеПолное, СовпаденияПолного, Бренд), Бренд);

КонецФункции

Функция БрендИзНаименований(Наименование, НаименованиеПолное, Бренды, Совпадения, СовпаденияПолного)

	Тексты = Новый Массив;
	Тексты.Добавить(Наименование);
	Если НаименованиеПолное <> Наименование Тогда Тексты.Добавить(НаименованиеПолное); КонецЕсли;
	Для Каждого Текст Из Тексты Цикл
		Разделитель = СтрНайти(Текст, "|", НаправлениеПоиска.СКонца);
		Если Разделитель = 0 Тогда Продолжить; КонецЕсли;
		Бренд = Бренды.Получить(НРег(КомпактныйКлючАртикула(Сред(Текст, Разделитель + 1))));
		Если ЗначениеЗаполнено(Бренд) Тогда Возврат Бренд; КонецЕсли;
	КонецЦикла;

	ВсеСовпадения = Новый Массив;
	ВсеСовпадения.Добавить(Совпадения);
	Если НаименованиеПолное <> Наименование Тогда ВсеСовпадения.Добавить(СовпаденияПолного); КонецЕсли;
	Бренд = Неопределено;
	Для Каждого Список Из ВсеСовпадения Цикл
		Для Каждого Совпадение Из Список Цикл
			Если Совпадение.Артикул Тогда Продолжить; КонецЕсли;
			Если Совпадение.Бренд = Null Или Бренд <> Неопределено И Совпадение.Бренд <> Бренд Тогда
				Возврат Неопределено;
			КонецЕсли;
			Бренд = Совпадение.Бренд;
		КонецЦикла;
	КонецЦикла;
	Возврат Бренд;

КонецФункции

// Сравниваем целые последовательности букв и цифр, чтобы не вырезать часть другого слова или кода.
// Позиции в исходной строке нужны для удаления совпадения вместе с его внутренними разделителями.
Функция СовпаденияНаименования(Наименование, КлючАртикула, Бренды, ДлинаКлюча)

	Результат = Новый Массив;
	Если ДлинаКлюча = 0 Тогда Возврат Результат; КонецЕсли;
	Позиции = Новый Массив;
	КлючИмени = НРег(КомпактныйКлючАртикула(Наименование, Позиции));
	Последний = Позиции.ВГраница();
	Начало = 0;
	Пока Начало <= Последний Цикл
		Если Начало > 0 И Позиции[Начало] = Позиции[Начало - 1] + 1 Тогда
			Начало = Начало + 1;
			Продолжить;
		КонецЕсли;
		Совпадение = Неопределено;
		КонецСовпадения = Начало;
		Для КонецКлюча = Начало По Мин(Последний, Начало + ДлинаКлюча - 1) Цикл
			Если КонецКлюча > Начало И Позиции[КонецКлюча] > Позиции[КонецКлюча - 1] + 1
				И СтрНайти(Сред(Наименование, Позиции[КонецКлюча - 1] + 1,
					Позиции[КонецКлюча] - Позиции[КонецКлюча - 1] - 1), "|") > 0 Тогда
				Прервать;
			КонецЕсли;
			Если КонецКлюча < Последний И Позиции[КонецКлюча + 1] = Позиции[КонецКлюча] + 1 Тогда
				Продолжить;
			КонецЕсли;
			Ключ = Сред(КлючИмени, Начало + 1, КонецКлюча - Начало + 1);
			Бренд = Бренды.Получить(Ключ);
			Если Ключ = КлючАртикула Или Бренд <> Неопределено Тогда
				Совпадение = Новый Структура("Начало,Конец,Артикул,Бренд",
					Позиции[Начало], Позиции[КонецКлюча], Ключ = КлючАртикула, Бренд);
				КонецСовпадения = КонецКлюча;
			КонецЕсли;
		КонецЦикла;
		Если Совпадение <> Неопределено Тогда Результат.Добавить(Совпадение); КонецЕсли;
		Начало = КонецСовпадения + 1;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция НаименованиеБезСовпадений(Знач Наименование, Совпадения, Бренд)

	ИсходноеНаименование = Наименование;
	Индекс = Совпадения.ВГраница();
	Пока Индекс >= 0 Цикл
		Совпадение = Совпадения[Индекс];
		Индекс = Индекс - 1;
		Если Не Совпадение.Артикул И (Не ЗначениеЗаполнено(Бренд) Или Бренд <> Совпадение.Бренд) Тогда Продолжить; КонецЕсли;
		Слева = СокрП(Лев(Наименование, Совпадение.Начало - 1));
		Справа = СокрЛ(Сред(Наименование, Совпадение.Конец + 1));
		Если Лев(Справа, 1) = "." Тогда Справа = СокрЛ(Сред(Справа, 2)); КонецЕсли;
		Открывающая = ?(ПустаяСтрока(Слева), 0, СтрНайти("([{«", Прав(Слева, 1)));
		Если Открывающая > 0 И Не ПустаяСтрока(Справа)
			И Лев(Справа, 1) = Сред(")]}»", Открывающая, 1) Тогда
			Слева = СокрП(Лев(Слева, СтрДлина(Слева) - 1));
			Справа = СокрЛ(Сред(Справа, 2));
		КонецЕсли;
		Разделители = "|,;:/-–—№";
		Пока Не ПустаяСтрока(Слева) И СтрНайти(Разделители, Прав(Слева, 1)) > 0 Цикл
			Слева = СокрП(Лев(Слева, СтрДлина(Слева) - 1));
		КонецЦикла;
		Пока Не ПустаяСтрока(Справа) И СтрНайти(Разделители, Лев(Справа, 1)) > 0 Цикл
			Справа = СокрЛ(Сред(Справа, 2));
		КонецЦикла;
		Наименование = Слева + ?(ПустаяСтрока(Слева) Или ПустаяСтрока(Справа), "", " ") + Справа;
	КонецЦикла;
	Возврат ?(Наименование = ИсходноеНаименование, Наименование, СокрЛП(Наименование));

КонецФункции

// Меняем только уже оформленный суффикс выбранного или прежнего бренда.
Функция НаименованиеСБрендом(Знач Наименование, Бренд, ПрежнийБренд = "", Максимум = 100) Экспорт

	Если ПустаяСтрока(Бренд) И ПустаяСтрока(ПрежнийБренд) Тогда Возврат Наименование; КонецЕсли;
	ИсходноеНаименование = Наименование;
	ТекущийКлюч = КомпактныйКлючАртикула(Бренд);
	ПрежнийКлюч = КомпактныйКлючАртикула(ПрежнийБренд);
	Разделитель = СтрНайти(Наименование, "|", НаправлениеПоиска.СКонца);
	Пока Разделитель > 0 Цикл
		Хвост = СокрЛП(Сред(Наименование, Разделитель + 1));
		КлючХвоста = КомпактныйКлючАртикула(Хвост);
		Если Не ПустаяСтрока(Хвост) И (ПустаяСтрока(КлючХвоста)
			Или КлючХвоста <> ТекущийКлюч И КлючХвоста <> ПрежнийКлюч) Тогда Прервать; КонецЕсли;
		Наименование = СокрП(Лев(Наименование, Разделитель - 1));
		Разделитель = СтрНайти(Наименование, "|", НаправлениеПоиска.СКонца);
	КонецЦикла;
	Если ПустаяСтрока(Бренд) Или ПустаяСтрока(Наименование) Тогда Возврат Наименование; КонецЕсли;
	Суффикс = " | " + СокрЛП(Бренд);
	Если Максимум > 0 Тогда
		ДлинаОсновы = Максимум - СтрДлина(Суффикс);
		Если ДлинаОсновы < 1 Тогда Возврат ИсходноеНаименование; КонецЕсли;
		Наименование = Лев(Наименование, ДлинаОсновы);
	КонецЕсли;
	Возврат СокрЛП(Наименование) + Суффикс;

КонецФункции

// Вызывать внутри транзакции записи номенклатуры.
Функция ЗаписатьНаименованияЗамен(ОсноваНаименования, Товары, ИсходныйТовар = Неопределено) Экспорт

	Если Не ПравоДоступа("Изменение", Метаданные.Справочники.Номенклатура) Тогда
		ВызватьИсключение "Нет доступа к изменению номенклатуры.";
	КонецЕсли;
	Если ПустаяСтрока(ОсноваНаименования) Тогда
		ВызватьИсключение "Укажите наименование исходного товара.";
	КонецЕсли;
	НаименованияТоваров = Новый Соответствие;
	Если Товары.Количество() = 0 Тогда
		Возврат НаименованияТоваров;
	КонецЕсли;

	СсылкиДляБлокировки = Новый ТаблицаЗначений;
	СсылкиДляБлокировки.Колонки.Добавить("Ссылка");
	Для Каждого Товар Из Товары Цикл
		СсылкиДляБлокировки.Добавить().Ссылка = Товар;
	КонецЦикла;
	Блокировка = Новый БлокировкаДанных;
	СтрокаБлокировки = Блокировка.Добавить("Справочник.Номенклатура");
	СтрокаБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	СтрокаБлокировки.ИсточникДанных = СсылкиДляБлокировки;
	СтрокаБлокировки.ИспользоватьИзИсточникаДанных("Ссылка", "Ссылка");
	Блокировка.Заблокировать();
	Для Каждого Товар Из Товары Цикл
		Карточка = Товар.ПолучитьОбъект();
		Если Товар = ИсходныйТовар Или Карточка = Неопределено Или Карточка.ЭтоГруппа
			Или Карточка.ПометкаУдаления Или Карточка.Недействителен
			Или Карточка.ТипНоменклатуры <> Перечисления.ТипыНоменклатуры.Запас Тогда
			ВызватьИсключение СтрШаблон("Товар «%1» недоступен для переименования.", Товар);
		КонецЕсли;
		Если Карточка.АС_ЗаписатьНаименованиеЗамены(ОсноваНаименования) Тогда
			НаименованияТоваров.Вставить(Товар, Карточка.Наименование);
		КонецЕсли;
	КонецЦикла;
	Возврат НаименованияТоваров;

КонецФункции

Функция ОсноваНаименованияДляЗамен(Знач Наименование, Бренд, ПрежнийБренд = "") Экспорт

	Наименование = СокрЛП(СтрЗаменить(Наименование, Символы.НПП, " "));
	Наименование = НаименованиеСБрендом(Наименование, "", Бренд);
	Наименование = НаименованиеСБрендом(Наименование, "", ПрежнийБренд);
	РазделительБренда = СтрНайти(Наименование, "| ", НаправлениеПоиска.СКонца);
	Если РазделительБренда > 0 Тогда
		Наименование = СокрП(Лев(Наименование, РазделительБренда - 1));
	КонецЕсли;
	Пока Прав(Наименование, 1) = "|" Цикл
		Наименование = СокрП(Лев(Наименование, СтрДлина(Наименование) - 1));
	КонецЦикла;

	КлючБренда = КомпактныйКлючАртикула(Бренд);
	КлючПрежнегоБренда = КомпактныйКлючАртикула(ПрежнийБренд);
	Для Каждого Разделитель Из СтрРазделить(" - | – | — ", "|") Цикл
		Позиция = СтрНайти(Наименование, Разделитель, НаправлениеПоиска.СКонца);
		Если Позиция = 0 Тогда
			Продолжить;
		КонецЕсли;
		КлючХвоста = КомпактныйКлючАртикула(Сред(Наименование, Позиция + СтрДлина(Разделитель)));
		Если Не ПустаяСтрока(КлючХвоста) И (КлючХвоста = КлючБренда Или КлючХвоста = КлючПрежнегоБренда) Тогда
			Возврат СокрП(Лев(Наименование, Позиция - 1));
		КонецЕсли;
	КонецЦикла;
	Возврат Наименование;

КонецФункции

// Четыре формы номера: 4/5 цифр модели, 7 цифр детали, без суффикса / с 2 цифрами.
// Пропущенные цифры неизвестны. Это кандидаты поиска, а не правило взаимозаменяемости.
// Указанные пятая цифра и суффикс сохраняются; 00 автоматически не подставляется.
Функция ШаблоныПоискаАвтоАртикула(Артикул) Экспорт

	Результат = Новый Массив;
	КлючАртикула = КомпактныйКлючАртикула(Артикул);
	ДлинаКлюча = СтрДлина(КлючАртикула);
	Если ДлинаКлюча < 11 Или ДлинаКлюча > 14 Тогда
		Возврат Результат;
	КонецЕсли;
	Для Позиция = 1 По ДлинаКлюча Цикл
		Если СтрНайти("0123456789", Сред(КлючАртикула, Позиция, 1)) = 0 Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;

	Модель = Лев(КлючАртикула, 4);
	ПолнаяМодель = Модель + "[0-9]";
	Если ДлинаКлюча = 12 Или ДлинаКлюча = 14 Тогда
		ПолнаяМодель = Лев(КлючАртикула, 5);
		НомерДетали = Сред(КлючАртикула, 6, 7);
	Иначе
		НомерДетали = Сред(КлючАртикула, 5, 7);
	КонецЕсли;
	Суффикс = "[0-9][0-9]";
	Если ДлинаКлюча = 13 Или ДлинаКлюча = 14 Тогда
		Суффикс = Прав(КлючАртикула, 2);
	КонецЕсли;

	Модели = Новый Массив;
	Модели.Добавить(Модель);
	Модели.Добавить(ПолнаяМодель);
	Суффиксы = Новый Массив;
	Суффиксы.Добавить("");
	Суффиксы.Добавить(Суффикс);
	Для Каждого МодельШаблона Из Модели Цикл
		Для Каждого СуффиксШаблона Из Суффиксы Цикл
			БезРазделителей = МодельШаблона + НомерДетали + СуффиксШаблона;
			СДефисами = МодельШаблона + "-" + НомерДетали;
			СПробелами = МодельШаблона + " " + НомерДетали;
			Если Не ПустаяСтрока(СуффиксШаблона) Тогда
				СДефисами = СДефисами + "-" + СуффиксШаблона;
				СПробелами = СПробелами + " " + СуффиксШаблона;
			КонецЕсли;
			Результат.Добавить(Новый Структура(
				"БезРазделителей,СДефисами,СПробелами,НомерДетали",
				БезРазделителей, СДефисами, СПробелами, НомерДетали));
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Общее условие для списка и автоподбора документов. Псевдоним: Номенклатура.
Функция УсловиеПоискаПоАртикулу(Запрос, Артикул) Экспорт

	Шаблоны = ШаблоныПоискаАвтоАртикула(Артикул);
	Если Шаблоны.Количество() = 0 Тогда
		// Обычные артикулы и неполный ввод сохраняют поиск по подстроке.
		КлючАртикула = КомпактныйКлючАртикула(Артикул);
		Шаблон = СтрЗаменить(КлючАртикула, "~", "~~");
		Шаблон = СтрЗаменить(Шаблон, "%", "~%");
		Шаблон = СтрЗаменить(Шаблон, "_", "~_");
		Шаблон = СтрЗаменить(Шаблон, "[", "~[");
		Шаблон = СтрЗаменить(Шаблон, "]", "~]");
		Запрос.УстановитьПараметр("АС_АртикулПодстрока", "%" + Шаблон + "%");
		Возврат "Номенклатура.АС_АртикулДляПоиска ПОДОБНО &АС_АртикулПодстрока СПЕЦСИМВОЛ ""~""";
	КонецЕсли;

	Условия = Новый Массив;
	Для Индекс = 0 По Шаблоны.ВГраница() Цикл
		Шаблон = Шаблоны[Индекс];
		ИмяПараметра = "АС_АртикулКомпактный" + Строка(Индекс);
		Запрос.УстановитьПараметр(ИмяПараметра, Шаблон.БезРазделителей);
		Условия.Добавить("Номенклатура.АС_АртикулДляПоиска ПОДОБНО &" + ИмяПараметра);
		// Прямые шаблоны находят старые карточки без технического ключа.
		Условия.Добавить("Номенклатура.Артикул ПОДОБНО &" + ИмяПараметра);
		ИмяПараметра = "АС_АртикулДефисы" + Строка(Индекс);
		Запрос.УстановитьПараметр(ИмяПараметра, Шаблон.СДефисами);
		Условия.Добавить("Номенклатура.Артикул ПОДОБНО &" + ИмяПараметра);
		ИмяПараметра = "АС_АртикулПробелы" + Строка(Индекс);
		Запрос.УстановитьПараметр(ИмяПараметра, Шаблон.СПробелами);
		Условия.Добавить("Номенклатура.Артикул ПОДОБНО &" + ИмяПараметра);
	КонецЦикла;
	Возврат "(" + СтрСоединить(Условия, " ИЛИ ") + ")";

КонецФункции


// Ключ взаимозаменяемости: сравнение артикула без разделителей и знаков.
// Короткий номер Lada (4 цифры модели + 7 цифр детали) соответствует только
// базовому полному номеру с пятой цифрой 0 и исполнением 00.
Функция КлючВзаимозаменяемостиАртикула(Артикул) Экспорт

	ИсходныйАртикул = ВРег(Строка(Артикул));
	ИсходныйАртикул = СтрЗаменить(ИсходныйАртикул, "Ё", "Е");
	ДопустимыеСимволы = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZАБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ";
	КомпактныйАртикул = "";
	Для Позиция = 1 По СтрДлина(ИсходныйАртикул) Цикл
		СимволАртикула = Сред(ИсходныйАртикул, Позиция, 1);
		Если СтрНайти(ДопустимыеСимволы, СимволАртикула) > 0 Тогда
			КомпактныйАртикул = КомпактныйАртикул + СимволАртикула;
		КонецЕсли;
	КонецЦикла;

	Если ПустаяСтрока(КомпактныйАртикул) Тогда
		Возврат "";
	КонецЕсли;

	ЭтоЧисловойАртикул = Истина;
	Для Позиция = 1 По СтрДлина(КомпактныйАртикул) Цикл
		Если СтрНайти("0123456789", Сред(КомпактныйАртикул, Позиция, 1)) = 0 Тогда
			ЭтоЧисловойАртикул = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ЭтоЧисловойАртикул И СтрДлина(КомпактныйАртикул) = 11 Тогда
		Возврат "LADA:" + Лев(КомпактныйАртикул, 4) + "0" + Сред(КомпактныйАртикул, 5, 7) + "00";
	КонецЕсли;

	Если ЭтоЧисловойАртикул И СтрДлина(КомпактныйАртикул) = 12 Тогда
		Если Сред(КомпактныйАртикул, 5, 1) = "0" Тогда
			Возврат "LADA:" + КомпактныйАртикул + "00";
		КонецЕсли;
	КонецЕсли;

	Если ЭтоЧисловойАртикул И СтрДлина(КомпактныйАртикул) = 13 Тогда
		Возврат "LADA:" + Лев(КомпактныйАртикул, 4) + "0"
			+ Сред(КомпактныйАртикул, 5, 7) + Прав(КомпактныйАртикул, 2);
	КонецЕсли;

	Если ЭтоЧисловойАртикул И СтрДлина(КомпактныйАртикул) = 14 Тогда
		Возврат "LADA:" + КомпактныйАртикул;
	КонецЕсли;

	Возврат "АРТИКУЛ:" + КомпактныйАртикул;

КонецФункции

Функция УсловиеПоискаКандидатовВзаимозаменяемости(Запрос, Артикул) Экспорт

	Шаблоны = ШаблоныПоискаАвтоАртикула(Артикул);
	Если Шаблоны.Количество() = 0 Тогда
		Ключ = КомпактныйКлючАртикула(Артикул);
		Запрос.УстановитьПараметр("АС_ВзаимозаменяемыйКлюч0", Ключ);
		Возврат "Номенклатура.АС_АртикулДляПоиска = &АС_ВзаимозаменяемыйКлюч0";
	КонецЕсли;

	Условия = Новый Массив;
	ПоляАртикула = Новый Массив;
	ПоляАртикула.Добавить("СДефисами");
	ПоляАртикула.Добавить("СПробелами");
	Для Индекс = 0 По Шаблоны.ВГраница() Цикл
		Шаблон = Шаблоны[Индекс];
		ИмяПараметра = "АС_ВзаимозаменяемыйКлюч" + Строка(Индекс);
		Запрос.УстановитьПараметр(ИмяПараметра, Шаблон.БезРазделителей);
		Условия.Добавить("Номенклатура.АС_АртикулДляПоиска = &" + ИмяПараметра);
		ИмяПараметра = "АС_ВзаимозаменяемыйБезРазделителей" + Строка(Индекс);
		Запрос.УстановитьПараметр(ИмяПараметра, Шаблон.БезРазделителей);
		Условия.Добавить("Номенклатура.Артикул ПОДОБНО &" + ИмяПараметра);
		Для Каждого ИмяПоля Из ПоляАртикула Цикл
			ИмяПараметра = "АС_Взаимозаменяемый" + ИмяПоля + Строка(Индекс);
			Запрос.УстановитьПараметр(ИмяПараметра, Шаблон[ИмяПоля]);
			Условия.Добавить("Номенклатура.Артикул ПОДОБНО &" + ИмяПараметра);
		КонецЦикла;
	КонецЦикла;

	Возврат "(" + СтрСоединить(Условия, " ИЛИ ") + ")";

КонецФункции

Функция ПолучитьПредставлениеВзаимозаменяемогоТовара(Номенклатура) Экспорт

	Результат = Новый Структура("Наименование,Артикул,Бренд", "", "", "");
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		| Номенклатура.Наименование КАК Наименование,
		| Номенклатура.Артикул КАК Артикул,
		| Номенклатура.АС_Бренд КАК Бренд
		|ИЗ Справочник.Номенклатура КАК Номенклатура
		|ГДЕ Номенклатура.Ссылка = &Номенклатура");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.Наименование = Выборка.Наименование;
		Результат.Артикул = Выборка.Артикул;
		Результат.Бренд = Строка(Выборка.Бренд);
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЭтоДопустимыйВзаимозаменяемыйТовар(Номенклатура) Экспорт

	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Ложь;
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1 Номенклатура.Ссылка
		|ИЗ Справочник.Номенклатура КАК Номенклатура
		|ГДЕ Номенклатура.Ссылка = &Номенклатура
		| И НЕ Номенклатура.ЭтоГруппа
		| И НЕ Номенклатура.ПометкаУдаления
		| И НЕ Номенклатура.Недействителен
		| И Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

Функция ПолучитьВзаимозаменяемыеТовары(Номенклатура) Экспорт

	Результат = Новый ТаблицаЗначений;
	ТипСтроки = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150));
	Результат.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Результат.Колонки.Добавить("Наименование", ТипСтроки);
	Результат.Колонки.Добавить("Артикул", ТипСтроки);
	Результат.Колонки.Добавить("Бренд", ТипСтроки);
	Результат.Колонки.Добавить("Автоматически", Новый ОписаниеТипов("Булево"));
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		| Связи.Номенклатура КАК Номенклатура,
		| Товары.Наименование КАК Наименование,
		| Товары.Артикул КАК Артикул,
		| Товары.АС_Бренд КАК Бренд,
		| Связи.АвтоматическиДобавлено КАК Автоматически
		|ИЗ
		| (
		|  ВЫБРАТЬ Рег.ВзаимозаменяемыйТовар КАК Номенклатура, Рег.АвтоматическиДобавлено КАК АвтоматическиДобавлено
		|  ИЗ РегистрСведений.АС_ВзаимозаменяемыеТовары КАК Рег
		|  ГДЕ Рег.Номенклатура = &Номенклатура
		|  ОБЪЕДИНИТЬ ВСЕ
		|  ВЫБРАТЬ Рег.Номенклатура, Рег.АвтоматическиДобавлено
		|  ИЗ РегистрСведений.АС_ВзаимозаменяемыеТовары КАК Рег
		|  ГДЕ Рег.ВзаимозаменяемыйТовар = &Номенклатура
		| ) КАК Связи
		| ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Товары
		| ПО Товары.Ссылка = Связи.Номенклатура
		|ГДЕ Товары.Ссылка <> &Номенклатура
		| И НЕ Товары.ЭтоГруппа
		| И НЕ Товары.ПометкаУдаления
		| И НЕ Товары.Недействителен
		|УПОРЯДОЧИТЬ ПО Товары.Наименование");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);

	Строки = Запрос.Выполнить().Выбрать();
	ИндексСтрок = Новый Соответствие;
	Пока Строки.Следующий() Цикл
		СуществующаяСтрока = ИндексСтрок.Получить(Строки.Номенклатура);
		Если СуществующаяСтрока <> Неопределено ИЛИ СуществующаяСтрока = Ложь Тогда
			Если СуществующаяСтрока <> Неопределено И Не Строки.Автоматически Тогда
				СуществующаяСтрока.Автоматически = Ложь;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.Номенклатура = Строки.Номенклатура;
		НоваяСтрока.Наименование = Строки.Наименование;
		НоваяСтрока.Артикул = Строки.Артикул;
		НоваяСтрока.Бренд = Строка(Строки.Бренд);
		НоваяСтрока.Автоматически = Строки.Автоматически;
		ИндексСтрок.Вставить(Строки.Номенклатура, НоваяСтрока);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ЗаписатьВзаимозаменяемуюСвязь(Номенклатура, ВзаимозаменяемыйТовар, Автоматически) Экспорт

	Если Номенклатура = ВзаимозаменяемыйТовар Тогда
		Возврат;
	КонецЕсли;
	ПарыСвязи = Новый Массив;
	ПарыСвязи.Добавить(Новый Структура("Номенклатура,Товар", Номенклатура, ВзаимозаменяемыйТовар));
	ПарыСвязи.Добавить(Новый Структура("Номенклатура,Товар", ВзаимозаменяемыйТовар, Номенклатура));
	Для Каждого Пара Из ПарыСвязи Цикл
		Запись = РегистрыСведений.АС_ВзаимозаменяемыеТовары.СоздатьМенеджерЗаписи();
		Запись.Номенклатура = Пара.Номенклатура;
		Запись.ВзаимозаменяемыйТовар = Пара.Товар;
		Запись.АвтоматическиДобавлено = Автоматически;
		Запись.Записать();
	КонецЦикла;

КонецПроцедуры

Функция ЕстьРучнаяВзаимозаменяемаяСвязь(Номенклатура, ВзаимозаменяемыйТовар) Экспорт

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1 Рег.Номенклатура
		|ИЗ РегистрСведений.АС_ВзаимозаменяемыеТовары КАК Рег
		|ГДЕ Рег.Номенклатура = &Номенклатура
		| И Рег.ВзаимозаменяемыйТовар = &Товар
		| И НЕ Рег.АвтоматическиДобавлено");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Товар", ВзаимозаменяемыйТовар);
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

Процедура УдалитьСвязьВзаимозаменяемыхТоваров(Номенклатура, ВзаимозаменяемыйТовар, ТолькоАвтоматическую = Неопределено) Экспорт

	ПарыСвязи = Новый Массив;
	ПарыСвязи.Добавить(Новый Структура("Номенклатура,Товар", Номенклатура, ВзаимозаменяемыйТовар));
	ПарыСвязи.Добавить(Новый Структура("Номенклатура,Товар", ВзаимозаменяемыйТовар, Номенклатура));
	Для Каждого Пара Из ПарыСвязи Цикл
		Запрос = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1 Рег.АвтоматическиДобавлено
			|ИЗ РегистрСведений.АС_ВзаимозаменяемыеТовары КАК Рег
			|ГДЕ Рег.Номенклатура = &Номенклатура
			| И Рег.ВзаимозаменяемыйТовар = &Товар");
		Запрос.УстановитьПараметр("Номенклатура", Пара.Номенклатура);
		Запрос.УстановитьПараметр("Товар", Пара.Товар);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Если ТолькоАвтоматическую = Неопределено ИЛИ Выборка.АвтоматическиДобавлено = ТолькоАвтоматическую Тогда
				Запись = РегистрыСведений.АС_ВзаимозаменяемыеТовары.СоздатьМенеджерЗаписи();
				Запись.Номенклатура = Пара.Номенклатура;
				Запись.ВзаимозаменяемыйТовар = Пара.Товар;
				Запись.Удалить();
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ОбновитьАвтоматическиеСвязи(Номенклатура) Экспорт

	ЗапросСтарыхСвязей = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ Рег.Номенклатура, Рег.ВзаимозаменяемыйТовар
		|ИЗ РегистрСведений.АС_ВзаимозаменяемыеТовары КАК Рег
		|ГДЕ Рег.АвтоматическиДобавлено
		| И (Рег.Номенклатура = &Номенклатура ИЛИ Рег.ВзаимозаменяемыйТовар = &Номенклатура)");
	ЗапросСтарыхСвязей.УстановитьПараметр("Номенклатура", Номенклатура);
	СтарыеСвязи = ЗапросСтарыхСвязей.Выполнить().Выбрать();
	Пока СтарыеСвязи.Следующий() Цикл
		УдалитьСвязьВзаимозаменяемыхТоваров(СтарыеСвязи.Номенклатура, СтарыеСвязи.ВзаимозаменяемыйТовар, Истина);
	КонецЦикла;

	ЗапросТекущего = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1 Номенклатура.Артикул, Номенклатура.ЭтоГруппа, Номенклатура.ПометкаУдаления, Номенклатура.Недействителен, Номенклатура.ТипНоменклатуры
		|ИЗ Справочник.Номенклатура КАК Номенклатура
		|ГДЕ Номенклатура.Ссылка = &Номенклатура");
	ЗапросТекущего.УстановитьПараметр("Номенклатура", Номенклатура);
	ТекущаяСтрока = ЗапросТекущего.Выполнить().Выбрать();
	Если Не ТекущаяСтрока.Следующий()
		Или ТекущаяСтрока.ЭтоГруппа
		Или ТекущаяСтрока.ПометкаУдаления
		Или ТекущаяСтрока.Недействителен
		Или ТекущаяСтрока.ТипНоменклатуры <> Перечисления.ТипыНоменклатуры.Запас Тогда
		Возврат;
	КонецЕсли;

	КлючТекущего = КлючВзаимозаменяемостиАртикула(ТекущаяСтрока.Артикул);
	Если ПустаяСтрока(КлючТекущего) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Условие = УсловиеПоискаКандидатовВзаимозаменяемости(Запрос, ТекущаяСтрока.Артикул);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		| Номенклатура.Ссылка КАК Ссылка,
		| Номенклатура.Артикул КАК Артикул
		|ИЗ Справочник.Номенклатура КАК Номенклатура
		|ГДЕ Номенклатура.Ссылка <> &ТекущаяНоменклатура
		| И НЕ Номенклатура.ЭтоГруппа
		| И НЕ Номенклатура.ПометкаУдаления
		| И НЕ Номенклатура.Недействителен
		| И Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)
		| И " + Условие;
	Запрос.УстановитьПараметр("ТекущаяНоменклатура", Номенклатура);

	Кандидаты = Запрос.Выполнить().Выбрать();
	Пока Кандидаты.Следующий() Цикл
		Если КлючВзаимозаменяемостиАртикула(Кандидаты.Артикул) <> КлючТекущего Тогда
			Продолжить;
		КонецЕсли;
		Если ЕстьРучнаяВзаимозаменяемаяСвязь(Номенклатура, Кандидаты.Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		ЗаписатьВзаимозаменяемуюСвязь(Номенклатура, Кандидаты.Ссылка, Истина);
	КонецЦикла;

КонецПроцедуры

Процедура СинхронизироватьРучныеСвязи(Номенклатура, СтрокиФормы, Цепочки = Неопределено) Экспорт

	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат;
	КонецЕсли;
	ЕстьЦепочки = Цепочки <> Неопределено И Цепочки.Количество() > 0
		И ЭтоДопустимыйВзаимозаменяемыйТовар(Номенклатура);
	ТоварыВКарточке = Новый Соответствие;
	ЖелаемыеСвязи = Новый Соответствие;
	ЖелаемыеТовары = Новый Массив;
	Для Каждого СтрокаФормы Из СтрокиФормы Цикл
		Если Не ЗначениеЗаполнено(СтрокаФормы.Номенклатура)
			Или СтрокаФормы.Номенклатура = Номенклатура
			Или (СтрокаФормы.Автоматически И Не ЕстьЦепочки)
			Или Не ЭтоДопустимыйВзаимозаменяемыйТовар(СтрокаФормы.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		ТоварыВКарточке.Вставить(СтрокаФормы.Номенклатура, Истина);
		Если Не СтрокаФормы.Автоматически И ЖелаемыеСвязи.Получить(СтрокаФормы.Номенклатура) = Неопределено Тогда
			ЖелаемыеСвязи.Вставить(СтрокаФормы.Номенклатура, Истина);
			ЖелаемыеТовары.Добавить(СтрокаФормы.Номенклатура);
		КонецЕсли;
	КонецЦикла;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ Рег.Номенклатура, Рег.ВзаимозаменяемыйТовар
		|ИЗ РегистрСведений.АС_ВзаимозаменяемыеТовары КАК Рег
		|ГДЕ НЕ Рег.АвтоматическиДобавлено
		| И (Рег.Номенклатура = &Номенклатура ИЛИ Рег.ВзаимозаменяемыйТовар = &Номенклатура)");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	СуществующиеСвязи = Запрос.Выполнить().Выбрать();
	Пока СуществующиеСвязи.Следующий() Цикл
		Товар = СуществующиеСвязи.Номенклатура;
		Если Товар = Номенклатура Тогда
			Товар = СуществующиеСвязи.ВзаимозаменяемыйТовар;
		КонецЕсли;
		Если ЖелаемыеСвязи.Получить(Товар) = Неопределено Тогда
			УдалитьСвязьВзаимозаменяемыхТоваров(Номенклатура, Товар, Ложь);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Товар Из ЖелаемыеТовары Цикл
		ЗаписатьВзаимозаменяемуюСвязь(Номенклатура, Товар, Ложь);
	КонецЦикла;
	Если ЕстьЦепочки Тогда
		ДополнитьСвязиГруппЗамен(Номенклатура, Цепочки, ТоварыВКарточке, ЖелаемыеСвязи);
	КонецЕсли;

КонецПроцедуры

Процедура ДополнитьСвязиГруппЗамен(Номенклатура, Цепочки, ТоварыВКарточке, ЖелаемыеСвязи)

	Товары = Новый Массив;
	Товары.Добавить(Номенклатура);
	Для Каждого ТоварВКарточке Из ТоварыВКарточке Цикл
		Товары.Добавить(ТоварВКарточке.Ключ);
	КонецЦикла;

	ПрямыеСвязи = ПрямыеСвязиТоваров(Товары);
	Для Каждого Цепочка Из Цепочки Цикл
		Если ЖелаемыеСвязи.Получить(Цепочка.Товар) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ГруппаЗамен = Новый Массив;
		ГруппаЗамен.Добавить(Номенклатура);
		Для Каждого Замена Из Цепочка.Замены Цикл
			Если ТоварыВКарточке.Получить(Замена) <> Неопределено Тогда
				ГруппаЗамен.Добавить(Замена);
			КонецЕсли;
		КонецЦикла;
		ЗаписатьНедостающиеСвязиГруппыЗамен(ГруппаЗамен, ПрямыеСвязи);
	КонецЦикла;

КонецПроцедуры

Функция ПрямыеСвязиТоваров(Товары)

	ПрямыеСвязи = Новый Соответствие;
	Для Каждого Товар Из Товары Цикл
		ПрямыеСвязи.Вставить(Товар, Новый Соответствие);
	КонецЦикла;
	Для Каждого Связь Из АС_ПродажиНоменклатурыСервер.СвязиДляРасчета(Товары) Цикл
		ПрямыеСвязи.Получить(Связь.Номенклатура).Вставить(Связь.ВзаимозаменяемыйТовар, Истина);
	КонецЦикла;
	Возврат ПрямыеСвязи;

КонецФункции

Процедура ЗаписатьНедостающиеСвязиГруппыЗамен(ГруппаЗамен, ПрямыеСвязи)

	Для Индекс = 0 По ГруппаЗамен.Количество() - 2 Цикл
		Товар = ГруппаЗамен[Индекс];
		ЗаменыТовара = ПрямыеСвязи.Получить(Товар);
		Для ИндексПары = Индекс + 1 По ГруппаЗамен.Количество() - 1 Цикл
			Замена = ГруппаЗамен[ИндексПары];
			Если ЗаменыТовара.Получить(Замена) = Неопределено Тогда
				ЗаписатьВзаимозаменяемуюСвязь(Товар, Замена, Ложь);
				ЗаменыТовара.Вставить(Замена, Истина);
				ПрямыеСвязи.Получить(Замена).Вставить(Товар, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция СвязанныеВзаимозаменяемыеТовары(Товары, ИсключитьТовар = Неопределено) Экспорт

	Результат = Новый Массив;
	Посещенные = Новый Соответствие;
	Если ЗначениеЗаполнено(ИсключитьТовар) Тогда
		Посещенные.Вставить(ИсключитьТовар, Истина);
	КонецЕсли;
	Для Каждого Товар Из Товары Цикл
		Посещенные.Вставить(Товар, Истина);
	КонецЦикла;
	Следующие = Товары;
	Пока Следующие.Количество() > 0 Цикл
		Связи = АС_ПродажиНоменклатурыСервер.СвязиДляРасчета(Следующие);
		Следующие = Новый Массив;
		Для Каждого Связь Из Связи Цикл
			Товар = Связь.ВзаимозаменяемыйТовар;
			Если Посещенные.Получить(Товар) = Неопределено Тогда
				Посещенные.Вставить(Товар, Истина);
				Следующие.Добавить(Товар);
				Результат.Добавить(Товар);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ДеревоГруппВзаимозаменяемыхТоваров(ТоварыОтбора) Экспорт

	Дерево = Новый ДеревоЗначений;
	ТипСтроки = Новый ОписаниеТипов("Строка");
	Дерево.Колонки.Добавить("Наименование", ТипСтроки);
	Дерево.Колонки.Добавить("Артикул", ТипСтроки);
	Дерево.Колонки.Добавить("Бренд", ТипСтроки);
	Дерево.Колонки.Добавить("Состав", ТипСтроки);
	Дерево.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Дерево.Колонки.Добавить("ЭтоГруппаЗамен", Новый ОписаниеТипов("Булево"));
	Если ТоварыОтбора.Количество() = 0 Тогда
		Возврат Дерево;
	КонецЕсли;

	Связи = АС_ПродажиНоменклатурыСервер.СвязиДляРасчета(Неопределено);
	ГруппыПоТоварам = СоставГруппВзаимозаменяемыхТоваров(ТоварыОтбора, Связи);
	Товары = Новый Массив;
	Для Каждого Элемент Из ГруппыПоТоварам Цикл
		Товары.Добавить(Элемент.Ключ);
	КонецЦикла;
	СтрокиГрупп = Новый Соответствие;
	Для Каждого ДанныеТовара Из ПредставленияВзаимозаменяемыхТоваров(Товары) Цикл
		КлючГруппы = ГруппыПоТоварам.Получить(ДанныеТовара.Номенклатура);
		СтрокаГруппы = СтрокиГрупп.Получить(КлючГруппы);
		Если СтрокаГруппы = Неопределено Тогда
			СтрокаГруппы = Дерево.Строки.Добавить();
			СтрокаГруппы.ЭтоГруппаЗамен = Истина;
			СтрокаГруппы.Наименование = ОсноваНаименованияДляЗамен(ДанныеТовара.Наименование, ДанныеТовара.Бренд);
			Если ПустаяСтрока(СтрокаГруппы.Наименование) Тогда
				СтрокаГруппы.Наименование = ДанныеТовара.Наименование;
			КонецЕсли;
			СтрокиГрупп.Вставить(КлючГруппы, СтрокаГруппы);
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(СтрокаГруппы.Строки.Добавить(), ДанныеТовара);
	КонецЦикла;

	Индекс = Дерево.Строки.Количество() - 1;
	Пока Индекс >= 0 Цикл
		СтрокаГруппы = Дерево.Строки[Индекс];
		Если СтрокаГруппы.Строки.Количество() < 2 Тогда
			Дерево.Строки.Удалить(СтрокаГруппы);
		Иначе
			СтрокаГруппы.Состав = Строка(СтрокаГруппы.Строки.Количество());
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	Дерево.Строки.Сортировать("Наименование");
	Возврат Дерево;

КонецФункции

Функция СоставГруппВзаимозаменяемыхТоваров(ТоварыОтбора, Связи)

	// Запрос связей возвращает оба направления, а получателем бывает только действующий товар.
	Соседи = Новый Соответствие;
	Для Каждого Связь Из Связи Цикл
		Если Соседи.Получить(Связь.ВзаимозаменяемыйТовар) = Неопределено Тогда
			Соседи.Вставить(Связь.ВзаимозаменяемыйТовар, Новый Массив);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Связь Из Связи Цикл
		Замены = Соседи.Получить(Связь.Номенклатура);
		Если Замены <> Неопределено Тогда
			Замены.Добавить(Связь.ВзаимозаменяемыйТовар);
		КонецЕсли;
	КонецЦикла;

	ГруппыПоТоварам = Новый Соответствие;
	Для Каждого Товар Из ТоварыОтбора Цикл
		Замены = Соседи.Получить(Товар);
		Если Замены = Неопределено Или Замены.Количество() = 0
			Или ГруппыПоТоварам.Получить(Товар) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Группа = Новый Массив;
		Группа.Добавить(Товар);
		ГруппыПоТоварам.Вставить(Товар, Товар);
		Индекс = 0;
		Пока Индекс < Группа.Количество() Цикл
			Для Каждого Замена Из Соседи.Получить(Группа[Индекс]) Цикл
				Если ГруппыПоТоварам.Получить(Замена) = Неопределено Тогда
					ГруппыПоТоварам.Вставить(Замена, Товар);
					Группа.Добавить(Замена);
				КонецЕсли;
			КонецЦикла;
			Индекс = Индекс + 1;
		КонецЦикла;
	КонецЦикла;
	Возврат ГруппыПоТоварам;

КонецФункции

Функция ПредставленияВзаимозаменяемыхТоваров(Товары) Экспорт

	Результат = Новый Массив;
	Если Товары.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		| Товары.Ссылка КАК Номенклатура, Товары.Наименование, Товары.Артикул, Товары.АС_Бренд КАК Бренд
		|ИЗ Справочник.Номенклатура КАК Товары
		|ГДЕ Товары.Ссылка В (&Товары)
		|УПОРЯДОЧИТЬ ПО Товары.Наименование");
	Запрос.УстановитьПараметр("Товары", Товары);
	Строки = Запрос.Выполнить().Выбрать();
	Пока Строки.Следующий() Цикл
		Результат.Добавить(Новый Структура("Номенклатура,Наименование,Артикул,Бренд,Автоматически",
			Строки.Номенклатура, Строки.Наименование, Строки.Артикул, Строка(Строки.Бренд), Ложь));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ДобавитьВыделенныеВзаимозаменяемыеТовары(ОсновнойТовар, ВыделенныеТовары,
	ДобавитьПоЦепочке = Ложь) Экспорт

	Результат = Новый Структура("Количество,Сообщение", 0, "");
	Если Не ПравоДоступа("Изменение", Метаданные.РегистрыСведений.АС_ВзаимозаменяемыеТовары) Тогда
		Результат.Сообщение = "Недостаточно прав для изменения взаимозаменяемых товаров.";
		Возврат Результат;
	КонецЕсли;
	Если Не ЭтоДопустимыйВзаимозаменяемыйТовар(ОсновнойТовар) Тогда
		Результат.Сообщение = "Текущая строка должна содержать действующий товар.";
		Возврат Результат;
	КонецЕсли;

	Если ВыделенныеТовары.Найти(ОсновнойТовар) = Неопределено Тогда
		Результат.Сообщение = "Сделайте текущим один из выделенных товаров.";
		Возврат Результат;
	КонецЕсли;

	Товары = Новый Массив;
	Товары.Добавить(ОсновнойТовар);
	Для Каждого Товар Из ВыделенныеТовары Цикл
		Если Товары.Найти(Товар) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЭтоДопустимыйВзаимозаменяемыйТовар(Товар) Тогда
			Результат.Сообщение = "Выделите только действующие товары, без групп и услуг.";
			Возврат Результат;
		КонецЕсли;
		Товары.Добавить(Товар);
	КонецЦикла;
	Если Товары.Количество() < 2 Тогда
		Результат.Сообщение = "Выделите как минимум два товара.";
		Возврат Результат;
	КонецЕсли;

	ТранзакцияНачата = Ложь;
	Попытка
		Если Не ТранзакцияАктивна() Тогда
			НачатьТранзакцию();
			ТранзакцияНачата = Истина;
		КонецЕсли;

		// Явно выделенные товары связываем вручную.
		Для Индекс = 0 По Товары.Количество() - 2 Цикл
			Для ИндексПары = Индекс + 1 По Товары.Количество() - 1 Цикл
				Если Не ЕстьРучнаяВзаимозаменяемаяСвязь(Товары[Индекс], Товары[ИндексПары]) Тогда
					ЗаписатьВзаимозаменяемуюСвязь(Товары[Индекс], Товары[ИндексПары], Ложь);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Если ДобавитьПоЦепочке Тогда
			Для Каждого Замена Из СвязанныеВзаимозаменяемыеТовары(Товары) Цикл
				Товары.Добавить(Замена);
			КонецЦикла;
			ЗаписатьНедостающиеСвязиГруппыЗамен(Товары, ПрямыеСвязиТоваров(Товары));
		КонецЕсли;
		Если ТранзакцияНачата Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;
	Исключение
		Если ТранзакцияНачата И ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

	Результат.Количество = Товары.Количество() - 1;
	Возврат Результат;

КонецФункции

Функция ОчиститьВзаимозаменяемыеТовары(Товары) Экспорт

	Результат = Новый Структура("Количество,Сообщение", 0, "");
	РегистрСвязей = Метаданные.РегистрыСведений.АС_ВзаимозаменяемыеТовары;
	Если Не ПравоДоступа("Изменение", РегистрСвязей) Тогда
		Результат.Сообщение = "Недостаточно прав для удаления взаимозаменяемых товаров.";
		Возврат Результат;
	КонецЕсли;
	Если Товары.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ Связи.Номенклатура, Связи.ВзаимозаменяемыйТовар
		|ИЗ РегистрСведений.АС_ВзаимозаменяемыеТовары КАК Связи
		|ГДЕ Связи.Номенклатура В (&Товары) ИЛИ Связи.ВзаимозаменяемыйТовар В (&Товары)
		|УПОРЯДОЧИТЬ ПО Связи.Номенклатура, Связи.ВзаимозаменяемыйТовар");
	Запрос.УстановитьПараметр("Товары", Товары);
	НачатьТранзакцию();
	Попытка
		Строки = Запрос.Выполнить().Выгрузить();
		Для Каждого СтрокаСвязи Из Строки Цикл
			Запись = РегистрыСведений.АС_ВзаимозаменяемыеТовары.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(Запись, СтрокаСвязи);
			Запись.Удалить();
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Результат.Количество = Строки.Количество();
	Возврат Результат;

КонецФункции
