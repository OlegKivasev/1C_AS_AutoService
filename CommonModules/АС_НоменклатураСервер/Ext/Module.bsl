Процедура УдалитьСвязьВзаимозаменяемыхТоваров(Номенклатура, ВзаимозаменяемыйТовар, ТолькоАвтоматическую = Неопределено) Экспорт

	ПарыСвязи = Новый Массив;
	ПарыСвязи.Добавить(Новый Структура("Номенклатура,Товар", Номенклатура, ВзаимозаменяемыйТовар));
	ПарыСвязи.Добавить(Новый Структура("Номенклатура,Товар", ВзаимозаменяемыйТовар, Номенклатура));
	Для Каждого Пара Из ПарыСвязи Цикл
		Запрос = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1 Рег.АвтоматическиДобавлено
			|ИЗ РегистрСведений.АС_ВзаимозаменяемыеТовары КАК Рег
			|ГДЕ Рег.Номенклатура = &Номенклатура
			| И Рег.ВзаимозаменяемыйТовар = &Товар");
		Запрос.УстановитьПараметр("Номенклатура", Пара.Номенклатура);
		Запрос.УстановитьПараметр("Товар", Пара.Товар);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Если ТолькоАвтоматическую = Неопределено ИЛИ Выборка.АвтоматическиДобавлено = ТолькоАвтоматическую Тогда
				Запись = РегистрыСведений.АС_ВзаимозаменяемыеТовары.СоздатьМенеджерЗаписи();
				Запись.Номенклатура = Пара.Номенклатура;
				Запись.ВзаимозаменяемыйТовар = Пара.Товар;
				Запись.Удалить();
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ОбновитьАвтоматическиеСвязи(Номенклатура) Экспорт

	ЗапросСтарыхСвязей = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ Рег.Номенклатура, Рег.ВзаимозаменяемыйТовар
		|ИЗ РегистрСведений.АС_ВзаимозаменяемыеТовары КАК Рег
		|ГДЕ Рег.АвтоматическиДобавлено
		| И (Рег.Номенклатура = &Номенклатура ИЛИ Рег.ВзаимозаменяемыйТовар = &Номенклатура)");
	ЗапросСтарыхСвязей.УстановитьПараметр("Номенклатура", Номенклатура);
	СтарыеСвязи = ЗапросСтарыхСвязей.Выполнить().Выбрать();
	Пока СтарыеСвязи.Следующий() Цикл
		УдалитьСвязьВзаимозаменяемыхТоваров(СтарыеСвязи.Номенклатура, СтарыеСвязи.ВзаимозаменяемыйТовар, Истина);
	КонецЦикла;

	ЗапросТекущего = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1 Номенклатура.Артикул, Номенклатура.ЭтоГруппа, Номенклатура.ПометкаУдаления, Номенклатура.Недействителен, Номенклатура.ТипНоменклатуры
		|ИЗ Справочник.Номенклатура КАК Номенклатура
		|ГДЕ Номенклатура.Ссылка = &Номенклатура");
	ЗапросТекущего.УстановитьПараметр("Номенклатура", Номенклатура);
	ТекущаяСтрока = ЗапросТекущего.Выполнить().Выбрать();
	Если Не ТекущаяСтрока.Следующий()
		Или ТекущаяСтрока.ЭтоГруппа
		Или ТекущаяСтрока.ПометкаУдаления
		Или ТекущаяСтрока.Недействителен
		Или ТекущаяСтрока.ТипНоменклатуры <> Перечисления.ТипыНоменклатуры.Запас Тогда
		Возврат;
	КонецЕсли;

	КлючТекущего = КлючВзаимозаменяемостиАртикула(ТекущаяСтрока.Артикул);
	Если ПустаяСтрока(КлючТекущего) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Условие = УсловиеПоискаКандидатовВзаимозаменяемости(Запрос, ТекущаяСтрока.Артикул);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		| Номенклатура.Ссылка КАК Ссылка,
		| Номенклатура.Артикул КАК Артикул
		|ИЗ Справочник.Номенклатура КАК Номенклатура
		|ГДЕ Номенклатура.Ссылка <> &ТекущаяНоменклатура
		| И НЕ Номенклатура.ЭтоГруппа
		| И НЕ Номенклатура.ПометкаУдаления
		| И НЕ Номенклатура.Недействителен
		| И Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)
		| И " + Условие;
	Запрос.УстановитьПараметр("ТекущаяНоменклатура", Номенклатура);

	Кандидаты = Запрос.Выполнить().Выбрать();
	Пока Кандидаты.Следующий() Цикл
		Если КлючВзаимозаменяемостиАртикула(Кандидаты.Артикул) <> КлючТекущего Тогда
			Продолжить;
		КонецЕсли;
		Если ЕстьРучнаяВзаимозаменяемаяСвязь(Номенклатура, Кандидаты.Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		ЗаписатьВзаимозаменяемуюСвязь(Номенклатура, Кандидаты.Ссылка, Истина);
	КонецЦикла;

КонецПроцедуры

Процедура СинхронизироватьРучныеСвязи(Номенклатура, СтрокиФормы) Экспорт

	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат;
	КонецЕсли;
	ЖелаемыеСвязи = Новый Соответствие;
	ЖелаемыеТовары = Новый Массив;
	Для Каждого СтрокаФормы Из СтрокиФормы Цикл
		Если Не ЗначениеЗаполнено(СтрокаФормы.Номенклатура)
			Или СтрокаФормы.Номенклатура = Номенклатура
			Или СтрокаФормы.Автоматически
			Или Не ЭтоДопустимыйВзаимозаменяемыйТовар(СтрокаФормы.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		Если ЖелаемыеСвязи.Получить(СтрокаФормы.Номенклатура) = Неопределено Тогда
			ЖелаемыеСвязи.Вставить(СтрокаФормы.Номенклатура, Истина);
			ЖелаемыеТовары.Добавить(СтрокаФормы.Номенклатура);
		КонецЕсли;
	КонецЦикла;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ Рег.Номенклатура, Рег.ВзаимозаменяемыйТовар
		|ИЗ РегистрСведений.АС_ВзаимозаменяемыеТовары КАК Рег
		|ГДЕ НЕ Рег.АвтоматическиДобавлено
		| И (Рег.Номенклатура = &Номенклатура ИЛИ Рег.ВзаимозаменяемыйТовар = &Номенклатура)");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	СуществующиеСвязи = Запрос.Выполнить().Выбрать();
	Пока СуществующиеСвязи.Следующий() Цикл
		Товар = СуществующиеСвязи.Номенклатура;
		Если Товар = Номенклатура Тогда
			Товар = СуществующиеСвязи.ВзаимозаменяемыйТовар;
		КонецЕсли;
		Если ЖелаемыеСвязи.Получить(Товар) = Неопределено Тогда
			УдалитьСвязьВзаимозаменяемыхТоваров(Номенклатура, Товар, Ложь);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Товар Из ЖелаемыеТовары Цикл
		ЗаписатьВзаимозаменяемуюСвязь(Номенклатура, Товар, Ложь);
	КонецЦикла;

КонецПроцедуры

Функция ДобавитьВыделенныеВзаимозаменяемыеТовары(ОсновнойТовар, ВыделенныеТовары) Экспорт

	Результат = Новый Структура("Количество,Сообщение", 0, "");
	Если Не ПравоДоступа("Изменение", Метаданные.РегистрыСведений.АС_ВзаимозаменяемыеТовары) Тогда
		Результат.Сообщение = "Недостаточно прав для изменения взаимозаменяемых товаров.";
		Возврат Результат;
	КонецЕсли;
	Если Не ЭтоДопустимыйВзаимозаменяемыйТовар(ОсновнойТовар) Тогда
		Результат.Сообщение = "Текущая строка должна содержать действующий товар.";
		Возврат Результат;
	КонецЕсли;

	Если ВыделенныеТовары.Найти(ОсновнойТовар) = Неопределено Тогда
		Результат.Сообщение = "Сделайте текущим один из выделенных товаров.";
		Возврат Результат;
	КонецЕсли;

	Товары = Новый Массив;
	Товары.Добавить(ОсновнойТовар);
	Для Каждого Товар Из ВыделенныеТовары Цикл
		Если Товары.Найти(Товар) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЭтоДопустимыйВзаимозаменяемыйТовар(Товар) Тогда
			Результат.Сообщение = "Выделите только действующие товары, без групп и услуг.";
			Возврат Результат;
		КонецЕсли;
		Товары.Добавить(Товар);
	КонецЦикла;
	Если Товары.Количество() < 2 Тогда
		Результат.Сообщение = "Выделите как минимум два товара.";
		Возврат Результат;
	КонецЕсли;

	ТранзакцияНачата = Ложь;
	Попытка
		Если Не ТранзакцияАктивна() Тогда
			НачатьТранзакцию();
			ТранзакцияНачата = Истина;
		КонецЕсли;
		// Первый товар — текущая строка. Каждая выбранная карточка видит остальных выбранных.
		// Существующие связи с товарами вне выделения не удаляются.
		Для Индекс = 0 По Товары.Количество() - 2 Цикл
			Для ИндексПары = Индекс + 1 По Товары.Количество() - 1 Цикл
				Если Не ЕстьРучнаяВзаимозаменяемаяСвязь(Товары[Индекс], Товары[ИндексПары]) Тогда
					ЗаписатьВзаимозаменяемуюСвязь(Товары[Индекс], Товары[ИндексПары], Ложь);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Если ТранзакцияНачата Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;
	Исключение
		Если ТранзакцияНачата И ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

	Результат.Количество = Товары.Количество() - 1;
	Возврат Результат;

КонецФункции
