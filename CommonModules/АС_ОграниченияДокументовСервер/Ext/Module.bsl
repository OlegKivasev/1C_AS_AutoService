Процедура ПроверитьОграниченияПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт

	// РМК отменяет проведение и удаляет непробитые чеки при штатной работе кассира.
	// Ограничения чеков определяются типовыми проверками РМК и правами пользователя.
	ЧекРМК = ЭтоЧекРМК(Источник);

	Если Не ЧекРМК
		И РольДоступна(Метаданные.Роли.АС_ЗапретитьОтменуПроведения)
		И РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Вам запрещено отменять проведение документов.'"),
			Источник, , , Отказ);
		Возврат;
	КонецЕсли;

	Если Не ЧекРМК
		И РольДоступна(Метаданные.Роли.АС_ЗапретитьПометкуУдаления)
		И Источник.ПометкаУдаления Тогда
		ПометкаУдаленияБылаУстановлена = Ложь;
		Если Не Источник.ЭтоНовый() Тогда
			ПометкаУдаленияБылаУстановлена = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
				Источник.Ссылка, "ПометкаУдаления");
		КонецЕсли;
		Если Не ПометкаУдаленияБылаУстановлена Тогда
			ОбщегоНазначения.СообщитьПользователю(
				НСтр("ru = 'Вам запрещено помечать документы на удаление.'"),
				Источник, , , Отказ);
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Если РольДоступна(Метаданные.Роли.АС_ЗапретитьРедактированиеСписаний)
		И ТипЗнч(Источник) = Тип("ДокументОбъект.СписаниеЗапасов")
		И Не Источник.ЭтоНовый() Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Созданные документы списания запасов доступны только для просмотра.'"),
			Источник, , , Отказ);
	КонецЕсли;

	Если Не Отказ
		И РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения
		И ТипЗнч(Источник) = Тип("ДокументОбъект.ЧекККМ")
		И Не Источник.ОбменДанными.Загрузка Тогда
		АС_ПереносВыручкиРМКСервер.ОтменитьПереносыПриОтменеЧека(Источник);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьРедактированиеПоступленияПередЗаписью(
	Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт

	Если РольДоступна(Метаданные.Роли.АС_ЗапретитьРедактированиеПоступлений)
		И Не Источник.ЭтоНовый() Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Созданные документы поступления в кассу и на счет доступны только для просмотра.'"),
			Источник, , , Отказ);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьОграниченияПередУдалением(Источник, Отказ) Экспорт

	Если РольДоступна(Метаданные.Роли.АС_ЗапретитьПометкуУдаления) Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Вам запрещено удалять документы.'"),
			Источник, , , Отказ);
	КонецЕсли;

КонецПроцедуры

Функция ЭтоЧекРМК(Источник)

	Возврат ТипЗнч(Источник) = Тип("ДокументОбъект.ЧекККМ")
		Или ТипЗнч(Источник) = Тип("ДокументОбъект.ЧекККМВозврат");

КонецФункции
