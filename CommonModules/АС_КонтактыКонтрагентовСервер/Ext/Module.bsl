// Один набор актуальных контактов на пакет документов. Межзапросного кэша нет.
Функция ДанныеКонтрагентов(Контрагенты) Экспорт

	Результат = Новый Соответствие;
	Уникальные = Новый Соответствие;
	Для Каждого Контрагент Из Контрагенты Цикл
		Если ЗначениеЗаполнено(Контрагент) Тогда Уникальные.Вставить(Контрагент, Истина); КонецЕсли;
	КонецЦикла;
	Если Уникальные.Количество() = 0 Тогда Возврат Результат; КонецЕсли;
	Ссылки = Новый Массив;
	Для Каждого Элемент Из Уникальные Цикл Ссылки.Добавить(Элемент.Ключ); КонецЦикла;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ Контрагенты.Ссылка, Контрагенты.ФИО,
		|Контрагенты.ВидКонтрагента,
		|Контрагенты.ЮридическоеФизическоеЛицо,
		|ЕСТЬNULL(Контрагенты.КонтактноеЛицо.Наименование, """") КАК КонтактноеЛицо
		|ИЗ Справочник.Контрагенты КАК Контрагенты
		|ГДЕ Контрагенты.Ссылка В (&Контрагенты)");
	Запрос.УстановитьПараметр("Контрагенты", Ссылки);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		// Вид из карточки отделяет обычное физлицо от ИП; реквизит БЗКБ их объединяет.
		ФизическоеЛицо = Выборка.ВидКонтрагента
			= Перечисления.ВидыКонтрагентов.ФизическоеЛицо;
		ИмяФизическогоЛица = Выборка.ЮридическоеФизическоеЛицо
			= Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо;
		Имя = СокрЛП(?(ИмяФизическогоЛица, Выборка.ФИО, Выборка.КонтактноеЛицо));
		Результат.Вставить(Выборка.Ссылка, Новый Структура("Имя,Телефон,ФизическоеЛицо", Имя, "", ФизическоеЛицо));
	КонецЦикла;

	// Штатный API учитывает права и историю ДействуетС. Без даты он вернёт историю целиком.
	Телефоны = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъектов(
		Ссылки, Перечисления.ТипыКонтактнойИнформации.Телефон, Неопределено, ТекущаяДатаСеанса());
	Для Каждого СтрокаТелефона Из Телефоны Цикл
		Данные = Результат.Получить(СтрокаТелефона.Объект);
		Если Данные = Неопределено Или Не ПустаяСтрока(Данные.Телефон) Тогда Продолжить; КонецЕсли;
		// При нескольких номерах используем первый непустой в штатном порядке строк.
		Данные.Телефон = СокрЛП(СтрокаТелефона.Представление);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ДанныеКонтрагента(Контрагент) Экспорт

	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Новый Структура("Имя,Телефон,ФизическоеЛицо", "", "", Ложь);
	КонецЕсли;
	Контрагенты = Новый Массив;
	Контрагенты.Добавить(Контрагент);
	Данные = ДанныеКонтрагентов(Контрагенты).Получить(Контрагент);
	Если Данные = Неопределено Тогда ВызватьИсключение "Не удалось прочитать контактные данные контрагента."; КонецЕсли;
	Возврат Данные;

КонецФункции

Процедура ЗаполнитьМеханикаЗаказНаряда(Заказ) Экспорт

	// ФИО и телефон берём из одного контакта, введённые сотрудником данные сохраняем.
	Если Не ПустаяСтрока(Заказ.АС_ФИОМеханика) Или Не ПустаяСтрока(Заказ.АС_ТелефонМеханика) Тогда
		Возврат;
	КонецЕсли;

	Механик = ПервыйМеханикКонтрагента(Заказ.Контрагент);
	Если Механик <> Неопределено Тогда
		Заказ.АС_ФИОМеханика = Механик.ФИО;
		Заказ.АС_ТелефонМеханика = Механик.Телефон;
	КонецЕсли;

КонецПроцедуры

Функция ПервыйМеханикКонтрагента(Контрагент)

	ДатаСеанса = ТекущаяДатаСеанса();
	// Карточка контрагента использует порядок из первой записи связи.
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		| Связи.Контакт КАК Контакт,
		| Контакты.Наименование КАК ФИО,
		| Связи.Должность КАК Должность
		|ИЗ РегистрСведений.СвязиКонтрагентКонтакт.СрезПоследних(, Контрагент = &Контрагент) КАК Связи
		| ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтактныеЛица КАК Контакты
		| ПО Связи.Контакт = Контакты.Ссылка
		| ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязиКонтрагентКонтакт.СрезПервых(, Контрагент = &Контрагент) КАК ПорядокСвязей
		| ПО Связи.Контакт = ПорядокСвязей.Контакт
		|ГДЕ НЕ Связи.СвязьНедействительна
		| И НЕ Контакты.ПометкаУдаления
		| И НЕ Контакты.Недействителен
		|УПОРЯДОЧИТЬ ПО ПорядокСвязей.Порядок, ФИО, Контакт");
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Выборка = Запрос.Выполнить().Выбрать();
	Ссылки = Новый Массив;
	Кандидаты = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Должность = НРег(СокрЛП(СтрЗаменить(Выборка.Должность, Символы.НПП, " ")));
		Если Должность = "механик" И Не ПустаяСтрока(Выборка.ФИО) Тогда
			Ссылки.Добавить(Выборка.Контакт);
			Кандидаты.Добавить(Новый Структура("Контакт,ФИО", Выборка.Контакт, СокрЛП(Выборка.ФИО)));
		КонецЕсли;
	КонецЦикла;
	Если Ссылки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	НомераПоКонтактам = Новый Соответствие;
	Телефоны = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъектов(
		Ссылки, Перечисления.ТипыКонтактнойИнформации.Телефон, Неопределено, ДатаСеанса);
	Для Каждого СтрокаТелефона Из Телефоны Цикл
		Телефон = СокрЛП(СтрокаТелефона.Представление);
		Если Не ПустаяСтрока(Телефон) И НомераПоКонтактам.Получить(СтрокаТелефона.Объект) = Неопределено Тогда
			НомераПоКонтактам.Вставить(СтрокаТелефона.Объект, Телефон);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Кандидат Из Кандидаты Цикл
		Телефон = НомераПоКонтактам.Получить(Кандидат.Контакт);
		Если Телефон <> Неопределено Тогда
			Возврат Новый Структура("ФИО,Телефон", Кандидат.ФИО, Телефон);
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция ВЗаказеИспользуетсяТелефонКонтрагента(ВидОперации) Экспорт

	Возврат ВидОперации = Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаПродажу
		Или ВидОперации = Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаряд;

КонецФункции

Процедура ОбновитьПолеТелефона(Форма, ИмяПоляКонтрагента) Экспорт

	ДобавитьПолеТелефона(Форма, ИмяПоляКонтрагента);
	Контрагент = Форма.Объект.Контрагент;
	Данные = ДанныеКонтрагента(Контрагент);
	Поле = Форма.Элементы.АС_ТелефонКонтрагента;
	РазрешитьВвод = Данные.ФизическоеЛицо И ПустаяСтрока(Данные.Телефон)
		И ВЗаказеИспользуетсяТелефонКонтрагента(Форма.Объект.ВидОперации);
	Если Не РазрешитьВвод Или Поле.ТолькоПросмотр Или Форма.АС_КонтрагентТелефона <> Контрагент Тогда
		Форма.АС_ТелефонКонтрагента = Данные.Телефон;
	КонецЕсли;
	Форма.АС_КонтрагентТелефона = Контрагент;
	Поле.ТолькоПросмотр = Не РазрешитьВвод;
	Поле.Подсказка = ?(РазрешитьВвод, "Введите номер для сохранения в карточке контрагента при проведении.",
		"Актуальный телефон из карточки контрагента.");

КонецПроцедуры

Процедура ПередатьТелефонДляПроведения(Форма, Заказ) Экспорт

	Если Не Форма.Элементы.АС_ТелефонКонтрагента.ТолькоПросмотр
		И Форма.АС_КонтрагентТелефона = Заказ.Контрагент Тогда
		Заказ.ДополнительныеСвойства.Вставить("АС_ТелефонФормы",
			Новый Структура("Контрагент,Телефон", Заказ.Контрагент, СокрЛП(Форма.АС_ТелефонКонтрагента)));
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьТелефонПриПроведении(Заказ, ТелефонОбязателен, Отказ) Экспорт

	Контрагент = Заказ.Контрагент;
	Ввод = Неопределено;
	Заказ.ДополнительныеСвойства.Свойство("АС_ТелефонФормы", Ввод);
	ТелефонВведен = Ввод <> Неопределено И Ввод.Контрагент = Контрагент И Не ПустаяСтрока(Ввод.Телефон);
	Если Не ТелефонОбязателен И Не ТелефонВведен Тогда
		Возврат;
	КонецЕсли;

	Данные = ДанныеКонтрагента(Контрагент);
	Если Не Данные.ФизическоеЛицо Или Не ПустаяСтрока(Данные.Телефон) Тогда
		Возврат;
	КонецЕсли;

	Если Не ТелефонВведен Тогда
		ИмяПоля = ?(Ввод = Неопределено, "", "АС_ТелефонКонтрагента");
		ОбщегоНазначения.СообщитьПользователю("Не заполнен телефон контрагента", , ИмяПоля, , Отказ);
		Возврат;
	КонецЕсли;

	// Проведение и заполнение карточки идут в одной транзакции. Перечитываем телефон после блокировки.
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("Справочник.Контрагенты");
	ЭлементБлокировки.УстановитьЗначение("Ссылка", Контрагент);
	Блокировка.Заблокировать();
	Данные = ДанныеКонтрагента(Контрагент);
	Если Данные.ФизическоеЛицо И ПустаяСтрока(Данные.Телефон) Тогда
		Карточка = Контрагент.ПолучитьОбъект();
		Карточка.Заблокировать();
		УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(Карточка, Ввод.Телефон,
			Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента, ТекущаяДатаСеанса());
		Карточка.Записать();
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьПолеТелефона(Форма, ИмяПоляКонтрагента)

	Если Форма.Элементы.Найти("АС_ТелефонКонтрагента") <> Неопределено Тогда Возврат; КонецЕсли;
	Реквизиты = Новый Массив;
	Реквизиты.Добавить(Новый РеквизитФормы("АС_ТелефонКонтрагента", Новый ОписаниеТипов("Строка")));
	Реквизиты.Добавить(Новый РеквизитФормы("АС_КонтрагентТелефона",
		Новый ОписаниеТипов("СправочникСсылка.Контрагенты")));
	Форма.ИзменитьРеквизиты(Реквизиты);
	ГруппаКонтрагента = Форма.Элементы[ИмяПоляКонтрагента].Родитель;
	Родитель = ГруппаКонтрагента.Родитель;
	СледующийЭлемент = Неопределено;
	НайденаГруппа = Ложь;
	Для Каждого Элемент Из Родитель.ПодчиненныеЭлементы Цикл
		Если НайденаГруппа Тогда СледующийЭлемент = Элемент; Прервать; КонецЕсли;
		Если Элемент = ГруппаКонтрагента Тогда НайденаГруппа = Истина; КонецЕсли;
	КонецЦикла;
	Поле = Форма.Элементы.Вставить("АС_ТелефонКонтрагента", Тип("ПолеФормы"), Родитель, СледующийЭлемент);
	Поле.Вид = ВидПоляФормы.ПолеВвода;
	Поле.ПутьКДанным = "АС_ТелефонКонтрагента";
	Поле.Заголовок = "Телефон контрагента";
	Поле.ТолькоПросмотр = Истина;

КонецПроцедуры
