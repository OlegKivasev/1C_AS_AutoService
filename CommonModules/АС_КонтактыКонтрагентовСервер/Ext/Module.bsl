// Один набор актуальных контактов на пакет документов. Межзапросного кэша нет.
Функция ДанныеКонтрагентов(Контрагенты) Экспорт

	Результат = Новый Соответствие;
	Уникальные = Новый Соответствие;
	Для Каждого Контрагент Из Контрагенты Цикл
		Если ЗначениеЗаполнено(Контрагент) Тогда Уникальные.Вставить(Контрагент, Истина); КонецЕсли;
	КонецЦикла;
	Если Уникальные.Количество() = 0 Тогда Возврат Результат; КонецЕсли;
	Ссылки = Новый Массив;
	Для Каждого Элемент Из Уникальные Цикл Ссылки.Добавить(Элемент.Ключ); КонецЦикла;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ Контрагенты.Ссылка, Контрагенты.ФИО,
		|Контрагенты.ВидКонтрагента,
		|Контрагенты.ЮридическоеФизическоеЛицо,
		|ЕСТЬNULL(Контрагенты.КонтактноеЛицо.Наименование, """") КАК КонтактноеЛицо
		|ИЗ Справочник.Контрагенты КАК Контрагенты
		|ГДЕ Контрагенты.Ссылка В (&Контрагенты)");
	Запрос.УстановитьПараметр("Контрагенты", Ссылки);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		// Вид из карточки отделяет обычное физлицо от ИП; реквизит БЗКБ их объединяет.
		ФизическоеЛицо = Выборка.ВидКонтрагента
			= Перечисления.ВидыКонтрагентов.ФизическоеЛицо;
		ИмяФизическогоЛица = Выборка.ЮридическоеФизическоеЛицо
			= Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо;
		Имя = СокрЛП(?(ИмяФизическогоЛица, Выборка.ФИО, Выборка.КонтактноеЛицо));
		Результат.Вставить(Выборка.Ссылка, Новый Структура("Имя,Телефон,ФизическоеЛицо", Имя, "", ФизическоеЛицо));
	КонецЦикла;

	// Штатный API учитывает права и историю ДействуетС. Без даты он вернёт историю целиком.
	Телефоны = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъектов(
		Ссылки, Перечисления.ТипыКонтактнойИнформации.Телефон, Неопределено, ТекущаяДатаСеанса());
	Для Каждого СтрокаТелефона Из Телефоны Цикл
		Данные = Результат.Получить(СтрокаТелефона.Объект);
		Если Данные = Неопределено Или Не ПустаяСтрока(Данные.Телефон) Тогда Продолжить; КонецЕсли;
		// При нескольких номерах используем первый непустой в штатном порядке строк.
		Данные.Телефон = СокрЛП(СтрокаТелефона.Представление);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ДанныеКонтрагента(Контрагент) Экспорт

	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Новый Структура("Имя,Телефон,ФизическоеЛицо", "", "", Ложь);
	КонецЕсли;
	Контрагенты = Новый Массив;
	Контрагенты.Добавить(Контрагент);
	Данные = ДанныеКонтрагентов(Контрагенты).Получить(Контрагент);
	Если Данные = Неопределено Тогда ВызватьИсключение "Не удалось прочитать контактные данные контрагента."; КонецЕсли;
	Возврат Данные;

КонецФункции

Процедура ДобавитьПолеТелефона(Форма, ИмяПоляКонтрагента) Экспорт

	Если Форма.Элементы.Найти("АС_ТелефонКонтрагента") <> Неопределено Тогда Возврат; КонецЕсли;
	Реквизиты = Новый Массив;
	Реквизиты.Добавить(Новый РеквизитФормы("АС_ТелефонКонтрагента", Новый ОписаниеТипов("Строка")));
	Форма.ИзменитьРеквизиты(Реквизиты);
	ГруппаКонтрагента = Форма.Элементы[ИмяПоляКонтрагента].Родитель;
	Родитель = ГруппаКонтрагента.Родитель;
	СледующийЭлемент = Неопределено;
	НайденаГруппа = Ложь;
	Для Каждого Элемент Из Родитель.ПодчиненныеЭлементы Цикл
		Если НайденаГруппа Тогда СледующийЭлемент = Элемент; Прервать; КонецЕсли;
		Если Элемент = ГруппаКонтрагента Тогда НайденаГруппа = Истина; КонецЕсли;
	КонецЦикла;
	Поле = Форма.Элементы.Вставить("АС_ТелефонКонтрагента", Тип("ПолеФормы"), Родитель, СледующийЭлемент);
	Поле.Вид = ВидПоляФормы.ПолеВвода;
	Поле.ПутьКДанным = "АС_ТелефонКонтрагента";
	Поле.Заголовок = "Телефон контрагента";
	Поле.ТолькоПросмотр = Истина;
	Поле.Подсказка = "Актуальный телефон из карточки контрагента. Измените телефон в карточке контрагента.";

КонецПроцедуры
