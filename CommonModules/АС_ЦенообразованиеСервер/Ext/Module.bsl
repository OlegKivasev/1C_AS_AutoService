Функция ВидЦенКонтрагента(Контрагент) Экспорт

	Если ТипЗнч(Контрагент) <> Тип("СправочникСсылка.Контрагенты")
		Или Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат ПредопределенноеЗначение("Справочник.ВидыЦен.ПустаяСсылка");
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|    ВидыЦенКонтрагентов.ВидЦен КАК ВидЦен
	|ИЗ
	|    РегистрСведений.АС_ВидыЦенКонтрагентов КАК ВидыЦенКонтрагентов
	|ГДЕ
	|    ВидыЦенКонтрагентов.Контрагент = &Контрагент
	|    И НЕ ВидыЦенКонтрагентов.ВидЦен.ПометкаУдаления";
	Запрос.УстановитьПараметр("Контрагент", Контрагент);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ВидЦен;
	КонецЕсли;

	Возврат ПредопределенноеЗначение("Справочник.ВидыЦен.ПустаяСсылка");

КонецФункции

Функция НастройкиРежимаОплаты() Экспорт

	Настройки = ЗагрузитьОбщиеНастройкиОплаты();
	Если ТипЗнч(Настройки) = Тип("Структура") Тогда
		Возврат Настройки;
	КонецЕсли;
	НаличныйВидЦен = Справочники.ВидыЦен.ПолучитьОсновнойВидЦенПродажи();
	БезналичныйВидЦен = Константы.АС_ОсновнойВидЦенБезналичногоРасчета.Получить();
	Если Не ЗначениеЗаполнено(БезналичныйВидЦен) Тогда
		БезналичныйВидЦен = ЗагрузитьОбщиеНастройкиОплаты(Истина);
	КонецЕсли;
	Возврат Новый Структура("НаличныйВидЦен,БезналичныйВидЦен,СкидкаНаличные,СкидкаКарта",
		НаличныйВидЦен, БезналичныйВидЦен, 20, 23);

КонецФункции

// Общие настройки читает любой продавец, изменяет только администратор.
// Повышение прав ограничено чтением двух фиксированных ключей расширения.
Функция ЗагрузитьОбщиеНастройкиОплаты(ОсновнойВидЦен = Ложь)

	БылПривилегированныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Если ОсновнойВидЦен Тогда
			Результат = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
				"АС_ВидыЦен", "ОсновнойВидЦенБезналичногоРасчета", , , "");
		Иначе
			Результат = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
				"АС_РежимОплаты", "Настройки", , , "");
		КонецЕсли;
	Исключение
		УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
	Возврат Результат;

КонецФункции

Функция ВидЦенРежимаОплаты(Наличные) Экспорт

	Настройки = НастройкиРежимаОплаты();
	Возврат ?(Наличные, Настройки.НаличныйВидЦен, Настройки.БезналичныйВидЦен);

КонецФункции

Процедура СохранитьНастройкиРежимаОплаты(Настройки) Экспорт

	Если Не Пользователи.ЭтоПолноправныйПользователь() Тогда
		ВызватьИсключение "Настройки цен и разрешённых скидок может менять только администратор.";
	КонецЕсли;
	Для Каждого Имя Из СтрРазделить("НаличныйВидЦен,БезналичныйВидЦен", ",") Цикл
		ВидЦен = Настройки[Имя];
		Если ТипЗнч(ВидЦен) <> Тип("СправочникСсылка.ВидыЦен")
			Или Не ЗначениеЗаполнено(ВидЦен) Или ВидЦен.ПометкаУдаления Тогда
			ВызватьИсключение "Выберите действующий вид цен для наличных и карты.";
		КонецЕсли;
	КонецЦикла;
	Если Настройки.НаличныйВидЦен.ВалютаЦены <> Настройки.БезналичныйВидЦен.ВалютаЦены Тогда
		ВызватьИсключение "Для наличных и карты выберите виды цен в одной валюте.";
	КонецЕсли;
	Для Каждого Имя Из СтрРазделить("СкидкаНаличные,СкидкаКарта", ",") Цикл
		Если ТипЗнч(Настройки[Имя]) <> Тип("Число")
			Или Настройки[Имя] < 0 Или Настройки[Имя] > 100 Тогда
			ВызватьИсключение "Разрешённая скидка должна быть от 0 до 100%.";
		КонецЕсли;
	КонецЦикла;
	Сохраняемые = Новый Структура("НаличныйВидЦен,БезналичныйВидЦен,СкидкаНаличные,СкидкаКарта");
	ЗаполнитьЗначенияСвойств(Сохраняемые, Настройки);
	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("АС_РежимОплаты", "Настройки", Сохраняемые, , "");

КонецПроцедуры

Функция ОшибкаСкидокРежимаОплаты(Таблица, Предел, ЭтоРМК = Ложь) Экспорт

	Если Пользователи.ЭтоПолноправныйПользователь() Тогда
		Возврат "";
	КонецЕсли;
	Для Каждого СтрокаТовара Из Таблица Цикл
		Если АС_РежимОплатыКлиентСервер.СкидкаПревышаетПредел(СтрокаТовара, Предел, ЭтоРМК) Тогда
			Возврат СтрШаблон("Скидка превышает разрешённые %1%%. Пересчитайте документ.", Предел);
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Процедура ОбновитьПараметрыЦенКаталогаРМК(Форма) Экспорт

	Если Форма.ЭтоЧекКоррекции
		Или Не ОбщегоНазначенияРМК.ЭтоВидОперацииПродажа(Форма.Объект.ВидОперации) Тогда
		Возврат;
	КонецЕсли;
	// Цена, возвращённая выбором из списка, заменяет шаблон строки чека.
	// Поэтому каталог должен использовать тот же вид цен, что сканер и чек.
	Форма.СписокТоваров.Параметры.УстановитьЗначениеПараметра("ВидЦены", Форма.РозничныйВидЦены);
	Форма.СписокТоваров.Параметры.УстановитьЗначениеПараметра("Дата", ТекущаяДатаСеанса());

КонецПроцедуры

// В копию входят и постоянные реквизиты, и служебные колонки формы.
// Массив структур не содержит ссылок на изменяемые строки исходной формы.
Функция КопииСтрокДляРежимаОплаты(Таблица, РеквизитыТаблицы, ДополнительныеКолонки) Экспорт

	Имена = СтрРазделить(ДополнительныеКолонки, ",", Ложь);
	Для Каждого Реквизит Из РеквизитыТаблицы Цикл
		Если Имена.Найти(Реквизит.Имя) = Неопределено Тогда
			Имена.Добавить(Реквизит.Имя);
		КонецЕсли;
	КонецЦикла;
	Результат = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Копия = Новый Структура;
		Для Каждого Имя Из Имена Цикл
			Если СтрокаТаблицы.Свойство(Имя) Тогда
				Копия.Вставить(Имя, СтрокаТаблицы[Имя]);
			КонецЕсли;
		КонецЦикла;
		Результат.Добавить(Копия);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Исключение действует только для заказ-наряда и именно юридического лица.
Функция ТолькоБезналичнаяОплатаЗаказНаряда(ВидОперации, Контрагент) Экспорт

	Если ВидОперации <> Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаряд
		Или Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контрагент, "ВидКонтрагента")
		= Перечисления.ВидыКонтрагентов.ЮридическоеЛицо;

КонецФункции

// Цена закупки хранится в строке заказа и остаётся основанием для обоих режимов.
// Проценты и формулы берутся из выбранного вида цен, без фиксированных +5% к продаже.
Функция ЦенаПоЦенеПоставщика(ЦенаПоставщика, Номенклатура, ВидЦен,
	Характеристика = Неопределено, КонтекстОбновления = Неопределено) Экспорт

	Если Характеристика = Неопределено Тогда
		Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	КонецЕсли;
	ДатаРасчета = ТекущаяДатаСеанса();
	Если КонтекстОбновления <> Неопределено Тогда ДатаРасчета = КонтекстОбновления.Дата; КонецЕсли;
	Если КонтекстОбновления <> Неопределено Тогда
		Ключ = ЗначениеВСтрокуВнутр(Новый Структура("ЦенаПоставщика,Номенклатура,ВидЦен,Характеристика,Дата",
			ЦенаПоставщика, Номенклатура, ВидЦен, Характеристика, ДатаРасчета));
		СохраненнаяЦена = КонтекстОбновления.ПоставочныеЦены.Получить(Ключ);
		Если СохраненнаяЦена <> Неопределено Тогда
			КонтекстОбновления.ПовторовЦен = КонтекстОбновления.ПовторовЦен + 1;
			Возврат СохраненнаяЦена;
		КонецЕсли;
	КонецЕсли;
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	// Кеш рекурсивной цепочки остаётся отдельным для каждого товара.
	Контекст = Новый Структура("ЦенаПоставщика,Номенклатура,Характеристика,Дата,Цепочка,Цены,Обновление",
		ЦенаПоставщика, Номенклатура, Характеристика, ДатаРасчета, Новый Массив, Новый Соответствие, КонтекстОбновления);
	// Копейки отбрасываем только после всей цепочки наценок, без округления вверх.
	Цена = Цел(РассчитатьВидЦенОтПоставщика(ВидЦен, Контекст));
	Если КонтекстОбновления <> Неопределено Тогда
		КонтекстОбновления.ПоставочныеЦены.Вставить(Ключ, Цена);
		КонтекстОбновления.МсПоставочныхЦен = КонтекстОбновления.МсПоставочныхЦен + ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
	КонецЕсли;
	Возврат Цена;

КонецФункции

Функция РассчитатьВидЦенОтПоставщика(ВидЦен, Контекст)

	Если Не ЗначениеЗаполнено(ВидЦен) Тогда
		ВызватьИсключение "Не указан вид цен для расчёта от цены поставщика.";
	КонецЕсли;
	Цена = Контекст.Цены.Получить(ВидЦен);
	Если Цена <> Неопределено Тогда
		Возврат Цена;
	КонецЕсли;
	Если Контекст.Цепочка.Найти(ВидЦен) <> Неопределено
		Или Контекст.Цепочка.Количество() >= 100 Тогда
		ВызватьИсключение "Циклическая зависимость видов цен: " + Строка(ВидЦен) + ".";
	КонецЕсли;
	Контекст.Цепочка.Добавить(ВидЦен);
	РеквизитыТовара = Неопределено;
	Если Контекст.Обновление <> Неопределено Тогда РеквизитыТовара = Контекст.Обновление.РеквизитыНоменклатуры.Получить(Контекст.Номенклатура); КонецЕсли;
	Если РеквизитыТовара = Неопределено Тогда
		ЦеноваяГруппа = Контекст.Номенклатура.ЦеноваяГруппа;
	Иначе
		ЦеноваяГруппа = РеквизитыТовара.ЦеноваяГруппа;
	КонецЕсли;
	Правило = ПравилоВидаЦенПоставщика(ВидЦен, ЦеноваяГруппа, Контекст.Обновление);
	Если НРег(Правило.ИдентификаторФормул) = "закупочнаяцена" Тогда
		Цена = Контекст.ЦенаПоставщика;
	ИначеЕсли Правило.ТипВидаЦен = Перечисления.ТипыВидовЦен.ДинамическийПроцент Тогда
		БазоваяЦена = РассчитатьВидЦенОтПоставщика(Правило.БазовыйВидЦен, Контекст);
		Цена = БазоваяЦена + БазоваяЦена * Правило.Процент / 100;
	ИначеЕсли Правило.ТипВидаЦен = Перечисления.ТипыВидовЦен.ДинамическийФормула Тогда
		Если ПустаяСтрока(Правило.Формула) Тогда
			Цена = Контекст.ЦенаПоставщика;
		Иначе
			Цена = РассчитатьФормулуОтПоставщика(ВидЦен, Правило, Контекст);
		КонецЕсли;
	ИначеЕсли Правило.ТипВидаЦен = Перечисления.ТипыВидовЦен.Статический Тогда
		Если Контекст.Цепочка.Количество() = 1 Тогда
			// Сохраняем прежнее поведение прямого переноса без правила наценки.
			Цена = Контекст.ЦенаПоставщика;
		Иначе
			Данные = Новый Структура("Номенклатура,Характеристика,ДатаОбработки,ВалютаДокумента,"
				+ "СуммаВключаетНДС,Коэффициент,ВидЦен",
				Контекст.Номенклатура, Контекст.Характеристика, Контекст.Дата,
				ВидЦен.ВалютаЦены, ВидЦен.ЦенаВключаетНДС, 1, ВидЦен);
			Цена = ЦенаДляОбновления(Данные, Ложь, Контекст.Обновление);
		КонецЕсли;
	Иначе
		ВызватьИсключение "Вид цен не поддерживает расчёт от цены поставщика: " + Строка(ВидЦен) + ".";
	КонецЕсли;
	Контекст.Цепочка.Удалить(Контекст.Цепочка.Количество() - 1);
	Контекст.Цены.Вставить(ВидЦен, Цена);
	Возврат Цена;

КонецФункции

Функция ПравилоВидаЦенПоставщика(ВидЦен, ЦеноваяГруппа, КонтекстОбновления = Неопределено)

	Если КонтекстОбновления <> Неопределено Тогда
		Ключ = ЗначениеВСтрокуВнутр(Новый Структура("ВидЦен,ЦеноваяГруппа", ВидЦен, ЦеноваяГруппа));
		Правило = КонтекстОбновления.Правила.Получить(Ключ);
		Если Правило <> Неопределено Тогда Возврат Правило; КонецЕсли;
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|   ВидыЦен.ТипВидаЦен КАК ТипВидаЦен,
		|   ВидыЦен.ИдентификаторФормул КАК ИдентификаторФормул,
		|   ВЫБОР КОГДА УсловияПоЦеновымГруппам.Формула ЕСТЬ NULL
		|       ТОГДА ВидыЦен.Формула
		|       ИНАЧЕ УсловияПоЦеновымГруппам.Формула КОНЕЦ КАК Формула,
		|   ВЫБОР КОГДА УсловияПоЦеновымГруппам.БазовыйВидЦен ЕСТЬ NULL
		|       ИЛИ УсловияПоЦеновымГруппам.БазовыйВидЦен = ЗНАЧЕНИЕ(Справочник.ВидыЦен.ПустаяСсылка)
		|       ТОГДА ВидыЦен.БазовыйВидЦен
		|       ИНАЧЕ УсловияПоЦеновымГруппам.БазовыйВидЦен КОНЕЦ КАК БазовыйВидЦен,
		|   ВЫБОР КОГДА УсловияПоЦеновымГруппам.БазовыйВидЦен ЕСТЬ NULL
		|       ИЛИ УсловияПоЦеновымГруппам.БазовыйВидЦен = ЗНАЧЕНИЕ(Справочник.ВидыЦен.ПустаяСсылка)
		|       ТОГДА ВидыЦен.Процент
		|       ИНАЧЕ УсловияПоЦеновымГруппам.Процент КОНЕЦ КАК Процент
		|ИЗ
		|   Справочник.ВидыЦен КАК ВидыЦен
		|       ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыЦен.ЦеновыеГруппы КАК УсловияПоЦеновымГруппам
		|       ПО УсловияПоЦеновымГруппам.Ссылка = ВидыЦен.Ссылка
		|           И УсловияПоЦеновымГруппам.ЦеноваяГруппа = &ЦеноваяГруппа
		|           И (ВидыЦен.ТипВидаЦен <> ЗНАЧЕНИЕ(Перечисление.ТипыВидовЦен.ДинамическийФормула)
		|               ИЛИ УсловияПоЦеновымГруппам.БазовыйВидЦен = ЗНАЧЕНИЕ(Справочник.ВидыЦен.ПустаяСсылка))
		|ГДЕ ВидыЦен.Ссылка = &ВидЦен");
	Запрос.УстановитьПараметр("ВидЦен", ВидЦен);
	Запрос.УстановитьПараметр("ЦеноваяГруппа", ЦеноваяГруппа);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение "Не найден вид цен для расчёта от цены поставщика.";
	КонецЕсли;
	Правило = Новый Структура("ТипВидаЦен,ИдентификаторФормул,Формула,БазовыйВидЦен,Процент",
		Выборка.ТипВидаЦен, Выборка.ИдентификаторФормул, Выборка.Формула, Выборка.БазовыйВидЦен, Выборка.Процент);
	Если КонтекстОбновления <> Неопределено Тогда
		КонтекстОбновления.Правила.Вставить(Ключ, Правило);
		КонтекстОбновления.ЧтенийПравил = КонтекстОбновления.ЧтенийПравил + 1;
	КонецЕсли;
	Возврат Правило;

КонецФункции

Функция РассчитатьФормулуОтПоставщика(ВидЦен, Правило, Контекст)

	ТаблицаОперандов = Неопределено;
	Если Контекст.Обновление <> Неопределено Тогда
		КлючОперандов = ЗначениеВСтрокуВнутр(Новый Структура("Дата,Формула", Контекст.Дата, Правило.Формула));
		ТаблицаОперандов = Контекст.Обновление.Операнды.Получить(КлючОперандов);
	КонецЕсли;
	Если ТаблицаОперандов = Неопределено Тогда
		ТаблицаОперандов = ЦенообразованиеФормулыСервер.ПолучитьТаблицуОперандовФормулы(
			Контекст.Дата, Правило.Формула);
		Если Контекст.Обновление <> Неопределено Тогда
			Контекст.Обновление.Операнды.Вставить(КлючОперандов, ТаблицаОперандов);
		КонецЕсли;
	КонецЕсли;
	ФормулаСтрокой = Правило.Формула;
	Если Найти(ФормулаСтрокой, "#ЕСЛИ") > 0 Тогда
		ФормулаСтрокой = СтрЗаменить(ФормулаСтрокой, "#ЕСЛИ", "?(");
		ФормулаСтрокой = СтрЗаменить(ФормулаСтрокой, "#ТОГДА", ",");
		ФормулаСтрокой = СтрЗаменить(ФормулаСтрокой, "#ИНАЧЕ", ",");
		ФормулаСтрокой = СтрЗаменить(ФормулаСтрокой, "#КОНЕЦЕСЛИ", ")");
		ФормулаСтрокой = СтрЗаменить(ФормулаСтрокой, Символы.ПС, "");
	КонецЕсли;

	КурсВалюты = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВидЦен.ВалютаЦены, Контекст.Дата);
	Курс = ?(ЗначениеЗаполнено(КурсВалюты.Курс), КурсВалюты.Курс, 1);
	Кратность = ?(ЗначениеЗаполнено(КурсВалюты.Кратность), КурсВалюты.Кратность, 1);
	Значения = Новый Массив;
	Для Каждого Операнд Из ТаблицаОперандов Цикл
		Если Операнд.ЭтоЦеныНоменклатуры <> Истина Или Не ЗначениеЗаполнено(Операнд.ВидЦен) Тогда
			ВызватьИсключение "Нельзя рассчитать от цены поставщика операнд " + Операнд.Операнд + ".";
		КонецЕсли;
		Если Операнд.Операнд = "[Закупочнаяцена]" Тогда
			ЦенаОперанда = Контекст.ЦенаПоставщика;
		Иначе
			ЦенаОперанда = РассчитатьВидЦенОтПоставщика(Операнд.ВидЦен, Контекст);
		КонецЕсли;
		// Курс и кратность исходных поставочных цен равны 1, как при штатном расчёте.
		Значения.Добавить(ЦенаОперанда * Кратность / Курс);
		ФормулаСтрокой = СтрЗаменить(ФормулаСтрокой, Операнд.Операнд,
			"(Параметры.Значения[" + Строка(Значения.Количество() - 1) + "])");
	КонецЦикла;

	// Штатный расчёт коллекции округляет по виду цен. Здесь сохраняем точность
	// операндов и результата, чтобы отбросить копейки только после всей наценки.
	Цена = ОбщегоНазначения.ВычислитьВБезопасномРежиме(
		ФормулаСтрокой, Новый Структура("Значения", Значения));
	Если ТипЗнч(Цена) <> Тип("Число") Тогда
		ВызватьИсключение "Формула вида цен должна возвращать число: " + Строка(ВидЦен) + ".";
	КонецЕсли;
	Возврат Цена;

КонецФункции

Функция ПодготовитьЦеныРежимаОплаты(Объект, ВидЦен, КонтекстОбновления = Неопределено) Экспорт

	Результат = Новый Структура("Ошибка,Цены,СуммаВключаетНДС", "", Новый Массив, ВидЦен.ЦенаВключаетНДС);
	Для Каждого СтрокаТовара Из Объект.Запасы Цикл
		Цена = Неопределено;
		Если Не СтрокаТовара.ЭтоРазделитель И СтрокаТовара.Отменен = 0
			И СтрокаТовара.ТипНоменклатурыЗапас
			И ТипЗнч(СтрокаТовара.Номенклатура) = Тип("СправочникСсылка.Номенклатура")
			И ЗначениеЗаполнено(СтрокаТовара.Номенклатура) Тогда
			Если СтрокаТовара.АС_ЦенаИзЗаказаПоставщика И СтрокаТовара.АС_ИсходнаяЦенаЗаказаПоставщика > 0 Тогда
				Попытка
					Цена = ЦенаПоЦенеПоставщика(
						СтрокаТовара.АС_ИсходнаяЦенаЗаказаПоставщика, СтрокаТовара.Номенклатура,
						ВидЦен, СтрокаТовара.Характеристика, КонтекстОбновления);
				Исключение
					Результат.Ошибка = СтрШаблон("Не удалось пересчитать цену %1. Режим оплаты не изменён. %2",
						СтрокаТовара.Номенклатура, ОписаниеОшибки());
					Возврат Результат;
				КонецПопытки;
			Иначе
				ДатаРасчета = ТекущаяДатаСеанса();
				Если КонтекстОбновления <> Неопределено Тогда ДатаРасчета = КонтекстОбновления.Дата; КонецЕсли;
				Данные = Новый Структура("Номенклатура,Характеристика,ДатаОбработки,ВалютаДокумента,"
					+ "СуммаВключаетНДС,Коэффициент,СтавкаНДС,ВидЦен",
					СтрокаТовара.Номенклатура, СтрокаТовара.Характеристика,
					?(ЗначениеЗаполнено(Объект.Ссылка), ДатаРасчета, Объект.Дата),
					Объект.ВалютаДокумента, Результат.СуммаВключаетНДС, 1, СтрокаТовара.СтавкаНДС, ВидЦен);
				ЦенообразованиеКлиентСервер.ДополнитьСтруктуруДанныхНоменклатурыПолямиЦенообразования(
					Объект, СтрокаТовара, Данные);
				Данные.Вставить("СуммаВключаетНДС", Результат.СуммаВключаетНДС);
				Данные.Вставить("ВидЦен", ВидЦен);
				Цена = ЦенаДляОбновления(Данные, Ложь, КонтекстОбновления);
			КонецЕсли;
			Если Цена <= 0 Тогда
				Результат.Ошибка = СтрШаблон("Для %1 не найдена цена выбранного вида цен. Режим оплаты не изменён.", СтрокаТовара.Номенклатура);
				Возврат Результат;
			КонецЕсли;
		КонецЕсли;
		Результат.Цены.Добавить(Цена);
	КонецЦикла;
	Возврат Результат;

КонецФункции


// Создаётся заново для одного ручного обновления и никуда не сохраняется.
Функция КонтекстЦенОбновления() Экспорт
	Контекст = Новый Структура("Дата,МинимальныеЦены,Цены,ПоставочныеЦены,Правила,Операнды",
		ТекущаяДатаСеанса(), Новый Соответствие, Новый Соответствие, Новый Соответствие, Новый Соответствие, Новый Соответствие);
	Контекст.Вставить("НастройкиОплаты", Неопределено);
	Контекст.Вставить("ПакетныеЦены", Новый Соответствие);
	Контекст.Вставить("НоменклатураПакета", Новый Массив);
	Контекст.Вставить("ХарактеристикиПакета", Новый Массив);
	Контекст.Вставить("РеквизитыНоменклатуры", Новый Соответствие);
	Контекст.Вставить("МинимальныеЦеныИспользуются", ЦенообразованиеСерверПовтИсп.МинимальныеЦеныИспользуются());
	Для Каждого Имя Из СтрРазделить("МсМинимальныхЦен,МсОбычныхЦен,МсПоставочныхЦен,МсКопий,МсПодготовкиЦен,МсАрифметики,ПовторовЦен,ЧтенийПравил,ПропущеноОплаченных,МсПакетныхЦен,ЗапросовПакетныхЦен,ЦенИзПакета,ШтатныхВызововЦен", ",") Цикл
		Контекст.Вставить(Имя, 0);
	КонецЦикла;
	Возврат Контекст;
КонецФункции

Функция ЦенаДляОбновления(Данные, МинимальнаяЦена, КонтекстОбновления = Неопределено) Экспорт
	Если КонтекстОбновления <> Неопределено Тогда
		Ключ = ЗначениеВСтрокуВнутр(Данные);
		Цены = ?(МинимальнаяЦена, КонтекстОбновления.МинимальныеЦены, КонтекстОбновления.Цены);
		СохраненнаяЦена = Цены.Получить(Ключ);
		Если СохраненнаяЦена <> Неопределено Тогда
			КонтекстОбновления.ПовторовЦен = КонтекстОбновления.ПовторовЦен + 1;
			Возврат СохраненнаяЦена;
		КонецЕсли;
	КонецЕсли;
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Если МинимальнаяЦена Тогда
		Цена = ЦенообразованиеСервер.ПолучитьМинимальнуюЦенуНоменклатуры(Данные);
	Иначе
		Цена = ЦенаИзПакетнойВыборки(Данные, КонтекстОбновления);
		Если Цена = Неопределено Тогда
			Если КонтекстОбновления <> Неопределено Тогда КонтекстОбновления.ШтатныхВызововЦен = КонтекстОбновления.ШтатныхВызововЦен + 1; КонецЕсли;
			Цена = ЦенообразованиеСервер.ПолучитьЦенуНоменклатурыПоВидуЦен(Данные);
		КонецЕсли;
	КонецЕсли;
	Если КонтекстОбновления <> Неопределено Тогда
		Цены.Вставить(Ключ, Цена);
		ИмяЗамера = ?(МинимальнаяЦена, "МсМинимальныхЦен", "МсОбычныхЦен");
		КонтекстОбновления[ИмяЗамера] = КонтекстОбновления[ИмяЗамера] + ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
	КонецЕсли;
	Возврат Цена;
КонецФункции


// Быстрый путь действует только в снимке ручного обновления. Особые случаи
// возвращают Неопределено и обрабатываются исходным штатным методом.
Функция ЦенаИзПакетнойВыборки(Данные, Контекст)
	Если Контекст = Неопределено Тогда Возврат Неопределено; КонецЕсли;
	Если Контекст.МинимальныеЦеныИспользуются Или Данные.Свойство("ДокументУстановкаЦен")
		Или (Данные.Свойство("ЭтоНовыйОбъект") И Данные.ЭтоНовыйОбъект)
		Или (Данные.Свойство("Коэффициент") И Данные.Коэффициент <> 1) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Не Данные.Свойство("ВидЦен") Или ТипЗнч(Данные.ВидЦен) <> Тип("СправочникСсылка.ВидыЦен")
		Или Не ЗначениеЗаполнено(Данные.ВидЦен) Или Не Данные.Свойство("ВалютаДокумента")
		Или ТипЗнч(Данные.ВалютаДокумента) <> Тип("СправочникСсылка.Валюты")
		Или Не ЗначениеЗаполнено(Данные.ВалютаДокумента) Тогда
		Возврат Неопределено;
	КонецЕсли;
	РеквизитыТовара = Контекст.РеквизитыНоменклатуры.Получить(Данные.Номенклатура);
	Если РеквизитыТовара = Неопределено
		Или РеквизитыТовара.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.ПодарочныйСертификат Тогда
		Возврат Неопределено;
	КонецЕсли;
	Характеристика = Данные.Характеристика;
	Если Характеристика = Неопределено Тогда Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка(); КонецЕсли;
	Если Контекст.ХарактеристикиПакета.Найти(Характеристика) = Неопределено Тогда Возврат Неопределено; КонецЕсли;
	// Дата не урезается до дня: разные даты и валюты получают разные выборки.
	Параметры = Новый Структура("Дата,Валюта,ВидЦен", Данные.ДатаОбработки, Данные.ВалютаДокумента, Данные.ВидЦен);
	КлючГруппы = ЗначениеВСтрокуВнутр(Параметры);
	Группа = Контекст.ПакетныеЦены.Получить(КлючГруппы);
	Если Группа = Неопределено Тогда
		Если Контекст.ПакетныеЦены.Количество() >= 8 Тогда Возврат Неопределено; КонецЕсли;
		Группа = ПрочитатьПакетОбычныхЦен(Параметры, Контекст);
		Контекст.ПакетныеЦены.Вставить(КлючГруппы, Группа);
	КонецЕсли;
	КлючТовара = КлючТовараПакетнойЦены(Данные.Номенклатура, Характеристика);
	СтрокаЦены = Группа.Цены.Получить(КлючТовара);
	Если СтрокаЦены <> Неопределено И (СтрокаЦены.Неоднозначно Или СтрокаЦены.НуженШтатныйРасчет) Тогда Возврат Неопределено; КонецЕсли;
	Контекст.ЦенИзПакета = Контекст.ЦенИзПакета + 1;
	// Как штатный метод при отсутствии цены и выключенных минимальных ценах.
	Если СтрокаЦены = Неопределено Тогда Возврат 0; КонецЕсли;
	Цена = СтрокаЦены.Цена;
	Если Данные.Свойство("СуммаВключаетНДС")
		И ((Данные.СуммаВключаетНДС И Не СтрокаЦены.ЦенаВключаетНДС)
			Или (Не Данные.СуммаВключаетНДС И СтрокаЦены.ЦенаВключаетНДС))
		И Данные.Свойство("СтавкаНДС") И ЗначениеЗаполнено(Данные.СтавкаНДС) Тогда
		Цена = ЦенообразованиеСервер.ПересчитатьСуммуПриИзмененииФлаговНДС(
			Цена, Данные.СуммаВключаетНДС, Данные.СтавкаНДС);
	КонецЕсли;
	Цена = ЦенообразованиеСервер.ОкруглитьЦену(Цена, СтрокаЦены.ТочностьОкругления, СтрокаЦены.ОкруглятьВБольшуюСторону);
	Возврат ЦенообразованиеКлиентСервер.ПрименитьПсихологическоеОкругление(Цена, Группа.ПсихологическоеОкругление);
КонецФункции

Функция КлючТовараПакетнойЦены(Номенклатура, Характеристика)
	Возврат ЗначениеВСтрокуВнутр(Новый Структура("Номенклатура,Характеристика", Номенклатура, Характеристика));
КонецФункции

Функция ПрочитатьПакетОбычныхЦен(Параметры, Контекст)
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Запрос = Новый Запрос(ТекстЗапросаПакетныхЦен());
	Запрос.УстановитьПараметр("ДатаОбработки", Параметры.Дата);
	Запрос.УстановитьПараметр("ВалютаДокумента", Параметры.Валюта);
	Запрос.УстановитьПараметр("ВидЦен", Параметры.ВидЦен);
	Запрос.УстановитьПараметр("Коэффициент", 1);
	Запрос.УстановитьПараметр("Номенклатура", Контекст.НоменклатураПакета);
	Запрос.УстановитьПараметр("Характеристика", Контекст.ХарактеристикиПакета);
	Группа = Новый Структура("Цены,ПсихологическоеОкругление", Новый Соответствие,
		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.ВидЦен, "ПсихологическоеОкругление"));
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключ = КлючТовараПакетнойЦены(Выборка.Номенклатура, Выборка.Характеристика);
		Сохраненная = Группа.Цены.Получить(Ключ);
		Если Сохраненная = Неопределено Тогда
			Сохраненная = Новый Структура("Цена,ЦенаВключаетНДС,ТочностьОкругления,ОкруглятьВБольшуюСторону,НижняяГраницаДиапазонаЦен,НуженШтатныйРасчет,Неоднозначно");
			ЗаполнитьЗначенияСвойств(Сохраненная, Выборка);
			Сохраненная.Неоднозначно = Ложь;
			Группа.Цены.Вставить(Ключ, Сохраненная);
		ИначеЕсли ЗначениеВСтрокуВнутр(Сохраненная.НижняяГраницаДиапазонаЦен)
			= ЗначениеВСтрокуВнутр(Выборка.НижняяГраницаДиапазонаЦен) Тогда
			// При одинаковых верхних границах штатный ПЕРВЫЕ 1 не задаёт выбор правила.
			// Не выбираем его самостоятельно: такой товар вернётся в штатный расчёт.
			Сохраненная.Неоднозначно = Истина;
		КонецЕсли;
	КонецЦикла;
	Контекст.ЗапросовПакетныхЦен = Контекст.ЗапросовПакетныхЦен + 1;
	Контекст.МсПакетныхЦен = Контекст.МсПакетныхЦен + ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
	Возврат Группа;
КонецФункции

Функция ТекстЗапросаПакетныхЦен()
	Возврат "ВЫБРАТЬ
	|	ВидыЦенПравилаОкругленияЦены.Ссылка КАК Ссылка,
	|	ВидыЦенПравилаОкругленияЦены.ТочностьОкругления КАК ТочностьОкругления,
	|	ВидыЦенПравилаОкругленияЦены.НижняяГраницаДиапазонаЦен КАК НижняяГраницаДиапазонаЦен
	|ПОМЕСТИТЬ ПравилаОкругления
	|ИЗ
	|	Справочник.ВидыЦен.ПравилаОкругленияЦены КАК ВидыЦенПравилаОкругленияЦены
	|ГДЕ
	|	ВидыЦенПравилаОкругленияЦены.Ссылка = &ВидЦен
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР
	|		КОГДА ЦеныНоменклатурыСрезПоследних.ВалютаЦены <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|			ТОГДА ЦеныНоменклатурыСрезПоследних.ВалютаЦены
	|		ИНАЧЕ ЦеныНоменклатурыСрезПоследних.ВидЦен.ВалютаЦены
	|	КОНЕЦ КАК ЦеныНоменклатурыВалюта,
	|	ЦеныНоменклатурыСрезПоследних.ВидЦен.ЦенаВключаетНДС КАК ЦенаВключаетНДС,
	|	ЦеныНоменклатурыСрезПоследних.ВидЦен.ПорядокОкругления КАК ТочностьОкругления,
	|	ЦеныНоменклатурыСрезПоследних.ВидЦен.ОкруглятьВБольшуюСторону КАК ОкруглятьВБольшуюСторону,
	|	ВЫБОР КОГДА ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.ЕдиницаИзмерения.Коэффициент, 1) = 0
	|		ТОГДА NULL
	|	ИНАЧЕ
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(КурсВалютыВидЦен.Курс, 0) = 0
	|				ИЛИ ЕСТЬNULL(КурсВалютыВидЦен.Кратность, 0) = 0
	|				ИЛИ ЕСТЬNULL(КурсВалютыДокумента.Кратность, 0) = 0
	|				ИЛИ ЕСТЬNULL(КурсВалютыДокумента.Курс, 0) = 0
	|			ТОГДА ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0) / ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.ЕдиницаИзмерения.Коэффициент, 1)
	|		ИНАЧЕ ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0) * ЕСТЬNULL(КурсВалютыВидЦен.Курс, 1) * ЕСТЬNULL(КурсВалютыДокумента.Кратность, 1) / (ЕСТЬNULL(КурсВалютыДокумента.Курс, 1) * ЕСТЬNULL(КурсВалютыВидЦен.Кратность, 1)) * ЕСТЬNULL(&Коэффициент, 1) / ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.ЕдиницаИзмерения.Коэффициент, 1)
	|	КОНЕЦ
	|	КОНЕЦ КАК Цена,
	|	ЦеныНоменклатурыСрезПоследних.ВидЦен КАК ВидЦен,
	|	ЦеныНоменклатурыСрезПоследних.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ЦеныНоменклатурыСрезПоследних.Номенклатура КАК Номенклатура,
	|	ЦеныНоменклатурыСрезПоследних.Характеристика КАК Характеристика,
	|	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.ЕдиницаИзмерения.Коэффициент, 1) = 0 КАК НуженШтатныйРасчет
	|ПОМЕСТИТЬ ЦеныНоменклатуры
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			&ДатаОбработки,
	|			Актуальность
	|				И Номенклатура В (&Номенклатура)
	|				И Характеристика В (&Характеристика)
	|				И ВидЦен = &ВидЦен
	|				И НЕ Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.ПодарочныйСертификат)) КАК ЦеныНоменклатурыСрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(&ДатаОбработки, ) КАК КурсВалютыВидЦен
	|		ПО (ВЫБОР
	|				КОГДА ЦеныНоменклатурыСрезПоследних.ВалютаЦены <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|					ТОГДА ЦеныНоменклатурыСрезПоследних.ВалютаЦены = КурсВалютыВидЦен.Валюта
	|				ИНАЧЕ ЦеныНоменклатурыСрезПоследних.ВидЦен.ВалютаЦены = КурсВалютыВидЦен.Валюта
	|			КОНЕЦ),
	|	РегистрСведений.КурсыВалют.СрезПоследних(&ДатаОбработки, Валюта = &ВалютаДокумента) КАК КурсВалютыДокумента
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&ВалютаДокумента,
	|	ИСТИНА,
	|	ЗНАЧЕНИЕ(Перечисление.ПорядкиОкругления.Окр0_01),
	|	ЛОЖЬ,
	|	Номенклатура.Номинал,
	|	&ВидЦен,
	|	ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка),
	|	Номенклатура.Ссылка,
	|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка),
	|	ЛОЖЬ
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка В (&Номенклатура)
	|	И Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.ПодарочныйСертификат)
	|	И ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЦеныНоменклатуры.ЦеныНоменклатурыВалюта КАК ЦеныНоменклатурыВалюта,
	|	ЦеныНоменклатуры.ЦенаВключаетНДС КАК ЦенаВключаетНДС,
	|	ЕСТЬNULL(ПравилаОкругления.ТочностьОкругления, ЦеныНоменклатуры.ТочностьОкругления) КАК ТочностьОкругления,
	|	ЦеныНоменклатуры.ОкруглятьВБольшуюСторону КАК ОкруглятьВБольшуюСторону,
	|	ЦеныНоменклатуры.Цена КАК Цена,
	|	ПравилаОкругления.НижняяГраницаДиапазонаЦен КАК НижняяГраницаДиапазонаЦен,
	|	ЦеныНоменклатуры.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ЦеныНоменклатуры.Номенклатура КАК Номенклатура,
	|	ЦеныНоменклатуры.Характеристика КАК Характеристика,
	|	ЦеныНоменклатуры.НуженШтатныйРасчет КАК НуженШтатныйРасчет
	|ИЗ
	|	ЦеныНоменклатуры КАК ЦеныНоменклатуры
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПравилаОкругления КАК ПравилаОкругления
	|		ПО ЦеныНоменклатуры.ВидЦен = ПравилаОкругления.Ссылка
	|			И ЦеныНоменклатуры.Цена >= ПравилаОкругления.НижняяГраницаДиапазонаЦен
	|
	|УПОРЯДОЧИТЬ ПО
	|	НижняяГраницаДиапазонаЦен УБЫВ";
КонецФункции
