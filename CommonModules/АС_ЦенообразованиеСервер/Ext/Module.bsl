Функция ВидЦенКонтрагента(Контрагент) Экспорт

	Если ТипЗнч(Контрагент) <> Тип("СправочникСсылка.Контрагенты")
		Или Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат ПредопределенноеЗначение("Справочник.ВидыЦен.ПустаяСсылка");
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|    ВидыЦенКонтрагентов.ВидЦен КАК ВидЦен
	|ИЗ
	|    РегистрСведений.АС_ВидыЦенКонтрагентов КАК ВидыЦенКонтрагентов
	|ГДЕ
	|    ВидыЦенКонтрагентов.Контрагент = &Контрагент
	|    И НЕ ВидыЦенКонтрагентов.ВидЦен.ПометкаУдаления";
	Запрос.УстановитьПараметр("Контрагент", Контрагент);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ВидЦен;
	КонецЕсли;

	Возврат ПредопределенноеЗначение("Справочник.ВидыЦен.ПустаяСсылка");

КонецФункции

Функция НастройкиРежимаОплаты() Экспорт

	Настройки = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("АС_РежимОплаты", "Настройки", , , "");
	Если ТипЗнч(Настройки) = Тип("Структура") Тогда
		Возврат Настройки;
	КонецЕсли;
	НаличныйВидЦен = Справочники.ВидыЦен.ПолучитьОсновнойВидЦенПродажи();
	БезналичныйВидЦен = Константы.АС_ОсновнойВидЦенБезналичногоРасчета.Получить();
	Если Не ЗначениеЗаполнено(БезналичныйВидЦен) Тогда
		БезналичныйВидЦен = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
			"АС_ВидыЦен", "ОсновнойВидЦенБезналичногоРасчета", , , "");
	КонецЕсли;
	Возврат Новый Структура("НаличныйВидЦен,БезналичныйВидЦен,СкидкаНаличные,СкидкаКарта",
		НаличныйВидЦен, БезналичныйВидЦен, 20, 23);

КонецФункции

Функция ВидЦенРежимаОплаты(Наличные) Экспорт

	Настройки = НастройкиРежимаОплаты();
	Возврат ?(Наличные, Настройки.НаличныйВидЦен, Настройки.БезналичныйВидЦен);

КонецФункции

Процедура СохранитьНастройкиРежимаОплаты(Настройки) Экспорт

	Если Не Пользователи.ЭтоПолноправныйПользователь() Тогда
		ВызватьИсключение "Настройки цен и разрешённых скидок может менять только администратор.";
	КонецЕсли;
	Для Каждого Имя Из СтрРазделить("НаличныйВидЦен,БезналичныйВидЦен", ",") Цикл
		ВидЦен = Настройки[Имя];
		Если ТипЗнч(ВидЦен) <> Тип("СправочникСсылка.ВидыЦен")
			Или Не ЗначениеЗаполнено(ВидЦен) Или ВидЦен.ПометкаУдаления Тогда
			ВызватьИсключение "Выберите действующий вид цен для наличных и карты.";
		КонецЕсли;
	КонецЦикла;
	Если Настройки.НаличныйВидЦен.ВалютаЦены <> Настройки.БезналичныйВидЦен.ВалютаЦены Тогда
		ВызватьИсключение "Для наличных и карты выберите виды цен в одной валюте.";
	КонецЕсли;
	Для Каждого Имя Из СтрРазделить("СкидкаНаличные,СкидкаКарта", ",") Цикл
		Если ТипЗнч(Настройки[Имя]) <> Тип("Число")
			Или Настройки[Имя] < 0 Или Настройки[Имя] > 100 Тогда
			ВызватьИсключение "Разрешённая скидка должна быть от 0 до 100%.";
		КонецЕсли;
	КонецЦикла;
	Сохраняемые = Новый Структура("НаличныйВидЦен,БезналичныйВидЦен,СкидкаНаличные,СкидкаКарта");
	ЗаполнитьЗначенияСвойств(Сохраняемые, Настройки);
	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("АС_РежимОплаты", "Настройки", Сохраняемые, , "");

КонецПроцедуры

Функция ОшибкаСкидокРежимаОплаты(Таблица, Предел, ЭтоРМК = Ложь) Экспорт

	Если Пользователи.ЭтоПолноправныйПользователь() Тогда
		Возврат "";
	КонецЕсли;
	Для Каждого СтрокаТовара Из Таблица Цикл
		Если АС_РежимОплатыКлиентСервер.СкидкаПревышаетПредел(СтрокаТовара, Предел, ЭтоРМК) Тогда
			Возврат СтрШаблон("Скидка превышает разрешённые %1%%. Пересчитайте документ.", Предел);
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Процедура ОбновитьПараметрыЦенКаталогаРМК(Форма) Экспорт

	Если Форма.ЭтоЧекКоррекции
		Или Не ОбщегоНазначенияРМК.ЭтоВидОперацииПродажа(Форма.Объект.ВидОперации) Тогда
		Возврат;
	КонецЕсли;
	// Цена, возвращённая выбором из списка, заменяет шаблон строки чека.
	// Поэтому каталог должен использовать тот же вид цен, что сканер и чек.
	Форма.СписокТоваров.Параметры.УстановитьЗначениеПараметра("ВидЦены", Форма.РозничныйВидЦены);
	Форма.СписокТоваров.Параметры.УстановитьЗначениеПараметра("Дата", ТекущаяДатаСеанса());

КонецПроцедуры

// В копию входят и постоянные реквизиты, и служебные колонки формы.
// Массив структур не содержит ссылок на изменяемые строки исходной формы.
Функция КопииСтрокДляРежимаОплаты(Таблица, РеквизитыТаблицы, ДополнительныеКолонки) Экспорт

	Имена = СтрРазделить(ДополнительныеКолонки, ",", Ложь);
	Для Каждого Реквизит Из РеквизитыТаблицы Цикл
		Если Имена.Найти(Реквизит.Имя) = Неопределено Тогда
			Имена.Добавить(Реквизит.Имя);
		КонецЕсли;
	КонецЦикла;
	Результат = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Копия = Новый Структура;
		Для Каждого Имя Из Имена Цикл
			Если СтрокаТаблицы.Свойство(Имя) Тогда
				Копия.Вставить(Имя, СтрокаТаблицы[Имя]);
			КонецЕсли;
		КонецЦикла;
		Результат.Добавить(Копия);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Исключение действует только для заказ-наряда и именно юридического лица.
Функция ТолькоБезналичнаяОплатаЗаказНаряда(ВидОперации, Контрагент) Экспорт

	Если ВидОперации <> Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаряд
		Или Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контрагент, "ВидКонтрагента")
		= Перечисления.ВидыКонтрагентов.ЮридическоеЛицо;

КонецФункции
