&Вместо("РассчитатьСуммыВСтрокеТЧ")
Процедура АС_РассчитатьСуммыБезЗапрещенныхСкидок(СтрокаТабличнойЧасти, ПараметрыРасчета)

	Если ТабличныеЧастиУНФКлиентСервер.АС_ЭтоСтрокаБезСкидки(СтрокаТабличнойЧасти) Тогда
		ТабличныеЧастиУНФКлиентСервер.АС_РассчитатьСтрокуБезСкидки(
			СтрокаТабличнойЧасти, ПараметрыРасчета);
	Иначе
		ПродолжитьВызов(СтрокаТабличнойЧасти, ПараметрыРасчета);
	КонецЕсли;

КонецПроцедуры

&Вместо("ПродолжитьРасчетСуммыВСтрокеТЧ")
Процедура АС_ПродолжитьРасчетБезЗапрещенныхСкидок(СтрокаТабличнойЧасти, ПараметрыРасчета, КоличествоСтроки)

	// В том числе ответ на уже открытый вопрос о распределении суммы.
	Если ТабличныеЧастиУНФКлиентСервер.АС_ЭтоСтрокаБезСкидки(СтрокаТабличнойЧасти) Тогда
		ТабличныеЧастиУНФКлиентСервер.АС_РассчитатьСтрокуБезСкидки(
			СтрокаТабличнойЧасти, ПараметрыРасчета);
	Иначе
		ПродолжитьВызов(СтрокаТабличнойЧасти, ПараметрыРасчета, КоличествоСтроки);
	КонецЕсли;

	РассчитатьЦену = Ложь;
	Наличные = Ложь;
	Если ПараметрыРасчета.Свойство("АС_ОплатаНаличными", Наличные)
		И ПараметрыРасчета.Свойство("РассчитатьЦену", РассчитатьЦену) И РассчитатьЦену Тогда
		ПрименятьНаценку = Истина;
		ПараметрыРасчета.Свойство("АС_ПрименятьНаценкуРаботы", ПрименятьНаценку);
		АС_РежимОплатыКлиентСервер.ЗапомнитьРассчитаннуюЦенуРаботы(
			СтрокаТабличнойЧасти, Наличные, ПрименятьНаценку);
	КонецЕсли;

КонецПроцедуры

// Расчёт выполняется только на независимых структурах, полученных с сервера.
// Состав документа, цены, скидки и внесённые оплаты при показе подсказки не меняются.
Функция АС_АльтернативныйИтогЗаказа(Контекст) Экспорт

	Возврат АС_РежимОплатыКлиентСервер.АС_АльтернативныйИтогЗаказа(Контекст);

КонецФункции

Функция АС_АльтернативныйИтогРМК(Контекст) Экспорт

	АС_ПрогнозРМКВосстановитьЦеныДоОкругления(Контекст);
	Контекст.Объект.ЦенаВключаетНДС = Контекст.НоваяСуммаВключаетНДС;
	Для Каждого СтрокаЧека Из Контекст.Объект.Товары Цикл
		СтрокаЧека.Цена = Окр(СтрокаЧека.АС_ЦенаДляПрогноза, 2);
		СтрокаЧека.ПроцентСкидкиНаценки = Мин(СтрокаЧека.ПроцентСкидкиНаценки, Контекст.ПределСкидки);
		БазаСкидки = СтрокаЧека.Цена * СтрокаЧека.КоличествоУпаковок;
		Если СтрокаЧека.ПроцентСкидкиНаценки <> 0 Тогда
			СтрокаЧека.СуммаСкидкиНаценки = Окр(БазаСкидки * СтрокаЧека.ПроцентСкидкиНаценки / 100, 2);
		Иначе
			СтрокаЧека.СуммаСкидкиНаценки = Мин(СтрокаЧека.СуммаСкидкиНаценки,
				Окр(БазаСкидки * Контекст.ПределСкидки / 100, 2));
		КонецЕсли;
		АС_ПересчитатьСтрокуПрогнозаРМК(
			Контекст.ФормаДляРасчетаСтроки, СтрокаЧека, , Контекст.ИспользоватьАвтоматическиеСкидки);
		АС_НДСПрогнозаРМК(Контекст.Объект, СтрокаЧека);
	КонецЦикла;
	Если Контекст.Объект.АС_ОплатаНаличными Тогда
		АС_ПрогнозРМКОкруглитьИтогИзменениемЦены(Контекст);
	КонецЕсли;
	Результат = 0;
	Для Каждого СтрокаЧека Из Контекст.Объект.Товары Цикл
		Если СтрокаЧека.АС_ВходитВИтогПрогноза И Не СтрокаЧека.ТоварКЗамене Тогда
			// Штатный итог использует сумму до скидок по количеству упаковок.
			Результат = Результат + СтрокаЧека.СуммаБезСкидки - СтрокаЧека.СуммаСкидкиНаценки
				- СтрокаЧека.СуммаАвтоматическойСкидки - СтрокаЧека.СуммаСкидкиОплатыБонусом
				+ ?(Контекст.Объект.ЦенаВключаетНДС, 0, СтрокаЧека.СуммаНДС);
		КонецЕсли;
	КонецЦикла;
	Возврат Окр(Результат, 2);

КонецФункции

Функция АС_ТекстАльтернативнойОплаты(Наличные, Итог, Оплачено = 0) Экспорт

	Текст = ?(Наличные, "Наличными: ", "Картой: ") + Формат(Итог, "ЧДЦ=2;ЧН=0,00");
	Если Оплачено > 0 Тогда
		Остаток = Окр(Итог - Оплачено, 2);
		Если Остаток < 0 Тогда
			Текст = Текст + Символы.ПС + "Переплата: " + Формат(-Остаток, "ЧДЦ=2;ЧН=0,00");
		Иначе
			Текст = Текст + Символы.ПС + "К доплате: " + Формат(Остаток, "ЧДЦ=2;ЧН=0,00");
		КонецЕсли;
	КонецЕсли;
	Возврат Текст;

КонецФункции

// Правила подбора цены и суммы совпадают с рабочим округлением форм.





















Процедура АС_ПрогнозРМКВосстановитьЦеныДоОкругления(Контекст)

	Для Каждого СтрокаЧека Из Контекст.Объект.Товары Цикл
		Если СтрокаЧека.АС_ЦенаДоОкругленияРМК <= 0 Или СтрокаЧека.Оплачена Тогда
			Продолжить;
		КонецЕсли;
		ИсходнаяЦена = СтрокаЧека.АС_ЦенаДоОкругленияРМК;
		ОкругленнаяЦена = СтрокаЧека.АС_ЦенаПослеОкругленияРМК;
		ИсходнаяСумма = СтрокаЧека.АС_СуммаДоОкругленияРМК;
		ИсходнаяСкидка = СтрокаЧека.АС_СкидкаДоОкругленияРМК;
		ИсходныйПроцентСкидки = СтрокаЧека.АС_ПроцентСкидкиДоОкругленияРМК;
		КоличествоНеИзменено = СтрокаЧека.АС_КоличествоПриОкругленииРМК = 0
			Или (СтрокаЧека.Количество = СтрокаЧека.АС_КоличествоПриОкругленииРМК
				И СтрокаЧека.КоличествоУпаковок = СтрокаЧека.АС_УпаковокПриОкругленииРМК);
		СуммаНеИзменена = СтрокаЧека.АС_КоличествоПриОкругленииРМК > 0
			И КоличествоНеИзменено
			И СтрокаЧека.Сумма = СтрокаЧека.АС_СуммаПослеОкругленияРМК;
		СкидкаНеИзменена = СтрокаЧека.СуммаСкидкиНаценки = СтрокаЧека.АС_СкидкаПослеОкругленияРМК
			И СтрокаЧека.ПроцентСкидкиНаценки = СтрокаЧека.АС_ПроцентСкидкиПослеОкругленияРМК;
		Если СтрокаЧека.Цена = ОкругленнаяЦена И СкидкаНеИзменена Тогда
			СтрокаЧека.СуммаСкидкиНаценки = СтрокаЧека.АС_СкидкаДоОкругленияРМК;
			СтрокаЧека.ПроцентСкидкиНаценки = СтрокаЧека.АС_ПроцентСкидкиДоОкругленияРМК;
		КонецЕсли;
		СтрокаЧека.АС_ЦенаДоОкругленияРМК = 0;
		СтрокаЧека.АС_ЦенаПослеОкругленияРМК = 0;
		СтрокаЧека.АС_СкидкаДоОкругленияРМК = 0;
		СтрокаЧека.АС_СкидкаПослеОкругленияРМК = 0;
		СтрокаЧека.АС_ПроцентСкидкиДоОкругленияРМК = 0;
		СтрокаЧека.АС_ПроцентСкидкиПослеОкругленияРМК = 0;
		СтрокаЧека.АС_СуммаДоОкругленияРМК = 0;
		СтрокаЧека.АС_СуммаПослеОкругленияРМК = 0;
		СтрокаЧека.АС_КоличествоПриОкругленииРМК = 0;
		СтрокаЧека.АС_УпаковокПриОкругленииРМК = 0;
		// Введённая вручную или полученная по виду цен цена становится новой исходной.
		Если СтрокаЧека.Цена <> ОкругленнаяЦена Тогда
			Продолжить;
		КонецЕсли;
		СтрокаЧека.Цена = ИсходнаяЦена;
		Если Не СтрокаЧека.Подарок Тогда
			ИсходнаяАвтоСкидка = СтрокаЧека.СуммаАвтоматическойСкидки;
			ИсходнаяБонуснаяСкидка = СтрокаЧека.СуммаСкидкиОплатыБонусом;
			АС_ПрогнозРМКРассчитатьСтрокуПриОкруглении(Контекст, СтрокаЧека, СкидкаНеИзменена И КоличествоНеИзменено);
			Если СкидкаНеИзменена И КоличествоНеИзменено
				И СтрокаЧека.СуммаСкидкиНаценки = ИсходнаяСкидка Тогда
				// Не выводим исходный процент заново из округлённой денежной скидки:
				// при дробном количестве это превращало, например, 20% в 20,02%.
				СтрокаЧека.ПроцентСкидкиНаценки = ИсходныйПроцентСкидки;
				Если СуммаНеИзменена
					И АС_ПрогнозРМКСуммаСтрокиНеНижеМинимальной(Контекст, СтрокаЧека, ИсходнаяСумма)
					И СтрокаЧека.СуммаАвтоматическойСкидки = ИсходнаяАвтоСкидка
					И СтрокаЧека.СуммаСкидкиОплатыБонусом = ИсходнаяБонуснаяСкидка Тогда
					// Сохраняем точный ручной ввод суммы, если скидки не урезаны минимумом.
					СтрокаЧека.Сумма = ИсходнаяСумма;
					АС_ПрогнозРМКСогласоватьСуммыСтроки(Контекст, СтрокаЧека);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура АС_ПрогнозРМКРассчитатьСтрокуПриОкруглении(Контекст, СтрокаЧека, СохранитьСуммуСкидки = Неопределено)

	СуммаБезСкидки = Окр(АС_ПрогнозРМКСуммаБезСкидкиСтроки(Контекст, СтрокаЧека), 2);
	Если СохранитьСуммуСкидки = Неопределено Тогда
		СохранитьСуммуСкидки = СтрокаЧека.ПроцентСкидкиНаценки = 0;
		Если СуммаБезСкидки > 0 Тогда
			СохранитьСуммуСкидки = СохранитьСуммуСкидки
				Или Окр(СтрокаЧека.СуммаСкидкиНаценки / СуммаБезСкидки * 100, 2)
					= СтрокаЧека.ПроцентСкидкиНаценки;
		КонецЕсли;
	КонецЕсли;
	Если Не СохранитьСуммуСкидки Тогда
		СтрокаЧека.СуммаСкидкиНаценки = Окр(СуммаБезСкидки * СтрокаЧека.ПроцентСкидкиНаценки / 100, 2);
	КонецЕсли;
	СтрокаЧека.Сумма = Окр(СуммаБезСкидки - СтрокаЧека.СуммаСкидкиНаценки
		- СтрокаЧека.СуммаАвтоматическойСкидки - СтрокаЧека.СуммаСкидкиОплатыБонусом, 2);
	АС_ПрогнозРМКСогласоватьСуммыСтроки(Контекст, СтрокаЧека);

КонецПроцедуры

Процедура АС_ПрогнозРМКОкруглитьИтогИзменениемЦены(Контекст)

	Если Не Контекст.Объект.АС_ОплатаНаличными Тогда
		Возврат;
	КонецЕсли;

	ИсходныйИтог = АС_ПрогнозРМКИтогДляОкругления(Контекст);
	Если ИсходныйИтог <= 0 Тогда
		Контекст.ПоследнийНеокругленныйИтог = Неопределено;
		Возврат;
	КонецЕсли;
	ЦелевойИтог = АС_РежимОплатыКлиентСервер.ОкруглитьНаличныйИтог(ИсходныйИтог);
	Если ЦелевойИтог = ИсходныйИтог Тогда
		Контекст.ПоследнийНеокругленныйИтог = Неопределено;
		Возврат;
	КонецЕсли;
	// Сначала проверяем все цены; сумма служит только запасным способом.
	Для СпособОкругления = 1 По 2 Цикл
		Для ПриоритетКоличество = 1 По 2 Цикл
			Для Каждого СтрокаЧека Из Контекст.Объект.Товары Цикл
				Если (ПриоритетКоличество = 1 И СтрокаЧека.Количество <> 1)
					Или (ПриоритетКоличество = 2 И СтрокаЧека.Количество = 1)
					Или Не АС_ПрогнозРМКМожноОкруглитьЦенуСтроки(Контекст, СтрокаЧека) Тогда
					Продолжить;
				КонецЕсли;
				Если АС_ПрогнозРМКПодобратьЦенуДляИтога(Контекст, СтрокаЧека, ИсходныйИтог, ЦелевойИтог,
					СпособОкругления = 2) Тогда
					Контекст.ПоследнийНеокругленныйИтог = Неопределено;
					Возврат;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция АС_ПрогнозРМКПодобратьЦенуДляИтога(Контекст, СтрокаЧека, ИсходныйИтог, ЦелевойИтог, КорректироватьСумму = Ложь)

	ИсходныеЗначения = Новый Структура(
		"Цена,Сумма,СуммаНДС,СуммаБезСкидки,СуммаСкидокОбщая,ПроцентСкидкиОбщий,ПроцентСкидкиНаценки,СуммаСкидкиНаценки,"
		+ "ПроцентАвтоматическойСкидки,СуммаАвтоматическойСкидки,СуммаСкидкиОплатыБонусом");
	ЗаполнитьЗначенияСвойств(ИсходныеЗначения, СтрокаЧека);
	МинимальнаяЦена = 0;
	Если СтрокаЧека.Свойство("МинимальнаяЦена") Тогда
		МинимальнаяЦена = СтрокаЧека.МинимальнаяЦена;
	КонецЕсли;
	ИсходнаяЦена = ИсходныеЗначения.Цена;
	НоваяЦена = Окр(ИсходнаяЦена + (ЦелевойИтог - ИсходныйИтог) / СтрокаЧека.Количество, 2);
	ПроверенныеЦены = Новый Массив;
	Для НомерПопытки = 1 По 4 Цикл
		Если НоваяЦена <= 0 Или НоваяЦена < МинимальнаяЦена
			Или Окр(НоваяЦена * СтрокаЧека.Количество, 2) <= 0
			Или (НоваяЦена = ИсходнаяЦена И Не КорректироватьСумму)
			Или ПроверенныеЦены.Найти(НоваяЦена) <> Неопределено Тогда
			Прервать;
		КонецЕсли;
		ПроверенныеЦены.Добавить(НоваяЦена);
		ЗаполнитьЗначенияСвойств(СтрокаЧека, ИсходныеЗначения);
		СтрокаЧека.Цена = НоваяЦена;
		Попытка
			АС_ПрогнозРМКРассчитатьСтрокуПриОкруглении(Контекст, СтрокаЧека);
		Исключение
			ЗаполнитьЗначенияСвойств(СтрокаЧека, ИсходныеЗначения);
			ВызватьИсключение;
		КонецПопытки;
		ФактическийИтог = АС_ПрогнозРМКИтогДляОкругления(Контекст);
		// Пределы кассовой скидки проверены штатным вводом. Округление её не увеличивает.
		СкидкаДопустима = СтрокаЧека.СуммаСкидкиНаценки = ИсходныеЗначения.СуммаСкидкиНаценки
			Или СтрокаЧека.ПроцентСкидкиНаценки = ИсходныеЗначения.ПроцентСкидкиНаценки;
		// Не принимаем цену, из-за которой штатный контроль минимальной цены урезал скидки.
		АвтоСкидкаСохранена = СтрокаЧека.СуммаАвтоматическойСкидки = ИсходныеЗначения.СуммаАвтоматическойСкидки;
		СуммаБезСкидки = Окр(НоваяЦена * СтрокаЧека.Количество, 2);
		СохраняласьДенежнаяСкидка = ИсходныеЗначения.ПроцентСкидкиНаценки = 0
			Или Окр(ИсходныеЗначения.СуммаСкидкиНаценки / СуммаБезСкидки * 100, 2)
				= ИсходныеЗначения.ПроцентСкидкиНаценки;
		РучнаяСкидкаСохранена = ?(СохраняласьДенежнаяСкидка,
			СтрокаЧека.СуммаСкидкиНаценки = ИсходныеЗначения.СуммаСкидкиНаценки,
			СтрокаЧека.ПроцентСкидкиНаценки = ИсходныеЗначения.ПроцентСкидкиНаценки);
		Если КорректироватьСумму И ФактическийИтог <> ЦелевойИтог
			И СкидкаДопустима И АвтоСкидкаСохранена И РучнаяСкидкаСохранена Тогда
			Попытка
				СуммаПодобрана = АС_ПрогнозРМКПодобратьСуммуДляИтога(Контекст, СтрокаЧека, ФактическийИтог, ЦелевойИтог, МинимальнаяЦена);
			Исключение
				ЗаполнитьЗначенияСвойств(СтрокаЧека, ИсходныеЗначения);
				ВызватьИсключение;
			КонецПопытки;
			Если СуммаПодобрана Тогда
				ФактическийИтог = АС_ПрогнозРМКИтогДляОкругления(Контекст);
			КонецЕсли;
		КонецЕсли;
		Если ФактическийИтог = ЦелевойИтог И СкидкаДопустима И АвтоСкидкаСохранена И РучнаяСкидкаСохранена
			И СтрокаЧека.Сумма >= Окр(МинимальнаяЦена * СтрокаЧека.Количество, 2) Тогда
			АС_ПрогнозРМКЗапомнитьОкруглениеСтроки(Контекст, СтрокаЧека, ИсходныеЗначения);
			Возврат Истина;
		КонецЕсли;
		ИзменениеИтога = ФактическийИтог - ИсходныйИтог;
		Если НоваяЦена = ИсходнаяЦена Тогда
			// Ручная сумма могла отличаться от цены на копейки. При той же цене
			// делитель для оценки влияния равен нулю: проверяем соседнюю копейку.
			НоваяЦена = Окр(НоваяЦена + ?(ЦелевойИтог > ФактическийИтог, 0.01, -0.01), 2);
			Продолжить;
		КонецЕсли;
		Если ИзменениеИтога = 0 Тогда
			Прервать;
		КонецЕсли;
		ВлияниеЦеныНаИтог = ИзменениеИтога / (НоваяЦена - ИсходнаяЦена);
		НоваяЦена = Окр(НоваяЦена + (ЦелевойИтог - ФактическийИтог) / ВлияниеЦеныНаИтог, 2);
	КонецЦикла;
	ЗаполнитьЗначенияСвойств(СтрокаЧека, ИсходныеЗначения);
	Возврат Ложь;

КонецФункции

Функция АС_ПрогнозРМКСуммаСтрокиНеНижеМинимальной(Контекст, СтрокаЧека, ПроверяемаяСумма)

	Если ПроверяемаяСумма <= 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СтрокаЧека.Свойство("МинимальнаяЦена") И СтрокаЧека.Цена > 0 Тогда
		КоличествоДляЦены = АС_ПрогнозРМКСуммаБезСкидкиСтроки(Контекст, СтрокаЧека) / СтрокаЧека.Цена;
		Возврат ПроверяемаяСумма >= Окр(СтрокаЧека.МинимальнаяЦена * КоличествоДляЦены, 2);
	КонецЕсли;
	Возврат Истина;

КонецФункции

Функция АС_ПрогнозРМКПодобратьСуммуДляИтога(Контекст, СтрокаЧека, ИсходныйИтог, ЦелевойИтог, МинимальнаяЦена)

	ИсходныеСуммы = Новый Структура("Сумма,СуммаНДС,СуммаБезСкидки,СуммаСкидокОбщая,ПроцентСкидкиОбщий");
	ЗаполнитьЗначенияСвойств(ИсходныеСуммы, СтрокаЧека);
	СуммаСНДС = ИсходныеСуммы.Сумма + ?(Контекст.Объект.ЦенаВключаетНДС, 0, ИсходныеСуммы.СуммаНДС);
	Если ИсходныеСуммы.Сумма <= 0 Или СуммаСНДС <= 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	КоличествоДляЦены = АС_ПрогнозРМКСуммаБезСкидкиСтроки(Контекст, СтрокаЧека) / СтрокаЧека.Цена;
	КоэффициентСуммы = ИсходныеСуммы.Сумма / СуммаСНДС;
	НоваяСумма = Окр(ИсходныеСуммы.Сумма + (ЦелевойИтог - ИсходныйИтог) * КоэффициентСуммы, 2);
	ПроверенныеСуммы = Новый Массив;
	Для НомерПопытки = 1 По 4 Цикл
		Если НоваяСумма <= 0 Или НоваяСумма < Окр(МинимальнаяЦена * СтрокаЧека.Количество, 2)
			Или ПроверенныеСуммы.Найти(НоваяСумма) <> Неопределено Тогда
			Прервать;
		КонецЕсли;
		// Поправляем лишь остаток округления: цена согласована с точной суммой
		// и уже рассчитанными скидками. Дополнительную ручную скидку не создаём.
		ЦенаИзСуммы = Окр((НоваяСумма + СтрокаЧека.СуммаСкидкиНаценки
			+ СтрокаЧека.СуммаАвтоматическойСкидки + СтрокаЧека.СуммаСкидкиОплатыБонусом)
			/ КоличествоДляЦены, 2);
		ПроверенныеСуммы.Добавить(НоваяСумма);
		СтрокаЧека.Сумма = НоваяСумма;
		Попытка
			АС_ПрогнозРМКСогласоватьСуммыСтроки(Контекст, СтрокаЧека);
		Исключение
			ЗаполнитьЗначенияСвойств(СтрокаЧека, ИсходныеСуммы);
			ВызватьИсключение;
		КонецПопытки;
		ФактическийИтог = АС_ПрогнозРМКИтогДляОкругления(Контекст);
		Если ФактическийИтог = ЦелевойИтог И ЦенаИзСуммы = СтрокаЧека.Цена Тогда
			Возврат Истина;
		КонецЕсли;
		НоваяСумма = Окр(НоваяСумма + (ЦелевойИтог - ФактическийИтог) * КоэффициентСуммы, 2);
	КонецЦикла;
	ЗаполнитьЗначенияСвойств(СтрокаЧека, ИсходныеСуммы);
	Возврат Ложь;

КонецФункции

Процедура АС_ПрогнозРМКЗапомнитьОкруглениеСтроки(Контекст, СтрокаЧека, ИсходныеЗначения)

	СтрокаЧека.АС_ЦенаДоОкругленияРМК = ИсходныеЗначения.Цена;
	СтрокаЧека.АС_ЦенаПослеОкругленияРМК = СтрокаЧека.Цена;
	СтрокаЧека.АС_СкидкаДоОкругленияРМК = ИсходныеЗначения.СуммаСкидкиНаценки;
	СтрокаЧека.АС_ПроцентСкидкиДоОкругленияРМК = ИсходныеЗначения.ПроцентСкидкиНаценки;
	СтрокаЧека.АС_СкидкаПослеОкругленияРМК = СтрокаЧека.СуммаСкидкиНаценки;
	СтрокаЧека.АС_ПроцентСкидкиПослеОкругленияРМК = СтрокаЧека.ПроцентСкидкиНаценки;
	СтрокаЧека.АС_СуммаДоОкругленияРМК = ИсходныеЗначения.Сумма;
	СтрокаЧека.АС_СуммаПослеОкругленияРМК = СтрокаЧека.Сумма;
	СтрокаЧека.АС_КоличествоПриОкругленииРМК = СтрокаЧека.Количество;
	СтрокаЧека.АС_УпаковокПриОкругленииРМК = СтрокаЧека.КоличествоУпаковок;

КонецПроцедуры

Функция АС_ПрогнозРМКСуммаБезСкидкиСтроки(Контекст, СтрокаЧека)
	Возврат СтрокаЧека.Цена * СтрокаЧека.Количество;
КонецФункции

Процедура АС_ПрогнозРМКСогласоватьСуммыСтроки(Контекст, СтрокаЧека)

	СтрокаЧека.СуммаСкидокОбщая = СтрокаЧека.СуммаСкидкиНаценки
		+ СтрокаЧека.СуммаАвтоматическойСкидки + СтрокаЧека.СуммаСкидкиОплатыБонусом;
	СтрокаЧека.СуммаБезСкидки = СтрокаЧека.Сумма + СтрокаЧека.СуммаСкидокОбщая;
	СтрокаЧека.ПроцентСкидкиОбщий = ?(СтрокаЧека.СуммаБезСкидки = 0, 0,
		СтрокаЧека.СуммаСкидокОбщая / СтрокаЧека.СуммаБезСкидки * 100);
	АС_НДСПрогнозаРМК(Контекст.Объект, СтрокаЧека);

КонецПроцедуры

Функция АС_ПрогнозРМКИтогДляОкругления(Контекст)

	Результат = 0;
	Для Каждого СтрокаЧека Из Контекст.Объект.Товары Цикл
		Если СтрокаЧека.АС_ВходитВИтогПрогноза И Не СтрокаЧека.ТоварКЗамене Тогда
			Результат = Результат + СтрокаЧека.Сумма + ?(Контекст.Объект.ЦенаВключаетНДС, 0, СтрокаЧека.СуммаНДС);
		КонецЕсли;
	КонецЦикла;
	Возврат Окр(Результат, 2);

КонецФункции

Функция АС_ПрогнозРМКМожноОкруглитьЦенуСтроки(Контекст, СтрокаЧека)

	Если СтрокаЧека.Количество <= 0 Или СтрокаЧека.Цена <= 0
		Или СтрокаЧека.Оплачена Или СтрокаЧека.Подарок Или СтрокаЧека.ТоварКЗамене
		Или СтрокаЧека.ЭтоНабор Или СтрокаЧека.НомерНабора <> 0
		Или СтрокаЧека.ЭтоПодарочныйСертификат Или СтрокаЧека.ЭтоТабачнаяПродукция
		Или ЗначениеЗаполнено(СтрокаЧека.МРЦ) Или ЗначениеЗаполнено(СтрокаЧека.ЕМРЦ) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СтрокаЧека.КоличествоУпаковок <> СтрокаЧека.Количество Тогда
		// Штатная касса использует разные количества для цены и суммы упаковки.
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрокаЧека.АС_ВходитВИтогПрогноза;

КонецФункции


// Алгоритмы ниже повторяют штатные расчёты строк УНФ (1С-Софт, CC BY 4.0).
// Только для копий: финансовые присваивания ограничены точностью полей формы.


Процедура АС_НДСПрогнозаРМК(КопияОбъекта, СтрокаЧека)

	СтавкаНДС = УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеСтавкиНДС(СтрокаЧека.СтавкаНДС);
	СтрокаЧека.СуммаНДС = Окр(?(КопияОбъекта.ЦенаВключаетНДС,
		СтрокаЧека.Сумма - СтрокаЧека.Сумма / ((СтавкаНДС + 100) / 100),
		СтрокаЧека.Сумма * СтавкаНДС / 100), 2);

КонецПроцедуры







Процедура АС_ПересчитатьСтрокуПрогнозаРМК(КопияФормы, ТекущаяСтрока, СкидкиРассчитаны = Ложь,
	ИспользоватьАвтоскидки = Ложь)

	ТекущаяСтрока.СуммаБезСкидки = Окр(ТекущаяСтрока.Цена * ТекущаяСтрока.КоличествоУпаковок, 2);

	СуммаТекущейСкидки = 0;

	ПроцентСкидкиНаценки = ?(ТекущаяСтрока.СуммаБезСкидки = 0, 0, ТекущаяСтрока.СуммаСкидкиНаценки/ТекущаяСтрока.СуммаБезСкидки * 100);
	Если НЕ ТекущаяСтрока.ПроцентСкидкиНаценки = Окр(ПроцентСкидкиНаценки,2) Тогда
		ПроцентСкидкиНаценки = ТекущаяСтрока.ПроцентСкидкиНаценки;
	КонецЕсли;

	Если ЗначениеЗаполнено(ПроцентСкидкиНаценки) Тогда

		ОсноваДляРасчетаСкидки = ТекущаяСтрока.СуммаБезСкидки;

		ТекущаяСтрока.СуммаСкидкиНаценки = Окр((ОсноваДляРасчетаСкидки * ПроцентСкидкиНаценки) / 100 + ТекущаяСтрока.СуммаОкругленияВПользуПокупателя, 2);
		Если ТекущаяСтрока.Подарок Тогда
			СуммаТекущейСкидки  = СуммаТекущейСкидки + ТекущаяСтрока.СуммаСкидкиНаценки;
		Иначе
			СуммаТекущейСкидки = СуммаТекущейСкидки + ТекущаяСтрока.СуммаСкидкиНаценки + ТекущаяСтрока.СуммаАвтоматическойСкидки;
		КонецЕсли;
		КопияФормы.ТекущийТоварСуммаСкидки = СуммаТекущейСкидки;

	ИначеЕсли ((ЗначениеЗаполнено(ТекущаяСтрока.СуммаСкидкиНаценки)
		Или ЗначениеЗаполнено(ТекущаяСтрока.СуммаАвтоматическойСкидки))
		И Не ЗначениеЗаполнено(ТекущаяСтрока.ПроцентСкидкиНаценки)) ИЛИ ЗначениеЗаполнено(ТекущаяСтрока.СуммаОкругленияВПользуПокупателя) Тогда

		ТекущаяСтрока.СуммаСкидкиНаценки = Окр(ТекущаяСтрока.СуммаСкидкиНаценки + ТекущаяСтрока.СуммаОкругленияВПользуПокупателя, 2);
		СуммаТекущейСкидки = СуммаТекущейСкидки + ТекущаяСтрока.СуммаСкидкиНаценки + ТекущаяСтрока.СуммаАвтоматическойСкидки;
		КопияФормы.ТекущийТоварСуммаСкидки = СуммаТекущейСкидки;

	КонецЕсли;

	СуммаСкидокОбщая = СуммаТекущейСкидки + ТекущаяСтрока.СуммаСкидкиОплатыБонусом;
	Если Не ТекущаяСтрока.СуммаСкидокОбщая = СуммаСкидокОбщая Тогда
		ТекущаяСтрока.СуммаСкидокОбщая = Окр(СуммаСкидокОбщая, 2);
	КонецЕсли;

	ТекущаяСтрока.ПроцентСкидкиОбщий = Окр(?(ТекущаяСтрока.СуммаБезСкидки = 0, 0, ТекущаяСтрока.СуммаСкидокОбщая/ТекущаяСтрока.СуммаБезСкидки) * 100, 2);

	Если ТекущаяСтрока.ПроцентСкидкиОбщий = 0 Тогда
		ТекущаяСтрока.ИндексКартинкиПроцентов = -1;
	Иначе
		ТекущаяСтрока.ИндексКартинкиПроцентов = 0;
	КонецЕсли;

	ТекущаяСтрока.ОтображаетсяСкидкаПроцентом = ЗначениеЗаполнено(ТекущаяСтрока.ПроцентСкидкиНаценки);
	ТекущаяСтрока.ОтображаетсяСкидкаСуммой =
		НЕ ТекущаяСтрока.ОтображаетсяСкидкаПроцентом И ЗначениеЗаполнено(ТекущаяСтрока.СуммаСкидкиНаценки);
	СуммаСтроки = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена - ТекущаяСтрока.СуммаСкидокОбщая;
	Если Не ТекущаяСтрока.Сумма = СуммаСтроки Тогда
		ТекущаяСтрока.Сумма = Окр(СуммаСтроки, 2);
	КонецЕсли;


КонецПроцедуры
