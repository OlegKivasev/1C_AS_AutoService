// Только чтение: точный штрихкод и сохраненные цены товара/характеристики.
Функция НайтиТовары(Штрихкод, Настройки, Диагностика = Неопределено) Экспорт

	Если Диагностика = Неопределено Тогда Диагностика = Новый Структура("Этап", ""); КонецЕсли;
	Диагностика.Этап = "Поиск штрихкода в регистре и справочнике упаковок";
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 21 Коды.Номенклатура, Коды.Характеристика, Коды.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения
		|ИЗ (ВЫБРАТЬ Штрихкоды.Номенклатура, Штрихкоды.Характеристика
		|ИЗ РегистрСведений.ШтрихкодыНоменклатуры КАК Штрихкоды
		|ГДЕ Штрихкоды.Штрихкод = &Штрихкод
		|ОБЪЕДИНИТЬ
		|ВЫБРАТЬ Упаковки.Номенклатура, Упаковки.Характеристика
		|ИЗ Справочник.ШтрихкодыУпаковокТоваров КАК Упаковки
		|ГДЕ Упаковки.ЗначениеШтрихкода = &Штрихкод И НЕ Упаковки.ПометкаУдаления) КАК Коды
		|ГДЕ Коды.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|И НЕ Коды.Номенклатура.ПометкаУдаления И НЕ Коды.Номенклатура.ЭтоГруппа
		|И (Коды.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
		|ИЛИ НЕ Коды.Характеристика.ПометкаУдаления)
		|УПОРЯДОЧИТЬ ПО Коды.Номенклатура, Коды.Характеристика");
	Запрос.УстановитьПараметр("Штрихкод", Штрихкод);
	Товары = Запрос.Выполнить().Выгрузить();
	Диагностика.Этап = "Проверка количества совпадений";
	Если Товары.Количество() > 20 Тогда
		ВызватьИсключение "Штрихкод соответствует более чем 20 товарам или характеристикам.";
	КонецЕсли;
	Результат = Новый Массив;
	ДатаЦен = ТекущаяДатаСеанса();
	Ссылки = Новый Массив;
	Для Каждого СтрокаТовара Из Товары Цикл
		Если Ссылки.Найти(СтрокаТовара.Номенклатура) = Неопределено Тогда
			Ссылки.Добавить(СтрокаТовара.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	Диагностика.Этап = "Чтение остатков с учетом заказов и истории продаж";
	Остатки = Новый Соответствие;
	Если ПравоДоступа("Чтение", Метаданные.РегистрыНакопления.Запасы)
		И ПравоДоступа("Чтение", Метаданные.РегистрыНакопления.ЗаказыПокупателей) Тогда
		Остатки = АС_ДоступностьТоваровСервер.ПолучитьСведенияПоНоменклатурам(Ссылки);
	КонецЕсли;
	История = АС_ПродажиНоменклатурыСервер.ПолучитьИсториюПродажПоМесяцам(Ссылки, 4, ДатаЦен);
	Для Каждого СтрокаТовара Из Товары Цикл
		Диагностика.Этап = "Чтение наименования и характеристики товара";
		Номенклатура = СтрокаТовара.Номенклатура;
		Характеристика = СтрокаТовара.Характеристика;
		// ЗаписатьJSON преобразует Неопределено в JSON null; тип Null не поддерживается.
		ИдентификаторХарактеристики = Неопределено;
		ИмяХарактеристики = Неопределено;
		Если ЗначениеЗаполнено(Характеристика) Тогда
			ИдентификаторХарактеристики = Строка(Характеристика.УникальныйИдентификатор());
			ИмяХарактеристики = ПроверитьТекст(Характеристика.Наименование, 256, Ложь, Истина);
		КонецЕсли;
		Диагностика.Этап = "Чтение закупочной цены";
		Закупочная = ТекущаяЦена(Номенклатура, Характеристика, Настройки.ЗакупочныйВидЦен, ДатаЦен);
		Диагностика.Этап = "Чтение розничной цены";
		Розничная = ТекущаяЦена(Номенклатура, Характеристика, Настройки.РозничныйВидЦен, ДатаЦен);
		Диагностика.Этап = "Чтение безналичной розничной цены";
		Безналичная = ТекущаяЦена(Номенклатура, Характеристика, Настройки.БезналичныйВидЦен, ДатаЦен);
		Цены = Новый Структура("purchase,retail,retailCashless", Закупочная, Розничная, Безналичная);
		Диагностика.Этап = "Подготовка наименования и полей карточки";
		Статистика = Новый Структура("stockWithOrders,unit,monthlySales", Неопределено, Неопределено, Неопределено);
		Единица = СокрЛП(Строка(СтрокаТовара.ЕдиницаИзмерения));
		Если Не ПустаяСтрока(Единица) Тогда Статистика.unit = ПроверитьТекст(Единица, 100, Ложь, Истина); КонецЕсли;
		Остаток = Остатки.Получить(Номенклатура);
		Если Остаток <> Неопределено Тогда Статистика.stockWithOrders = Остаток.ОстатокСУчетомЗаказов; КонецЕсли;
		ПродажиТовара = История.Получить(Номенклатура);
		Если ПродажиТовара.ПродажиДоступны Тогда
			Статистика.monthlySales = Новый Массив;
			Для Индекс = 0 По 3 Цикл
				МесяцПродаж = ПродажиТовара.Месяцы[3 - Индекс];
				Статистика.monthlySales.Добавить(Новый Структура("month,quantity",
					Формат(МесяцПродаж.Месяц, "ДФ=yyyy-MM"), МесяцПродаж.Количество));
			КонецЦикла;
		КонецЕсли;
		Результат.Добавить(Новый Структура("id,name,characteristicId,characteristicName,prices,statistics",
			Строка(Номенклатура.УникальныйИдентификатор()), ПроверитьТекст(Номенклатура.Наименование, 500, Ложь, Истина),
			ИдентификаторХарактеристики, ИмяХарактеристики, Цены, Статистика));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Каталог — ведущая таблица: нулевые остатки включают товары без записей регистра.
// Первая порция с фильтрами группирует остатки один раз, считает строки в том же пакете.
Функция ТоварыВНаличии(После, Диагностика, СтрокаПоиска = "", ПолеСортировки = "id", НаправлениеСортировки = "asc", ПараметрыСписка = Неопределено) Экспорт

	Диагностика.Этап = "Подготовка запроса номенклатуры";
	НачалоПодготовки = ТекущаяУниверсальнаяДатаВМиллисекундах();
	РасширенныйСписок = ТипЗнч(ПараметрыСписка) = Тип("Структура");
	ПризнакОстатков = Ложь;
	СУчетомЗаказов = РасширенныйСписок И ПараметрыСписка.Свойство("inventory", ПризнакОстатков) И ПризнакОстатков = Истина;
	Наличие = ?(РасширенныйСписок, ПараметрыСписка.availability, "available");
	Если Наличие <> "available" И Наличие <> "all" И Наличие <> "absent" Тогда ВызватьИсключение "Неизвестный отбор остатков."; КонецЕсли;
	ЕстьСортировкаПоЦене = ПолеСортировки = "price";
	ПериодКоличестваПродаж = Неопределено;
	ПоказыватьКоличествоПродаж = СУчетомЗаказов И ПараметрыСписка.Свойство("salesCount", ПериодКоличестваПродаж);
	Если ПоказыватьКоличествоПродаж И Не ПравоДоступа("Чтение", Метаданные.РегистрыНакопления.Продажи) Тогда
		ВызватьИсключение "Нет доступа к количеству продаж.";
	КонецЕсли;
	Если ПолеСортировки = "salesCount" И Не ПоказыватьКоличествоПродаж Тогда
		ВызватьИсключение "Для сортировки по количеству продаж укажите период.";
	КонецЕсли;
	Если ЕстьСортировкаПоЦене Тогда
		Если Не РасширенныйСписок Или Не ЗначениеЗаполнено(ПараметрыСписка.priceType) Тогда ВызватьИсключение "Для сортировки по цене выберите вид цены."; КонецЕсли;
		ВидЦенДляСортировки = Справочники.ВидыЦен.ПолучитьСсылку(Новый УникальныйИдентификатор(ПараметрыСписка.priceType));
		ПроверитьВидЦен(ВидЦенДляСортировки);
	КонецЕсли;
	Если ПолеСортировки = "id" Тогда КолонкаСортировки = "Номенклатура";
	ИначеЕсли ПолеСортировки = "name" Тогда КолонкаСортировки = "Наименование";
	ИначеЕсли ПолеСортировки = "article" Тогда КолонкаСортировки = "Артикул";
	ИначеЕсли ПолеСортировки = "quantity" Тогда КолонкаСортировки = "Количество";
	ИначеЕсли ПолеСортировки = "price" Тогда КолонкаСортировки = "ЦенаДляСортировки";
	ИначеЕсли ПолеСортировки = "salesCount" Тогда КолонкаСортировки = "Продано";
	Иначе ВызватьИсключение "Неизвестное поле сортировки."; КонецЕсли;
	Если НаправлениеСортировки <> "asc" И НаправлениеСортировки <> "desc" Тогда ВызватьИсключение "Неизвестное направление сортировки."; КонецЕсли;
	Если ПолеСортировки = "id" И НаправлениеСортировки <> "asc" Тогда ВызватьИсключение "Неизвестный порядок списка."; КонецЕсли;
	Сравнение = ?(НаправлениеСортировки = "desc", "<", ">");
	Порядок = ?(ЕстьСортировкаПоЦене, "ЕстьЦена УБЫВ, " + КолонкаСортировки, КолонкаСортировки)
		+ ?(НаправлениеСортировки = "desc", " УБЫВ", "");
	Если ПолеСортировки <> "id" Тогда Порядок = Порядок + ", Номенклатура"; КонецЕсли;
	ЕстьКурсор = ТипЗнч(После) = Тип("Структура");
	ОтборПродаж = СУчетомЗаказов И ПараметрыСписка.Свойство("sales");
	УсловияСправочника = Новый Массив;
	УсловияСправочника.Добавить("НЕ Найденные.ПометкаУдаления И НЕ Найденные.ЭтоГруппа И Найденные.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)");
	СтрокаПоиска = ПроверитьТекст(СтрокаПоиска, 100, Истина);
	ПараметрыПоиска = Новый Структура;
	УсловиеТекста = "";
	Синонимы = Неопределено;
	ПодготовкаСинонимовМС = 0;
	ОтборСинонимовМС = 0;
	РежимПоиска = "text";
	Если РасширенныйСписок Тогда
		ПараметрыСписка.Свойство("searchMode", РежимПоиска);
		Категория = Неопределено; Группа = Неопределено;
		Если ПараметрыСписка.Свойство("category", Категория) И ЗначениеЗаполнено(Категория) Тогда
			ПараметрыПоиска.Вставить("Категория", Справочники.КатегорииНоменклатуры.ПолучитьСсылку(Новый УникальныйИдентификатор(Категория)));
			УсловияСправочника.Добавить("Найденные.КатегорияНоменклатуры В ИЕРАРХИИ (&Категория)");
		КонецЕсли;
		Если ПараметрыСписка.Свойство("group", Группа) И ЗначениеЗаполнено(Группа) Тогда
			ПараметрыПоиска.Вставить("Группа", Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Группа)));
			УсловияСправочника.Добавить("Найденные.Ссылка В ИЕРАРХИИ (&Группа)");
		КонецЕсли;
	КонецЕсли;
	Если РежимПоиска = "oem" Тогда
		МаркаOEM = Неопределено;
		ПараметрыСписка.Свойство("oemBrand", МаркаOEM);
		Если ЗначениеЗаполнено(СтрокаПоиска) Или ЗначениеЗаполнено(МаркаOEM) Тогда
			ПараметрыПоиска.Вставить("НоменклатураOEM", НоменклатураПоOEM(СтрокаПоиска, МаркаOEM));
			УсловияСправочника.Добавить("Найденные.Ссылка В (&НоменклатураOEM)");
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(СтрокаПоиска) Тогда
		УсловияТекста = Новый Массив;
		ОбработанныеЧасти = Новый Соответствие;
		НомерЧасти = 0;
		Для Каждого Часть Из СтрРазделить(СтрокаПоиска, " ") Цикл
			Если Не ЗначениеЗаполнено(Часть) Или ОбработанныеЧасти.Получить(Часть) <> Неопределено Тогда Продолжить; КонецЕсли;
			ОбработанныеЧасти.Вставить(Часть, Истина);
			ИмяПараметра = "Поиск" + Формат(НомерЧасти, "ЧГ=0");
			ПараметрыПоиска.Вставить(ИмяПараметра, ШаблонПодстроки(Часть));
			УсловиеПоАртикулу = "Найденные.Артикул ПОДОБНО &" + ИмяПараметра + " СПЕЦСИМВОЛ ""~""";
			КлючАртикула = АС_НоменклатураСервер.КомпактныйКлючАртикула(Часть);
			Если ЗначениеЗаполнено(КлючАртикула) Тогда
				ИмяКлюча = "КлючАртикула" + Формат(НомерЧасти, "ЧГ=0");
				ПараметрыПоиска.Вставить(ИмяКлюча, ШаблонПодстроки(КлючАртикула));
				УсловиеПоАртикулу = "(" + УсловиеПоАртикулу + " ИЛИ Найденные.АС_АртикулДляПоиска ПОДОБНО &" + ИмяКлюча + " СПЕЦСИМВОЛ ""~""";
				// Старые карточки могут ещё не иметь технического ключа.
				ШаблонКандидатов = "%";
				Для Позиция = 1 По СтрДлина(КлючАртикула) Цикл
					ШаблонКандидатов = ШаблонКандидатов + Сред(КлючАртикула, Позиция, 1) + "%";
				КонецЦикла;
				ИмяШаблона = "АртикулРазделители" + Формат(НомерЧасти, "ЧГ=0");
				ПараметрыПоиска.Вставить(ИмяШаблона, ШаблонКандидатов);
				УсловиеПоАртикулу = УсловиеПоАртикулу + " ИЛИ (Найденные.АС_АртикулДляПоиска = """" И Найденные.Артикул ПОДОБНО &" + ИмяШаблона + "))";
			КонецЕсли;
			УсловияТекста.Добавить("(Найденные.Наименование ПОДОБНО &" + ИмяПараметра + " СПЕЦСИМВОЛ ""~"" ИЛИ " + УсловиеПоАртикулу + ")");
			НомерЧасти = НомерЧасти + 1;
		КонецЦикла;
		НачалоСинонимов = ТекущаяУниверсальнаяДатаВМиллисекундах();
		ВариантыПоиска = АС_СинонимыПоискаСервер.ВариантыСтрокиПоиска(СтрокаПоиска);
		Если ВариантыПоиска.Количество() > 1 Тогда
			Синонимы = АС_СинонимыПоискаСервер.ПодготовитьПоискСинонимов(ВариантыПоиска, ПараметрыПоиска);
		КонецЕсли;
		ПодготовкаСинонимовМС = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоСинонимов;
		УсловиеТекста = "(" + СтрСоединить(УсловияТекста, " И ") + ")";
	КонецЕсли;
	Если ЕстьКурсор Тогда
		ПослеНоменклатуры = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(После.id));
		ПараметрыПоиска.Вставить("ПослеНоменклатуры", ПослеНоменклатуры);
		Если ПолеСортировки = "id" Тогда
			УсловияСправочника.Добавить("Найденные.Ссылка > &ПослеНоменклатуры");
		ИначеЕсли ПолеСортировки <> "quantity" И ПолеСортировки <> "price" И ПолеСортировки <> "salesCount" Тогда
			ПараметрыПоиска.Вставить("ПослеЗначения", После.value);
			УсловияСправочника.Добавить("(Найденные." + КолонкаСортировки + " " + Сравнение + " &ПослеЗначения
				|ИЛИ (Найденные." + КолонкаСортировки + " = &ПослеЗначения И Найденные.Ссылка > &ПослеНоменклатуры))");
		КонецЕсли;
	КонецЕсли;
	ТекстПакета = "";
	Если СУчетомЗаказов Тогда
		ТекстПакета = ТекстТоварныхОтборов(ПараметрыСписка, УсловияСправочника, ПараметрыПоиска);
	КонецЕсли;
	МенеджерТаблиц = Неопределено;
	ИсточникКаталога = "Справочник.Номенклатура";
	ЕстьСинонимы = Синонимы <> Неопределено И Не ПустаяСтрока(Синонимы.Условие);
	РежимСинонимов = "без синонимов";
	Если ЕстьСинонимы И Синонимы.ПроверятьКандидатов Тогда
		РежимСинонимов = "с проверкой";
		Диагностика.Этап = "Отбор и проверка синонимов";
		НачалоОтбораСинонимов = ТекущаяУниверсальнаяДатаВМиллисекундах();
		МенеджерТаблиц = Новый МенеджерВременныхТаблиц;
		Кандидаты = ПодтвердитьСинонимыСписка(МенеджерТаблиц, ТекстПакета, УсловияСправочника, УсловиеТекста, Синонимы);
		ОтборСинонимовМС = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоОтбораСинонимов;
		ПараметрыПоиска = Новый Структура("ПодтвержденныеСинонимы", Кандидаты);
		Если ЕстьКурсор И (ПолеСортировки = "quantity" Или ПолеСортировки = "price") Тогда
			ПараметрыПоиска.Вставить("ПослеНоменклатуры", ПослеНоменклатуры);
		КонецЕсли;
		ИсточникКаталога = "АС_КандидатыПоиска";
		ОтборКаталога = " ГДЕ Найденные.ПрямоеСовпадение ИЛИ Найденные.Ссылка В (&ПодтвержденныеСинонимы)";
		ТекстПакета = "";
	Иначе
		Если ЕстьСинонимы Тогда
			РежимСинонимов = "в запросе";
			УсловиеТекста = "(" + УсловиеТекста + " ИЛИ (НЕ Найденные.Недействителен И " + Синонимы.Условие + "))";
		КонецЕсли;
		Если Не ПустаяСтрока(УсловиеТекста) Тогда УсловияСправочника.Добавить(УсловиеТекста); КонецЕсли;
		ОтборКаталога = " ГДЕ " + СтрСоединить(УсловияСправочника, " И ");
	КонецЕсли;
	Если СУчетомЗаказов Или МенеджерТаблиц <> Неопределено Тогда
		// Применяем текст, периоды и навигацию один раз для остатков, цен и страницы.
		ТекстПакета = ТекстПакета +
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ Найденные.Ссылка КАК Ссылка, Найденные.Наименование КАК Наименование,
			|Найденные.Артикул КАК Артикул ПОМЕСТИТЬ АС_КаталогСтраницы
			|ИЗ " + ИсточникКаталога + " КАК Найденные" + ОтборКаталога + "
			|ИНДЕКСИРОВАТЬ ПО Ссылка;";
		ИсточникКаталога = "АС_КаталогСтраницы";
		ОтборКаталога = "";
	КонецЕсли;
	Если ПоказыватьКоличествоПродаж Тогда
		ДатаС = Дата(СтрЗаменить(ПериодКоличестваПродаж["from"], "-", ""));
		ДатаПо = КонецДня(Дата(СтрЗаменить(ПериодКоличестваПродаж["to"], "-", "")));
		Если ДатаС > ДатаПо Тогда ВызватьИсключение "Некорректный период количества продаж."; КонецЕсли;
		ПараметрыПоиска.Вставить("АС_ДатаКоличестваПродажС", ДатаС);
		ПараметрыПоиска.Вставить("АС_ДатаКоличестваПродажПо", ДатаПо);
		ТекстПакета = ТекстПакета + Символы.ПС
			+ АС_ПродажиНоменклатурыСервер.ТекстКоличестваПродаж(Истина, Истина) + Символы.ПС;
	КонецЕсли;
	СсылкиКаталога = "ВЫБРАТЬ Найденные.Ссылка ИЗ " + ИсточникКаталога + " КАК Найденные" + ОтборКаталога;
	Итог = "ЕСТЬNULL(Остатки.Количество, 0)";
	Если СУчетомЗаказов Тогда
		Если МенеджерТаблиц = Неопределено Тогда МенеджерТаблиц = Новый МенеджерВременныхТаблиц; КонецЕсли;
		ТекстПакета = ТекстПакета + АС_ДоступностьТоваровСервер.ТекстОстатковСписка(СсылкиКаталога);
		Итог = Итог + " + ЕСТЬNULL(Замены.Количество, 0)";
	КонецЕсли;
	ОтборИтога = ?(Наличие = "available", Итог + " > 0", ?(Наличие = "absent", Итог + " <= 0", "ИСТИНА"));
	Если ЕстьКурсор И ПолеСортировки = "quantity" Тогда
		ОтборИтога = ОтборИтога + " И (" + Итог + " " + Сравнение + " &ПослеЗначения ИЛИ (" + Итог + " = &ПослеЗначения И Найденные.Ссылка > &ПослеНоменклатуры))";
	КонецЕсли;
	ВыражениеПродано = "ЕСТЬNULL(ПродажиПоТоварам.Количество, 0)";
	Если ЕстьКурсор И ПолеСортировки = "salesCount" Тогда
		ОтборИтога = ОтборИтога + " И (" + ВыражениеПродано + " " + Сравнение + " &ПослеЗначения ИЛИ ("
			+ ВыражениеПродано + " = &ПослеЗначения И Найденные.Ссылка > &ПослеНоменклатуры))";
	КонецЕсли;
	ВыражениеЕстьЦены = "ВЫБОР КОГДА ЦеныСортировки.Цена ЕСТЬ NULL ТОГДА 0 ИНАЧЕ 1 КОНЕЦ";
	ВыражениеЦены = "ЕСТЬNULL(ЦеныСортировки.Цена, 0)";
	Если ЕстьКурсор И ПолеСортировки = "price" Тогда
		ОтборИтога = ОтборИтога + " И ((" + ВыражениеЕстьЦены + " < &ПослеЕстьЦены)
			|ИЛИ (" + ВыражениеЕстьЦены + " = &ПослеЕстьЦены И (" + ВыражениеЦены + " " + Сравнение + " &ПослеЗначения
			|ИЛИ (" + ВыражениеЦены + " = &ПослеЗначения И Найденные.Ссылка > &ПослеНоменклатуры))))";
	КонецЕсли;
	Поля = "Найденные.Ссылка КАК Номенклатура, Найденные.Наименование КАК Наименование, Найденные.Артикул КАК Артикул, " + Итог + " КАК Количество"
		+ ?(ЕстьСортировкаПоЦене, ", " + ВыражениеЦены + " КАК ЦенаДляСортировки, " + ВыражениеЕстьЦены + " КАК ЕстьЦена", "")
		+ ?(ПоказыватьКоличествоПродаж, ", " + ВыражениеПродано + " КАК Продано", "");
	Источник = " ИЗ " + ИсточникКаталога + " КАК Найденные ЛЕВОЕ СОЕДИНЕНИЕ";
	Если СУчетомЗаказов Тогда
		Источник = Источник + " АС_СвободныеОстатки КАК Остатки ПО Найденные.Ссылка = Остатки.Номенклатура
		|ЛЕВОЕ СОЕДИНЕНИЕ АС_ИтогиЗамен КАК Замены ПО Найденные.Ссылка = Замены.Номенклатура";
	Иначе
		Источник = Источник + "
			|(ВЫБРАТЬ Остатки.Номенклатура КАК Номенклатура, СУММА(Остатки.КоличествоОстаток) КАК Количество
			|ИЗ РегистрНакопления.ЗапасыНаСкладах.Остатки(, Номенклатура В (" + СсылкиКаталога + ")) КАК Остатки
			|СГРУППИРОВАТЬ ПО Остатки.Номенклатура) КАК Остатки ПО Найденные.Ссылка = Остатки.Номенклатура";
	КонецЕсли;
	Если ЕстьСортировкаПоЦене Тогда
		Источник = Источник + " ЛЕВОЕ СОЕДИНЕНИЕ
			|(ВЫБРАТЬ Цены.Номенклатура, Цены.Цена
			|ИЗ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&ДатаЦенСортировки, ВидЦен = &ВидЦенСортировки
			|И Номенклатура В (" + СсылкиКаталога + ")
			|И Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК Цены
			|ГДЕ Цены.Актуальность) КАК ЦеныСортировки ПО Найденные.Ссылка = ЦеныСортировки.Номенклатура";
	КонецЕсли;
	Если ПоказыватьКоличествоПродаж Тогда
		Источник = Источник + " ЛЕВОЕ СОЕДИНЕНИЕ АС_ПродажиПоТоварам КАК ПродажиПоТоварам
			|ПО Найденные.Ссылка = ПродажиПоТоварам.Номенклатура";
	КонецЕсли;
	Источник = Источник + ?(ПустаяСтрока(ОтборКаталога), " ГДЕ ", ОтборКаталога + " И ") + ОтборИтога;
	СчитатьВсего = РасширенныйСписок И Не ЕстьКурсор;
	ПоляСтраницы = "Номенклатура, Наименование, Артикул, Количество"
		+ ?(ЕстьСортировкаПоЦене, ", ЦенаДляСортировки, ЕстьЦена", "") + ?(ПоказыватьКоличествоПродаж, ", Продано", "");
	Запрос = Новый Запрос;
	Если МенеджерТаблиц <> Неопределено Тогда Запрос.МенеджерВременныхТаблиц = МенеджерТаблиц; КонецЕсли;
	Если СчитатьВсего Тогда
		Запрос.Текст = ТекстПакета + "ВЫБРАТЬ РАЗРЕШЕННЫЕ " + Поля + " ПОМЕСТИТЬ СписокНоменклатуры" + Источник
			+ "; ВЫБРАТЬ ПЕРВЫЕ 101 " + ПоляСтраницы + " ИЗ СписокНоменклатуры УПОРЯДОЧИТЬ ПО " + Порядок
			+ "; ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ СписокНоменклатуры";
	Иначе Запрос.Текст = ТекстПакета + "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 101 " + Поля + Источник + " УПОРЯДОЧИТЬ ПО " + Порядок; КонецЕсли;
	Если ЕстьКурсор Тогда
		Если ПолеСортировки = "quantity" Или ПолеСортировки = "salesCount" Тогда
			Чтение = Новый ЧтениеJSON;
			Чтение.УстановитьСтроку(После.value);
			Попытка ЗначениеПосле = ПрочитатьJSON(Чтение, Ложь);
			Исключение Чтение.Закрыть(); ВызватьИсключение; КонецПопытки;
			Чтение.Закрыть();
			Если ТипЗнч(ЗначениеПосле) <> Тип("Число") Тогда ВызватьИсключение "Некорректный остаток курсора."; КонецЕсли;
			Если ЗначениеПосле < -1000000000000000 Или ЗначениеПосле > 1000000000000000 Тогда ВызватьИсключение "Некорректный остаток курсора."; КонецЕсли;
			Запрос.УстановитьПараметр("ПослеЗначения", ЗначениеПосле);
		ИначеЕсли ПолеСортировки = "price" Тогда
			Чтение = Новый ЧтениеJSON;
			Чтение.УстановитьСтроку(После.value);
			Попытка ЗначениеПосле = ПрочитатьJSON(Чтение, Ложь);
			Исключение Чтение.Закрыть(); ВызватьИсключение; КонецПопытки;
			Чтение.Закрыть();
			Если ТипЗнч(ЗначениеПосле) <> Тип("Структура") Тогда ВызватьИсключение "Некорректная цена курсора."; КонецЕсли;
			ЕстьЦенаПосле = Неопределено; ЦенаПосле = Неопределено;
			Если Не ЗначениеПосле.Свойство("hasPrice", ЕстьЦенаПосле) Или Не ЗначениеПосле.Свойство("amount", ЦенаПосле)
				Или ТипЗнч(ЕстьЦенаПосле) <> Тип("Булево") Или ТипЗнч(ЦенаПосле) <> Тип("Число")
				Или ЦенаПосле < 0 Или ЦенаПосле > 1000000000000 Или Не ЕстьЦенаПосле И ЦенаПосле <> 0 Тогда ВызватьИсключение "Некорректная цена курсора."; КонецЕсли;
			Запрос.УстановитьПараметр("ПослеЕстьЦены", ?(ЕстьЦенаПосле, 1, 0));
			Запрос.УстановитьПараметр("ПослеЗначения", ЦенаПосле);
		КонецЕсли;
	КонецЕсли;
	Если ЕстьСортировкаПоЦене Тогда
		Запрос.УстановитьПараметр("ДатаЦенСортировки", ТекущаяДатаСеанса());
		Запрос.УстановитьПараметр("ВидЦенСортировки", ВидЦенДляСортировки);
	КонецЕсли;
	Для Каждого ПараметрПоиска Из ПараметрыПоиска Цикл Запрос.УстановитьПараметр(ПараметрПоиска.Ключ, ПараметрПоиска.Значение); КонецЦикла;
	Диагностика.Этап = "Чтение страницы номенклатуры";
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Всего = Неопределено;
	Если СчитатьВсего Тогда
		Пакет = Запрос.ВыполнитьПакет();
		Выборка = Пакет[Пакет.ВГраница() - 1].Выбрать();
		Счетчик = Пакет[Пакет.ВГраница()].Выбрать(); Счетчик.Следующий(); Всего = Счетчик.Всего;
	Иначе Выборка = Запрос.Выполнить().Выбрать(); КонецЕсли;
	Товары = Новый Массив;
	ЧтениеСтраницыМС = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
	Ссылки = Новый Массив;
	ЕстьЕще = Ложь;
	ПоследнееЗначение = Неопределено;
	ЗапрошенаПодсветка = Ложь;
	ПодсветкаСинонимов = Синонимы <> Неопределено И Синонимы.Варианты.Количество() > 1
		И РасширенныйСписок И ПараметрыСписка.Свойство("highlightSynonyms", ЗапрошенаПодсветка)
		И ЗапрошенаПодсветка = Истина;
	Если ПодсветкаСинонимов Тогда
		ИсходныеСлова = Новый Соответствие;
		Для Каждого Слово Из СтрРазделить(АС_СинонимыПоискаСервер.НормализоватьСтроку(СтрокаПоиска), " ", Ложь) Цикл
			ИсходныеСлова.Вставить(Слово, Истина);
		КонецЦикла;
	КонецЕсли;
	Пока Выборка.Следующий() Цикл
		Если Товары.Количество() = 100 Тогда ЕстьЕще = Истина; Прервать; КонецЕсли;
		Ссылки.Добавить(Выборка.Номенклатура);
		Товар = Новый Структура("id,name,article,quantity",
			НРег(Строка(Выборка.Номенклатура.УникальныйИдентификатор())),
			ПроверитьТекст(Выборка.Наименование, 500, Ложь, Истина), ПроверитьТекст(Выборка.Артикул, 50, Истина, Истина), Выборка.Количество);
		Если ПоказыватьКоличествоПродаж Тогда Товар.Вставить("salesCount", Выборка.Продано); КонецЕсли;
		Если ПодсветкаСинонимов Тогда
			СловаПодсветки = АС_СинонимыПоискаСервер.СловаСинонимовДляПодсветки(Товар.name, Синонимы.Варианты, ИсходныеСлова);
			Если СловаПодсветки.Количество() > 0 Тогда Товар.Вставить("nameMatches", СловаПодсветки); КонецЕсли;
		КонецЕсли;
		Товары.Добавить(Товар);
		Если ПолеСортировки = "name" Тогда ПоследнееЗначение = Выборка.Наименование;
		ИначеЕсли ПолеСортировки = "article" Тогда ПоследнееЗначение = Выборка.Артикул;
		ИначеЕсли ПолеСортировки = "quantity" Тогда ПоследнееЗначение = Выборка.Количество;
		ИначеЕсли ПолеСортировки = "salesCount" Тогда ПоследнееЗначение = Выборка.Продано;
		ИначеЕсли ПолеСортировки = "price" Тогда ПоследнееЗначение = Новый Структура("hasPrice,amount", Выборка.ЕстьЦена = 1, ?(Выборка.ЕстьЦена = 1, Выборка.ЦенаДляСортировки, 0)); КонецЕсли;
	КонецЦикла;
	Если (ПолеСортировки = "quantity" Или ПолеСортировки = "price" Или ПолеСортировки = "salesCount") И Товары.Количество() > 0 Тогда
		Запись = Новый ЗаписьJSON; Запись.УстановитьСтроку(); ЗаписатьJSON(Запись, ПоследнееЗначение); ПоследнееЗначение = Запись.Закрыть();
	КонецЕсли;
	Результат = Новый Структура("products,hasMore,lastSortValue", Товары, ЕстьЕще, ПоследнееЗначение);
	Если СчитатьВсего Тогда
		Результат.Вставить("totalCount", Всего);
		Результат.Вставить("priceTypes", ВидыЦенДляСписка());
		ЗагрузитьНавигацию = Ложь;
		Если ПараметрыСписка.Свойство("navigation", ЗагрузитьНавигацию) И ЗагрузитьНавигацию Тогда
			Результат.Вставить("navigation", НавигацияНоменклатуры());
		КонецЕсли;
	КонецЕсли;
	ЧтениеПоставокМС = 0;
	Если СУчетомЗаказов И Ссылки.Количество() > 0 Тогда
		Диагностика.Этап = "Пакетное чтение расшифровок остатков";
		Расшифровки = АС_ДоступностьТоваровСервер.РасшифровкиСписка(Ссылки, МенеджерТаблиц);
		Диагностика.Этап = "Пакетное чтение количества к поступлению";
		НачалоПоставок = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Поступления = ПоступленияСтраницыНоменклатуры(Ссылки);
		ЧтениеПоставокМС = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоПоставок;
		Диагностика.Этап = "Подготовка результатов остатков и поступлений";
		Для Индекс = 0 По Товары.Количество() - 1 Цикл
			Расшифровка = Расшифровки.Получить(Ссылки[Индекс]);
			Товары[Индекс].Вставить("stockDetails", ОстатокДляАгрегатора(
				Расшифровка.Оригинал.Количество, Расшифровка.Замены));
			Товары[Индекс].Вставить("incoming", Поступления.Получить(Ссылки[Индекс]));
		КонецЦикла;
	КонецЕсли;
	Если РасширенныйСписок И ЗначениеЗаполнено(ПараметрыСписка.priceType) Тогда
		Диагностика.Этап = "Пакетное чтение цен номенклатуры";
		ЦеныСтраницы = ЦеныСтраницыНоменклатуры(Ссылки, ПараметрыСписка.priceType);
		Для Индекс = 0 По Товары.Количество() - 1 Цикл Товары[Индекс].Вставить("price", ЦеныСтраницы.Получить(Ссылки[Индекс])); КонецЦикла;
	КонецЕсли;
	ЗаписьЖурналаРегистрации("АС_Агрегатор.НоменклатураОстатки", УровеньЖурналаРегистрации.Информация, , ,
		СтрШаблон("Страница: %1 товаров; есть еще: %2; время: %3 мс; подготовка: %4 мс; запрос списка: %5 мс; к поступлению: %6 мс; продажи: %7; продолжение: %8; варианты: %9 мс; отбор синонимов с фильтрами: %10 мс.",
			Товары.Количество(), ЕстьЕще, ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоПодготовки,
			Начало - НачалоПодготовки, ЧтениеСтраницыМС, ЧтениеПоставокМС, ОтборПродаж, ЕстьКурсор,
			ПодготовкаСинонимовМС, ОтборСинонимовМС) + " Синонимы: " + РежимСинонимов + ".");
	Возврат Результат;
КонецФункции

// Подстроки артикула и имени проверяются тем же запросом по уже
// ограниченному каталогу. В BSL уходят только кандидаты без прямого попадания.
Функция ПодтвердитьСинонимыСписка(МенеджерТаблиц, ТекстПакета, УсловияСправочника, ПрямойПоиск, Синонимы)

	Запрос = Новый Запрос(ТекстПакета +
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ Найденные.Ссылка КАК Ссылка, Найденные.Наименование КАК Наименование,
		|Найденные.Артикул КАК Артикул,
		|ВЫБОР КОГДА " + ПрямойПоиск + " ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК ПрямоеСовпадение
		|ПОМЕСТИТЬ АС_КандидатыПоиска
		|ИЗ Справочник.Номенклатура КАК Найденные
		|ГДЕ " + СтрСоединить(УсловияСправочника, " И ")
			+ " И (" + ПрямойПоиск + " ИЛИ (НЕ Найденные.Недействителен И " + Синонимы.Условие + "))
		|ИНДЕКСИРОВАТЬ ПО Ссылка;
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ Кандидаты.Ссылка КАК Номенклатура, Кандидаты.Наименование КАК Наименование,
		|Найденные.НаименованиеПолное КАК НаименованиеПолное
		|ИЗ АС_КандидатыПоиска КАК Кандидаты
		|    ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Найденные
		|    ПО Кандидаты.Ссылка = Найденные.Ссылка
		|ГДЕ НЕ Кандидаты.ПрямоеСовпадение");
	Запрос.МенеджерВременныхТаблиц = МенеджерТаблиц;
	Для Каждого Параметр Из Синонимы.Параметры Цикл
		Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	Возврат АС_СинонимыПоискаСервер.ПроверенныеСинонимы(Запрос.Выполнить().Выбрать(), Синонимы.Варианты);

КонецФункции

Функция ТекстТоварныхОтборов(ПараметрыСписка, УсловияСправочника, ПараметрыПоиска)

	ТекстПакета = "";
	Период = Неопределено;
	Если ПараметрыСписка.Свойство("receipts", Период) Тогда
		Назначение = НомерИсточникаТовара(Период.source);
		ТекстПакета = АС_ПродажиНоменклатурыСервер.ТекстОтбораПоступлений(Назначение);
		УсловияСправочника.Добавить("Найденные.Ссылка В (ВЫБРАТЬ Номенклатура ИЗ АС_ПоступившиеНоменклатура)");
		ПараметрыПоиска.Вставить("ДатаПоступленияС", Дата(СтрЗаменить(Период["from"], "-", "")));
		ПараметрыПоиска.Вставить("ДатаПоступленияПо", КонецДня(Дата(СтрЗаменить(Период["to"], "-", ""))));
		ПараметрыПоиска.Вставить("ПоступлениеПодЗаказПокупателя", Назначение = 2);
	КонецЕсли;
	Если ПараметрыСписка.Свойство("sales", Период) Тогда
		Источник = НомерИсточникаТовара(Период.source);
		ТекстПакета = ТекстПакета + АС_ПродажиНоменклатурыСервер.ТекстОтбораПродаж(Источник);
		УсловияСправочника.Добавить("Найденные.Ссылка В (ВЫБРАТЬ Номенклатура ИЗ АС_ПроданныеНоменклатура)");
		ПараметрыПоиска.Вставить("ДатаПродажиС", Дата(СтрЗаменить(Период["from"], "-", "")));
		ПараметрыПоиска.Вставить("ДатаПродажиПо", КонецДня(Дата(СтрЗаменить(Период["to"], "-", ""))));
		ПараметрыПоиска.Вставить("ПродажаПодЗаказПокупателя", Источник = 2);
	КонецЕсли;
	НаличиеOEM = "";
	Если ПараметрыСписка.Свойство("oemPresence", НаличиеOEM) Тогда
		ОтборМарки = "";
		Марка = Неопределено;
		Если ПараметрыСписка.Свойство("oemFilterBrand", Марка) Тогда
			ПараметрыПоиска.Вставить("МаркаОтбораOEM", Справочники.АС_Автомобили.ПолучитьСсылку(Новый УникальныйИдентификатор(Марка)));
			ОтборМарки = " И OEMПоМаркам.Марка = &МаркаОтбораOEM";
		КонецЕсли;
		УсловияСправочника.Добавить(?(НаличиеOEM = "absent", "НЕ ", "") + "Найденные.Ссылка В
			|(ВЫБРАТЬ OEMПоМаркам.Ссылка ИЗ Справочник.Номенклатура.АС_OEMПоМаркам КАК OEMПоМаркам
			|ГДЕ OEMПоМаркам.OEM <> """"" + ОтборМарки + ")");
	КонецЕсли;
	Возврат ТекстПакета;

КонецФункции

Функция НомерИсточникаТовара(Источник)

	Если Источник = "free" Тогда Возврат 1; КонецЕсли;
	Если Источник = "customer" Тогда Возврат 2; КонецЕсли;
	Если Источник = "all" Тогда Возврат 3; КонецЕсли;
	ВызватьИсключение "Неизвестный источник товара.";

КонецФункции

Функция ПоступленияСтраницыНоменклатуры(Ссылки) Экспорт

	Запрос = Новый Запрос(
		АС_ПродажиНоменклатурыСервер.ТекстЗапросаСвязейПоступления(Истина)
		+ " ИНДЕКСИРОВАТЬ ПО Номенклатура, ВзаимозаменяемыйТовар;"
		+ АС_ПродажиНоменклатурыСервер.ТекстЗапросаПоступления(Ложь, Ложь, Ложь, Истина)
		+ АС_ПродажиНоменклатурыСервер.ТекстЗапросаПоступленияЗамен(Истина)
		+ "ВЫБРАТЬ Ссылка.Номенклатура, Ссылка.Оригинал, Ссылка.Замена
		|ИЗ (ВЫБРАТЬ Поступления.Номенклатура КАК Номенклатура, Поступления.Количество КАК Оригинал,
		|0 КАК Замена ИЗ АС_КПоступлению КАК Поступления ГДЕ Поступления.Номенклатура В (&НоменклатураСтраницы)
		|ОБЪЕДИНИТЬ ВСЕ ВЫБРАТЬ Замены.Номенклатура, 0, Замены.Количество ИЗ АС_КПоступлениюЗамены КАК Замены) КАК Ссылка");
	Запрос.УстановитьПараметр("НоменклатураСтраницы", Ссылки);
	Результат = Новый Соответствие;
	Для Каждого Ссылка Из Ссылки Цикл
		Результат.Вставить(Ссылка, Новый Структура("original,replacement", 0, 0));
	КонецЦикла;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Количество = Результат.Получить(Выборка.Номенклатура);
		Количество.original = Количество.original + Выборка.Оригинал;
		Количество.replacement = Количество.replacement + Выборка.Замена;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Расшифровываем только выбранную колонку, пакетами по 100 строк заказа и товара.
Функция ЗаказыКПоступлению(Параметры, Диагностика) Экспорт

	Диагностика.Этап = "Расшифровка количества к поступлению";
	Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Параметры.productId));
	Замены = Параметры.side = "replacement";
	ТекстПакета = АС_ПродажиНоменклатурыСервер.ТекстЗапросаПоступления(Истина);
	УсловиеТовара = "";
	Если Замены Тогда
		ТекстПакета = АС_ПродажиНоменклатурыСервер.ТекстЗапросаСвязейПоступления(Истина)
			+ " ИНДЕКСИРОВАТЬ ПО Номенклатура, ВзаимозаменяемыйТовар;"
			+ АС_ПродажиНоменклатурыСервер.ТекстЗапросаПоступления(Ложь, Ложь, Ложь, Истина);
		УсловиеТовара = " И Поставки.Номенклатура <> &Номенклатура
			|И НЕ Поставки.Номенклатура.ЭтоГруппа И НЕ Поставки.Номенклатура.ПометкаУдаления
			|И НЕ Поставки.Номенклатура.Недействителен";
	КонецЕсли;
	После = Неопределено;
	ЕстьКурсор = Параметры.Свойство("after", После);
	Если ЕстьКурсор Тогда
		УсловиеТовара = УсловиеТовара + " И (Поставки.ЗаказПоставщику > &ПослеЗаказа
			|ИЛИ (Поставки.ЗаказПоставщику = &ПослеЗаказа И Поставки.Номенклатура > &ПослеТовара))";
	КонецЕсли;
	Запрос = Новый Запрос(ТекстПакета +
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|Поставки.ЗаказПоставщику КАК Заказ, Поставки.Номенклатура КАК Номенклатура,
		|Поставки.Характеристика КАК Характеристика, Поставки.Организация КАК Организация,
		|Поставки.Количество - ЕСТЬNULL(Размещения.Количество, 0) КАК Количество
		|ПОМЕСТИТЬ АС_СвободныеПоставкиДляСписка
		|ИЗ АС_ПоставкиДляПоступления КАК Поставки
		|    ЛЕВОЕ СОЕДИНЕНИЕ АС_РазмещенияДляПоступления КАК Размещения
		|    ПО Поставки.Организация = Размещения.Организация
		|        И Поставки.ЗаказПоставщику = Размещения.ИсточникОбеспечения
		|        И Поставки.Номенклатура = Размещения.Номенклатура
		|        И Поставки.Характеристика = Размещения.Характеристика
		|ГДЕ Поставки.Количество > 0 И Поставки.Количество - ЕСТЬNULL(Размещения.Количество, 0) > 0" + УсловиеТовара + "
		|ИНДЕКСИРОВАТЬ ПО Заказ, Номенклатура;
		|ВЫБРАТЬ ПЕРВЫЕ 101 Поставки.Заказ КАК Заказ, Поставки.Номенклатура КАК Номенклатура,
		|СУММА(Поставки.Количество) КАК Количество
		|ПОМЕСТИТЬ АС_СтраницаЗаказовКПоступлению
		|ИЗ АС_СвободныеПоставкиДляСписка КАК Поставки
		|СГРУППИРОВАТЬ ПО Поставки.Заказ, Поставки.Номенклатура
		|УПОРЯДОЧИТЬ ПО Заказ, Номенклатура
		|ИНДЕКСИРОВАТЬ ПО Заказ, Номенклатура;
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ Страница.Заказ КАК Заказ, Страница.Номенклатура КАК Номенклатура,
		|СУММА(Строки.Количество * ВЫБОР
		|    КОГДА Строки.ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерения
		|        ТОГДА ВЫРАЗИТЬ(Строки.ЕдиницаИзмерения КАК Справочник.ЕдиницыИзмерения).Коэффициент
		|    ИНАЧЕ 1 КОНЕЦ) КАК Заказано,
		|МИНИМУМ(ВЫБОР
		|    КОГДА Страница.Заказ.ПоложениеДатыПоступления =
		|        ЗНАЧЕНИЕ(Перечисление.ПоложениеРеквизитаНаФорме.ВТабличнойЧасти)
		|        ТОГДА ВЫБОР КОГДА Строки.ДатаПоступления > ДАТАВРЕМЯ(1, 1, 1)
		|            И Строки.ДатаПоступления < ДАТАВРЕМЯ(3999, 12, 31) ТОГДА Строки.ДатаПоступления ИНАЧЕ NULL КОНЕЦ
		|    КОГДА Страница.Заказ.ДатаПоступления > ДАТАВРЕМЯ(1, 1, 1)
		|        И Страница.Заказ.ДатаПоступления < ДАТАВРЕМЯ(3999, 12, 31) ТОГДА Страница.Заказ.ДатаПоступления
		|    ИНАЧЕ NULL КОНЕЦ) КАК ДатаЗаказа
		|ПОМЕСТИТЬ АС_КоличествоВЗаказахСтраницы
		|ИЗ АС_СтраницаЗаказовКПоступлению КАК Страница
		|    ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику.Запасы КАК Строки
		|    ПО Страница.Заказ = Строки.Ссылка И Страница.Номенклатура = Строки.Номенклатура
		|ГДЕ Строки.Количество > 0
		|СГРУППИРОВАТЬ ПО Страница.Заказ, Страница.Номенклатура
		|ИНДЕКСИРОВАТЬ ПО Заказ, Номенклатура;
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ Страница.Заказ КАК Заказ, Страница.Номенклатура КАК Номенклатура,
		|МИНИМУМ(График.Период) КАК БлижайшаяДата
		|ПОМЕСТИТЬ АС_ДатыЗаказовСтраницы
		|ИЗ АС_СтраницаЗаказовКПоступлению КАК Страница
		|    ВНУТРЕННЕЕ СОЕДИНЕНИЕ АС_СвободныеПоставкиДляСписка КАК Поставки
		|    ПО Страница.Заказ = Поставки.Заказ И Страница.Номенклатура = Поставки.Номенклатура
		|    ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ГрафикДвиженияЗапасов КАК График
		|    ПО Поставки.Заказ = График.Заказ И Поставки.Номенклатура = График.Номенклатура
		|        И Поставки.Характеристика = График.Характеристика И Поставки.Организация = График.Организация
		|        И График.Период > ДАТАВРЕМЯ(1, 1, 1) И График.Период < ДАТАВРЕМЯ(3999, 12, 31)
		|СГРУППИРОВАТЬ ПО Страница.Заказ, Страница.Номенклатура
		|ИНДЕКСИРОВАТЬ ПО Заказ, Номенклатура;
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ Страница.Заказ КАК Заказ, Страница.Номенклатура КАК Номенклатура,
		|ЕСТЬNULL(Страница.Заказ.Контрагент.Наименование, """") КАК Поставщик, Страница.Заказ.Номер КАК Номер,
		|Страница.Номенклатура.Наименование КАК Наименование, Страница.Номенклатура.Артикул КАК Артикул,
		|Страница.Количество КАК Количество, Заказы.Заказано КАК Заказано,
		|ЕСТЬNULL(Даты.БлижайшаяДата, Заказы.ДатаЗаказа) КАК БлижайшаяДата
		|ИЗ АС_СтраницаЗаказовКПоступлению КАК Страница
		|    ЛЕВОЕ СОЕДИНЕНИЕ АС_КоличествоВЗаказахСтраницы КАК Заказы
		|    ПО Страница.Заказ = Заказы.Заказ И Страница.Номенклатура = Заказы.Номенклатура
		|    ЛЕВОЕ СОЕДИНЕНИЕ АС_ДатыЗаказовСтраницы КАК Даты
		|    ПО Страница.Заказ = Даты.Заказ И Страница.Номенклатура = Даты.Номенклатура
		|УПОРЯДОЧИТЬ ПО Заказ, Номенклатура");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Если Замены Тогда
		Ссылки = Новый Массив;
		Ссылки.Добавить(Номенклатура);
		Запрос.УстановитьПараметр("НоменклатураСтраницы", Ссылки);
	КонецЕсли;
	Если ЕстьКурсор Тогда
		Запрос.УстановитьПараметр("ПослеЗаказа", Документы.ЗаказПоставщику.ПолучитьСсылку(Новый УникальныйИдентификатор(После.orderId)));
		Запрос.УстановитьПараметр("ПослеТовара", Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(После.productId)));
	КонецЕсли;
	Результат = Новый Структура("orders,hasMore", Новый Массив, Ложь);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Результат.orders.Количество() = 100 Тогда
			Результат.hasMore = Истина;
			Прервать;
		КонецЕсли;
		ДатаПоставки = ?(ТипЗнч(Выборка.БлижайшаяДата) = Тип("Дата"),
			Формат(Выборка.БлижайшаяДата, "ДФ=yyyy-MM-dd"), Неопределено);
		Заказано = ?(ТипЗнч(Выборка.Заказано) = Тип("Число") И Выборка.Заказано > 0, Выборка.Заказано, Неопределено);
		Результат.orders.Добавить(Новый Структура("orderId,productId,supplier,number,name,article,ordered,quantity,expectedDate",
			НРег(Строка(Выборка.Заказ.УникальныйИдентификатор())), НРег(Строка(Выборка.Номенклатура.УникальныйИдентификатор())),
			ПроверитьТекст(Выборка.Поставщик, 500, Истина, Истина), ПроверитьТекст(Выборка.Номер, 50, Истина, Истина),
			ПроверитьТекст(Выборка.Наименование, 500, Ложь, Истина), ПроверитьТекст(Выборка.Артикул, 50, Истина, Истина),
			Заказано, Выборка.Количество, ДатаПоставки));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ШаблонПодстроки(Значение)
	Шаблон = СтрЗаменить(Значение, "~", "~~");
	Для Каждого СимволШаблона Из СтрРазделить("%,_,[,]", ",") Цикл
		Шаблон = СтрЗаменить(Шаблон, СимволШаблона, "~" + СимволШаблона);
	КонецЦикла;
	Возврат "%" + Шаблон + "%";
КонецФункции

Функция НавигацияНоменклатуры()
	Результат = Новый Структура("categories,groups,oemBrands", Новый Массив, Новый Массив, Новый Массив);
	Для Каждого Вид Из СтрРазделить("categories,groups,oemBrands", ",") Цикл
		Если Вид = "categories" Тогда ИмяСправочника = "КатегорииНоменклатуры"; Условие = "";
		ИначеЕсли Вид = "groups" Тогда ИмяСправочника = "Номенклатура"; Условие = " И Данные.ЭтоГруппа";
		Иначе ИмяСправочника = "АС_Автомобили"; Условие = " И Данные.ЭтоГруппа"; КонецЕсли;
		Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 5001 Данные.Ссылка КАК Ссылка, Данные.Наименование КАК Наименование, Данные.Родитель КАК Родитель, Данные.ЭтоГруппа КАК ЭтоГруппа
			|ИЗ Справочник." + ИмяСправочника + " КАК Данные ГДЕ НЕ Данные.ПометкаУдаления" + Условие + " УПОРЯДОЧИТЬ ПО Наименование, Ссылка");
		Выборка = Запрос.Выполнить().Выбрать();
		Строки = Результат[Вид];
		Пока Выборка.Следующий() Цикл
			Если Строки.Количество() = 5000 Тогда ВызватьИсключение "Слишком много элементов навигации номенклатуры."; КонецЕсли;
			Элемент = Новый Структура("id,name", НРег(Строка(Выборка.Ссылка.УникальныйИдентификатор())), ПроверитьТекст(Выборка.Наименование, 150, Ложь, Истина));
			Если Вид <> "oemBrands" Тогда
				Элемент.Вставить("parentId", ?(ЗначениеЗаполнено(Выборка.Родитель), НРег(Строка(Выборка.Родитель.УникальныйИдентификатор())), Неопределено));
				Элемент.Вставить("isFolder", Выборка.ЭтоГруппа);
			КонецЕсли;
			Строки.Добавить(Элемент);
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция НоменклатураПоOEM(OEM, ИдентификаторМарки)
	Результат = Новый Массив;
	КлючOEM = АС_ИндексOEMСервер.НормализоватьOEM(OEM);
	Если ЗначениеЗаполнено(OEM) И ПустаяСтрока(КлючOEM) Тогда Возврат Результат; КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ Данные.Ссылка КАК Номенклатура, Данные.OEM КАК OEM
		|ИЗ Справочник.Номенклатура.АС_OEMПоМаркам КАК Данные ГДЕ Данные.OEM <> """"");
	Если ЗначениеЗаполнено(OEM) Тогда
		АС_ИндексOEMСервер.ОбеспечитьИндекс();
		Запрос.Текст = Запрос.Текст + " И Данные.Ссылка В (ВЫБРАТЬ Индекс.Номенклатура ИЗ РегистрСведений.АС_ИндексOEMНоменклатуры КАК Индекс ГДЕ Индекс.КлючOEM = &КлючOEM)";
		Запрос.УстановитьПараметр("КлючOEM", КлючOEM);
	КонецЕсли;
	Если ЗначениеЗаполнено(ИдентификаторМарки) Тогда
		Запрос.Текст = Запрос.Текст + " И Данные.Марка = &Марка";
		Запрос.УстановитьПараметр("Марка", Справочники.АС_Автомобили.ПолучитьСсылку(Новый УникальныйИдентификатор(ИдентификаторМарки)));
	КонецЕсли;
	Добавленные = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(OEM) И АС_ИндексOEMСервер.НормализоватьOEM(Выборка.OEM) <> КлючOEM Тогда Продолжить; КонецЕсли;
		Если Добавленные.Получить(Выборка.Номенклатура) = Неопределено Тогда
			Добавленные.Вставить(Выборка.Номенклатура, Истина); Результат.Добавить(Выборка.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция КарточкаТовара(Параметры, Диагностика, Настройки, ОтложенныйРасчет = Неопределено) Экспорт

	Диагностика.Этап = "Чтение номенклатуры для карточки";
	Диагностика.Вставить("ЭтапыКарточки", Новый Массив);
	Диагностика.Вставить("НачалоЭтапаКарточки", ТекущаяУниверсальнаяДатаВМиллисекундах());
	Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Параметры.id));
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|Товар.Наименование, Товар.Артикул, Товар.АС_Бренд,
		|Товар.КатегорияНоменклатуры.Наименование КАК Категория,
		|Товар.ЕдиницаИзмерения.Наименование КАК Единица, Товар.ФайлКартинки,
		|ЕСТЬNULL(Товар.ФайлКартинки.Размер, 0) КАК РазмерФотографии,
		|Товар.ТипНоменклатуры, Товар.ЗапретитьВводДробногоКоличества
		|ИЗ Справочник.Номенклатура КАК Товар
		|ГДЕ Товар.Ссылка = &Товар И НЕ Товар.ЭтоГруппа И НЕ Товар.ПометкаУдаления");
	Запрос.УстановитьПараметр("Товар", Номенклатура);
	Выборка = Запрос.Выполнить().Выбрать();
	Ответ = Новый Структура("id,view,data", Параметры.id, Параметры.view, Неопределено);
	Если Не Выборка.Следующий() Тогда Возврат Ответ; КонецЕсли;
	Если Параметры.view = "history" Тогда
		ЭтапЧтенияКарточки(Диагностика, "История продаж");
		Ответ.data = ИсторияКарточкиТовара(Номенклатура, Параметры.period);
		ЭтапЧтенияКарточки(Диагностика, "Формирование ответа");
		Возврат Ответ;
	КонецЕсли;
	ЭтоЗапас = Выборка.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Запас;
	Показатели = Новый Структура("image,incoming,monthlySales,average,recommendation",
		Неопределено, Неопределено, Неопределено, Неопределено, Неопределено);
	Если Параметры.view = "details" Или Параметры.view = "progressive" Тогда
		ЗаполнитьДополнительныеДанныеКарточки(Показатели, Номенклатура, Выборка, ЭтоЗапас, Диагностика, , ОтложенныйРасчет);
		Ответ.data = Показатели;
		Возврат Ответ;
	КонецЕсли;
	Предпросмотр = Параметры.view = "preview";
	Если Не Предпросмотр И Параметры.view <> "card" Тогда
		ВызватьИсключение "Неизвестный вид карточки товара.";
	КонецЕсли;
	Карточка = Новый Структура("name,article,brand,category,unit,stock,stockDetails",
		ТекстКарточки(Выборка.Наименование), ТекстКарточки(Выборка.Артикул, 100),
		ТекстКарточки(Выборка.АС_Бренд, 150), ТекстКарточки(Выборка.Категория, 150),
		ТекстКарточки(Выборка.Единица, 100), 0, ОстатокДляАгрегатора(0, Новый Массив));
	ЭтапЧтенияКарточки(Диагностика, "Остатки");
	Связи = Неопределено;
	Если ЭтоЗапас Тогда
		Связи = ЗаполнитьОстаткиКарточки(Карточка, Номенклатура);
	КонецЕсли;
	Период = АС_ПродажиНоменклатурыСервер.ПолучитьПериод();
	Карточка.Вставить("period", Новый Структура("from,to", Формат(Период.НачалоПериода, "ДФ=yyyy-MM-dd"),
		Формат(Период.КонецПериода, "ДФ=yyyy-MM-dd")));
	ЭтапЧтенияКарточки(Диагностика, "Цены");
	ВидыЦен = ?(Предпросмотр, Новый Массив, Неопределено);
	Карточка.Вставить("prices", ЦеныКарточкиТовара(Номенклатура, ВидыЦен));
	Если Предпросмотр Тогда
		Карточка.Вставить("detailsPending", ЭтоЗапас Или
			МожноПрочитатьФотографию(Выборка.ФайлКартинки, Выборка.РазмерФотографии));
		Карточка.Вставить("priceTypes", ВидыЦен);
		ВидыПоУмолчанию = Новый Массив;
		Для Каждого ИмяВида Из СтрРазделить("ЗакупочныйВидЦен,РозничныйВидЦен,БезналичныйВидЦен", ",") Цикл
			Если ЗначениеЗаполнено(Настройки[ИмяВида]) Тогда
				ВидыПоУмолчанию.Добавить(НРег(Строка(Настройки[ИмяВида].УникальныйИдентификатор())));
			КонецЕсли;
		КонецЦикла;
		Карточка.Вставить("defaultPriceTypes", ВидыПоУмолчанию);
	КонецЕсли;
	ЭтапЧтенияКарточки(Диагностика, "OEM, применяемость и замены");
	ЗаполнитьСправочныеТаблицыКарточки(Карточка, Номенклатура);
	Если Предпросмотр Тогда
		ЭтапЧтенияКарточки(Диагностика, "Формирование ответа");
	Иначе
		ЗаполнитьДополнительныеДанныеКарточки(Показатели, Номенклатура, Выборка, ЭтоЗапас, Диагностика, Связи);
	КонецЕсли;
	Для Каждого Показатель Из Показатели Цикл Карточка.Вставить(Показатель.Ключ, Показатель.Значение); КонецЦикла;
	Ответ.data = Карточка;
	Возврат Ответ;

КонецФункции

Процедура ЭтапЧтенияКарточки(Диагностика, Этап)

	Сейчас = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Диагностика.ЭтапыКарточки.Добавить(Диагностика.Этап + " " + Формат(Сейчас - Диагностика.НачалоЭтапаКарточки, "ЧГ=0") + " мс");
	Диагностика.НачалоЭтапаКарточки = Сейчас;
	Диагностика.Этап = Этап;

КонецПроцедуры

Процедура ЗаполнитьДополнительныеДанныеКарточки(Показатели, Номенклатура, Выборка, ЭтоЗапас, Диагностика,
	Связи = Неопределено, ОтложенныйРасчет = Неопределено)

	Если ЭтоЗапас Тогда
		ЭтапЧтенияКарточки(Диагностика, ?(ОтложенныйРасчет = Неопределено, "Продажи, закупка и поступления", "Продажи и поступления"));
		ЗаполнитьПоказателиКарточки(Показатели, Номенклатура, Выборка.ЗапретитьВводДробногоКоличества, Связи, ОтложенныйРасчет);
	КонецЕсли;
	ЭтапЧтенияКарточки(Диагностика, "Фотография");
	Если МожноПрочитатьФотографию(Выборка.ФайлКартинки, Выборка.РазмерФотографии) Тогда
		Показатели.image = ИзображениеКарточкиТовара(Выборка.ФайлКартинки);
	КонецЕсли;
	ЭтапЧтенияКарточки(Диагностика, "Формирование ответа");

КонецПроцедуры

Функция ЗаполнитьОстаткиКарточки(Карточка, Номенклатура)

	Товары = Новый Массив;
	Товары.Добавить(Номенклатура);
	Связи = АС_ПродажиНоменклатурыСервер.СвязиДляРасчета(Товары, Ложь, Истина);
	Для Каждого Связь Из Связи Цикл Товары.Добавить(Связь.ВзаимозаменяемыйТовар); КонецЦикла;
	Остатки = АС_ДоступностьТоваровСервер.ПолучитьСведенияПоНоменклатурам(Товары, Истина);
	Оригинал = Остатки.Получить(Номенклатура);
	Карточка.stock = Макс(0, Оригинал.ОстатокСУчетомЗаказов);
	Замены = Новый Массив;
	Для Каждого Связь Из Связи Цикл
		Количество = Остатки.Получить(Связь.ВзаимозаменяемыйТовар).ОстатокСУчетомЗаказов;
		Если Количество <= 0 Тогда Продолжить; КонецЕсли;
		Замены.Добавить(Новый Структура("Наименование,Артикул,Количество,Номенклатура",
			Связь.НаименованиеЗамены, Связь.АртикулЗамены, Количество, Связь.ВзаимозаменяемыйТовар));
		Карточка.stock = Карточка.stock + Количество;
	КонецЦикла;
	Карточка.stockDetails = ОстатокДляАгрегатора(Макс(0, Оригинал.ОстатокСУчетомЗаказов), Замены);
	Возврат Связи;

КонецФункции

Процедура ЗаполнитьПоказателиКарточки(Карточка, Номенклатура, ЦелыеКоличество, Связи, ОтложенныйРасчет)

	// Остатки для прогноза вычисляются штатным расчётом. Эти два значения нужны только ключу кэша формы 1С.
	Показатели = АС_ПродажиНоменклатурыСервер.ПолучитьПоказателиЗакупки(Номенклатура,
		0, 0, ЦелыеКоличество, , , Связи, Ложь, ОтложенныйРасчет);
	Если Показатели.ПродажиДоступны Тогда
		Карточка.monthlySales = Новый Массив;
		Для Индекс = 0 По Показатели.Месяцы.ВГраница() Цикл
			МесяцПродаж = Показатели.Месяцы[Показатели.Месяцы.ВГраница() - Индекс];
			Карточка.monthlySales.Добавить(Новый Структура("month,quantity",
				Формат(МесяцПродаж.Месяц, "ДФ=yyyy-MM"), МесяцПродаж.Количество));
		КонецЦикла;
		Карточка.average = Показатели.СреднемесячныеПродажи;
	КонецЕсли;
	Если Показатели.РасчетДоступен Тогда Карточка.recommendation = Показатели.РекомендованнаяЗакупка; КонецЕсли;
	Если Показатели.ПоступлениеДоступно Тогда
		Карточка.incoming = Новый Структура("original,replacement",
			Показатели.КПоступлению, Показатели.КПоступлениюВзаимозаменяемых);
	КонецЕсли;

КонецПроцедуры

Функция ИсторияКарточкиТовара(Номенклатура, Период)

	НачалоПериода = Дата(СтрЗаменить(Период["from"], "-", ""));
	КонецПериода = Дата(СтрЗаменить(Период["to"], "-", ""));
	Если НачалоПериода > КонецПериода Тогда ВызватьИсключение "Некорректный период истории."; КонецЕсли;
	Выборка = АС_ПродажиНоменклатурыСервер.ПолучитьСтрокиИсторииДляАгрегатора(Номенклатура, НачалоПериода, КонецПериода);
	Если Выборка = Неопределено Тогда Возврат Неопределено; КонецЕсли;
	Строки = Новый Массив;
	ЕстьЕще = Ложь;
	Пока Выборка.Следующий() Цикл
		Если Строки.Количество() = 500 Тогда ЕстьЕще = Истина; Прервать; КонецЕсли;
		Строки.Добавить(Новый Структура("date,operation,document,quantity",
			Формат(Выборка.Дата, "ДФ=yyyy-MM-dd") + "T" + Формат(Выборка.Дата, "ДФ=HH:mm:ss"),
			ТекстКарточки(Выборка.Операция, 150), ТекстКарточки(Выборка.НаименованиеЗаказа), Выборка.Количество));
	КонецЦикла;
	Возврат Новый Структура("rows,hasMore", Строки, ЕстьЕще);

КонецФункции

Функция ЦеныКарточкиТовара(Номенклатура, ВидыЦен)

	Результат = Новый Массив;
	Если Не ПравоДоступа("Чтение", Метаданные.РегистрыСведений.ЦеныНоменклатуры) Тогда Возврат Результат; КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ Цены.ВидЦен.Наименование КАК ВидЦен, Цены.ВидЦен КАК СсылкаВидаЦен, Цены.Цена,
		|ВЫБОР КОГДА Цены.ВалютаЦены <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
		|ТОГДА Цены.ВалютаЦены.Код ИНАЧЕ Цены.ВидЦен.ВалютаЦены.Код КОНЕЦ КАК КодВалюты,
		|Цены.ЕдиницаИзмерения.Наименование КАК Единица, Цены.Характеристика.Наименование КАК Характеристика,
		|Цены.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК Основная
		|ИЗ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&ДатаЦен, Номенклатура = &Номенклатура) КАК Цены
		|ГДЕ Цены.Актуальность И НЕ Цены.ВидЦен.ПометкаУдаления И НЕ Цены.ВидЦен.Недействителен
		|УПОРЯДОЧИТЬ ПО Основная УБЫВ, ВидЦен, Характеристика, Единица");
	Запрос.УстановитьПараметр("ДатаЦен", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Если ВидыЦен <> Неопределено Тогда
		Запрос.Текст = Запрос.Текст + ";" + Символы.ПС + ТекстЗапросаВидовЦен();
		Пакет = Запрос.ВыполнитьПакет();
		Выборка = Пакет[0].Выбрать();
		ЗаполнитьВидыЦен(ВидыЦен, Пакет[1].Выбрать());
	Иначе
		Выборка = Запрос.Выполнить().Выбрать();
	КонецЕсли;
	Коды = КодыВалютДляАгрегатора();
	Пока Выборка.Следующий() Цикл
		Код = Коды.Получить(ТекстКарточки(Выборка.КодВалюты, 3));
		Если Код = Неопределено Тогда Код = "XXX"; КонецЕсли;
		Цена = Новый Структура("name,characteristic,unit,amount,currency,primary",
			ТекстКарточки(Выборка.ВидЦен, 150), ТекстКарточки(Выборка.Характеристика, 150),
			ТекстКарточки(Выборка.Единица, 100), Выборка.Цена, Код, Выборка.Основная);
		Если ВидыЦен <> Неопределено Тогда
			Цена.Вставить("typeId", НРег(Строка(Выборка.СсылкаВидаЦен.УникальныйИдентификатор())));
		КонецЕсли;
		Результат.Добавить(Цена);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ЗаполнитьСправочныеТаблицыКарточки(Карточка, Номенклатура)

	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ Таблица.OEM, Таблица.Марка.Наименование КАК Марка
		|ИЗ Справочник.Номенклатура.АС_OEMПоМаркам КАК Таблица ГДЕ Таблица.Ссылка = &Товар
		|УПОРЯДОЧИТЬ ПО Таблица.НомерСтроки;
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|ЕСТЬNULL(Таблица.Автомобиль.Родитель.Наименование, Таблица.Марка.Наименование) КАК Марка,
		|ЕСТЬNULL(Таблица.Автомобиль.Наименование, Таблица.АС_АвтомобильПредставление) КАК Модель,
		|Таблица.ГодС, Таблица.ГодПо,
		|Таблица.ТипКузова, Таблица.КодКузова, Таблица.ЛитражДвигателя, Таблица.КодДвигателя, Таблица.Уточнение
		|ИЗ Справочник.Номенклатура.АС_Применяемость КАК Таблица ГДЕ Таблица.Ссылка = &Товар
		|УПОРЯДОЧИТЬ ПО Таблица.НомерСтроки");
	Запрос.УстановитьПараметр("Товар", Номенклатура);
	Пакет = Запрос.ВыполнитьПакет();
	Карточка.Вставить("oem", Новый Массив);
	Выборка = Пакет[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		Карточка.oem.Добавить(Новый Структура("article,make",
			ТекстКарточки(Выборка.OEM, 150), ТекстКарточки(Выборка.Марка, 150)));
	КонецЦикла;
	Карточка.Вставить("applicability", Новый Массив);
	Выборка = Пакет[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		Карточка.applicability.Добавить(Новый Структура("make,model,from,to,body,bodyCode,engine,engineCode,note",
			ТекстКарточки(Выборка.Марка, 150), ТекстКарточки(Выборка.Модель, 300),
			?(Выборка.ГодС = 0, "", Формат(Выборка.ГодС, "ЧГ=0")),
			?(Выборка.ГодПо = 0, "", Формат(Выборка.ГодПо, "ЧГ=0")),
			ТекстКарточки(Выборка.ТипКузова, 150), ТекстКарточки(Выборка.КодКузова, 150),
			ТекстКарточки(Выборка.ЛитражДвигателя, 100), ТекстКарточки(Выборка.КодДвигателя, 150),
			ТекстКарточки(Выборка.Уточнение)));
	КонецЦикла;
	Карточка.Вставить("replacements", Новый Массив);
	Если ПравоДоступа("Чтение", Метаданные.РегистрыСведений.АС_ВзаимозаменяемыеТовары) Тогда
		Для Каждого Замена Из АС_НоменклатураСервер.ПолучитьВзаимозаменяемыеТовары(Номенклатура) Цикл
			Карточка.replacements.Добавить(Новый Структура("id,name,article,brand",
				НРег(Строка(Замена.Номенклатура.УникальныйИдентификатор())), ТекстКарточки(Замена.Наименование),
				ТекстКарточки(Замена.Артикул, 100), ТекстКарточки(Замена.Бренд, 150)));
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Функция МожноПрочитатьФотографию(Файл, Размер)
	Возврат ЗначениеЗаполнено(Файл) И Размер <= 2097152;
КонецФункции

Функция ИзображениеКарточкиТовара(Файл)

	Данные = РаботаСФайлами.ДвоичныеДанныеФайла(Файл, Ложь);
	Если ТипЗнч(Данные) <> Тип("ДвоичныеДанные") Или Данные.Размер() = 0 Или Данные.Размер() > 2097152 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат СтрЗаменить(СтрЗаменить(Base64Строка(Данные), Символы.ВК, ""), Символы.ПС, "");

КонецФункции

Функция ТекстКарточки(Значение, Максимум = 500)
	Возврат ?(ЗначениеЗаполнено(Значение), ПроверитьТекст(Лев(Строка(Значение), Максимум), Максимум, Истина, Истина), "");
КонецФункции

Функция ВидыЦенДляСписка()
	Запрос = Новый Запрос(ТекстЗапросаВидовЦен());
	Результат = Новый Массив;
	ЗаполнитьВидыЦен(Результат, Запрос.Выполнить().Выбрать());
	Возврат Результат;
КонецФункции

Функция ТекстЗапросаВидовЦен()
	Возврат "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1001 Виды.Ссылка КАК Ссылка, Виды.Наименование КАК Наименование
		|ИЗ Справочник.ВидыЦен КАК Виды ГДЕ НЕ Виды.ПометкаУдаления И НЕ Виды.Недействителен УПОРЯДОЧИТЬ ПО Наименование, Ссылка";
КонецФункции

Процедура ЗаполнитьВидыЦен(Результат, Выборка)
	Пока Выборка.Следующий() Цикл
		Если Результат.Количество() = 1000 Тогда ВызватьИсключение "Слишком много видов цен для списка."; КонецЕсли;
		Результат.Добавить(Новый Структура("id,name", НРег(Строка(Выборка.Ссылка.УникальныйИдентификатор())), ПроверитьТекст(Выборка.Наименование, 150, Ложь, Истина)));
	КонецЦикла;
КонецПроцедуры

Функция ЦеныСтраницыНоменклатуры(Ссылки, ИдентификаторВида)
	Результат = Новый Соответствие;
	Если Ссылки.Количество() = 0 Тогда Возврат Результат; КонецЕсли;
	ВидЦен = Справочники.ВидыЦен.ПолучитьСсылку(Новый УникальныйИдентификатор(ИдентификаторВида));
	ПроверитьВидЦен(ВидЦен);
	Запрос = Новый Запрос("ВЫБРАТЬ Цены.Номенклатура, Цены.Цена,
		|ВЫБОР КОГДА Цены.ВалютаЦены <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
		|ТОГДА Цены.ВалютаЦены.Код ИНАЧЕ Цены.ВидЦен.ВалютаЦены.Код КОНЕЦ КАК КодВалюты,
		|Цены.ЕдиницаИзмерения.Наименование КАК Единица
		|ИЗ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&ДатаЦен, ВидЦен = &ВидЦен
		|И Номенклатура В (&Ссылки) И Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК Цены
		|ГДЕ Цены.Актуальность");
	Запрос.УстановитьПараметр("ДатаЦен", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("ВидЦен", ВидЦен);
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Выборка = Запрос.Выполнить().Выбрать();
	Коды = КодыВалютДляАгрегатора();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Цена < 0 Или Выборка.Цена > 1000000000000 Тогда ВызватьИсключение "Сохраненная цена находится вне допустимого диапазона."; КонецЕсли;
		Код = Коды.Получить(СокрЛП(Выборка.КодВалюты));
		Если Код = Неопределено Тогда ВызватьИсключение "Валюта цены не поддерживается обменом номенклатуры."; КонецЕсли;
		Результат.Вставить(Выборка.Номенклатура, Новый Структура("amount,currency,unit", Выборка.Цена, Код, ПроверитьТекст(Выборка.Единица, 100, Истина, Истина)));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ПроверитьВидЦен(ВидЦен) Экспорт
	Если ТипЗнч(ВидЦен) <> Тип("СправочникСсылка.ВидыЦен") Или Не ЗначениеЗаполнено(ВидЦен) Тогда
		ВызватьИсключение "Выберите закупочный, розничный и безналичный виды цен.";
	КонецЕсли;
	Если ВидЦен.ПометкаУдаления Или ВидЦен.Недействителен Тогда
		ВызватьИсключение "Для поиска номенклатуры выберите действующие виды цен.";
	КонецЕсли;
КонецПроцедуры

Функция ТекущаяЦена(Номенклатура, Характеристика, ВидЦен, ДатаЦен)
	ПроверитьВидЦен(ВидЦен);
	Запрос = Новый Запрос(
		"ВЫБРАТЬ Цены.Цена,
		|ВЫБОР КОГДА Цены.ВалютаЦены <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
		|ТОГДА Цены.ВалютаЦены ИНАЧЕ Цены.ВидЦен.ВалютаЦены КОНЕЦ КАК Валюта
		|ИЗ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&ДатаЦен,
		|ВидЦен = &ВидЦен И Номенклатура = &Номенклатура И Характеристика = &Характеристика) КАК Цены
		|ГДЕ Цены.Актуальность");
	Запрос.УстановитьПараметр("ДатаЦен", ДатаЦен);
	Запрос.УстановитьПараметр("ВидЦен", ВидЦен);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Характеристика", Характеристика);
	Выборка = Запрос.Выполнить().Выбрать();
	// Отсутствующая цена передаётся как JSON null; сохранённая нулевая цена остаётся числом 0.
	Если Не Выборка.Следующий() Тогда Возврат Неопределено; КонецЕсли;
	Если Выборка.Цена < 0 Или Выборка.Цена > 1000000000000 Тогда
		ВызватьИсключение "Сохраненная цена находится вне допустимого диапазона.";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Выборка.Валюта) Тогда
		ВызватьИсключение "У сохраненной цены не задана валюта.";
	КонецЕсли;
	// Цифровой код ОКВ устойчив к локальному названию рубля «руб.».
	КодыВалют = КодыВалютДляАгрегатора();
	КодВалюты = КодыВалют.Получить(СокрЛП(Выборка.Валюта.Код));
	Если КодВалюты = Неопределено Тогда
		ВызватьИсключение "Валюта сохраненной цены не поддерживается обменом номенклатуры.";
	КонецЕсли;
	Возврат Новый Структура("amount,currency", Выборка.Цена, КодВалюты);
КонецФункции

Функция КодыВалютДляАгрегатора()
	Коды = Новый Соответствие;
	Коды.Вставить("643", "RUB"); Коды.Вставить("840", "USD"); Коды.Вставить("978", "EUR");
	Коды.Вставить("156", "CNY"); Коды.Вставить("398", "KZT"); Коды.Вставить("933", "BYN");
	Коды.Вставить("826", "GBP"); Коды.Вставить("784", "AED"); Коды.Вставить("392", "JPY");
	Коды.Вставить("756", "CHF"); Коды.Вставить("949", "TRY");
	Возврат Коды;
КонецФункции

Функция ОстатокДляАгрегатора(Оригинал, Замены) Экспорт
	СтрокиЗамен = Новый Массив;
	Для Каждого Замена Из Замены Цикл
		Наименование = ПроверитьТекст(Замена.Наименование, 500, Истина, Истина);
		Артикул = ПроверитьТекст(Замена.Артикул, 100, Истина, Истина);
		Строка = Новый Структура("name,article,quantity",
			?(ПустаяСтрока(Наименование), "Товар без наименования", Наименование), Артикул, Замена.Количество);
		СсылкаЗамены = Неопределено;
		Если Замена.Свойство("Номенклатура", СсылкаЗамены) И ЗначениеЗаполнено(СсылкаЗамены) Тогда
			Строка.Вставить("id", НРег(Строка(СсылкаЗамены.УникальныйИдентификатор())));
		КонецЕсли;
		СтрокиЗамен.Добавить(Строка);
	КонецЦикла;
	Возврат Новый Структура("original,replacements", Оригинал, СтрокиЗамен);
КонецФункции

Функция ПроверитьТекст(Знач Значение, Максимум, РазрешитьПустое = Ложь, ДляОтображения = Ложь)
	// Работаем с копией. Поля справочников не записываются и товары не пропускаются.
	Значение = СокрЛП(Значение);
	Если СтрДлина(Значение) > Максимум Тогда
		ВызватьИсключение "Некорректное наименование товара или характеристики.";
	КонецЕсли;
	Фрагменты = Неопределено;
	НачалоФрагмента = 1;
	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Код = КодСимвола(Значение, Индекс);
		Если Код < 32 Или (Код >= 127 И Код <= 159) Тогда
			// Строка поиска остаётся строгой. Только отображаемые реквизиты очищаются.
			Если Не ДляОтображения Тогда ВызватьИсключение "Текст содержит управляющие символы."; КонецЕсли;
			Если Фрагменты = Неопределено Тогда Фрагменты = Новый Массив; КонецЕсли;
			Фрагмент = СокрЛП(Сред(Значение, НачалоФрагмента, Индекс - НачалоФрагмента));
			Если ЗначениеЗаполнено(Фрагмент) Тогда Фрагменты.Добавить(Фрагмент); КонецЕсли;
			НачалоФрагмента = Индекс + 1;
		КонецЕсли;
	КонецЦикла;
	Если Фрагменты <> Неопределено Тогда
		Фрагмент = СокрЛП(Сред(Значение, НачалоФрагмента));
		Если ЗначениеЗаполнено(Фрагмент) Тогда Фрагменты.Добавить(Фрагмент); КонецЕсли;
		Значение = СтрСоединить(Фрагменты, " ");
	КонецЕсли;
	Если Не РазрешитьПустое И Не ЗначениеЗаполнено(Значение) Тогда
		ВызватьИсключение "Пустое наименование товара или характеристики после подготовки текста.";
	КонецЕсли;
	Возврат Значение;
КонецФункции
