// Только чтение: точный штрихкод и сохраненные цены товара/характеристики.
Функция НайтиТовары(Штрихкод, Настройки, Диагностика = Неопределено) Экспорт

	Если Диагностика = Неопределено Тогда Диагностика = Новый Структура("Этап", ""); КонецЕсли;
	Диагностика.Этап = "Поиск штрихкода в регистре и справочнике упаковок";
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 21 Коды.Номенклатура, Коды.Характеристика
		|ИЗ (ВЫБРАТЬ Штрихкоды.Номенклатура, Штрихкоды.Характеристика
		|ИЗ РегистрСведений.ШтрихкодыНоменклатуры КАК Штрихкоды
		|ГДЕ Штрихкоды.Штрихкод = &Штрихкод
		|ОБЪЕДИНИТЬ
		|ВЫБРАТЬ Упаковки.Номенклатура, Упаковки.Характеристика
		|ИЗ Справочник.ШтрихкодыУпаковокТоваров КАК Упаковки
		|ГДЕ Упаковки.ЗначениеШтрихкода = &Штрихкод И НЕ Упаковки.ПометкаУдаления) КАК Коды
		|ГДЕ Коды.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|И НЕ Коды.Номенклатура.ПометкаУдаления И НЕ Коды.Номенклатура.ЭтоГруппа
		|И (Коды.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
		|ИЛИ НЕ Коды.Характеристика.ПометкаУдаления)
		|УПОРЯДОЧИТЬ ПО Коды.Номенклатура, Коды.Характеристика");
	Запрос.УстановитьПараметр("Штрихкод", Штрихкод);
	Товары = Запрос.Выполнить().Выгрузить();
	Диагностика.Этап = "Проверка количества совпадений";
	Если Товары.Количество() > 20 Тогда
		ВызватьИсключение "Штрихкод соответствует более чем 20 товарам или характеристикам.";
	КонецЕсли;
	Результат = Новый Массив;
	ДатаЦен = ТекущаяДатаСеанса();
	Для Каждого СтрокаТовара Из Товары Цикл
		Диагностика.Этап = "Чтение наименования и характеристики товара";
		Номенклатура = СтрокаТовара.Номенклатура;
		Характеристика = СтрокаТовара.Характеристика;
		// ЗаписатьJSON преобразует Неопределено в JSON null; тип Null не поддерживается.
		ИдентификаторХарактеристики = Неопределено;
		ИмяХарактеристики = Неопределено;
		Если ЗначениеЗаполнено(Характеристика) Тогда
			ИдентификаторХарактеристики = Строка(Характеристика.УникальныйИдентификатор());
			ИмяХарактеристики = ПроверитьТекст(Характеристика.Наименование, 256);
		КонецЕсли;
		Диагностика.Этап = "Чтение закупочной цены";
		Закупочная = ТекущаяЦена(Номенклатура, Характеристика, Настройки.ЗакупочныйВидЦен, ДатаЦен);
		Диагностика.Этап = "Чтение розничной цены";
		Розничная = ТекущаяЦена(Номенклатура, Характеристика, Настройки.РозничныйВидЦен, ДатаЦен);
		Диагностика.Этап = "Чтение безналичной розничной цены";
		Безналичная = ТекущаяЦена(Номенклатура, Характеристика, Настройки.БезналичныйВидЦен, ДатаЦен);
		Цены = Новый Структура("purchase,retail,retailCashless", Закупочная, Розничная, Безналичная);
		Диагностика.Этап = "Подготовка наименования и полей карточки";
		Результат.Добавить(Новый Структура("id,name,characteristicId,characteristicName,prices",
			Строка(Номенклатура.УникальныйИдентификатор()), ПроверитьТекст(Номенклатура.Наименование, 500),
			ИдентификаторХарактеристики, ИмяХарактеристики, Цены));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ПроверитьВидЦен(ВидЦен) Экспорт
	Если ТипЗнч(ВидЦен) <> Тип("СправочникСсылка.ВидыЦен") Или Не ЗначениеЗаполнено(ВидЦен) Тогда
		ВызватьИсключение "Выберите закупочный, розничный и безналичный виды цен.";
	КонецЕсли;
	Если ВидЦен.ПометкаУдаления Или ВидЦен.Недействителен Тогда
		ВызватьИсключение "Для поиска номенклатуры выберите действующие виды цен.";
	КонецЕсли;
КонецПроцедуры

Функция ТекущаяЦена(Номенклатура, Характеристика, ВидЦен, ДатаЦен)
	ПроверитьВидЦен(ВидЦен);
	Запрос = Новый Запрос(
		"ВЫБРАТЬ Цены.Цена,
		|ВЫБОР КОГДА Цены.ВалютаЦены <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
		|ТОГДА Цены.ВалютаЦены ИНАЧЕ Цены.ВидЦен.ВалютаЦены КОНЕЦ КАК Валюта
		|ИЗ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&ДатаЦен,
		|ВидЦен = &ВидЦен И Номенклатура = &Номенклатура И Характеристика = &Характеристика) КАК Цены
		|ГДЕ Цены.Актуальность");
	Запрос.УстановитьПараметр("ДатаЦен", ДатаЦен);
	Запрос.УстановитьПараметр("ВидЦен", ВидЦен);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Характеристика", Характеристика);
	Выборка = Запрос.Выполнить().Выбрать();
	// Отсутствующая цена передаётся как JSON null; сохранённая нулевая цена остаётся числом 0.
	Если Не Выборка.Следующий() Тогда Возврат Неопределено; КонецЕсли;
	Если Выборка.Цена < 0 Или Выборка.Цена > 1000000000000 Тогда
		ВызватьИсключение "Сохраненная цена находится вне допустимого диапазона.";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Выборка.Валюта) Тогда
		ВызватьИсключение "У сохраненной цены не задана валюта.";
	КонецЕсли;
	// Цифровой код ОКВ устойчив к локальному названию рубля «руб.».
	КодыВалют = Новый Соответствие;
	КодыВалют.Вставить("643", "RUB");
	КодыВалют.Вставить("840", "USD");
	КодыВалют.Вставить("978", "EUR");
	КодыВалют.Вставить("156", "CNY");
	КодыВалют.Вставить("398", "KZT");
	КодыВалют.Вставить("933", "BYN");
	КодыВалют.Вставить("826", "GBP");
	КодыВалют.Вставить("784", "AED");
	КодыВалют.Вставить("392", "JPY");
	КодыВалют.Вставить("756", "CHF");
	КодыВалют.Вставить("949", "TRY");
	КодВалюты = КодыВалют.Получить(СокрЛП(Выборка.Валюта.Код));
	Если КодВалюты = Неопределено Тогда
		ВызватьИсключение "Валюта сохраненной цены не поддерживается обменом номенклатуры.";
	КонецЕсли;
	Возврат Новый Структура("amount,currency", Выборка.Цена, КодВалюты);
КонецФункции

Функция ПроверитьТекст(Знач Значение, Максимум)
	// Нормализация работает с копией строки, не меняя реквизит переданного товара.
	Значение = СокрЛП(Значение);
	Если Не ЗначениеЗаполнено(Значение) Или СтрДлина(Значение) > Максимум Тогда
		ВызватьИсключение "Некорректное наименование товара или характеристики.";
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Код = КодСимвола(Значение, Индекс);
		Если Код < 32 Или (Код >= 127 И Код <= 159) Тогда
			ВызватьИсключение "Наименование содержит управляющие символы.";
		КонецЕсли;
	КонецЦикла;
	Возврат Значение;
КонецФункции
