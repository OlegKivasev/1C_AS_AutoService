// Только чтение: точный штрихкод и сохраненные цены товара/характеристики.
Функция НайтиТовары(Штрихкод, Настройки, Диагностика = Неопределено) Экспорт

	Если Диагностика = Неопределено Тогда Диагностика = Новый Структура("Этап", ""); КонецЕсли;
	Диагностика.Этап = "Поиск штрихкода в регистре и справочнике упаковок";
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 21 Коды.Номенклатура, Коды.Характеристика
		|ИЗ (ВЫБРАТЬ Штрихкоды.Номенклатура, Штрихкоды.Характеристика
		|ИЗ РегистрСведений.ШтрихкодыНоменклатуры КАК Штрихкоды
		|ГДЕ Штрихкоды.Штрихкод = &Штрихкод
		|ОБЪЕДИНИТЬ
		|ВЫБРАТЬ Упаковки.Номенклатура, Упаковки.Характеристика
		|ИЗ Справочник.ШтрихкодыУпаковокТоваров КАК Упаковки
		|ГДЕ Упаковки.ЗначениеШтрихкода = &Штрихкод И НЕ Упаковки.ПометкаУдаления) КАК Коды
		|ГДЕ Коды.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|И НЕ Коды.Номенклатура.ПометкаУдаления И НЕ Коды.Номенклатура.ЭтоГруппа
		|И (Коды.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
		|ИЛИ НЕ Коды.Характеристика.ПометкаУдаления)
		|УПОРЯДОЧИТЬ ПО Коды.Номенклатура, Коды.Характеристика");
	Запрос.УстановитьПараметр("Штрихкод", Штрихкод);
	Товары = Запрос.Выполнить().Выгрузить();
	Диагностика.Этап = "Проверка количества совпадений";
	Если Товары.Количество() > 20 Тогда
		ВызватьИсключение "Штрихкод соответствует более чем 20 товарам или характеристикам.";
	КонецЕсли;
	Результат = Новый Массив;
	ДатаЦен = ТекущаяДатаСеанса();
	Для Каждого СтрокаТовара Из Товары Цикл
		Диагностика.Этап = "Чтение наименования и характеристики товара";
		Номенклатура = СтрокаТовара.Номенклатура;
		Характеристика = СтрокаТовара.Характеристика;
		// ЗаписатьJSON преобразует Неопределено в JSON null; тип Null не поддерживается.
		ИдентификаторХарактеристики = Неопределено;
		ИмяХарактеристики = Неопределено;
		Если ЗначениеЗаполнено(Характеристика) Тогда
			ИдентификаторХарактеристики = Строка(Характеристика.УникальныйИдентификатор());
			ИмяХарактеристики = ПроверитьТекст(Характеристика.Наименование, 256, Ложь, Истина);
		КонецЕсли;
		Диагностика.Этап = "Чтение закупочной цены";
		Закупочная = ТекущаяЦена(Номенклатура, Характеристика, Настройки.ЗакупочныйВидЦен, ДатаЦен);
		Диагностика.Этап = "Чтение розничной цены";
		Розничная = ТекущаяЦена(Номенклатура, Характеристика, Настройки.РозничныйВидЦен, ДатаЦен);
		Диагностика.Этап = "Чтение безналичной розничной цены";
		Безналичная = ТекущаяЦена(Номенклатура, Характеристика, Настройки.БезналичныйВидЦен, ДатаЦен);
		Цены = Новый Структура("purchase,retail,retailCashless", Закупочная, Розничная, Безналичная);
		Диагностика.Этап = "Подготовка наименования и полей карточки";
		Результат.Добавить(Новый Структура("id,name,characteristicId,characteristicName,prices",
			Строка(Номенклатура.УникальныйИдентификатор()), ПроверитьТекст(Номенклатура.Наименование, 500, Ложь, Истина),
			ИдентификаторХарактеристики, ИмяХарактеристики, Цены));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Каталог — ведущая таблица: нулевые остатки включают товары без записей регистра.
// Первая порция с фильтрами группирует остатки один раз, считает строки в том же пакете.
Функция ТоварыВНаличии(После, Диагностика, СтрокаПоиска = "", ПолеСортировки = "id", НаправлениеСортировки = "asc", ПараметрыСписка = Неопределено) Экспорт

	Диагностика.Этап = "Подготовка запроса номенклатуры";
	РасширенныйСписок = ТипЗнч(ПараметрыСписка) = Тип("Структура");
	Наличие = ?(РасширенныйСписок, ПараметрыСписка.availability, "available");
	Если Наличие <> "available" И Наличие <> "all" И Наличие <> "absent" Тогда ВызватьИсключение "Неизвестный отбор остатков."; КонецЕсли;
	ЕстьСортировкаПоЦене = ПолеСортировки = "price";
	Если ЕстьСортировкаПоЦене Тогда
		Если Не РасширенныйСписок Или Не ЗначениеЗаполнено(ПараметрыСписка.priceType) Тогда ВызватьИсключение "Для сортировки по цене выберите вид цены."; КонецЕсли;
		ВидЦенДляСортировки = Справочники.ВидыЦен.ПолучитьСсылку(Новый УникальныйИдентификатор(ПараметрыСписка.priceType));
		ПроверитьВидЦен(ВидЦенДляСортировки);
	КонецЕсли;
	Если ПолеСортировки = "id" Тогда КолонкаСортировки = "Номенклатура";
	ИначеЕсли ПолеСортировки = "name" Тогда КолонкаСортировки = "Наименование";
	ИначеЕсли ПолеСортировки = "article" Тогда КолонкаСортировки = "Артикул";
	ИначеЕсли ПолеСортировки = "quantity" Тогда КолонкаСортировки = "Количество";
	ИначеЕсли ПолеСортировки = "price" Тогда КолонкаСортировки = "ЦенаДляСортировки";
	Иначе ВызватьИсключение "Неизвестное поле сортировки."; КонецЕсли;
	Если НаправлениеСортировки <> "asc" И НаправлениеСортировки <> "desc" Тогда ВызватьИсключение "Неизвестное направление сортировки."; КонецЕсли;
	Если ПолеСортировки = "id" И НаправлениеСортировки <> "asc" Тогда ВызватьИсключение "Неизвестный порядок списка."; КонецЕсли;
	Сравнение = ?(НаправлениеСортировки = "desc", "<", ">");
	Порядок = ?(ЕстьСортировкаПоЦене, "ЕстьЦена УБЫВ, " + КолонкаСортировки, КолонкаСортировки)
		+ ?(НаправлениеСортировки = "desc", " УБЫВ", "");
	Если ПолеСортировки <> "id" Тогда Порядок = Порядок + ", Номенклатура"; КонецЕсли;
	ЕстьКурсор = ТипЗнч(После) = Тип("Структура");
	УсловияСправочника = Новый Массив;
	УсловияСправочника.Добавить("НЕ Найденные.ПометкаУдаления И НЕ Найденные.ЭтоГруппа И Найденные.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)");
	СтрокаПоиска = ПроверитьТекст(СтрокаПоиска, 100, Истина);
	ПараметрыПоиска = Новый Структура;
	РежимПоиска = "text";
	Если РасширенныйСписок Тогда
		ПараметрыСписка.Свойство("searchMode", РежимПоиска);
		Категория = Неопределено; Группа = Неопределено;
		Если ПараметрыСписка.Свойство("category", Категория) И ЗначениеЗаполнено(Категория) Тогда
			ПараметрыПоиска.Вставить("Категория", Справочники.КатегорииНоменклатуры.ПолучитьСсылку(Новый УникальныйИдентификатор(Категория)));
			УсловияСправочника.Добавить("Найденные.КатегорияНоменклатуры В ИЕРАРХИИ (&Категория)");
		КонецЕсли;
		Если ПараметрыСписка.Свойство("group", Группа) И ЗначениеЗаполнено(Группа) Тогда
			ПараметрыПоиска.Вставить("Группа", Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Группа)));
			УсловияСправочника.Добавить("Найденные.Ссылка В ИЕРАРХИИ (&Группа)");
		КонецЕсли;
	КонецЕсли;
	Если РежимПоиска = "oem" Тогда
		МаркаOEM = Неопределено;
		ПараметрыСписка.Свойство("oemBrand", МаркаOEM);
		Если ЗначениеЗаполнено(СтрокаПоиска) Или ЗначениеЗаполнено(МаркаOEM) Тогда
			ПараметрыПоиска.Вставить("НоменклатураOEM", НоменклатураПоOEM(СтрокаПоиска, МаркаOEM));
			УсловияСправочника.Добавить("Найденные.Ссылка В (&НоменклатураOEM)");
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(СтрокаПоиска) Тогда
		УсловияТекста = Новый Массив;
		ОбработанныеЧасти = Новый Соответствие;
		НомерЧасти = 0;
		Для Каждого Часть Из СтрРазделить(СтрокаПоиска, " ") Цикл
			Если Не ЗначениеЗаполнено(Часть) Или ОбработанныеЧасти.Получить(Часть) <> Неопределено Тогда Продолжить; КонецЕсли;
			ОбработанныеЧасти.Вставить(Часть, Истина);
			ИмяПараметра = "Поиск" + Формат(НомерЧасти, "ЧГ=0");
			ПараметрыПоиска.Вставить(ИмяПараметра, ШаблонПодстроки(Часть));
			УсловиеПоАртикулу = "Найденные.Артикул ПОДОБНО &" + ИмяПараметра + " СПЕЦСИМВОЛ ""~""";
			КлючАртикула = АС_НоменклатураСервер.КомпактныйКлючАртикула(Часть);
			Если ЗначениеЗаполнено(КлючАртикула) Тогда
				ИмяКлюча = "КлючАртикула" + Формат(НомерЧасти, "ЧГ=0");
				ПараметрыПоиска.Вставить(ИмяКлюча, ШаблонПодстроки(КлючАртикула));
				УсловиеПоАртикулу = "(" + УсловиеПоАртикулу + " ИЛИ Найденные.АС_АртикулДляПоиска ПОДОБНО &" + ИмяКлюча + " СПЕЦСИМВОЛ ""~""";
				// Старые карточки могут ещё не иметь технического ключа.
				ШаблонКандидатов = "%";
				Для Позиция = 1 По СтрДлина(КлючАртикула) Цикл
					ШаблонКандидатов = ШаблонКандидатов + Сред(КлючАртикула, Позиция, 1) + "%";
				КонецЦикла;
				ИмяШаблона = "АртикулРазделители" + Формат(НомерЧасти, "ЧГ=0");
				ПараметрыПоиска.Вставить(ИмяШаблона, ШаблонКандидатов);
				УсловиеПоАртикулу = УсловиеПоАртикулу + " ИЛИ (Найденные.АС_АртикулДляПоиска = """" И Найденные.Артикул ПОДОБНО &" + ИмяШаблона + "))";
			КонецЕсли;
			УсловияТекста.Добавить("(Найденные.Наименование ПОДОБНО &" + ИмяПараметра + " СПЕЦСИМВОЛ ""~"" ИЛИ " + УсловиеПоАртикулу + ")");
			НомерЧасти = НомерЧасти + 1;
		КонецЦикла;
		ВариантыПоиска = АС_СинонимыПоискаСервер.ВариантыСтрокиПоиска(СтрокаПоиска);
		УсловиеТекста = "(" + СтрСоединить(УсловияТекста, " И ") + ")";
		Если ВариантыПоиска.Количество() > 1 Тогда
			ПараметрыПоиска.Вставить("Синонимы", АС_СинонимыПоискаСервер.НайтиНоменклатуруПоВариантам(ВариантыПоиска));
			УсловиеТекста = "(" + УсловиеТекста + " ИЛИ Найденные.Ссылка В (&Синонимы))";
		КонецЕсли;
		УсловияСправочника.Добавить(УсловиеТекста);
	КонецЕсли;
	Если ЕстьКурсор Тогда
		Если ПолеСортировки = "id" Тогда
			УсловияСправочника.Добавить("Найденные.Ссылка > &ПослеНоменклатуры");
		ИначеЕсли ПолеСортировки <> "quantity" И ПолеСортировки <> "price" Тогда
			УсловияСправочника.Добавить("(Найденные." + КолонкаСортировки + " " + Сравнение + " &ПослеЗначения
				|ИЛИ (Найденные." + КолонкаСортировки + " = &ПослеЗначения И Найденные.Ссылка > &ПослеНоменклатуры))");
		КонецЕсли;
	КонецЕсли;
	Каталог = СтрСоединить(УсловияСправочника, " И ");
	Итог = "ЕСТЬNULL(Остатки.Количество, 0)";
	ОтборИтога = ?(Наличие = "available", Итог + " > 0", ?(Наличие = "absent", Итог + " <= 0", "ИСТИНА"));
	Если ЕстьКурсор И ПолеСортировки = "quantity" Тогда
		ОтборИтога = ОтборИтога + " И (" + Итог + " " + Сравнение + " &ПослеЗначения ИЛИ (" + Итог + " = &ПослеЗначения И Найденные.Ссылка > &ПослеНоменклатуры))";
	КонецЕсли;
	ВыражениеЕстьЦены = "ВЫБОР КОГДА ЦеныСортировки.Цена ЕСТЬ NULL ТОГДА 0 ИНАЧЕ 1 КОНЕЦ";
	ВыражениеЦены = "ЕСТЬNULL(ЦеныСортировки.Цена, 0)";
	Если ЕстьКурсор И ПолеСортировки = "price" Тогда
		ОтборИтога = ОтборИтога + " И ((" + ВыражениеЕстьЦены + " < &ПослеЕстьЦены)
			|ИЛИ (" + ВыражениеЕстьЦены + " = &ПослеЕстьЦены И (" + ВыражениеЦены + " " + Сравнение + " &ПослеЗначения
			|ИЛИ (" + ВыражениеЦены + " = &ПослеЗначения И Найденные.Ссылка > &ПослеНоменклатуры))))";
	КонецЕсли;
	Поля = "Найденные.Ссылка КАК Номенклатура, Найденные.Наименование КАК Наименование, Найденные.Артикул КАК Артикул, " + Итог + " КАК Количество"
		+ ?(ЕстьСортировкаПоЦене, ", " + ВыражениеЦены + " КАК ЦенаДляСортировки, " + ВыражениеЕстьЦены + " КАК ЕстьЦена", "");
	Источник = " ИЗ Справочник.Номенклатура КАК Найденные ЛЕВОЕ СОЕДИНЕНИЕ
		|(ВЫБРАТЬ Остатки.Номенклатура КАК Номенклатура, СУММА(Остатки.КоличествоОстаток) КАК Количество
		|ИЗ РегистрНакопления.ЗапасыНаСкладах.Остатки(, Номенклатура В
		|(ВЫБРАТЬ Найденные.Ссылка ИЗ Справочник.Номенклатура КАК Найденные ГДЕ " + Каталог + ")) КАК Остатки
		|СГРУППИРОВАТЬ ПО Остатки.Номенклатура) КАК Остатки ПО Найденные.Ссылка = Остатки.Номенклатура";
	Если ЕстьСортировкаПоЦене Тогда
		Источник = Источник + " ЛЕВОЕ СОЕДИНЕНИЕ
			|(ВЫБРАТЬ Цены.Номенклатура, Цены.Цена
			|ИЗ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&ДатаЦенСортировки, ВидЦен = &ВидЦенСортировки
			|И Номенклатура В (ВЫБРАТЬ Найденные.Ссылка ИЗ Справочник.Номенклатура КАК Найденные ГДЕ " + Каталог + ")
			|И Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК Цены
			|ГДЕ Цены.Актуальность) КАК ЦеныСортировки ПО Найденные.Ссылка = ЦеныСортировки.Номенклатура";
	КонецЕсли;
	Источник = Источник + " ГДЕ " + Каталог + " И " + ОтборИтога;
	СчитатьВсего = РасширенныйСписок И Не ЕстьКурсор;
	ПоляСтраницы = "Номенклатура, Наименование, Артикул, Количество" + ?(ЕстьСортировкаПоЦене, ", ЦенаДляСортировки, ЕстьЦена", "");
	Запрос = Новый Запрос;
	Если СчитатьВсего Тогда
		Запрос.Текст = "ВЫБРАТЬ " + Поля + " ПОМЕСТИТЬ СписокНоменклатуры" + Источник
			+ "; ВЫБРАТЬ ПЕРВЫЕ 101 " + ПоляСтраницы + " ИЗ СписокНоменклатуры УПОРЯДОЧИТЬ ПО " + Порядок
			+ "; ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ СписокНоменклатуры";
	Иначе Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 101 " + Поля + Источник + " УПОРЯДОЧИТЬ ПО " + Порядок; КонецЕсли;
	Если ЕстьКурсор Тогда
		Запрос.УстановитьПараметр("ПослеНоменклатуры", Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(После.id)));
		Если ПолеСортировки = "quantity" Тогда
			Чтение = Новый ЧтениеJSON;
			Чтение.УстановитьСтроку(После.value);
			Попытка ЗначениеПосле = ПрочитатьJSON(Чтение, Ложь);
			Исключение Чтение.Закрыть(); ВызватьИсключение; КонецПопытки;
			Чтение.Закрыть();
			Если ТипЗнч(ЗначениеПосле) <> Тип("Число") Тогда ВызватьИсключение "Некорректный остаток курсора."; КонецЕсли;
			Если ЗначениеПосле < -1000000000000000 Или ЗначениеПосле > 1000000000000000 Тогда ВызватьИсключение "Некорректный остаток курсора."; КонецЕсли;
			Запрос.УстановитьПараметр("ПослеЗначения", ЗначениеПосле);
		ИначеЕсли ПолеСортировки = "price" Тогда
			Чтение = Новый ЧтениеJSON;
			Чтение.УстановитьСтроку(После.value);
			Попытка ЗначениеПосле = ПрочитатьJSON(Чтение, Ложь);
			Исключение Чтение.Закрыть(); ВызватьИсключение; КонецПопытки;
			Чтение.Закрыть();
			Если ТипЗнч(ЗначениеПосле) <> Тип("Структура") Тогда ВызватьИсключение "Некорректная цена курсора."; КонецЕсли;
			ЕстьЦенаПосле = Неопределено; ЦенаПосле = Неопределено;
			Если Не ЗначениеПосле.Свойство("hasPrice", ЕстьЦенаПосле) Или Не ЗначениеПосле.Свойство("amount", ЦенаПосле)
				Или ТипЗнч(ЕстьЦенаПосле) <> Тип("Булево") Или ТипЗнч(ЦенаПосле) <> Тип("Число")
				Или ЦенаПосле < 0 Или ЦенаПосле > 1000000000000 Или Не ЕстьЦенаПосле И ЦенаПосле <> 0 Тогда ВызватьИсключение "Некорректная цена курсора."; КонецЕсли;
			Запрос.УстановитьПараметр("ПослеЕстьЦены", ?(ЕстьЦенаПосле, 1, 0));
			Запрос.УстановитьПараметр("ПослеЗначения", ЦенаПосле);
		ИначеЕсли ПолеСортировки <> "id" Тогда Запрос.УстановитьПараметр("ПослеЗначения", После.value); КонецЕсли;
	КонецЕсли;
	Если ЕстьСортировкаПоЦене Тогда
		Запрос.УстановитьПараметр("ДатаЦенСортировки", ТекущаяДатаСеанса());
		Запрос.УстановитьПараметр("ВидЦенСортировки", ВидЦенДляСортировки);
	КонецЕсли;
	Для Каждого ПараметрПоиска Из ПараметрыПоиска Цикл Запрос.УстановитьПараметр(ПараметрПоиска.Ключ, ПараметрПоиска.Значение); КонецЦикла;
	Диагностика.Этап = "Чтение страницы номенклатуры";
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Всего = Неопределено;
	Если СчитатьВсего Тогда
		Пакет = Запрос.ВыполнитьПакет();
		Выборка = Пакет[1].Выбрать();
		Счетчик = Пакет[2].Выбрать(); Счетчик.Следующий(); Всего = Счетчик.Всего;
	Иначе Выборка = Запрос.Выполнить().Выбрать(); КонецЕсли;
	Товары = Новый Массив;
	Ссылки = Новый Массив;
	ЕстьЕще = Ложь;
	ПоследнееЗначение = Неопределено;
	Пока Выборка.Следующий() Цикл
		Если Товары.Количество() = 100 Тогда ЕстьЕще = Истина; Прервать; КонецЕсли;
		Ссылки.Добавить(Выборка.Номенклатура);
		Товары.Добавить(Новый Структура("id,name,article,quantity",
			НРег(Строка(Выборка.Номенклатура.УникальныйИдентификатор())),
			ПроверитьТекст(Выборка.Наименование, 500, Ложь, Истина), ПроверитьТекст(Выборка.Артикул, 50, Истина, Истина), Выборка.Количество));
		Если ПолеСортировки = "name" Тогда ПоследнееЗначение = Выборка.Наименование;
		ИначеЕсли ПолеСортировки = "article" Тогда ПоследнееЗначение = Выборка.Артикул;
		ИначеЕсли ПолеСортировки = "quantity" Тогда ПоследнееЗначение = Выборка.Количество;
		ИначеЕсли ПолеСортировки = "price" Тогда ПоследнееЗначение = Новый Структура("hasPrice,amount", Выборка.ЕстьЦена = 1, ?(Выборка.ЕстьЦена = 1, Выборка.ЦенаДляСортировки, 0)); КонецЕсли;
	КонецЦикла;
	Если (ПолеСортировки = "quantity" ИЛИ ПолеСортировки = "price") И Товары.Количество() > 0 Тогда
		Запись = Новый ЗаписьJSON; Запись.УстановитьСтроку(); ЗаписатьJSON(Запись, ПоследнееЗначение); ПоследнееЗначение = Запись.Закрыть();
	КонецЕсли;
	Результат = Новый Структура("products,hasMore,lastSortValue", Товары, ЕстьЕще, ПоследнееЗначение);
	Если СчитатьВсего Тогда
		Результат.Вставить("totalCount", Всего);
		Результат.Вставить("priceTypes", ВидыЦенДляСписка());
		ЗагрузитьНавигацию = Ложь;
		Если ПараметрыСписка.Свойство("navigation", ЗагрузитьНавигацию) И ЗагрузитьНавигацию Тогда
			Результат.Вставить("navigation", НавигацияНоменклатуры());
		КонецЕсли;
	КонецЕсли;
	Если РасширенныйСписок И ЗначениеЗаполнено(ПараметрыСписка.priceType) Тогда
		Диагностика.Этап = "Пакетное чтение цен номенклатуры";
		ЦеныСтраницы = ЦеныСтраницыНоменклатуры(Ссылки, ПараметрыСписка.priceType);
		Для Индекс = 0 По Товары.Количество() - 1 Цикл Товары[Индекс].Вставить("price", ЦеныСтраницы.Получить(Ссылки[Индекс])); КонецЦикла;
	КонецЕсли;
	ЗаписьЖурналаРегистрации("АС_Агрегатор.НоменклатураОстатки", УровеньЖурналаРегистрации.Информация, , ,
		СтрШаблон("Страница: %1 товаров; есть еще: %2; чтение и подготовка: %3 мс; остатки: один запрос/пакет; отбор: %4; порядок: %5 %6.",
			Товары.Количество(), ЕстьЕще, ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало, Наличие, ПолеСортировки, НаправлениеСортировки));
	Возврат Результат;
КонецФункции

Функция ШаблонПодстроки(Значение)
	Шаблон = СтрЗаменить(Значение, "~", "~~");
	Для Каждого СимволШаблона Из СтрРазделить("%,_,[,]", ",") Цикл
		Шаблон = СтрЗаменить(Шаблон, СимволШаблона, "~" + СимволШаблона);
	КонецЦикла;
	Возврат "%" + Шаблон + "%";
КонецФункции

Функция НавигацияНоменклатуры()
	Результат = Новый Структура("categories,groups,oemBrands", Новый Массив, Новый Массив, Новый Массив);
	Для Каждого Вид Из СтрРазделить("categories,groups,oemBrands", ",") Цикл
		Если Вид = "categories" Тогда ИмяСправочника = "КатегорииНоменклатуры"; Условие = "";
		ИначеЕсли Вид = "groups" Тогда ИмяСправочника = "Номенклатура"; Условие = " И Данные.ЭтоГруппа";
		Иначе ИмяСправочника = "АС_Автомобили"; Условие = " И Данные.ЭтоГруппа"; КонецЕсли;
		Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 5001 Данные.Ссылка КАК Ссылка, Данные.Наименование КАК Наименование, Данные.Родитель КАК Родитель, Данные.ЭтоГруппа КАК ЭтоГруппа
			|ИЗ Справочник." + ИмяСправочника + " КАК Данные ГДЕ НЕ Данные.ПометкаУдаления" + Условие + " УПОРЯДОЧИТЬ ПО Наименование, Ссылка");
		Выборка = Запрос.Выполнить().Выбрать();
		Строки = Результат[Вид];
		Пока Выборка.Следующий() Цикл
			Если Строки.Количество() = 5000 Тогда ВызватьИсключение "Слишком много элементов навигации номенклатуры."; КонецЕсли;
			Элемент = Новый Структура("id,name", НРег(Строка(Выборка.Ссылка.УникальныйИдентификатор())), ПроверитьТекст(Выборка.Наименование, 150, Ложь, Истина));
			Если Вид <> "oemBrands" Тогда
				Элемент.Вставить("parentId", ?(ЗначениеЗаполнено(Выборка.Родитель), НРег(Строка(Выборка.Родитель.УникальныйИдентификатор())), Неопределено));
				Элемент.Вставить("isFolder", Выборка.ЭтоГруппа);
			КонецЕсли;
			Строки.Добавить(Элемент);
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция НоменклатураПоOEM(OEM, ИдентификаторМарки)
	Результат = Новый Массив;
	КлючOEM = АС_ИндексOEMСервер.НормализоватьOEM(OEM);
	Если ЗначениеЗаполнено(OEM) И ПустаяСтрока(КлючOEM) Тогда Возврат Результат; КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ Данные.Ссылка КАК Номенклатура, Данные.OEM КАК OEM
		|ИЗ Справочник.Номенклатура.АС_OEMПоМаркам КАК Данные ГДЕ Данные.OEM <> """"");
	Если ЗначениеЗаполнено(OEM) Тогда
		АС_ИндексOEMСервер.ОбеспечитьИндекс();
		Запрос.Текст = Запрос.Текст + " И Данные.Ссылка В (ВЫБРАТЬ Индекс.Номенклатура ИЗ РегистрСведений.АС_ИндексOEMНоменклатуры КАК Индекс ГДЕ Индекс.КлючOEM = &КлючOEM)";
		Запрос.УстановитьПараметр("КлючOEM", КлючOEM);
	КонецЕсли;
	Если ЗначениеЗаполнено(ИдентификаторМарки) Тогда
		Запрос.Текст = Запрос.Текст + " И Данные.Марка = &Марка";
		Запрос.УстановитьПараметр("Марка", Справочники.АС_Автомобили.ПолучитьСсылку(Новый УникальныйИдентификатор(ИдентификаторМарки)));
	КонецЕсли;
	Добавленные = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(OEM) И АС_ИндексOEMСервер.НормализоватьOEM(Выборка.OEM) <> КлючOEM Тогда Продолжить; КонецЕсли;
		Если Добавленные.Получить(Выборка.Номенклатура) = Неопределено Тогда
			Добавленные.Вставить(Выборка.Номенклатура, Истина); Результат.Добавить(Выборка.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ВидыЦенДляСписка()
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1001 Виды.Ссылка КАК Ссылка, Виды.Наименование КАК Наименование
		|ИЗ Справочник.ВидыЦен КАК Виды ГДЕ НЕ Виды.ПометкаУдаления И НЕ Виды.Недействителен УПОРЯДОЧИТЬ ПО Наименование, Ссылка");
	Выборка = Запрос.Выполнить().Выбрать();
	Результат = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Если Результат.Количество() = 1000 Тогда ВызватьИсключение "Слишком много видов цен для списка."; КонецЕсли;
		Результат.Добавить(Новый Структура("id,name", НРег(Строка(Выборка.Ссылка.УникальныйИдентификатор())), ПроверитьТекст(Выборка.Наименование, 150, Ложь, Истина)));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ЦеныСтраницыНоменклатуры(Ссылки, ИдентификаторВида)
	Результат = Новый Соответствие;
	Если Ссылки.Количество() = 0 Тогда Возврат Результат; КонецЕсли;
	ВидЦен = Справочники.ВидыЦен.ПолучитьСсылку(Новый УникальныйИдентификатор(ИдентификаторВида));
	ПроверитьВидЦен(ВидЦен);
	Запрос = Новый Запрос("ВЫБРАТЬ Цены.Номенклатура, Цены.Цена,
		|ВЫБОР КОГДА Цены.ВалютаЦены <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
		|ТОГДА Цены.ВалютаЦены.Код ИНАЧЕ Цены.ВидЦен.ВалютаЦены.Код КОНЕЦ КАК КодВалюты,
		|Цены.ЕдиницаИзмерения.Наименование КАК Единица
		|ИЗ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&ДатаЦен, ВидЦен = &ВидЦен
		|И Номенклатура В (&Ссылки) И Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК Цены
		|ГДЕ Цены.Актуальность");
	Запрос.УстановитьПараметр("ДатаЦен", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("ВидЦен", ВидЦен);
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Выборка = Запрос.Выполнить().Выбрать();
	Коды = Новый Соответствие;
	Коды.Вставить("643", "RUB"); Коды.Вставить("840", "USD"); Коды.Вставить("978", "EUR");
	Коды.Вставить("156", "CNY"); Коды.Вставить("398", "KZT"); Коды.Вставить("933", "BYN");
	Коды.Вставить("826", "GBP"); Коды.Вставить("784", "AED"); Коды.Вставить("392", "JPY");
	Коды.Вставить("756", "CHF"); Коды.Вставить("949", "TRY");
	Пока Выборка.Следующий() Цикл
		Если Выборка.Цена < 0 Или Выборка.Цена > 1000000000000 Тогда ВызватьИсключение "Сохраненная цена находится вне допустимого диапазона."; КонецЕсли;
		Код = Коды.Получить(СокрЛП(Выборка.КодВалюты));
		Если Код = Неопределено Тогда ВызватьИсключение "Валюта цены не поддерживается обменом номенклатуры."; КонецЕсли;
		Результат.Вставить(Выборка.Номенклатура, Новый Структура("amount,currency,unit", Выборка.Цена, Код, ПроверитьТекст(Выборка.Единица, 100, Истина, Истина)));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ПроверитьВидЦен(ВидЦен) Экспорт
	Если ТипЗнч(ВидЦен) <> Тип("СправочникСсылка.ВидыЦен") Или Не ЗначениеЗаполнено(ВидЦен) Тогда
		ВызватьИсключение "Выберите закупочный, розничный и безналичный виды цен.";
	КонецЕсли;
	Если ВидЦен.ПометкаУдаления Или ВидЦен.Недействителен Тогда
		ВызватьИсключение "Для поиска номенклатуры выберите действующие виды цен.";
	КонецЕсли;
КонецПроцедуры

Функция ТекущаяЦена(Номенклатура, Характеристика, ВидЦен, ДатаЦен)
	ПроверитьВидЦен(ВидЦен);
	Запрос = Новый Запрос(
		"ВЫБРАТЬ Цены.Цена,
		|ВЫБОР КОГДА Цены.ВалютаЦены <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
		|ТОГДА Цены.ВалютаЦены ИНАЧЕ Цены.ВидЦен.ВалютаЦены КОНЕЦ КАК Валюта
		|ИЗ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&ДатаЦен,
		|ВидЦен = &ВидЦен И Номенклатура = &Номенклатура И Характеристика = &Характеристика) КАК Цены
		|ГДЕ Цены.Актуальность");
	Запрос.УстановитьПараметр("ДатаЦен", ДатаЦен);
	Запрос.УстановитьПараметр("ВидЦен", ВидЦен);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Характеристика", Характеристика);
	Выборка = Запрос.Выполнить().Выбрать();
	// Отсутствующая цена передаётся как JSON null; сохранённая нулевая цена остаётся числом 0.
	Если Не Выборка.Следующий() Тогда Возврат Неопределено; КонецЕсли;
	Если Выборка.Цена < 0 Или Выборка.Цена > 1000000000000 Тогда
		ВызватьИсключение "Сохраненная цена находится вне допустимого диапазона.";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Выборка.Валюта) Тогда
		ВызватьИсключение "У сохраненной цены не задана валюта.";
	КонецЕсли;
	// Цифровой код ОКВ устойчив к локальному названию рубля «руб.».
	КодыВалют = Новый Соответствие;
	КодыВалют.Вставить("643", "RUB");
	КодыВалют.Вставить("840", "USD");
	КодыВалют.Вставить("978", "EUR");
	КодыВалют.Вставить("156", "CNY");
	КодыВалют.Вставить("398", "KZT");
	КодыВалют.Вставить("933", "BYN");
	КодыВалют.Вставить("826", "GBP");
	КодыВалют.Вставить("784", "AED");
	КодыВалют.Вставить("392", "JPY");
	КодыВалют.Вставить("756", "CHF");
	КодыВалют.Вставить("949", "TRY");
	КодВалюты = КодыВалют.Получить(СокрЛП(Выборка.Валюта.Код));
	Если КодВалюты = Неопределено Тогда
		ВызватьИсключение "Валюта сохраненной цены не поддерживается обменом номенклатуры.";
	КонецЕсли;
	Возврат Новый Структура("amount,currency", Выборка.Цена, КодВалюты);
КонецФункции

Функция ПроверитьТекст(Знач Значение, Максимум, РазрешитьПустое = Ложь, ДляОтображения = Ложь)
	// Работаем с копией. Поля справочников не записываются и товары не пропускаются.
	Значение = СокрЛП(Значение);
	Если СтрДлина(Значение) > Максимум Тогда
		ВызватьИсключение "Некорректное наименование товара или характеристики.";
	КонецЕсли;
	Фрагменты = Неопределено;
	НачалоФрагмента = 1;
	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Код = КодСимвола(Значение, Индекс);
		Если Код < 32 Или (Код >= 127 И Код <= 159) Тогда
			// Строка поиска остаётся строгой. Только отображаемые реквизиты очищаются.
			Если Не ДляОтображения Тогда ВызватьИсключение "Текст содержит управляющие символы."; КонецЕсли;
			Если Фрагменты = Неопределено Тогда Фрагменты = Новый Массив; КонецЕсли;
			Фрагмент = СокрЛП(Сред(Значение, НачалоФрагмента, Индекс - НачалоФрагмента));
			Если ЗначениеЗаполнено(Фрагмент) Тогда Фрагменты.Добавить(Фрагмент); КонецЕсли;
			НачалоФрагмента = Индекс + 1;
		КонецЕсли;
	КонецЦикла;
	Если Фрагменты <> Неопределено Тогда
		Фрагмент = СокрЛП(Сред(Значение, НачалоФрагмента));
		Если ЗначениеЗаполнено(Фрагмент) Тогда Фрагменты.Добавить(Фрагмент); КонецЕсли;
		Значение = СтрСоединить(Фрагменты, " ");
	КонецЕсли;
	Если Не РазрешитьПустое И Не ЗначениеЗаполнено(Значение) Тогда
		ВызватьИсключение "Пустое наименование товара или характеристики после подготовки текста.";
	КонецЕсли;
	Возврат Значение;
КонецФункции
