Функция ПечатьЭтикетокИзПриходнойНакладной(ПараметрКоманды) Экспорт

	Если ПараметрКоманды.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Не АС_ПоступлениеЗаказовПоставщикамСервер.ЕстьСмешанныеТоварыДляПечатиЭтикеток(
		ПараметрКоманды.ОбъектыПечати) Тогда
		Возврат ПечатьДокументовУНФКлиент.ПечатьЭтикетокИЦенниковИзДокументов(ПараметрКоманды);
	КонецЕсли;

	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить(
		"ТолькоМагазин",
		"Печатать этикетки только для товаров в магазине");
	Кнопки.Добавить(
		"ВсеТовары",
		"Печатать этикетки для всех товаров");

	ПоказатьВопрос(
		Новый ОписаниеОповещения(
			"ВыборТоваровДляПечатиЭтикетокЗавершение",
			ЭтотОбъект,
			ПараметрКоманды),
		"В приходной накладной есть товары для заказов покупателей и товары для магазина. Для каких товаров напечатать этикетки?",
		Кнопки,
		,
		"ВсеТовары");

	Возврат Неопределено;

КонецФункции

Процедура ВыборТоваровДляПечатиЭтикетокЗавершение(Ответ, ПараметрКоманды) Экспорт

	Если Ответ <> "ТолькоМагазин" Тогда
		ПечатьДокументовУНФКлиент.ПечатьЭтикетокИЦенниковИзДокументов(ПараметрКоманды);
		Возврат;
	КонецЕсли;

	ИспользоватьНовуюПечать = Не ПечатьДокументовУНФВызовСервера.ВыключеноИспользованиеНовойПечатиЦенников();
	АдресВХранилище = АС_ПоступлениеЗаказовПоставщикамСервер.ПодготовитьДанныеПечатиЭтикетокТолькоДляМагазина(
		ПараметрКоманды.ОбъектыПечати);

	ПараметрыФормы = Новый Структура("АдресВХранилище", АдресВХранилище);
	Если ИспользоватьНовуюПечать Тогда
		ПараметрыФормы.Вставить("РежимПечати", "ПечатьЭтикеток");
		ОткрытьФорму(
			"Обработка.ПечатьЭтикетокИЦенниковБПО.Форма.Форма",
			ПараметрыФормы,
			,
			Новый УникальныйИдентификатор);
	Иначе
		ОткрытьФорму(
			"Обработка.ПечатьЭтикетокИЦенников.Форма.Форма",
			ПараметрыФормы,
			,
			Новый УникальныйИдентификатор);
	КонецЕсли;

КонецПроцедуры
