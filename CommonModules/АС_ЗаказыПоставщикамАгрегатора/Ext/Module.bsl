Функция Прочитать(Параметры, Диагностика) Экспорт

	Диагностика.Этап = "Чтение заказов поставщикам";
	Если ТипЗнч(Параметры) <> Тип("Структура") Или Не Параметры.Свойство("view") Тогда
		ВызватьИсключение "Не задан вид чтения заказов поставщикам.";
	КонецЕсли;
	Если Параметры.view = "list" Или Параметры.view = "listPage" Тогда
		Возврат СписокЗаказов(Параметры);
	КонецЕсли;
	Если Параметры.view = "counterparties" Тогда
		Возврат КонтрагентыДляЗаказов(Параметры);
	КонецЕсли;
	Если Параметры.view <> "order" Тогда
		ВызватьИсключение "Неизвестный вид чтения заказов поставщикам.";
	КонецЕсли;
	Ссылка = СсылкаЗаказа(Параметры.id);
	Возврат СоставЗаказа(Ссылка, Параметры.id, Диагностика);

КонецФункции

Функция КонтрагентыДляЗаказов(Параметры)
	Запрос = Новый Запрос;
	Условие = "";
	Если Параметры.id <> Неопределено И Параметры.id <> Null Тогда
		Запрос.УстановитьПараметр("Ссылка", Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(Параметры.id)));
		Условие = " И Ссылка = &Ссылка";
	ИначеЕсли Не ПустаяСтрока(Параметры.query) Тогда
		ТекстПоиска = СтрЗаменить(Параметры.query, "~", "~~");
		Для Каждого СимволПоиска Из СтрРазделить("%,_,[,]", ",") Цикл
			ТекстПоиска = СтрЗаменить(ТекстПоиска, СимволПоиска, "~" + СимволПоиска);
		КонецЦикла;
		Запрос.УстановитьПараметр("Поиск", "%" + ТекстПоиска + "%");
		Условие = " И (Наименование ПОДОБНО &Поиск СПЕЦСИМВОЛ ""~"" ИЛИ ИНН ПОДОБНО &Поиск СПЕЦСИМВОЛ ""~"")";
	КонецЕсли;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 50 Ссылка, Наименование, ИНН
		|ИЗ Справочник.Контрагенты
		|ГДЕ НЕ ПометкаУдаления И НЕ ЭтоГруппа И Поставщик" + Условие + "
		|УПОРЯДОЧИТЬ ПО Наименование, Ссылка";
	Контрагенты = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Имя = ТекстДляОтображения(Выборка.Наименование);
		Если Не ПустаяСтрока(Имя) Тогда
			Контрагенты.Добавить(Новый Структура("id,name,taxId", Строка(Выборка.Ссылка.УникальныйИдентификатор()),
				Имя, ТекстДляОтображения(Выборка.ИНН)));
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("view,counterparties", "counterparties", Контрагенты);
КонецФункции

Функция СсылкаЗаказа(Идентификатор)

	Если ТипЗнч(Идентификатор) <> Тип("Строка") Или СтрДлина(Идентификатор) <> 36
		Или Идентификатор = "00000000-0000-0000-0000-000000000000" Тогда
		ВызватьИсключение "Некорректная ссылка заказа поставщику.";
	КонецЕсли;
	Возврат Документы.ЗаказПоставщику.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));

КонецФункции

Функция УсловиеРабочегоЗаказа()

	Возврат "НЕ Заказы.ПометкаУдаления
		|И Заказы.ВариантЗавершения = ЗНАЧЕНИЕ(Перечисление.ВариантыЗавершенияЗаказа.ПустаяСсылка)
		|И Заказы.СостояниеЗаказа.Наименование = &ВРаботе";

КонецФункции

Функция ВыражениеПоставщика()

	Возврат "ВЫБОР КОГДА Заказы.Контрагент.Наименование = ""Рынок""
		|И ЕСТЬNULL(Заказы.Договор.Наименование, """") <> """"
		|И Заказы.Договор.Наименование <> ""Основной договор""
		|ТОГДА Заказы.Договор.Наименование
		|ИНАЧЕ ЕСТЬNULL(Заказы.Контрагент.Наименование, """") КОНЕЦ";

КонецФункции

Функция ВыражениеПокупателя()

	Возврат "ВЫБОР КОГДА ЕСТЬNULL(Заказы.ЗаказПокупателя.Контрагент.Наименование, """") <> """"
		|ТОГДА Заказы.ЗаказПокупателя.Контрагент.Наименование
		|ИНАЧЕ ЕСТЬNULL(Заказы.ЗаказПокупателя.Номер, """") КОНЕЦ";

КонецФункции

Функция ПоляШапки(ЭтоСписок = Ложь)

	Поля = "Заказы.Ссылка КАК Ссылка, Заказы.Номер КАК Номер, Заказы.Дата КАК Дата,
		|ЕСТЬNULL(Заказы.ВалютаДокумента.Код, """") КАК Валюта, "
		+ ВыражениеПокупателя() + " КАК Покупатель, ";
	Если ЭтоСписок Тогда
		Возврат Поля + ВыражениеПоставщика() + " КАК Поставщик";
	КонецЕсли;
	Возврат Поля + "ЕСТЬNULL(Заказы.Контрагент.Наименование, """") КАК Поставщик,
		|Заказы.Контрагент КАК Контрагент, ЕСТЬNULL(Заказы.Договор.Наименование, """") КАК Договор";

КонецФункции

Функция УсловиеПоиска(Запрос, Поиск)

	Если ТипЗнч(Поиск) <> Тип("Строка") Или СтрДлина(Поиск) > 100 Тогда
		ВызватьИсключение "Некорректная строка поиска заказа поставщику.";
	КонецЕсли;
	ВыражениеДоговора = ВыражениеПоставщика();
	Условия = Новый Массив;
	Для Каждого Слово Из СтрРазделить(Поиск, " ", Ложь) Цикл
		Шаблон = СтрЗаменить(Слово, "~", "~~");
		Для Каждого Спецсимвол Из СтрРазделить("%,_,[,]", ",") Цикл
			Шаблон = СтрЗаменить(Шаблон, Спецсимвол, "~" + Спецсимвол);
		КонецЦикла;
		Имя = "Поиск" + Формат(Условия.Количество() + 1, "ЧГ=0");
		Запрос.УстановитьПараметр(Имя, "%" + Шаблон + "%");
		УсловиеШаблона = " ПОДОБНО &" + Имя + " СПЕЦСИМВОЛ ""~""";
		Условия.Добавить(" И (Заказы.Номер" + УсловиеШаблона
			+ " ИЛИ Заказы.Контрагент.Наименование" + УсловиеШаблона
			+ " ИЛИ (" + ВыражениеДоговора + ")" + УсловиеШаблона
			+ " ИЛИ Заказы.ЗаказПокупателя.Контрагент.Наименование" + УсловиеШаблона
			+ " ИЛИ Заказы.ЗаказПокупателя.Номер" + УсловиеШаблона + ")");
	КонецЦикла;
	Возврат СтрСоединить(Условия, "");

КонецФункции

Функция ТекстСуммЗаказов(ИмяТаблицы)

	Возврат "ВЫБРАТЬ РАЗРЕШЕННЫЕ Строки.Ссылка КАК Ссылка,
		|СУММА(Строки.Всего) КАК Сумма
		|ПОМЕСТИТЬ АС_СуммыЗаказовПоставщикам
		|ИЗ " + ИмяТаблицы + " КАК Кандидаты
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику.Запасы КАК Строки
		|	ПО Строки.Ссылка = Кандидаты.Ссылка
		|ГДЕ Строки.Цена <> 0
		|	И Строки.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)
		|СГРУППИРОВАТЬ ПО Строки.Ссылка
		|ИНДЕКСИРОВАТЬ ПО Ссылка;
		|";

КонецФункции

Функция УсловиеПослеЗаказа(Запрос, После, Ключ, Поле, Сравнение, РасширенныйСписок)

	Если После = Неопределено Или ТипЗнч(После) = Тип("Null") Тогда
		Возврат "";
	КонецЕсли;
	Запрос.УстановитьПараметр("ПослеСсылки", СсылкаЗаказа(После.id));
	ТаЖеСтрокаПорядка = " И Заказы.Ссылка " + Сравнение + " &ПослеСсылки";
	ЗначениеКлюча = ?(РасширенныйСписок, После.value, После.date);
	БезСуммы = Ключ + " ЕСТЬ NULL";
	Если Поле = "amount" И (ЗначениеКлюча = Неопределено Или ТипЗнч(ЗначениеКлюча) = Тип("Null")) Тогда
		Возврат " И (" + БезСуммы + ТаЖеСтрокаПорядка + ")";
	КонецЕсли;
	Если Поле = "date" Тогда
		ДатаКурсора = СтрЗаменить(СтрЗаменить(СтрЗаменить(ЗначениеКлюча, "-", ""), "T", ""), ":", "");
		ЗначениеКлюча = Дата(ДатаКурсора);
	КонецЕсли;
	Запрос.УстановитьПараметр("ПослеЗначения", ЗначениеКлюча);
	Возврат " И (" + ?(Поле = "amount", БезСуммы + " ИЛИ ", "")
		+ Ключ + " " + Сравнение + " &ПослеЗначения"
		+ " ИЛИ (" + Ключ + " = &ПослеЗначения" + ТаЖеСтрокаПорядка + "))";

КонецФункции

Функция СписокЗаказов(Параметры)

	Запрос = Новый Запрос;
	РасширенныйСписок = Параметры.view = "listPage";
	Поле = ?(РасширенныйСписок, Параметры.sort, "date");
	Направление = ?(РасширенныйСписок, Параметры.direction, "desc");
	Если Направление <> "asc" И Направление <> "desc" Тогда
		ВызватьИсключение "Неизвестное направление сортировки заказов поставщикам.";
	КонецЕсли;
	Поля = Новый Структура("date,number,supplier,buyer,amount",
		"Заказы.Дата", "Заказы.Номер", ВыражениеПоставщика(), ВыражениеПокупателя(), "Суммы.Сумма");
	Ключ = "";
	Если Не Поля.Свойство(Поле, Ключ) Тогда
		ВызватьИсключение "Неизвестное поле сортировки заказов поставщикам.";
	КонецЕсли;
	Сравнение = ?(Направление = "asc", ">", "<");
	КлючСортировки = "КлючСортировки" + ?(Направление = "asc", "", " УБЫВ");
	СсылкаСортировки = "Ссылка" + ?(Направление = "asc", "", " УБЫВ");
	Условие = УсловиеРабочегоЗаказа();
	Если РасширенныйСписок Тогда
		Условие = Условие + УсловиеПоиска(Запрос, Параметры.query);
	КонецЕсли;
	Запрос.УстановитьПараметр("ВРаботе", СостоянияЗаказов.СостояниеВРаботе());
	Источник = "Документ.ЗаказПоставщику КАК Заказы";
	ТекстПакета = "";
	ПризнакБезСуммы = "";
	ПорядокБезСуммы = "";
	Если Поле = "amount" Тогда
		// Для сортировки по сумме нужны суммы всех подходящих заказов.
		ТекстПакета = "ВЫБРАТЬ РАЗРЕШЕННЫЕ Заказы.Ссылка КАК Ссылка
			|ПОМЕСТИТЬ АС_КандидатыЗаказовПоставщикам
			|ИЗ " + Источник + "
			|ГДЕ " + Условие + "
			|ИНДЕКСИРОВАТЬ ПО Ссылка;
			|" + ТекстСуммЗаказов("АС_КандидатыЗаказовПоставщикам");
		Источник = "АС_КандидатыЗаказовПоставщикам КАК Заказы
			|ЛЕВОЕ СОЕДИНЕНИЕ АС_СуммыЗаказовПоставщикам КАК Суммы ПО Суммы.Ссылка = Заказы.Ссылка";
		Условие = "ИСТИНА";
		ПризнакБезСуммы = ", ВЫБОР КОГДА Суммы.Сумма ЕСТЬ NULL ТОГДА 1 ИНАЧЕ 0 КОНЕЦ КАК БезСуммы";
		ПорядокБезСуммы = "БезСуммы, ";
	КонецЕсли;
	Условие = Условие + УсловиеПослеЗаказа(Запрос, Параметры.after, Ключ, Поле, Сравнение, РасширенныйСписок);
	ТекстПакета = ТекстПакета + "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 51 Заказы.Ссылка КАК Ссылка, "
		+ Ключ + " КАК КлючСортировки" + ПризнакБезСуммы + "
		|ПОМЕСТИТЬ АС_СтраницаЗаказовПоставщикам
		|ИЗ " + Источник + "
		|ГДЕ " + Условие + "
		|УПОРЯДОЧИТЬ ПО " + ПорядокБезСуммы + КлючСортировки + ", " + СсылкаСортировки + "
		|ИНДЕКСИРОВАТЬ ПО Ссылка;
		|";
	Если Поле <> "amount" Тогда
		ТекстПакета = ТекстПакета + ТекстСуммЗаказов("АС_СтраницаЗаказовПоставщикам");
	КонецЕсли;
	ПоляСтраницы = ", Страница.КлючСортировки КАК КлючСортировки";
	Если Поле = "amount" Тогда
		ПоляСтраницы = ПоляСтраницы + ", Страница.БезСуммы КАК БезСуммы";
	КонецЕсли;
	Запрос.Текст = ТекстПакета + "ВЫБРАТЬ РАЗРЕШЕННЫЕ " + ПоляШапки(Истина)
		+ ", Суммы.Сумма КАК Сумма" + ПоляСтраницы + "
		|ИЗ АС_СтраницаЗаказовПоставщикам КАК Страница
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику КАК Заказы
		|	ПО Заказы.Ссылка = Страница.Ссылка
		|	ЛЕВОЕ СОЕДИНЕНИЕ АС_СуммыЗаказовПоставщикам КАК Суммы
		|	ПО Суммы.Ссылка = Страница.Ссылка
		|УПОРЯДОЧИТЬ ПО " + ПорядокБезСуммы + КлючСортировки + ", " + СсылкаСортировки;
	Выборка = Запрос.Выполнить().Выбрать();
	Заказы = Новый Массив;
	ПоследнееЗначение = Неопределено;
	Пока Выборка.Следующий() Цикл
		Если Заказы.Количество() = 50 Тогда
			Страница = Новый Структура("view,orders,hasMore", Параметры.view, Заказы, Истина);
			Если РасширенныйСписок Тогда
				Страница.Вставить("lastValue", ПоследнееЗначение);
			КонецЕсли;
			Возврат Страница;
		КонецЕсли;
		Сумма = ?(ТипЗнч(Выборка.Сумма) = Тип("Число"), Выборка.Сумма, Неопределено);
		Заказы.Добавить(ШапкаЗаказа(Выборка, Сумма));
		Если РасширенныйСписок И Заказы.Количество() = 50 Тогда
			ПоследнееЗначение = ?(Поле = "date", ДатаЗаказа(Выборка.Дата),
				?(Поле = "amount", Сумма, Выборка.КлючСортировки));
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("view,orders,hasMore", Параметры.view, Заказы, Ложь);

КонецФункции

Функция СоставЗаказа(Ссылка, Идентификатор, Диагностика)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Заказ", Ссылка);
	Запрос.УстановитьПараметр("ВРаботе", СостоянияЗаказов.СостояниеВРаботе());
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ " + ПоляШапки() + ",
		|Заказы.Организация КАК Организация, Заказы.УчетПотребностиПоСкладам КАК УчетПотребностиПоСкладам
		|ПОМЕСТИТЬ АС_ЗаказПоставщику
		|ИЗ Документ.ЗаказПоставщику КАК Заказы
		|ГДЕ Заказы.Ссылка = &Заказ И " + УсловиеРабочегоЗаказа() + ";
		|
		|ВЫБРАТЬ * ИЗ АС_ЗаказПоставщику;
		|
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ Строки.НомерСтроки КАК НомерСтроки,
		|Строки.Номенклатура.Наименование КАК Наименование,
		|Строки.Номенклатура.Артикул КАК Артикул, Строки.Количество КАК Количество,
		|Строки.Номенклатура КАК Номенклатура, Строки.Характеристика КАК Характеристика,
		|Строки.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|Строки.СтруктурнаяЕдиницаРезерв КАК СтруктурнаяЕдиницаРезерв,
		|Строки.Цена КАК Цена, Строки.Сумма КАК Сумма, Строки.Всего КАК Всего,
		|Строки.АС_КоличествоДнейНаВозврат КАК ДнейНаВозврат,
		|ВЫБОР КОГДА Строки.Ссылка.ПоложениеДатыПоступления =
		|	ЗНАЧЕНИЕ(Перечисление.ПоложениеРеквизитаНаФорме.ВТабличнойЧасти)
		|ТОГДА Строки.ДатаПоступления ИНАЧЕ Строки.Ссылка.ДатаПоступления КОНЕЦ КАК ДатаПоступления
		|ИЗ АС_ЗаказПоставщику КАК Заказ
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику.Запасы КАК Строки
		|	ПО Строки.Ссылка = Заказ.Ссылка
		|ГДЕ Строки.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)
		|УПОРЯДОЧИТЬ ПО НомерСтроки";
	Пакет = Запрос.ВыполнитьПакет();
	Шапка = Пакет[1].Выбрать();
	Карточка = Неопределено;
	Если Шапка.Следующий() Тогда
		Строки = Пакет[2].Выгрузить();
		Карточка = ПодробностиЗаказа(Шапка, Строки, Диагностика);
	КонецЕсли;
	Возврат Новый Структура("view,id,order", "order", Идентификатор, Карточка);

КонецФункции

Функция ПодробностиЗаказа(Шапка, Строки, Диагностика)

	Рынок = ЭтоРынок(Шапка);
	СрокВозврата = ?(Рынок, 0, АС_УсловияВозвратаПоставщикамСервер.ФиксированныйСрокВозврата(Шапка.Контрагент));
	Товары = Новый Массив;
	Всего = Неопределено;
	Если Строки.Количество() > 0 Тогда
		Диагностика.Этап = "Поступление по заказу поставщику";
		Строки.Колонки.Добавить("АС_Поступление");
		ДанныеПоступления = Новый Структура("Ссылка,Запасы,УчетПотребностиПоСкладам",
			Шапка.Ссылка, Строки, Шапка.УчетПотребностиПоСкладам);
		АС_ПоступлениеЗаказовПоставщикамСервер.ЗаполнитьСтатусыПоступления(ДанныеПоступления);

		Диагностика.Этап = "Остатки товаров заказа поставщику";
		Остатки = Неопределено;
		Если ЗначениеЗаполнено(Шапка.Организация) Тогда
			СтрокиРасчета = Новый Массив;
			Для Каждого СтрокаЗапасов Из Строки Цикл
				СтрокиРасчета.Добавить(Новый Структура(
					"Номенклатура,Характеристика,ЕдиницаИзмерения,НеОтгружено,ИспользоватьВРасчете",
					СтрокаЗапасов.Номенклатура, СтрокаЗапасов.Характеристика, СтрокаЗапасов.ЕдиницаИзмерения,
					0, Истина));
			КонецЦикла;
			Остатки = АС_ДоступностьТоваровСервер.РассчитатьСЗаменами(СтрокиРасчета, Шапка.Организация,
				Документы.ЗаказПокупателя.ПустаяСсылка());
		КонецЕсли;
		Для Индекс = 0 По Строки.Количество() - 1 Цикл
			СтрокаЗапасов = Строки[Индекс];
			Позиция = ПозицияЗаказа(СтрокаЗапасов);
			Если ЗначениеЗаполнено(СтрокаЗапасов.Номенклатура) Тогда
				Позиция.Вставить("productId", НРег(Строка(СтрокаЗапасов.Номенклатура.УникальныйИдентификатор())));
			КонецЕсли;
			ЕстьЦена = СтрокаЗапасов.Цена <> 0;
			Позиция.Вставить("price", ?(Рынок Или Не ЕстьЦена, Неопределено, СтрокаЗапасов.Цена));
			Позиция.Вставить("amount", ?(Рынок Или Не ЕстьЦена, Неопределено, СтрокаЗапасов.Сумма));
			Позиция.Вставить("stock", ?(Остатки = Неопределено, 0, Остатки[Индекс].Доступно));
			Если Остатки <> Неопределено Тогда
				Позиция.Вставить("stockDetails", АС_НоменклатураАгрегатора.ОстатокДляАгрегатора(
					Остатки[Индекс].Оригинал, Остатки[Индекс].Замены));
			КонецЕсли;
			Позиция.Вставить("returnDays", ?(Рынок, 0, ?(СрокВозврата > 0, СрокВозврата, СтрокаЗапасов.ДнейНаВозврат)));
			ДатаПоступления = СтрокаЗапасов.ДатаПоступления;
			Позиция.Вставить("expectedDate", ?(Не Рынок И ЗначениеЗаполнено(ДатаПоступления) И ДатаПоступления < Дата(3999, 12, 31),
				Формат(ДатаПоступления, "ДФ=yyyy-MM-dd"), Неопределено));
			Позиция.Вставить("receipt", СтрокаЗапасов.АС_Поступление);
			Товары.Добавить(Позиция);
			Если ЕстьЦена Тогда
				Всего = ?(Всего = Неопределено, 0, Всего) + СтрокаЗапасов.Всего;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Результат = ШапкаЗаказа(Шапка, Всего);
	Результат.Вставить("market", Рынок);
	Результат.Вставить("contract", ДоговорРынка(Шапка));
	Результат.Вставить("products", Товары);
	Возврат Результат;

КонецФункции

Функция ЭтоРынок(Шапка)
	Возврат НРег(СокрЛП(Шапка.Поставщик)) = "рынок";
КонецФункции

Функция ДоговорРынка(Шапка)
	Договор = ТекстДляОтображения(Шапка.Договор);
	Возврат ?(ЭтоРынок(Шапка) И НРег(Договор) <> "основной договор", Договор, "");
КонецФункции

Функция ШапкаЗаказа(Шапка, Сумма)
	Возврат Новый Структура("id,number,date,supplier,buyer,amount,currency",
		НРег(Строка(Шапка.Ссылка.УникальныйИдентификатор())), СокрЛП(Шапка.Номер),
		ДатаЗаказа(Шапка.Дата),
		ТекстДляОтображения(Шапка.Поставщик), ТекстДляОтображения(Шапка.Покупатель), Сумма, СокрЛП(Шапка.Валюта));
КонецФункции

Функция ДатаЗаказа(Значение)
	Возврат Формат(Значение, "ДФ=yyyy-MM-dd") + "T" + Формат(Значение, "ДФ=HH:mm:ss");
КонецФункции

Функция ПозицияЗаказа(СтрокаЗапасов)
	Возврат Новый Структура("name,article,quantity", ТекстДляОтображения(СтрокаЗапасов.Наименование),
		ТекстДляОтображения(СтрокаЗапасов.Артикул), СтрокаЗапасов.Количество);
КонецФункции

Функция ТекстДляОтображения(Значение)
	Возврат СокрЛП(СтрЗаменить(СтрЗаменить(СтрЗаменить(Значение, Символы.ВК, " "), Символы.ПС, " "), Символы.Таб, " "));
КонецФункции
