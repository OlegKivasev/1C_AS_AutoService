Функция ФиксированныйСрокВозврата(Контрагент) Экспорт

	// ИНН сохраняет привязку к поставщику при переименовании карточки.
	Если ЗначениеЗаполнено(Контрагент)
		И СокрЛП(Контрагент.ИНН) = "7743666731" Тогда
		Возврат 10;
	КонецЕсли;

	Возврат 0;

КонецФункции

Процедура УстановитьФиксированныйСрокВозврата(ЗаказПоставщику) Экспорт

	СрокВозврата = ФиксированныйСрокВозврата(ЗаказПоставщику.Контрагент);
	Если СрокВозврата = 0 Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаЗапаса Из ЗаказПоставщику.Запасы Цикл
		Если СтрокаЗапаса.АС_КоличествоДнейНаВозврат <> СрокВозврата Тогда
			СтрокаЗапаса.АС_КоличествоДнейНаВозврат = СрокВозврата;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Возврат через списание не хранит ссылку на поступление и заказ клиента.
// Распределяем его FIFO среди поступлений на тот же склад и учитываем
// прочее нетто-выбытие из регистра запасов (продажи, чеки, списания и т.д.).
// Перенос резерва внутри склада даёт нулевое нетто и не расходует слой.
// Затем выбираем оставшиеся поступления актуальных источников строки.
// Не переносим непокрытый возврат на будущие поступления.
Функция ПолучитьСрокиВозврата(ЗаказПокупателя, СтрокиЗапасов, СвязиПоставок) Экспорт

	ЗаказыПокупателей = Новый Массив;
	Если ЗначениеЗаполнено(ЗаказПокупателя) Тогда
		ЗаказыПокупателей.Добавить(ЗаказПокупателя);
	КонецЕсли;
	ДанныеРасчета = ПодготовитьДанныеСроковВозврата(ЗаказыПокупателей, СтрокиЗапасов, СвязиПоставок);
	Возврат СрокиВозвратаПоДанным(ЗаказПокупателя, СтрокиЗапасов, СвязиПоставок, ДанныеРасчета);

КонецФункции

// Для порции динамического списка поступления и выбытия читаются один раз.
// Карточка документа и список используют одинаковые источники и остатки слоёв.
Функция ПолучитьСрокиВозвратаЗаказов(ЗаказыПокупателей) Экспорт

	Результат = Новый Соответствие;
	Если ЗаказыПокупателей.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ Строки.Ссылка, Строки.НомерСтроки,
	|Строки.Номенклатура, Строки.Характеристика, Строки.Количество,
	|Строки.АС_ЗаказПоставщику, Строки.АС_КлючСвязиЗаказаПоставщику,
	|Строки.АС_ИдентификаторГруппыПоставок
	|ИЗ Документ.ЗаказПокупателя.Запасы КАК Строки
	|ГДЕ Строки.Ссылка В (&ЗаказыПокупателей) И Строки.Количество > 0
	|;
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ Связи.Ссылка, Связи.ИдентификаторСтрокиПокупателя,
	|Связи.Количество, Связи.ЗаказПоставщику, Связи.КлючСвязиЗаказаПоставщику
	|ИЗ Документ.ЗаказПокупателя.АС_ИсточникиПоставок КАК Связи
	|ГДЕ Связи.Ссылка В (&ЗаказыПокупателей) И Связи.Количество > 0");
	Запрос.УстановитьПараметр("ЗаказыПокупателей", ЗаказыПокупателей);
	Пакет = Запрос.ВыполнитьПакет();
	СтрокиЗапасов = Пакет[0].Выгрузить();
	СвязиПоставок = Пакет[1].Выгрузить();
	СтрокиЗапасов.Индексы.Добавить("Ссылка");
	СвязиПоставок.Индексы.Добавить("Ссылка");
	ДанныеРасчета = ПодготовитьДанныеСроковВозврата(ЗаказыПокупателей, СтрокиЗапасов, СвязиПоставок);
	Для Каждого ЗаказПокупателя Из ЗаказыПокупателей Цикл
		Отбор = Новый Структура("Ссылка", ЗаказПокупателя);
		СрокиСтрок = СрокиВозвратаПоДанным(ЗаказПокупателя,
			СтрокиЗапасов.НайтиСтроки(Отбор), СвязиПоставок.НайтиСтроки(Отбор), ДанныеРасчета);
		Для Каждого СрокСтроки Из СрокиСтрок Цикл
			КоличествоДней = Результат.Получить(ЗаказПокупателя);
			Если КоличествоДней = Неопределено Или СрокСтроки.Значение < КоличествоДней Тогда
				Результат.Вставить(ЗаказПокупателя, СрокСтроки.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Оформление применяется к уже рассчитанной порции списка, без старого
// агрегата по всем историческим поступлениям в запросе динамического списка.
Процедура УстановитьИндикациюСроковВозврата(СтрокиСписка, ЗавершенноеСостояние) Экспорт

	ЗаказыПокупателей = Новый Массив;
	Для Каждого СтрокаСписка Из СтрокиСписка Цикл
		СтрокаСписка = СтрокиСписка[СтрокаСписка.Ключ];
		Если Не СтрокаСписка.Данные.Свойство("Ссылка")
			Или Не СтрокаСписка.Данные.Свойство("СостояниеЗаказа")
			Или СтрокаСписка.Данные.СостояниеЗаказа = ЗавершенноеСостояние Тогда
			Продолжить;
		КонецЕсли;
		Если ЗаказыПокупателей.Найти(СтрокаСписка.Данные.Ссылка) = Неопределено Тогда
			ЗаказыПокупателей.Добавить(СтрокаСписка.Данные.Ссылка);
		КонецЕсли;
	КонецЦикла;
	СрокиВозврата = ПолучитьСрокиВозвратаЗаказов(ЗаказыПокупателей);
	Для Каждого СтрокаСписка Из СтрокиСписка Цикл
		СтрокаСписка = СтрокиСписка[СтрокаСписка.Ключ];
		Если Не СтрокаСписка.Данные.Свойство("Ссылка") Тогда
			Продолжить;
		КонецЕсли;
		КоличествоДней = СрокиВозврата.Получить(СтрокаСписка.Данные.Ссылка);
		Если КоличествоДней = Неопределено Или КоличествоДней > 5 Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ИмяПоля Из СтрРазделить("Контрагент,КонтрагентИлиЛид", ",") Цикл
			ОформлениеПоля = СтрокаСписка.Оформление.Получить(ИмяПоля);
			Если ОформлениеПоля <> Неопределено Тогда
				ОформлениеПоля.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(255, 224, 224));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция ПодготовитьДанныеСроковВозврата(ЗаказыПокупателей, СтрокиЗапасов, СвязиПоставок)

	Результат = Новый Структура("СтрокиПоставщиков,Слои,Сегодня,СлоиПоНоменклатуре",
		Новый Массив, Новый Массив, НачалоДня(ТекущаяДатаСеанса()), Новый Соответствие);
	Номенклатура = Новый Массив;
	ЗаказыПоставщикам = Новый Массив;
	Для Каждого СтрокаЗапаса Из СтрокиЗапасов Цикл
		Если ТипЗнч(СтрокаЗапаса.Номенклатура) = Тип("СправочникСсылка.Номенклатура")
			И ЗначениеЗаполнено(СтрокаЗапаса.Номенклатура)
			И Номенклатура.Найти(СтрокаЗапаса.Номенклатура) = Неопределено Тогда
			Номенклатура.Добавить(СтрокаЗапаса.Номенклатура);
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаЗапаса.АС_ЗаказПоставщику)
			И ЗаказыПоставщикам.Найти(СтрокаЗапаса.АС_ЗаказПоставщику) = Неопределено Тогда
			ЗаказыПоставщикам.Добавить(СтрокаЗапаса.АС_ЗаказПоставщику);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Связь Из СвязиПоставок Цикл
		Если Связь.Количество > 0 И ЗначениеЗаполнено(Связь.ЗаказПоставщику)
			И ЗаказыПоставщикам.Найти(Связь.ЗаказПоставщику) = Неопределено Тогда
			ЗаказыПоставщикам.Добавить(Связь.ЗаказПоставщику);
		КонецЕсли;
	КонецЦикла;
	Если Номенклатура.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ Строки.Ссылка КАК ЗаказПоставщику,
	|Строки.КлючСвязи, Строки.Номенклатура, Строки.Характеристика,
	|Строки.АС_КоличествоДнейНаВозврат КАК КоличествоДней,
	|Строки.Ссылка.Контрагент КАК Поставщик,
	|ВЫБОР КОГДА Строки.Ссылка.ПоложениеЗаказаПокупателя =
	|    ЗНАЧЕНИЕ(Перечисление.ПоложениеРеквизитаНаФорме.ВТабличнойЧасти)
	|    ТОГДА Строки.ЗаказПокупателя ИНАЧЕ Строки.Ссылка.ЗаказПокупателя КОНЕЦ КАК ЗаказПокупателя
	|ИЗ Документ.ЗаказПоставщику.Запасы КАК Строки
	|ГДЕ Строки.Номенклатура В (&Номенклатура)
	|    И Строки.Количество > 0
	|    И НЕ Строки.Ссылка.ПометкаУдаления
	|    И Строки.Ссылка.ВариантЗавершения <> ЗНАЧЕНИЕ(Перечисление.ВариантыЗавершенияЗаказа.Отменен)
	|    И (Строки.Ссылка В (&ЗаказыПоставщикам)
	|        ИЛИ (ВЫБОР КОГДА Строки.Ссылка.ПоложениеЗаказаПокупателя =
	|            ЗНАЧЕНИЕ(Перечисление.ПоложениеРеквизитаНаФорме.ВТабличнойЧасти)
	|            ТОГДА Строки.ЗаказПокупателя ИНАЧЕ Строки.Ссылка.ЗаказПокупателя КОНЕЦ В (&ЗаказыПокупателей)))");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("ЗаказыПоставщикам", ЗаказыПоставщикам);
	Запрос.УстановитьПараметр("ЗаказыПокупателей", ЗаказыПокупателей);
	СтрокиПоставщиков = Запрос.Выполнить().Выгрузить();
	Результат.СтрокиПоставщиков = СтрокиПоставщиков;
	// История нужна только товарам, для которых возможен положительный срок возврата.
	// По этим товарам сохраняем всю историю: отсечение по дате нарушило бы FIFO.
	НоменклатураВозврата = Новый Массив;
	ТоварыВозврата = Новый Соответствие;
	Для Каждого СтрокаПоставщика Из СтрокиПоставщиков Цикл
		Если СтрокаПоставщика.КоличествоДней > 0
			И ТоварыВозврата.Получить(СтрокаПоставщика.Номенклатура) = Неопределено Тогда
			ТоварыВозврата.Вставить(СтрокаПоставщика.Номенклатура, Истина);
			НоменклатураВозврата.Добавить(СтрокаПоставщика.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	Если НоменклатураВозврата.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос(ТекстЗапросаСобытийВозврата());
	Запрос.УстановитьПараметр("Номенклатура", НоменклатураВозврата);
	Запрос.УстановитьПараметр("Расход", ВидДвиженияНакопления.Расход);
	События = Запрос.Выполнить().Выгрузить();
	Слои = Результат.Слои;
	ИндексСлоев = Новый Соответствие;
	ПеремещенныеСлои = Новый Соответствие;
	Для Каждого Событие Из События Цикл
		Если Событие.ВидСобытия = 0 Тогда
			Событие.Организация = Константы.УчетПоКомпании.Компания(Событие.Организация);
			ДобавитьСлойВозврата(Слои, ИндексСлоев, Событие);
		ИначеЕсли Событие.ВидСобытия = 2 Тогда
			// Для перемещения сохраняем источник и дату исходного поступления.
			ДобавитьПриходПеремещения(Слои, Событие,
				ПеремещенныеСлои.Получить(Событие.Документ), ИндексСлоев);
		Иначе
			Если ТипЗнч(Событие.Документ) = Тип("ДокументСсылка.СписаниеЗапасов")
				И ВРег(СокрЛП(Событие.Корреспонденция)) <> ВРег("Возврат") Тогда
				Событие.Поставщик = Справочники.Контрагенты.ПустаяСсылка();
			КонецЕсли;
			ПереносимыеСлои = Неопределено;
			Если ТипЗнч(Событие.Документ) = Тип("ДокументСсылка.ПеремещениеЗапасов") Тогда
				ПереносимыеСлои = ПеремещенныеСлои.Получить(Событие.Документ);
				Если ПереносимыеСлои = Неопределено Тогда
					ПереносимыеСлои = Новый Массив;
					ПеремещенныеСлои.Вставить(Событие.Документ, ПереносимыеСлои);
				КонецЕсли;
			КонецЕсли;
			РаспределитьВозвратПоПоступлениям(
				ГруппаСлоевПоУчету(ИндексСлоев, Событие), Событие, ПереносимыеСлои);
		КонецЕсли;
	КонецЦикла;

	// Для каждой строки документа далее читаются только живые слои ее товара.
	Для Каждого Слой Из Слои Цикл
		Если Слой.Количество > 0 Тогда
			Ключи = Новый Массив;
			Ключи.Добавить(Слой.Номенклатура);
			Ключи.Добавить(Слой.Характеристика);
			ГруппаИндексаСлоев(Результат.СлоиПоНоменклатуре, Ключи, Истина).Добавить(Слой);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция СрокиВозвратаПоДанным(ЗаказПокупателя, СтрокиЗапасов, СвязиПоставок, ДанныеРасчета)

	Результат = Новый Соответствие;
	СтрокиПоставщиков = ДанныеРасчета.СтрокиПоставщиков;
	ИндексСлоев = ДанныеРасчета.СлоиПоНоменклатуре;
	Сегодня = ДанныеРасчета.Сегодня;
	Для Каждого СтрокаЗапаса Из СтрокиЗапасов Цикл
		Если СтрокаЗапаса.Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Источники = ИсточникиВозвратаСтроки(СтрокаЗапаса, СвязиПоставок, СтрокиПоставщиков, ЗаказПокупателя);
		КоличествоДней = Неопределено;
		Ключи = Новый Массив;
		Ключи.Добавить(СтрокаЗапаса.Номенклатура);
		Ключи.Добавить(СтрокаЗапаса.Характеристика);
		Для Каждого Слой Из ГруппаИндексаСлоев(ИндексСлоев, Ключи) Цикл
			Если Слой.Количество <= 0
				Или Слой.Номенклатура <> СтрокаЗапаса.Номенклатура
				Или Слой.Характеристика <> СтрокаЗапаса.Характеристика Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого Источник Из Источники Цикл
				Если Слой.ЗаказПоставщику <> Источник.ЗаказПоставщику Тогда
					Продолжить;
				КонецЕсли;
				Если ЗначениеЗаполнено(Слой.ЗаказПокупателя)
					И Слой.ЗаказПокупателя <> ЗаказПокупателя Тогда
					Продолжить;
				КонецЕсли;
				ДатаОтсчета = Макс(Сегодня, НачалоДня(Слой.Дата));
				ОсталосьДней = Источник.КоличествоДней - (ДатаОтсчета - НачалоДня(Слой.Дата)) / 86400;
				Если КоличествоДней = Неопределено Или ОсталосьДней < КоличествоДней Тогда
					КоличествоДней = ОсталосьДней;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Если КоличествоДней <> Неопределено Тогда
			Результат.Вставить(СтрокаЗапаса.НомерСтроки, КоличествоДней);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ИсточникиВозвратаСтроки(СтрокаЗапаса, СвязиПоставок, СтрокиПоставщиков, ЗаказПокупателя)

	СвязиСтроки = Новый Массив;
	Для Каждого Связь Из СвязиПоставок Цикл
		Если ЗначениеЗаполнено(СтрокаЗапаса.АС_ИдентификаторГруппыПоставок)
			И Связь.ИдентификаторСтрокиПокупателя = СтрокаЗапаса.АС_ИдентификаторГруппыПоставок
			И Связь.Количество > 0 Тогда
			СвязиСтроки.Добавить(Связь);
		КонецЕсли;
	КонецЦикла;
	Если СвязиСтроки.Количество() = 0 И ЗначениеЗаполнено(СтрокаЗапаса.АС_ЗаказПоставщику) Тогда
		СвязиСтроки.Добавить(Новый Структура("ЗаказПоставщику,КлючСвязиЗаказаПоставщику",
			СтрокаЗапаса.АС_ЗаказПоставщику, СтрокаЗапаса.АС_КлючСвязиЗаказаПоставщику));
	КонецЕсли;

	Результат = Новый Массив;
	Для Каждого СтрокаПоставщика Из СтрокиПоставщиков Цикл
		Если СтрокаПоставщика.Номенклатура <> СтрокаЗапаса.Номенклатура
			Или СтрокаПоставщика.Характеристика <> СтрокаЗапаса.Характеристика
			Или СтрокаПоставщика.КоличествоДней <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Если СвязиСтроки.Количество() = 0 Тогда
			Если ЗначениеЗаполнено(ЗаказПокупателя) И СтрокаПоставщика.ЗаказПокупателя = ЗаказПокупателя Тогда
				Результат.Добавить(СтрокаПоставщика);
			КонецЕсли;
		Иначе
			Для Каждого Связь Из СвязиСтроки Цикл
				Если Связь.ЗаказПоставщику = СтрокаПоставщика.ЗаказПоставщику
					И (Связь.КлючСвязиЗаказаПоставщику = 0
						ИЛИ Связь.КлючСвязиЗаказаПоставщику = СтрокаПоставщика.КлючСвязи) Тогда
					Результат.Добавить(СтрокаПоставщика);
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура РаспределитьВозвратПоПоступлениям(Слои, ВозвратПоставщику, ПереносимыеСлои = Неопределено)

	ОсталосьВернуть = ВозвратПоставщику.Количество;
	ИндексСлоя = 0;
	Пока ИндексСлоя < Слои.Количество() Цикл
		Слой = Слои[ИндексСлоя];
		Если Слой.Количество <= 0 Тогда
			Слои.Удалить(ИндексСлоя);
			Продолжить;
		КонецЕсли;
		Если (ЗначениеЗаполнено(ВозвратПоставщику.Поставщик)
				И Слой.Поставщик <> ВозвратПоставщику.Поставщик)
			Или Слой.Организация <> ВозвратПоставщику.Организация
			Или Слой.Склад <> ВозвратПоставщику.Склад
			Или Слой.Номенклатура <> ВозвратПоставщику.Номенклатура
			Или Слой.УчетнаяХарактеристика <> ВозвратПоставщику.УчетнаяХарактеристика
			Или Слой.УчетнаяПартия <> ВозвратПоставщику.УчетнаяПартия Тогда
			ИндексСлоя = ИндексСлоя + 1;
			Продолжить;
		КонецЕсли;
		КоличествоВозврата = Мин(ОсталосьВернуть, Слой.Количество);
		Если ПереносимыеСлои <> Неопределено Тогда
			ПереносимыеСлои.Добавить(КопияСлояВозврата(Слой, КоличествоВозврата));
		КонецЕсли;
		Слой.Количество = Окр(Слой.Количество - КоличествоВозврата, 6);
		ОсталосьВернуть = Окр(ОсталосьВернуть - КоличествоВозврата, 6);
		Если Слой.Количество <= 0 Тогда
			// Удаляем только из рабочей группы; исходный слой остается в общем списке.
			Слои.Удалить(ИндексСлоя);
		Иначе
			ИндексСлоя = ИндексСлоя + 1;
		КонецЕсли;
		Если ОсталосьВернуть <= 0 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Межскладской перенос сохраняет дату поступления и источник закупки.
Функция КопияСлояВозврата(Слой, Количество)

	Копия = Новый Структура("Дата,ВидСобытия,Документ,НомерСтроки,Поставщик,Организация,Склад,Номенклатура,Характеристика,Партия,Количество,ЗаказПоставщику,ЗаказПокупателя,Корреспонденция,УчетнаяХарактеристика,УчетнаяПартия");
	ЗаполнитьЗначенияСвойств(Копия, Слой);
	Копия.Количество = Количество;
	Возврат Копия;

КонецФункции

Процедура ДобавитьПриходПеремещения(Слои, Приход, ПереносимыеСлои, ИндексСлоев)

	ОсталосьДобавить = Приход.Количество;
	Если ПереносимыеСлои <> Неопределено Тогда
		Для Каждого ПереносимыйСлой Из ПереносимыеСлои Цикл
			Если ПереносимыйСлой.Количество <= 0
				Или ПереносимыйСлой.Номенклатура <> Приход.Номенклатура
				Или ПереносимыйСлой.УчетнаяХарактеристика <> Приход.УчетнаяХарактеристика
				Или ПереносимыйСлой.УчетнаяПартия <> Приход.УчетнаяПартия Тогда
				Продолжить;
			КонецЕсли;
			КоличествоПрихода = Мин(ОсталосьДобавить, ПереносимыйСлой.Количество);
			НовыйСлой = КопияСлояВозврата(ПереносимыйСлой, КоличествоПрихода);
			НовыйСлой.Склад = Приход.Склад;
			НовыйСлой.Организация = Приход.Организация;
			ДобавитьСлойВозврата(Слои, ИндексСлоев, НовыйСлой);
			ПереносимыйСлой.Количество = Окр(ПереносимыйСлой.Количество - КоличествоПрихода, 6);
			ОсталосьДобавить = Окр(ОсталосьДобавить - КоличествоПрихода, 6);
			Если ОсталосьДобавить <= 0 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если ОсталосьДобавить > 0 Тогда
		ДобавитьСлойВозврата(Слои, ИндексСлоев, КопияСлояВозврата(Приход, ОсталосьДобавить));
	КонецЕсли;

КонецПроцедуры

// Ключи храним отдельными значениями, без строковой склейки ссылок и коллизий.
Функция ГруппаИндексаСлоев(Индекс, Ключи, Создавать = Ложь)

	Группа = Индекс;
	Для НомерКлюча = 0 По Ключи.Количество() - 1 Цикл
		Ключ = Ключи[НомерКлюча];
		СледующаяГруппа = Группа.Получить(Ключ);
		Если СледующаяГруппа = Неопределено Тогда
			Если Не Создавать Тогда
				Возврат Новый Массив;
			КонецЕсли;
			Если НомерКлюча = Ключи.Количество() - 1 Тогда
				СледующаяГруппа = Новый Массив;
			Иначе
				СледующаяГруппа = Новый Соответствие;
			КонецЕсли;
			Группа.Вставить(Ключ, СледующаяГруппа);
		КонецЕсли;
		Группа = СледующаяГруппа;
	КонецЦикла;
	Возврат Группа;

КонецФункции

Функция ГруппаСлоевПоУчету(Индекс, Слой, Создавать = Ложь)

	Ключи = Новый Массив;
	Ключи.Добавить(Слой.Организация);
	Ключи.Добавить(Слой.Склад);
	Ключи.Добавить(Слой.Номенклатура);
	Ключи.Добавить(Слой.УчетнаяХарактеристика);
	Ключи.Добавить(Слой.УчетнаяПартия);
	Возврат ГруппаИндексаСлоев(Индекс, Ключи, Создавать);

КонецФункции

Процедура ДобавитьСлойВозврата(Слои, ИндексСлоев, Слой)

	Слои.Добавить(Слой);
	ГруппаСлоевПоУчету(ИндексСлоев, Слой, Истина).Добавить(Слой);

КонецПроцедуры

Функция ТекстЗапросаСобытийВозврата()

	Возврат "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ Запасы.Регистратор КАК Документ,
	|Запасы.Номенклатура, Запасы.Характеристика
	|ПОМЕСТИТЬ АС_УчетныеХарактеристикиПриходов
	|ИЗ РегистрНакопления.Запасы КАК Запасы
	|ГДЕ Запасы.Активность И Запасы.ВидДвижения <> &Расход
	|    И Запасы.Регистратор ССЫЛКА Документ.ПриходнаяНакладная
	|    И Запасы.Номенклатура В (&Номенклатура);
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ Запасы.Регистратор КАК Документ,
	|Запасы.Номенклатура, Запасы.Партия
	|ПОМЕСТИТЬ АС_УчетныеПартииПриходов
	|ИЗ РегистрНакопления.Запасы КАК Запасы
	|ГДЕ Запасы.Активность И Запасы.ВидДвижения <> &Расход
	|    И Запасы.Регистратор ССЫЛКА Документ.ПриходнаяНакладная
	|    И Запасы.Номенклатура В (&Номенклатура);
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ Строки.Ссылка.Дата КАК Дата,
	|0 КАК ВидСобытия, Строки.Ссылка КАК Документ, Строки.НомерСтроки,
	|Строки.Ссылка.Контрагент КАК Поставщик, Строки.Ссылка.Организация КАК Организация,
	|ВЫБОР КОГДА Строки.Ссылка.ПоложениеСклада =
	|    ЗНАЧЕНИЕ(Перечисление.ПоложениеРеквизитаНаФорме.ВТабличнойЧасти)
	|    ТОГДА Строки.СтруктурнаяЕдиница ИНАЧЕ Строки.Ссылка.СтруктурнаяЕдиница КОНЕЦ КАК Склад,
	|Строки.Номенклатура, Строки.Характеристика, Строки.Партия,
	|Строки.Количество * ВЫБОР КОГДА Строки.ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерения
	|    ТОГДА ВЫРАЗИТЬ(Строки.ЕдиницаИзмерения КАК Справочник.ЕдиницыИзмерения).Коэффициент
	|    ИНАЧЕ 1 КОНЕЦ КАК Количество,
	|ВЫБОР КОГДА Строки.Заказ ССЫЛКА Документ.ЗаказПоставщику
	|    ТОГДА ВЫРАЗИТЬ(Строки.Заказ КАК Документ.ЗаказПоставщику)
	|    ИНАЧЕ ВЫРАЗИТЬ(Строки.Ссылка.Заказ КАК Документ.ЗаказПоставщику) КОНЕЦ КАК ЗаказПоставщику,
	|Строки.ЗаказПокупателя, """" КАК Корреспонденция,
	|ВЫБОР КОГДА Характеристики.Документ ЕСТЬ NULL И ПустыеХарактеристики.Документ ЕСТЬ НЕ NULL
	|    ТОГДА ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
	|    ИНАЧЕ Строки.Характеристика КОНЕЦ КАК УчетнаяХарактеристика,
	|ВЫБОР КОГДА Партии.Документ ЕСТЬ NULL И ПустыеПартии.Документ ЕСТЬ НЕ NULL
	|    ТОГДА ЗНАЧЕНИЕ(Справочник.ПартииНоменклатуры.ПустаяСсылка)
	|    ИНАЧЕ Строки.Партия КОНЕЦ КАК УчетнаяПартия
	|ИЗ Документ.ПриходнаяНакладная.Запасы КАК Строки
	|    ЛЕВОЕ СОЕДИНЕНИЕ АС_УчетныеХарактеристикиПриходов КАК Характеристики
	|    ПО Строки.Ссылка = Характеристики.Документ И Строки.Номенклатура = Характеристики.Номенклатура
	|        И Строки.Характеристика = Характеристики.Характеристика
	|    ЛЕВОЕ СОЕДИНЕНИЕ АС_УчетныеХарактеристикиПриходов КАК ПустыеХарактеристики
	|    ПО Строки.Ссылка = ПустыеХарактеристики.Документ И Строки.Номенклатура = ПустыеХарактеристики.Номенклатура
	|        И ПустыеХарактеристики.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
	|    ЛЕВОЕ СОЕДИНЕНИЕ АС_УчетныеПартииПриходов КАК Партии
	|    ПО Строки.Ссылка = Партии.Документ И Строки.Номенклатура = Партии.Номенклатура
	|        И Строки.Партия = Партии.Партия
	|    ЛЕВОЕ СОЕДИНЕНИЕ АС_УчетныеПартииПриходов КАК ПустыеПартии
	|    ПО Строки.Ссылка = ПустыеПартии.Документ И Строки.Номенклатура = ПустыеПартии.Номенклатура
	|        И ПустыеПартии.Партия = ЗНАЧЕНИЕ(Справочник.ПартииНоменклатуры.ПустаяСсылка)
	|ГДЕ Строки.Ссылка.Проведен И НЕ Строки.Ссылка.ПометкаУдаления
	|    И Строки.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПриходнаяНакладная.ПоступлениеОтПоставщика)
	|    И Строки.Номенклатура В (&Номенклатура)
	|    И Строки.Количество > 0
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ Движения.Дата,
	|ВЫБОР КОГДА Движения.Расход > 0 ТОГДА 1 ИНАЧЕ 2 КОНЕЦ,
	|Движения.Документ, 0,
	|ВЫБОР КОГДА Движения.Документ ССЫЛКА Документ.СписаниеЗапасов
	|    ТОГДА ВЫРАЗИТЬ(Движения.Документ КАК Документ.СписаниеЗапасов).АС_ПоставщикВозврата
	|    КОГДА Движения.Документ ССЫЛКА Документ.РасходнаяНакладная
	|        И ВЫРАЗИТЬ(Движения.Документ КАК Документ.РасходнаяНакладная).ВидОперации =
	|            ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРасходнаяНакладная.ВозвратПоставщику)
	|    ТОГДА ВЫРАЗИТЬ(Движения.Документ КАК Документ.РасходнаяНакладная).Контрагент
	|    ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) КОНЕЦ,
	|Движения.Организация, Движения.Склад, Движения.Номенклатура, Движения.Характеристика, Движения.Партия,
	|ВЫБОР КОГДА Движения.Расход > 0 ТОГДА Движения.Расход ИНАЧЕ -Движения.Расход КОНЕЦ,
	|ЗНАЧЕНИЕ(Документ.ЗаказПоставщику.ПустаяСсылка), ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка),
	|ВЫРАЗИТЬ(Движения.Документ КАК Документ.СписаниеЗапасов).Корреспонденция.Наименование,
	|Движения.Характеристика, Движения.Партия
	|ИЗ (ВЫБРАТЬ Запасы.Период КАК Дата, Запасы.Регистратор КАК Документ,
	|    Запасы.Организация КАК Организация, Запасы.СтруктурнаяЕдиница КАК Склад,
	|    Запасы.Номенклатура КАК Номенклатура, Запасы.Характеристика КАК Характеристика, Запасы.Партия КАК Партия,
	|    СУММА(ВЫБОР КОГДА Запасы.ВидДвижения = &Расход ТОГДА Запасы.Количество ИНАЧЕ -Запасы.Количество КОНЕЦ) КАК Расход
	|ИЗ РегистрНакопления.Запасы КАК Запасы
	|ГДЕ Запасы.Активность И Запасы.Номенклатура В (&Номенклатура)
	|    И Запасы.СтруктурнаяЕдиница ССЫЛКА Справочник.СтруктурныеЕдиницы
	|    И НЕ (Запасы.Регистратор ССЫЛКА Документ.ПриходнаяНакладная
	|        И ВЫРАЗИТЬ(Запасы.Регистратор КАК Документ.ПриходнаяНакладная).ВидОперации =
	|            ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПриходнаяНакладная.ПоступлениеОтПоставщика))
	|СГРУППИРОВАТЬ ПО Запасы.Период, Запасы.Регистратор, Запасы.Организация,
	|    Запасы.СтруктурнаяЕдиница, Запасы.Номенклатура, Запасы.Характеристика, Запасы.Партия
	|ИМЕЮЩИЕ СУММА(ВЫБОР КОГДА Запасы.ВидДвижения = &Расход ТОГДА Запасы.Количество ИНАЧЕ -Запасы.Количество КОНЕЦ) <> 0
	|) КАК Движения
	|УПОРЯДОЧИТЬ ПО Дата, Документ, ВидСобытия, НомерСтроки";

КонецФункции
