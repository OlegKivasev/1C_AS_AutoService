&НаКлиенте
Процедура ПоступлениеНаСчетИзЗаказа(Знач Источник, Знач ПараметрыВыполненияКоманды) Экспорт

	СозданиеНаОснованииВызовСервера.ПроверитьВозможностьСозданияПоЗаказуПокупателя(Источник);

	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить("Счет", НСтр("ru = 'Счёт'"));
	Кнопки.Добавить("Озон", НСтр("ru = 'Озон'"));
	Кнопки.Добавить("Сбербанк", НСтр("ru = 'Сбербанк'"));

	Контекст = Новый Структура;
	Контекст.Вставить("Источник", Источник);
	Контекст.Вставить("ПараметрыВыполненияКоманды", ПараметрыВыполненияКоманды);

	ПоказатьВопрос(
		Новый ОписаниеОповещения(
			"ПоступлениеНаСчетИзЗаказаЗавершение",
			ЭтотОбъект,
			Контекст),
		НСтр("ru = 'Выберите, куда поступят деньги.'"),
		Кнопки,
		,
		"Счет");

КонецПроцедуры

&НаКлиенте
Процедура ПоступлениеНаСчетИзЗаказаЗавершение(Ответ, Контекст) Экспорт

	Если Ответ = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура("Основание", Контекст.Источник);
	КомментарийПлатежа = "";
	Если Ответ = "Озон" Тогда
		КомментарийПлатежа = "Перевод на Озон";
	ИначеЕсли Ответ = "Сбербанк" Тогда
		КомментарийПлатежа = "Перевод на Сбербанк";
	КонецЕсли;

	ФормаПоступления = ПолучитьФорму(
		"Документ.ПоступлениеНаСчет.ФормаОбъекта",
		ПараметрыФормы,
		Контекст.ПараметрыВыполненияКоманды.Форма,
		Истина);
	Если ЗначениеЗаполнено(КомментарийПлатежа) Тогда
		ФормаПоступления.Объект.Комментарий = КомментарийПлатежа;
	КонецЕсли;
	ФормаПоступления.Открыть();

КонецПроцедуры
