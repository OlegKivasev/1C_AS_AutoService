&Вместо("РассчитатьСуммуИПроцентСкидки")
Процедура АС_РассчитатьСуммуИПроцентРазрешенныхСкидок(Форма, ИмяТабличнойЧасти = "Запасы",
	ПараметрыОтбора = Неопределено)

	Таблица = Форма.Объект[ИмяТабличнойЧасти];
	Если Таблица.Количество() = 0 Тогда
		ПродолжитьВызов(Форма, ИмяТабличнойЧасти, ПараметрыОтбора);
		Возврат;
	КонецЕсли;
	Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(
		Таблица[0], "АС_БезСкидки")
		Или Таблица.НайтиСтроки(Новый Структура("АС_БезСкидки", Истина)).Количество() = 0 Тогда
		ПродолжитьВызов(Форма, ИмяТабличнойЧасти, ПараметрыОтбора);
		Возврат;
	КонецЕсли;
	Отбор = ТабличныеЧастиУНФКлиентСервер.АС_ОтборСтрокСоСкидкой(Таблица, ПараметрыОтбора);
	СуммаБезСкидок = 0;
	СуммаРучныхСкидок = 0;
	Для Каждого СтрокаТовара Из Таблица Цикл
		Если Не ОбщегоНазначенияУНФКлиентСервер.ОбъектСоответствуетПараметрамОтбора(
			СтрокаТовара, Отбор) Тогда
			Продолжить;
		КонецЕсли;
		СуммаБезСкидок = СуммаБезСкидок + СтрокаТовара.Цена * СтрокаТовара.Количество;
		// Сумма хранится точнее процента; бонусы не являются ручной скидкой.
		СуммаРучныхСкидок = СуммаРучныхСкидок + СтрокаТовара.СуммаСкидкиНаценки;
	КонецЦикла;
	Форма.СкидкаСумма = СуммаРучныхСкидок;
	Форма.СкидкаПроцент = ?(СуммаБезСкидок = 0, 0, СуммаРучныхСкидок / СуммаБезСкидок * 100);

КонецПроцедуры
