&После("ПрименитьРезультатРасчетаСкидокКОбъекту")
Процедура АС_ПроверитьЗапретПослеПримененияСкидок(Объект, ИмяТЧ, РезультатРасчетаСкидокНаценок,
	РеализацияСверхЗаказа = Ложь, ТоварыСверхЗаказа = Неопределено, ИмяТЧ2 = Неопределено,
	ДеревоСкидок = Неопределено, ДополнительныеПараметры = Неопределено)

	Если ИмяТЧ <> "Запасы" Или Объект.Запасы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(
		Объект.Запасы[0], "АС_БезСкидки") Тогда
		// Защита также от применения результата, рассчитанного до установки флажка.
		ТабличныеЧастиУНФКлиентСервер.АС_НормализоватьСкидкиЗаказа(Объект);
	КонецЕсли;

КонецПроцедуры

&Вместо("ПересчитатьСуммыВСтрокеДокумента")
Процедура АС_ПересчитатьСтрокуБезЗапрещенныхСкидок(СтрокаТЧ, СуммаАвтоматическойСкидки,
	ПроцентСкидкиПоДисконтнойКарте, СуммаВключаетНДС, ЭтоРаботы = Ложь, ЗаполнятьСуммуСкидки = Ложь)

	Если ТабличныеЧастиУНФКлиентСервер.АС_ЭтоСтрокаБезСкидки(СтрокаТЧ) Тогда
		ТабличныеЧастиУНФКлиентСервер.АС_РассчитатьСтрокуБезСкидки(
			СтрокаТЧ, Новый Структура("СуммаВключаетНДС", СуммаВключаетНДС));
	Иначе
		ПродолжитьВызов(СтрокаТЧ, СуммаАвтоматическойСкидки, ПроцентСкидкиПоДисконтнойКарте,
			СуммаВключаетНДС, ЭтоРаботы, ЗаполнятьСуммуСкидки);
	КонецЕсли;

КонецПроцедуры

Процедура АС_ПеренестиЗапретыСкидок(Источник, Приемник) Экспорт

	Если Источник.Колонки.Найти("АС_БезСкидки") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Приемник.Колонки.Найти("АС_БезСкидки") = Неопределено Тогда
		Приемник.Колонки.Добавить("АС_БезСкидки", Новый ОписаниеТипов("Булево"));
	КонецЕсли;
	ЗапрещенныеКлючи = Новый Соответствие;
	Для Каждого Товар Из Источник Цикл
		Если Товар.АС_БезСкидки Тогда
			ЗапрещенныеКлючи.Вставить(Товар.КлючСвязи, Истина);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Товар Из Приемник Цикл
		Товар.АС_БезСкидки = ЗапрещенныеКлючи.Получить(Товар.КлючСвязи) = Истина;
	КонецЦикла;

КонецПроцедуры

&Вместо("ПодготовитьПараметрыРасчетаСкидок")
Функция АС_ПодготовитьПараметрыСЗапретамиСкидок(ПакетЗапросов, ПараметрыРасчета, ВходныеПараметры)

	Результат = ПродолжитьВызов(ПакетЗапросов, ПараметрыРасчета, ВходныеПараметры);
	// Штатный промежуточный запрос выбирает фиксированный список колонок.
	АС_ПеренестиЗапретыСкидок(ПараметрыРасчета.Товары, Результат.Товары);
	Возврат Результат;

КонецФункции

&Вместо("РассчитатьСкидку")
Процедура АС_РассчитатьСкидкуПоРазрешеннымСтрокам(СтрокаДерева, Параметры)

	ИсходныеТовары = СтрокаДерева.ТаблицаТоваров;
	Если ИсходныеТовары.Колонки.Найти("АС_БезСкидки") = Неопределено Тогда
		ПродолжитьВызов(СтрокаДерева, Параметры);
		Возврат;
	КонецЕсли;
	Если ИсходныеТовары.НайтиСтроки(Новый Структура("АС_БезСкидки", Истина)).Количество() = 0 Тогда
		ПродолжитьВызов(СтрокаДерева, Параметры);
		Возврат;
	КонецЕсли;
	ЭтоДенежнаяСкидка = СтрокаДерева.СпособПредоставления = Перечисления.СпособыПредоставленияСкидокНаценок.Процент
		Или СтрокаДерева.СпособПредоставления = Перечисления.СпособыПредоставленияСкидокНаценок.Сумма
		Или СтрокаДерева.СпособПредоставления = Перечисления.СпособыПредоставленияСкидокНаценок.ВидЦен
		Или СтрокаДерева.СпособПредоставления = Перечисления.СпособыПредоставленияСкидокНаценок.РучнаяСкидка
		Или СтрокаДерева.СпособПредоставления = Перечисления.СпособыПредоставленияСкидокНаценок.Округление
		Или СтрокаДерева.СпособПредоставления = Перечисления.СпособыПредоставленияСкидокНаценок.Расширение;
	Если СтрокаДерева.СпособПредоставления = Перечисления.СпособыПредоставленияСкидокНаценок.Подарок Тогда
		// Подарок из корзины оформляется скидкой на уже существующий товар.
		// Отдельно выдаваемые подарки остаются в штатном расчете.
		ЭтоДенежнаяСкидка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
			СтрокаДерева.СкидкаНаценка, "ПодарокИзКорзиныПокупателя");
	КонецЕсли;
	Если Не ЭтоДенежнаяСкидка Или СтрокаДерева.ЭтоПравилоНачисленияБонусов Тогда
		ПродолжитьВызов(СтрокаДерева, Параметры);
		Возврат;
	КонецЕсли;
	ТоварыСоСкидкой = ИсходныеТовары.Скопировать(Новый Структура("АС_БезСкидки", Ложь));
	Если ТоварыСоСкидкой.Количество() = 0 Тогда
		СтрокаДерева.ТаблицаДанных = ПолучитьПустуюТаблицуСкидокСРасшифровкой(Параметры);
		Возврат;
	КонецЕсли;
	СтрокаДерева.ТаблицаТоваров = ТоварыСоСкидкой;
	Попытка
		ПродолжитьВызов(СтрокаДерева, Параметры);
	Исключение
		СтрокаДерева.ТаблицаТоваров = ИсходныеТовары;
		ВызватьИсключение;
	КонецПопытки;
	СтрокаДерева.ТаблицаТоваров = ИсходныеТовары;

КонецПроцедуры
