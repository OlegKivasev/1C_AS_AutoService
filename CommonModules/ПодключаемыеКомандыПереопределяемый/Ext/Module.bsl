&После("ПриОпределенииКомандПодключенныхКОбъекту")
Процедура АС_ДобавитьПоступлениеИзРасходной(
	НастройкиФормы, Источники, ПодключенныеОтчетыИОбработки, Команды)

	Если Не АС_ПоступлениеИзРасходнойСВыборомДоступно(НастройкиФормы.ИмяФормы)
		Или Команды.Найти("АС_ПоступлениеНаСчетИзРасходнойНакладной", "Идентификатор") <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Штатный метод проверяет право добавления и заполняет представление и менеджер.
	Команда = СозданиеНаОсновании.ДобавитьКомандуСозданияНаОсновании(
		Команды, Метаданные.Документы.ПоступлениеНаСчет);
	Если Команда = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Команда.Вид = "СозданиеНаОсновании";
	Команда.Идентификатор = "АС_ПоступлениеНаСчетИзРасходнойНакладной";
	Команда.ТипПараметра = Новый ОписаниеТипов("ДокументСсылка.РасходнаяНакладная");
	Команда.МножественныйВыбор = Ложь;
	Команда.РежимЗаписи = "Записывать";
	Команда.Обработчик = "АС_ПлатежиЗаказовКлиент.ПоступлениеНаСчетИзРасходнойНакладной";
	Команда.ИмяПараметраФормы = "Основание";
	Команда.ПараметрыФормы = Новый Структура;
	Команда.Подменю = "ФормаСоздатьНаОсновании";
	Команда.Важность = "Обычное";
	Команда.Порядок = 50;

	Если НастройкиФормы.ИмяФормы = "Документ.РасходнаяНакладная.Форма.ФормаСписка" Тогда
		КомандаКонтекстногоМеню = Команды.Добавить();
		ЗаполнитьЗначенияСвойств(КомандаКонтекстногоМеню, Команда);
		КомандаКонтекстногоМеню.Подменю = "СписокКонтекстноеМенюСоздатьНаОсновании";
	КонецЕсли;

КонецПроцедуры

// Одни условия используются для добавления замены и скрытия исходной кнопки.
Функция АС_ПоступлениеИзРасходнойСВыборомДоступно(ИмяФормы) Экспорт

	Возврат (ИмяФормы = "Документ.РасходнаяНакладная.Форма.ФормаДокумента"
		Или ИмяФормы = "Документ.РасходнаяНакладная.Форма.ФормаСписка")
		И ПравоДоступа("Добавление", Метаданные.Документы.ПоступлениеНаСчет)
		И ОбщегоНазначения.ОбъектМетаданныхДоступенПоФункциональнымОпциям("Документ.ПоступлениеНаСчет");

КонецФункции
