Функция Рассчитать(СтрокиДокумента, ОрганизацияДокумента, ТекущийЗаказ) Экспорт

	Результат = Новый Массив;
	ТаблицаПотребности = Новый ТаблицаЗначений;
	ТаблицаПотребности.Колонки.Добавить("Номенклатура",
		Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаПотребности.Колонки.Добавить("Характеристика",
		Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТаблицаПотребности.Колонки.Добавить("Количество",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3)));

	Для Каждого ДанныеСтроки Из СтрокиДокумента Цикл

		Результат.Добавить(Новый Структура("Доступно", 0));
		Если Не ДанныеСтроки.ИспользоватьВРасчете Тогда
			Продолжить;
		КонецЕсли;

		Коэффициент = КоэффициентЕдиницыИзмерения(ДанныеСтроки.ЕдиницаИзмерения);
		НоваяСтрока = ТаблицаПотребности.Добавить();
		НоваяСтрока.Номенклатура = ДанныеСтроки.Номенклатура;
		НоваяСтрока.Характеристика = ДанныеСтроки.Характеристика;
		НоваяСтрока.Количество = ДанныеСтроки.НеОтгружено * Коэффициент;

	КонецЦикла;

	Если ТаблицаПотребности.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Организация = Константы.УчетПоКомпании.Компания(ОрганизацияДокумента);
	Если ПолучитьФункциональнуюОпцию("ПередачаТоваровМеждуОрганизациями") Тогда
		ОрганизацииОстатков = ИнтеркампаниСервер.ОрганизацииОстатков(Организация);
	Иначе
		ОрганизацииОстатков = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Организация);
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаПотребности", ТаблицаПотребности);
	Запрос.УстановитьПараметр("Номенклатура", ТаблицаПотребности.ВыгрузитьКолонку("Номенклатура"));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ОрганизацииОстатков", ОрганизацииОстатков);
	Запрос.УстановитьПараметр("ТекущийЗаказ", ТекущийЗаказ);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаПотребности.Номенклатура КАК Номенклатура,
	|	ТаблицаПотребности.Характеристика КАК Характеристика,
	|	ТаблицаПотребности.Количество КАК Количество
	|ПОМЕСТИТЬ ВТСтрокиПотребности
	|ИЗ
	|	&ТаблицаПотребности КАК ТаблицаПотребности
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТСтрокиПотребности.Номенклатура КАК Номенклатура,
	|	ВТСтрокиПотребности.Характеристика КАК Характеристика,
	|	СУММА(ВТСтрокиПотребности.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТПотребностьТекущегоЗаказа
	|ИЗ
	|	ВТСтрокиПотребности КАК ВТСтрокиПотребности
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТСтрокиПотребности.Номенклатура,
	|	ВТСтрокиПотребности.Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗапасыОстатки.Номенклатура КАК Номенклатура,
	|	ЗапасыОстатки.Характеристика КАК Характеристика,
	|	СУММА(ЗапасыОстатки.КоличествоОстаток) КАК Количество
	|ПОМЕСТИТЬ ВТФизическийОстаток
	|ИЗ
	|	РегистрНакопления.Запасы.Остатки(
	|			,
	|			Организация В (&ОрганизацииОстатков)
	|				И Номенклатура В (&Номенклатура)
	|				И ТИПЗНАЧЕНИЯ(СтруктурнаяЕдиница) = ТИП(Справочник.СтруктурныеЕдиницы)) КАК ЗапасыОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗапасыОстатки.Номенклатура,
	|	ЗапасыОстатки.Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказыПокупателейОстатки.Номенклатура КАК Номенклатура,
	|	ЗаказыПокупателейОстатки.Характеристика КАК Характеристика,
	|	СУММА(ЗаказыПокупателейОстатки.КоличествоОстаток) КАК Количество
	|ПОМЕСТИТЬ ВТПотребностьДругихЗаказов
	|ИЗ
	|	РегистрНакопления.ЗаказыПокупателей.Остатки(
	|			,
	|			Организация = &Организация
	|				И ЗаказПокупателя <> &ТекущийЗаказ
	|				И Номенклатура В (&Номенклатура)) КАК ЗаказыПокупателейОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказыПокупателейОстатки.Номенклатура,
	|	ЗаказыПокупателейОстатки.Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТПотребностьТекущегоЗаказа.Номенклатура КАК Номенклатура,
	|	ВТПотребностьТекущегоЗаказа.Характеристика КАК Характеристика,
	|	ЕСТЬNULL(ВТФизическийОстаток.Количество, 0)
	|		- ЕСТЬNULL(ВТПотребностьДругихЗаказов.Количество, 0)
	|		- ВТПотребностьТекущегоЗаказа.Количество КАК Доступно
	|ИЗ
	|	ВТПотребностьТекущегоЗаказа КАК ВТПотребностьТекущегоЗаказа
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТФизическийОстаток КАК ВТФизическийОстаток
	|		ПО ВТПотребностьТекущегоЗаказа.Номенклатура = ВТФизическийОстаток.Номенклатура
	|			И ВТПотребностьТекущегоЗаказа.Характеристика = ВТФизическийОстаток.Характеристика
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТПотребностьДругихЗаказов КАК ВТПотребностьДругихЗаказов
	|		ПО ВТПотребностьТекущегоЗаказа.Номенклатура = ВТПотребностьДругихЗаказов.Номенклатура
	|			И ВТПотребностьТекущегоЗаказа.Характеристика = ВТПотребностьДругихЗаказов.Характеристика";

	ТаблицаДоступности = Запрос.Выполнить().Выгрузить();
	ПараметрыПоиска = Новый Структура("Номенклатура, Характеристика");

	Для Индекс = 0 По СтрокиДокумента.Количество() - 1 Цикл

		ДанныеСтроки = СтрокиДокумента[Индекс];
		Если Не ДанныеСтроки.ИспользоватьВРасчете Тогда
			Продолжить;
		КонецЕсли;

		ПараметрыПоиска.Номенклатура = ДанныеСтроки.Номенклатура;
		ПараметрыПоиска.Характеристика = ДанныеСтроки.Характеристика;
		НайденныеСтроки = ТаблицаДоступности.НайтиСтроки(ПараметрыПоиска);
		Если НайденныеСтроки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		Коэффициент = КоэффициентЕдиницыИзмерения(ДанныеСтроки.ЕдиницаИзмерения);
		Доступно = Окр(НайденныеСтроки[0].Доступно / Коэффициент, 3);
		Результат[Индекс].Доступно = ?(Доступно < 0, 0, Доступно);

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция КоэффициентЕдиницыИзмерения(ЕдиницаИзмерения)

	Если ТипЗнч(ЕдиницаИзмерения) = Тип("СправочникСсылка.ЕдиницыИзмерения") Тогда
		Коэффициент = ЕдиницаИзмерения.Коэффициент;
		Возврат ?(Коэффициент = 0, 1, Коэффициент);
	КонецЕсли;

	Возврат 1;

КонецФункции
