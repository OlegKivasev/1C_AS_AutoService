Функция Рассчитать(СтрокиДокумента, ОрганизацияДокумента, ТекущийЗаказ, СтруктурнаяЕдиница = Неопределено,
	ТолькоРазрешенныеДанные = Истина, ВернутьБазовыйОстаток = Ложь) Экспорт

	Результат = Новый Массив;
	ТаблицаПотребности = Новый ТаблицаЗначений;
	ТаблицаПотребности.Колонки.Добавить("Номенклатура",
		Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаПотребности.Колонки.Добавить("Характеристика",
		Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТаблицаПотребности.Колонки.Добавить("Количество",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3)));
	ТаблицаПотребности.Колонки.Добавить("ИспользоватьЗарегистрированнуюПотребность",
		Новый ОписаниеТипов("Булево"));
	КоэффициентыЕдиниц = Новый Соответствие;

	Для Каждого ДанныеСтроки Из СтрокиДокумента Цикл

		Результат.Добавить(Новый Структура("Доступно", 0));
		Если Не ДанныеСтроки.ИспользоватьВРасчете Тогда
			Продолжить;
		КонецЕсли;

		Коэффициент = КоэффициентыЕдиниц.Получить(ДанныеСтроки.ЕдиницаИзмерения);
		Если Коэффициент = Неопределено Тогда
			Коэффициент = КоэффициентЕдиницыИзмерения(ДанныеСтроки.ЕдиницаИзмерения);
			КоэффициентыЕдиниц.Вставить(ДанныеСтроки.ЕдиницаИзмерения, Коэффициент);
		КонецЕсли;
		ЗначениеСвойства = Неопределено;
		УчитыватьВПотребности = Истина;
		Если ДанныеСтроки.Свойство("УчитыватьВПотребности", ЗначениеСвойства) Тогда
			УчитыватьВПотребности = ЗначениеСвойства;
		КонецЕсли;
		ИспользоватьЗарегистрированнуюПотребность = Ложь;
		Если ДанныеСтроки.Свойство(
			"ИспользоватьЗарегистрированнуюПотребность", ЗначениеСвойства) Тогда
			ИспользоватьЗарегистрированнуюПотребность = ЗначениеСвойства;
		КонецЕсли;

		НоваяСтрока = ТаблицаПотребности.Добавить();
		НоваяСтрока.Номенклатура = ДанныеСтроки.Номенклатура;
		НоваяСтрока.Характеристика = ДанныеСтроки.Характеристика;
		НоваяСтрока.ИспользоватьЗарегистрированнуюПотребность =
			УчитыватьВПотребности И ИспользоватьЗарегистрированнуюПотребность;
		Если УчитыватьВПотребности Тогда
			НоваяСтрока.Количество = ДанныеСтроки.НеОтгружено * Коэффициент;
		Иначе
			НоваяСтрока.Количество = 0;
		КонецЕсли;

	КонецЦикла;

	Если ТаблицаПотребности.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Организация = Константы.УчетПоКомпании.Компания(ОрганизацияДокумента);
	Если ПолучитьФункциональнуюОпцию("ПередачаТоваровМеждуОрганизациями") Тогда
		ОрганизацииОстатков = ИнтеркампаниСервер.ОрганизацииОстатков(Организация);
	Иначе
		ОрганизацииОстатков = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Организация);
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаПотребности", ТаблицаПотребности);
	Запрос.УстановитьПараметр("Номенклатура", ТаблицаПотребности.ВыгрузитьКолонку("Номенклатура"));
	Запрос.УстановитьПараметр("ОрганизацииОстатков", ОрганизацииОстатков);
	Запрос.УстановитьПараметр("ТекущийЗаказ", ТекущийЗаказ);
	ВсеСклады = Не ЗначениеЗаполнено(СтруктурнаяЕдиница);
	Если ВсеСклады Тогда
		СтруктурнаяЕдиницаОтбора = Справочники.СтруктурныеЕдиницы.ПустаяСсылка();
	Иначе
		СтруктурнаяЕдиницаОтбора = СтруктурнаяЕдиница;
	КонецЕсли;
	Запрос.УстановитьПараметр("СтруктурнаяЕдиница", СтруктурнаяЕдиницаОтбора);
	Запрос.УстановитьПараметр("ВсеСклады", ВсеСклады);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаПотребности.Номенклатура КАК Номенклатура,
	|	ТаблицаПотребности.Характеристика КАК Характеристика,
	|	ТаблицаПотребности.Количество КАК Количество,
	|	ТаблицаПотребности.ИспользоватьЗарегистрированнуюПотребность КАК ИспользоватьЗарегистрированнуюПотребность
	|ПОМЕСТИТЬ ВТСтрокиПотребности
	|ИЗ
	|	&ТаблицаПотребности КАК ТаблицаПотребности
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТСтрокиПотребности.Номенклатура КАК Номенклатура,
	|	ВТСтрокиПотребности.Характеристика КАК Характеристика,
	|	СУММА(ВТСтрокиПотребности.Количество) КАК Количество,
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА ВТСтрокиПотребности.ИспользоватьЗарегистрированнуюПотребность
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ) КАК ИспользоватьЗарегистрированнуюПотребность
	|ПОМЕСТИТЬ ВТПотребностьТекущегоЗаказа
	|ИЗ
	|	ВТСтрокиПотребности КАК ВТСтрокиПотребности
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТСтрокиПотребности.Номенклатура,
	|	ВТСтрокиПотребности.Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗапасыОстатки.Номенклатура КАК Номенклатура,
	|	ЗапасыОстатки.Характеристика КАК Характеристика,
	|	СУММА(ЗапасыОстатки.КоличествоОстаток) КАК Количество
	|ПОМЕСТИТЬ ВТФизическийОстаток
	|ИЗ
	|	РегистрНакопления.Запасы.Остатки(
	|			,
	|			Организация В (&ОрганизацииОстатков)
	|				И Номенклатура В (&Номенклатура)
	|				И (&ВсеСклады ИЛИ СтруктурнаяЕдиница = &СтруктурнаяЕдиница)
	|				И ТИПЗНАЧЕНИЯ(СтруктурнаяЕдиница) = ТИП(Справочник.СтруктурныеЕдиницы)) КАК ЗапасыОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗапасыОстатки.Номенклатура,
	|	ЗапасыОстатки.Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказыПокупателейОстатки.Номенклатура КАК Номенклатура,
	|	ЗаказыПокупателейОстатки.Характеристика КАК Характеристика,
	|	СУММА(ЗаказыПокупателейОстатки.КоличествоОстаток) КАК Количество
	|ПОМЕСТИТЬ ВТПотребностьДругихЗаказов
	|ИЗ
	|	РегистрНакопления.ЗаказыПокупателей.Остатки(
	|			,
	|			Организация В (&ОрганизацииОстатков)
	|				И ЗаказПокупателя <> &ТекущийЗаказ
	|				И (&ВсеСклады ИЛИ Склад = &СтруктурнаяЕдиница)
	|				И Номенклатура В (&Номенклатура)) КАК ЗаказыПокупателейОстатки
	|
	|ГДЕ
	|	ЗаказыПокупателейОстатки.КоличествоОстаток > 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказыПокупателейОстатки.Номенклатура,
	|	ЗаказыПокупателейОстатки.Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказыПокупателейОстатки.Номенклатура КАК Номенклатура,
	|	ЗаказыПокупателейОстатки.Характеристика КАК Характеристика,
	|	СУММА(ЗаказыПокупателейОстатки.КоличествоОстаток) КАК Количество
	|ПОМЕСТИТЬ ВТЗарегистрированнаяПотребностьТекущегоЗаказа
	|ИЗ
	|	РегистрНакопления.ЗаказыПокупателей.Остатки(
	|			,
	|			Организация В (&ОрганизацииОстатков)
	|				И ЗаказПокупателя = &ТекущийЗаказ
	|				И (&ВсеСклады ИЛИ Склад = &СтруктурнаяЕдиница)
	|				И Номенклатура В (&Номенклатура)) КАК ЗаказыПокупателейОстатки
	|
	|ГДЕ
	|	ЗаказыПокупателейОстатки.КоличествоОстаток > 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказыПокупателейОстатки.Номенклатура,
	|	ЗаказыПокупателейОстатки.Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТПотребностьТекущегоЗаказа.Номенклатура КАК Номенклатура,
	|	ВТПотребностьТекущегоЗаказа.Характеристика КАК Характеристика,
	|	ЕСТЬNULL(ВТФизическийОстаток.Количество, 0)
	|		- ЕСТЬNULL(ВТПотребностьДругихЗаказов.Количество, 0)
	|		- ВЫБОР
	|			КОГДА ВТПотребностьТекущегоЗаказа.ИспользоватьЗарегистрированнуюПотребность = 1
	|				ТОГДА ЕСТЬNULL(ВТЗарегистрированнаяПотребностьТекущегоЗаказа.Количество, 0)
	|			ИНАЧЕ ВТПотребностьТекущегоЗаказа.Количество
	|		КОНЕЦ КАК Доступно
	|ИЗ
	|	ВТПотребностьТекущегоЗаказа КАК ВТПотребностьТекущегоЗаказа
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТФизическийОстаток КАК ВТФизическийОстаток
	|		ПО ВТПотребностьТекущегоЗаказа.Номенклатура = ВТФизическийОстаток.Номенклатура
	|			И ВТПотребностьТекущегоЗаказа.Характеристика = ВТФизическийОстаток.Характеристика
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТПотребностьДругихЗаказов КАК ВТПотребностьДругихЗаказов
	|		ПО ВТПотребностьТекущегоЗаказа.Номенклатура = ВТПотребностьДругихЗаказов.Номенклатура
	|			И ВТПотребностьТекущегоЗаказа.Характеристика = ВТПотребностьДругихЗаказов.Характеристика
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТЗарегистрированнаяПотребностьТекущегоЗаказа КАК ВТЗарегистрированнаяПотребностьТекущегоЗаказа
	|		ПО ВТПотребностьТекущегоЗаказа.Номенклатура = ВТЗарегистрированнаяПотребностьТекущегоЗаказа.Номенклатура
	|			И ВТПотребностьТекущегоЗаказа.Характеристика = ВТЗарегистрированнаяПотребностьТекущегоЗаказа.Характеристика";

	Если Не ТолькоРазрешенныеДанные Тогда
		// Скрытые заказы не должны молча исключаться из проверки ограничения покупателей.
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВЫБРАТЬ РАЗРЕШЕННЫЕ", "ВЫБРАТЬ");
	КонецЕсли;
	ТаблицаДоступности = Запрос.Выполнить().Выгрузить();
	ТаблицаДоступности.Индексы.Добавить("Номенклатура, Характеристика");
	ПараметрыПоиска = Новый Структура("Номенклатура, Характеристика");

	Для Индекс = 0 По СтрокиДокумента.Количество() - 1 Цикл

		ДанныеСтроки = СтрокиДокумента[Индекс];
		Если Не ДанныеСтроки.ИспользоватьВРасчете Тогда
			Продолжить;
		КонецЕсли;

		ПараметрыПоиска.Номенклатура = ДанныеСтроки.Номенклатура;
		ПараметрыПоиска.Характеристика = ДанныеСтроки.Характеристика;
		НайденныеСтроки = ТаблицаДоступности.НайтиСтроки(ПараметрыПоиска);
		Если НайденныеСтроки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		Коэффициент = КоэффициентыЕдиниц.Получить(ДанныеСтроки.ЕдиницаИзмерения);
		Доступно = Окр(НайденныеСтроки[0].Доступно / Коэффициент, 3);
		Результат[Индекс].Доступно = ?(Доступно < 0, 0, Доступно);
		Если ВернутьБазовыйОстаток Тогда
			Результат[Индекс].Вставить("БазовыйОстаток", Макс(0, НайденныеСтроки[0].Доступно));
			Результат[Индекс].Вставить("Коэффициент", Коэффициент);
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Пары хранятся в обе стороны. Учитываем каждую действующую замену один раз.
Функция ТекстСвязейОстатков(ИсточникСсылок)
	Возврат "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|Связи.Номенклатура КАК Номенклатура, Связи.ВзаимозаменяемыйТовар КАК Замена
	|ПОМЕСТИТЬ АС_СвязиОстатков
	|ИЗ (" + АС_ПродажиНоменклатурыСервер.ТекстЗапросаСвязейПоступления(Ложь, ИсточникСсылок) + ") КАК Связи
	|    ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Товары
	|    ПО Товары.Ссылка = Связи.ВзаимозаменяемыйТовар
	|ГДЕ Связи.Номенклатура <> Связи.ВзаимозаменяемыйТовар
	|    И НЕ Товары.ЭтоГруппа И НЕ Товары.ПометкаУдаления И НЕ Товары.Недействителен
	|    И Товары.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)
	|ИНДЕКСИРОВАТЬ ПО Номенклатура, Замена;";
КонецФункции

Функция ТекстОстатковСписка(ИсточникСсылок, СОтборами = Ложь, ЕстьТаблицаОстатков = Ложь,
	СчитатьИтогиЗамен = Истина) Экспорт

	Текст = ТекстСвязейОстатков(ИсточникСсылок);
	Если Не ЕстьТаблицаОстатков Тогда
		Текст = Текст + "ВЫБРАТЬ РАЗРЕШЕННЫЕ Остатки.Номенклатура КАК Номенклатура,
		|СУММА(Остатки.Количество) КАК Количество, СУММА(Остатки.Резерв) КАК Резерв
		|ПОМЕСТИТЬ ОстаткиТоваров ИЗ РегистрСведений.ОстаткиТоваров КАК Остатки
		|ГДЕ (Остатки.Номенклатура В (" + ИсточникСсылок + ")
		|    ИЛИ Остатки.Номенклатура В (ВЫБРАТЬ Связи.Замена ИЗ АС_СвязиОстатков КАК Связи))"
		+ ?(СОтборами, " И (&ВсеСклады ИЛИ Остатки.СтруктурнаяЕдиница В (&Склад))
			|И (&ВсеОрганизации ИЛИ Остатки.Организация В (&Организация))
			|И (&БезОтбора ИЛИ Остатки.Характеристика В (&Характеристика))", "") + "
		|СГРУППИРОВАТЬ ПО Остатки.Номенклатура ИНДЕКСИРОВАТЬ ПО Номенклатура;";
	КонецЕсли;
	Текст = Текст + "ВЫБРАТЬ РАЗРЕШЕННЫЕ Заказы.Номенклатура КАК Номенклатура,
	|СУММА(Заказы.КоличествоОстаток) КАК Количество
	|ПОМЕСТИТЬ АС_АктивныеЗаказы
	|ИЗ РегистрНакопления.ЗаказыПокупателей.Остатки(,
	|    Номенклатура В (ВЫБРАТЬ Остатки.Номенклатура ИЗ ОстаткиТоваров КАК Остатки)"
	+ ?(СОтборами, " И (&ВсеСклады ИЛИ Склад В (&Склад))
		|И (&ВсеОрганизации ИЛИ Организация В (&Организация))
		|И (&БезОтбора ИЛИ Характеристика В (&Характеристика))", "") + ") КАК Заказы
	|ГДЕ Заказы.КоличествоОстаток > 0
	|СГРУППИРОВАТЬ ПО Заказы.Номенклатура ИНДЕКСИРОВАТЬ ПО Номенклатура;
	|
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ Остатки.Номенклатура КАК Номенклатура,
	|Остатки.Количество + Остатки.Резерв - ЕСТЬNULL(Заказы.Количество, 0) КАК Количество
	|ПОМЕСТИТЬ АС_СвободныеОстатки
	|ИЗ ОстаткиТоваров КАК Остатки
	|    ЛЕВОЕ СОЕДИНЕНИЕ АС_АктивныеЗаказы КАК Заказы ПО Остатки.Номенклатура = Заказы.Номенклатура
	|ГДЕ Остатки.Количество + Остатки.Резерв - ЕСТЬNULL(Заказы.Количество, 0) > 0
	|ИНДЕКСИРОВАТЬ ПО Номенклатура;";
	Если СчитатьИтогиЗамен Тогда
		Текст = Текст + "ВЫБРАТЬ Связи.Номенклатура КАК Номенклатура, СУММА(Остатки.Количество) КАК Количество
		|ПОМЕСТИТЬ АС_ИтогиЗамен
		|ИЗ АС_СвязиОстатков КАК Связи
		|    ВНУТРЕННЕЕ СОЕДИНЕНИЕ АС_СвободныеОстатки КАК Остатки ПО Связи.Замена = Остатки.Номенклатура
		|СГРУППИРОВАТЬ ПО Связи.Номенклатура ИНДЕКСИРОВАТЬ ПО Номенклатура;";
	КонецЕсли;
	Возврат Текст;

КонецФункции

Функция РасшифровкиСписка(Ссылки, МенеджерТаблиц = Неопределено, Отборы = Неопределено) Экспорт

	ТекстПакета = "";
	Если МенеджерТаблиц = Неопределено Тогда
		ТекстПакета = ТекстОстатковСписка("ВЫБРАТЬ Товары.Ссылка ИЗ Справочник.Номенклатура КАК Товары
			|ГДЕ Товары.Ссылка В (&Ссылки)", Отборы <> Неопределено, Ложь, Ложь);
	КонецЕсли;
	Запрос = Новый Запрос(ТекстПакета + "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|Связи.Номенклатура КАК Номенклатура, Товары.Ссылка КАК ТоварСтроки,
	|Товары.Наименование КАК Наименование, Товары.Артикул КАК Артикул,
	|ЕСТЬNULL(ОстаткиЗамен.Количество, 0) КАК Количество
	|ИЗ АС_СвязиОстатков КАК Связи
	|    ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Товары ПО Связи.Замена = Товары.Ссылка
	|    ЛЕВОЕ СОЕДИНЕНИЕ АС_СвободныеОстатки КАК ОстаткиЗамен
	|    ПО Связи.Замена = ОстаткиЗамен.Номенклатура
	|ГДЕ Связи.Номенклатура В (&Ссылки)
	|УПОРЯДОЧИТЬ ПО Наименование, Артикул, Товары.Ссылка;
	|
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ Товары.Ссылка КАК Номенклатура, Товары.Ссылка КАК ТоварСтроки,
	|Товары.Наименование КАК Наименование,
	|Товары.Артикул КАК Артикул, ЕСТЬNULL(ОстаткиОригинала.Количество, 0) КАК Количество
	|ИЗ Справочник.Номенклатура КАК Товары
	|    ЛЕВОЕ СОЕДИНЕНИЕ АС_СвободныеОстатки КАК ОстаткиОригинала
	|    ПО Товары.Ссылка = ОстаткиОригинала.Номенклатура
	|ГДЕ Товары.Ссылка В (&Ссылки)");
	Если МенеджерТаблиц <> Неопределено Тогда Запрос.МенеджерВременныхТаблиц = МенеджерТаблиц; КонецЕсли;
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Если Отборы <> Неопределено Тогда
		Для Каждого Отбор Из Отборы Цикл Запрос.УстановитьПараметр(Отбор.Ключ, Отбор.Значение); КонецЦикла;
	КонецЕсли;
	Пакет = Запрос.ВыполнитьПакет();
	Выборка = Пакет[Пакет.ВГраница()].Выбрать();
	Результат = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Номенклатура, Новый Структура("Оригинал,Замены", СтрокаРасшифровки(Выборка), Новый Массив));
	КонецЦикла;
	Выборка = Пакет[Пакет.ВГраница() - 1].Выбрать();
	Пока Выборка.Следующий() Цикл
		Расшифровка = Результат.Получить(Выборка.Номенклатура);
		Если Расшифровка <> Неопределено Тогда Расшифровка.Замены.Добавить(СтрокаРасшифровки(Выборка)); КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция СтрокаРасшифровки(Выборка)
	Возврат Новый Структура("Наименование,Артикул,Количество,Номенклатура",
		Выборка.Наименование, Выборка.Артикул, Выборка.Количество, Выборка.ТоварСтроки);
КонецФункции

Функция РассчитатьСЗаменами(СтрокиДокумента, Организация, ТекущийЗаказ,
	ИндексРасшифровки = Неопределено) Экспорт

	СтрокиРасчета = Новый Массив;
	ИндексыПоТоварам = Новый Соответствие;
	ЗарегистрированнаяПотребность = Ложь;
	Для Каждого Строка Из СтрокиДокумента Цикл
		Индекс = СтрокиРасчета.Количество();
		СтрокиРасчета.Добавить(Строка);
		Если Не Строка.ИспользоватьВРасчете Тогда Продолжить; КонецЕсли;
		ИндексыСтрокТовара(ИндексыПоТоварам, Строка.Номенклатура).Вставить(Строка.Характеристика, Индекс);
		Если Строка.Свойство("ИспользоватьЗарегистрированнуюПотребность")
			И Строка.ИспользоватьЗарегистрированнуюПотребность Тогда
			ЗарегистрированнаяПотребность = Истина;
		КонецЕсли;
	КонецЦикла;

	Замены = Новый Соответствие;
	Если ИндексыПоТоварам.Количество() > 0 Тогда
		Запрос = Новый Запрос(ТекстСвязейОстатков("&Товары") + "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|Связи.Номенклатура КАК Номенклатура, Связи.Замена КАК Замена,
		|Товары.Наименование КАК Наименование, Товары.Артикул КАК Артикул
		|ИЗ АС_СвязиОстатков КАК Связи
		|    ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Товары ПО Связи.Замена = Товары.Ссылка
		|УПОРЯДОЧИТЬ ПО Наименование, Артикул, Замена");
		Запрос.УстановитьПараметр("Товары", ОбщегоНазначенияБЗККлиентСервер.КлючиСоответствия(ИндексыПоТоварам));
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Связи = Замены.Получить(Выборка.Номенклатура);
			Если Связи = Неопределено Тогда
				Связи = Новый Массив;
				Замены.Вставить(Выборка.Номенклатура, Связи);
			КонецЕсли;
			Связи.Добавить(Новый Структура("Номенклатура,Наименование,Артикул",
				Выборка.Замена, Выборка.Наименование, Выборка.Артикул));
		КонецЦикла;
	КонецЕсли;

	// Дополнительные пары читаются в том же пакете. Строки самого документа
	// продолжают задавать потребность, в том числе при повторе товара в наряде.
	Для Каждого Строка Из СтрокиДокумента Цикл
		Если Не Строка.ИспользоватьВРасчете Тогда Продолжить; КонецЕсли;
		Связи = Замены.Получить(Строка.Номенклатура);
		Если Связи = Неопределено Тогда Продолжить; КонецЕсли;
		Для Каждого Связь Из Связи Цикл
			Индексы = ИндексыСтрокТовара(ИндексыПоТоварам, Связь.Номенклатура);
			Если Индексы.Получить(Строка.Характеристика) <> Неопределено Тогда Продолжить; КонецЕсли;
			Индексы.Вставить(Строка.Характеристика, СтрокиРасчета.Количество());
			СтрокиРасчета.Добавить(Новый Структура(
				"Номенклатура,Характеристика,ЕдиницаИзмерения,НеОтгружено,ИспользоватьВРасчете,ИспользоватьЗарегистрированнуюПотребность",
				Связь.Номенклатура, Строка.Характеристика, Неопределено, 0, Истина, ЗарегистрированнаяПотребность));
		КонецЦикла;
	КонецЦикла;

	Остатки = Рассчитать(СтрокиРасчета, Организация, ТекущийЗаказ, , Истина, Истина);
	Результат = Новый Массив;
	Для Индекс = 0 По СтрокиДокумента.Количество() - 1 Цикл
		Строка = СтрокиДокумента[Индекс];
		Остаток = Остатки[Индекс];
		ПоказатьРасшифровку = ИндексРасшифровки = Неопределено Или ИндексРасшифровки = Индекс;
		Итог = Новый Структура("Доступно,Оригинал,Замены", Остаток.Доступно, Остаток.Доступно, Новый Массив);
		Результат.Добавить(Итог);
		Если Не Строка.ИспользоватьВРасчете Или Не Остаток.Свойство("Коэффициент") Тогда Продолжить; КонецЕсли;
		Связи = Замены.Получить(Строка.Номенклатура);
		Если Связи = Неопределено Тогда Продолжить; КонецЕсли;
		Для Каждого Связь Из Связи Цикл
			ИндексЗамены = ИндексыПоТоварам.Получить(Связь.Номенклатура).Получить(Строка.Характеристика);
			ДоступностьЗамены = Остатки[ИндексЗамены];
			БазовыйОстаток = ?(ДоступностьЗамены.Свойство("БазовыйОстаток"), ДоступностьЗамены.БазовыйОстаток, 0);
			Количество = Окр(БазовыйОстаток / Остаток.Коэффициент, 3);
			Итог.Доступно = Итог.Доступно + Количество;
			Если ПоказатьРасшифровку Тогда
				Итог.Замены.Добавить(Новый Структура("Наименование,Артикул,Количество,Номенклатура",
					Связь.Наименование, Связь.Артикул, Количество, Связь.Номенклатура));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ИндексыСтрокТовара(ИндексыПоТоварам, Товар)
	Индексы = ИндексыПоТоварам.Получить(Товар);
	Если Индексы = Неопределено Тогда
		Индексы = Новый Соответствие;
		ИндексыПоТоварам.Вставить(Товар, Индексы);
	КонецЕсли;
	Возврат Индексы;
КонецФункции

Функция СписокРасшифровкиДокумента(Номенклатура, Остаток) Экспорт

	Оригинал = Неопределено;
	Если Остаток.Оригинал > 0 Тогда
		Оригинал = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, "Наименование,Артикул");
		Оригинал.Вставить("Количество", Остаток.Оригинал);
	КонецЕсли;
	Возврат СписокРасшифровки(Новый Структура("Оригинал,Замены", Оригинал, Остаток.Замены));

КонецФункции

Функция СписокРасшифровки(Расшифровка) Экспорт

	Если Расшифровка = Неопределено Тогда Возврат Неопределено; КонецЕсли;
	Список = Новый СписокЗначений;
	Если Расшифровка.Оригинал <> Неопределено И Расшифровка.Оригинал.Количество > 0 Тогда
		Список.Добавить(Неопределено, ПредставлениеСтрокиОстатка("Оригинал", Расшифровка.Оригинал));
	КонецЕсли;
	Для Каждого Товар Из Расшифровка.Замены Цикл
		Если Товар.Количество > 0 Тогда
			Список.Добавить(Неопределено, ПредставлениеСтрокиОстатка("Замена", Товар));
		КонецЕсли;
	КонецЦикла;
	Возврат ?(Список.Количество() > 0, Список, Неопределено);

КонецФункции

Функция ПредставлениеСтрокиОстатка(ВидТовара, Товар)

	Возврат ВидТовара + " — " + Товар.Наименование
		+ ?(ПустаяСтрока(Товар.Артикул), "", " · " + Товар.Артикул)
		+ " — " + Формат(Товар.Количество, "ЧН=0");

КонецФункции

Функция ПустыеСведенияОбОстатках()
	Возврат Новый Структура(
		"ОстатокСУчетомЗаказов,КоличествоАктивныхЗаказов,ПредставлениеСкладов,ФизическийОстаток,"
		+ "ПотребностьПоЗаказам,КоличествоВЗаказНарядах", 0, 0, "Все склады", 0, 0, 0);
КонецФункции

Функция ПолучитьСведенияПоНоменклатуре(Номенклатура) Экспорт
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат ПустыеСведенияОбОстатках();
	КонецЕсли;
	Товары = Новый Массив;
	Товары.Добавить(Номенклатура);
	Возврат ПолучитьСведенияПоНоменклатурам(Товары).Получить(Номенклатура);
КонецФункции

// Две выборки на весь список, те же склады и положительная потребность каждого заказа.
Функция ПолучитьСведенияПоНоменклатурам(Номенклатура, УчитыватьОткрытыеНаряды = Ложь) Экспорт

	Результат = Новый Соответствие;
	СкладыПоТоварам = Новый Соответствие;
	Для Каждого Товар Из Номенклатура Цикл
		Результат.Вставить(Товар, ПустыеСведенияОбОстатках());
		СкладыПоТоварам.Вставить(Товар, Новый Массив);
	КонецЦикла;
	Если Номенклатура.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗапасыОстатки.Номенклатура КАК Номенклатура,
	|	ЗапасыОстатки.СтруктурнаяЕдиница КАК Склад,
	|	ЕСТЬNULL(СУММА(ЗапасыОстатки.КоличествоОстаток), 0) КАК Количество
	|ИЗ
	|	РегистрНакопления.Запасы.Остатки(
	|			,
	|			Номенклатура В (&Номенклатура)
	|				И ТИПЗНАЧЕНИЯ(СтруктурнаяЕдиница) = ТИП(Справочник.СтруктурныеЕдиницы)) КАК ЗапасыОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗапасыОстатки.Номенклатура,
	|	ЗапасыОстатки.СтруктурнаяЕдиница
	|;";
	ДобавитьЗапросАктивныхЗаказов(Запрос, УчитыватьОткрытыеНаряды);
	РезультатыПакета = Запрос.ВыполнитьПакет();
	ВыборкаОстатка = РезультатыПакета[0].Выбрать();
	Пока ВыборкаОстатка.Следующий() Цикл
		Сведения = Результат.Получить(ВыборкаОстатка.Номенклатура);
		Сведения.ФизическийОстаток = Сведения.ФизическийОстаток + ВыборкаОстатка.Количество;
		СкладыПоТоварам.Получить(ВыборкаОстатка.Номенклатура).Добавить(ВыборкаОстатка.Склад);
	КонецЦикла;
	ВыборкаЗаказов = РезультатыПакета[РезультатыПакета.ВГраница()].Выбрать();
	Пока ВыборкаЗаказов.Следующий() Цикл
		Сведения = Результат.Получить(ВыборкаЗаказов.Номенклатура);
		Сведения.ПотребностьПоЗаказам = Сведения.ПотребностьПоЗаказам + ВыборкаЗаказов.Количество;
		Если ВыборкаЗаказов.ЭтоОткрытыйНаряд Тогда
			Сведения.КоличествоВЗаказНарядах = Сведения.КоличествоВЗаказНарядах + ВыборкаЗаказов.Количество;
		КонецЕсли;
		Сведения.КоличествоАктивныхЗаказов = Сведения.КоличествоАктивныхЗаказов + 1;
	КонецЦикла;
	Для Каждого Пара Из Результат Цикл
		Сведения = Пара.Значение;
		Склады = СкладыПоТоварам.Получить(Пара.Ключ);
		Если Склады.Количество() = 1 Тогда
			Сведения.ПредставлениеСкладов = Строка(Склады[0]);
		КонецЕсли;
		Остаток = Окр(Сведения.ФизическийОстаток - Сведения.ПотребностьПоЗаказам, 3);
		Сведения.ОстатокСУчетомЗаказов = ?(Остаток < 0, 0, Остаток);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ДобавитьЗапросАктивныхЗаказов(Запрос, УчитыватьОткрытыеНаряды)

	УчитыватьОткрытыеНаряды = УчитыватьОткрытыеНаряды
		И ПравоДоступа("Чтение", Метаданные.Документы.ЗаказПокупателя)
		И ПравоДоступа("Чтение", Метаданные.Справочники.ВидыЗаказНарядов);
	ЗарегистрированныеЗаказы = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|    Заказы.Номенклатура КАК Номенклатура,
	|    Заказы.ЗаказПокупателя КАК ЗаказПокупателя,
	|    СУММА(Заказы.КоличествоОстаток) КАК Количество,
	|    ЛОЖЬ КАК ЭтоОткрытыйНаряд
	|/*ЗАРЕГИСТРИРОВАННЫЕ_ЗАКАЗЫ*/
	|ИЗ РегистрНакопления.ЗаказыПокупателей.Остатки(, Номенклатура В (&Номенклатура)) КАК Заказы
	|СГРУППИРОВАТЬ ПО Заказы.Номенклатура, Заказы.ЗаказПокупателя
	|ИМЕЮЩИЕ СУММА(Заказы.КоличествоОстаток) > 0";
	Если Не УчитыватьОткрытыеНаряды Тогда
		Запрос.Текст = Запрос.Текст + СтрЗаменить(ЗарегистрированныеЗаказы, "/*ЗАРЕГИСТРИРОВАННЫЕ_ЗАКАЗЫ*/", "");
		Возврат;
	КонецЕсли;

	Запрос.УстановитьПараметр("ДатаОстатков", ТекущаяДатаСеанса());
	Запрос.Текст = Запрос.Текст + СтрЗаменить(ЗарегистрированныеЗаказы,
		"/*ЗАРЕГИСТРИРОВАННЫЕ_ЗАКАЗЫ*/", "ПОМЕСТИТЬ АС_ЗарегистрированныеЗаказы") + ";" + Символы.ПС
		+ ТекстПотребностиОткрытыхЗаказНарядов() + "
	|ВЫБРАТЬ Заказы.Номенклатура КАК Номенклатура, Заказы.ЗаказПокупателя КАК ЗаказПокупателя,
	|    Заказы.Количество КАК Количество, Заказы.ЭтоОткрытыйНаряд КАК ЭтоОткрытыйНаряд
	|ИЗ АС_ЗарегистрированныеЗаказы КАК Заказы
	|ГДЕ НЕ (Заказы.ЗаказПокупателя В (ВЫБРАТЬ Наряды.Заказ ИЗ АС_ОткрытыеНаряды КАК Наряды))
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ Потребность.Номенклатура, Потребность.Заказ,
	|    СУММА(Потребность.Количество), ИСТИНА
	|ИЗ АС_ПотребностьОткрытыхНарядов КАК Потребность
	|СГРУППИРОВАТЬ ПО Потребность.Номенклатура, Потребность.Заказ";

КонецПроцедуры

Функция ТекстОткрытыхЗаказНарядов(ИсточникЗаказов) Экспорт

	// Признак выполнения берём из порядка состояний вида заказ-наряда, как при проведении УНФ.
	ФильтрЗаказов = ?(ПустаяСтрока(ИсточникЗаказов), "", "И Заказы.Ссылка В (" + ИсточникЗаказов + ")");
	Возврат "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ Заказы.Ссылка КАК Заказ
	|ПОМЕСТИТЬ АС_ОткрытыеНаряды
	|ИЗ Документ.ЗаказПокупателя КАК Заказы
	|    ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыЗаказНарядов.ПорядокСостояний КАК Порядок
	|    ПО Порядок.Ссылка = Заказы.ВидЗаказа И Порядок.Состояние = Заказы.СостояниеЗаказа
	|ГДЕ Заказы.Проведен И НЕ Заказы.ПометкаУдаления
	|    И Заказы.Дата <= &ДатаОстатков
	|    И Заказы.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаряд)
	|    И Заказы.ВариантЗавершения = ЗНАЧЕНИЕ(Перечисление.ВариантыЗавершенияЗаказа.ПустаяСсылка)
	|    И НЕ ЕСТЬNULL(Порядок.НомерСтроки >= Порядок.Ссылка.НомерСостоянияВыполнения, ЛОЖЬ)
	|    " + ФильтрЗаказов + "
	|ИНДЕКСИРОВАТЬ ПО Заказ;";

КонецФункции

Функция ТекстПотребностиОткрытыхЗаказНарядов(ОграничитьТовары = Истина, ДляЗакупки = Ложь) Экспорт

	ФильтрТоваров = ?(ОграничитьТовары, "Номенклатура В (&Номенклатура)", "ИСТИНА");
	ИсточникЗаказов = "";
	Если ОграничитьТовары Тогда
		ИсточникЗаказов = "ВЫБРАТЬ Строки.Ссылка
		|ИЗ Документ.ЗаказПокупателя.Запасы КАК Строки
		|ГДЕ " + ФильтрТоваров;
	КонецЕсли;
	Если Не ДляЗакупки И ОграничитьТовары Тогда
		// Зарегистрированные строки нужны в том числе после удаления товара из наряда.
		ИсточникЗаказов = ИсточникЗаказов + "
		|ОБЪЕДИНИТЬ
		|ВЫБРАТЬ Остатки.ЗаказПокупателя ИЗ АС_ЗарегистрированныеЗаказы КАК Остатки";
	КонецЕсли;
	Текст = ТекстОткрытыхЗаказНарядов(ИсточникЗаказов) + "
	|
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|    Строки.Ссылка КАК Заказ,
	|    ВЫРАЗИТЬ(Строки.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
	|    Строки.Характеристика КАК Характеристика, /*ПОЛЯ_ЗАКУПКИ*/
	|    СУММА(Строки.Количество * ВЫБОР
	|        КОГДА Строки.ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерения
	|        ТОГДА ВЫРАЗИТЬ(Строки.ЕдиницаИзмерения КАК Справочник.ЕдиницыИзмерения).Коэффициент
	|        ИНАЧЕ 1 КОНЕЦ) КАК Количество
	|ПОМЕСТИТЬ АС_ТоварыОткрытыхНарядов
	|ИЗ Документ.ЗаказПокупателя.Запасы КАК Строки
	|ГДЕ Строки.Ссылка В (ВЫБРАТЬ Наряды.Заказ ИЗ АС_ОткрытыеНаряды КАК Наряды)
	|    И Строки.Номенклатура ССЫЛКА Справочник.Номенклатура И /*ТОВАРЫ*/
	|    И Строки.Количество > 0 И НЕ Строки.АС_НеСписывать И НЕ Строки.ЭтоРазделитель
	|    И (Строки.Ссылка.ОсновнойВариантКП = 0 ИЛИ Строки.НомерВариантаКП = Строки.Ссылка.ОсновнойВариантКП)
	|СГРУППИРОВАТЬ ПО Строки.Ссылка, Строки.Номенклатура, Строки.Характеристика /*ГРУППИРОВКА_ЗАКУПКИ*/
	|ИНДЕКСИРОВАТЬ ПО Заказ, Номенклатура, Характеристика;
	|
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|    Отгрузки.ЗаказПокупателя КАК Заказ, Отгрузки.Номенклатура КАК Номенклатура,
	|    Отгрузки.Характеристика КАК Характеристика, СУММА(Отгрузки.КоличествоРасход) КАК Количество
	|ПОМЕСТИТЬ АС_ОтгрузкиОткрытыхНарядов
	|ИЗ РегистрНакопления.ЗаказыПокупателей.Обороты(, &ДатаОстатков, ,
	|    /*ТОВАРЫ*/
	|    И ЗаказПокупателя В (ВЫБРАТЬ Наряды.Заказ ИЗ АС_ОткрытыеНаряды КАК Наряды)) КАК Отгрузки
	|СГРУППИРОВАТЬ ПО Отгрузки.ЗаказПокупателя, Отгрузки.Номенклатура, Отгрузки.Характеристика
	|ИМЕЮЩИЕ СУММА(Отгрузки.КоличествоРасход) > 0
	|ИНДЕКСИРОВАТЬ ПО Заказ, Номенклатура, Характеристика;
	|
	|";
	Текст = СтрЗаменить(Текст, "/*ТОВАРЫ*/", ФильтрТоваров);
	Если ДляЗакупки Тогда
		ДатаДобавления = "НАЧАЛОПЕРИОДА(ВЫБОР КОГДА Строки.АС_ДатаДобавления = ДАТАВРЕМЯ(1, 1, 1)
		|    ТОГДА Строки.Ссылка.Дата ИНАЧЕ Строки.АС_ДатаДобавления КОНЕЦ, МЕСЯЦ)";
		Склад = "ВЫБОР КОГДА Строки.Ссылка.ПоложениеСклада =
		|    ЗНАЧЕНИЕ(Перечисление.ПоложениеРеквизитаНаФорме.ВТабличнойЧасти)
		|    ТОГДА Строки.СтруктурнаяЕдиницаРезерв ИНАЧЕ Строки.Ссылка.СтруктурнаяЕдиницаРезерв КОНЕЦ";
		Текст = СтрЗаменить(Текст, "/*ПОЛЯ_ЗАКУПКИ*/",
			"Строки.Ссылка.Организация КАК Организация, " + Склад + " КАК Склад, "
			+ ДатаДобавления + " КАК Месяц,");
		Текст = СтрЗаменить(Текст, "/*ГРУППИРОВКА_ЗАКУПКИ*/",
			", Строки.Ссылка.Организация, " + Склад + ", " + ДатаДобавления);
		Возврат Текст + "
		|ВЫБРАТЬ Товары.Заказ, Товары.Номенклатура, Товары.Характеристика,
		|    Товары.Организация, Товары.Склад, Товары.Месяц, Товары.Количество,
		|    ЕСТЬNULL(Отгрузки.Количество, 0) КАК Отгружено
		|ИЗ АС_ТоварыОткрытыхНарядов КАК Товары
		|    ЛЕВОЕ СОЕДИНЕНИЕ АС_ОтгрузкиОткрытыхНарядов КАК Отгрузки
		|    ПО Товары.Заказ = Отгрузки.Заказ И Товары.Номенклатура = Отгрузки.Номенклатура
		|        И Товары.Характеристика = Отгрузки.Характеристика
		|УПОРЯДОЧИТЬ ПО Товары.Заказ, Товары.Номенклатура, Товары.Характеристика, Товары.Месяц, Товары.Склад";
	КонецЕсли;

	Текст = СтрЗаменить(Текст, "/*ПОЛЯ_ЗАКУПКИ*/", "");
	Текст = СтрЗаменить(Текст, "/*ГРУППИРОВКА_ЗАКУПКИ*/", "");
	Возврат Текст + "
	|ВЫБРАТЬ Товары.Заказ КАК Заказ, Товары.Номенклатура КАК Номенклатура,
	|    Товары.Количество - ЕСТЬNULL(Отгрузки.Количество, 0) КАК Количество
	|ПОМЕСТИТЬ АС_ПотребностьОткрытыхНарядов
	|ИЗ АС_ТоварыОткрытыхНарядов КАК Товары
	|    ЛЕВОЕ СОЕДИНЕНИЕ АС_ОтгрузкиОткрытыхНарядов КАК Отгрузки
	|    ПО Товары.Заказ = Отгрузки.Заказ
	|        И Товары.Номенклатура = Отгрузки.Номенклатура И Товары.Характеристика = Отгрузки.Характеристика
	|ГДЕ Товары.Количество > ЕСТЬNULL(Отгрузки.Количество, 0);";

КонецФункции

Функция ПолучитьАктивныеЗаказы(Номенклатура) Экспорт
	Результат = Новый СписокЗначений;
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Результат;
	КонецЕсли;

	Товары = Новый Массив;
	Товары.Добавить(Номенклатура);
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Номенклатура", Товары);
	ДобавитьЗапросАктивныхЗаказов(Запрос, Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ПредставлениеЗаказа = Строка(Выборка.ЗаказПокупателя)
			+ " — заказано: " + Формат(Выборка.Количество, "ЧН=0; ЧДЦ=3");
		Результат.Добавить(Выборка.ЗаказПокупателя, ПредставлениеЗаказа);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция КоэффициентЕдиницыИзмерения(ЕдиницаИзмерения)

	Если ТипЗнч(ЕдиницаИзмерения) = Тип("СправочникСсылка.ЕдиницыИзмерения") Тогда
		Коэффициент = ЕдиницаИзмерения.Коэффициент;
		Возврат ?(Коэффициент = 0, 1, Коэффициент);
	КонецЕсли;

	Возврат 1;

КонецФункции
