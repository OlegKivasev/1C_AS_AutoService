// Исходная цена сохраняется отдельно от цены продажи, в том числе после записи.
Функция УстановитьЦенуРаботы(СтрокаРаботы, Наличные, ВведенаЦена = Ложь,
	ПереключениеРежима = Ложь, ПрименятьНаценку = Истина) Экспорт

	Если СтрокаРаботы = Неопределено
		Или ТипЗнч(СтрокаРаботы.Номенклатура) <> Тип("СправочникСсылка.Номенклатура")
		Или Не ЗначениеЗаполнено(СтрокаРаботы.Номенклатура) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(
		СтрокаРаботы, "ТипНоменклатурыЗапас") Тогда
		Если СтрокаРаботы.ТипНоменклатурыЗапас Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	СохраненаИсходнаяЦена = СтрокаРаботы.АС_НоменклатураИсходнойЦены = СтрокаРаботы.Номенклатура
		И СтрокаРаботы.Цена = СтрокаРаботы.АС_ЦенаРаботыПослеНаценки;
	Если СохраненаИсходнаяЦена И Не ВведенаЦена И Не ПереключениеРежима Тогда
		Если ПрименятьНаценку Или Наличные
			Или СтрокаРаботы.Цена = Окр(СтрокаРаботы.АС_ИсходнаяЦенаРаботы, 2) Тогда
			Возврат Ложь;
		КонецЕсли;
		// Для юрлица при явном пересчёте снимаем только сохранённую автоматическую наценку.
	КонецЕсли;
	Если Не СохраненаИсходнаяЦена Или ВведенаЦена Тогда
		СтрокаРаботы.АС_ИсходнаяЦенаРаботы = СтрокаРаботы.Цена;
		СтрокаРаботы.АС_НоменклатураИсходнойЦены = СтрокаРаботы.Номенклатура;
	КонецЕсли;
	ИсходнаяЦенаПродажи = СтрокаРаботы.Цена;
	СтрокаРаботы.Цена = Окр(СтрокаРаботы.АС_ИсходнаяЦенаРаботы * ?(Наличные Или Не ПрименятьНаценку, 1, 1.05), 2);
	СтрокаРаботы.АС_ЦенаРаботыПослеНаценки = СтрокаРаботы.Цена;
	Возврат СтрокаРаботы.Цена <> ИсходнаяЦенаПродажи;

КонецФункции

Процедура ЗапомнитьИсторическуюЦенуРаботы(СтрокаРаботы) Экспорт

	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаРаботы, "ТипНоменклатурыЗапас") Тогда
		Если СтрокаРаботы.ТипНоменклатурыЗапас Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Если ТипЗнч(СтрокаРаботы.Номенклатура) <> Тип("СправочникСсылка.Номенклатура")
		Или Не ЗначениеЗаполнено(СтрокаРаботы.Номенклатура)
		Или ЗначениеЗаполнено(СтрокаРаботы.АС_НоменклатураИсходнойЦены) Тогда
		Возврат;
	КонецЕсли;
	СтрокаРаботы.АС_ИсходнаяЦенаРаботы = СтрокаРаботы.Цена;
	СтрокаРаботы.АС_ЦенаРаботыПослеНаценки = СтрокаРаботы.Цена;
	СтрокаРаботы.АС_НоменклатураИсходнойЦены = СтрокаРаботы.Номенклатура;

КонецПроцедуры

Функция СуммаБезРучнойСкидки(СтрокаТовара, ЭтоРМК = Ложь) Экспорт

	Если ЭтоРМК Тогда
		// Штатный расчёт уже учёл упаковки, количество и выбранный способ скидки.
		Возврат Макс(0, СтрокаТовара.СуммаБезСкидки);
	КонецЕсли;
	Количество = СтрокаТовара.Количество;
	Для Каждого Имя Из СтрРазделить("Кратность,Коэффициент", ",") Цикл
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТовара, Имя) Тогда
			Количество = Количество * СтрокаТовара[Имя];
		КонецЕсли;
	КонецЦикла;
	Возврат Макс(0, СтрокаТовара.Цена * Количество);

КонецФункции

Функция СкидкаПревышаетПредел(СтрокаТовара, Предел, ЭтоРМК = Ложь) Экспорт

	БазаСкидки = СуммаБезРучнойСкидки(СтрокаТовара, ЭтоРМК);
	Скидка = СтрокаТовара.СуммаСкидкиНаценки;
	Процент = СтрокаТовара.ПроцентСкидкиНаценки;
	Суффикс = ?(ЭтоРМК, "РМК", "ЗН");
	ИмяИсходнойЦены = "АС_ЦенаДоОкругления" + Суффикс;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТовара, ИмяИсходнойЦены) Тогда
		Если СтрокаТовара[ИмяИсходнойЦены] > 0 И СтрокаТовара.Цена > 0
			И СтрокаТовара.Цена = СтрокаТовара["АС_ЦенаПослеОкругления" + Суффикс]
			И Скидка = СтрокаТовара["АС_СкидкаПослеОкругления" + Суффикс]
			И Процент = СтрокаТовара["АС_ПроцентСкидкиПослеОкругления" + Суффикс]
			И СтрокаТовара.Сумма = СтрокаТовара["АС_СуммаПослеОкругления" + Суффикс]
			И СтрокаТовара.Количество = СтрокаТовара["АС_КоличествоПриОкруглении" + Суффикс] Тогда
			// Кассовое округление не является дополнительной ручной скидкой.
			Если ЭтоРМК И СтрокаТовара.КоличествоУпаковок <> СтрокаТовара.АС_УпаковокПриОкругленииРМК Тогда
				Возврат Процент > Предел Или Скидка > Окр(БазаСкидки * Предел / 100, 2);
			КонецЕсли;
			Если ЭтоРМК Тогда
				БазаСкидки = СтрокаТовара.АС_СуммаДоОкругленияРМК
					+ СтрокаТовара.АС_СкидкаДоОкругленияРМК
					+ СтрокаТовара.СуммаАвтоматическойСкидки + СтрокаТовара.СуммаСкидкиОплатыБонусом;
			Иначе
				БазаСкидки = БазаСкидки / СтрокаТовара.Цена * СтрокаТовара[ИмяИсходнойЦены];
			КонецЕсли;
			Скидка = СтрокаТовара["АС_СкидкаДоОкругления" + Суффикс];
			Процент = СтрокаТовара["АС_ПроцентСкидкиДоОкругления" + Суффикс];
		КонецЕсли;
	КонецЕсли;
	МаксимальнаяСкидка = Окр(БазаСкидки * Предел / 100, 2);
	Возврат Процент > Предел Или Скидка > МаксимальнаяСкидка;

КонецФункции

Процедура ЗапомнитьРассчитаннуюЦенуРаботы(СтрокаРаботы, Наличные, ПрименятьНаценку = Истина) Экспорт

	Если СтрокаРаботы = Неопределено
		Или ТипЗнч(СтрокаРаботы.Номенклатура) <> Тип("СправочникСсылка.Номенклатура")
		Или Не ЗначениеЗаполнено(СтрокаРаботы.Номенклатура) Тогда
		Возврат;
	КонецЕсли;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаРаботы, "ТипНоменклатурыЗапас") Тогда
		Если СтрокаРаботы.ТипНоменклатурыЗапас Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	// Ручная сумма уже является итогом продажи. Не добавляем к ней наценку повторно.
	СтрокаРаботы.АС_ИсходнаяЦенаРаботы = СтрокаРаботы.Цена / ?(Наличные Или Не ПрименятьНаценку, 1, 1.05);
	СтрокаРаботы.АС_ЦенаРаботыПослеНаценки = СтрокаРаботы.Цена;
	СтрокаРаботы.АС_НоменклатураИсходнойЦены = СтрокаРаботы.Номенклатура;

КонецПроцедуры

// Общий шаг для наличного итога документа и подсказки другого способа оплаты.
Функция ОкруглитьНаличныйИтог(Сумма) Экспорт

	Если Сумма <= 0 Тогда
		Возврат Сумма;
	КонецЕсли;
	ШагОкругления = ?(Сумма <= 200, 10, 50);
	// Ровно половина шага округляется вверх: 125 -> 130, 6975 -> 7000.
	Результат = ШагОкругления * Окр(Сумма / ШагОкругления, 0, РежимОкругления.Окр15как20);
	// Сохраняем минимальный положительный итог наличными 10 рублей.
	Возврат Макс(10, Результат);

КонецФункции

// Сравниваются полные суммы после скидок и наличного округления.
Функция СогласоватьИтогКартой(ИтогКартой, ИтогНаличными) Экспорт

	Возврат Макс(Окр(ИтогКартой, 2), Окр(ИтогНаличными, 2));

КонецФункции

// Единый прогноз заказ-наряда для формы и фонового обмена.
// Перенесён без изменения финансовых формул из ТабличныеЧастиУНФКлиент.
// Штатные расчёты строк УНФ: 1С-Софт, CC BY 4.0.
Функция АС_АльтернативныйИтогЗаказа(Контекст) Экспорт

	АС_ПрогнозЗаказаВосстановитьЦеныДоОкругления(Контекст);
	Контекст.Объект.СуммаВключаетНДС = Контекст.НоваяСуммаВключаетНДС;
	Для Каждого ИмяТаблицы Из СтрРазделить("Запасы,Работы", ",") Цикл
		Для Каждого СтрокаТовара Из Контекст.Объект[ИмяТаблицы] Цикл
			Если ИмяТаблицы = "Запасы" И СтрокаТовара.ТипНоменклатурыЗапас Тогда
				Если СтрокаТовара.АС_ЦенаДляПрогноза <> Неопределено Тогда
					СтрокаТовара.Цена = Окр(СтрокаТовара.АС_ЦенаДляПрогноза, 2);
				КонецЕсли;
			Иначе
				ИзмененаЦена = АС_РежимОплатыКлиентСервер.УстановитьЦенуРаботы(
					СтрокаТовара, Контекст.Объект.АС_ОплатаНаличными, Ложь, Истина);
			КонецЕсли;
			Если Контекст.ОграничиватьСкидки Тогда
				МаксимальнаяСкидка = Окр(АС_ПрогнозЗаказаСуммаБезСкидкиСтроки(Контекст, СтрокаТовара)
					* Контекст.ПределСкидки / 100, 2);
				Если СтрокаТовара.ПроцентСкидкиНаценки > Контекст.ПределСкидки Тогда
					СтрокаТовара.ПроцентСкидкиНаценки = Контекст.ПределСкидки;
					СтрокаТовара.СуммаСкидкиНаценки = МаксимальнаяСкидка;
				КонецЕсли;
				СтрокаТовара.СуммаСкидкиНаценки = Мин(СтрокаТовара.СуммаСкидкиНаценки, МаксимальнаяСкидка);
			КонецЕсли;
			Параметры = Новый Структура("СуммаВключаетНДС,ИспользоватьМинимальныеЦены,АС_ОплатаНаличными",
				Контекст.Объект.СуммаВключаетНДС, Контекст.ИспользоватьМинимальныеЦены, Контекст.Объект.АС_ОплатаНаличными);
			Параметры.Вставить(?(СтрокаТовара.ПроцентСкидкиНаценки = 0,
				"РассчитатьПроцентСкидки", "РассчитатьСуммуСкидки"), Истина);
			АС_РассчитатьСтрокуПрогнозаЗаказа(СтрокаТовара, Параметры);
		КонецЦикла;
	КонецЦикла;
	Если Контекст.Округлять Тогда
		АС_ПрогнозЗаказаОкруглитьИтогИзменениемЦены(Контекст);
	КонецЕсли;
	Результат = Контекст.СтоимостьДоставки;
	Для Каждого СтрокаТовара Из Контекст.Объект.Запасы Цикл
		Если СтрокаТовара.АС_ВходитВИтогПрогноза Тогда
			Результат = Результат + СтрокаТовара.Всего;
		КонецЕсли;
	КонецЦикла;
	Для Каждого СтрокаРаботы Из Контекст.Объект.Работы Цикл
		Результат = Результат + СтрокаРаботы.Всего;
	КонецЦикла;
	Возврат Окр(Результат, 2);

КонецФункции

Процедура АС_ПрогнозЗаказаВосстановитьЦеныДоОкругления(Контекст)

	Для Каждого СтрокаТовара Из Контекст.Объект.Запасы Цикл
		Если СтрокаТовара.АС_ЦенаДоОкругленияЗН <= 0 Или СтрокаТовара.Отгружено > 0 Тогда
			Продолжить;
		КонецЕсли;
		ИсходнаяЦена = СтрокаТовара.АС_ЦенаДоОкругленияЗН;
		ОкругленнаяЦена = СтрокаТовара.АС_ЦенаПослеОкругленияЗН;
		ИсходнаяСумма = СтрокаТовара.АС_СуммаДоОкругленияЗН;
		ИсходнаяСкидка = СтрокаТовара.АС_СкидкаДоОкругленияЗН;
		ИсходныйПроцентСкидки = СтрокаТовара.АС_ПроцентСкидкиДоОкругленияЗН;
		КоличествоНеИзменено = СтрокаТовара.АС_КоличествоПриОкругленииЗН = 0
			Или СтрокаТовара.Количество = СтрокаТовара.АС_КоличествоПриОкругленииЗН;
		СуммаНеИзменена = СтрокаТовара.АС_КоличествоПриОкругленииЗН > 0
			И КоличествоНеИзменено
			И СтрокаТовара.Сумма = СтрокаТовара.АС_СуммаПослеОкругленияЗН;
		СкидкаНеИзменена = СтрокаТовара.СуммаСкидкиНаценки = СтрокаТовара.АС_СкидкаПослеОкругленияЗН
			И СтрокаТовара.ПроцентСкидкиНаценки = СтрокаТовара.АС_ПроцентСкидкиПослеОкругленияЗН;
		Если СтрокаТовара.Цена = ОкругленнаяЦена И СкидкаНеИзменена Тогда
			СтрокаТовара.СуммаСкидкиНаценки = СтрокаТовара.АС_СкидкаДоОкругленияЗН;
			СтрокаТовара.ПроцентСкидкиНаценки = СтрокаТовара.АС_ПроцентСкидкиДоОкругленияЗН;
		КонецЕсли;
		СтрокаТовара.АС_ЦенаДоОкругленияЗН = 0;
		СтрокаТовара.АС_ЦенаПослеОкругленияЗН = 0;
		СтрокаТовара.АС_СкидкаДоОкругленияЗН = 0;
		СтрокаТовара.АС_СкидкаПослеОкругленияЗН = 0;
		СтрокаТовара.АС_ПроцентСкидкиДоОкругленияЗН = 0;
		СтрокаТовара.АС_ПроцентСкидкиПослеОкругленияЗН = 0;
		СтрокаТовара.АС_СуммаДоОкругленияЗН = 0;
		СтрокаТовара.АС_СуммаПослеОкругленияЗН = 0;
		СтрокаТовара.АС_КоличествоПриОкругленииЗН = 0;
		// Введённая вручную или полученная по виду цен цена становится новой исходной.
		Если СтрокаТовара.Цена <> ОкругленнаяЦена Тогда
			Продолжить;
		КонецЕсли;
		СтрокаТовара.Цена = ИсходнаяЦена;
		Если Не СтрокаТовара.ЭтоРазделитель И СтрокаТовара.Отменен = 0 Тогда
			ИсходнаяАвтоСкидка = СтрокаТовара.СуммаАвтоматическойСкидки;
			ИсходнаяБонуснаяСкидка = СтрокаТовара.СуммаСкидкиОплатыБонусом;
			АС_ПрогнозЗаказаРассчитатьСтрокуПриОкруглении(Контекст, СтрокаТовара, СкидкаНеИзменена И КоличествоНеИзменено);
			Если СкидкаНеИзменена И КоличествоНеИзменено
				И СтрокаТовара.СуммаСкидкиНаценки = ИсходнаяСкидка Тогда
				// Не выводим исходный процент заново из округлённой денежной скидки:
				// при дробном количестве это превращало, например, 20% в 20,02%.
				СтрокаТовара.ПроцентСкидкиНаценки = ИсходныйПроцентСкидки;
				Если СуммаНеИзменена
					И АС_ПрогнозЗаказаСуммаСтрокиНеНижеМинимальной(Контекст, СтрокаТовара, ИсходнаяСумма)
					И СтрокаТовара.СуммаАвтоматическойСкидки = ИсходнаяАвтоСкидка
					И СтрокаТовара.СуммаСкидкиОплатыБонусом = ИсходнаяБонуснаяСкидка Тогда
					// Сохраняем точный ручной ввод суммы, если скидки не урезаны минимумом.
					СтрокаТовара.Сумма = ИсходнаяСумма;
					АС_НДСПрогнозаЗаказа(СтрокаТовара,
						Новый Структура("СуммаВключаетНДС", Контекст.Объект.СуммаВключаетНДС));
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура АС_ПрогнозЗаказаРассчитатьСтрокуПриОкруглении(Контекст, СтрокаТовара, СохранитьСуммуСкидки = Неопределено)

	СуммаБезСкидки = Окр(СтрокаТовара.Цена * СтрокаТовара.Количество, 2);
	// Как в РМК: сохраняем точную денежную скидку, когда её процент
	// согласован с новой ценой; в остальных случаях приоритет у процента.
	Если СохранитьСуммуСкидки = Неопределено Тогда
		СохранитьСуммуСкидки = СтрокаТовара.ПроцентСкидкиНаценки = 0;
		Если СуммаБезСкидки > 0 Тогда
			СохранитьСуммуСкидки = СохранитьСуммуСкидки
				Или Окр(СтрокаТовара.СуммаСкидкиНаценки / СуммаБезСкидки * 100, 2)
					= СтрокаТовара.ПроцентСкидкиНаценки;
		КонецЕсли;
	КонецЕсли;
	ПараметрыРасчета = Новый Структура("СуммаВключаетНДС,ИспользоватьМинимальныеЦены",
		Контекст.Объект.СуммаВключаетНДС, Контекст.ИспользоватьМинимальныеЦены);
	Если СохранитьСуммуСкидки Тогда
		ПараметрыРасчета.Вставить("РассчитатьПроцентСкидки", Истина);
	Иначе
		ПараметрыРасчета.Вставить("РассчитатьСуммуСкидки", Истина);
	КонецЕсли;
	АС_РассчитатьСтрокуПрогнозаЗаказа(СтрокаТовара, ПараметрыРасчета);

КонецПроцедуры

Процедура АС_ПрогнозЗаказаОкруглитьИтогИзменениемЦены(Контекст)

	Если Не Контекст.Объект.АС_ОплатаНаличными Тогда
		Возврат;
	КонецЕсли;

	ИсходныйИтог = АС_ПрогнозЗаказаИтогДляОкругления(Контекст);
	Если ИсходныйИтог <= 0 Тогда
		Контекст.ПоследнийНеокругленныйИтог = Неопределено;
		Возврат;
	КонецЕсли;
	ЦелевойИтог = АС_РежимОплатыКлиентСервер.ОкруглитьНаличныйИтог(ИсходныйИтог);
	Если ЦелевойИтог = ИсходныйИтог Тогда
		Контекст.ПоследнийНеокругленныйИтог = Неопределено;
		Возврат;
	КонецЕсли;
	// Сначала проверяем все цены; сумма служит только запасным способом.
	Для СпособОкругления = 1 По 2 Цикл
		Для ПриоритетКоличество = 1 По 2 Цикл
			Для Каждого СтрокаТовара Из Контекст.Объект.Запасы Цикл
				Если (ПриоритетКоличество = 1 И СтрокаТовара.Количество <> 1)
					Или (ПриоритетКоличество = 2 И СтрокаТовара.Количество = 1)
					Или Не АС_ПрогнозЗаказаМожноОкруглитьЦенуСтроки(Контекст, СтрокаТовара) Тогда
					Продолжить;
				КонецЕсли;
				Если АС_ПрогнозЗаказаПодобратьЦенуДляИтога(Контекст, СтрокаТовара, ИсходныйИтог, ЦелевойИтог,
					СпособОкругления = 2) Тогда
					Контекст.ПоследнийНеокругленныйИтог = Неопределено;
					Возврат;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция АС_ПрогнозЗаказаПодобратьЦенуДляИтога(Контекст, СтрокаТовара, ИсходныйИтог, ЦелевойИтог, КорректироватьСумму = Ложь)

	ИсходныеЗначения = Новый Структура(
		"Цена,Сумма,СуммаНДС,Всего,ПроцентСкидкиНаценки,СуммаСкидкиНаценки,"
		+ "ПроцентАвтоматическойСкидки,СуммаАвтоматическойСкидки,СуммаСкидкиОплатыБонусом");
	ЗаполнитьЗначенияСвойств(ИсходныеЗначения, СтрокаТовара);
	МинимальнаяЦена = 0;
	Если СтрокаТовара.Свойство("МинимальнаяЦена") Тогда
		МинимальнаяЦена = СтрокаТовара.МинимальнаяЦена;
	КонецЕсли;
	ИсходнаяЦена = ИсходныеЗначения.Цена;
	НоваяЦена = Окр(ИсходнаяЦена + (ЦелевойИтог - ИсходныйИтог) / СтрокаТовара.Количество, 2);
	ПроверенныеЦены = Новый Массив;
	Для НомерПопытки = 1 По 4 Цикл
		Если НоваяЦена <= 0 Или НоваяЦена < МинимальнаяЦена
			Или Окр(НоваяЦена * СтрокаТовара.Количество, 2) <= 0
			Или (НоваяЦена = ИсходнаяЦена И Не КорректироватьСумму)
			Или ПроверенныеЦены.Найти(НоваяЦена) <> Неопределено Тогда
			Прервать;
		КонецЕсли;
		ПроверенныеЦены.Добавить(НоваяЦена);
		ЗаполнитьЗначенияСвойств(СтрокаТовара, ИсходныеЗначения);
		СтрокаТовара.Цена = НоваяЦена;
		Попытка
			АС_ПрогнозЗаказаРассчитатьСтрокуПриОкруглении(Контекст, СтрокаТовара);
		Исключение
			ЗаполнитьЗначенияСвойств(СтрокаТовара, ИсходныеЗначения);
			ВызватьИсключение;
		КонецПопытки;
		ФактическийИтог = АС_ПрогнозЗаказаИтогДляОкругления(Контекст);
		СкидкаДопустима = Не Контекст.ОграничиватьСкидки
			Или СтрокаТовара.ПроцентСкидкиНаценки <= Контекст.ПределСкидки
				И СтрокаТовара.СуммаСкидкиНаценки <= Окр(АС_ПрогнозЗаказаСуммаБезСкидкиСтроки(Контекст, СтрокаТовара) * Контекст.ПределСкидки / 100, 2);
		// Не принимаем цену, из-за которой штатный контроль минимальной цены урезал скидки.
		АвтоСкидкаСохранена = СтрокаТовара.СуммаАвтоматическойСкидки = ИсходныеЗначения.СуммаАвтоматическойСкидки;
		СуммаБезСкидки = Окр(НоваяЦена * СтрокаТовара.Количество, 2);
		СохраняласьДенежнаяСкидка = ИсходныеЗначения.ПроцентСкидкиНаценки = 0
			Или Окр(ИсходныеЗначения.СуммаСкидкиНаценки / СуммаБезСкидки * 100, 2)
				= ИсходныеЗначения.ПроцентСкидкиНаценки;
		РучнаяСкидкаСохранена = ?(СохраняласьДенежнаяСкидка,
			СтрокаТовара.СуммаСкидкиНаценки = ИсходныеЗначения.СуммаСкидкиНаценки,
			СтрокаТовара.ПроцентСкидкиНаценки = ИсходныеЗначения.ПроцентСкидкиНаценки);
		Если КорректироватьСумму И ФактическийИтог <> ЦелевойИтог
			И СкидкаДопустима И АвтоСкидкаСохранена И РучнаяСкидкаСохранена Тогда
			Попытка
				СуммаПодобрана = АС_ПрогнозЗаказаПодобратьСуммуДляИтога(Контекст, СтрокаТовара, ФактическийИтог, ЦелевойИтог, МинимальнаяЦена);
			Исключение
				ЗаполнитьЗначенияСвойств(СтрокаТовара, ИсходныеЗначения);
				ВызватьИсключение;
			КонецПопытки;
			Если СуммаПодобрана Тогда
				ФактическийИтог = АС_ПрогнозЗаказаИтогДляОкругления(Контекст);
			КонецЕсли;
		КонецЕсли;
		Если ФактическийИтог = ЦелевойИтог И СкидкаДопустима И АвтоСкидкаСохранена И РучнаяСкидкаСохранена
			И СтрокаТовара.Сумма >= Окр(МинимальнаяЦена * СтрокаТовара.Количество, 2) Тогда
			АС_ПрогнозЗаказаЗапомнитьОкруглениеСтроки(Контекст, СтрокаТовара, ИсходныеЗначения);
			Возврат Истина;
		КонецЕсли;
		ИзменениеИтога = ФактическийИтог - ИсходныйИтог;
		Если НоваяЦена = ИсходнаяЦена Тогда
			// Ручная сумма могла отличаться от цены на копейки. При той же цене
			// делитель для оценки влияния равен нулю: проверяем соседнюю копейку.
			НоваяЦена = Окр(НоваяЦена + ?(ЦелевойИтог > ФактическийИтог, 0.01, -0.01), 2);
			Продолжить;
		КонецЕсли;
		Если ИзменениеИтога = 0 Тогда
			Прервать;
		КонецЕсли;
		ВлияниеЦеныНаИтог = ИзменениеИтога / (НоваяЦена - ИсходнаяЦена);
		НоваяЦена = Окр(НоваяЦена + (ЦелевойИтог - ФактическийИтог) / ВлияниеЦеныНаИтог, 2);
	КонецЦикла;
	ЗаполнитьЗначенияСвойств(СтрокаТовара, ИсходныеЗначения);
	Возврат Ложь;

КонецФункции

Функция АС_ПрогнозЗаказаСуммаСтрокиНеНижеМинимальной(Контекст, СтрокаТовара, ПроверяемаяСумма)

	Если ПроверяемаяСумма <= 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СтрокаТовара.Свойство("МинимальнаяЦена") И СтрокаТовара.Цена > 0 Тогда
		КоличествоДляЦены = АС_ПрогнозЗаказаСуммаБезСкидкиСтроки(Контекст, СтрокаТовара) / СтрокаТовара.Цена;
		Возврат ПроверяемаяСумма >= Окр(СтрокаТовара.МинимальнаяЦена * КоличествоДляЦены, 2);
	КонецЕсли;
	Возврат Истина;

КонецФункции

Функция АС_ПрогнозЗаказаПодобратьСуммуДляИтога(Контекст, СтрокаТовара, ИсходныйИтог, ЦелевойИтог, МинимальнаяЦена)

	ИсходныеСуммы = Новый Структура("Сумма,СуммаНДС,Всего");
	ЗаполнитьЗначенияСвойств(ИсходныеСуммы, СтрокаТовара);
	Если ИсходныеСуммы.Сумма <= 0 Или ИсходныеСуммы.Всего <= 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	КоличествоДляЦены = АС_ПрогнозЗаказаСуммаБезСкидкиСтроки(Контекст, СтрокаТовара) / СтрокаТовара.Цена;
	ПараметрыНДС = Новый Структура("СуммаВключаетНДС", Контекст.Объект.СуммаВключаетНДС);
	КоэффициентСуммы = ИсходныеСуммы.Сумма / ИсходныеСуммы.Всего;
	НоваяСумма = Окр(ИсходныеСуммы.Сумма + (ЦелевойИтог - ИсходныйИтог) * КоэффициентСуммы, 2);
	ПроверенныеСуммы = Новый Массив;
	Для НомерПопытки = 1 По 4 Цикл
		Если НоваяСумма <= 0 Или НоваяСумма < Окр(МинимальнаяЦена * СтрокаТовара.Количество, 2)
			Или ПроверенныеСуммы.Найти(НоваяСумма) <> Неопределено Тогда
			Прервать;
		КонецЕсли;
		// Поправляем лишь остаток округления: цена согласована с точной суммой
		// и уже рассчитанными скидками. Дополнительную ручную скидку не создаём.
		ЦенаИзСуммы = Окр((НоваяСумма + СтрокаТовара.СуммаСкидкиНаценки
			+ СтрокаТовара.СуммаАвтоматическойСкидки + СтрокаТовара.СуммаСкидкиОплатыБонусом)
			/ КоличествоДляЦены, 2);
		ПроверенныеСуммы.Добавить(НоваяСумма);
		СтрокаТовара.Сумма = НоваяСумма;
		Попытка
			АС_НДСПрогнозаЗаказа(СтрокаТовара, ПараметрыНДС);
		Исключение
			ЗаполнитьЗначенияСвойств(СтрокаТовара, ИсходныеСуммы);
			ВызватьИсключение;
		КонецПопытки;
		ФактическийИтог = АС_ПрогнозЗаказаИтогДляОкругления(Контекст);
		Если ФактическийИтог = ЦелевойИтог И ЦенаИзСуммы = СтрокаТовара.Цена Тогда
			Возврат Истина;
		КонецЕсли;
		НоваяСумма = Окр(НоваяСумма + (ЦелевойИтог - ФактическийИтог) * КоэффициентСуммы, 2);
	КонецЦикла;
	ЗаполнитьЗначенияСвойств(СтрокаТовара, ИсходныеСуммы);
	Возврат Ложь;

КонецФункции

Процедура АС_ПрогнозЗаказаЗапомнитьОкруглениеСтроки(Контекст, СтрокаТовара, ИсходныеЗначения)

	СтрокаТовара.АС_ЦенаДоОкругленияЗН = ИсходныеЗначения.Цена;
	СтрокаТовара.АС_ЦенаПослеОкругленияЗН = СтрокаТовара.Цена;
	СтрокаТовара.АС_СкидкаДоОкругленияЗН = ИсходныеЗначения.СуммаСкидкиНаценки;
	СтрокаТовара.АС_ПроцентСкидкиДоОкругленияЗН = ИсходныеЗначения.ПроцентСкидкиНаценки;
	СтрокаТовара.АС_СкидкаПослеОкругленияЗН = СтрокаТовара.СуммаСкидкиНаценки;
	СтрокаТовара.АС_ПроцентСкидкиПослеОкругленияЗН = СтрокаТовара.ПроцентСкидкиНаценки;
	СтрокаТовара.АС_СуммаДоОкругленияЗН = ИсходныеЗначения.Сумма;
	СтрокаТовара.АС_СуммаПослеОкругленияЗН = СтрокаТовара.Сумма;
	СтрокаТовара.АС_КоличествоПриОкругленииЗН = СтрокаТовара.Количество;

КонецПроцедуры

Функция АС_ПрогнозЗаказаСуммаБезСкидкиСтроки(Контекст, СтрокаТабличнойЧасти)

	КоличествоСтроки = СтрокаТабличнойЧасти.Количество;
	Если СтрокаТабличнойЧасти.Свойство("Кратность") Тогда
		КоличествоСтроки = КоличествоСтроки * СтрокаТабличнойЧасти.Кратность;
	КонецЕсли;
	Если СтрокаТабличнойЧасти.Свойство("Коэффициент") Тогда
		КоличествоСтроки = КоличествоСтроки * СтрокаТабличнойЧасти.Коэффициент;
	КонецЕсли;

	Результат = СтрокаТабличнойЧасти.Цена * КоличествоСтроки;
	Если Результат < 0 Тогда
		Результат = 0;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция АС_ПрогнозЗаказаИтогДляОкругления(Контекст)

	Результат = 0;
	Для Каждого СтрокаТовара Из Контекст.Объект.Запасы Цикл
		Если СтрокаТовара.АС_ВходитВОкруглениеПрогноза И Не СтрокаТовара.ЭтоРазделитель Тогда
			Результат = Результат + СтрокаТовара.Всего;
		КонецЕсли;
	КонецЦикла;
	Возврат Окр(Результат, 2);

КонецФункции

Функция АС_ПрогнозЗаказаМожноОкруглитьЦенуСтроки(Контекст, СтрокаТовара)

	Если СтрокаТовара.АС_БезСкидки Тогда
		Возврат Ложь;
	КонецЕсли;

	Если СтрокаТовара.Количество <= 0 Или СтрокаТовара.Цена <= 0
		Или СтрокаТовара.Отменен <> 0 Или СтрокаТовара.Отгружено > 0
		Или Не СтрокаТовара.АС_ВходитВОкруглениеПрогноза
		Или СтрокаТовара.ЭтоРазделитель Или СтрокаТовара.АС_НеУчитывать
		Или Не СтрокаТовара.ТипНоменклатурыЗапас Или СтрокаТовара.ПродажаПодарка
		Или СтрокаТовара.ЭтоНабор Или ЗначениеЗаполнено(СтрокаТовара.НоменклатураНабора)
		Или ТипЗнч(СтрокаТовара.Номенклатура) <> Тип("СправочникСсылка.Номенклатура") Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрокаТовара.АС_НоменклатураРазрешаетОкругление;

КонецФункции

Процедура АС_РассчитатьСтрокуПрогнозаЗаказа(СтрокаТовара, Параметры)

	Если ТабличныеЧастиУНФКлиентСервер.АС_ЭтоСтрокаБезСкидки(СтрокаТовара) Тогда
		ТабличныеЧастиУНФКлиентСервер.АС_РассчитатьСтрокуБезСкидки(СтрокаТовара, Параметры);
		СтрокаТовара.Сумма = Окр(СтрокаТовара.Сумма, 2);
		АС_НДСПрогнозаЗаказа(СтрокаТовара, Параметры);
		Возврат;
	КонецЕсли;
	Параметры.Вставить("РассчитатьСумму", Истина);
	КоличествоСтроки = СтрокаТовара.Количество;
	Если СтрокаТовара.Свойство("Кратность") И СтрокаТовара.Свойство("Коэффициент") Тогда
		КоличествоСтроки = КоличествоСтроки * СтрокаТовара.Кратность * СтрокаТовара.Коэффициент;
	КонецЕсли;
	АС_ПродолжитьРасчетПрогнозаЗаказа(СтрокаТовара, Параметры, КоличествоСтроки);

КонецПроцедуры

Процедура АС_ПродолжитьРасчетПрогнозаЗаказа(СтрокаТабличнойЧасти, ПараметрыРасчета, КоличествоСтроки)


	Если СтрокаТабличнойЧасти.Свойство("ПроцентСкидкиНаценки") Тогда

		ЕстьСкидкаБонусом = СтрокаТабличнойЧасти.Свойство("СуммаСкидкиОплатыБонусом");
		ЕстьАвтоматическаяСкидка = СтрокаТабличнойЧасти.Свойство("СуммаАвтоматическойСкидки");
		ЕстьРучнаяСкидка = СтрокаТабличнойЧасти.Свойство("СуммаСкидкиНаценки");
		ЕстьЗаказ = СтрокаТабличнойЧасти.Свойство("Заказ") И ЗначениеЗаполнено(СтрокаТабличнойЧасти.Заказ);

		ФиксированнаяСуммаАвтоматическихСкидок = Ложь;
		СуммаДоВсехСкидок = КоличествоСтроки * СтрокаТабличнойЧасти.Цена;

		Если ПараметрыРасчета.Свойство("СброситьФлагСкидкиРассчитаны") И ПараметрыРасчета.СброситьФлагСкидкиРассчитаны
			И ЕстьАвтоматическаяСкидка Тогда
			СтрокаТабличнойЧасти.СуммаАвтоматическойСкидки = Окр(0, 2);
			СтрокаТабличнойЧасти.ПроцентАвтоматическойСкидки = Окр(0, 2);
		ИначеЕсли ЕстьАвтоматическаяСкидка И ЕстьЗаказ Тогда
			ФиксированнаяСуммаАвтоматическихСкидок = Истина;
		ИначеЕсли ЕстьАвтоматическаяСкидка И СуммаДоВсехСкидок = 0 Тогда
			СтрокаТабличнойЧасти.СуммаАвтоматическойСкидки = Окр(0, 2);
			СтрокаТабличнойЧасти.ПроцентАвтоматическойСкидки = Окр(0, 2);
		ИначеЕсли ЕстьАвтоматическаяСкидка Тогда

			ПроцентАвтоматическойСкидки = 100 * СтрокаТабличнойЧасти.СуммаАвтоматическойСкидки / СуммаДоВсехСкидок;
			СтрокаТабличнойЧасти.СуммаАвтоматическойСкидки = Окр(Окр(СуммаДоВсехСкидок * ПроцентАвтоматическойСкидки / 100, 2), 2);
		КонецЕсли;

		СуммаОплатБонусом = ?(ЕстьСкидкаБонусом, СтрокаТабличнойЧасти.СуммаСкидкиОплатыБонусом, 0);
		СуммаРучныхСкидок = ?(ЕстьРучнаяСкидка, СтрокаТабличнойЧасти.СуммаСкидкиНаценки, 0);
		СуммаАвтоматическихСкидок = ?(ЕстьАвтоматическаяСкидка, СтрокаТабличнойЧасти.СуммаАвтоматическойСкидки, 0);
		СуммаСкидок = СуммаРучныхСкидок + СуммаАвтоматическихСкидок + СуммаОплатБонусом;
		СуммаДоРучнойСкидки = СуммаДоВсехСкидок - СуммаОплатБонусом - СуммаАвтоматическихСкидок;

		Если ПараметрыРасчета.Свойство("РассчитатьЦену") И ПараметрыРасчета.РассчитатьЦену = Истина Тогда
			Если КоличествоСтроки <> 0 Тогда
				Если СтрокаТабличнойЧасти.ПроцентСкидкиНаценки >= 100 И СуммаДоРучнойСкидки = 0 Тогда
					СтрокаТабличнойЧасти.ПроцентСкидкиНаценки = Окр(0, 2);
					СтрокаТабличнойЧасти.СуммаСкидкиНаценки = Окр(0, 2);
				ИначеЕсли СтрокаТабличнойЧасти.ПроцентСкидкиНаценки >= 100 Тогда

					СтрокаТабличнойЧасти.ПроцентСкидкиНаценки = Окр(Окр(100* (1 - СтрокаТабличнойЧасти.Сумма / (СуммаДоРучнойСкидки)), 2), 2);
					СтрокаТабличнойЧасти.СуммаСкидкиНаценки = Окр(Окр(СуммаДоВсехСкидок * СтрокаТабличнойЧасти.ПроцентСкидкиНаценки / 100, 2), 2);
				Иначе
					ПроцентРучной = ?(ЕстьРучнаяСкидка, СтрокаТабличнойЧасти.ПроцентСкидкиНаценки, 0);
					ПроцентАвтоматической = ?(ЕстьАвтоматическаяСкидка, СтрокаТабличнойЧасти.ПроцентАвтоматическойСкидки, 0);
					НоваяСуммаДоСкидок = СуммаСкидок;
					Если ФиксированнаяСуммаАвтоматическихСкидок Тогда
						НоваяСуммаДоСкидок = (СтрокаТабличнойЧасти.Сумма + СуммаОплатБонусом + СуммаАвтоматическихСкидок) / ((100 - ПроцентРучной)/100);
						ПроцентАвтоматической = 100 * СуммаАвтоматическихСкидок / НоваяСуммаДоСкидок;
					ИначеЕсли ПроцентРучной + ПроцентАвтоматической <> 100 Тогда
						НоваяСуммаДоСкидок = (СтрокаТабличнойЧасти.Сумма + СуммаОплатБонусом) / ((100 - ПроцентРучной - ПроцентАвтоматической)/100);
					КонецЕсли;
					СтрокаТабличнойЧасти.Цена = Окр(Окр(НоваяСуммаДоСкидок / КоличествоСтроки, 2), 2);
					Если ЕстьРучнаяСкидка Тогда
						СтрокаТабличнойЧасти.СуммаСкидкиНаценки = Окр(Окр(НоваяСуммаДоСкидок * ПроцентРучной / 100, 2), 2);
						СтрокаТабличнойЧасти.ПроцентСкидкиНаценки = Окр(Окр(ПроцентРучной, 2), 2);
					КонецЕсли;
					Если ЕстьАвтоматическаяСкидка Тогда



						СтрокаТабличнойЧасти.СуммаАвтоматическойСкидки = Окр(Окр(НоваяСуммаДоСкидок * ПроцентАвтоматической / 100, 2), 2);
						СтрокаТабличнойЧасти.ПроцентАвтоматическойСкидки = Окр(Окр(ПроцентАвтоматической, 2), 2);
					КонецЕсли;
					Если ЕстьРучнаяСкидка и ЕстьАвтоматическаяСкидка Тогда

						ОшибкаОкругления = НоваяСуммаДоСкидок * (ПроцентАвтоматической+ПроцентРучной)/100 - СтрокаТабличнойЧасти.СуммаСкидкиНаценки - СтрокаТабличнойЧасти.СуммаАвтоматическойСкидки;
						СтрокаТабличнойЧасти.СуммаСкидкиНаценки = Окр(СтрокаТабличнойЧасти.СуммаСкидкиНаценки + ОшибкаОкругления, 2);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли ПараметрыРасчета.Свойство("КорректировкаСуммыЗаСчетРучнойСкидки") И ПараметрыРасчета.КорректировкаСуммыЗаСчетРучнойСкидки = Истина Тогда
			Если КоличествоСтроки <> 0 Тогда
				СуммаРучныхСкидок = СуммаДоРучнойСкидки - СтрокаТабличнойЧасти.Сумма;
				СуммаСкидок = СуммаРучныхСкидок + СуммаАвтоматическихСкидок + СуммаОплатБонусом;
				СтрокаТабличнойЧасти.СуммаСкидкиНаценки = Окр(СуммаРучныхСкидок, 2);
				Если НЕ СуммаДоВсехСкидок = 0 Тогда
					СтрокаТабличнойЧасти.ПроцентСкидкиНаценки = Окр(Окр(100 * СуммаРучныхСкидок / СуммаДоВсехСкидок, 2), 2);
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли ПараметрыРасчета.Свойство("РассчитатьПроцентСкидки") И ПараметрыРасчета.РассчитатьПроцентСкидки Тогда

			Если СуммаДоВсехСкидок = 0 Тогда
				СтрокаТабличнойЧасти.ПроцентСкидкиНаценки = Окр(0, 2);
				СтрокаТабличнойЧасти.Сумма = Окр(Макс(СуммаДоВсехСкидок - СуммаСкидок, 0), 2);
				СтрокаТабличнойЧасти.СуммаСкидкиНаценки = Окр(СуммаДоВсехСкидок - СтрокаТабличнойЧасти.Сумма - СуммаАвтоматическихСкидок - СуммаОплатБонусом, 2);
			ИначеЕсли СтрокаТабличнойЧасти.СуммаСкидкиНаценки >= СуммаДоВсехСкидок - СуммаОплатБонусом - СуммаАвтоматическихСкидок Тогда
				СтрокаТабличнойЧасти.СуммаСкидкиНаценки = Окр(СуммаДоВсехСкидок - СуммаОплатБонусом - СуммаАвтоматическихСкидок, 2);
				СуммаРучныхСкидок = СтрокаТабличнойЧасти.СуммаСкидкиНаценки;
				СуммаСкидок = СуммаРучныхСкидок + СуммаАвтоматическихСкидок + СуммаОплатБонусом;
				СтрокаТабличнойЧасти.Сумма = Окр(0, 2);
				СтрокаТабличнойЧасти.ПроцентСкидкиНаценки = Окр(Окр(100 * СуммаРучныхСкидок / СуммаДоВсехСкидок, 2), 2);
			Иначе
				СтрокаТабличнойЧасти.ПроцентСкидкиНаценки = Окр(Окр(100 * СуммаРучныхСкидок / СуммаДоВсехСкидок, 2), 2);
				СтрокаТабличнойЧасти.Сумма = Окр(СуммаДоВсехСкидок - СуммаСкидок, 2);
			КонецЕсли;

		Иначе
			СуммаРучныхСкидок = Окр(СуммаДоВсехСкидок * СтрокаТабличнойЧасти.ПроцентСкидкиНаценки / 100, 2);
			СуммаСкидок = СуммаРучныхСкидок + СуммаАвтоматическихСкидок + СуммаОплатБонусом;
			СтрокаТабличнойЧасти.СуммаСкидкиНаценки = Окр(СуммаРучныхСкидок, 2);
			СтрокаТабличнойЧасти.Сумма = Окр(СуммаДоВсехСкидок - СуммаСкидок, 2);
		КонецЕсли;

		Если СтрокаТабличнойЧасти.Сумма >= 0 Тогда

			АС_МинимальнаяЦенаПрогнозаЗаказа(СтрокаТабличнойЧасти, КоличествоСтроки, ПараметрыРасчета);

		КонецЕсли;
	Иначе
		Если ПараметрыРасчета.Свойство("РассчитатьЦену") И ПараметрыРасчета.РассчитатьЦену = Истина Тогда
			СтрокаТабличнойЧасти.Цена = Окр(?(КоличествоСтроки=0, 0, СтрокаТабличнойЧасти.Сумма / КоличествоСтроки), 2);
		Иначе
			СтрокаТабличнойЧасти.Сумма = Окр(СтрокаТабличнойЧасти.Цена * КоличествоСтроки, 2);
		КонецЕсли;
	КонецЕсли;

	Если СтрокаТабличнойЧасти.Свойство("СуммаСкидки") Тогда
		СтрокаТабличнойЧасти.СуммаСкидки = Окр(СтрокаТабличнойЧасти.СуммаСкидкиНаценки, 2);
	КонецЕсли;

	Если СтрокаТабличнойЧасти.Свойство("СтавкаНДС") Тогда
		АС_НДСПрогнозаЗаказа(СтрокаТабличнойЧасти, ПараметрыРасчета);
	КонецЕсли;



КонецПроцедуры

Процедура АС_МинимальнаяЦенаПрогнозаЗаказа(СтрокаТабличнойЧасти, КоличествоСтроки, ПараметрыРасчета)

	ИспользоватьМинимальныеЦены = ПараметрыРасчета.Свойство("ИспользоватьМинимальныеЦены")
		И ПараметрыРасчета.ИспользоватьМинимальныеЦены
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТабличнойЧасти, "МинимальнаяЦена")
		И ЗначениеЗаполнено(СтрокаТабличнойЧасти.МинимальнаяЦена);

	ИзменитьСкидки = (ПараметрыРасчета.Свойство("РассчитатьСуммуСкидки")
		И ПараметрыРасчета.РассчитатьСуммуСкидки
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТабличнойЧасти, "СуммаСкидкиНаценки"))
		ИЛИ (ПараметрыРасчета.Свойство("РассчитатьПроцентСкидки")
		И ПараметрыРасчета.РассчитатьПроцентСкидки
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТабличнойЧасти, "ПроцентСкидкиНаценки"));

	Если ИспользоватьМинимальныеЦены И ИзменитьСкидки Тогда

		ЕстьСкидкаБонусом 		= ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТабличнойЧасти, "СуммаСкидкиОплатыБонусом");
		ЕстьАвтоматическаяСкидка= ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТабличнойЧасти, "СуммаАвтоматическойСкидки");
		ЕстьРучнаяСкидка 		= ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТабличнойЧасти, "СуммаСкидкиНаценки");

		МинимальнаяСумма = КоличествоСтроки * СтрокаТабличнойЧасти.МинимальнаяЦена;
		СуммаДоСкидок = КоличествоСтроки * СтрокаТабличнойЧасти.Цена;
		Если СтрокаТабличнойЧасти.Сумма < МинимальнаяСумма и СуммаДоСкидок > 0 Тогда

			СуммаОплатБонусом = ?(ЕстьСкидкаБонусом, СтрокаТабличнойЧасти.СуммаСкидкиОплатыБонусом, 0);
			СуммаРучныхСкидок = ?(ЕстьРучнаяСкидка, СтрокаТабличнойЧасти.СуммаСкидкиНаценки, 0);
			СуммаАвтоматическихСкидок = ?(ЕстьАвтоматическаяСкидка, СтрокаТабличнойЧасти.СуммаАвтоматическойСкидки, 0);

			СуммаРучнойСкидкиДоИзменения = СуммаРучныхСкидок;
			СуммаБонусовДоИзменения = СуммаОплатБонусом;

			МаксимальнаяСкидка = Макс(СуммаДоСкидок - МинимальнаяСумма, 0);

			Если СуммаАвтоматическихСкидок > МаксимальнаяСкидка Тогда
				СуммаРучныхСкидок = 0;

				СуммаАвтоматическихСкидок = МаксимальнаяСкидка;
			ИначеЕсли СуммаРучныхСкидок + СуммаАвтоматическихСкидок > МаксимальнаяСкидка Тогда
				СуммаРучныхСкидок = МаксимальнаяСкидка - СуммаАвтоматическихСкидок;



			КонецЕсли;

			Если ЕстьАвтоматическаяСкидка Тогда
				СтрокаТабличнойЧасти.СуммаАвтоматическойСкидки = Окр(СуммаАвтоматическихСкидок, 2);
				Если СуммаАвтоматическихСкидок = 0 Тогда
					СтрокаТабличнойЧасти.ПроцентАвтоматическойСкидки = Окр(0, 2);
				Иначе
					СтрокаТабличнойЧасти.ПроцентАвтоматическойСкидки = Окр(Окр(100 * СуммаАвтоматическихСкидок / СуммаДоСкидок, 2), 2);
				КонецЕсли;
			КонецЕсли;
			Если ЕстьРучнаяСкидка Тогда
				СтрокаТабличнойЧасти.СуммаСкидкиНаценки = Окр(СуммаРучныхСкидок, 2);
				Если СуммаРучныхСкидок = 0 Тогда
					СтрокаТабличнойЧасти.ПроцентСкидкиНаценки = Окр(0, 2);
				Иначе
					СтрокаТабличнойЧасти.ПроцентСкидкиНаценки = Окр(Окр(100 * СуммаРучныхСкидок / СуммаДоСкидок, 2), 2);
				КонецЕсли;
			КонецЕсли;



			СтрокаТабличнойЧасти.Сумма = Окр(СуммаДоСкидок - СуммаАвтоматическихСкидок - СуммаРучныхСкидок - СуммаОплатБонусом, 2);

			Если СуммаРучнойСкидкиДоИзменения > СуммаРучныхСкидок
				И СтрокаТабличнойЧасти.Цена >= СтрокаТабличнойЧасти.МинимальнаяЦена Тогда

				ПараметрыРасчета.Вставить("СообщениеПользователю", НСтр("ru = 'Размер и сумма скидки были изменены по минимальной цене'"));
			КонецЕсли;






		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

Процедура АС_НДСПрогнозаЗаказа(СтрокаТабличнойЧасти, ПараметрыРасчета)

	СтавкаНДС = УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеСтавкиНДС(СтрокаТабличнойЧасти.СтавкаНДС);

	СтрокаТабличнойЧасти.СуммаНДС = Окр(?(ПараметрыРасчета.СуммаВключаетНДС,
									  СтрокаТабличнойЧасти.Сумма - (СтрокаТабличнойЧасти.Сумма) / ((СтавкаНДС + 100) / 100),
									  СтрокаТабличнойЧасти.Сумма * СтавкаНДС / 100), 2);

	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТабличнойЧасти, "Всего") Тогда
		СтрокаТабличнойЧасти.Всего = Окр(СтрокаТабличнойЧасти.Сумма + ?(ПараметрыРасчета.СуммаВключаетНДС, 0, СтрокаТабличнойЧасти.СуммаНДС), 2);
	ИначеЕсли ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТабличнойЧасти, "СуммаСНДС") Тогда
		СтрокаТабличнойЧасти.СуммаСНДС = Окр(СтрокаТабличнойЧасти.Сумма + ?(ПараметрыРасчета.СуммаВключаетНДС, 0, СтрокаТабличнойЧасти.СуммаНДС), 2);
	КонецЕсли;

КонецПроцедуры
