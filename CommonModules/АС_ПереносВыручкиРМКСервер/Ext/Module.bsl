// Читает реквизиты расширения на сервере: ссылка настройки на клиенте их не раскрывает.
Функция НастройкаОсновнойКассы(СсылкаНастройки) Экспорт

	Результат = Новый Структура("Использовать, Касса, АвтоКарты, БанковскийСчет, Ошибка",
		Ложь, Неопределено, Ложь, Неопределено, "");
	Если Не ЗначениеЗаполнено(СсылкаНастройки) Тогда
		Возврат Результат;
	КонецЕсли;

	РеквизитыНастройки = Метаданные.Справочники.НастройкиРабочегоМестаКассира.Реквизиты;
	Если РеквизитыНастройки.Найти("АС_ИспользоватьОсновнуюКассу") = Неопределено
		Или РеквизитыНастройки.Найти("АС_ОсновнаяКасса") = Неопределено
		Или РеквизитыНастройки.Найти("АС_АвтоПоступлениеПоКартам") = Неопределено
		Или РеквизитыНастройки.Найти("АС_БанковскийСчетКартРМК") = Неопределено Тогда
		Результат.Ошибка = "Реквизиты оплаты РМК отсутствуют в конфигурации базы. Обновите конфигурацию базы данных после загрузки расширения.";
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		| Настройки.АС_ИспользоватьОсновнуюКассу КАК Использовать,
		| Настройки.АС_ОсновнаяКасса КАК Касса,
		| Настройки.АС_АвтоПоступлениеПоКартам КАК АвтоКарты,
		| Настройки.АС_БанковскийСчетКартРМК КАК БанковскийСчет
		|ИЗ
		| Справочник.НастройкиРабочегоМестаКассира КАК Настройки
		|ГДЕ
		| Настройки.Ссылка = &СсылкаНастройки";
	Запрос.УстановитьПараметр("СсылкаНастройки", СсылкаНастройки);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.Использовать = Выборка.Использовать;
		Результат.Касса = Выборка.Касса;
		Результат.АвтоКарты = Выборка.АвтоКарты;
		Результат.БанковскийСчет = Выборка.БанковскийСчет;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Переносит только фактическое движение наличных по успешно пробитому чеку.
// Чек и движение по кассе ККМ создаются штатным механизмом РМК.
Процедура ОтразитьОплатуВОсновнойКассе(ЧекККМ, ОсновнаяКасса) Экспорт

	Если Не ЗначениеЗаполнено(ОсновнаяКасса) Тогда
		ВызватьИсключение "В настройках РМК не выбрана основная касса.";
	КонецЕсли;
	Если ТипЗнч(ЧекККМ) <> Тип("ДокументСсылка.ЧекККМ") Тогда
		Возврат;
	КонецЕсли;
	Если Не ЧекККМ.Проведен Тогда
		ВызватьИсключение "Чек РМК не проведен.";
	КонецЕсли;
	Если ЧекККМ.КассаККМ.ТипКассы <> Перечисления.ТипыКассККМ.ФискальныйРегистратор Тогда
		ВызватьИсключение "Перенос выручки по каждому чеку доступен для ККТ с передачей в ОФД.";
	КонецЕсли;

	ВалютаККМ = ЧекККМ.КассаККМ.ВалютаДенежныхСредств;
	Если ОсновнаяКасса.ВалютаПоУмолчанию <> ВалютаККМ Тогда
		ВызватьИсключение "Валюта основной кассы отличается от валюты кассы ККМ.";
	КонецЕсли;

	Сумма = СуммаНаличныхПоЧеку(ЧекККМ);
	Если Сумма <= 0 Тогда
		Возврат;
	КонецЕсли;

	КлючЧека = "П:" + Строка(ЧекККМ.УникальныйИдентификатор());
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.АС_ПереносыВыручкиРМК");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("КлючЧека", КлючЧека);
		Блокировка.Заблокировать();

		Если ПереносУжеВыполнен(КлючЧека) Тогда
			ЗафиксироватьТранзакцию();
			Возврат;
		КонецЕсли;

		ДокументыПереноса = ОтразитьПродажу(ЧекККМ, ОсновнаяКасса, ВалютаККМ, Сумма);

		ЗаписьПереноса = РегистрыСведений.АС_ПереносыВыручкиРМК.СоздатьМенеджерЗаписи();
		ЗаписьПереноса.КлючЧека = КлючЧека;
		ЗаписьПереноса.СуммаПереноса = Сумма;
		ЗаписьПереноса.ИдентификаторВыемки = Строка(ДокументыПереноса.Выемка.УникальныйИдентификатор());
		ЗаписьПереноса.ИдентификаторПоступленияВКассу = Строка(
			ДокументыПереноса.Поступление.УникальныйИдентификатор());
		ЗаписьПереноса.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Вызывается из подписки ПередЗаписью чека. Запись чека и отмена связанных
// денежных документов выполняются платформой в одной транзакции.
Процедура ОтменитьПереносыПриОтменеЧека(ЧекККМ) Экспорт

	Если ТипЗнч(ЧекККМ) <> Тип("ДокументОбъект.ЧекККМ") Тогда
		Возврат;
	КонецЕсли;

	КлючНаличных = "П:" + Строка(ЧекККМ.Ссылка.УникальныйИдентификатор());
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		| Переносы.КлючЧека КАК КлючЧека,
		| Переносы.СуммаПереноса КАК СуммаПереноса,
		| Переносы.ИдентификаторВыемки КАК ИдентификаторВыемки,
		| Переносы.ИдентификаторПоступленияВКассу КАК ИдентификаторПоступленияВКассу
		|ИЗ
		| РегистрСведений.АС_ПереносыВыручкиРМК КАК Переносы
		|ГДЕ
		| Переносы.КлючЧека = &КлючНаличных";
	Запрос.УстановитьПараметр("КлючНаличных", КлючНаличных);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат;
	КонецЕсли;
	Пара = ДенежныеДокументыПоНаличным(ЧекККМ, Выборка);
	Если Пара.Поступление.Проведен Тогда
		Пара.Поступление.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	КонецЕсли;
	Если Пара.Выемка.Проведен Тогда
		Пара.Выемка.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	КонецЕсли;
	ЗаписиПереноса = РегистрыСведений.АС_ПереносыВыручкиРМК.СоздатьНаборЗаписей();
	ЗаписиПереноса.Отбор.КлючЧека.Установить(КлючНаличных);
	ЗаписиПереноса.Записать(Истина);

КонецПроцедуры

Функция ДенежныеДокументыПоНаличным(ЧекККМ, Перенос)

	Если ЗначениеЗаполнено(Перенос.ИдентификаторВыемки)
		И ЗначениеЗаполнено(Перенос.ИдентификаторПоступленияВКассу) Тогда
		СсылкаВыемки = Документы.ВыемкаНаличных.ПолучитьСсылку(
			Новый УникальныйИдентификатор(Перенос.ИдентификаторВыемки));
		СсылкаПоступления = Документы.ПоступлениеВКассу.ПолучитьСсылку(
			Новый УникальныйИдентификатор(Перенос.ИдентификаторПоступленияВКассу));
	Иначе
		// Для чеков, созданных до добавления ссылок в служебный регистр.
		Комментарий = "Автоперенос наличных РМК по чеку " + Строка(ЧекККМ.Ссылка);
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 2
			| Выемка.Ссылка КАК Выемка,
			| Поступление.Ссылка КАК Поступление
			|ИЗ
			| Документ.ВыемкаНаличных КАК Выемка
			|  ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеВКассу КАК Поступление
			|  ПО Поступление.ДокументОснование = Выемка.Ссылка
			|ГДЕ
			| ВЫРАЗИТЬ(Выемка.Комментарий КАК СТРОКА(500)) = &Комментарий
			| И ВЫРАЗИТЬ(Поступление.Комментарий КАК СТРОКА(500)) = &Комментарий
			| И Выемка.Организация = &Организация
			| И Поступление.Организация = &Организация
			| И Выемка.КассаККМ = &КассаККМ
			| И Выемка.СуммаДокумента = &Сумма
			| И Поступление.СуммаДокумента = &Сумма";
		Запрос.УстановитьПараметр("Комментарий", Комментарий);
		Запрос.УстановитьПараметр("Организация", ЧекККМ.Организация);
		Запрос.УстановитьПараметр("КассаККМ", ЧекККМ.КассаККМ);
		Запрос.УстановитьПараметр("Сумма", Перенос.СуммаПереноса);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Не Выборка.Следующий() Тогда
			ВызватьИсключение "Не найдены поступление в кассу и выемка по чеку "
				+ Строка(ЧекККМ.Ссылка) + ". Отмена чека прервана.";
		КонецЕсли;
		СсылкаВыемки = Выборка.Выемка;
		СсылкаПоступления = Выборка.Поступление;
		Если Выборка.Следующий() Тогда
			ВызватьИсключение "По чеку " + Строка(ЧекККМ.Ссылка)
				+ " найдено несколько пар денежных документов. Отмена чека прервана.";
		КонецЕсли;
	КонецЕсли;

	Выемка = СсылкаВыемки.ПолучитьОбъект();
	Поступление = СсылкаПоступления.ПолучитьОбъект();
	Если Выемка = Неопределено Или Поступление = Неопределено Тогда
		ВызватьИсключение "Денежные документы по чеку " + Строка(ЧекККМ.Ссылка)
			+ " не найдены. Отмена чека прервана.";
	КонецЕсли;
	Если Выемка.Организация <> ЧекККМ.Организация
		Или Выемка.КассаККМ <> ЧекККМ.КассаККМ
		Или Выемка.СуммаДокумента <> Перенос.СуммаПереноса
		Или Поступление.Организация <> ЧекККМ.Организация
		Или Поступление.ДокументОснование <> СсылкаВыемки
		Или Поступление.СуммаДокумента <> Перенос.СуммаПереноса Тогда
		ВызватьИсключение "Денежные документы по чеку " + Строка(ЧекККМ.Ссылка)
			+ " изменены. Проверьте их перед отменой чека.";
	КонецЕсли;
	Возврат Новый Структура("Выемка, Поступление", Выемка, Поступление);

КонецФункции

Функция СуммаНаличныхПоЧеку(ЧекККМ)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		| ЕСТЬNULL(СУММА(ВЫБОР
		|     КОГДА Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|         ТОГДА Движения.СуммаВал
		|     ИНАЧЕ -Движения.СуммаВал
		| КОНЕЦ), 0) КАК Сумма
		|ИЗ
		| РегистрНакопления.ДенежныеСредстваВКассахККМ КАК Движения
		|ГДЕ
		| Движения.Регистратор = &ЧекККМ";
	Запрос.УстановитьПараметр("ЧекККМ", ЧекККМ);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Сумма;
	КонецЕсли;
	Возврат 0;

КонецФункции

Функция ПереносУжеВыполнен(КлючЧека)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		| Переносы.КлючЧека КАК КлючЧека
		|ИЗ
		| РегистрСведений.АС_ПереносыВыручкиРМК КАК Переносы
		|ГДЕ
		| Переносы.КлючЧека = &КлючЧека";
	Запрос.УстановитьПараметр("КлючЧека", КлючЧека);
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

Функция ОтразитьПродажу(ЧекККМ, ОсновнаяКасса, ВалютаККМ, Сумма)

	ДанныеВыемки = Новый Структура;
	ДанныеВыемки.Вставить("Дата", ТекущаяДатаСеанса());
	ДанныеВыемки.Вставить("СуммаДокумента", Сумма);
	ДанныеВыемки.Вставить("КассаККМ", ЧекККМ.КассаККМ);
	ДанныеВыемки.Вставить("ВалютаДенежныхСредств", ВалютаККМ);
	ДанныеВыемки.Вставить("Организация", ЧекККМ.Организация);
	Выемка = Документы.ВыемкаНаличных.СоздатьДокумент();
	Выемка.Заполнить(ДанныеВыемки);
	Выемка.Комментарий = "";
	Выемка.Записать(РежимЗаписиДокумента.Проведение);

	Поступление = Документы.ПоступлениеВКассу.СоздатьДокумент();
	Поступление.Дата = ТекущаяДатаСеанса();
	Поступление.Заполнить(Выемка.Ссылка);
	Поступление.Касса = ОсновнаяКасса;
	Поступление.Комментарий = "";
	Поступление.Записать(РежимЗаписиДокумента.Проведение);
	Возврат Новый Структура("Выемка, Поступление", Выемка.Ссылка, Поступление.Ссылка);

КонецФункции

// Каждый способ оплаты без подключения оборудования сохраняется в чеке как
// эквайринговый терминал. Его наименование используется для комментария банка.
Процедура ОтразитьОплатуКартойНаСчете(ЧекККМ, БанковскийСчет) Экспорт

	Если Не ЗначениеЗаполнено(БанковскийСчет) Тогда
		ВызватьИсключение "В настройках РМК не выбран банковский счёт для оплаты картой.";
	КонецЕсли;
	Если ТипЗнч(ЧекККМ) <> Тип("ДокументСсылка.ЧекККМ") Тогда
		Возврат;
	КонецЕсли;
	Если Не ЧекККМ.Проведен Тогда
		ВызватьИсключение "Чек РМК не проведен.";
	КонецЕсли;
	Если БанковскийСчет.Владелец <> ЧекККМ.Организация Тогда
		ВызватьИсключение "Банковский счёт оплаты картой принадлежит другой организации.";
	КонецЕсли;
	Если БанковскийСчет.ВалютаДенежныхСредств <> ЧекККМ.КассаККМ.ВалютаДенежныхСредств Тогда
		ВызватьИсключение "Валюта банковского счёта отличается от валюты чека РМК.";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		| Оплата.ЭквайринговыйТерминал КАК СпособОплаты,
		| СУММА(Оплата.Сумма) КАК Сумма
		|ИЗ
		| Документ.ЧекККМ.БезналичнаяОплата КАК Оплата
		|ГДЕ
		| Оплата.Ссылка = &ЧекККМ
		| И Оплата.ВидОплаты = ЗНАЧЕНИЕ(Перечисление.ВидыБезналичныхОплат.БанковскаяКарта)
		|СГРУППИРОВАТЬ ПО
		| Оплата.ЭквайринговыйТерминал
		|УПОРЯДОЧИТЬ ПО
		| СпособОплаты";
	Запрос.УстановитьПараметр("ЧекККМ", ЧекККМ);
	Выборка = Запрос.Выполнить().Выбрать();
	НомерСпособа = 0;
	Пока Выборка.Следующий() Цикл
		НомерСпособа = НомерСпособа + 1;
		Если Выборка.Сумма <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Выборка.СпособОплаты) Тогда
			ВызватьИсключение "В чеке не указан способ оплаты картой.";
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Выборка.СпособОплаты.Эквайрер)
			Или Не ЗначениеЗаполнено(Выборка.СпособОплаты.Договор) Тогда
			ВызватьИсключение "Для способа оплаты «" + Строка(Выборка.СпособОплаты)
				+ "» укажите эквайера и договор эквайринга.";
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.СпособОплаты.БанковскийСчетЭквайринг)
			И Выборка.СпособОплаты.БанковскийСчетЭквайринг <> БанковскийСчет Тогда
			ВызватьИсключение "Банковский счёт способа оплаты «" + Строка(Выборка.СпособОплаты)
				+ "» отличается от счёта в настройках РМК.";
		КонецЕсли;
		Если Выборка.СпособОплаты.Договор.КонтрольВзаиморасчетовЭквайринг Тогда
			ВызватьИсключение "Для немедленного поступления по карте отключите контроль взаиморасчётов "
				+ "по договору способа оплаты «" + Строка(Выборка.СпособОплаты) + "».";
		КонецЕсли;

		КлючЧека = "Б:" + Строка(ЧекККМ.УникальныйИдентификатор()) + ":" + Строка(НомерСпособа);
		НачатьТранзакцию();
		Попытка
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.АС_ПереносыВыручкиРМК");
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			ЭлементБлокировки.УстановитьЗначение("КлючЧека", КлючЧека);
			Блокировка.Заблокировать();
			Если ПереносУжеВыполнен(КлючЧека) Тогда
				ЗафиксироватьТранзакцию();
				Продолжить;
			КонецЕсли;

			Поступление = Документы.ПоступлениеНаСчет.СоздатьДокумент();
			Поступление.Дата = ТекущаяДатаСеанса();
			Поступление.ВидОперации = Перечисления.ВидыОперацийПоступлениеНаСчет.ПоступлениеОплатыПоКартам;
			Поступление.Организация = ЧекККМ.Организация;
			Поступление.БанковскийСчет = БанковскийСчет;
			Поступление.ВалютаДенежныхСредств = БанковскийСчет.ВалютаДенежныхСредств;
			Поступление.Контрагент = Выборка.СпособОплаты.Эквайрер;
			Поступление.НалогообложениеНДС = ЧекККМ.НалогообложениеНДС;
			Поступление.Патент = ЧекККМ.Патент;
			Поступление.Статья = Справочники.СтатьиДвиженияДенежныхСредств.ОплатаОтПокупателей;
			Поступление.ПоложениеСтатьи = Перечисления.ПоложениеРеквизитаНаФорме.ВШапке;
			Поступление.ЭквайринговыйТерминал = Выборка.СпособОплаты;
			Поступление.СуммаДокумента = Выборка.Сумма;
			Поступление.Комментарий = КомментарийКарточногоПлатежа(ЧекККМ.Комментарий);
			ЗаписатьКарточноеПоступление(Поступление);

			ЗаписьПереноса = РегистрыСведений.АС_ПереносыВыручкиРМК.СоздатьМенеджерЗаписи();
			ЗаписьПереноса.КлючЧека = КлючЧека;
			ЗаписьПереноса.СуммаПереноса = Выборка.Сумма;
			ЗаписьПереноса.Записать();
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

Функция КомментарийКарточногоПлатежа(КомментарийЧека)

	Если КомментарийЧека = "Перевод на Озон"
		Или Лев(КомментарийЧека, СтрДлина("Перевод на Озон; ")) = "Перевод на Озон; " Тогда
		Возврат "Перевод на Озон";
	КонецЕсли;
	Если КомментарийЧека = "Перевод на Сбербанк"
		Или Лев(КомментарийЧека, СтрДлина("Перевод на Сбербанк; ")) = "Перевод на Сбербанк; " Тогда
		Возврат "Перевод на Сбербанк";
	КонецЕсли;
	Возврат "";

КонецФункции

Процедура ЗаписатьКарточноеПоступление(Поступление)

	// Здесь контроль взаиморасчётов уже проверен и отключён.
	// Из очереди удаляем только информацию этой успешной автоматической записи.
	ПредыдущиеСообщения = ПолучитьСообщенияПользователю(Истина);
	Попытка
		Поступление.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		СообщенияОшибки = ПолучитьСообщенияПользователю(Истина);
		ВосстановитьСообщенияПользователюРМК(ПредыдущиеСообщения);
		ВосстановитьСообщенияПользователюРМК(СообщенияОшибки);
		ВызватьИсключение;
	КонецПопытки;

	НовыеСообщения = ПолучитьСообщенияПользователю(Истина);
	ВосстановитьСообщенияПользователюРМК(ПредыдущиеСообщения);
	Для Каждого Сообщение Из НовыеСообщения Цикл
		Если Не ИнформацияОбОстаткахПоКартам(Сообщение.Текст) Тогда
			Сообщение.Сообщить();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ИнформацияОбОстаткахПоКартам(ТекстСообщения)

	ЗаголовокИнформации = НСтр("ru = 'Информация:'") + Символы.ПС
		+ НСтр("ru = 'Есть остаток в расчетах по платежным картам'");
	Если СокрЛП(ТекстСообщения) = ЗаголовокИнформации Тогда
		Возврат Истина;
	КонецЕсли;
	НачалоПодробностей = НСтр("ru = 'Остаток суммы по операции оплаты меньше разнесенной суммы платежа.'");
	Возврат Лев(ТекстСообщения, СтрДлина(НачалоПодробностей)) = НачалоПодробностей;

КонецФункции

Процедура ВосстановитьСообщенияПользователюРМК(Сообщения)

	Для Каждого Сообщение Из Сообщения Цикл
		Сообщение.Сообщить();
	КонецЦикла;

КонецПроцедуры
