Процедура ЗаполнитьСтатусыПоступления(ЗаказПоставщику) Экспорт

	Для Каждого СтрокаЗаказа Из ЗаказПоставщику.Запасы Цикл
		СтрокаЗаказа.АС_Поступление = "Не пришёл";
	КонецЦикла;

	Если Не ЗначениеЗаполнено(ЗаказПоставщику.Ссылка) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|    ЗаказыПоставщикамОстаткиИОбороты.Номенклатура КАК Номенклатура,
	|    ЗаказыПоставщикамОстаткиИОбороты.Характеристика КАК Характеристика,
	|    ЗаказыПоставщикамОстаткиИОбороты.Склад КАК Склад,
	|    СУММА(ЗаказыПоставщикамОстаткиИОбороты.КоличествоРасход) КАК Получено
	|ИЗ
	|    РегистрНакопления.ЗаказыПоставщикам.ОстаткиИОбороты(, , , , ЗаказПоставщику = &Заказ) КАК ЗаказыПоставщикамОстаткиИОбороты
	|СГРУППИРОВАТЬ ПО
	|    ЗаказыПоставщикамОстаткиИОбороты.Номенклатура,
	|    ЗаказыПоставщикамОстаткиИОбороты.Характеристика,
	|    ЗаказыПоставщикамОстаткиИОбороты.Склад";
	Запрос.УстановитьПараметр("Заказ", ЗаказПоставщику.Ссылка);
	СтрокиПолучено = Запрос.Выполнить().Выгрузить();

	Для Каждого СтрокаЗаказа Из ЗаказПоставщику.Запасы Цикл

		Если СтрокаЗаказа.Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;

		Если ЗаказПоставщику.УчетПотребностиПоСкладам Тогда
			ПараметрыПоиска = Новый Структура("Номенклатура, Характеристика, Склад",
				СтрокаЗаказа.Номенклатура,
				СтрокаЗаказа.Характеристика,
				СтрокаЗаказа.СтруктурнаяЕдиницаРезерв);
		Иначе
			ПараметрыПоиска = Новый Структура("Номенклатура, Характеристика",
				СтрокаЗаказа.Номенклатура,
				СтрокаЗаказа.Характеристика);
		КонецЕсли;

		ПолученоСтроки = 0;
		ОсталосьРаспределить = СтрокаЗаказа.Количество;
		СтрокиРегистра = СтрокиПолучено.НайтиСтроки(ПараметрыПоиска);

		Для Каждого СтрокаРегистра Из СтрокиРегистра Цикл

			Если СтрокаРегистра.Получено <= 0 Тогда
				Продолжить;
			КонецЕсли;

			КоличествоКЗачету = Мин(ОсталосьРаспределить, СтрокаРегистра.Получено);
			ПолученоСтроки = ПолученоСтроки + КоличествоКЗачету;
			СтрокаРегистра.Получено = СтрокаРегистра.Получено - КоличествоКЗачету;
			ОсталосьРаспределить = ОсталосьРаспределить - КоличествоКЗачету;

			Если ОсталосьРаспределить = 0 Тогда
				Прервать;
			КонецЕсли;

		КонецЦикла;

		Если ПолученоСтроки = 0 Тогда
			Продолжить;
		ИначеЕсли ПолученоСтроки >= СтрокаЗаказа.Количество Тогда
			СтрокаЗаказа.АС_Поступление = "Пришёл";
		Иначе
			СтрокаЗаказа.АС_Поступление = "Пришло " + Строка(ПолученоСтроки)
				+ " из " + Строка(СтрокаЗаказа.Количество);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Функция ЕстьСмешанныеТоварыДляПечатиЭтикеток(МассивДокументов) Экспорт

	Классификация = АС_ПолучитьКлассификациюТоваровДляПечатиЭтикеток(МассивДокументов);
	Возврат Классификация.ЕстьТоварыВМагазин
		И Классификация.ЕстьТоварыНаЗаказ;

КонецФункции

Функция ПодготовитьДанныеПечатиЭтикетокТолькоДляМагазина(МассивДокументов) Экспорт

	АдресПодготовленныхДанных = ПечатьДокументовУНФ.ПодготовитьСтруктуруДанныхПечатиЭтикетокИЦенниковИзДокументов(
		МассивДокументов,
		Ложь);
	ДанныеПечати = ПолучитьИзВременногоХранилища(АдресПодготовленныхДанных);
	Если ТипЗнч(ДанныеПечати) <> Тип("Структура")
		Или Не ДанныеПечати.Свойство("Запасы") Тогда
		Возврат АдресПодготовленныхДанных;
	КонецЕсли;

	Классификация = АС_ПолучитьКлассификациюТоваровДляПечатиЭтикеток(МассивДокументов);

	АС_ОставитьТолькоМагазинныеТоварыДляПечати(
		ДанныеПечати.Запасы,
		Классификация.МагазинныеТовары);

	Возврат ПоместитьВоВременноеХранилище(ДанныеПечати);

КонецФункции

Функция АС_ПолучитьКлассификациюТоваровДляПечатиЭтикеток(МассивДокументов)

	МагазинныеТовары = Новый ТаблицаЗначений;
	МагазинныеТовары.Колонки.Добавить("Номенклатура");
	МагазинныеТовары.Колонки.Добавить("Характеристика");
	МагазинныеТовары.Колонки.Добавить("Партия");
	МагазинныеТовары.Колонки.Добавить("Серия");
	МагазинныеТовары.Колонки.Добавить("ЕдиницаИзмерения");
	МагазинныеТовары.Колонки.Добавить("Организация");
	МагазинныеТовары.Колонки.Добавить("Количество");

	Результат = Новый Структура(
		"ЕстьТоварыВМагазин,ЕстьТоварыНаЗаказ,МагазинныеТовары",
		Ложь,
		Ложь,
		МагазинныеТовары);

	Для Каждого ДокументПечати Из МассивДокументов Цикл
		Если ТипЗнч(ДокументПечати) <> Тип("ДокументСсылка.ПриходнаяНакладная")
			Или Не ЗначениеЗаполнено(ДокументПечати) Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			ПоступлениеОбъект = ДокументПечати.ПолучитьОбъект();
		Исключение
			Продолжить;
		КонецПопытки;

		ОбъектыЗаказовПоставщикам = Новый Соответствие;
		Для Каждого СтрокаПоступления Из ПоступлениеОбъект.Запасы Цикл
			Если Не ЗначениеЗаполнено(СтрокаПоступления.Номенклатура) Тогда
				Продолжить;
			КонецЕсли;

			Если АС_СтрокаПоступленияСвязанаСЗаказомПокупателя(
				СтрокаПоступления,
				ПоступлениеОбъект.Заказ,
				ОбъектыЗаказовПоставщикам) Тогда
				Результат.ЕстьТоварыНаЗаказ = Истина;
				Продолжить;
			КонецЕсли;

			Результат.ЕстьТоварыВМагазин = Истина;
			ЕстьСерии = Ложь;
			Для Каждого СтрокаСерии Из ПоступлениеОбъект.СерииНоменклатуры Цикл
				Если СтрокаСерии.КлючСвязи <> СтрокаПоступления.КлючСвязи Тогда
					Продолжить;
				КонецЕсли;

				ЕстьСерии = Истина;
				АС_ДобавитьМагазинныйТоварДляПечати(
					МагазинныеТовары,
					СтрокаПоступления,
					ПоступлениеОбъект.Организация,
					СтрокаСерии.Серия,
					СтрокаСерии.Количество);
			КонецЦикла;

			Если Не ЕстьСерии Тогда
				АС_ДобавитьМагазинныйТоварДляПечати(
					МагазинныеТовары,
					СтрокаПоступления,
					ПоступлениеОбъект.Организация,
					Справочники.СерииНоменклатуры.ПустаяСсылка(),
					СтрокаПоступления.Количество);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция АС_СтрокаПоступленияСвязанаСЗаказомПокупателя(
	СтрокаПоступления, ЗаказПоставщикуИзШапки, ОбъектыЗаказовПоставщикам)

	Если ТипЗнч(СтрокаПоступления.ЗаказПокупателя) = Тип("ДокументСсылка.ЗаказПокупателя")
		И ЗначениеЗаполнено(СтрокаПоступления.ЗаказПокупателя) Тогда
		Возврат Истина;
	КонецЕсли;

	ЗаказПоставщику = СтрокаПоступления.Заказ;
	Если ТипЗнч(ЗаказПоставщику) <> Тип("ДокументСсылка.ЗаказПоставщику")
		Или Не ЗначениеЗаполнено(ЗаказПоставщику) Тогда
		ЗаказПоставщику = ЗаказПоставщикуИзШапки;
	КонецЕсли;
	Если ТипЗнч(ЗаказПоставщику) <> Тип("ДокументСсылка.ЗаказПоставщику")
		Или Не ЗначениеЗаполнено(ЗаказПоставщику) Тогда
		Возврат Ложь;
	КонецЕсли;

	ЗаказПоставщикуОбъект = ОбъектыЗаказовПоставщикам.Получить(ЗаказПоставщику);
	Если ЗаказПоставщикуОбъект = Неопределено Тогда
		ЗаказПоставщикуОбъект = ЗаказПоставщику.ПолучитьОбъект();
		ОбъектыЗаказовПоставщикам.Вставить(ЗаказПоставщику, ЗаказПоставщикуОбъект);
	КонецЕсли;

	Если ЗаказПоставщикуОбъект.ПоложениеЗаказаПокупателя <>
		ПредопределенноеЗначение("Перечисление.ПоложениеРеквизитаНаФорме.ВТабличнойЧасти")
		И ЗначениеЗаполнено(ЗаказПоставщикуОбъект.ЗаказПокупателя) Тогда
		Возврат Истина;
	КонецЕсли;

	Для Каждого СтрокаЗаказаПоставщику Из ЗаказПоставщикуОбъект.Запасы Цикл
		Если СтрокаЗаказаПоставщику.Номенклатура = СтрокаПоступления.Номенклатура
			И СтрокаЗаказаПоставщику.Характеристика = СтрокаПоступления.Характеристика
			И ЗначениеЗаполнено(СтрокаЗаказаПоставщику.ЗаказПокупателя) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Процедура АС_ДобавитьМагазинныйТоварДляПечати(
	МагазинныеТовары, СтрокаПоступления, Организация, Серия, Количество)

	Отбор = Новый Структура(
		"Номенклатура,Характеристика,Партия,ЕдиницаИзмерения,Организация",
		СтрокаПоступления.Номенклатура,
		СтрокаПоступления.Характеристика,
		СтрокаПоступления.Партия,
		СтрокаПоступления.ЕдиницаИзмерения,
		Организация);
	Отбор.Вставить("Серия", Серия);

	НайденныеСтроки = МагазинныеТовары.НайтиСтроки(Отбор);
	Если НайденныеСтроки.Количество() = 0 Тогда
		НоваяСтрока = МагазинныеТовары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПоступления);
		НоваяСтрока.Серия = Серия;
		НоваяСтрока.Организация = Организация;
		НоваяСтрока.Количество = Количество;
	Иначе
		НайденныеСтроки[0].Количество = НайденныеСтроки[0].Количество + Количество;
	КонецЕсли;

КонецПроцедуры

Процедура АС_ОставитьТолькоМагазинныеТоварыДляПечати(Запасы, МагазинныеТовары)

	ЭтоСтараяПечать = ТипЗнч(Запасы) = Тип("ТаблицаЗначений");
	Индекс = Запасы.Количество() - 1;
	Пока Индекс >= 0 Цикл
		ТоварДляПечати = Запасы[Индекс];
		Если ЭтоСтараяПечать Тогда
			Отбор = Новый Структура(
				"Номенклатура,Характеристика,Партия,Серия,ЕдиницаИзмерения,Организация",
				ТоварДляПечати.Номенклатура,
				ТоварДляПечати.Характеристика,
				ТоварДляПечати.Партия,
				ТоварДляПечати.Серия,
				ТоварДляПечати.ЕдиницаИзмерения,
				ТоварДляПечати.Организация);
		Иначе
			Отбор = Новый Структура("Номенклатура", ТоварДляПечати.НоменклатураБПО);
			АС_ДобавитьЗаполненноеПолеОтбора(Отбор, "Характеристика", ТоварДляПечати.ХарактеристикаБПО);
			АС_ДобавитьЗаполненноеПолеОтбора(Отбор, "ЕдиницаИзмерения", ТоварДляПечати.УпаковкаБПО);
			АС_ДобавитьЗаполненноеПолеОтбора(Отбор, "Организация", ТоварДляПечати.ОрганизацияБПО);
			АС_ДобавитьПолеОтбораИзСтруктуры(Отбор, ТоварДляПечати, "Партия");
			АС_ДобавитьПолеОтбораИзСтруктуры(Отбор, ТоварДляПечати, "Серия");
		КонецЕсли;

		НайденныеСтроки = МагазинныеТовары.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() = 0 Тогда
			Если ЭтоСтараяПечать Тогда
				Запасы.Удалить(ТоварДляПечати);
			Иначе
				Запасы.Удалить(Индекс);
			КонецЕсли;
		Иначе
			Количество = 0;
			Для Каждого МагазинныйТовар Из НайденныеСтроки Цикл
				Количество = Количество + МагазинныйТовар.Количество;
			КонецЦикла;
			ТоварДляПечати.Количество = Количество;
		КонецЕсли;

		Индекс = Индекс - 1;
	КонецЦикла;

КонецПроцедуры

Процедура АС_ДобавитьЗаполненноеПолеОтбора(Отбор, ИмяПоля, Значение)

	Если Значение <> Неопределено Тогда
		Отбор.Вставить(ИмяПоля, Значение);
	КонецЕсли;

КонецПроцедуры

Процедура АС_ДобавитьПолеОтбораИзСтруктуры(Отбор, СтруктураТовара, ИмяПоля)

	ЗначениеПоля = Неопределено;
	Если СтруктураТовара.Свойство(ИмяПоля, ЗначениеПоля)
		И ЗначениеПоля <> Неопределено Тогда
		Отбор.Вставить(ИмяПоля, ЗначениеПоля);
	КонецЕсли;

КонецПроцедуры
