Процедура ЗаполнитьСтатусыПоступления(ЗаказПоставщику) Экспорт

	Для Каждого СтрокаЗаказа Из ЗаказПоставщику.Запасы Цикл
		СтрокаЗаказа.АС_Поступление = "Не пришёл";
	КонецЦикла;

	Если Не ЗначениеЗаполнено(ЗаказПоставщику.Ссылка) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|    ЗаказыПоставщикамОстаткиИОбороты.Номенклатура КАК Номенклатура,
	|    ЗаказыПоставщикамОстаткиИОбороты.Характеристика КАК Характеристика,
	|    ЗаказыПоставщикамОстаткиИОбороты.Склад КАК Склад,
	|    СУММА(ЗаказыПоставщикамОстаткиИОбороты.КоличествоРасход) КАК Получено
	|ИЗ
	|    РегистрНакопления.ЗаказыПоставщикам.ОстаткиИОбороты(, , , , ЗаказПоставщику = &Заказ) КАК ЗаказыПоставщикамОстаткиИОбороты
	|СГРУППИРОВАТЬ ПО
	|    ЗаказыПоставщикамОстаткиИОбороты.Номенклатура,
	|    ЗаказыПоставщикамОстаткиИОбороты.Характеристика,
	|    ЗаказыПоставщикамОстаткиИОбороты.Склад";
	Запрос.УстановитьПараметр("Заказ", ЗаказПоставщику.Ссылка);
	СтрокиПолучено = Запрос.Выполнить().Выгрузить();

	Для Каждого СтрокаЗаказа Из ЗаказПоставщику.Запасы Цикл

		Если СтрокаЗаказа.Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;

		Если ЗаказПоставщику.УчетПотребностиПоСкладам Тогда
			ПараметрыПоиска = Новый Структура("Номенклатура, Характеристика, Склад",
				СтрокаЗаказа.Номенклатура,
				СтрокаЗаказа.Характеристика,
				СтрокаЗаказа.СтруктурнаяЕдиницаРезерв);
		Иначе
			ПараметрыПоиска = Новый Структура("Номенклатура, Характеристика",
				СтрокаЗаказа.Номенклатура,
				СтрокаЗаказа.Характеристика);
		КонецЕсли;

		ПолученоСтроки = 0;
		ОсталосьРаспределить = СтрокаЗаказа.Количество;
		СтрокиРегистра = СтрокиПолучено.НайтиСтроки(ПараметрыПоиска);

		Для Каждого СтрокаРегистра Из СтрокиРегистра Цикл

			Если СтрокаРегистра.Получено <= 0 Тогда
				Продолжить;
			КонецЕсли;

			КоличествоКЗачету = Мин(ОсталосьРаспределить, СтрокаРегистра.Получено);
			ПолученоСтроки = ПолученоСтроки + КоличествоКЗачету;
			СтрокаРегистра.Получено = СтрокаРегистра.Получено - КоличествоКЗачету;
			ОсталосьРаспределить = ОсталосьРаспределить - КоличествоКЗачету;

			Если ОсталосьРаспределить = 0 Тогда
				Прервать;
			КонецЕсли;

		КонецЦикла;

		Если ПолученоСтроки = 0 Тогда
			Продолжить;
		ИначеЕсли ПолученоСтроки >= СтрокаЗаказа.Количество Тогда
			СтрокаЗаказа.АС_Поступление = "Пришёл";
		Иначе
			СтрокаЗаказа.АС_Поступление = "Пришло " + Строка(ПолученоСтроки)
				+ " из " + Строка(СтрокаЗаказа.Количество);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры