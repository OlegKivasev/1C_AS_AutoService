// Состояние принадлежит одной форме. Сканирование и команды пользователя
// не помещаются в очередь: откладываются только расчётные обновления панелей.

&НаКлиенте
Процедура ПодготовитьСостояние(Состояние) Экспорт

	Если Состояние = Неопределено Тогда
		Состояние = Новый Структура("ПаузаДо,РедактируемыеТаблицы,Обновления,Закрыта,Оповещения,ПроверитьОплатуПосле",
			Дата(1, 1, 1), Новый Соответствие, Новый Соответствие, Ложь,
			Новый Массив, ТекущаяДата() + 60);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗащититьРедактор(Форма) Экспорт

	ПолеВвода = Форма.ТекущийЭлемент;
	Если ТипЗнч(ПолеВвода) = Тип("ПолеФормы")
		И ПолеВвода.Вид = ВидПоляФормы.ПолеВвода
		И ПолеВвода.ОбновлениеТекстаРедактирования <> ОбновлениеТекстаРедактирования.НеИспользовать Тогда
		// Штатный режим: изменение другого реквизита не перечитывает редактор.
		ПолеВвода.ОбновлениеТекстаРедактирования =
			ОбновлениеТекстаРедактирования.ПриИзмененииЗначения;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция МожноОбновить(Форма, Состояние) Экспорт

	ПодготовитьСостояние(Состояние);
	Если Состояние.Закрыта Или Не Форма.ВводДоступен() Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТекущаяДата() < Состояние.ПаузаДо
		Или Состояние.РедактируемыеТаблицы.Количество() > 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	ЗащититьРедактор(Форма);
	ПолеВвода = Форма.ТекущийЭлемент;
	Если ТипЗнч(ПолеВвода) <> Тип("ПолеФормы") Тогда
		Возврат Истина;
	КонецЕсли;
	Если ПолеВвода.Вид <> ВидПоляФормы.ПолеВвода Или ПолеВвода.ТолькоПросмотр Тогда
		Возврат Истина;
	КонецЕсли;
	// Сохраняем весь период работы в поле, включая паузы, выделение, Ctrl+C
	// и Esc. Совпадение текста со значением ещё не означает окончание ввода.
	Возврат Ложь;

КонецФункции

&НаКлиенте
Процедура ОтметитьСканирование(Состояние) Экспорт

	ПодготовитьСостояние(Состояние);
	Состояние.ПаузаДо = ТекущаяДата() + 2;

КонецПроцедуры

&НаКлиенте
Процедура НачатьРедактированиеТаблицы(Состояние, ИмяТаблицы) Экспорт

	ПодготовитьСостояние(Состояние);
	Состояние.РедактируемыеТаблицы.Вставить(ИмяТаблицы, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьРедактированиеТаблицы(Состояние, ИмяТаблицы) Экспорт

	ПодготовитьСостояние(Состояние);
	Состояние.РедактируемыеТаблицы.Удалить(ИмяТаблицы);

КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьОбновление(Состояние, Ключ) Экспорт

	ПодготовитьСостояние(Состояние);
	Если Не Состояние.Закрыта Тогда
		Состояние.Обновления.Вставить(Ключ, Истина);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Закрыть(Состояние) Экспорт

	ПодготовитьСостояние(Состояние);
	Состояние.Закрыта = Истина;
	Состояние.Обновления.Очистить();
	Состояние.Оповещения.Очистить();

КонецПроцедуры

&НаКлиенте
Процедура НастроитьЗащитуРедакторов(Форма) Экспорт

	Для Каждого Элемент Из Форма.Элементы Цикл
		Если ТипЗнч(Элемент) = Тип("ПолеФормы")
			И Элемент.Вид = ВидПоляФормы.ПолеВвода
			И Элемент.ОбновлениеТекстаРедактирования <> ОбновлениеТекстаРедактирования.НеИспользовать Тогда
			Элемент.ОбновлениеТекстаРедактирования =
				ОбновлениеТекстаРедактирования.ПриИзмененииЗначения;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СохранитьОтложенноеОповещение(Состояние, ИмяСобытия, Параметр, Источник) Экспорт

	ПодготовитьСостояние(Состояние);
	Если Состояние.Закрыта Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Оповещение Из Состояние.Оповещения Цикл
		Если Оповещение.ИмяСобытия = ИмяСобытия
			И Оповещение.Параметр = Параметр И Оповещение.Источник = Источник Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	// Одинаковое имя события о разных карточках не означает одинаковые данные.
	Состояние.Оповещения.Добавить(
		Новый Структура("ИмяСобытия,Параметр,Источник", ИмяСобытия, Параметр, Источник));

КонецПроцедуры
