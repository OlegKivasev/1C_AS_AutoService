// HTTP выполняется только вне транзакции записи заказ-наряда.
// Параметры и секрет читаются на сервере; секрет никогда не возвращается форме.

Функция НастройкиДляФормы() Экспорт

	ПроверитьАдминистратора();
	Настройки = ПрочитатьНастройки();
	Результат = Новый Структура("Включен,Адрес,ТестоваяПлатформа,СекретЗадан,НужноПодтвердитьБазу",
		Настройки.Включен, Настройки.Адрес, Настройки.ТестоваяПлатформа,
		ЗначениеЗаполнено(ПрочитатьСекрет()), Настройки.ОтпечатокБазы <> ОтпечатокБазы());
	Если Результат.НужноПодтвердитьБазу Тогда
		Результат.Включен = Ложь;
		Результат.ТестоваяПлатформа = Истина;
	КонецЕсли;
	Для Каждого Имя Из СтрРазделить("ПоискНоменклатурыВключен,ЗакупочныйВидЦен,РозничныйВидЦен,БезналичныйВидЦен", ",") Цикл
		Результат.Вставить(Имя, Настройки[Имя]);
	КонецЦикла;
	Если Результат.НужноПодтвердитьБазу Тогда Результат.ПоискНоменклатурыВключен = Ложь; КонецЕсли;
	Результат.Вставить("КлючНоменклатурыЗадан", ЗначениеЗаполнено(ПрочитатьКлючНоменклатуры()));
	Возврат Результат;

КонецФункции

Процедура СохранитьНастройки(Включен, Адрес, ТестоваяПлатформа, НовыйСекрет, Номенклатура) Экспорт

	ПроверитьАдминистратора();
	Если ТипЗнч(Включен) <> Тип("Булево") Или ТипЗнч(ТестоваяПлатформа) <> Тип("Булево")
		Или ТипЗнч(Адрес) <> Тип("Строка") Или ТипЗнч(НовыйСекрет) <> Тип("Строка") Тогда
		ВызватьИсключение "Некорректные параметры интеграции.";
	КонецЕсли;
	Если Включен И ОбщегоНазначения.ИнформационнаяБазаФайловая() И Не ТестоваяПлатформа Тогда
		ВызватьИсключение "Для файловой копии включите флажок «Тестовая платформа».";
	КонецЕсли;
	Если ТипЗнч(Номенклатура) <> Тип("Структура") Тогда ВызватьИсключение "Некорректные настройки номенклатуры."; КонецЕсли;
	Для Каждого Имя Из СтрРазделить("ЗакупочныйВидЦен,РозничныйВидЦен,БезналичныйВидЦен,НовыйКлючНоменклатуры", ",") Цикл
		Если Не Номенклатура.Свойство(Имя) Тогда ВызватьИсключение "Не заполнены настройки номенклатуры."; КонецЕсли;
	КонецЦикла;
	Если ТипЗнч(Номенклатура.НовыйКлючНоменклатуры) <> Тип("Строка") Тогда ВызватьИсключение "Некорректные настройки номенклатуры."; КонецЕсли;
	Если ЗначениеЗаполнено(Номенклатура.НовыйКлючНоменклатуры) Тогда ПроверитьСекрет(Номенклатура.НовыйКлючНоменклатуры, "Новый ключ номенклатуры"); КонецЕсли;
	Номенклатура.Вставить("ПоискНоменклатурыВключен", ЗначениеЗаполнено(Номенклатура.НовыйКлючНоменклатуры)
		Или ЗначениеЗаполнено(ПрочитатьКлючНоменклатуры()));
	ПроверитьНастройкиНоменклатуры(Номенклатура, Номенклатура.НовыйКлючНоменклатуры);
	Адрес = СокрЛП(Адрес);
	Если Включен Или Номенклатура.ПоискНоменклатурыВключен Или ЗначениеЗаполнено(Адрес) Тогда
		ПроверитьАдрес(Адрес, ТестоваяПлатформа И Не Номенклатура.ПоискНоменклатурыВключен);
	КонецЕсли;
	Если ЗначениеЗаполнено(НовыйСекрет) Тогда
		ПроверитьСекрет(НовыйСекрет, "Новый секрет заказ-нарядов");
	КонецЕсли;
	Если Включен И Не ЗначениеЗаполнено(НовыйСекрет) И Не ЗначениеЗаполнено(ПрочитатьСекрет()) Тогда
		ВызватьИсключение "Введите отдельный секрет интеграции, заданный на сервере агрегатора.";
	КонецЕсли;
	// Назначение задания выполняется администратором, без открытия клиентского таймера.
	НастроитьРегламентныйПоискНоменклатуры(Номенклатура.ПоискНоменклатурыВключен);
	НастроитьЗаданиеАгрегатора("АС_ОбновлениеЗаказНарядовАгрегатора", "АС_ОбновлениеЗаказНарядов", Включен, 1);
	НастроитьЗаданиеАгрегатора("АС_ОтправкаЗаказНарядовАгрегатора", "АС_ОтправкаЗаказНарядов", Включен, 10);
	НастроитьЗаданиеАгрегатора("АС_СверкаЗаказНарядовАгрегатора", "АС_СверкаЗаказНарядов", Включен, 60);
	Предыдущие = ПрочитатьНастройки();
	Настройки = Новый Структура("Включен,Адрес,ТестоваяПлатформа,ОтпечатокБазы,ПроверкаЗавершена,ПервичнаяВыгрузка",
		Включен, Адрес, ТестоваяПлатформа, ОтпечатокБазы(), Ложь, "");
	Для Каждого Имя Из СтрРазделить("ПоискНоменклатурыВключен,ЗакупочныйВидЦен,РозничныйВидЦен,БезналичныйВидЦен", ",") Цикл
		Настройки.Вставить(Имя, Номенклатура[Имя]);
	КонецЦикла;
	Настройки.Вставить("ВерсияНоменклатуры", Строка(Новый УникальныйИдентификатор));
	Если Предыдущие.Адрес = Адрес И Предыдущие.ТестоваяПлатформа = ТестоваяПлатформа
		И Предыдущие.ОтпечатокБазы = Настройки.ОтпечатокБазы Тогда
		Настройки.ПервичнаяВыгрузка = Предыдущие.ПервичнаяВыгрузка;
		Если Предыдущие.Включен = Включен И Не ЗначениеЗаполнено(НовыйСекрет) Тогда
			Настройки.ПроверкаЗавершена = Предыдущие.ПроверкаЗавершена;
		КонецЕсли;
	КонецЕсли;
	БылПривилегированныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		НачатьТранзакцию();
		Блокировка = Новый БлокировкаДанных;
		Блокировка.Добавить("Константа.АС_НастройкиАгрегатора");
		Блокировка.Заблокировать();
		Если ЗначениеЗаполнено(НовыйСекрет) Тогда
			ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(
				"АС_АгрегаторРемонты", НовыйСекрет, "СекретИнтеграции");
		КонецЕсли;
		Если ЗначениеЗаполнено(Номенклатура.НовыйКлючНоменклатуры) Тогда
			ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(
				"АС_АгрегаторНоменклатура", Номенклатура.НовыйКлючНоменклатуры, "КлючИсточника");
		КонецЕсли;
		Константы.АС_НастройкиАгрегатора.Установить(Новый ХранилищеЗначения(Настройки));
		ЗафиксироватьТранзакцию();
	Исключение
		Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
		УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
		ВызватьИсключение "Не удалось сохранить настройки интеграции.";
	КонецПопытки;
	УстановитьПривилегированныйРежим(БылПривилегированныйРежим);

КонецПроцедуры

Функция ПроверитьПодключение() Экспорт

	ПроверитьАдминистратора();
	Настройки = НастройкиДляОбмена(Ложь);
	Результат = ВыполнитьЗапрос(Настройки, "GET", "/api/integration/1c/repairs/status");
	Готов = Ложь;
	Если Не Результат.Свойство("ready", Готов) Или Готов <> Истина Тогда
		ВызватьИсключение "Ответ сервера не подтверждает готовность интеграции.";
	КонецЕсли;
	Возврат "Подключение к агрегатору проверено. Секрет принят.";

КонецФункции

Процедура ПриЗаписиЗаказНаряда(Источник, Отказ) Экспорт

	Если Отказ Или Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Настройки = ПрочитатьНастройки();
	Если Не Настройки.Включен Или Настройки.ОтпечатокБазы <> ОтпечатокБазы() Тогда Возврат; КонецЕсли;
	БылПривилегированныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ЭтоЗаказНаряд = Источник.ВидОперации = Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаряд;
		// Закрытие регистрируем и без локального подтверждения: карточка могла прийти через ручное обновление.
		// Отправитель перечитает зафиксированный документ; неактивный документ означает DELETE, не POST.
		Если ЭтоЗаказНаряд Или КарточкаМоглаБытьПередана(Источник.Ссылка, Настройки.ТестоваяПлатформа) Тогда
			ПоставитьВОчередь(Источник.Ссылка, Настройки.ТестоваяПлатформа);
		КонецЕсли;
	Исключение
		УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
		ВызватьИсключение "Не удалось зарегистрировать заказ-наряд для передачи в агрегатор.";
	КонецПопытки;
	УстановитьПривилегированныйРежим(БылПривилегированныйРежим);

КонецПроцедуры


Процедура ЗапуститьОтправку(РезультатЗапуска = "", ТолькоОчередь = Ложь) Экспорт

	РезультатЗапуска = "Обмен отключен или настройки этой базы не подтверждены.";
	Настройки = ПрочитатьНастройки();
	Если Не Настройки.Включен Или Не Настройки.ПроверкаЗавершена Или Настройки.ОтпечатокБазы <> ОтпечатокБазы() Тогда Возврат; КонецЕсли;
	БылПривилегированныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		// Быстрый тик не пересчитывает склад и не создаёт задание при пустой очереди.
		Если ТолькоОчередь Тогда
			ЗапросОчереди = Новый Запрос(
				"ВЫБРАТЬ ПЕРВЫЕ 1 Очередь.Документ
				|ИЗ РегистрСведений.АС_ОчередьРемонтовАгрегатора КАК Очередь
				|ГДЕ Очередь.Документ <> ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
				|И Очередь.ТестоваяПлатформа = &ТестоваяПлатформа
				|И Очередь.СледующаяПопытка <= &Сейчас");
			ЗапросОчереди.УстановитьПараметр("ТестоваяПлатформа", Настройки.ТестоваяПлатформа);
			ЗапросОчереди.УстановитьПараметр("Сейчас", ТекущаяУниверсальнаяДата());
			ГотовыеКарточки = ЗапросОчереди.Выполнить().Выбрать();
			Если Не ГотовыеКарточки.Следующий() Тогда
				РезультатЗапуска = "Нет карточек для отправки.";
				УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
				Возврат;
			КонецЕсли;
		КонецЕсли;
		Отбор = Новый Структура("ИмяМетода,Ключ,Состояние",
			"АС_АгрегаторСервер.ОбработатьОчередь", "АС_АгрегаторРемонты", СостояниеФоновогоЗадания.Активно);
		Если ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор).Количество() = 0 Тогда
			ПараметрыОтправки = Новый Массив;
			ПараметрыОтправки.Добавить(ТолькоОчередь);
			ФоновыеЗадания.Выполнить("АС_АгрегаторСервер.ОбработатьОчередь", ПараметрыОтправки,
				"АС_АгрегаторРемонты", "Передача заказ-нарядов в агрегатор");
			РезультатЗапуска = "Фоновая отправка запущена. Нажмите «Обновить состояние» для проверки результата.";
		Иначе
			РезультатЗапуска = "Отправка уже выполняется. Дождитесь завершения и обновите состояние.";
		КонецЕсли;
	Исключение
		РезультатЗапуска = "Не удалось запустить фоновую отправку. Очередь сохранена; повторите команду.";
		// Конфликт одновременного запуска или временная недоступность фоновых заданий:
		// постоянная очередь сохраняется, следующий клиентский тик повторит запуск.
		ЗаписьЖурналаРегистрации("АС_Агрегатор.Запуск", УровеньЖурналаРегистрации.Ошибка, , ,
			"Не удалось запустить фоновую отправку ремонтов. Очередь сохранена.");
		УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
		Возврат;
	КонецПопытки;
	УстановитьПривилегированныйРежим(БылПривилегированныйРежим);

КонецПроцедуры


Процедура ОбработатьОчередь(ТолькоОчередь = Ложь) Экспорт

	Настройки = ПрочитатьНастройки();
	Если Не Настройки.Включен Или Не Настройки.ПроверкаЗавершена Или Настройки.ОтпечатокБазы <> ОтпечатокБазы() Тогда Возврат; КонецЕсли;
	БылПривилегированныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Токен = "";
	Попытка
		Токен = ЗахватитьОбработчик();
		Если Не ЗначениеЗаполнено(Токен) Тогда
			УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
			Возврат;
		КонецЕсли;
		Если Не ТолькоОчередь Тогда
			СверитьАктивныеКарточки(Настройки, ТекущаяУниверсальнаяДата() + 20);
		КонецЕсли;
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 100 Очередь.Документ, Очередь.Версия
			|ИЗ РегистрСведений.АС_ОчередьРемонтовАгрегатора КАК Очередь
			|ГДЕ Очередь.Документ <> ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
			|И Очередь.ТестоваяПлатформа = &ТестоваяПлатформа
			|И Очередь.СледующаяПопытка <= &Сейчас
			|УПОРЯДОЧИТЬ ПО Очередь.ДатаИзменения");
		Запрос.УстановитьПараметр("ТестоваяПлатформа", Настройки.ТестоваяПлатформа);
		Запрос.УстановитьПараметр("Сейчас", ТекущаяУниверсальнаяДата());
		Выборка = Запрос.Выполнить().Выбрать();
		ЗавершитьДо = ТекущаяУниверсальнаяДата() + 45;
		Пока Выборка.Следующий() И ТекущаяУниверсальнаяДата() < ЗавершитьДо Цикл
			АктуальныеНастройки = ПрочитатьНастройки();
			Если Не АктуальныеНастройки.Включен Или Не АктуальныеНастройки.ПроверкаЗавершена Или АктуальныеНастройки.Адрес <> Настройки.Адрес
				Или АктуальныеНастройки.ТестоваяПлатформа <> Настройки.ТестоваяПлатформа Тогда Прервать; КонецЕсли;
			Ошибка = "";
			Диагностика = Новый Структура("Сообщение,Повторить", "Не удалось прочитать документ или рассчитать складское наличие. Проверьте данные 1С.", Ложь);
			Попытка
				Карточка = КарточкаДокумента(Выборка.Документ, Настройки.ТестоваяПлатформа);
				Если Карточка <> Неопределено Тогда
					Диагностика.Сообщение = ОшибкаДанныхКарточки(Карточка);
					Если ЗначениеЗаполнено(Диагностика.Сообщение) Тогда ВызватьИсключение Диагностика.Сообщение; КонецЕсли;
					Ответ = ВыполнитьЗапрос(Настройки, "POST", "/api/integration/1c/repairs", Карточка, ЗавершитьДо, Диагностика);
					Диагностика.Сообщение = "Сервер не подтвердил карточку. Проверьте версию агрегатора и расширения.";
					ПодтвердитьПриемКарточки(Ответ, Карточка, Диагностика);
					Диагностика.Сообщение = "Карточка принята сайтом, но не сохранено подтверждение в 1С. Отправка будет повторена.";
					СохранитьПодтверждениеКарточки(Выборка.Документ, Настройки.ТестоваяПлатформа, Карточка);
					ПодтвердитьПервичнуюКарточку(Выборка.Документ, Настройки.ТестоваяПлатформа, Настройки.ПервичнаяВыгрузка);
				Иначе
					// Непроведённый документ не передаётся как ремонт: удаляем прежнюю карточку.
					УдалитьКарточкуСайта(Выборка.Документ, Настройки, ЗавершитьДо, Диагностика);
				КонецЕсли;
			Исключение
				// Диагностика содержит только наши сообщения, без сырых исключений и HTTP-тела.
				Ошибка = Диагностика.Сообщение;
			КонецПопытки;
			ЗавершитьЭлементОчереди(Выборка.Документ, Настройки.ТестоваяПлатформа, Выборка.Версия, Ошибка);
		КонецЦикла;
	Исключение
		Если ЗначениеЗаполнено(Токен) Тогда ОсвободитьОбработчикБезОшибки(Токен); КонецЕсли;
		УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
		ВызватьИсключение "Обработка очереди агрегатора прервана. Неотправленные карточки сохранены.";
	КонецПопытки;
	ОсвободитьОбработчикБезОшибки(Токен);
	УстановитьПривилегированныйРежим(БылПривилегированныйРежим);

КонецПроцедуры

Функция СостояниеОчереди() Экспорт

	ПроверитьАдминистратора();
	Настройки = ПрочитатьНастройки();
	БылПривилегированныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Запрос = Новый Запрос(
			"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество
			|ИЗ РегистрСведений.АС_ОчередьРемонтовАгрегатора КАК Очередь
			|ГДЕ Очередь.Документ <> ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
			|И Очередь.ТестоваяПлатформа = &ТестоваяПлатформа");
		Запрос.УстановитьПараметр("ТестоваяПлатформа", Настройки.ТестоваяПлатформа);
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		Количество = Выборка.Количество;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 20 Очередь.Документ.Номер КАК Номер, Очередь.Ошибка
			|ИЗ РегистрСведений.АС_ОчередьРемонтовАгрегатора КАК Очередь
			|ГДЕ Очередь.Документ <> ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
			|И Очередь.ТестоваяПлатформа = &ТестоваяПлатформа
			|И Очередь.Ошибка <> """"
			|УПОРЯДОЧИТЬ ПО Очередь.ДатаИзменения УБЫВ";
		Выборка = Запрос.Выполнить().Выбрать();
		Ошибка = "";
		ОшибкиТекст = "";
		Пока Выборка.Следующий() Цикл
			Если Не ЗначениеЗаполнено(Ошибка) Тогда Ошибка = Выборка.Ошибка; КонецЕсли;
			Если ЗначениеЗаполнено(ОшибкиТекст) Тогда ОшибкиТекст = ОшибкиТекст + Символы.ПС; КонецЕсли;
			ОшибкиТекст = ОшибкиТекст + "№ " + СокрЛП(Выборка.Номер) + ": " + Выборка.Ошибка;
		КонецЦикла;
	Исключение
		УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
		ВызватьИсключение "Не удалось прочитать очередь интеграции.";
	КонецПопытки;
	УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
	Возврат Новый Структура("Количество,Ошибка,ОшибкиТекст", Количество, Ошибка, ОшибкиТекст);

КонецФункции

Функция УдалитьКарточки() Экспорт

	ПроверитьАдминистратора();
	Настройки = НастройкиДляОбмена(Ложь);
	Если Настройки.Включен Тогда
		ВызватьИсключение "Для удаления отключите обмен и сохраните настройки выбранного режима.";
	КонецЕсли;
	БылПривилегированныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Токен = "";
	Диагностика = Новый Структура("Сообщение,Повторить", "Не удалось заблокировать очередь 1С для очистки.", Ложь);
	Попытка
		Токен = ЗахватитьОбработчик();
		Если Не ЗначениеЗаполнено(Токен) Тогда
			Диагностика.Сообщение = "Дождитесь окончания отправки и повторите удаление карточек.";
			ВызватьИсключение Диагностика.Сообщение;
		КонецЕсли;
		Актуальные = НастройкиДляОбмена(Ложь);
		Если Актуальные.Включен Или Актуальные.Адрес <> Настройки.Адрес
			Или Актуальные.ТестоваяПлатформа <> Настройки.ТестоваяПлатформа Тогда
			Диагностика.Сообщение = "Настройки изменены. Отключите обмен и сохраните выбранный режим заново.";
			ВызватьИсключение Диагностика.Сообщение;
		КонецЕсли;
		Путь = ?(Настройки.ТестоваяПлатформа, "/api/integration/1c/repairs/test", "/api/integration/1c/repairs/production");
		Подтверждение = ?(Настройки.ТестоваяПлатформа, "confirmTestCleanup", "confirmProductionCleanup");
		Ответ = ВыполнитьЗапрос(Настройки, "DELETE", Путь,
			Новый Структура(Подтверждение, Истина), Неопределено, Диагностика);
		Диагностика.Сообщение = "Сервер не подтвердил удаление карточек. Обновите агрегатор и повторите команду.";
		Количество = Неопределено;
		Если Не Ответ.Свойство("deleted", Количество) Или ТипЗнч(Количество) <> Тип("Число")
			Или Количество < 0 Или Количество <> Цел(Количество) Тогда
			ВызватьИсключение Диагностика.Сообщение;
		КонецЕсли;
		Диагностика.Сообщение = "Карточки выбранного режима на сайте удалены, но очистка очереди 1С не завершена. Повторите команду при выключенном обмене.";
		НачатьТранзакцию();
		Набор = РегистрыСведений.АС_ОчередьРемонтовАгрегатора.СоздатьНаборЗаписей();
		Набор.Отбор.ТестоваяПлатформа.Установить(Настройки.ТестоваяПлатформа);
		// Служебная аренда отправителя находится в рабочей платформе; сохраняем её до конца очистки.
		Набор.Прочитать();
		Индекс = Набор.Количество() - 1;
		Пока Индекс >= 0 Цикл
			Если ЗначениеЗаполнено(Набор[Индекс].Документ) Тогда Набор.Удалить(Индекс); КонецЕсли;
			Индекс = Индекс - 1;
		КонецЦикла;
		Набор.Записать();
		Сверка = РегистрыСведений.АС_СверкаКарточекАгрегатора.СоздатьНаборЗаписей();
		Сверка.Отбор.ТестоваяПлатформа.Установить(Настройки.ТестоваяПлатформа);
		Сверка.Записать();
		Первичная = РегистрыСведений.АС_ПервичнаяВыгрузкаАгрегатора.СоздатьНаборЗаписей();
		Первичная.Отбор.ТестоваяПлатформа.Установить(Настройки.ТестоваяПлатформа);
		Первичная.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
		Если ЗначениеЗаполнено(Токен) Тогда ОсвободитьОбработчикБезОшибки(Токен); КонецЕсли;
		УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
		ВызватьИсключение Диагностика.Сообщение;
	КонецПопытки;
	ОсвободитьОбработчикБезОшибки(Токен);
	УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
	Возврат Количество;

КонецФункции

// Служебные методы не экспортируются клиенту.
Процедура ПроверитьАдминистратора()
	Если Не Пользователи.ЭтоПолноправныйПользователь(Неопределено, Ложь, Ложь) Тогда
		ВызватьИсключение "Настройка интеграции доступна только пользователю с полными правами.";
	КонецЕсли;
КонецПроцедуры

Функция ПрочитатьНастройки()
	Результат = Новый Структура("Включен,Адрес,ТестоваяПлатформа,ОтпечатокБазы,ПроверкаЗавершена,ПервичнаяВыгрузка", Ложь, "", Истина, "", Истина, "");
	БылПривилегированныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Результат.Вставить("ПоискНоменклатурыВключен", Ложь);
		Результат.Вставить("ЗакупочныйВидЦен", Справочники.ВидыЦен.ПустаяСсылка());
		Результат.Вставить("РозничныйВидЦен", Справочники.ВидыЦен.ПустаяСсылка());
		Результат.Вставить("БезналичныйВидЦен", Константы.АС_ОсновнойВидЦенБезналичногоРасчета.Получить());
		Результат.Вставить("ВерсияНоменклатуры", "");
		Хранилище = Константы.АС_НастройкиАгрегатора.Получить();
		Если ТипЗнч(Хранилище) = Тип("ХранилищеЗначения") Тогда
			Данные = Хранилище.Получить();
			Если ТипЗнч(Данные) = Тип("Структура") Тогда ЗаполнитьЗначенияСвойств(Результат, Данные); КонецЕсли;
		КонецЕсли;
	Исключение
		УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
		ВызватьИсключение "Не удалось прочитать настройки агрегатора.";
	КонецПопытки;
	УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
	Результат.ПоискНоменклатурыВключен = ЗначениеЗаполнено(ПрочитатьКлючНоменклатуры());
	Возврат Результат;
КонецФункции

Функция НастройкиДляОбмена(ТребоватьВключение = Истина)
	Настройки = ПрочитатьНастройки();
	Если Настройки.ОтпечатокБазы <> ОтпечатокБазы() Тогда
		ВызватьИсключение "После копирования базы подтвердите настройки интеграции для этой базы.";
	КонецЕсли;
	Если ТребоватьВключение И Не Настройки.Включен Тогда ВызватьИсключение "Обмен с агрегатором отключен."; КонецЕсли;
	ПроверитьАдрес(Настройки.Адрес, Настройки.ТестоваяПлатформа);
	Возврат Настройки;
КонецФункции

Функция ОтпечатокБазы()
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Параметры = СтроковыеФункцииКлиентСервер.ПараметрыИзСтроки(СтрокаСоединенияИнформационнойБазы());
	КлючБазы = Новый Структура("File,Srvr,Ref", "", "", "");
	Параметры.Свойство("File", КлючБазы.File);
	Параметры.Свойство("Srvr", КлючБазы.Srvr);
	Параметры.Свойство("Ref", КлючБазы.Ref);
	Если Не ЗначениеЗаполнено(КлючБазы.File)
		И Не (ЗначениеЗаполнено(КлючБазы.Srvr) И ЗначениеЗаполнено(КлючБазы.Ref)) Тогда
		ВызватьИсключение "Не удалось определить подключение информационной базы.";
	КонецЕсли;
	Хеширование.Добавить(ЗначениеВСтрокуВнутр(КлючБазы));
	Возврат Base64Строка(Хеширование.ХешСумма);
КонецФункции

Функция ПрочитатьСекрет()
	БылПривилегированныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Секрет = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища("АС_АгрегаторРемонты", "СекретИнтеграции");
	Исключение
		УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
		ВызватьИсключение "Не удалось прочитать серверный секрет интеграции.";
	КонецПопытки;
	УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
	Возврат ?(ТипЗнч(Секрет) = Тип("Строка"), Секрет, "");
КонецФункции

Процедура ПроверитьСекрет(Секрет, ИмяПоля)
	ДопустимыеСимволы = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_-";
	ПрефиксОшибки = "Поле «" + ИмяПоля + "»: ";
	Если ТипЗнч(Секрет) <> Тип("Строка") Тогда
		ВызватьИсключение ПрефиксОшибки + "значение должно быть строкой.";
	КонецЕсли;
	Если СтрДлина(Секрет) < 32 Или СтрДлина(Секрет) > 256 Тогда
		ВызватьИсключение ПрефиксОшибки + "нужно от 32 до 256 символов. Вставьте только значение, без имени настройки, кавычек и пробелов.";
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(Секрет) Цикл
		Если СтрНайти(ДопустимыеСимволы, Сред(Секрет, Индекс, 1)) = 0 Тогда
			// Не выводим сам секрет или его фрагменты, даже в локальном исключении.
			ВызватьИсключение ПрефиксОшибки + "недопустимый символ в позиции " + Формат(Индекс, "ЧГ=0")
				+ ". Разрешены латинские буквы A–Z, a–z, цифры 0–9, дефис (-) и подчёркивание (_)."
				+ " Пробелы, переносы строк, кавычки и кириллица недопустимы. Вставьте только значение ключа или секрета.";
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ПроверитьАдрес(Адрес, ТестоваяПлатформа)
	Если Не ЗначениеЗаполнено(Адрес) Или СтрДлина(Адрес) > 500 Или СтрНайти(Адрес, "?") > 0 Или СтрНайти(Адрес, "#") > 0 Тогда
		ВызватьИсключение "Укажите адрес агрегатора вида https://имя-сервера без пути и параметров.";
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(Адрес) Цикл
		Код = КодСимвола(Адрес, Индекс);
		Если Код <= 32 Или Код = 127 Тогда ВызватьИсключение "Адрес содержит недопустимые символы."; КонецЕсли;
	КонецЦикла;
	Попытка
		URI = ОбщегоНазначенияКлиентСервер.СтруктураURI(Адрес);
	Исключение
		ВызватьИсключение "Не удалось разобрать адрес агрегатора.";
	КонецПопытки;
	Если Не ЗначениеЗаполнено(URI.Хост) Или ЗначениеЗаполнено(URI.Логин) Или ЗначениеЗаполнено(URI.Пароль)
		Или ЗначениеЗаполнено(URI.ПутьНаСервере) Тогда
		ВызватьИсключение "В адресе допускается только сервер и порт, без пароля, пути и параметров.";
	КонецЕсли;
	Если URI.Схема <> "https" И Не (ТестоваяПлатформа И URI.Схема = "http" И (URI.Хост = "127.0.0.1" Или URI.Хост = "localhost")) Тогда
		ВызватьИсключение "Для доступа через интернет используйте HTTPS. HTTP разрешен только для локальной тестовой платформы.";
	КонецЕсли;
	Если URI.Порт <> Неопределено И (URI.Порт < 1 Или URI.Порт > 65535 Или URI.Порт <> Цел(URI.Порт)) Тогда
		ВызватьИсключение "Некорректный порт агрегатора.";
	КонецЕсли;
	Возврат URI;
КонецФункции

Функция ВыполнитьЗапрос(Настройки, Метод, Путь, Тело = Неопределено, НеПозднее = Неопределено, Диагностика = Неопределено, КонтекстОбмена = Неопределено)
	Если Диагностика = Неопределено Тогда Диагностика = Новый Структура("Сообщение,Повторить", "", Ложь); КонецЕсли;
	Для НомерПопытки = 1 По 2 Цикл
		Диагностика.Сообщение = "Не удалось подготовить запрос. Проверьте сохраненный адрес и секрет интеграции.";
		Диагностика.Повторить = Ложь;
		Попытка
			Возврат ВыполнитьЗапросОдинРаз(Настройки, Метод, Путь, Тело, НеПозднее, Диагностика, КонтекстОбмена);
		Исключение
			МожноПовторить = Диагностика.Повторить И НомерПопытки < 2;
			Если НеПозднее <> Неопределено И ТекущаяУниверсальнаяДата() >= НеПозднее Тогда МожноПовторить = Ложь; КонецЕсли;
			Если Не МожноПовторить Тогда ВызватьИсключение Диагностика.Сообщение; КонецЕсли;
		КонецПопытки;
	КонецЦикла;
КонецФункции

Функция ВыполнитьЗапросОдинРаз(Настройки, Метод, Путь, Тело, НеПозднее, Диагностика, КонтекстОбмена)
	Если ТранзакцияАктивна() Тогда
		Диагностика.Сообщение = "HTTP-обмен нельзя выполнять внутри транзакции записи 1С.";
		ВызватьИсключение Диагностика.Сообщение;
	КонецЕсли;
	Если КонтекстОбмена = Неопределено Тогда
		КонтекстОбмена = Новый Структура("Соединение,Секрет", Неопределено, "");
	КонецЕсли;
	Если КонтекстОбмена.Соединение = Неопределено Тогда
		URI = ПроверитьАдрес(Настройки.Адрес, Настройки.ТестоваяПлатформа);
		КонтекстОбмена.Секрет = ПрочитатьСекрет();
		ПроверитьСекрет(КонтекстОбмена.Секрет, "Сохранённый секрет заказ-нарядов");
		Защита = ?(URI.Схема = "https", Новый ЗащищенноеСоединениеOpenSSL(, Новый СертификатыУдостоверяющихЦентровОС), Неопределено);
		КонтекстОбмена.Соединение = Новый HTTPСоединение(URI.Хост, URI.Порт, , , , 10, Защита);
	КонецЕсли;
	Запрос = Новый HTTPЗапрос(Путь);
	Запрос.Заголовки.Вставить("Authorization", "Bearer " + КонтекстОбмена.Секрет);
	Запрос.Заголовки.Вставить("Accept", "application/json");
	Если Тело <> Неопределено Тогда
		Диагностика.Сообщение = "Не удалось сформировать JSON запроса. Проверьте типы значений в данных заказ-наряда.";
		Запись = Новый ЗаписьJSON;
		Запись.УстановитьСтроку();
		ЗаписатьJSON(Запись, Тело);
		Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Запрос.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	КонецЕсли;
	Если НеПозднее <> Неопределено И ТекущаяУниверсальнаяДата() >= НеПозднее Тогда
		Диагностика.Сообщение = "Карточка ожидает следующего запуска очереди: истекло время текущего пакета.";
		ВызватьИсключение Диагностика.Сообщение;
	КонецЕсли;
	Попытка
		Ответ = КонтекстОбмена.Соединение.ВызватьHTTPМетод(Метод, Запрос);
	Исключение
		// Повтор после сетевого сбоя открывает новое соединение.
		КонтекстОбмена.Соединение = Неопределено;
		Диагностика.Сообщение = "Сбой соединения с сайтом: сеть, таймаут или TLS. HTTP-ответ не получен.";
		Диагностика.Повторить = Истина;
		ВызватьИсключение Диагностика.Сообщение;
	КонецПопытки;
	Если Ответ.КодСостояния <> 200 Тогда
		Диагностика.Сообщение = СообщениеHTTPОшибки(Ответ.КодСостояния, Ответ);
		Диагностика.Повторить = Ответ.КодСостояния = 500 Или Ответ.КодСостояния = 502
			Или Ответ.КодСостояния = 503 Или Ответ.КодСостояния = 504;
		ВызватьИсключение Диагностика.Сообщение;
	КонецЕсли;
	Диагностика.Сообщение = "HTTP 200, но получен некорректный JSON. Проверьте маршрут API на сервере сайта.";
	Попытка
		Текст = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		Если СтрДлина(Текст) > 16384 Тогда ВызватьИсключение Диагностика.Сообщение; КонецЕсли;
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Текст);
		Результат = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();
		Если ТипЗнч(Результат) <> Тип("Структура") Тогда ВызватьИсключение Диагностика.Сообщение; КонецЕсли;
	Исключение
		ВызватьИсключение Диагностика.Сообщение;
	КонецПопытки;
	Возврат Результат;
КонецФункции

Функция СообщениеHTTPОшибки(Код, Ответ)
	Если Код = 400 Тогда
		// Не выводим серверный текст. Разрешены только имена полей из нашего контракта.
		Попытка
			Текст = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
			Если СтрДлина(Текст) <= 16384 Тогда
				Чтение = Новый ЧтениеJSON;
				Чтение.УстановитьСтроку(Текст);
				Данные = ПрочитатьJSON(Чтение);
				Чтение.Закрыть();
				Сообщение = Неопределено;
				Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("message", Сообщение)
					И ТипЗнч(Сообщение) = Тип("Строка") Тогда
					Для Каждого Поле Из СтрРазделить("documentId,number,date,vehicleName,status,responsibleFio,counterpartyName,contactName,contactPhone,testPlatform,goodsReadiness,paymentStatus,amountDue,paymentOptions", ",") Цикл
						Если СтрНачинаетсяС(Сообщение, Поле + ":") Тогда
							Возврат "HTTP 400: агрегатор отклонил поле " + Поле + ". Проверьте его заполнение и длину.";
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
		Исключение
			// Ответ прокси или другой JSON не является доверенным сообщением пользователю.
			Возврат "HTTP 400: сервер отклонил формат карточки. Обновите агрегатор и проверьте данные 1С.";
		КонецПопытки;
		Возврат "HTTP 400: сервер отклонил формат карточки. Обновите агрегатор и проверьте данные 1С.";
	ИначеЕсли Код = 401 Тогда
		Возврат "HTTP 401: секрет не принят. Сохраните в 1С тот же секрет, что настроен у службы агрегатора.";
	ИначеЕсли Код = 403 Тогда
		Возврат "HTTP 403: доступ запрещен сервером сайта. Проверьте разрешения маршрутов интеграции.";
	ИначеЕсли Код = 404 Или Код = 405 Тогда
		Возврат "HTTP " + Формат(Код, "ЧГ=0") + ": маршрут API не найден или метод запрещен. Обновите агрегатор и проверьте прокси.";
	ИначеЕсли Код = 413 Тогда
		Возврат "HTTP 413: карточка превышает допустимый размер запроса.";
	ИначеЕсли Код = 415 Тогда
		Возврат "HTTP 415: сервер отклонил Content-Type. Проверьте версию API и настройки прокси.";
	ИначеЕсли Код = 503 Тогда
		Возврат "HTTP 503: интеграция не настроена или временно недоступна. Проверьте секрет в окружении службы сайта.";
	КонецЕсли;
	Возврат "HTTP " + Формат(Код, "ЧГ=0") + ": ошибка сервера сайта. Карточка сохранена для повторной отправки.";
КонецФункции

Функция ОшибкаДанныхКарточки(Карточка)
	Для Каждого Поле Из СтрРазделить("number,vehicleName,status,responsibleFio,counterpartyName,contactName,contactPhone", ",") Цикл
		Значение = Неопределено;
		Если Не Карточка.Свойство(Поле, Значение) Тогда Продолжить; КонецЕсли;
		МожноПустое = Поле = "vehicleName" И Карточка.Свойство("counterpartyName");
		Если Не МожноПустое И Не ЗначениеЗаполнено(Значение) Тогда
			Возврат "Данные 1С: не заполнено поле " + Поле + ". Исправьте документ и повторите отправку.";
		КонецЕсли;
		Предел = ?(Поле = "number", 64, ?(Поле = "status", 200, ?(Поле = "responsibleFio", 256, ?(Поле = "contactPhone", 200, 500))));
		Если СтрДлина(Значение) > Предел Тогда
			Возврат "Данные 1С: поле " + Поле + " длиннее допустимого. Исправьте наименование и повторите отправку.";
		КонецЕсли;
		Для Индекс = 1 По СтрДлина(Значение) Цикл
			Код = КодСимвола(Значение, Индекс);
			Если Код < 32 Или (Код >= 127 И Код <= 159) Тогда
				Возврат "Данные 1С: поле " + Поле + " содержит перенос строки или управляющий символ. Исправьте наименование.";
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция КарточкаДокумента(Документ, ТестоваяПлатформа, ДанныеПакета = Неопределено)
	Если Не ЗначениеЗаполнено(Документ) Тогда Возврат Неопределено; КонецЕсли;
	Реквизиты = Документ;
	Если ДанныеПакета <> Неопределено Тогда
		Реквизиты = ДанныеПакета.РеквизитыКарточек.Получить(Документ);
		Если Реквизиты = Неопределено Тогда ВызватьИсключение "Не получены реквизиты карточки в пакете."; КонецЕсли;
	КонецЕсли;
	// Единый отбор на стороне 1С до формирования и отправки карточки.
	Если ДанныеПакета = Неопределено Тогда
		Если Не Документ.Проведен Или Документ.ПометкаУдаления
			Или Документ.ВидОперации <> Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаряд
			Или Документ.СостояниеЗаказа.Наименование <> СостоянияЗаказов.СостояниеВРаботе() Тогда
			Возврат Неопределено;
		КонецЕсли;
		НаименованиеСостояния = Документ.СостояниеЗаказа.Наименование;
	Иначе
		НаименованиеСостояния = Реквизиты.НаименованиеСостояния;
		Если Не Реквизиты.Проведен Или Реквизиты.ПометкаУдаления
			Или Реквизиты.ВидОперации <> Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаряд
			Или НаименованиеСостояния <> СостоянияЗаказов.СостояниеВРаботе() Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	Если ДанныеПакета = Неопределено Тогда
		НаименованиеКонтрагента = Документ.Контрагент.Наименование;
		ЮридическоеФизическоеЛицо = Документ.Контрагент.ЮридическоеФизическоеЛицо;
		НаименованиеДоговора = Документ.Договор.Наименование;
		НаименованиеОтветственного = Документ.Ответственный.Наименование;
	Иначе
		НаименованиеКонтрагента = Реквизиты.НаименованиеКонтрагента;
		ЮридическоеФизическоеЛицо = Реквизиты.ЮридическоеФизическоеЛицо;
		НаименованиеДоговора = Реквизиты.НаименованиеДоговора;
		НаименованиеОтветственного = Реквизиты.НаименованиеОтветственного;
	КонецЕсли;
	НаименованиеКонтрагента = СокрЛП(НаименованиеКонтрагента);
	Автомобиль = НаименованиеКонтрагента;
	ЮридическоеЛицо = ЮридическоеФизическоеЛицо
		= Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо;
	Если ЮридическоеЛицо Тогда
		Автомобиль = "";
		Если ЗначениеЗаполнено(Реквизиты.Договор) Тогда
			Автомобиль = СокрЛП(НаименованиеДоговора);
		КонецЕсли;
	КонецЕсли;
	Карточка = Новый Структура("documentId,number,date,vehicleName,status,testPlatform",
		НРег(Строка(Документ.УникальныйИдентификатор())), СокрЛП(Реквизиты.Номер),
		Формат(Реквизиты.Дата, "ДФ=yyyy-MM-dd") + "T" + Формат(Реквизиты.Дата, "ДФ=HH:mm:ss"),
		Автомобиль, СокрЛП(НаименованиеСостояния), ТестоваяПлатформа);
	Если ЗначениеЗаполнено(Реквизиты.Ответственный) Тогда
		Карточка.Вставить("responsibleFio", СокрЛП(НаименованиеОтветственного));
	КонецЕсли;
	Если ЮридическоеЛицо Тогда Карточка.Вставить("counterpartyName", НаименованиеКонтрагента); КонецЕсли;
	Если ДанныеПакета = Неопределено Тогда
		Контакты = АС_КонтактыКонтрагентовСервер.ДанныеКонтрагента(Реквизиты.Контрагент);
	Иначе
		Контакты = ДанныеПакета.КонтактыКонтрагентов.Получить(Реквизиты.Контрагент);
		Если Контакты = Неопределено Тогда ВызватьИсключение "Не получены контакты контрагента в пакете."; КонецЕсли;
	КонецЕсли;
	Если Не ПустаяСтрока(Контакты.Имя) Тогда Карточка.Вставить("contactName", Контакты.Имя); КонецЕсли;
	Если Не ПустаяСтрока(Контакты.Телефон) Тогда Карточка.Вставить("contactPhone", Контакты.Телефон); КонецЕсли;
	Если Карточка.status = СостоянияЗаказов.СостояниеВРаботе() Тогда
		Если ДанныеПакета = Неопределено Тогда
			Готовность = АС_ГотовностьТоваровАгрегатора.Рассчитать(Документ);
		Иначе
			Готовность = ДанныеПакета.Готовность.Получить(Документ);
			Если Готовность = Неопределено Тогда ВызватьИсключение "Не получена готовность документа в пакете."; КонецЕсли;
		КонецЕсли;
		Карточка.Вставить("goodsReadiness", Готовность);
		Оплата = ОплатаДокумента(Документ, ДанныеПакета);
		Карточка.Вставить("paymentStatus", Оплата.paymentStatus);
		Карточка.Вставить("amountDue", Оплата.amountDue);
		Если Оплата.Свойство("paymentOptions") Тогда Карточка.Вставить("paymentOptions", Оплата.paymentOptions); КонецЕсли;
	КонецЕсли;
	Возврат Карточка;
КонецФункции

Функция ОплатаДокумента(Документ, ДанныеПакета = Неопределено)
	// Как поля «Оплачено» и «Должен» в форме: работы + запасы, оплата + аванс.
	// СуммаДокумента не используется: она дополнительно включает доставку.
	Если ДанныеПакета = Неопределено Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Документ", Документ);
		Запрос.Текст =
		"ВЫБРАТЬ ЕСТЬNULL(СУММА(Данные.СуммаКОплате), 0) КАК СуммаКОплате,
		|ЕСТЬNULL(СУММА(Данные.Оплачено), 0) КАК Оплачено
		|ИЗ (
		|ВЫБРАТЬ Запасы.Всего КАК СуммаКОплате, 0 КАК Оплачено
		|ИЗ Документ.ЗаказПокупателя.Запасы КАК Запасы
		|ГДЕ Запасы.Ссылка = &Документ
		|ОБЪЕДИНИТЬ ВСЕ
		|ВЫБРАТЬ Работы.Всего, 0
		|ИЗ Документ.ЗаказПокупателя.Работы КАК Работы
		|ГДЕ Работы.Ссылка = &Документ
		|ОБЪЕДИНИТЬ ВСЕ
		|ВЫБРАТЬ 0, ФактОплаты.СуммаОплаты + ФактОплаты.СуммаАванса
		|ИЗ РегистрСведений.ФактОплатыЗаказов КАК ФактОплаты
		|ГДЕ ФактОплаты.СчетНаОплату = &Документ) КАК Данные";
		Выборка = Запрос.Выполнить().Выбрать();
		Если Не Выборка.Следующий() Тогда
			ВызватьИсключение "Не удалось рассчитать статус оплаты заказ-наряда.";
		КонецЕсли;
	Иначе
		Выборка = ДанныеПакета.СуммыОплаты.Получить(Документ);
		Если Выборка = Неопределено Тогда ВызватьИсключение "Не получены суммы оплаты документа в пакете."; КонецЕсли;
	КонецЕсли;
	Должен = Макс(0, Окр(Выборка.СуммаКОплате - Выборка.Оплачено, 2));
	Если Должен = 0 Тогда
		Статус = "paid";
	ИначеЕсли Выборка.Оплачено > 0 Тогда
		Статус = "partially_paid";
	Иначе
		Статус = "payment_required";
	КонецЕсли;
	Результат = Новый Структура("paymentStatus,amountDue", Статус, Должен);
	// У оплаченного заказа интерфейс не показывает альтернативные варианты.
	Если Должен = 0 Тогда
		Если ДанныеПакета <> Неопределено Тогда
			ДанныеПакета.КонтекстЦен.ПропущеноОплаченных = ДанныеПакета.КонтекстЦен.ПропущеноОплаченных + 1;
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;
	Попытка
		Результат.Вставить("paymentOptions", ВариантыОплатыДокумента(Документ, Выборка.СуммаКОплате, Выборка.Оплачено, ДанныеПакета));
	Исключение
		// Отсутствующий расчёт очищает предыдущие варианты в полной карточке агрегатора.
		ЗаписьЖурналаРегистрации("АС_Агрегатор.РасчетОплаты", УровеньЖурналаРегистрации.Предупреждение,
			Метаданные.Документы.ЗаказПокупателя, Документ, "Расчёт способов оплаты недоступен: " + ОписаниеОшибки());
	КонецПопытки;
	Возврат Результат;
КонецФункции

Процедура ПодтвердитьПриемКарточки(Ответ, Карточка, Диагностика)
	Диагностика.Сообщение = "Сервер не подтвердил карточку. Проверьте версию агрегатора и расширения.";
	Принято = Неопределено;
	Если Не Ответ.Свойство("repair", Принято) Или ТипЗнч(Принято) <> Тип("Структура") Тогда
		ВызватьИсключение "Сервер не подтвердил прием карточки.";
	КонецЕсли;
	Для Каждого Поле Из Карточка Цикл
		ЗначениеОтвета = Неопределено;
		Если Не Принято.Свойство(Поле.Ключ, ЗначениеОтвета) Тогда
			Если Поле.Ключ = "testPlatform" И Поле.Значение = Ложь Тогда
				// API не включает testPlatform в рабочую карточку: отсутствие означает Ложь.
				ЗначениеОтвета = Ложь;
			Иначе
				ВызватьИсключение "Сервер не подтвердил поле карточки. Обновите агрегатор.";
			КонецЕсли;
		КонецЕсли;
		Если Поле.Ключ = "goodsReadiness" Тогда
			Совпадает = Ложь;
			Если ТипЗнч(ЗначениеОтвета) = Тип("Структура") Тогда
				Всего = Неопределено;
				Готово = Неопределено;
				Если ЗначениеОтвета.Свойство("totalPositions", Всего)
					И ЗначениеОтвета.Свойство("availablePositions", Готово) Тогда
					Совпадает = Всего = Поле.Значение.totalPositions И Готово = Поле.Значение.availablePositions;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли Поле.Ключ = "paymentOptions" Тогда
			Совпадает = ПодтвержденыВариантыОплаты(Поле.Значение, ЗначениеОтвета);
		Иначе
			Совпадает = ЗначениеОтвета = Поле.Значение;
		КонецЕсли;
		Если Не Совпадает Тогда
			Диагностика.Сообщение = "Сервер подтвердил другие данные поля " + Поле.Ключ + ". Карточка сохранена в очереди; проверьте версию API.";
			ВызватьИсключение Диагностика.Сообщение;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// JSON создаёт новую структуру: сравниваем значения полей, а не ссылки на объекты.
// JSON null читается как Неопределено; SQL Null в структуру для JSON не включаем.
Функция ПодтвержденыВариантыОплаты(Ожидалось, Принято)

	Если ТипЗнч(Принято) <> Тип("Структура") Тогда Возврат Ложь; КонецЕсли;
	Если Принято.Количество() <> 3 Тогда Возврат Ложь; КонецЕсли;
	Для Каждого ИмяПоля Из СтрРазделить("cardAmountDue,cashAmountDue,cashDiscountPercent", ",") Цикл
		ЗначениеОтвета = Неопределено;
		Если Не Принято.Свойство(ИмяПоля, ЗначениеОтвета) Тогда Возврат Ложь; КонецЕсли;
		ОжидаемоеЗначение = Ожидалось[ИмяПоля];
		Если ТипЗнч(ЗначениеОтвета) <> ТипЗнч(ОжидаемоеЗначение) Тогда Возврат Ложь; КонецЕсли;
		Если ТипЗнч(ОжидаемоеЗначение) <> Тип("Неопределено") Тогда
			Если ЗначениеОтвета <> ОжидаемоеЗначение Тогда Возврат Ложь; КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Процедура ЗаблокироватьОчередь(Документ, ТестоваяПлатформа)
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрСведений.АС_ОчередьРемонтовАгрегатора");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Элемент.УстановитьЗначение("Документ", Документ);
	Элемент.УстановитьЗначение("ТестоваяПлатформа", ТестоваяПлатформа);
	Блокировка.Заблокировать();
КонецПроцедуры

Процедура ПоставитьВОчередь(Документ, ТестоваяПлатформа)
	ЗаблокироватьОчередь(Документ, ТестоваяПлатформа);
	Запись = РегистрыСведений.АС_ОчередьРемонтовАгрегатора.СоздатьМенеджерЗаписи();
	Запись.Документ = Документ;
	Запись.ТестоваяПлатформа = ТестоваяПлатформа;
	Запись.Версия = Строка(Новый УникальныйИдентификатор);
	Запись.ДатаИзменения = ТекущаяУниверсальнаяДата();
	Запись.Записать();
КонецПроцедуры

Процедура ЗавершитьЭлементОчереди(Документ, ТестоваяПлатформа, Версия, Ошибка)
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьОчередь(Документ, ТестоваяПлатформа);
		Запись = РегистрыСведений.АС_ОчередьРемонтовАгрегатора.СоздатьМенеджерЗаписи();
		Запись.Документ = Документ;
		Запись.ТестоваяПлатформа = ТестоваяПлатформа;
		Запись.Прочитать();
		Если Запись.Выбран() И Запись.Версия = Версия Тогда
			Если ЗначениеЗаполнено(Ошибка) Тогда
				Запись.Ошибка = Ошибка;
				Запись.СледующаяПопытка = ТекущаяУниверсальнаяДата() + 60;
				Запись.ДатаИзменения = ТекущаяУниверсальнаяДата();
				Запись.Записать();
			Иначе Запись.Удалить(); КонецЕсли;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

Функция ЗахватитьОбработчик()
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьОчередь(Документы.ЗаказПокупателя.ПустаяСсылка(), Ложь);
		Запись = РегистрыСведений.АС_ОчередьРемонтовАгрегатора.СоздатьМенеджерЗаписи();
		Запись.Документ = Документы.ЗаказПокупателя.ПустаяСсылка();
		Запись.ТестоваяПлатформа = Ложь;
		Запись.Прочитать();
		Если Запись.Выбран() И Запись.ЗанятоДо > ТекущаяУниверсальнаяДата() Тогда
			ЗафиксироватьТранзакцию();
			Возврат "";
		КонецЕсли;
		Токен = Строка(Новый УникальныйИдентификатор);
		Запись.Версия = Токен;
		Запись.ЗанятоДо = ТекущаяУниверсальнаяДата() + 120;
		Запись.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	Возврат Токен;
КонецФункции

Процедура ОсвободитьОбработчик(Токен)
	ЗавершитьЭлементОчереди(Документы.ЗаказПокупателя.ПустаяСсылка(), Ложь, Токен, "");
КонецПроцедуры

// Сбой освобождения не должен подменять результат HTTP и удалять очередь.
// Аренда блокировки истечет автоматически через 120 секунд.
Процедура ОсвободитьОбработчикБезОшибки(Токен)
	Попытка
		ОсвободитьОбработчик(Токен);
	Исключение
		ЗаписьЖурналаРегистрации("АС_Агрегатор.Блокировка", УровеньЖурналаРегистрации.Ошибка, , ,
			"Не удалось освободить блокировку отправителя; она будет снята по сроку аренды.");
	КонецПопытки;
КонецПроцедуры

// Сверка выполняется единственным фоновым отправителем вне транзакций документов.
// Ротация по дате проверки не оставляет большие списки постоянно за первым пакетом.
Процедура СверитьАктивныеКарточки(Настройки, НеПозднее)
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 100 Заказы.Ссылка КАК Документ
		|ИЗ Документ.ЗаказПокупателя КАК Заказы
		|ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АС_СверкаКарточекАгрегатора КАК Сверка
		|ПО Сверка.Документ = Заказы.Ссылка И Сверка.ТестоваяПлатформа = &ТестоваяПлатформа
		|ГДЕ ((Заказы.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаряд)
		|И Заказы.Проведен И НЕ Заказы.ПометкаУдаления
		|И Заказы.СостояниеЗаказа.Наименование = &СостояниеВРаботе)
		|ИЛИ Сверка.ОтпечатокПодтверждения <> """")
		|УПОРЯДОЧИТЬ ПО ЕСТЬNULL(Сверка.ДатаПроверки, ДАТАВРЕМЯ(1, 1, 1)), Заказы.Ссылка");
	Запрос.УстановитьПараметр("ТестоваяПлатформа", Настройки.ТестоваяПлатформа);
	Запрос.УстановитьПараметр("СостояниеВРаботе", СостоянияЗаказов.СостояниеВРаботе());
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() И ТекущаяУниверсальнаяДата() < НеПозднее Цикл
		Сверка = РегистрыСведений.АС_СверкаКарточекАгрегатора.СоздатьМенеджерЗаписи();
		Сверка.Документ = Выборка.Документ;
		Сверка.ТестоваяПлатформа = Настройки.ТестоваяПлатформа;
		Сверка.Прочитать();
		// При ошибке чтения отправитель сохранит диагностику в постоянной очереди.
		Изменена = Истина;
		Попытка
			Карточка = КарточкаДокумента(Выборка.Документ, Настройки.ТестоваяПлатформа);
			Если Карточка <> Неопределено Тогда
				Изменена = ОтпечатокКарточки(Карточка) <> Сверка.ОтпечатокПодтверждения;
			КонецЕсли;
		Исключение
			Изменена = Истина;
		КонецПопытки;
		Если Изменена Тогда
			НачатьТранзакцию();
			Попытка
				ЗаблокироватьОчередь(Выборка.Документ, Настройки.ТестоваяПлатформа);
				Очередь = РегистрыСведений.АС_ОчередьРемонтовАгрегатора.СоздатьМенеджерЗаписи();
				Очередь.Документ = Выборка.Документ;
				Очередь.ТестоваяПлатформа = Настройки.ТестоваяПлатформа;
				Очередь.Прочитать();
				// Существующую версию, ошибку и отсрочку не сбрасываем при сверке.
				Если Не Очередь.Выбран() Тогда ПоставитьВОчередь(Выборка.Документ, Настройки.ТестоваяПлатформа); КонецЕсли;
				ЗафиксироватьТранзакцию();
			Исключение
				Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
				ВызватьИсключение;
			КонецПопытки;
		КонецЕсли;
		Сверка.ДатаПроверки = ТекущаяУниверсальнаяДата();
		Сверка.Записать();
	КонецЦикла;
КонецПроцедуры

Функция ОтпечатокКарточки(Карточка)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Карточка);
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Запись.Закрыть());
	Возврат Base64Строка(Хеширование.ХешСумма);
КонецФункции

Процедура СохранитьПодтверждениеКарточки(Документ, ТестоваяПлатформа, Карточка)
	Сверка = РегистрыСведений.АС_СверкаКарточекАгрегатора.СоздатьМенеджерЗаписи();
	Сверка.Документ = Документ;
	Сверка.ТестоваяПлатформа = ТестоваяПлатформа;
	Сверка.Прочитать();
	Сверка.ДатаПроверки = ТекущаяУниверсальнаяДата();
	Сверка.ОтпечатокПодтверждения = ОтпечатокКарточки(Карточка);
	Сверка.Записать();
КонецПроцедуры

Функция КоличествоКарточекНаСайте(Настройки)
	Ответ = ВыполнитьЗапрос(Настройки, "GET", "/api/integration/1c/repairs/status");
	Готов = Ложь;
	Карточки = Неопределено;
	Если Не Ответ.Свойство("ready", Готов) Или Готов <> Истина
		Или Не Ответ.Свойство("cards", Карточки) Или ТипЗнч(Карточки) <> Тип("Структура") Тогда
		ВызватьИсключение "Обновите агрегатор: сервер не подтвердил готовность и количество карточек.";
	КонецЕсли;
	Всего = 0;
	Для Каждого Имя Из СтрРазделить("production,test", ",") Цикл
		Количество = Неопределено;
		Если Не Карточки.Свойство(Имя, Количество) Или ТипЗнч(Количество) <> Тип("Число") Тогда
			ВызватьИсключение "Сервер вернул некорректное количество карточек.";
		КонецЕсли;
		Если Количество < 0 Или Количество <> Цел(Количество) Тогда
			ВызватьИсключение "Сервер вернул некорректное количество карточек.";
		КонецЕсли;
		Если Имя = ?(Настройки.ТестоваяПлатформа, "test", "production") Тогда Всего = Количество; КонецЕсли;
	КонецЦикла;
	Возврат Всего;
КонецФункции

Процедура ПроверитьОжидаемыйРежимЗаказНарядов(Настройки, ОжидаемыйРежим)
	Если ОжидаемыйРежим = Неопределено Тогда Возврат; КонецЕсли;
	Если ТипЗнч(ОжидаемыйРежим) <> Тип("Булево") Или Настройки.ТестоваяПлатформа <> ОжидаемыйРежим Тогда
		ВызватьИсключение "Режим заказ-нарядов изменился. Выгрузка не запущена. Закройте форму и проверьте сохранённый режим перед повторной попыткой.";
	КонецЕсли;
КонецПроцедуры

Функция ПроверитьНачалоОбмена(ОжидаемыйРежим = Неопределено) Экспорт
	ПроверитьАдминистратора();
	Настройки = НастройкиДляОбмена();
	ПроверитьОжидаемыйРежимЗаказНарядов(Настройки, ОжидаемыйРежим);
	Всего = КоличествоКарточекНаСайте(Настройки);
	Первичная = СостояниеПервичнойВыгрузки();
	НужнаВыгрузка = Всего = 0 И (Не Первичная.ЕстьВыгрузка Или Первичная.Завершена);
	Если Не НужнаВыгрузка Тогда
		Настройки.ПроверкаЗавершена = Истина;
		СохранитьСлужебныеНастройки(Настройки);
		ЗапуститьОтправку();
	КонецЕсли;
	Возврат Новый Структура("НужнаВыгрузка,ЕстьВыгрузка,Завершена", НужнаВыгрузка,
		Первичная.ЕстьВыгрузка, Первичная.Завершена);
КонецФункции

Функция НачатьПервичнуюВыгрузку(Принудительно = Ложь, ОжидаемыйРежим = Неопределено) Экспорт
	ПроверитьАдминистратора();
	Настройки = НастройкиДляОбмена();
	ПроверитьОжидаемыйРежимЗаказНарядов(Настройки, ОжидаемыйРежим);
	Состояние = СостояниеПервичнойВыгрузки();
	Если Не Принудительно И Состояние.ЕстьВыгрузка И Не Состояние.Завершена Тогда
		Настройки.ПроверкаЗавершена = Истина;
		СохранитьСлужебныеНастройки(Настройки);
		ЗапуститьОтправку();
		Возврат Истина;
	КонецЕсли;
	БылПривилегированныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Токен = "";
	Попытка
		Токен = ЗахватитьОбработчик();
		Если Не ЗначениеЗаполнено(Токен) Тогда
			УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
			Возврат Ложь;
		КонецЕсли;
		Если Не Принудительно И КоличествоКарточекНаСайте(Настройки) > 0 Тогда
			// Пока был открыт вопрос, другой сеанс мог заполнить выбранную платформу.
			Настройки.ПроверкаЗавершена = Истина;
			СохранитьСлужебныеНастройки(Настройки);
			ОсвободитьОбработчикБезОшибки(Токен);
			УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
			Возврат Истина;
		КонецЕсли;
		Идентификатор = Строка(Новый УникальныйИдентификатор);
		Запрос = Новый Запрос(
			"ВЫБРАТЬ Заказы.Ссылка КАК Документ
			|ИЗ Документ.ЗаказПокупателя КАК Заказы
			|ГДЕ Заказы.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаряд)
			|И Заказы.Проведен И НЕ Заказы.ПометкаУдаления
			|И Заказы.СостояниеЗаказа.Наименование = &СостояниеВРаботе");
		Запрос.УстановитьПараметр("СостояниеВРаботе", СостоянияЗаказов.СостояниеВРаботе());
		Выборка = Запрос.Выполнить().Выбрать();
		НачатьТранзакцию();
		Набор = РегистрыСведений.АС_ПервичнаяВыгрузкаАгрегатора.СоздатьНаборЗаписей();
		Набор.Отбор.ТестоваяПлатформа.Установить(Настройки.ТестоваяПлатформа);
		Пока Выборка.Следующий() Цикл
			СтрокаВыгрузки = Набор.Добавить();
			СтрокаВыгрузки.Документ = Выборка.Документ;
			СтрокаВыгрузки.ТестоваяПлатформа = Настройки.ТестоваяПлатформа;
			СтрокаВыгрузки.ИдентификаторВыгрузки = Идентификатор;
			ПоставитьВОчередь(Выборка.Документ, Настройки.ТестоваяПлатформа);
		КонецЦикла;
		Набор.Записать();
		Настройки.ПервичнаяВыгрузка = Идентификатор;
		Настройки.ПроверкаЗавершена = Истина;
		СохранитьСлужебныеНастройки(Настройки);
		ЗафиксироватьТранзакцию();
	Исключение
		Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
		Если ЗначениеЗаполнено(Токен) Тогда ОсвободитьОбработчикБезОшибки(Токен); КонецЕсли;
		УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
		ВызватьИсключение "Не удалось подготовить первичную выгрузку. Настройки сохранены; повторите сохранение.";
	КонецПопытки;
	ОсвободитьОбработчикБезОшибки(Токен);
	УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
	РезультатЗапуска = "";
	ЗапуститьОтправку(РезультатЗапуска, Истина);
	Возврат Истина;
КонецФункции

Функция СостояниеПервичнойВыгрузки() Экспорт
	ПроверитьАдминистратора();
	Настройки = ПрочитатьНастройки();
	Результат = Новый Структура("ЕстьВыгрузка,Всего,Загружено,Завершена", Ложь, 0, 0, Ложь);
	Если Не ЗначениеЗаполнено(Настройки.ПервичнаяВыгрузка) Тогда Возврат Результат; КонецЕсли;
	БылПривилегированныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Запрос = Новый Запрос(
			"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего,
			|ЕСТЬNULL(СУММА(ВЫБОР КОГДА ДатаПодтверждения > ДАТАВРЕМЯ(1, 1, 1) ТОГДА 1 ИНАЧЕ 0 КОНЕЦ), 0) КАК Загружено
			|ИЗ РегистрСведений.АС_ПервичнаяВыгрузкаАгрегатора
			|ГДЕ ТестоваяПлатформа = &ТестоваяПлатформа И ИдентификаторВыгрузки = &Идентификатор");
		Запрос.УстановитьПараметр("ТестоваяПлатформа", Настройки.ТестоваяПлатформа);
		Запрос.УстановитьПараметр("Идентификатор", Настройки.ПервичнаяВыгрузка);
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		Результат.ЕстьВыгрузка = Истина;
		Результат.Всего = Выборка.Всего;
		Результат.Загружено = Выборка.Загружено;
		Результат.Завершена = Результат.Загружено = Результат.Всего;
	Исключение
		УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
		ВызватьИсключение "Не удалось получить состояние первичной выгрузки.";
	КонецПопытки;
	УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
	Возврат Результат;
КонецФункции

Процедура ПодтвердитьПервичнуюКарточку(Документ, ТестоваяПлатформа, Идентификатор)
	Если Не ЗначениеЗаполнено(Идентификатор) Тогда Возврат; КонецЕсли;
	Запись = РегистрыСведений.АС_ПервичнаяВыгрузкаАгрегатора.СоздатьМенеджерЗаписи();
	Запись.Документ = Документ;
	Запись.ТестоваяПлатформа = ТестоваяПлатформа;
	Запись.Прочитать();
	Если Запись.Выбран() И Запись.ИдентификаторВыгрузки = Идентификатор
		И Запись.ДатаПодтверждения = Дата(1, 1, 1) Тогда
		Запись.ДатаПодтверждения = ТекущаяУниверсальнаяДата();
		Запись.Записать();
	КонецЕсли;
КонецПроцедуры

Процедура СохранитьСлужебныеНастройки(Настройки)
	БылПривилегированныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		НачатьТранзакцию();
		Блокировка = Новый БлокировкаДанных;
		Блокировка.Добавить("Константа.АС_НастройкиАгрегатора");
		Блокировка.Заблокировать();
		Актуальные = ПрочитатьНастройки();
		Если Не Актуальные.Включен Или Актуальные.Адрес <> Настройки.Адрес
			Или Актуальные.ТестоваяПлатформа <> Настройки.ТестоваяПлатформа
			Или Актуальные.ОтпечатокБазы <> Настройки.ОтпечатокБазы Тогда
			ВызватьИсключение "Настройки изменены другим сеансом. Сохраните форму заново.";
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(Актуальные, Настройки, "ПроверкаЗавершена,ПервичнаяВыгрузка");
		Константы.АС_НастройкиАгрегатора.Установить(Новый ХранилищеЗначения(Актуальные));
		ЗафиксироватьТранзакцию();
	Исключение
		Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
		УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
		ВызватьИсключение "Не удалось завершить настройку обмена. Сохраните настройки ещё раз.";
	КонецПопытки;
	УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
КонецПроцедуры

Функция КарточкаМоглаБытьПередана(Документ, ТестоваяПлатформа)
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1 Очередь.Документ
		|ИЗ РегистрСведений.АС_ОчередьРемонтовАгрегатора КАК Очередь
		|ГДЕ Очередь.Документ = &Документ И Очередь.ТестоваяПлатформа = &ТестоваяПлатформа
		|ОБЪЕДИНИТЬ ВСЕ
		|ВЫБРАТЬ Сверка.Документ
		|ИЗ РегистрСведений.АС_СверкаКарточекАгрегатора КАК Сверка
		|ГДЕ Сверка.Документ = &Документ И Сверка.ТестоваяПлатформа = &ТестоваяПлатформа");
	Запрос.УстановитьПараметр("Документ", Документ);
	Запрос.УстановитьПараметр("ТестоваяПлатформа", ТестоваяПлатформа);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат Выборка.Следующий();
КонецФункции

Процедура УдалитьКарточкуСайта(Документ, Настройки, НеПозднее, Диагностика)
	Идентификатор = НРег(Строка(Документ.УникальныйИдентификатор()));
	Ответ = ВыполнитьЗапрос(Настройки, "DELETE", "/api/integration/1c/repairs",
		Новый Структура("documentId,testPlatform", Идентификатор, Настройки.ТестоваяПлатформа), НеПозднее, Диагностика);
	Диагностика.Сообщение = "Сервер не подтвердил удаление карточки. Обновите агрегатор; команда будет повторена автоматически.";
	Удалено = Неопределено;
	ПринятыйИдентификатор = Неопределено;
	Платформа = Неопределено;
	Если Не Ответ.Свойство("documentId", ПринятыйИдентификатор)
		Или Не Ответ.Свойство("testPlatform", Платформа) Или Не Ответ.Свойство("deleted", Удалено) Тогда
		ВызватьИсключение Диагностика.Сообщение;
	КонецЕсли;
	Если ПринятыйИдентификатор <> Идентификатор Или Платформа <> Настройки.ТестоваяПлатформа
		Или ТипЗнч(Удалено) <> Тип("Число") Тогда ВызватьИсключение Диагностика.Сообщение; КонецЕсли;
	Если Удалено <> 0 И Удалено <> 1 Тогда ВызватьИсключение Диагностика.Сообщение; КонецЕсли;
	// Повторное удаление отсутствующей карточки также является подтверждённым успехом.
	Сверка = РегистрыСведений.АС_СверкаКарточекАгрегатора.СоздатьМенеджерЗаписи();
	Сверка.Документ = Документ;
	Сверка.ТестоваяПлатформа = Настройки.ТестоваяПлатформа;
	Сверка.Прочитать();
	Если Сверка.Выбран() Тогда Сверка.Удалить(); КонецЕсли;
	Первичная = РегистрыСведений.АС_ПервичнаяВыгрузкаАгрегатора.СоздатьМенеджерЗаписи();
	Первичная.Документ = Документ;
	Первичная.ТестоваяПлатформа = Настройки.ТестоваяПлатформа;
	Первичная.Прочитать();
	Если Первичная.Выбран() И Первичная.ИдентификаторВыгрузки = Настройки.ПервичнаяВыгрузка Тогда
		// Документ больше не входит в первичный отбор и не считается загруженным.
		Первичная.Удалить();
	КонецЕсли;
КонецПроцедуры


// Поиск не зависит от включения обмена заказ-нарядами.
Процедура НастроитьРегламентныйПоискНоменклатуры(ЕстьКлюч)
	НастроитьЗаданиеАгрегатора("АС_ПоискНоменклатурыАгрегатора", "АС_НоменклатураАгрегатора", ЕстьКлюч);
КонецПроцедуры

Процедура НастроитьЗаданиеАгрегатора(ИмяЗадания, Ключ, Включено, ПериодСекунд = 2)
	Задания = РегламентныеЗадания.ПолучитьРегламентныеЗадания(
		Новый Структура("Метаданные", Метаданные.РегламентныеЗадания[ИмяЗадания]));
	Если Задания.Количество() <> 1 Тогда
		ВызватьИсключение "Не найдено единственное предопределённое задание интеграции. Обновите конфигурацию базы данных расширения.";
	КонецЕсли;
	Задание = Задания[0];
	Если Не ЗначениеЗаполнено(Задание.ИмяПользователя) Тогда
		Задание.ИмяПользователя = ПользователиИнформационнойБазы.ТекущийПользователь().Имя;
	КонецЕсли;
	Расписание = Новый РасписаниеРегламентногоЗадания;
	Расписание.ПериодПовтораДней = 1;
	Расписание.ПериодПовтораВТечениеДня = ПериодСекунд;
	Расписание.ПаузаПовтора = ПериодСекунд;
	Задание.Расписание = Расписание;
	Задание.Ключ = Ключ;
	Задание.Использование = Включено;
	Задание.Записать();
КонецПроцедуры

Функция ПроверитьПодключениеНоменклатуры() Экспорт
	ПроверитьАдминистратора();
	Настройки = НастройкиДляНоменклатуры();
	ПроверитьНастройкиНоменклатуры(Настройки, "");
	Ответ = ЗапросНоменклатуры(Настройки, "GET", "status", Неопределено, ТекущаяУниверсальнаяДата() + 10);
	Готов = Ложь;
	Если Не Ответ.Свойство("ready", Готов) Или Готов <> Истина Тогда
		ВызватьИсключение "Ответ не подтверждает подключение номенклатуры.";
	КонецЕсли;
	// /status проверяет ключ и HTTPS; обработчик очереди этим запросом не запускается.
	Возврат Ответ;
КонецФункции

Процедура ОбработатьЗапросыНоменклатуры() Экспорт
	Если ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание() = Неопределено Тогда
		ВызватьИсключение "Обработчик поиска запускается только фоновым заданием сервера.";
	КонецЕсли;
	БылПривилегированныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		// Одно регламентное задание не выполняется параллельно самому себе.
		// После сетевой ошибки не создаём поток повторных запросов каждые две секунды.
		Отбор = Новый Структура("ИмяМетода", "АС_АгрегаторСервер.ОбработатьЗапросыНоменклатуры");
		Для Каждого Задание Из ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор) Цикл
			Если Задание.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно
				И Задание.Конец + 30 > ТекущаяДатаСеанса() Тогда
				УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
				Возврат;
			КонецЕсли;
		КонецЦикла;
		Настройки = ПрочитатьНастройки();
		Если Настройки.ПоискНоменклатурыВключен И Настройки.ОтпечатокБазы = ОтпечатокБазы() Тогда
			ПроверитьНастройкиНоменклатуры(Настройки, "");
			ЗавершитьДо = ТекущаяУниверсальнаяДата() + 45;
			Для Номер = 1 По 20 Цикл
				Если ТекущаяУниверсальнаяДата() >= ЗавершитьДо - 3 Или Не АктуальныНастройкиНоменклатуры(Настройки) Тогда Прервать; КонецЕсли;
				Ответ = ЗапросНоменклатуры(Настройки, "GET", "requests?waitSeconds=20", Неопределено, ЗавершитьДо);
				Задание = Неопределено;
				Если Не Ответ.Свойство("request", Задание) Тогда ВызватьИсключение "Некорректный ответ очереди номенклатуры."; КонецЕсли;
				Если Задание = Неопределено Или ТипЗнч(Задание) = Тип("Null") Тогда Продолжить; КонецЕсли;
				ПроверитьЗаданиеНоменклатуры(Задание);
				Если Не АктуальныНастройкиНоменклатуры(Настройки) Тогда Прервать; КонецЕсли;
				Результат = Новый Структура("requestId,leaseId,status,products", Задание.id, Задание.leaseId, "error", Новый Массив);
				Попытка
					Диагностика = Новый Структура("Этап", "Чтение карточки");
					Результат.products = АС_НоменклатураАгрегатора.НайтиТовары(Задание.barcode, Настройки, Диагностика);
					Результат.status = ?(Результат.products.Количество() = 0, "not_found", "found");
				Исключение
					ЗаписьЖурналаРегистрации("АС_Агрегатор.НоменклатураКарточка", УровеньЖурналаРегистрации.Ошибка, , ,
						Диагностика.Этап + ": " + Лев(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), 3000));
					// Ошибки чтения не становятся успешным «не найдено» и не раскрывают данные базы.
					Результат.products = Новый Массив;
				КонецПопытки;
				Если Не АктуальныНастройкиНоменклатуры(Настройки) Или ТекущаяУниверсальнаяДата() >= ЗавершитьДо Тогда Прервать; КонецЕсли;
				Подтверждение = ЗапросНоменклатуры(Настройки, "POST", "results", Результат, ЗавершитьДо);
				Если Подтверждение <> Неопределено Тогда
					Принято = Ложь;
					Идентификатор = "";
					Если Не Подтверждение.Свойство("accepted", Принято) Или Принято <> Истина
						Или Не Подтверждение.Свойство("requestId", Идентификатор) Или Идентификатор <> Задание.id Тогда
						ВызватьИсключение "Сервер не подтвердил результат поиска номенклатуры.";
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	Исключение
		УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
		ВызватьИсключение "Поиск номенклатуры приостановлен на 30 секунд. "
			+ Лев(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), 3000);
	КонецПопытки;
	УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
КонецПроцедуры

Функция АктуальныНастройкиНоменклатуры(Настройки)
	Актуальные = ПрочитатьНастройки();
	Возврат Актуальные.ПоискНоменклатурыВключен И Актуальные.ОтпечатокБазы = ОтпечатокБазы()
		И Актуальные.ВерсияНоменклатуры = Настройки.ВерсияНоменклатуры;
КонецФункции

Процедура ПроверитьНастройкиНоменклатуры(Настройки, НовыйКлюч)
	Если Не Настройки.ПоискНоменклатурыВключен Тогда Возврат; КонецЕсли;
	Для Каждого Имя Из СтрРазделить("ЗакупочныйВидЦен,РозничныйВидЦен,БезналичныйВидЦен", ",") Цикл
		АС_НоменклатураАгрегатора.ПроверитьВидЦен(Настройки[Имя]);
	КонецЦикла;
	ПроверитьСекрет(?(ЗначениеЗаполнено(НовыйКлюч), НовыйКлюч, ПрочитатьКлючНоменклатуры()), "Ключ номенклатуры");
КонецПроцедуры

Функция ПрочитатьКлючНоменклатуры()
	БылПривилегированныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Ключ = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища("АС_АгрегаторНоменклатура", "КлючИсточника");
	Исключение
		УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
		ВызватьИсключение "Не удалось прочитать ключ номенклатуры из безопасного хранилища.";
	КонецПопытки;
	УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
	Возврат ?(ТипЗнч(Ключ) = Тип("Строка"), Ключ, "");
КонецФункции

// Подключение номенклатуры не зависит от режима обмена заказ-нарядами.
Функция НастройкиДляНоменклатуры()
	Настройки = ПрочитатьНастройки();
	Если Настройки.ОтпечатокБазы <> ОтпечатокБазы() Тогда
		ВызватьИсключение "После копирования базы сохраните настройки номенклатуры.";
	КонецЕсли;
	Если Не Настройки.ПоискНоменклатурыВключен Тогда ВызватьИсключение "Сохраните ключ номенклатуры в настройках интеграции."; КонецЕсли;
	ПроверитьАдрес(Настройки.Адрес, Ложь);
	Возврат Настройки;
КонецФункции

Процедура ПроверитьЗаданиеНоменклатуры(Задание)
	Если ТипЗнч(Задание) <> Тип("Структура") Тогда ВызватьИсключение "Некорректное задание номенклатуры."; КонецЕсли;
	Для Каждого Имя Из СтрРазделить("id,leaseId,barcode,expiresAt", ",") Цикл
		Значение = Неопределено;
		Если Не Задание.Свойство(Имя, Значение) Или ТипЗнч(Значение) <> Тип("Строка") Тогда
			ВызватьИсключение "В задании номенклатуры отсутствует обязательное поле.";
		КонецЕсли;
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("id,leaseId", ",") Цикл
		Попытка
			Идентификатор = Новый УникальныйИдентификатор(Задание[Имя]);
			Если СтрДлина(Задание[Имя]) <> 36 Или Строка(Идентификатор) = "00000000-0000-0000-0000-000000000000" Тогда ВызватьИсключение "Пустой UUID."; КонецЕсли;
		Исключение
			ВызватьИсключение "Некорректный идентификатор задания номенклатуры.";
		КонецПопытки;
	КонецЦикла;
	ПроверитьШтрихкодНоменклатуры(Задание.barcode);
КонецПроцедуры

Процедура ПроверитьШтрихкодНоменклатуры(Штрихкод)
	Если ТипЗнч(Штрихкод) <> Тип("Строка") Тогда ВызватьИсключение "Введите штрихкод строкой."; КонецЕсли;
	Если Не ЗначениеЗаполнено(СокрЛП(Штрихкод)) Или СтрДлина(Штрихкод) > 200 Тогда
		ВызватьИсключение "Некорректный штрихкод в задании номенклатуры.";
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(Штрихкод) Цикл
		Код = КодСимвола(Штрихкод, Индекс);
		Если Код < 32 Или (Код >= 127 И Код <= 159) Тогда ВызватьИсключение "Штрихкод содержит управляющие символы."; КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ЗапросНоменклатуры(Настройки, Метод, Ресурс, Тело, НеПозднее)
	Если ТранзакцияАктивна() Тогда ВызватьИсключение "Поиск номенклатуры не выполняется внутри транзакции."; КонецЕсли;
	URI = ПроверитьАдрес(Настройки.Адрес, Ложь);
	Ключ = ПрочитатьКлючНоменклатуры();
	ПроверитьСекрет(Ключ, "Сохранённый ключ номенклатуры");
	Осталось = Цел(НеПозднее - ТекущаяУниверсальнаяДата());
	Если Осталось < 1 Тогда ВызватьИсключение "Истек срок обработки номенклатуры."; КонецЕсли;
	Таймаут = Мин(25, Осталось);
	Если Ресурс = "requests?waitSeconds=20" Тогда
		Ресурс = "requests?waitSeconds=" + Формат(Макс(0, Мин(20, Таймаут - 2)), "ЧГ=0");
	КонецЕсли;
	Защита = ?(URI.Схема = "https", Новый ЗащищенноеСоединениеOpenSSL(, Новый СертификатыУдостоверяющихЦентровОС), Неопределено);
	Соединение = Новый HTTPСоединение(URI.Хост, URI.Порт, , , , Таймаут, Защита);
	Запрос = Новый HTTPЗапрос("/api/integration/1c/nomenclature/" + Ресурс);
	Запрос.Заголовки.Вставить("Authorization", "Bearer " + Ключ);
	Запрос.Заголовки.Вставить("Accept", "application/json");
	Если Тело <> Неопределено Тогда
		Запись = Новый ЗаписьJSON;
		Запись.УстановитьСтроку();
		ЗаписатьJSON(Запись, Тело);
		ТекстJSON = Запись.Закрыть();
		Если ПолучитьДвоичныеДанныеИзСтроки(ТекстJSON, КодировкаТекста.UTF8).Размер() > 65536 Тогда
			// Слишком большой найденный набор — явная ошибка, а не частичная карточка.
			Тело.status = "error";
			Тело.products = Новый Массив;
			Запись = Новый ЗаписьJSON;
			Запись.УстановитьСтроку();
			ЗаписатьJSON(Запись, Тело);
			ТекстJSON = Запись.Закрыть();
		КонецЕсли;
		Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Запрос.УстановитьТелоИзСтроки(ТекстJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	КонецЕсли;
	Попытка
		Ответ = Соединение.ВызватьHTTPМетод(Метод, Запрос);
	Исключение
		ВызватьИсключение "Нет соединения с агрегатором номенклатуры. Проверьте сеть и TLS.";
	КонецПопытки;
	// Отмена, истечение срока и новая аренда — штатный отказ от устаревшего результата.
	Если Ответ.КодСостояния = 409 И Метод = "POST" Тогда Возврат Неопределено; КонецЕсли;
	Если Ответ.КодСостояния = 401 Тогда ВызватьИсключение "Ключ номенклатуры отклонен. Сохраните новый ключ."; КонецЕсли;
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение "Агрегатор отклонил запрос номенклатуры: HTTP " + Формат(Ответ.КодСостояния, "ЧГ=0") + ".";
	КонецЕсли;
	ТипОтвета = Неопределено;
	Для Каждого Заголовок Из Ответ.Заголовки Цикл
		Если НРег(Заголовок.Ключ) = "content-type" Тогда ТипОтвета = Заголовок.Значение; Прервать; КонецЕсли;
	КонецЦикла;
	Если ТипЗнч(ТипОтвета) <> Тип("Строка") Тогда ВызватьИсключение "В ответе номенклатуры не задан Content-Type."; КонецЕсли;
	Если НРег(СокрЛП(СтрРазделить(ТипОтвета, ";")[0])) <> "application/json" Тогда
		ВызватьИсключение "Вместо JSON номенклатуры получен ответ другого формата.";
	КонецЕсли;
	ДанныеОтвета = Ответ.ПолучитьТелоКакДвоичныеДанные();
	Если ДанныеОтвета = Неопределено Тогда ВызватьИсключение "Пустой ответ номенклатуры."; КонецЕсли;
	Если ДанныеОтвета.Размер() > 16384 Тогда ВызватьИсключение "Слишком большой ответ номенклатуры."; КонецЕсли;
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
		Результат = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();
		Если ТипЗнч(Результат) <> Тип("Структура") Тогда ВызватьИсключение "Некорректный JSON."; КонецЕсли;
	Исключение
		ВызватьИсключение "Некорректный JSON номенклатуры от агрегатора.";
	КонецПопытки;
	Возврат Результат;
КонецФункции

// Только локальная проверка чтения карточки для администратора, без HTTP и ключей.
Функция ПроверитьКарточкуНоменклатуры(Штрихкод, ТестовыеВидыЦен = Неопределено) Экспорт
	ПроверитьАдминистратора();
	Диагностика = Новый Структура("Этап", "Проверка штрихкода");
	Результат = Новый Структура("ok,stage,message,response", Ложь, "", "", Неопределено);
	БылПривилегированныйРежим = ПривилегированныйРежим();
	Попытка
		ПроверитьШтрихкодНоменклатуры(Штрихкод);
		// Локальная проверка не требует ключа, сети или включённого обмена.
		Настройки = ПрочитатьНастройки();
		Если ТестовыеВидыЦен <> Неопределено Тогда
			Если ТипЗнч(ТестовыеВидыЦен) <> Тип("Структура") Тогда ВызватьИсключение "Некорректные тестовые виды цен."; КонецЕсли;
			Для Каждого Имя Из СтрРазделить("ЗакупочныйВидЦен,РозничныйВидЦен,БезналичныйВидЦен", ",") Цикл
				Если Не ТестовыеВидыЦен.Свойство(Имя) Тогда ВызватьИсключение "Укажите три тестовых вида цен."; КонецЕсли;
				Настройки[Имя] = ТестовыеВидыЦен[Имя];
			КонецЦикла;
		КонецЕсли;
		Диагностика.Этап = "Проверка трёх видов цен";
		УстановитьПривилегированныйРежим(Истина);
		Для Каждого Имя Из СтрРазделить("ЗакупочныйВидЦен,РозничныйВидЦен,БезналичныйВидЦен", ",") Цикл
			АС_НоменклатураАгрегатора.ПроверитьВидЦен(Настройки[Имя]);
		КонецЦикла;
		Товары = АС_НоменклатураАгрегатора.НайтиТовары(Штрихкод, Настройки, Диагностика);
		Диагностика.Этап = "Проверка JSON карточки";
		Ответ = Новый Структура("status,products", ?(Товары.Количество() = 0, "not_found", "found"), Товары);
		Запись = Новый ЗаписьJSON;
		Запись.УстановитьСтроку();
		ЗаписатьJSON(Запись, Ответ);
		ТекстJSON = Запись.Закрыть();
		Если ПолучитьДвоичныеДанныеИзСтроки(ТекстJSON, КодировкаТекста.UTF8).Размер() > 64000 Тогда
			ВызватьИсключение "Набор карточек превышает допустимый размер ответа.";
		КонецЕсли;
		Результат.ok = Истина;
		Результат.message = "Локальное чтение и JSON проверены. Найдено карточек: " + Формат(Товары.Количество(), "ЧГ=0") + ". На сайт ничего не отправлено.";
		Результат.response = Ответ;
	Исключение
		// Детали локального чтения видит только администратор, секреты здесь не используются.
		Результат.message = Лев(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), 3000);
	КонецПопытки;
	УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
	Результат.stage = Диагностика.Этап;
	Возврат Результат;
КонецФункции


// Снимок для отдельной административной формы. Ключи и секреты в JSON не включаются.
Функция ДиагностикаАгрегатора() Экспорт
	ПроверитьАдминистратора();
	Настройки = НастройкиДляФормы();
	Результат = Новый Структура("serverDatabase,connectionConfirmed,keyConfigured,repairsEnabled,testRepairs",
		Не ОбщегоНазначения.ИнформационнаяБазаФайловая(), Не Настройки.НужноПодтвердитьБазу,
		Настройки.КлючНоменклатурыЗадан, Настройки.Включен, Настройки.ТестоваяПлатформа);
	Результат.Вставить("scheduledJobs", Новый Массив);
	Результат.Вставить("recentRuns", Новый Массив);
	Задания = РегламентныеЗадания.ПолучитьРегламентныеЗадания(
		Новый Структура("Метаданные", Метаданные.РегламентныеЗадания.АС_ПоискНоменклатурыАгрегатора));
	Для Каждого Задание Из Задания Цикл
		Расписание = Задание.Расписание;
		Результат.scheduledJobs.Добавить(Новый Структура("id,enabled,user,periodSeconds,pauseSeconds",
			Строка(Задание.УникальныйИдентификатор), Задание.Использование, Задание.ИмяПользователя,
			Расписание.ПериодПовтораВТечениеДня, Расписание.ПаузаПовтора));
	КонецЦикла;
	История = Новый ТаблицаЗначений;
	Для Каждого Имя Из СтрРазделить("Начало,Конец,Состояние,Ошибка", ",") Цикл История.Колонки.Добавить(Имя); КонецЦикла;
	Отбор = Новый Структура("ИмяМетода", "АС_АгрегаторСервер.ОбработатьЗапросыНоменклатуры");
	Для Каждого Задание Из ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор) Цикл
		СтрокаИстории = История.Добавить();
		СтрокаИстории.Начало = Задание.Начало;
		СтрокаИстории.Конец = Задание.Конец;
		СтрокаИстории.Состояние = Строка(Задание.Состояние);
		СтрокаИстории.Ошибка = "";
		Если Задание.ИнформацияОбОшибке <> Неопределено Тогда
			СтрокаИстории.Ошибка = Лев(КраткоеПредставлениеОшибки(Задание.ИнформацияОбОшибке), 3000);
		КонецЕсли;
	КонецЦикла;
	История.Сортировать("Начало Убыв");
	Для Каждого СтрокаИстории Из История Цикл
		Если Результат.recentRuns.Количество() >= 10 Тогда Прервать; КонецЕсли;
		Результат.recentRuns.Добавить(Новый Структура("startedAt,finishedAt,state,error",
			Формат(СтрокаИстории.Начало, "ДФ=yyyy-MM-dd HH:mm:ss"), Формат(СтрокаИстории.Конец, "ДФ=yyyy-MM-dd HH:mm:ss"),
			СтрокаИстории.Состояние, СтрокаИстории.Ошибка));
	КонецЦикла;
	Результат.Вставить("repairQueue", СостояниеОчереди());
	Результат.Вставить("repairDelivery", ДиагностикаАвтообменаЗаказНарядов(
		"АС_ОтправкаЗаказНарядовАгрегатора", "ОтправитьИзмененияЗаказНарядов"));
	Результат.Вставить("repairReconciliation", ДиагностикаАвтообменаЗаказНарядов(
		"АС_СверкаЗаказНарядовАгрегатора", "СверитьЗаказНарядыАгрегатора"));
	Результат.Вставить("repairRefreshJobs", Новый Массив);
	Задания = РегламентныеЗадания.ПолучитьРегламентныеЗадания(
		Новый Структура("Метаданные", Метаданные.РегламентныеЗадания.АС_ОбновлениеЗаказНарядовАгрегатора));
	Для Каждого Задание Из Задания Цикл
		Результат.repairRefreshJobs.Добавить(Новый Структура("enabled,user,periodSeconds",
			Задание.Использование, Задание.ИмяПользователя, Задание.Расписание.ПериодПовтораВТечениеДня));
	КонецЦикла;
	Результат.Вставить("repairRefreshRuns", Новый Массив);
	Отбор = Новый Структура("ИмяМетода", "АС_АгрегаторСервер.ОбработатьОбновленияЗаказНарядов");
	Для Каждого Задание Из ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор) Цикл
		Если Результат.repairRefreshRuns.Количество() >= 10 Тогда Прервать; КонецЕсли;
		Ошибка = "";
		Если Задание.ИнформацияОбОшибке <> Неопределено Тогда
			Ошибка = Лев(КраткоеПредставлениеОшибки(Задание.ИнформацияОбОшибке), 3000);
		КонецЕсли;
		Результат.repairRefreshRuns.Добавить(Новый Структура("startedAt,finishedAt,state,error",
			Формат(Задание.Начало, "ДФ=yyyy-MM-dd HH:mm:ss"), Формат(Задание.Конец, "ДФ=yyyy-MM-dd HH:mm:ss"),
			Строка(Задание.Состояние), Ошибка));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция JSONДляРазработчика(Данные) Экспорт
	ПроверитьАдминистратора();
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, "  "));
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();
КонецФункции

Функция СохранитьРежимОбменаДляРазработчика(Знач ТестоваяПлатформа) Экспорт
	ПроверитьАдминистратора();
	Если ТипЗнч(ТестоваяПлатформа) <> Тип("Булево") Тогда
		ВызватьИсключение "Выберите тестовый или рабочий режим заказ-нарядов.";
	КонецЕсли;
	Сохраненные = НастройкиДляФормы();
	Если Сохраненные.НужноПодтвердитьБазу Тогда
		ВызватьИсключение "Сначала сохраните настройки интеграции для этой базы в основной форме.";
	КонецЕсли;
	Если Сохраненные.ТестоваяПлатформа <> ТестоваяПлатформа Тогда
		Номенклатура = Новый Структура("ЗакупочныйВидЦен,РозничныйВидЦен,БезналичныйВидЦен,НовыйКлючНоменклатуры",
			Сохраненные.ЗакупочныйВидЦен, Сохраненные.РозничныйВидЦен, Сохраненные.БезналичныйВидЦен, "");
		// При смене назначения останавливаем обмен. Новая выгрузка требует явного включения.
		СохранитьНастройки(Ложь, Сохраненные.Адрес, ТестоваяПлатформа, "", Номенклатура);
		Сохраненные = НастройкиДляФормы();
		Если Сохраненные.НужноПодтвердитьБазу Или Сохраненные.ТестоваяПлатформа <> ТестоваяПлатформа
			Или Сохраненные.Включен Тогда
			ВызватьИсключение "Не удалось подтвердить сохранение режима заказ-нарядов. Закройте форму и проверьте настройки повторно; выгрузку не запускайте.";
		КонецЕсли;
	КонецЕсли;
	Возврат Новый Структура("ТестоваяПлатформа,Включен", Сохраненные.ТестоваяПлатформа, Сохраненные.Включен);
КонецФункции

Функция ПроверитьКарточкуЗаказНаряда(Документ, ТестоваяПлатформа) Экспорт
	ПроверитьАдминистратора();
	Если ТипЗнч(Документ) <> Тип("ДокументСсылка.ЗаказПокупателя") Или Не ЗначениеЗаполнено(Документ)
		Или ТипЗнч(ТестоваяПлатформа) <> Тип("Булево") Тогда ВызватьИсключение "Выберите заказ-наряд и режим проверки."; КонецЕсли;
	БылПривилегированныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Карточка = КарточкаДокумента(Документ, ТестоваяПлатформа);
		Если Карточка = Неопределено Тогда
			Ошибка = "Документ не входит в отбор: нужен проведённый заказ-наряд «В работе» без пометки удаления.";
		Иначе
			Ошибка = ОшибкаДанныхКарточки(Карточка);
			Если Не ЗначениеЗаполнено(Ошибка) Тогда
				// Локально проверяем тот же JSON и подтверждение, что использует отправитель.
				// HTTP-запросы и изменение документа здесь не выполняются.
				Запись = Новый ЗаписьJSON;
				Запись.УстановитьСтроку();
				ЗаписатьJSON(Запись, Карточка);
				Чтение = Новый ЧтениеJSON;
				Чтение.УстановитьСтроку(Запись.Закрыть());
				КарточкаИзJSON = ПрочитатьJSON(Чтение);
				Чтение.Закрыть();
				Диагностика = Новый Структура("Сообщение,Повторить", "", Ложь);
				ПодтвердитьПриемКарточки(Новый Структура("repair", КарточкаИзJSON), Карточка, Диагностика);
			КонецЕсли;
		КонецЕсли;
		Результат = Новый Структура("ok,message,response", Не ЗначениеЗаполнено(Ошибка),
			?(ЗначениеЗаполнено(Ошибка), Ошибка, "Карточка, преобразование JSON и подтверждение проверены."), Карточка);
	Исключение
		Результат = Новый Структура("ok,message,response", Ложь,
			Лев(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), 3000), Неопределено);
	КонецПопытки;
	УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
	Возврат Результат;
КонецФункции


// Отдельная очередь кнопки «Обновить»: только переданные UUID, без полной сверки базы.
Процедура ОбработатьОбновленияЗаказНарядов() Экспорт
	Если ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание() = Неопределено Тогда
		ВызватьИсключение "Обновление заказ-нарядов выполняется фоновым заданием сервера.";
	КонецЕсли;
	БылПривилегированныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Отбор = Новый Структура("ИмяМетода", "АС_АгрегаторСервер.ОбработатьОбновленияЗаказНарядов");
		Для Каждого Задание Из ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор) Цикл
			Если Задание.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно
				И Задание.Конец + 30 > ТекущаяДатаСеанса() Тогда
				УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
				Возврат;
			КонецЕсли;
		КонецЦикла;
		Настройки = ПрочитатьНастройки();
		Если Настройки.Включен И Настройки.ОтпечатокБазы = ОтпечатокБазы() Тогда
			// На сервере длинный ограниченный цикл сокращает стыки перезапуска.
			// В файловой базе сохраняем прежний срок, освобождая фоновые задания.
			ФайловаяБаза = ОбщегоНазначения.ИнформационнаяБазаФайловая();
			СрокОпроса = ?(ФайловаяБаза, 45, 300);
			ПределОпросов = ?(ФайловаяБаза, 20, 200);
			ЗапасОпроса = ?(ФайловаяБаза, 15, 7);
			НачалоОбработчика = ТекущаяУниверсальнаяДатаВМиллисекундах();
			ЗавершитьДо = ТекущаяУниверсальнаяДата() + СрокОпроса;
			// Один HTTP/TLS-канал на получение заданий и отправку результатов этого запуска.
			КонтекстОбмена = Новый Структура("Соединение,Секрет", Неопределено, "");
			Для Номер = 1 По ПределОпросов Цикл
				Если ТекущаяУниверсальнаяДата() >= ЗавершитьДо - ЗапасОпроса
					Или Не АктуальныНастройкиОбновленияЗаказНарядов(Настройки) Тогда Прервать; КонецЕсли;
				Путь = "/api/integration/1c/repairs/refresh/requests?waitSeconds=5&testPlatform="
					+ ?(Настройки.ТестоваяПлатформа, "true", "false");
				НачалоПолучения = ТекущаяУниверсальнаяДатаВМиллисекундах();
				Ответ = ВыполнитьЗапрос(Настройки, "GET", Путь, Неопределено, ЗавершитьДо, , КонтекстОбмена);
				МсПолучения = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоПолучения;
				Задание = Неопределено;
				Если Не Ответ.Свойство("request", Задание) Тогда ВызватьИсключение "Некорректный ответ очереди обновления заказ-нарядов."; КонецЕсли;
				Если Задание = Неопределено Или ТипЗнч(Задание) = Тип("Null") Тогда Продолжить; КонецЕсли;
				ПроверитьЗаданиеОбновленияЗаказНарядов(Задание, Настройки.ТестоваяПлатформа);
				// Каждому полученному запросу даём собственный бюджет в пределах аренды 45 секунд.
				ЗавершитьЗаданиеДо = ТекущаяУниверсальнаяДата() + 43;
				Если Не АктуальныНастройкиОбновленияЗаказНарядов(Настройки) Тогда Прервать; КонецЕсли;
				Результат = Новый Структура("requestId,leaseId,testPlatform,status,repairs,removedDocumentIds",
					Задание.id, Задание.leaseId, Настройки.ТестоваяПлатформа, "error", Новый Массив, Новый Массив);
				НачалоЧтения = ТекущаяУниверсальнаяДатаВМиллисекундах();
				МсГотовности = 0;
				МсПодготовкиОплаты = 0;
				МсКарточек = 0;
				ДанныеПакета = Неопределено;
				ЗамерыОстатков = Новый Структура("Организации,Потребность,Выборки,Расчет", 0, 0, 0, 0);
				Попытка
					// HTTP выполняется после завершения транзакции чтения.
					НачатьТранзакцию();
					СуществующиеДокументы = СуществующиеДокументыОбновления(Задание.documentIds);
					СсылкиПакета = Новый Массив;
					Для Каждого ЭлементПакета Из СуществующиеДокументы Цикл СсылкиПакета.Добавить(ЭлементПакета.Значение); КонецЦикла;
					НачалоЭтапа = ТекущаяУниверсальнаяДатаВМиллисекундах();
					ДанныеПакета = ПодготовитьДанныеПакетаЗаказНарядов(СсылкиПакета);
					МсПодготовкиОплаты = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЭтапа;
					НачалоЭтапа = ТекущаяУниверсальнаяДатаВМиллисекундах();
					ГотовностьПакета = АС_ГотовностьТоваровАгрегатора.РассчитатьПакет(СсылкиПакета, ДанныеПакета.Документы, ЗамерыОстатков);
					МсГотовности = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЭтапа;
					ДанныеПакета.Вставить("Готовность", ГотовностьПакета);
					НачалоЭтапа = ТекущаяУниверсальнаяДатаВМиллисекундах();
					Для Каждого Идентификатор Из Задание.documentIds Цикл
						Если ТекущаяУниверсальнаяДата() >= ЗавершитьЗаданиеДо - 12 Тогда
							ВызватьИсключение "Истёк срок полного чтения показанных заказ-нарядов.";
						КонецЕсли;
						Документ = СуществующиеДокументы.Получить(Идентификатор);
						Карточка = Неопределено;
						Если Документ <> Неопределено Тогда
							Карточка = КарточкаДокумента(Документ, Настройки.ТестоваяПлатформа, ДанныеПакета);
						КонецЕсли;
						Если Карточка = Неопределено Тогда
							Результат.removedDocumentIds.Добавить(Идентификатор);
						Иначе
							Ошибка = ОшибкаДанныхКарточки(Карточка);
							Если ЗначениеЗаполнено(Ошибка) Или Не Карточка.Свойство("goodsReadiness") Тогда
								ВызватьИсключение "Не удалось полностью проверить карточку заказ-наряда.";
							КонецЕсли;
							Результат.repairs.Добавить(Карточка);
						КонецЕсли;
					КонецЦикла;
					МсКарточек = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЭтапа;
					ЗафиксироватьТранзакцию();
					Результат.status = "success";
				Исключение
					Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
					// Никакой частичный набор не должен стать успешным обновлением.
					Результат.repairs = Новый Массив;
					Результат.removedDocumentIds = Новый Массив;
					ЗаписьЖурналаРегистрации("АС_Агрегатор.ОбновлениеЗаказНарядов", УровеньЖурналаРегистрации.Ошибка, , ,
						"Не удалось полностью прочитать и проверить запрошенные карточки. Частичные данные на сайт не отправлены.");
				КонецПопытки;
				СекундЧтения = (ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЧтения) / 1000;
				Если Не АктуальныНастройкиОбновленияЗаказНарядов(Настройки) Тогда Прервать; КонецЕсли;
				// Проверяем сериализацию до отправки. Ошибка также означает отказ от всего пакета.
				Попытка
					Запись = Новый ЗаписьJSON;
					Запись.УстановитьСтроку();
					ЗаписатьJSON(Запись, Результат);
					Если ПолучитьДвоичныеДанныеИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8).Размер() > 500000 Тогда
						ВызватьИсключение "Превышен размер ответа обновления.";
					КонецЕсли;
				Исключение
					Результат.status = "error";
					Результат.repairs = Новый Массив;
					Результат.removedDocumentIds = Новый Массив;
				КонецПопытки;
				НачалоОтправки = ТекущаяУниверсальнаяДатаВМиллисекундах();
				Подтверждение = ВыполнитьЗапрос(Настройки, "POST", "/api/integration/1c/repairs/refresh/results", Результат, ЗавершитьЗаданиеДо, , КонтекстОбмена);
				СекундОтправки = (ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоОтправки) / 1000;
				МсОчереди = -1;
				МсПриемаСервером = -1;
				ЗамерыСервера = Неопределено;
				Если Подтверждение.Свойство("timing", ЗамерыСервера) И ТипЗнч(ЗамерыСервера) = Тип("Структура") Тогда
					Если ЗамерыСервера.Свойство("queueMs") И ТипЗнч(ЗамерыСервера.queueMs) = Тип("Число") Тогда МсОчереди = ЗамерыСервера.queueMs; КонецЕсли;
					Если ЗамерыСервера.Свойство("applyMs") И ТипЗнч(ЗамерыСервера.applyMs) = Тип("Число") Тогда МсПриемаСервером = ЗамерыСервера.applyMs; КонецЕсли;
				КонецЕсли;
				// Один замер на ручное задание, в том числе быстрее секунды.
				ЗаписьЖурналаРегистрации("АС_Агрегатор.ВремяОбновления", УровеньЖурналаРегистрации.Информация, , ,
					СтрШаблон("Пакет v6. Запрос %1; документов: %2; чтение 1С: %3 с; отправка результата: %4 с; остатки: %5 мс; подготовка оплаты: %6 мс; карточки и цены: %7 мс; очередь: %8 мс; приём сервером: %9 мс.",
						Задание.id, Задание.documentIds.Количество(), Окр(СекундЧтения, 3), Окр(СекундОтправки, 3),
						МсГотовности, МсПодготовкиОплаты, МсКарточек, МсОчереди, МсПриемаСервером) + ЗамерыЦенПакета(ДанныеПакета)
					+ Символы.ПС + СтрШаблон("Остатки v6: организации: %1 мс; потребность: %2 мс; выборки: %3 мс; расчёт: %4 мс. Обработчик: возраст начала опроса %5 мс; опрос %6; получение задания: %7 мс.",
						ЗамерыОстатков.Организации, ЗамерыОстатков.Потребность, ЗамерыОстатков.Выборки, ЗамерыОстатков.Расчет,
						НачалоПолучения - НачалоОбработчика, Номер, МсПолучения));
				Если Не Подтверждение.Свойство("accepted") Или Подтверждение.accepted <> Истина
					Или Не Подтверждение.Свойство("requestId") Или Подтверждение.requestId <> Задание.id Тогда
					ВызватьИсключение "Агрегатор не подтвердил полный результат обновления заказ-нарядов.";
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	Исключение
		Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
		УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
		ВызватьИсключение "Сбой очереди обновления заказ-нарядов. Проверьте адрес, секрет, сеть и состояние серверного задания.";
	КонецПопытки;
	УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
КонецПроцедуры

// Проверяем существование всего пакета одним запросом, сохраняя UUID удалённых документов.
Функция СуществующиеДокументыОбновления(Идентификаторы)
	Ссылки = Новый Массив;
	Для Каждого Идентификатор Из Идентификаторы Цикл
		Ссылки.Добавить(Документы.ЗаказПокупателя.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор)));
	КонецЦикла;
	Запрос = Новый Запрос("ВЫБРАТЬ Документ.Ссылка ИЗ Документ.ЗаказПокупателя КАК Документ
	|ГДЕ Документ.Ссылка В (&Документы) И Документ.Проведен И НЕ Документ.ПометкаУдаления
	|И Документ.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаряд)
	|И Документ.СостояниеЗаказа.Наименование = &Состояние");
	Запрос.УстановитьПараметр("Состояние", СостоянияЗаказов.СостояниеВРаботе());
	Запрос.УстановитьПараметр("Документы", Ссылки);
	Выборка = Запрос.Выполнить().Выбрать();
	СуществующиеДокументы = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		СуществующиеДокументы.Вставить(НРег(Строка(Выборка.Ссылка.УникальныйИдентификатор())), Выборка.Ссылка);
	КонецЦикла;
	Возврат СуществующиеДокументы;
КонецФункции

Функция АктуальныНастройкиОбновленияЗаказНарядов(Настройки)
	Актуальные = ПрочитатьНастройки();
	Возврат Актуальные.Включен И Актуальные.ОтпечатокБазы = ОтпечатокБазы()
		И Актуальные.ТестоваяПлатформа = Настройки.ТестоваяПлатформа
		И Актуальные.ВерсияНоменклатуры = Настройки.ВерсияНоменклатуры;
КонецФункции

Процедура ПроверитьЗаданиеОбновленияЗаказНарядов(Задание, ТестоваяПлатформа)
	Если ТипЗнч(Задание) <> Тип("Структура") Тогда ВызватьИсключение "Некорректное задание обновления."; КонецЕсли;
	Для Каждого Имя Из СтрРазделить("id,leaseId,expiresAt,documentIds,testPlatform", ",") Цикл
		Если Не Задание.Свойство(Имя) Тогда ВызватьИсключение "Неполное задание обновления."; КонецЕсли;
	КонецЦикла;
	Если ТипЗнч(Задание.documentIds) <> Тип("Массив") Или ТипЗнч(Задание.testPlatform) <> Тип("Булево")
		Или Задание.testPlatform <> ТестоваяПлатформа Тогда ВызватьИсключение "Некорректный состав или режим обновления."; КонецЕсли;
	Если Задание.documentIds.Количество() < 1 Или Задание.documentIds.Количество() > 200 Тогда
		ВызватьИсключение "Недопустимое число запрошенных заказ-нарядов.";
	КонецЕсли;
	Идентификаторы = Новый Массив;
	Идентификаторы.Добавить(Задание.id);
	Идентификаторы.Добавить(Задание.leaseId);
	Для Каждого Идентификатор Из Задание.documentIds Цикл Идентификаторы.Добавить(Идентификатор); КонецЦикла;
	Для Каждого Идентификатор Из Идентификаторы Цикл
		Если ТипЗнч(Идентификатор) <> Тип("Строка") Тогда ВызватьИсключение "Некорректный UUID задания."; КонецЕсли;
		Если СтрДлина(Идентификатор) <> 36 Или Строка(Новый УникальныйИдентификатор(Идентификатор))
			= "00000000-0000-0000-0000-000000000000" Тогда ВызватьИсключение "Некорректный UUID задания."; КонецЕсли;
	КонецЦикла;
	Уникальные = Новый Соответствие;
	Для Каждого Идентификатор Из Задание.documentIds Цикл Уникальные.Вставить(Идентификатор, Истина); КонецЦикла;
	Если Уникальные.Количество() <> Задание.documentIds.Количество() Тогда ВызватьИсключение "Повторяющиеся UUID в задании."; КонецЕсли;
КонецПроцедуры


// Обычная передача изменений и удалений выполняется сервером отдельно от очереди ручного обновления.
Функция ИспользоватьКлиентскийТаймерОбмена() Экспорт
	Возврат ОбщегоНазначения.ИнформационнаяБазаФайловая();
КонецФункции

Процедура ПроверитьФоновыйОбменЗаказНарядов()
	Если ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание() = Неопределено Тогда
		ВызватьИсключение "Автоматический обмен заказ-нарядами выполняется фоновым заданием сервера.";
	КонецЕсли;
КонецПроцедуры

Процедура ОтправитьИзмененияЗаказНарядов() Экспорт
	ПроверитьФоновыйОбменЗаказНарядов();
	// Быстрый запуск читает только готовую очередь, без пересчёта всего списка.
	ОбработатьОчередь(Истина);
КонецПроцедуры

Процедура СверитьЗаказНарядыАгрегатора() Экспорт
	ПроверитьФоновыйОбменЗаказНарядов();
	// Ротационная сверка восстанавливает пропущенные изменения, включая закрытые документы.
	ОбработатьОчередь(Ложь);
КонецПроцедуры

Функция ДиагностикаАвтообменаЗаказНарядов(ИмяЗадания, ИмяМетода)
	Результат = Новый Структура("jobs,recentRuns", Новый Массив, Новый Массив);
	Задания = РегламентныеЗадания.ПолучитьРегламентныеЗадания(
		Новый Структура("Метаданные", Метаданные.РегламентныеЗадания[ИмяЗадания]));
	Для Каждого Задание Из Задания Цикл
		Результат.jobs.Добавить(Новый Структура("enabled,user,periodSeconds",
			Задание.Использование, Задание.ИмяПользователя, Задание.Расписание.ПериодПовтораВТечениеДня));
	КонецЦикла;
	История = Новый ТаблицаЗначений;
	Для Каждого Имя Из СтрРазделить("Начало,Конец,Состояние,Ошибка", ",") Цикл История.Колонки.Добавить(Имя); КонецЦикла;
	Отбор = Новый Структура("ИмяМетода", "АС_АгрегаторСервер." + ИмяМетода);
	Для Каждого Задание Из ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор) Цикл
		СтрокаИстории = История.Добавить();
		СтрокаИстории.Начало = Задание.Начало;
		СтрокаИстории.Конец = Задание.Конец;
		СтрокаИстории.Состояние = Строка(Задание.Состояние);
		// Только безопасный итог: сырые исключения могут содержать данные документов или HTTP.
		СтрокаИстории.Ошибка = ?(Задание.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно,
			"Серверное задание завершилось с ошибкой. Проверьте очередь, подключение и разрешения фоновых заданий.", "");
	КонецЦикла;
	История.Сортировать("Начало Убыв");
	Для Каждого СтрокаИстории Из История Цикл
		Если Результат.recentRuns.Количество() >= 10 Тогда Прервать; КонецЕсли;
		Результат.recentRuns.Добавить(Новый Структура("startedAt,finishedAt,state,error",
			Формат(СтрокаИстории.Начало, "ДФ=yyyy-MM-dd HH:mm:ss"), Формат(СтрокаИстории.Конец, "ДФ=yyyy-MM-dd HH:mm:ss"),
			СтрокаИстории.Состояние, СтрокаИстории.Ошибка));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ВариантыОплатыДокумента(Документ, СуммаКОплате, Оплачено, ДанныеПакета = Неопределено)

	КонтекстЦен = Неопределено;
	Если ДанныеПакета = Неопределено Тогда
		ТолькоКарта = АС_ЦенообразованиеСервер.ТолькоБезналичнаяОплатаЗаказНаряда(Документ.ВидОперации, Документ.Контрагент);
	Иначе
		КонтекстЦен = ДанныеПакета.КонтекстЦен;
		Реквизиты = ДанныеПакета.РеквизитыКарточек.Получить(Документ);
		ТолькоКарта = Реквизиты.ВидОперации = Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаряд
			И ЗначениеЗаполнено(Реквизиты.Контрагент) И Реквизиты.ВидКонтрагента = Перечисления.ВидыКонтрагентов.ЮридическоеЛицо;
		ФизическоеЛицо = ЗначениеЗаполнено(Реквизиты.Контрагент) И Реквизиты.ВидКонтрагента = Перечисления.ВидыКонтрагентов.ФизическоеЛицо;
		ОплатаНаличными = Реквизиты.АС_ОплатаНаличными;
	КонецЕсли;
	Если ТолькоКарта Тогда
		Возврат Новый Структура("cardAmountDue,cashAmountDue,cashDiscountPercent",
			Макс(0, Окр(СуммаКОплате - Оплачено, 2)), Неопределено, Неопределено);
	КонецЕсли;
	Если ДанныеПакета = Неопределено Тогда ОплатаНаличными = Документ.АС_ОплатаНаличными; КонецЕсли;
	Настройки = Неопределено;
	Если КонтекстЦен <> Неопределено Тогда Настройки = КонтекстЦен.НастройкиОплаты; КонецЕсли;
	Если Настройки = Неопределено Тогда
		Настройки = АС_ЦенообразованиеСервер.НастройкиРежимаОплаты();
		Если КонтекстЦен <> Неопределено Тогда КонтекстЦен.НастройкиОплаты = Настройки; КонецЕсли;
	КонецЕсли;
	Наличные = Не ОплатаНаличными;
	ВидЦен = ?(Наличные, Настройки.НаличныйВидЦен, Настройки.БезналичныйВидЦен);
	Если Не ЗначениеЗаполнено(ВидЦен) Или ВидЦен.ПометкаУдаления Тогда
		ВызватьИсключение "Не настроен вид цен альтернативной оплаты.";
	КонецЕсли;
	НачалоЭтапа = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Копия = КопияЗаказНарядаДляПрогноза(Документ, ДанныеПакета);
	Если КонтекстЦен <> Неопределено Тогда КонтекстЦен.МсКопий = КонтекстЦен.МсКопий + ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЭтапа; КонецЕсли;
	НачалоЭтапа = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Цены = АС_ЦенообразованиеСервер.ПодготовитьЦеныРежимаОплаты(Копия, ВидЦен, КонтекстЦен);
	Если КонтекстЦен <> Неопределено Тогда КонтекстЦен.МсПодготовкиЦен = КонтекстЦен.МсПодготовкиЦен + ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЭтапа; КонецЕсли;
	НачалоЭтапа = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Если Не ПустаяСтрока(Цены.Ошибка) Тогда
		ВызватьИсключение "Для части товаров не задана цена альтернативной оплаты.";
	КонецЕсли;
	Копия.АС_ОплатаНаличными = Наличные;
	Для Индекс = 0 По Копия.Запасы.Количество() - 1 Цикл
		Копия.Запасы[Индекс].Вставить("АС_ЦенаДляПрогноза", Цены.Цены[Индекс]);
	КонецЦикла;
	Контекст = Новый Структура("Объект,НоваяСуммаВключаетНДС,ПоследнийНеокругленныйИтог",
		Копия, Цены.СуммаВключаетНДС, Неопределено);
	// Как предпросмотр администратора: не ограничиваем скидки правами сотрудника.
	// Права регламентного задания на результат расчёта не влияют.
	Контекст.Вставить("ОграничиватьСкидки", Ложь);
	Контекст.Вставить("ПределСкидки", ?(Наличные, Настройки.СкидкаНаличные, Настройки.СкидкаКарта));
	Контекст.Вставить("ИспользоватьМинимальныеЦены", ЦенообразованиеСерверПовтИсп.МинимальныеЦеныИспользуются());
	Если ДанныеПакета = Неопределено Тогда
		Контекст.Вставить("Округлять", Наличные И ЗначениеЗаполнено(Документ.Контрагент)
			И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ.Контрагент, "ВидКонтрагента")
				= Перечисления.ВидыКонтрагентов.ФизическоеЛицо);
	Иначе
		Контекст.Вставить("Округлять", Наличные И ФизическоеЛицо);
	КонецЕсли;
	// ФормаЗаказНаряда не включает доставку в прогноз и сумму долга.
	Контекст.Вставить("СтоимостьДоставки", 0);
	АльтернативныйИтог = АС_РежимОплатыКлиентСервер.АС_АльтернативныйИтогЗаказа(Контекст);
	ИтогНаличными = ?(Наличные, АльтернативныйИтог, СуммаКОплате);
	ИтогКартой = ?(Наличные, СуммаКОплате, АльтернативныйИтог);
	Если Не Наличные Тогда
		ИтогКартой = АС_РежимОплатыКлиентСервер.СогласоватьИтогКартой(ИтогКартой, ИтогНаличными);
	КонецЕсли;
	Скидка = ?(ИтогКартой > 0, Макс(0, Окр((ИтогКартой - ИтогНаличными) / ИтогКартой * 100, 2)), 0);
	Если КонтекстЦен <> Неопределено Тогда КонтекстЦен.МсАрифметики = КонтекстЦен.МсАрифметики + ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЭтапа; КонецЕсли;
	Возврат Новый Структура("cardAmountDue,cashAmountDue,cashDiscountPercent",
		Макс(0, Окр(ИтогКартой - Оплачено, 2)), Макс(0, Окр(ИтогНаличными - Оплачено, 2)), Скидка);

КонецФункции

Функция КопияЗаказНарядаДляПрогноза(Документ, ДанныеПакета = Неопределено)

	Если ДанныеПакета = Неопределено Тогда
		Объект = Документ.ПолучитьОбъект();
	Иначе
		Объект = ДанныеПакета.Документы.Получить(Документ);
		Если Объект = Неопределено Тогда ВызватьИсключение "Не получены строки документа в пакете."; КонецЕсли;
	КонецЕсли;
	КонтекстЦен = Неопределено;
	Если ДанныеПакета <> Неопределено Тогда КонтекстЦен = ДанныеПакета.КонтекстЦен; КонецЕсли;
	Если ДанныеПакета = Неопределено Тогда
		Копия = Новый Структура;
		Для Каждого Реквизит Из Метаданные.Документы.ЗаказПокупателя.Реквизиты Цикл
			Копия.Вставить(Реквизит.Имя, Объект[Реквизит.Имя]);
		КонецЦикла;
	Иначе
		Копия = Новый Структура(ДанныеПакета.СхемаРеквизитов.Шапка);
		ЗаполнитьЗначенияСвойств(Копия, Объект);
	КонецЕсли;
	Копия.Вставить("Ссылка", Документ);
	Копия.Вставить("Дата", Объект.Дата);
	ИспользоватьМинимальныеЦены = ЦенообразованиеСерверПовтИсп.МинимальныеЦеныИспользуются();
	Для Каждого ИмяТаблицы Из СтрРазделить("Запасы,Работы", ",") Цикл
		ИменаРеквизитовСтроки = "";
		Если ДанныеПакета <> Неопределено Тогда ИменаРеквизитовСтроки = ДанныеПакета.СхемаРеквизитов.Строки.Получить(ИмяТаблицы); КонецЕсли;
		Строки = Новый Массив;
		Для Каждого ИсходнаяСтрока Из Объект[ИмяТаблицы] Цикл
			Если ДанныеПакета = Неопределено Тогда
				СтрокаТовара = Новый Структура;
				Для Каждого Реквизит Из Метаданные.Документы.ЗаказПокупателя.ТабличныеЧасти[ИмяТаблицы].Реквизиты Цикл
					СтрокаТовара.Вставить(Реквизит.Имя, ИсходнаяСтрока[Реквизит.Имя]);
				КонецЦикла;
			Иначе
				СтрокаТовара = Новый Структура(ИменаРеквизитовСтроки);
				ЗаполнитьЗначенияСвойств(СтрокаТовара, ИсходнаяСтрока);
			КонецЕсли;
			// Отменённые строки форма удаляет перед записью документа.
			СтрокаТовара.Вставить("Отменен", 0);
			СтрокаТовара.Вставить("Отгружено", 0);
			СтрокаТовара.Вставить("МинимальнаяЦена", 0);
			ЭтоНоменклатура = ЗначениеЗаполнено(СтрокаТовара.Номенклатура)
				И ТипЗнч(СтрокаТовара.Номенклатура) = Тип("СправочникСсылка.Номенклатура");
			РеквизитыТовара = Неопределено;
			ЭтоНабор = Ложь;
			Если ЭтоНоменклатура Тогда
				Если ДанныеПакета = Неопределено Тогда
					ЭтоНабор = СтрокаТовара.Номенклатура.ЭтоНабор;
				Иначе
					РеквизитыТовара = ДанныеПакета.Номенклатура.Получить(СтрокаТовара.Номенклатура);
					Если РеквизитыТовара = Неопределено Тогда ВызватьИсключение "Не получены реквизиты номенклатуры в пакете."; КонецЕсли;
					ЭтоНабор = РеквизитыТовара.ЭтоНабор;
				КонецЕсли;
			КонецЕсли;
			СтрокаТовара.Вставить("ЭтоНабор", ЭтоНоменклатура
				И Не ЗначениеЗаполнено(СтрокаТовара.НоменклатураНабора) И ЭтоНабор);
			Если ЭтоНоменклатура И ИспользоватьМинимальныеЦены Тогда
				Данные = Новый Структура("Номенклатура,Характеристика,ДатаОбработки,ВалютаДокумента,СуммаВключаетНДС,Коэффициент,СтавкаНДС",
					СтрокаТовара.Номенклатура, СтрокаТовара.Характеристика,
					ЦенообразованиеСервер.ПолучитьДатуОбработкиЦен(Ложь, Объект.Дата),
					Объект.ВалютаДокумента, Объект.СуммаВключаетНДС, 1, СтрокаТовара.СтавкаНДС);
				ЦенообразованиеКлиентСервер.ДополнитьСтруктуруДанныхНоменклатурыПолямиЦенообразования(Объект, СтрокаТовара, Данные);
				СтрокаТовара.МинимальнаяЦена = АС_ЦенообразованиеСервер.ЦенаДляОбновления(Данные, Истина, КонтекстЦен);
			КонецЕсли;
			Если ИмяТаблицы = "Запасы" Тогда
				СтрокаТовара.Вставить("Коэффициент", 1);
				СтрокаТовара.Вставить("Кратность", 1);
				ТекущийКП = СтрокаТовара.НомерВариантаКП = Объект.ОсновнойВариантКП
					И (Объект.КоличествоВариантовКП = 0 Или Объект.ОсновнойВариантКП <> 0);
				СтрокаТовара.Вставить("АС_ВходитВОкруглениеПрогноза", ТекущийКП);
				СтрокаТовара.Вставить("АС_ВходитВИтогПрогноза", ТекущийКП И Не СтрокаТовара.ЭтоРазделитель);
				Разрешено = Ложь;
				Если ЭтоНоменклатура И СтрокаТовара.ТипНоменклатурыЗапас Тогда
					Если РеквизитыТовара = Неопределено Тогда
						РеквизитыТовара = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
							СтрокаТовара.Номенклатура, "ТипНоменклатуры,ВидПродукцииИС");
					КонецЕсли;
					Разрешено = РеквизитыТовара.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Запас
						И РеквизитыТовара.ВидПродукцииИС <> Перечисления.ВидыПродукцииИС.Табак
						И РеквизитыТовара.ВидПродукцииИС <> Перечисления.ВидыПродукцииИС.АльтернативныйТабак
						И РеквизитыТовара.ВидПродукцииИС <> Перечисления.ВидыПродукцииИС.НикотиносодержащаяПродукция;
				КонецЕсли;
				СтрокаТовара.Вставить("АС_НоменклатураРазрешаетОкругление", Разрешено);
			КонецЕсли;
			Строки.Добавить(СтрокаТовара);
		КонецЦикла;
		Копия.Вставить(ИмяТаблицы, Строки);
	КонецЦикла;
	СтрокиТекущегоКП = Новый Массив;
	Для Каждого СтрокаТовара Из Копия.Запасы Цикл
		Если СтрокаТовара.АС_ВходитВОкруглениеПрогноза Тогда СтрокиТекущегоКП.Добавить(СтрокаТовара); КонецЕсли;
	КонецЦикла;
	ЗаполнитьОтгрузкуПрогноза(Документ, СтрокиТекущегоКП, ДанныеПакета);
	Возврат Копия;

КонецФункции

// Распределение повторяет НоменклатураВДокументахСервер: сначала склад, затем продажи.
// Дубликаты номенклатуры и разные единицы распределяются в порядке строк документа.
Процедура ЗаполнитьОтгрузкуПрогноза(Документ, Строки, ДанныеПакета = Неопределено)

	Если Строки.Количество() = 0 Тогда Возврат; КонецЕсли;
	Если ДанныеПакета = Неопределено Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Заказ", Документ);
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ Продажи.Номенклатура КАК Номенклатура,
		|Продажи.Характеристика КАК Характеристика, Продажи.Партия КАК Партия,
		|СУММА(Продажи.Количество) КАК Количество, СУММА(Продажи.Количество) КАК ОтгруженоИтог
		|ИЗ РегистрНакопления.Продажи КАК Продажи
		|ГДЕ Продажи.ЗаказПокупателя = &Заказ И Продажи.Количество > 0
		|СГРУППИРОВАТЬ ПО Продажи.Номенклатура, Продажи.Характеристика, Продажи.Партия
		|;
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ Запасы.Номенклатура КАК Номенклатура,
		|Запасы.Характеристика КАК Характеристика, Запасы.Партия КАК Партия,
		|Запасы.СтруктурнаяЕдиница КАК СтруктурнаяЕдиницаРезерв, СУММА(Запасы.Количество) КАК Количество
		|ИЗ РегистрНакопления.Запасы КАК Запасы
		|ГДЕ Запасы.ЗаказПокупателя = &Заказ
		|И Запасы.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|И НЕ ТИПЗНАЧЕНИЯ(Запасы.Регистратор) = ТИП(Документ.РезервированиеЗапасов)
		|И НЕ ТИПЗНАЧЕНИЯ(Запасы.Регистратор) = ТИП(Документ.СборкаЗапасов)
		|СГРУППИРОВАТЬ ПО Запасы.Номенклатура, Запасы.Характеристика, Запасы.Партия, Запасы.СтруктурнаяЕдиница";
		Пакет = Запрос.ВыполнитьПакет();
		Продажи = Пакет[0].Выгрузить();
		Расходы = Пакет[1].Выгрузить();
	Иначе
		ОтборДокумента = Новый Структура("Документ", Документ);
		// Распределение меняет количества: каждому документу даём отдельную копию строк.
		Продажи = ДанныеПакета.Продажи.Скопировать(ДанныеПакета.Продажи.НайтиСтроки(ОтборДокумента));
		Расходы = ДанныеПакета.Расходы.Скопировать(ДанныеПакета.Расходы.НайтиСтроки(ОтборДокумента));
	КонецЕсли;
	Итоги = Новый ТаблицаЗначений;
	Для Каждого ИмяКолонки Из СтрРазделить("Номенклатура,Характеристика,Партия,Количество", ",") Цикл
		Итоги.Колонки.Добавить(ИмяКолонки);
	КонецЦикла;
	Для Каждого СтрокаТовара Из Строки Цикл
		Если Не ЗначениеЗаполнено(СтрокаТовара.Номенклатура) Или ТипЗнч(СтрокаТовара.Номенклатура) = Тип("Строка") Тогда Продолжить; КонецЕсли;
		Итог = Итоги.Добавить();
		ЗаполнитьЗначенияСвойств(Итог, СтрокаТовара);
		Итог.Количество = СтрокаТовара.Количество * КоэффициентЕИПрогноза(СтрокаТовара);
	КонецЦикла;
	Итоги.Свернуть("Номенклатура,Характеристика,Партия", "Количество");
	Для Каждого СтрокаТовара Из Строки Цикл
		Если Не ЗначениеЗаполнено(СтрокаТовара.Номенклатура) Или ТипЗнч(СтрокаТовара.Номенклатура) = Тип("Строка") Тогда Продолжить; КонецЕсли;
		К = КоэффициентЕИПрогноза(СтрокаТовара);
		Отбор = Новый Структура("Номенклатура,Характеристика,Партия", СтрокаТовара.Номенклатура, СтрокаТовара.Характеристика, СтрокаТовара.Партия);
		П = Продажи.НайтиСтроки(Отбор);
		СуммаПоСтрокам = Итоги.НайтиСтроки(Отбор)[0].Количество;
		Отбор.Вставить("СтруктурнаяЕдиницаРезерв", СтрокаТовара.СтруктурнаяЕдиницаРезерв);
		Р = Расходы.НайтиСтроки(Отбор);
		Если Р.Количество() = 0 Или П.Количество() = 0 Тогда Продолжить; КонецЕсли;
		Отгружено = Окр(Р[0].Количество / К, 3);
		Если Отгружено <= 0 Тогда Продолжить; КонецЕсли;
		Если СтрокаТовара.Количество >= Отгружено Тогда
			СтрокаТовара.Отгружено = Отгружено;
			Р[0].Количество = 0;
		Иначе
			СтрокаТовара.Отгружено = СтрокаТовара.Количество;
			Р[0].Количество = Р[0].Количество - СтрокаТовара.Количество * К;
		КонецЕсли;
		Если П[0].ОтгруженоИтог > СуммаПоСтрокам Тогда
			П[0].Количество = СуммаПоСтрокам;
			П[0].ОтгруженоИтог = СуммаПоСтрокам;
		КонецЕсли;
		П[0].Количество = П[0].Количество - СтрокаТовара.Отгружено;
	КонецЦикла;
	Для Каждого СтрокаТовара Из Строки Цикл
		Если Не ЗначениеЗаполнено(СтрокаТовара.Номенклатура) Или ТипЗнч(СтрокаТовара.Номенклатура) = Тип("Строка") Тогда Продолжить; КонецЕсли;
		К = КоэффициентЕИПрогноза(СтрокаТовара);
		П = Продажи.НайтиСтроки(Новый Структура("Номенклатура,Характеристика,Партия", СтрокаТовара.Номенклатура, СтрокаТовара.Характеристика, СтрокаТовара.Партия));
		Если П.Количество() = 0 Тогда Продолжить; КонецЕсли;
		Отгружено = СтрокаТовара.Отгружено + Окр(П[0].Количество / К, 3);
		Если Отгружено = 0 Тогда
			СтрокаТовара.Отгружено = 0;
		ИначеЕсли СтрокаТовара.Количество >= Отгружено Тогда
			СтрокаТовара.Отгружено = Отгружено;
			П[0].Количество = 0;
		Иначе
			П[0].Количество = П[0].Количество - (СтрокаТовара.Количество - СтрокаТовара.Отгружено) * К;
			СтрокаТовара.Отгружено = СтрокаТовара.Количество;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция КоэффициентЕИПрогноза(СтрокаТовара)

	Если Не ЗначениеЗаполнено(СтрокаТовара.ЕдиницаИзмерения)
		Или ТипЗнч(СтрокаТовара.ЕдиницаИзмерения) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
		Возврат 1;
	КонецЕсли;
	Возврат СтрокаТовара.ЕдиницаИзмерения.Коэффициент;

КонецФункции


// Снимок относится только к текущему запросу. Документы и строки в базе не изменяются.
Функция ПодготовитьДанныеПакетаЗаказНарядов(Документы)
	НачалоЭтапа = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Данные = Новый Структура("Документы,СуммыОплаты,Номенклатура,Продажи,Расходы",
		Новый Соответствие, Новый Соответствие, Новый Соответствие, Неопределено, Неопределено);
	Данные.Вставить("КонтекстЦен", АС_ЦенообразованиеСервер.КонтекстЦенОбновления());
	Данные.Вставить("ЗамерыПодготовки", Новый Структура("Шапки,Строки,Номенклатура,Оплата,Отгрузка", 0, 0, 0, 0, 0));
	Данные.Вставить("СхемаРеквизитов", СхемаРеквизитовПакетаЗаказНарядов());
	Данные.Вставить("РеквизитыКарточек", РеквизитыКарточекПакета(Документы, Данные.СхемаРеквизитов.Шапка));
	// Обе ссылки относятся к одному снимку шапок; прогноз копирует его отдельно.
	Данные.Документы = Данные.РеквизитыКарточек;
	Контрагенты = Новый Массив;
	Для Каждого Элемент Из Данные.Документы Цикл
		Контрагенты.Добавить(Элемент.Значение.Контрагент);
	КонецЦикла;
	Данные.Вставить("КонтактыКонтрагентов", АС_КонтактыКонтрагентовСервер.ДанныеКонтрагентов(Контрагенты));
	Если Документы.Количество() = 0 Тогда Возврат Данные; КонецЕсли;
	Для Каждого Элемент Из Данные.Документы Цикл
		Элемент.Значение.Вставить("Ссылка", Элемент.Ключ);
		Элемент.Значение.Вставить("Запасы", Новый Массив);
		Элемент.Значение.Вставить("Работы", Новый Массив);
	КонецЦикла;
	Данные.ЗамерыПодготовки.Шапки = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЭтапа;
	НачалоЭтапа = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Номенклатура = Новый Соответствие;
	Характеристики = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Документы", Документы);
	Для Каждого ИмяТаблицы Из СтрРазделить("Запасы,Работы", ",") Цикл
		ИменаРеквизитовСтроки = Данные.СхемаРеквизитов.Строки.Получить(ИмяТаблицы);
		Поля = "Строки.Ссылка КАК Документ";
		Для Каждого ИмяРеквизита Из СтрРазделить(ИменаРеквизитовСтроки, ",") Цикл
			Поля = Поля + ", Строки." + ИмяРеквизита + " КАК " + ИмяРеквизита;
		КонецЦикла;
		Запрос.Текст = "ВЫБРАТЬ " + Поля + " ИЗ Документ.ЗаказПокупателя." + ИмяТаблицы
			+ " КАК Строки ГДЕ Строки.Ссылка В (&Документы) УПОРЯДОЧИТЬ ПО Строки.Ссылка, Строки.НомерСтроки";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			СтрокаТовара = Новый Структура(ИменаРеквизитовСтроки);
			ЗаполнитьЗначенияСвойств(СтрокаТовара, Выборка);
			Объект = Данные.Документы.Получить(Выборка.Документ);
			Если Объект = Неопределено Тогда ВызватьИсключение "Не получена шапка заказ-наряда для расчёта."; КонецЕсли;
			Объект[ИмяТаблицы].Добавить(СтрокаТовара);
			Если ЗначениеЗаполнено(СтрокаТовара.Номенклатура)
				И ТипЗнч(СтрокаТовара.Номенклатура) = Тип("СправочникСсылка.Номенклатура") Тогда
				Номенклатура.Вставить(СтрокаТовара.Номенклатура, Истина);
				Характеристика = СтрокаТовара.Характеристика;
				Если Характеристика = Неопределено Тогда Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка(); КонецЕсли;
				Характеристики.Вставить(Характеристика, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Данные.ЗамерыПодготовки.Строки = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЭтапа;
	НачалоЭтапа = ТекущаяУниверсальнаяДатаВМиллисекундах();
	СсылкиНоменклатуры = Новый Массив;
	Для Каждого Элемент Из Номенклатура Цикл СсылкиНоменклатуры.Добавить(Элемент.Ключ); КонецЦикла;
	Данные.Номенклатура = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(
		СсылкиНоменклатуры, "ЭтоНабор,ТипНоменклатуры,ВидПродукцииИС,ЦеноваяГруппа");
	Данные.КонтекстЦен.НоменклатураПакета = СсылкиНоменклатуры;
	Данные.КонтекстЦен.РеквизитыНоменклатуры = Данные.Номенклатура;
	Для Каждого Элемент Из Характеристики Цикл Данные.КонтекстЦен.ХарактеристикиПакета.Добавить(Элемент.Ключ); КонецЦикла;
	Данные.ЗамерыПодготовки.Номенклатура = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЭтапа;
	НачалоЭтапа = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Для Каждого Документ Из Документы Цикл
		Данные.СуммыОплаты.Вставить(Документ, Новый Структура("СуммаКОплате,Оплачено", 0, 0));
	КонецЦикла;
	Запрос.Текст =
	"ВЫБРАТЬ Данные.Документ, СУММА(Данные.СуммаКОплате) КАК СуммаКОплате,
	|СУММА(Данные.Оплачено) КАК Оплачено
	|ИЗ (
	|ВЫБРАТЬ Запасы.Ссылка КАК Документ, Запасы.Всего КАК СуммаКОплате, 0 КАК Оплачено
	|ИЗ Документ.ЗаказПокупателя.Запасы КАК Запасы ГДЕ Запасы.Ссылка В (&Документы)
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ Работы.Ссылка, Работы.Всего, 0
	|ИЗ Документ.ЗаказПокупателя.Работы КАК Работы ГДЕ Работы.Ссылка В (&Документы)
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ ФактОплаты.СчетНаОплату, 0, ФактОплаты.СуммаОплаты + ФактОплаты.СуммаАванса
	|ИЗ РегистрСведений.ФактОплатыЗаказов КАК ФактОплаты
	|ГДЕ ФактОплаты.СчетНаОплату В (&Документы)) КАК Данные
	|СГРУППИРОВАТЬ ПО Данные.Документ";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Данные.СуммыОплаты.Вставить(Выборка.Документ,
			Новый Структура("СуммаКОплате,Оплачено", Выборка.СуммаКОплате, Выборка.Оплачено));
	КонецЦикла;
	Данные.ЗамерыПодготовки.Оплата = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЭтапа;
	НачалоЭтапа = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Запрос.Текст = ТекстОтгрузкиПакета();
	ПакетОтгрузки = Запрос.ВыполнитьПакет();
	Данные.Продажи = ПакетОтгрузки[0].Выгрузить();
	Данные.Расходы = ПакетОтгрузки[1].Выгрузить();
	Данные.Продажи.Индексы.Добавить("Документ");
	Данные.Расходы.Индексы.Добавить("Документ");
	Данные.ЗамерыПодготовки.Отгрузка = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЭтапа;
	Возврат Данные;
КонецФункции

Функция ТекстОтгрузкиПакета()
	Возврат "ВЫБРАТЬ РАЗРЕШЕННЫЕ Продажи.ЗаказПокупателя КАК Документ, Продажи.Номенклатура КАК Номенклатура,
	|Продажи.Характеристика КАК Характеристика, Продажи.Партия КАК Партия,
	|СУММА(Продажи.Количество) КАК Количество, СУММА(Продажи.Количество) КАК ОтгруженоИтог
	|ИЗ РегистрНакопления.Продажи КАК Продажи
	|ГДЕ Продажи.ЗаказПокупателя В (&Документы) И Продажи.Количество > 0
	|СГРУППИРОВАТЬ ПО Продажи.ЗаказПокупателя, Продажи.Номенклатура, Продажи.Характеристика, Продажи.Партия
	|;
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ Запасы.ЗаказПокупателя КАК Документ, Запасы.Номенклатура КАК Номенклатура,
	|Запасы.Характеристика КАК Характеристика, Запасы.Партия КАК Партия,
	|Запасы.СтруктурнаяЕдиница КАК СтруктурнаяЕдиницаРезерв, СУММА(Запасы.Количество) КАК Количество
	|ИЗ РегистрНакопления.Запасы КАК Запасы
	|ГДЕ Запасы.ЗаказПокупателя В (&Документы)
	|И Запасы.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|И НЕ ТИПЗНАЧЕНИЯ(Запасы.Регистратор) = ТИП(Документ.РезервированиеЗапасов)
	|И НЕ ТИПЗНАЧЕНИЯ(Запасы.Регистратор) = ТИП(Документ.СборкаЗапасов)
	|СГРУППИРОВАТЬ ПО Запасы.ЗаказПокупателя, Запасы.Номенклатура, Запасы.Характеристика, Запасы.Партия, Запасы.СтруктурнаяЕдиница";
КонецФункции


// Все представления карточек и признаки контрагента читаются одним запросом.
Функция РеквизитыКарточекПакета(Документы, РеквизитыШапки)
	Результат = Новый Соответствие;
	Если Документы.Количество() = 0 Тогда Возврат Результат; КонецЕсли;
	ИменаПолей = "Ссылка,Номер,Дата,Проведен,ПометкаУдаления,ВидОперации,Контрагент,Договор,Ответственный,НаименованиеСостояния,НаименованиеКонтрагента,ЮридическоеФизическоеЛицо,ВидКонтрагента,НаименованиеДоговора,НаименованиеОтветственного,АС_ОплатаНаличными";
	ВыбранныеПоля = СтрРазделить(ИменаПолей, ",");
	ДополнительныеПоля = "";
	Для Каждого ИмяРеквизита Из СтрРазделить(РеквизитыШапки, ",") Цикл
		Если ВыбранныеПоля.Найти(ИмяРеквизита) <> Неопределено Тогда Продолжить; КонецЕсли;
		ВыбранныеПоля.Добавить(ИмяРеквизита);
		ИменаПолей = ИменаПолей + "," + ИмяРеквизита;
		ДополнительныеПоля = ДополнительныеПоля + ", Документы." + ИмяРеквизита + " КАК " + ИмяРеквизита;
	КонецЦикла;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ Документы.Ссылка, Документы.Номер, Документы.Дата,
		|Документы.Проведен, Документы.ПометкаУдаления, Документы.ВидОперации,
		|Документы.Контрагент, Документы.Договор, Документы.Ответственный,
		|ЕСТЬNULL(Документы.СостояниеЗаказа.Наименование, """") КАК НаименованиеСостояния,
		|ЕСТЬNULL(Документы.Контрагент.Наименование, """") КАК НаименованиеКонтрагента,
		|ЕСТЬNULL(Документы.Контрагент.ЮридическоеФизическоеЛицо,
		|ЗНАЧЕНИЕ(Перечисление.ЮридическоеФизическоеЛицо.ПустаяСсылка)) КАК ЮридическоеФизическоеЛицо,
		|ЕСТЬNULL(Документы.Контрагент.ВидКонтрагента,
		|ЗНАЧЕНИЕ(Перечисление.ВидыКонтрагентов.ПустаяСсылка)) КАК ВидКонтрагента,
		|ЕСТЬNULL(Документы.Договор.Наименование, """") КАК НаименованиеДоговора,
		|ЕСТЬNULL(Документы.Ответственный.Наименование, """") КАК НаименованиеОтветственного,
		|Документы.АС_ОплатаНаличными" + ДополнительныеПоля + "
		|ИЗ Документ.ЗаказПокупателя КАК Документы ГДЕ Документы.Ссылка В (&Документы)");
	Запрос.УстановитьПараметр("Документы", Документы);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Реквизиты = Новый Структура(ИменаПолей);
		ЗаполнитьЗначенияСвойств(Реквизиты, Выборка);
		Результат.Вставить(Выборка.Ссылка, Реквизиты);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ЗамерыЦенПакета(ДанныеПакета)
	Если ДанныеПакета = Неопределено Тогда Возврат ""; КонецЕсли;
	Цены = ДанныеПакета.КонтекстЦен;
	Подготовка = ДанныеПакета.ЗамерыПодготовки;
	Возврат Символы.ПС + СтрШаблон(
		"Цены v6: копии и минимальные цены: %1 мс (чтение минимумов: %2 мс); подбор цен: %3 мс (обычные: %4 мс; поставочные: %5 мс); арифметика и округление: %6 мс; повторно использовано цен: %7; прочитано правил: %8; пропущено оплаченных: %9.",
		Цены.МсКопий, Цены.МсМинимальныхЦен, Цены.МсПодготовкиЦен, Цены.МсОбычныхЦен, Цены.МсПоставочныхЦен,
		Цены.МсАрифметики, Цены.ПовторовЦен, Цены.ЧтенийПравил, Цены.ПропущеноОплаченных)
		+ Символы.ПС + СтрШаблон("Выборки v6: общих запросов цен: %1; чтение: %2 мс; цен из пакета: %3; штатных вызовов: %4.",
			Цены.ЗапросовПакетныхЦен, Цены.МсПакетныхЦен, Цены.ЦенИзПакета, Цены.ШтатныхВызововЦен)
		+ Символы.ПС + СтрШаблон("Подготовка v6: шапки и представления: %1 мс; строки: %2 мс; номенклатура: %3 мс; оплата: %4 мс; отгрузка: %5 мс.",
			Подготовка.Шапки, Подготовка.Строки, Подготовка.Номенклатура, Подготовка.Оплата, Подготовка.Отгрузка);
КонецФункции


// Имена берутся из текущих метаданных один раз на ручное обновление.
Функция СхемаРеквизитовПакетаЗаказНарядов()
	Схема = Новый Структура("Шапка,Строки", "Ссылка,Дата", Новый Соответствие);
	Для Каждого Реквизит Из Метаданные.Документы.ЗаказПокупателя.Реквизиты Цикл
		Схема.Шапка = Схема.Шапка + "," + Реквизит.Имя;
	КонецЦикла;
	Для Каждого ИмяТаблицы Из СтрРазделить("Запасы,Работы", ",") Цикл
		Имена = Новый Массив;
		Для Каждого Реквизит Из Метаданные.Документы.ЗаказПокупателя.ТабличныеЧасти[ИмяТаблицы].Реквизиты Цикл
			Имена.Добавить(Реквизит.Имя);
		КонецЦикла;
		Схема.Строки.Вставить(ИмяТаблицы, СтрСоединить(Имена, ","));
	КонецЦикла;
	Возврат Схема;
КонецФункции
