&Перед("ПеренестиТаблицуТоваровЧекаВТаблицуФормы")
Процедура АС_СохранитьИсходныйКлючОкругленияПриЗагрузке(Форма, ТаблицаТоварыЧека, ДанныеДляРаспределения)

	Если Не ЗначениеЗаполнено(Форма.ОтложенныйЧек)
		Или ТипЗнч(Форма.ОтложенныйЧек) <> Тип("ДокументСсылка.ЧекККМ") Тогда
		Возврат;
	КонецЕсли;
	// Серии получают новые штатные ключи. Этот временный ключ проходит через
	// штатное копирование и связывает все части с одной исходной строкой.
	Если ТаблицаТоварыЧека.Колонки.Найти("АС_ИсходныйКлючОкругленияРМК") = Неопределено Тогда
		ТипКлюча = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 0, ДопустимыйЗнак.Неотрицательный));
		ТаблицаТоварыЧека.Колонки.Добавить("АС_ИсходныйКлючОкругленияРМК", ТипКлюча);
	КонецЕсли;
	Если ТаблицаТоварыЧека.Колонки.Найти("АС_КоэффициентИсточникаОкругленияРМК") = Неопределено Тогда
		ТипКоэффициента = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 6, ДопустимыйЗнак.Неотрицательный));
		ТаблицаТоварыЧека.Колонки.Добавить("АС_КоэффициентИсточникаОкругленияРМК", ТипКоэффициента);
	КонецЕсли;
	ЕстьКоэффициент = ТаблицаТоварыЧека.Колонки.Найти("КоэффициентУпаковки") <> Неопределено;
	Для Каждого СтрокаЧека Из ТаблицаТоварыЧека Цикл
		СтрокаЧека.АС_ИсходныйКлючОкругленияРМК = СтрокаЧека.КлючСвязиЧекаПродажи + 1;
		СтрокаЧека.АС_КоэффициентИсточникаОкругленияРМК = 1;
		Если ЕстьКоэффициент И СтрокаЧека.КоэффициентУпаковки > 0 Тогда
			СтрокаЧека.АС_КоэффициентИсточникаОкругленияРМК = СтрокаЧека.КоэффициентУпаковки;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&После("ЗаполнитьРозничныйВидЦены")
Процедура АС_ВыбратьВидЦенРежимаОплаты(Форма)

	Если Форма.ЭтоЧекКоррекции
		Или Не ОбщегоНазначенияРМК.ЭтоВидОперацииПродажа(Форма.Объект.ВидОперации) Тогда
		Возврат;
	КонецЕсли;

	ВидЦен = АС_ЦенообразованиеСервер.ВидЦенРежимаОплаты(Форма.Объект.АС_ОплатаНаличными);
	Если ЗначениеЗаполнено(ВидЦен) Тогда
		Форма.РозничныйВидЦены = ВидЦен;
		Форма.Объект.ЦенаВключаетНДС = ВидЦен.ЦенаВключаетНДС;
		Форма.ВалютаДокумента = ВидЦен.ВалютаЦены;
	КонецЕсли;
	Форма.МаксимальныйПроцентРучнойСкидки = ?(Форма.Объект.АС_ОплатаНаличными, 20, 23);

КонецПроцедуры

&После("ЗаполнитьДанныеИзОтложенногоЧека")
Процедура АС_ПрочитатьРежимОтложенногоЧека(Форма, ОтложенныйЧек, ДополнительныеИсходящиеДанные = Неопределено)

	Если ТипЗнч(ОтложенныйЧек) <> Тип("ДокументСсылка.ЧекККМ") Тогда
		Возврат;
	КонецЕсли;

	Форма.Объект.АС_ОплатаНаличными = ОтложенныйЧек.АС_ОплатаНаличными;
	Если ЗначениеЗаполнено(ОтложенныйЧек.ВидЦен) Тогда
		Форма.РозничныйВидЦены = ОтложенныйЧек.ВидЦен;
		Форма.ВалютаДокумента = ОтложенныйЧек.ВалютаДокумента;
		Форма.Объект.ЦенаВключаетНДС = ОтложенныйЧек.СуммаВключаетНДС;
	КонецЕсли;
	АС_ЦенообразованиеСервер.ОбновитьПараметрыЦенКаталогаРМК(Форма);
	Форма.МаксимальныйПроцентРучнойСкидки = ?(Форма.Объект.АС_ОплатаНаличными, 20, 23);

КонецПроцедуры

&Вместо("ЗаписатьЧекККМПередПробитием")
Процедура АС_ПроверитьСкидкиПередПробитием(Форма, Отказ, ТекстОшибки, СистемаНалогообложения)

	Если Не ОбщегоНазначенияРМК.ЭтоВидОперацииПродажа(Форма.Объект.ВидОперации) Тогда
		ПродолжитьВызов(Форма, Отказ, ТекстОшибки, СистемаНалогообложения);
		Возврат;
	КонецЕсли;

	Предел = ?(Форма.Объект.АС_ОплатаНаличными, 20, 23);
	Ошибка = АС_ЦенообразованиеСервер.ОшибкаСкидокРежимаОплаты(Форма.Объект.Товары, Предел, Истина);
	Если Не ПустаяСтрока(Ошибка) Тогда
		Отказ = Истина;
		ТекстОшибки = Ошибка;
		Возврат;
	КонецЕсли;
	ПродолжитьВызов(Форма, Отказ, ТекстОшибки, СистемаНалогообложения);

КонецПроцедуры

&Вместо("СоздатьОтложенныйЧек")
Процедура АС_ПроверитьСкидкиПередОтложением(Форма, ЧекСоздан)

	Если Не ОбщегоНазначенияРМК.ЭтоВидОперацииПродажа(Форма.Объект.ВидОперации) Тогда
		ПродолжитьВызов(Форма, ЧекСоздан);
		Возврат;
	КонецЕсли;

	Предел = ?(Форма.Объект.АС_ОплатаНаличными, 20, 23);
	Ошибка = АС_ЦенообразованиеСервер.ОшибкаСкидокРежимаОплаты(Форма.Объект.Товары, Предел, Истина);
	Если Не ПустаяСтрока(Ошибка) Тогда
		ЧекСоздан = Ложь;
		ОбщегоНазначения.СообщитьПользователю(Ошибка);
		Возврат;
	КонецЕсли;
	ПродолжитьВызов(Форма, ЧекСоздан);

КонецПроцедуры

&После("НастроитьДинамическийСписокТоваров")
Процедура АС_НастроитьЦеныИсключенийКаталога(Форма)

	АС_ЦенообразованиеСервер.ОбновитьПараметрыЦенКаталогаРМК(Форма);

КонецПроцедуры
