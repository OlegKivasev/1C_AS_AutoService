&НаСервереБезКонтекста
Функция АС_ПолучитьФактОплатыЗаказа(Заказ)

	Результат = Новый Структура("СуммаОплаты,СуммаАванса", 0, 0);

	Если Не ЗначениеЗаполнено(Заказ) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|    ЕСТЬNULL(ФактОплаты.СуммаОплаты, 0) КАК СуммаОплаты,
	|    ЕСТЬNULL(ФактОплаты.СуммаАванса, 0) КАК СуммаАванса
	|ИЗ
	|    РегистрСведений.ФактОплатыЗаказов КАК ФактОплаты
	|ГДЕ
	|    ФактОплаты.СчетНаОплату = &Заказ";

	Запрос.УстановитьПараметр("Заказ", Заказ);
	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Результат.СуммаОплаты = Выборка.СуммаОплаты;
		Результат.СуммаАванса = Выборка.СуммаАванса;
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция АС_ПолучитьНастроенныйВидЦенБезналичногоРасчета()

	ОсновнойВидЦен = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
		"АС_ВидыЦен",
		"ОсновнойВидЦенБезналичногоРасчета");

	Если ТипЗнч(ОсновнойВидЦен) = Тип("СправочникСсылка.ВидыЦен")
		И ЗначениеЗаполнено(ОсновнойВидЦен) Тогда
		Возврат ОсновнойВидЦен;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

