&НаСервереБезКонтекста
Функция АС_ПолучитьVINДляПанелиНаСервере(Контрагент, Договор)

	// Это отображение актуальной карточки, а не реквизит документа.
	Результат = "";
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Результат;
	КонецЕсли;

	РеквизитыКонтрагента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Контрагент, "ВидКонтрагента, АС_VINАвтомобиля");
	Если РеквизитыКонтрагента.ВидКонтрагента = Перечисления.ВидыКонтрагентов.ФизическоеЛицо Тогда
		Результат = РеквизитыКонтрагента.АС_VINАвтомобиля;
	ИначеЕсли РеквизитыКонтрагента.ВидКонтрагента = Перечисления.ВидыКонтрагентов.ЮридическоеЛицо Тогда
		Если Не ЗначениеЗаполнено(Договор) Тогда
			Возврат Результат;
		КонецЕсли;
		РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			Договор, "Владелец, АС_VINАвтомобиля");
		Если РеквизитыДоговора.Владелец = Контрагент Тогда
			Результат = РеквизитыДоговора.АС_VINАвтомобиля;
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура АС_ЗащититьВводПередОповещением(ИмяСобытия, Параметр, Источник)

	АС_БезопасноеОбновлениеКлиент.ЗащититьРедактор(ЭтотОбъект);
	Если Источник = "ПодключаемоеОборудование" Тогда
		АС_БезопасноеОбновлениеКлиент.ОтметитьСканирование(АС_СостояниеФоновогоОбновления);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&Вместо("ОбработкаОповещения")
Процедура АС_ОтложитьШтатноеОповещениеПриВводе(ИмяСобытия, Параметр, Источник)

	АС_ЗащититьВводПередОповещением(ИмяСобытия, Параметр, Источник);
	МеняетсяСостояние = ИмяСобытия = "ИзменениеСостояния_ЗаказПокупателя";
	Если МеняетсяСостояние Тогда
		Если ТипЗнч(Параметр) = Тип("Массив") Тогда
			МеняетсяСостояние = Параметр.Найти(Объект.Ссылка) <> Неопределено;
		Иначе
			МеняетсяСостояние = ТипЗнч(Параметр) = Тип("ДокументСсылка.ЗаказПокупателя")
				И Параметр = Объект.Ссылка;
		КонецЕсли;
	КонецЕсли;
	Если Источник <> "ПодключаемоеОборудование"
		И (Лев(ИмяСобытия, 7) = "Запись_" Или МеняетсяСостояние) Тогда
		// Прочитать() нельзя выполнять поверх несохранённых пользовательских данных.
		Если (МеняетсяСостояние И Модифицированность)
			Или Не АС_БезопасноеОбновлениеКлиент.МожноОбновить(ЭтотОбъект, АС_СостояниеФоновогоОбновления) Тогда
			// Для этой формы массив ссылок равнозначен уведомлению о текущем заказе.
			ПараметрОжидания = ?(МеняетсяСостояние, Объект.Ссылка, Параметр);
			АС_БезопасноеОбновлениеКлиент.СохранитьОтложенноеОповещение(
				АС_СостояниеФоновогоОбновления, ИмяСобытия, ПараметрОжидания, Источник);
			АС_ЗапланироватьФоновоеОбновлениеЗаказа("ШтатныеОповещения");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	ПродолжитьВызов(ИмяСобытия, Параметр, Источник);
	АС_ОбработкаОповещенияПосле(ИмяСобытия, Параметр, Источник);

КонецПроцедуры

&НаКлиенте
Процедура АС_ПрименитьОтложенныеОповещенияДокумента()

	Оповещения = АС_СостояниеФоновогоОбновления.Оповещения;
	АС_СостояниеФоновогоОбновления.Оповещения = Новый Массив;
	Для Каждого Данные Из Оповещения Цикл
		// Перехватчик повторно проверит ввод и модифицированность. Оборудования
		// в этой очереди нет; параметры штатных уведомлений сохранены.
		ОбработкаОповещения(Данные.ИмяСобытия, Данные.Параметр, Данные.Источник);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура АС_ДобавитьРежимОплаты()

	АС_ДобавитьАльтернативныйИтог();

	Группа = Элементы.Добавить("АС_ГруппаРежимОплаты", Тип("ГруппаФормы"), Элементы.ШапкаПраво);
	Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Группа.Отображение = ОтображениеОбычнойГруппы.Нет;
	Группа.ОтображатьЗаголовок = Ложь;
	Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
	Поле = Элементы.Добавить("АС_ОплатаНаличными", Тип("ПолеФормы"), Группа);
	Поле.Вид = ВидПоляФормы.ПолеФлажка;
	Поле.ПутьКДанным = "Объект.АС_ОплатаНаличными";
	Поле.Заголовок = "Оплата наличными";
	Поле.УстановитьДействие("ПриИзменении", "АС_ОплатаНаличнымиПриИзменении");
	Команда = Команды.Добавить("АС_НастройкиРежимаОплаты");
	Команда.Действие = "АС_ОткрытьНастройкиРежимаОплаты";
	Команда.Заголовок = "...";
	Кнопка = Элементы.Добавить("АС_НастройкиРежимаОплаты", Тип("КнопкаФормы"), Группа);
	Кнопка.ИмяКоманды = Команда.Имя;
	Кнопка.Видимость = Пользователи.ЭтоПолноправныйПользователь();

КонецПроцедуры

