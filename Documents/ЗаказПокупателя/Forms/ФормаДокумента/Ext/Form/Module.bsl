Процедура АС_УстановитьВидЦенСтрокиЗапаса(СтрокаТабличнойЧасти)

	Если СтрокаТабличнойЧасти = Неопределено Тогда
		СтрокаТабличнойЧасти = Элементы.Запасы.ТекущиеДанные;
	КонецЕсли;

	Если СтрокаТабличнойЧасти = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтрокаТабличнойЧасти.АС_ПримененныйВидЦен = АС_ПолучитьВидЦенДляРасчета();

КонецПроцедуры

&НаКлиенте
Процедура АС_УстановитьВидЦенСтрокЗапасов(ВидЦен = Неопределено)

	Если ВидЦен = Неопределено Тогда
		ВидЦен = АС_ПолучитьВидЦенДляРасчета();
	КонецЕсли;

	Для Каждого СтрокаТовара Из Объект.Запасы Цикл
		СтрокаТовара.АС_ПримененныйВидЦен = ВидЦен;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура АС_НастроитьОграничениеВыбораВидаЦен()

	Если АС_ВидыЦенДляВыбора = Неопределено Тогда
		АС_ИнициализироватьВыборВидаЦен();
	КонецЕсли;

	Если ЗапасыИзменениеСтрокДействие <> ПредопределенноеЗначение(
			"Перечисление.ДействияГрупповогоИзмененияСтрок.УстановитьЦеныПоВиду") Тогда
		Возврат;
	КонецЕсли;

	Если АС_ВидыЦенДляВыбора = Неопределено Тогда
		АС_ВидыЦенДляВыбора = АС_ПолучитьРазрешенныеВидыЦен();
	КонецЕсли;

	АС_ПараметрыВыбораВидаЦен = Новый Массив;
	АС_ПараметрыВыбораВидаЦен.Добавить(Новый ПараметрВыбора("Отбор.Ссылка", АС_ВидыЦенДляВыбора));
	Элементы.ЗапасыИзменениеСтрокЗначение.ПараметрыВыбора = Новый ФиксированныйМассив(АС_ПараметрыВыбораВидаЦен);

КонецПроцедуры

&НаКлиенте
Функция АС_РазрешитьИспользованиеВидаЦен()

	Если АС_ВидыЦенДляВыбора = Неопределено Тогда
		АС_ИнициализироватьВыборВидаЦен();
	КонецЕсли;

	Если ЗапасыИзменениеСтрокДействие <> ПредопределенноеЗначение(
			"Перечисление.ДействияГрупповогоИзмененияСтрок.УстановитьЦеныПоВиду")
		Или Не ЗначениеЗаполнено(ЗапасыИзменениеСтрокЗначение) Тогда
		Возврат Истина;
	КонецЕсли;

	Для Каждого РазрешенныйВидЦен Из АС_ВидыЦенДляВыбора Цикл
		Если РазрешенныйВидЦен = ЗапасыИзменениеСтрокЗначение Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Сообщить("Вид цены «" + Строка(ЗапасыИзменениеСтрокЗначение)
		+ "» недоступен согласно профилю доступа.");

	Возврат Ложь;

КонецФункции

