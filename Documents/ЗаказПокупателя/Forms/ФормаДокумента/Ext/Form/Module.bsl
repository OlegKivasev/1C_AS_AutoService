&НаСервереБезКонтекста
Функция АС_ПолучитьВидыЦенДляВыбораБезЗакупочных()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|    ВидыЦен.Ссылка,
	|    ВидыЦен.Наименование
	|ИЗ
	|    Справочник.ВидыЦен КАК ВидыЦен
	|ГДЕ
	|    НЕ ВидыЦен.ПометкаУдаления";

	Выборка = Запрос.Выполнить().Выбрать();
	ВидыЦен = Новый Массив;

	Пока Выборка.Следующий() Цикл
		Если СтрНайти(ВРег(Выборка.Наименование), "ЗАКУПОЧ") = 0 Тогда
			ВидыЦен.Добавить(Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;

	Возврат Новый ФиксированныйМассив(ВидыЦен);

КонецФункции

&НаСервереБезКонтекста
Функция АС_ЭтоЗакупочнаяЦена(ВидЦен)

	Если ТипЗнч(ВидЦен) <> Тип("СправочникСсылка.ВидыЦен")
		Или Не ЗначениеЗаполнено(ВидЦен) Тогда
		Возврат Ложь;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|    ВидыЦен.Наименование
	|ИЗ
	|    Справочник.ВидыЦен КАК ВидыЦен
	|ГДЕ
	|    ВидыЦен.Ссылка = &ВидЦен";
	Запрос.УстановитьПараметр("ВидЦен", ВидЦен);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат СтрНайти(ВРег(Выборка.Наименование), "ЗАКУПОЧ") > 0;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

&НаСервереБезКонтекста
Функция АС_ПолучитьНоменклатуруСОстатком(ОрганизацияДокумента, Склад, ТекущийЗаказ)

	ДоступнаяНоменклатура = Новый Массив;
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|    Номенклатура.Ссылка КАК Номенклатура
	|ИЗ
	|    Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|    НЕ Номенклатура.ПометкаУдаления
	|    И Номенклатура.ТипНоменклатуры <> ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)";

	Если ЗначениеЗаполнено(ОрганизацияДокумента) Тогда
		Организация = Константы.УчетПоКомпании.Компания(ОрганизацияДокумента);
		Если ПолучитьФункциональнуюОпцию("ПередачаТоваровМеждуОрганизациями") Тогда
			ОрганизацииОстатков = ИнтеркампаниСервер.ОрганизацииОстатков(Организация);
		Иначе
			ОрганизацииОстатков = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Организация);
		КонецЕсли;

		Если Не ЗначениеЗаполнено(ТекущийЗаказ) Тогда
			ТекущийЗаказ = ПредопределенноеЗначение("Документ.ЗаказПокупателя.ПустаяСсылка");
		КонецЕсли;

		ТекстУсловияСклада = "";
		Если ЗначениеЗаполнено(Склад) Тогда
			ТекстУсловияСклада =
			"
			|                И СтруктурнаяЕдиница = &Склад";
		КонецЕсли;

		ТекстЗапроса = ТекстЗапроса
			+ "
			|ОБЪЕДИНИТЬ
			|
			|ВЫБРАТЬ
			|    ЗапасыОстатки.Номенклатура
			|ИЗ
			|    РегистрНакопления.Запасы.Остатки(
			|            ,
			|            Организация В (&ОрганизацииОстатков)
			|                И (ЗаказПокупателя = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
			|                    ИЛИ ЗаказПокупателя = &ТекущийЗаказ)
			|                И ТИПЗНАЧЕНИЯ(СтруктурнаяЕдиница) = ТИП(Справочник.СтруктурныеЕдиницы)"
			+ ТекстУсловияСклада
			+ ") КАК ЗапасыОстатки
			|        ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК НоменклатураСправочника
			|        ПО ЗапасыОстатки.Номенклатура = НоменклатураСправочника.Ссылка
			|            И НЕ НоменклатураСправочника.ПометкаУдаления
			|            И НоменклатураСправочника.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)
			|
			|СГРУППИРОВАТЬ ПО
			|    ЗапасыОстатки.Номенклатура
			|
			|ИМЕЮЩИЕ
			|    СУММА(ЗапасыОстатки.КоличествоОстаток) > 0";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Если ЗначениеЗаполнено(ОрганизацияДокумента) Тогда
		Запрос.УстановитьПараметр("ОрганизацииОстатков", ОрганизацииОстатков);
		Запрос.УстановитьПараметр("ТекущийЗаказ", ТекущийЗаказ);
		Если ЗначениеЗаполнено(Склад) Тогда
			Запрос.УстановитьПараметр("Склад", Склад);
		КонецЕсли;
	КонецЕсли;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДоступнаяНоменклатура.Добавить(Выборка.Номенклатура);
	КонецЦикла;

	Возврат Новый ФиксированныйМассив(ДоступнаяНоменклатура);

КонецФункции

&НаСервере
Процедура АС_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.Ответственный = Неопределено;
	КонецЕсли;

	ПолеОтветственного = Элементы.Добавить("АС_Ответственный", Тип("ПолеФормы"), Элементы.ШапкаПраво);
	ПолеОтветственного.Вид = ВидПоляФормы.ПолеВвода;
	ПолеОтветственного.ПутьКДанным = "Объект.Ответственный";
	ПолеОтветственного.Заголовок = "Ответственный";
	ПолеОтветственного.Ширина = 29;
	Элементы.Переместить(ПолеОтветственного, Элементы.ШапкаПраво, Элементы.ГруппаРеквизитыПечатиЦены);

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("АС_ЗапасыДоступноСУчетомЗаказов");
	ОформляемоеПоле.Использование = Истина;

	ОтборПоОстатку = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборПоОстатку.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Запасы.АС_ДоступноСУчетомЗаказов");
	ОтборПоОстатку.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборПоОстатку.ПравоеЗначение = 0;
	ОтборПоОстатку.Использование = Истина;

	ОтборПоТипу = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборПоТипу.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Запасы.ТипНоменклатурыЗапас");
	ОтборПоТипу.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборПоТипу.ПравоеЗначение = Истина;
	ОтборПоТипу.Использование = Истина;

	ЦветТекста = ЭлементОформления.Оформление.Элементы.Найти("ЦветТекста");
	ЦветТекста.Значение = WebЦвета.Красный;
	ЦветТекста.Использование = Истина;

КонецПроцедуры

