КонецПроцедуры

&НаКлиенте
Процедура АС_ИнициализироватьЦеныРаботПриОткрытии()

	Для Каждого ИмяТаблицы Из СтрРазделить("Запасы,Работы", ",") Цикл
		Для Каждого СтрокаРаботы Из Объект[ИмяТаблицы] Цикл
			Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
				АС_РежимОплатыКлиентСервер.ЗапомнитьИсторическуюЦенуРаботы(СтрокаРаботы);
			Иначе
				Если АС_РежимОплатыКлиентСервер.УстановитьЦенуРаботы(СтрокаРаботы, Объект.АС_ОплатаНаличными) Тогда
					РассчитатьСуммуВСтрокеТабличнойЧасти(ИмяТаблицы, СтрокаРаботы);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура АС_ОплатаНаличнымиПриИзменении(Элемент)

	Если ТолькоПросмотр Тогда
		Объект.АС_ОплатаНаличными = АС_ПоследнийНаличныйРежим;
		Возврат;
	КонецЕсли;
	ВидЦен = АС_ВидЦенОплаты();
	Если Не ЗначениеЗаполнено(ВидЦен) Или Не АС_ВидЦенРазрешен(ВидЦен) Тогда
		Объект.АС_ОплатаНаличными = АС_ПоследнийНаличныйРежим;
		Сообщить("Выберите в настройках доступные виды цен для наличных и карты.");
		Возврат;
	КонецЕсли;
	// При отгрузке стоимость уже вошла в движения: переключать такой документ нельзя.
	Для Каждого СтрокаТовара Из Объект.Запасы Цикл
		Если СтрокаТовара.Отгружено > 0 Тогда
			Объект.АС_ОплатаНаличными = АС_ПоследнийНаличныйРежим;
			Сообщить("Нельзя менять режим оплаты заказа с отгруженными товарами.");
			Возврат;
		КонецЕсли;
	КонецЦикла;
	ПодготовленныеЦены = АС_ПодготовитьЦеныРежимаОплаты(ВидЦен);
	Если Не ПустаяСтрока(ПодготовленныеЦены.Ошибка) Тогда
		Объект.АС_ОплатаНаличными = АС_ПоследнийНаличныйРежим;
		Сообщить(ПодготовленныеЦены.Ошибка);
		Возврат;
	КонецЕсли;
	АС_ГлубинаИзмененияСтоимости = АС_ГлубинаИзмененияСтоимости + 1;
	Попытка
		// Восстанавливаем старый результат даже при переходе в режим без округления.
		АС_ВосстановитьЦеныДоОкругления();
		Объект.СуммаВключаетНДС = ПодготовленныеЦены.СуммаВключаетНДС;
		Объект.ВидЦен = ВидЦен;
		АС_СинхронизироватьВидЦенДокумента();
		Для Каждого ИмяТаблицы Из СтрРазделить("Запасы,Работы", ",") Цикл
			ИндексСтроки = -1;
			Для Каждого СтрокаТовара Из Объект[ИмяТаблицы] Цикл
				ИндексСтроки = ИндексСтроки + 1;
				Если ИмяТаблицы = "Запасы" И СтрокаТовара.ТипНоменклатурыЗапас Тогда
					Если Не СтрокаТовара.ЭтоРазделитель И СтрокаТовара.Отменен = 0 Тогда
						Если ПодготовленныеЦены.Цены[ИндексСтроки] <> Неопределено Тогда
							СтрокаТовара.Цена = ПодготовленныеЦены.Цены[ИндексСтроки];
							СтрокаТовара.АС_ПримененныйВидЦен = ВидЦен;
							СтрокаТовара.АС_ЦенаПоВидуЦенКонтрагента = АС_ЭтоВидЦенКонтрагента(ВидЦен);
						КонецЕсли;
					КонецЕсли;
				Иначе
					ИзмененаЦена = АС_РежимОплатыКлиентСервер.УстановитьЦенуРаботы(
						СтрокаТовара, Объект.АС_ОплатаНаличными, Ложь, Истина);
				КонецЕсли;
				АС_ОграничитьРучнуюСкидкуВСтроке(ИмяТаблицы, СтрокаТовара, Ложь, Ложь);
				ПараметрыСтроки = Новый Структура(
					?(СтрокаТовара.ПроцентСкидкиНаценки = 0, "РассчитатьПроцентСкидки", "РассчитатьСуммуСкидки"), Истина);
				РассчитатьСуммуВСтрокеТабличнойЧасти(ИмяТаблицы, СтрокаТовара, ПараметрыСтроки);
			КонецЦикла;
		КонецЦикла;
		АС_ПоследнийНаличныйРежим = Объект.АС_ОплатаНаличными;
		АС_ПоследнийНеокругленныйИтог = Неопределено;
		Модифицированность = Истина;
	Исключение
		АС_ГлубинаИзмененияСтоимости = АС_ГлубинаИзмененияСтоимости - 1;
		ВызватьИсключение;
	КонецПопытки;
	АС_ГлубинаИзмененияСтоимости = АС_ГлубинаИзмененияСтоимости - 1;
	АС_ОбновитьИтогиПослеИзмененияСтоимости();

КонецПроцедуры

&НаКлиенте
Процедура АС_ПодготовитьЦенуРаботыПриРасчете(ИмяТаблицы, СтрокаРаботы)

	Если АС_ФормаГотоваКОкруглению <> Истина Тогда
		Возврат;
	КонецЕсли;
	Если СтрокаРаботы = Неопределено Тогда
		Если Элементы.Найти(ИмяТаблицы) = Неопределено Тогда
			Возврат;
		КонецЕсли;
		СтрокаРаботы = Элементы[ИмяТаблицы].ТекущиеДанные;
	КонецЕсли;
	ИзмененаЦена = АС_РежимОплатыКлиентСервер.УстановитьЦенуРаботы(
		СтрокаРаботы, Объект.АС_ОплатаНаличными);

КонецПроцедуры

&НаКлиенте
&Перед("ЗапасыЦенаПриИзменении")
Процедура АС_УчестьВведеннуюЦенуУслуги(Элемент)

	ИзмененаЦена = АС_РежимОплатыКлиентСервер.УстановитьЦенуРаботы(
		Элементы.Запасы.ТекущиеДанные, Объект.АС_ОплатаНаличными, Истина);

КонецПроцедуры


&НаКлиенте
Процедура АС_ЗафиксироватьЦенуИзСуммы(ИмяТаблицы, СтрокаРаботы, ПараметрыРасчета)

	РассчитатьЦену = Ложь;
	Если ПараметрыРасчета = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Не ПараметрыРасчета.Свойство("РассчитатьЦену", РассчитатьЦену) Или Не РассчитатьЦену Тогда
		Возврат;
	КонецЕсли;
	Если СтрокаРаботы = Неопределено Тогда
		Если Элементы.Найти(ИмяТаблицы) = Неопределено Тогда
			Возврат;
		КонецЕсли;
		СтрокаРаботы = Элементы[ИмяТаблицы].ТекущиеДанные;
	КонецЕсли;
	АС_РежимОплатыКлиентСервер.ЗапомнитьРассчитаннуюЦенуРаботы(СтрокаРаботы, Объект.АС_ОплатаНаличными);

КонецПроцедуры

&НаКлиенте
Процедура АС_УчестьРежимСкопированныхРабот(ИмяТаблицы, КоличествоВставленных)

	Если КоличествоВставленных <= 0 Или (ИмяТаблицы <> "Запасы" И ИмяТаблицы <> "Работы") Тогда
		Возврат;
	КонецЕсли;
	Таблица = Объект[ИмяТаблицы];
	Для Индекс = Макс(0, Таблица.Количество() - КоличествоВставленных) По Таблица.Количество() - 1 Цикл
		СтрокаРаботы = Таблица[Индекс];
		Если АС_РежимОплатыКлиентСервер.УстановитьЦенуРаботы(
			СтрокаРаботы, Объект.АС_ОплатаНаличными, Ложь, Истина) Тогда
			РассчитатьСуммуВСтрокеТабличнойЧасти(ИмяТаблицы, СтрокаРаботы,
				Новый Структура("РассчитатьСуммуСкидки", Истина));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция АС_ПодготовитьЦеныРежимаОплаты(ВидЦен)

	Результат = Новый Структура("Ошибка,Цены,СуммаВключаетНДС", "", Новый Массив, ВидЦен.ЦенаВключаетНДС);
	Для Каждого СтрокаТовара Из Объект.Запасы Цикл
		Цена = Неопределено;
		Если Не СтрокаТовара.ЭтоРазделитель И СтрокаТовара.Отменен = 0
			И СтрокаТовара.ТипНоменклатурыЗапас
			И ТипЗнч(СтрокаТовара.Номенклатура) = Тип("СправочникСсылка.Номенклатура")
			И ЗначениеЗаполнено(СтрокаТовара.Номенклатура) Тогда
			Если СтрокаТовара.АС_ЦенаИзЗаказаПоставщика И СтрокаТовара.АС_ИсходнаяЦенаЗаказаПоставщика > 0 Тогда
				Попытка
					Цена = АС_РассчитатьЦенуПоЦенеПоставщикаНаСервере(
						СтрокаТовара.АС_ИсходнаяЦенаЗаказаПоставщика, СтрокаТовара.Номенклатура,
						ВидЦен, СтрокаТовара.Характеристика);
				Исключение
					Результат.Ошибка = СтрШаблон("Не удалось пересчитать цену %1. Режим оплаты не изменён. %2",
						СтрокаТовара.Номенклатура, ОписаниеОшибки());
					Возврат Результат;
				КонецПопытки;
			Иначе
				Данные = Новый Структура("Номенклатура,Характеристика,ДатаОбработки,ВалютаДокумента,"
					+ "СуммаВключаетНДС,Коэффициент,СтавкаНДС,ВидЦен",
					СтрокаТовара.Номенклатура, СтрокаТовара.Характеристика,
					?(ЗначениеЗаполнено(Объект.Ссылка), ТекущаяДатаСеанса(), Объект.Дата),
					Объект.ВалютаДокумента, Результат.СуммаВключаетНДС, 1, СтрокаТовара.СтавкаНДС, ВидЦен);
				ЦенообразованиеКлиентСервер.ДополнитьСтруктуруДанныхНоменклатурыПолямиЦенообразования(
					Объект, СтрокаТовара, Данные);
				Данные.Вставить("СуммаВключаетНДС", Результат.СуммаВключаетНДС);
				Данные.Вставить("ВидЦен", ВидЦен);
				Цена = АС_ПолучитьЦенуПоВидуЦен(Данные);
			КонецЕсли;
			Если Цена <= 0 Тогда
				Результат.Ошибка = СтрШаблон("Для %1 не найдена цена выбранного вида цен. Режим оплаты не изменён.", СтрокаТовара.Номенклатура);
				Возврат Результат;
			КонецЕсли;
		КонецЕсли;
		Результат.Цены.Добавить(Цена);
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервере
Процедура АС_ДобавитьАльтернативныйИтог()

	ПолеИтога = Элементы.ИтогВсего;
	Группа = Элементы.Вставить("АС_ИтогиРежимовОплаты", Тип("ГруппаФормы"), ПолеИтога.Родитель, ПолеИтога);
	Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	Группа.ОтображатьЗаголовок = Ложь;
	Элементы.Переместить(ПолеИтога, Группа);
	Надпись = Элементы.Добавить("АС_АльтернативнаяОплата", Тип("ДекорацияФормы"), Группа);
	Надпись.Вид = ВидДекорацииФормы.Надпись;
	Надпись.Заголовок = "";
	Надпись.Видимость = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура АС_ЗапланироватьАльтернативныйИтог()

	Если АС_ФормаГотоваКОкруглению <> Истина
		Или Элементы.Найти("АС_АльтернативнаяОплата") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если АС_ОбновлениеАльтернативыНазначено = Истина Тогда
		Возврат;
	КонецЕсли;
	АС_ОбновлениеАльтернативыНазначено = Истина;
	Элементы.АС_АльтернативнаяОплата.Заголовок = ?(Объект.АС_ОплатаНаличными, "Картой: расчёт…", "Наличными: расчёт…");
	Элементы.АС_АльтернативнаяОплата.Видимость = Истина;
	ПодключитьОбработчикОжидания("АС_ОбновитьАльтернативныйИтог", 0.2, Истина);

КонецПроцедуры

&НаКлиенте
Процедура АС_ОбновитьАльтернативныйИтог() Экспорт

	АС_ОбновлениеАльтернативыНазначено = Ложь;
	Если (АС_ГлубинаИзмененияСтоимости <> Неопределено И АС_ГлубинаИзмененияСтоимости > 0)
		Или АС_ПересчитываетсяОкруглениеЦен = Истина Тогда
		АС_ЗапланироватьАльтернативныйИтог();
		Возврат;
	КонецЕсли;
	Наличные = Не Объект.АС_ОплатаНаличными;
	Префикс = ?(Наличные, "Наличными: ", "Картой: ");
	Попытка
		Настройки = АС_НастройкиОплаты();
		ВидЦен = ?(Наличные, Настройки.НаличныйВидЦен, Настройки.БезналичныйВидЦен);
		Если Не АС_ВидЦенРазрешен(ВидЦен) Тогда
			Элементы.АС_АльтернативнаяОплата.Заголовок = Префикс + "вид цен недоступен";
			Возврат;
		КонецЕсли;
		Данные = АС_ПодготовитьПрогнозОплаты(ВидЦен, Наличные);
		Если Не ПустаяСтрока(Данные.Ошибка) Тогда
			Элементы.АС_АльтернативнаяОплата.Заголовок = Префикс + Данные.Ошибка;
			Возврат;
		КонецЕсли;
		Данные.Вставить("ОграничиватьСкидки", АС_ОграничиватьРучныеСкидки);
		Данные.Вставить("ПределСкидки", ?(Наличные, Настройки.СкидкаНаличные, Настройки.СкидкаКарта));
		Данные.Вставить("ИспользоватьМинимальныеЦены", КэшЗначений.ИспользоватьМинимальныеЦены);
		Итог = ТабличныеЧастиУНФКлиент.АС_АльтернативныйИтогЗаказа(Данные);
		Элементы.АС_АльтернативнаяОплата.Заголовок = ТабличныеЧастиУНФКлиент.АС_ТекстАльтернативнойОплаты(
			Наличные, Итог, АС_СуммаОплачено);
	Исключение
		Элементы.АС_АльтернативнаяОплата.Заголовок = Префикс + "расчёт недоступен";
	КонецПопытки;

КонецПроцедуры

&НаСервере
Функция АС_ПодготовитьПрогнозОплаты(ВидЦен, Наличные)

	Цены = АС_ПодготовитьЦеныРежимаОплаты(ВидЦен);
	Если Не ПустаяСтрока(Цены.Ошибка) Тогда
		Возврат Новый Структура("Ошибка", "для части товаров не задана цена");
	КонецЕсли;
	КопияОбъекта = Новый Структура("СуммаВключаетНДС,АС_ОплатаНаличными",
		Объект.СуммаВключаетНДС, Наличные);
	Для Каждого ИмяТаблицы Из СтрРазделить("Запасы,Работы", ",") Цикл
		КопияОбъекта.Вставить(ИмяТаблицы, АС_ЦенообразованиеСервер.КопииСтрокДляРежимаОплаты(
			Объект[ИмяТаблицы], Метаданные.Документы.ЗаказПокупателя.ТабличныеЧасти[ИмяТаблицы].Реквизиты,
			АС_ДополнительныеКолонкиПрогноза(ИмяТаблицы)));
	КонецЦикла;
	ДопускиНоменклатуры = Новый Соответствие;
	Для Индекс = 0 По КопияОбъекта.Запасы.Количество() - 1 Цикл
		СтрокаТовара = КопияОбъекта.Запасы[Индекс];
		СтрокаТовара.Вставить("АС_ЦенаДляПрогноза", Цены.Цены[Индекс]);
		СтрокаТовара.Вставить("АС_ВходитВИтогПрогноза", Не СтрокаТовара.ЭтоРазделитель И СтрокаТовара.НомерВариантаКП = ТекущийВариантКП);
		СтрокаТовара.Вставить("АС_ВходитВОкруглениеПрогноза", СтрокаТовара.НомерВариантаКП = ТекущийВариантКП);
		Разрешено = Ложь;
		Если СтрокаТовара.ТипНоменклатурыЗапас И ЗначениеЗаполнено(СтрокаТовара.Номенклатура)
			И ТипЗнч(СтрокаТовара.Номенклатура) = Тип("СправочникСсылка.Номенклатура") Тогда
			Разрешено = ДопускиНоменклатуры.Получить(СтрокаТовара.Номенклатура);
			Если Разрешено = Неопределено Тогда
				Разрешено = АС_НоменклатураДопускаетОкруглениеЦены(СтрокаТовара.Номенклатура);
				ДопускиНоменклатуры.Вставить(СтрокаТовара.Номенклатура, Разрешено);
			КонецЕсли;
		КонецЕсли;
		СтрокаТовара.Вставить("АС_НоменклатураРазрешаетОкругление", Разрешено);
	КонецЦикла;
	Результат = Новый Структура("Ошибка,Объект,НоваяСуммаВключаетНДС,ПоследнийНеокругленныйИтог",
		"", КопияОбъекта, Цены.СуммаВключаетНДС, Неопределено);
	Результат.Вставить("Округлять", Наличные );
	Результат.Вставить("СтоимостьДоставки", СтоимостьДоставкиСНДС);
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция АС_ДополнительныеКолонкиПрогноза(ИмяТаблицы)

	Если ИмяТаблицы = "Запасы" Тогда
		Возврат "АС_ДоступноСУчетомЗаказов,АС_ЕстьСрокВозврата,АС_КоличествоДнейДоВозврата,АС_ПредставлениеДнейДоВозврата,ВРезерве,"
			+ "ВесЕдиницыТовара,ДатаПоступления,ЕдиницаИзмеренияДоОтмены,ЕстьДопРеквизитыСпецификации,ЕстьРасхождение,"
			+ "ЗаполнениеХарактеристикиПроверено,ЗапретитьВводДробногоКоличества,Зарезервировано,ИндексЦвета,ИспользоватьПартии,"
			+ "ИспользоватьХарактеристики,КПоступлению,КартинкаНабора,КлючСвязиОтмененные,КоличествоДоОтмены,"
			+ "КоличествоДоОтменыСтрокой,КомиссияСНДС,Коэффициент,Кратность,МинимальнаяЦена,"
			+ "МожноОтгрузить,НеОбеспечено,НеОтгружено,НеОтгруженоВсего,НоменклатураДоОтмены,"
			+ "НоменклатураСсылка,НомерКартинки,НомерСтрокиВнутренний,НомерСтрокиПредставление,Обеспечено,"
			+ "ОбъемЕдиницыТовара,ОстатокОбщий,ОстатокСвободно,Отгружено,Отменен,"
			+ "ПараметрыСпецификации,ПартияДоОтмены,Пометка,ПредставлениеДублей,ПредставлениеНеОтгружено,"
			+ "ПричинаОтмены,ПричинаОтменыДатаЗапрета,ПроверятьЗаполнениеПартий,ПроверятьЗаполнениеХарактеристики,Размещено,"
			+ "Расхождение,РасхождениеПредставление,СерияДоОтмены,СрокПополнения,СтатусыСерийНоменклатуры,"
			+ "ХарактеристикаДоОтмены,ЦенаДоОтмены,ЦенаДоОтменыСтрокой,ЭтоДубльСтроки,ЭтоНабор,"
			+ "ЭтоШаблонСпецификации";
	КонецЕсли;
	Если ИмяТаблицы = "Работы" Тогда
		Возврат "ЗаполнениеХарактеристикиПроверено,Исполнители,ИспользоватьХарактеристики,Коэффициент,Кратность,"
			+ "Материалы,МинимальнаяЦена,ПроверятьЗаполнениеХарактеристики";
	КонецЕсли;
	Возврат "";

КонецФункции

&НаКлиенте
&Перед("ПриЗакрытии")
Процедура АС_ОстановитьРасчетАльтернативы(ЗавершениеРаботы)

	ОтключитьОбработчикОжидания("АС_ОбновитьАльтернативныйИтог");
	АС_ОбновлениеАльтернативыНазначено = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура АС_ПересчитатьПоставочныеЦены(ВидЦен)

	ИзменениеСтоимостиНачато = АС_НачатьИзменениеСтоимости(Неопределено);
	Попытка
		Для Каждого СтрокаТовара Из Объект.Запасы Цикл
			Если СтрокаТовара.АС_ЦенаИзЗаказаПоставщика
				И СтрокаТовара.АС_ИсходнаяЦенаЗаказаПоставщика > 0
				И Не СтрокаТовара.ЭтоРазделитель И СтрокаТовара.Отменен = 0
				И СтрокаТовара.Отгружено = 0 Тогда
				АС_ЗаполнитьЦенуТовараПоВидуЦен(СтрокаТовара, Истина, ВидЦен);
			КонецЕсли;
		КонецЦикла;
		АС_ОбновитьИтогиПослеИзмененияСтоимости();
	Исключение
		АС_ЗавершитьИзменениеСтоимости(ИзменениеСтоимостиНачато, Ложь);
		ВызватьИсключение;
	КонецПопытки;
	АС_ЗавершитьИзменениеСтоимости(ИзменениеСтоимостиНачато);

КонецПроцедуры
