КонецПроцедуры

&НаКлиенте
Процедура АС_ИнициализироватьВыборВидаЦен()

	АС_МожноВыбиратьЗакупочнуюЦену = АС_РазрешеноВыбиратьЗакупочнуюЦену();
	Если Не АС_МожноВыбиратьЗакупочнуюЦену Тогда
		АС_ВидыЦенДляВыбора = АС_ПолучитьВидыЦенДляВыбораБезЗакупочных();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_НастроитьОграничениеВыбораВидаЦен()

	Если АС_МожноВыбиратьЗакупочнуюЦену = Неопределено Тогда
		АС_ИнициализироватьВыборВидаЦен();
	КонецЕсли;

	Если АС_МожноВыбиратьЗакупочнуюЦену
		Или ЗапасыИзменениеСтрокДействие <> ПредопределенноеЗначение(
			"Перечисление.ДействияГрупповогоИзмененияСтрок.УстановитьЦеныПоВиду") Тогда
		Возврат;
	КонецЕсли;

	Если АС_ВидыЦенДляВыбора = Неопределено Тогда
		АС_ВидыЦенДляВыбора = АС_ПолучитьВидыЦенДляВыбораБезЗакупочных();
	КонецЕсли;

	АС_ПараметрыВыбораВидаЦен = Новый Массив;
	АС_ПараметрыВыбораВидаЦен.Добавить(Новый ПараметрВыбора("Отбор.Ссылка", АС_ВидыЦенДляВыбора));
	Элементы.ЗапасыИзменениеСтрокЗначение.ПараметрыВыбора = Новый ФиксированныйМассив(АС_ПараметрыВыбораВидаЦен);

КонецПроцедуры

&НаКлиенте
Функция АС_РазрешитьИспользованиеВидаЦен()

	Если АС_МожноВыбиратьЗакупочнуюЦену = Неопределено Тогда
		АС_ИнициализироватьВыборВидаЦен();
	КонецЕсли;

	Если АС_МожноВыбиратьЗакупочнуюЦену
		Или ЗапасыИзменениеСтрокДействие <> ПредопределенноеЗначение(
			"Перечисление.ДействияГрупповогоИзмененияСтрок.УстановитьЦеныПоВиду")
		Или Не ЗначениеЗаполнено(ЗапасыИзменениеСтрокЗначение) Тогда
		Возврат Истина;
	КонецЕсли;

	Если АС_ЭтоЗакупочнаяЦена(ЗапасыИзменениеСтрокЗначение) Тогда
		Сообщить("Вид цены «Закупочная цена» недоступен для выбора.");
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

&НаКлиенте
&После("ЗапасыИзменениеСтрокДействиеПриИзменении")
Процедура АС_ЗапасыИзменениеСтрокДействиеПриИзмененииПосле(Элемент)

	АС_НастроитьОграничениеВыбораВидаЦен();

КонецПроцедуры

&НаКлиенте
&После("ЗапасыИзменениеСтрокЗначениеПриИзменении")
Процедура АС_ЗапасыИзменениеСтрокЗначениеПриИзмененииПосле(Элемент)

	Если Не АС_РазрешитьИспользованиеВидаЦен() Тогда
		ЗапасыИзменениеСтрокЗначение = ПредопределенноеЗначение("Справочник.ВидыЦен.ПустаяСсылка");
		ЗапасыНастроитьОформлениеПанелиРедактирования(3);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&Вместо("ОбработатьТаблицу")
Процедура АС_ОбработатьТаблицу(АС_ИмяТабличнойЧасти, АС_ЗаСчетСкидки = Неопределено)

	Если АС_ИмяТабличнойЧасти = "Запасы" И Не АС_РазрешитьИспользованиеВидаЦен() Тогда
		Возврат;
	КонецЕсли;

	АС_ИспользоватьТекущуюДату = ЗначениеЗаполнено(Объект.Ссылка)
		И АС_ИмяТабличнойЧасти = "Запасы"
		И ЭтотОбъект[АС_ИмяТабличнойЧасти + "ИзменениеСтрокДействие"] =
			ПредопределенноеЗначение("Перечисление.ДействияГрупповогоИзмененияСтрок.УстановитьЦеныПоВиду");
	АС_ДатаДокументаДляВосстановления = Неопределено;
	Если АС_ИспользоватьТекущуюДату Тогда
		АС_ДатаДокументаДляВосстановления = Объект.Дата;
		Объект.Дата = ОбщегоНазначенияКлиент.ДатаСеанса();
	КонецЕсли;

	ПродолжитьВызов(АС_ИмяТабличнойЧасти, АС_ЗаСчетСкидки);

	Если АС_ИспользоватьТекущуюДату Тогда
		Объект.Дата = АС_ДатаДокументаДляВосстановления;
	КонецЕсли;

	Если АС_ОграничитьРучныеСкидкиВТаблице(АС_ИмяТабличнойЧасти) Тогда
		Сообщить("Скидка ограничена 20% от суммы строки.");
		ОбновитьИтогиКлиент();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&Перед("СкидкаПроцентПриИзменении")
Процедура АС_СкидкаПроцентПриИзмененииПеред(Элемент)

	Если СкидкаПроцент > 20 Тогда
		СкидкаПроцент = 20;
		Сообщить("Скидка ограничена 20%.");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&Перед("СкидкаСуммаПриИзменении")
Процедура АС_СкидкаСуммаПриИзмененииПеред(Элемент)

	МаксимальнаяСуммаСкидки = АС_МаксимальнаяСуммаРучнойСкидки("Запасы");
	Если СкидкаСумма > МаксимальнаяСуммаСкидки Тогда
		СкидкаСумма = МаксимальнаяСуммаСкидки;
		Сообщить("Сумма скидки ограничена 20% от суммы заказа.");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&Перед("ЗапасыПроцентСкидкиНаценкиПриИзменении")
Процедура АС_ЗапасыПроцентСкидкиНаценкиПриИзмененииПеред(Элемент)

	АС_ОграничитьРучнуюСкидкуВТекущейСтроке("Запасы");

КонецПроцедуры

&НаКлиенте
&Перед("ЗапасыСуммаСкидкиНаценкиПриИзменении")
Процедура АС_ЗапасыСуммаСкидкиНаценкиПриИзмененииПеред(Элемент)

	АС_ОграничитьРучнуюСкидкуВТекущейСтроке("Запасы");

КонецПроцедуры

&НаКлиенте
Процедура АС_НастроитьДоступностьРучнойСкидки()

	Доступно = АС_РазрешеноПрименятьСкидки() ИЛИ АС_РазрешеноРедактированиеЦенДокументов();

	Элементы.ЗапасыПроцентСкидкиНаценки.ТолькоПросмотр = НЕ Доступно;
	Элементы.ЗапасыСуммаСкидкиНаценки.ТолькоПросмотр = НЕ Доступно;
	Элементы.Скидки.ТолькоПросмотр = НЕ Доступно;
	Элементы.СкидкаПроцент.ТолькоПросмотр = НЕ Доступно;
	Элементы.СкидкаСумма.ТолькоПросмотр = НЕ Доступно;

КонецПроцедуры

&НаКлиенте
Процедура АС_ОграничитьРучнуюСкидкуВТекущейСтроке(ИмяТабличнойЧасти)

	СтрокаТабличнойЧасти = Элементы[ИмяТабличнойЧасти].ТекущиеДанные;
	Если СтрокаТабличнойЧасти = Неопределено Тогда
		Возврат;
	КонецЕсли;

	АС_ОграничитьРучнуюСкидкуВСтроке(ИмяТабличнойЧасти, СтрокаТабличнойЧасти, Истина, Ложь);

КонецПроцедуры

&НаКлиенте
Функция АС_СуммаБезСкидкиСтроки(СтрокаТабличнойЧасти)

	КоличествоСтроки = СтрокаТабличнойЧасти.Количество;
	Если СтрокаТабличнойЧасти.Свойство("Кратность") Тогда
		КоличествоСтроки = КоличествоСтроки * СтрокаТабличнойЧасти.Кратность;
	КонецЕсли;
	Если СтрокаТабличнойЧасти.Свойство("Коэффициент") Тогда
		КоличествоСтроки = КоличествоСтроки * СтрокаТабличнойЧасти.Коэффициент;
	КонецЕсли;

	Результат = СтрокаТабличнойЧасти.Цена * КоличествоСтроки;
	Если Результат < 0 Тогда
		Результат = 0;
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаКлиенте
Функция АС_МаксимальнаяСуммаРучнойСкидки(ИмяТабличнойЧасти)

	Результат = 0;
	Для каждого СтрокаТабличнойЧасти Из Объект[ИмяТабличнойЧасти] Цикл
		Результат = Результат + АС_СуммаБезСкидкиСтроки(СтрокаТабличнойЧасти) * 20 / 100;
	КонецЦикла;

	Возврат Окр(Результат, 2);

КонецФункции

&НаКлиенте
Функция АС_ОграничитьРучнуюСкидкуВСтроке(ИмяТабличнойЧасти, СтрокаТабличнойЧасти,
	ПоказыватьСообщение = Истина, Пересчитать = Истина)

	МаксимальнаяСуммаСкидки = Окр(АС_СуммаБезСкидкиСтроки(СтрокаТабличнойЧасти) * 20 / 100, 2);
	ПроцентОграничен = Ложь;
	СуммаОграничена = Ложь;

	Если СтрокаТабличнойЧасти.ПроцентСкидкиНаценки > 20 Тогда
		СтрокаТабличнойЧасти.ПроцентСкидкиНаценки = 20;
		СтрокаТабличнойЧасти.СуммаСкидкиНаценки = МаксимальнаяСуммаСкидки;
		ПроцентОграничен = Истина;
	КонецЕсли;

	Если СтрокаТабличнойЧасти.СуммаСкидкиНаценки > МаксимальнаяСуммаСкидки Тогда
		СтрокаТабличнойЧасти.СуммаСкидкиНаценки = МаксимальнаяСуммаСкидки;
		СуммаОграничена = Истина;
	КонецЕсли;

	Если Не ПроцентОграничен И Не СуммаОграничена Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Пересчитать Тогда
		Если ПроцентОграничен Тогда
			ПараметрыРасчета = Новый Структура("РассчитатьСуммуСкидки", Истина);
		Иначе
			ПараметрыРасчета = Новый Структура("РассчитатьПроцентСкидки", Истина);
		КонецЕсли;
		РассчитатьСуммуВСтрокеТабличнойЧасти(ИмяТабличнойЧасти, СтрокаТабличнойЧасти, ПараметрыРасчета);
	КонецЕсли;

	Если ПоказыватьСообщение Тогда
		Если ПроцентОграничен Тогда
			Сообщить("Скидка ограничена 20%.");
		Иначе
			Сообщить("Сумма скидки ограничена 20% от суммы строки.");
		КонецЕсли;
	КонецЕсли;

	Возврат Истина;

КонецФункции

&НаКлиенте
Функция АС_ОграничитьРучныеСкидкиВТаблице(ИмяТабличнойЧасти)

	Изменено = Ложь;
	Для каждого СтрокаТабличнойЧасти Из Объект[ИмяТабличнойЧасти] Цикл
		Если АС_ОграничитьРучнуюСкидкуВСтроке(ИмяТабличнойЧасти, СтрокаТабличнойЧасти, Ложь, Истина) Тогда
			Изменено = Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Изменено;

КонецФункции

&НаКлиенте
Процедура АС_ОграничитьРучныеСкидкиПередЗаписью()

	Если АС_ОграничитьРучныеСкидкиВТаблице("Запасы") Тогда
		Сообщить("Скидка ограничена 20% от суммы строки.");
		ОбновитьИтогиКлиент();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&После("ЗапасыПриАктивизацииЯчейки")
Процедура АС_ЗапасыПриАктивизацииЯчейкиПосле(Элемент)

	АС_ОбновитьДоступностьЦеныУслуги();
	АС_НастроитьОтборНоменклатурыПоОстатку();

КонецПроцедуры

&НаКлиенте
&После("ЗапасыНоменклатураПриИзменении")
Процедура АС_ЗапасыНоменклатураПриИзмененииПосле(Элемент)

	АС_ОбновитьДоступностьЦеныУслуги();
	АС_НастроитьОтборНоменклатурыПоОстатку(Истина);

КонецПроцедуры

&НаКлиенте
Процедура АС_ОбновитьДоступностьЦеныУслуги()

	Если Не АС_ОграниченоРедактированиеЦеныУслуги Тогда
		Возврат;
	КонецЕсли;

	МожноИзменять = Ложь;
	СтрокаТабличнойЧасти = Элементы.Запасы.ТекущиеДанные;
	Если СтрокаТабличнойЧасти <> Неопределено Тогда
		СтрокаОбъекта = Неопределено;
		Если Элементы.Запасы.ТекущаяСтрока <> Неопределено Тогда
			СтрокаОбъекта = Объект.Запасы.НайтиПоИдентификатору(Элементы.Запасы.ТекущаяСтрока);
		КонецЕсли;
		Если СтрокаОбъекта <> Неопределено Тогда
			МожноИзменять = Не СтрокаОбъекта.ТипНоменклатурыЗапас;
		КонецЕсли;
	КонецЕсли;

	Элементы.ЗапасыЦена.ТолькоПросмотр = Не МожноИзменять;

КонецПроцедуры

&НаКлиенте
&После("ОбновитьОтображениеКолонокВРазрезеЗапасов")
Процедура АС_ОбновитьОтображениеКолонокВРазрезеЗапасовПосле()

	Элементы.АС_ЗапасыДоступноСУчетомЗаказов.Видимость = РежимОстаткиИРезервы;

КонецПроцедуры

&НаКлиенте
&После("ОстаткиИРезервы")
Процедура АС_ОстаткиИРезервыПосле(Команда)

	Если РежимОстаткиИРезервы Тогда
		АС_ПересчитатьДоступность();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&После("ЗапасыНоменклатураПриИзмененииПродолжить")
Процедура АС_ЗапасыНоменклатураПриИзмененииПродолжитьПосле(Элемент, НовоеКоличество,
	СтрокаТабличнойЧасти = Неопределено, ЦенаЗапаса = Неопределено, Партия = Неопределено)
	АС_ЗаполнитьЦенуТовараПоОсновномуВидуЦен(СтрокаТабличнойЧасти);
	АС_ОбновитьДоступностьЦеныУслуги();
	АС_ПересчитатьДоступность();
КонецПроцедуры

&НаКлиенте
Процедура АС_ЗаполнитьЦенуТовараПоОсновномуВидуЦен(СтрокаТабличнойЧасти)

	Если СтрокаТабличнойЧасти = Неопределено Тогда
		СтрокаТабличнойЧасти = Элементы.Запасы.ТекущиеДанные;
	КонецЕсли;

	Если СтрокаТабличнойЧасти = Неопределено
		Или Не ЗначениеЗаполнено(Объект.Контрагент)
		Или ТипЗнч(СтрокаТабличнойЧасти.Номенклатура) <> Тип("СправочникСсылка.Номенклатура")
		Или Не СтрокаТабличнойЧасти.ТипНоменклатурыЗапас
		Или СтрокаТабличнойЧасти.Цена <> 0 Тогда
		Возврат;
	КонецЕсли;

	СтруктураДанные = Новый Структура;
	СтруктураДанные.Вставить("Номенклатура", СтрокаТабличнойЧасти.Номенклатура);
	СтруктураДанные.Вставить("Характеристика", СтрокаТабличнойЧасти.Характеристика);
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		СтруктураДанные.Вставить("ДатаОбработки", ОбщегоНазначенияКлиент.ДатаСеанса());
	Иначе
		СтруктураДанные.Вставить("ДатаОбработки", Объект.Дата);
	КонецЕсли;
	СтруктураДанные.Вставить("ВалютаДокумента", Объект.ВалютаДокумента);
	СтруктураДанные.Вставить("СуммаВключаетНДС", Объект.СуммаВключаетНДС);
	СтруктураДанные.Вставить("Коэффициент", 1);
	СтруктураДанные.Вставить("СтавкаНДС", СтрокаТабличнойЧасти.СтавкаНДС);

	Если Не ЗначениеЗаполнено(СтруктураДанные.ДатаОбработки) Тогда
		СтруктураДанные.ДатаОбработки = ОбщегоНазначенияКлиент.ДатаСеанса();
	КонецЕсли;

	ЦенообразованиеКлиентСервер.ДополнитьСтруктуруДанныхНоменклатурыПолямиЦенообразования(
		Объект, СтрокаТабличнойЧасти, СтруктураДанные);

	ЦенаПоУмолчанию = АС_ПолучитьЦенуПоОсновномуВидуЦен(СтруктураДанные);
	Если ЦенаПоУмолчанию <> 0 Тогда
		СтрокаТабличнойЧасти.Цена = ЦенаПоУмолчанию;
		РассчитатьСуммуВСтрокеТабличнойЧасти("Запасы", СтрокаТабличнойЧасти);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_ЗаполнитьЦеныТоваровПослеСканирования()

	Если Не ЗначениеЗаполнено(Объект.Контрагент) Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаТовара Из Объект.Запасы Цикл
		АС_ЗаполнитьЦенуТовараПоОсновномуВидуЦен(СтрокаТовара);
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_ПолучитьЦенуПоОсновномуВидуЦен(СтруктураДанные)

	ОсновнойВидЦен = Справочники.ВидыЦен.ПолучитьОсновнойВидЦенПродажи();
	Если Не ЗначениеЗаполнено(ОсновнойВидЦен) Тогда
		Возврат 0;
	КонецЕсли;

	СтруктураДанные.Вставить("ВидЦен", ОсновнойВидЦен);
	Возврат ЦенообразованиеСервер.ПолучитьЦенуНоменклатурыПоВидуЦен(СтруктураДанные);

КонецФункции

