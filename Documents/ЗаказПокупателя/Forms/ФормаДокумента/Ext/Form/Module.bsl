&НаСервереБезКонтекста
Функция АС_ПолучитьТекущегоПродавца()

	Результат = Новый Структура("Продавец,ТекстОшибки", Справочники.Сотрудники.ПустаяСсылка(), "");
	ТекущийПользователь = Пользователи.ТекущийПользователь();
	СотрудникиПользователя = РегистрыСведений.СотрудникиПользователя.ПолучитьСотрудниковПользователя(
		ТекущийПользователь);

	Если СотрудникиПользователя.Количество() = 1 Тогда
		Результат.Продавец = СотрудникиПользователя[0];
	ИначеЕсли СотрудникиПользователя.Количество() = 0 Тогда
		Результат.ТекстОшибки = "Нельзя определить продавца: текущая учетная запись не связана с сотрудником.";
	Иначе
		Результат.ТекстОшибки = "Нельзя определить продавца: с текущей учетной записью связано несколько сотрудников.";
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура АС_ЗаполнитьПродавцаВДобавленныхСтроках(КоличествоДобавленныхСтрок)

	Если КоличествоДобавленныхСтрок <= 0 Тогда
		Возврат;
	КонецЕсли;

	КоличествоСтрок = Объект.Запасы.Количество();
	Для Итератор = 1 По Мин(КоличествоДобавленныхСтрок, КоличествоСтрок) Цикл
		АС_ЗаполнитьПродавцаСтроки(Объект.Запасы[КоличествоСтрок - Итератор]);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура АС_ОтменитьВернутьЗапасыПосле(ДанныеЗапаса, ПричинаОтмены)

	АС_ПересчитатьДоступность(Ложь);

	Если ДанныеЗапаса.Отменен <> 1
		Или Не ЗначениеЗаполнено(ДанныеЗапаса.НоменклатураДоОтмены) Тогда
		Возврат;
	КонецЕсли;

	СтрокиОтмены = Объект.ОтмененныеЗапасы.НайтиСтроки(
		Новый Структура("КлючСвязиОтмененные", ДанныеЗапаса.КлючСвязиОтмененные));
	ПродавецОтмены = ДанныеЗапаса.АС_Продавец;
	Если Не ЗначениеЗаполнено(ПродавецОтмены) Тогда
		// У исторической строки продавец не был зафиксирован: отмену относим к текущему сотруднику.
		ПродавецОтмены = АС_ПолучитьТекущегоПродавца().Продавец;
	КонецЕсли;
	Если СтрокиОтмены.Количество() = 1 Тогда
		СтрокиОтмены[0].АС_Номенклатура = ДанныеЗапаса.НоменклатураДоОтмены;
		СтрокиОтмены[0].АС_Продавец = ПродавецОтмены;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_ЗаполнитьПродавцаСтроки(СтрокаТовара)

	Если СтрокаТовара = Неопределено
		Или Не ЗначениеЗаполнено(СтрокаТовара.Номенклатура)
		Или ЗначениеЗаполнено(СтрокаТовара.АС_Продавец) Тогда
		Возврат;
	КонецЕсли;

	Если АС_ТекущийПродавец = Неопределено
		И АС_ОшибкаОпределенияПродавца = Неопределено Тогда
		ДанныеПродавца = АС_ПолучитьТекущегоПродавца();
		АС_ТекущийПродавец = ДанныеПродавца.Продавец;
		АС_ОшибкаОпределенияПродавца = ДанныеПродавца.ТекстОшибки;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(АС_ТекущийПродавец) Тогда
		Если АС_СтрокиБезПродавца = Неопределено Тогда
			АС_СтрокиБезПродавца = Новый Массив;
		КонецЕсли;
		АС_СтрокиБезПродавца.Добавить(СтрокаТовара.ПолучитьИдентификатор());
		Возврат;
	КонецЕсли;

	СтрокаТовара.АС_Продавец = АС_ТекущийПродавец;

КонецПроцедуры

&НаКлиенте
Процедура АС_ПроверитьПродавцовПередЗаписью(Отказ)

	Если АС_СтрокиБезПродавца = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ИдентификаторСтроки Из АС_СтрокиБезПродавца Цикл
		СтрокаТовара = Объект.Запасы.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если СтрокаТовара = Неопределено
			Или Не ЗначениеЗаполнено(СтрокаТовара.Номенклатура)
			Или ЗначениеЗаполнено(СтрокаТовара.АС_Продавец) Тогда
			Продолжить;
		КонецЕсли;

		Отказ = Истина;
		Если ЗначениеЗаполнено(АС_ОшибкаОпределенияПродавца) Тогда
			Сообщить(АС_ОшибкаОпределенияПродавца);
		Иначе
			Сообщить("Укажите продавца для новой строки товара перед записью заказа.");
		КонецЕсли;
		Возврат;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура АС_ОбновитьИтогиПослеИзмененияСтоимости(ОбновитьОплату = Истина)

	ОбновитьИтогиКлиент();
	ПересчитатьПлатежныйКалендарь();
	Если ОбновитьОплату Тогда
		АС_ОбновитьОтображениеОплаты();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_ПересчитатьСтоимостьИПроверитьПередЗаписью(Отказ)

	ИзменениеСтоимостиНачато = АС_НачатьИзменениеСтоимости(Неопределено);
	Попытка
		// Денежная скидка уже рассчитана обработчиком изменения строки или перенесена
		// из буфера. Округлённый процент не должен менять её при записи документа.
		ПараметрыРасчета = Новый Структура(
			"РассчитатьПроцентСкидки,СброситьФлагСкидкиРассчитаны", Истина, Ложь);
		ТекстСтрокБезЦены = "";
		НомерСтроки = 0;

		Для Каждого СтрокаТовара Из Объект.Запасы Цикл
			НомерСтроки = НомерСтроки + 1;
			Если СтрокаТовара.ЭтоРазделитель
				Или СтрокаТовара.Отменен <> 0
				Или Не ЗначениеЗаполнено(СтрокаТовара.Номенклатура)
				Или ТипЗнч(СтрокаТовара.Номенклатура) <> Тип("СправочникСсылка.Номенклатура") Тогда
				Продолжить;
			КонецЕсли;

			Если СтрокаТовара.ТипНоменклатурыЗапас И СтрокаТовара.Цена = 0 Тогда
				АС_ЗаполнитьЦенуТовараПоВидуЦен(СтрокаТовара);
			КонецЕсли;

			ИсходнаяЦена = СтрокаТовара.Цена;
			ИсходнаяСумма = СтрокаТовара.Сумма;
			ИсходнаяАвтоСкидка = СтрокаТовара.СуммаАвтоматическойСкидки;
			ИсходнаяБонуснаяСкидка = СтрокаТовара.СуммаСкидкиОплатыБонусом;
			ИсходнаяСуммаСкидки = СтрокаТовара.СуммаСкидкиНаценки;
			ИсходныйПроцентСкидки = СтрокаТовара.ПроцентСкидкиНаценки;
			РассчитатьСуммуВСтрокеТабличнойЧасти("Запасы", СтрокаТовара, ПараметрыРасчета);
			Если СтрокаТовара.СуммаСкидкиНаценки = ИсходнаяСуммаСкидки Тогда
				// Запись не должна превращать заданный процент в процент от округлённой суммы.
				СтрокаТовара.ПроцентСкидкиНаценки = ИсходныйПроцентСкидки;
				Если СтрокаТовара.Цена = ИсходнаяЦена
					И СтрокаТовара.СуммаАвтоматическойСкидки = ИсходнаяАвтоСкидка
					И СтрокаТовара.СуммаСкидкиОплатыБонусом = ИсходнаяБонуснаяСкидка
					И СтрокаТовара.Отменен = 0
					И АС_СуммаСтрокиНеНижеМинимальной(СтрокаТовара, ИсходнаяСумма) Тогда
					// Точный ввод суммы сохраняется и после полного пересчёта перед записью.
					СтрокаТовара.Сумма = ИсходнаяСумма;
					ТабличныеЧастиУНФКлиент.РассчитатьСуммуНДСИВсего(СтрокаТовара,
						Новый Структура("СуммаВключаетНДС", Объект.СуммаВключаетНДС));
				КонецЕсли;
			КонецЕсли;

			Если СтрокаТовара.Количество <> 0
				И СтрокаТовара.Цена = 0 Тогда
				ТекстСтрокБезЦены = ТекстСтрокБезЦены + Символы.ПС
					+ СтрШаблон("Товары, строка %1: %2", НомерСтроки, СтрокаТовара.Номенклатура);
			КонецЕсли;
		КонецЦикла;

		Если ПустаяСтрока(ТекстСтрокБезЦены)
			И ИспользоватьАвтоматическиеСкидки И Не Объект.СкидкиРассчитаны Тогда
			// Штатный серверный расчёт при записи должен получить уже рассчитанные акции:
			// иначе он изменит суммы после клиентского округления.
			РассчитатьСкидкиНаценкиКлиент();
		КонецЕсли;
		АС_ОбновитьИтогиПослеИзмененияСтоимости(Ложь);

		Если Не ПустаяСтрока(ТекстСтрокБезЦены) Тогда
			Отказ = Истина;
			Сообщить("Запись отменена: у товаров или услуг не определена цена."
				+ Символы.ПС + "Укажите цену в строках:" + ТекстСтрокБезЦены);
		КонецЕсли;
	Исключение
		АС_ЗавершитьИзменениеСтоимости(ИзменениеСтоимостиНачато, Ложь);
		ВызватьИсключение;
	КонецПопытки;
	АС_ЗавершитьИзменениеСтоимости(ИзменениеСтоимостиНачато);

КонецПроцедуры

