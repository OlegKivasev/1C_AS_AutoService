&НаКлиенте
&После("ЗапасыИзменениеСтрокЗначениеПриИзменении")
Процедура АС_ЗапасыИзменениеСтрокЗначениеПриИзмененииПосле(Элемент)

	Если Не АС_РазрешитьИспользованиеВидаЦен() Тогда
		ЗапасыИзменениеСтрокЗначение = ПредопределенноеЗначение("Справочник.ВидыЦен.ПустаяСсылка");
		ЗапасыНастроитьОформлениеПанелиРедактирования(3);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&Вместо("ОбработатьТаблицу")
Процедура АС_ОбработатьТаблицу(АС_ИмяТабличнойЧасти, АС_ЗаСчетСкидки = Неопределено)

	Если АС_ИмяТабличнойЧасти = "Запасы" И Не АС_РазрешитьИспользованиеВидаЦен() Тогда
		Возврат;
	КонецЕсли;

	ИзменениеСтоимостиНачато = АС_НачатьИзменениеСтоимости(Неопределено);
	Попытка
		ИзменяемыеСтрокиВидаЦен = Новый Массив;
		Если АС_ИмяТабличнойЧасти = "Запасы"
			И ЭтотОбъект[АС_ИмяТабличнойЧасти + "ИзменениеСтрокДействие"] = ПредопределенноеЗначение(
				"Перечисление.ДействияГрупповогоИзмененияСтрок.УстановитьЦеныПоВиду") Тогда
			ИзменяемыеСтрокиВидаЦен = Объект[АС_ИмяТабличнойЧасти].НайтиСтроки(
				Новый Структура("Пометка", Истина));
		КонецЕсли;

		АС_ИспользоватьТекущуюДату = ЗначениеЗаполнено(Объект.Ссылка)
			И АС_ИмяТабличнойЧасти = "Запасы"
			И ЭтотОбъект[АС_ИмяТабличнойЧасти + "ИзменениеСтрокДействие"] =
				ПредопределенноеЗначение("Перечисление.ДействияГрупповогоИзмененияСтрок.УстановитьЦеныПоВиду");
		АС_ДатаДокументаДляВосстановления = Неопределено;
		Если АС_ИспользоватьТекущуюДату Тогда
			АС_ДатаДокументаДляВосстановления = Объект.Дата;
			Объект.Дата = ОбщегоНазначенияКлиент.ДатаСеанса();
		КонецЕсли;

		АС_ВыполняетсяАвтоматическийПересчетЦен = Истина;
		ПродолжитьВызов(АС_ИмяТабличнойЧасти, АС_ЗаСчетСкидки);
		АС_ВыполняетсяАвтоматическийПересчетЦен = Ложь;

		Если ИзменяемыеСтрокиВидаЦен.Количество() > 0 Тогда
			ВидЦенИзменяемыхСтрок = ЭтотОбъект[АС_ИмяТабличнойЧасти + "ИзменениеСтрокЗначение"];
			ЦенаПоВидуЦенКонтрагента = АС_ЭтоВидЦенКонтрагента(ВидЦенИзменяемыхСтрок);
			Для Каждого СтрокаТовара Из ИзменяемыеСтрокиВидаЦен Цикл
				СтрокаТовара.АС_ПримененныйВидЦен = ВидЦенИзменяемыхСтрок;
				СтрокаТовара.АС_ЦенаИзЗаказаПоставщика = Ложь;
				СтрокаТовара.АС_ЦенаПоВидуЦенКонтрагента = СтрокаТовара.Цена <> 0
					И ЦенаПоВидуЦенКонтрагента;
			КонецЦикла;
		КонецЕсли;

		Если АС_ИспользоватьТекущуюДату Тогда
			Объект.Дата = АС_ДатаДокументаДляВосстановления;
		КонецЕсли;

		Если АС_ОграничитьРучныеСкидкиВТаблице(АС_ИмяТабличнойЧасти) Тогда
			Сообщить(СтрШаблон("Скидка ограничена %1%% от суммы строки.", АС_МаксимальныйПроцентРучнойСкидки()));
			ОбновитьИтогиКлиент();
		КонецЕсли;
		АС_ОбновитьИтогиПослеИзмененияСтоимости();
	Исключение
		АС_ВыполняетсяАвтоматическийПересчетЦен = Ложь;
		Если АС_ДатаДокументаДляВосстановления <> Неопределено Тогда
			Объект.Дата = АС_ДатаДокументаДляВосстановления;
		КонецЕсли;
		АС_ЗавершитьИзменениеСтоимости(ИзменениеСтоимостиНачато, Ложь);
		ВызватьИсключение;
	КонецПопытки;
	АС_ЗавершитьИзменениеСтоимости(ИзменениеСтоимостиНачато);

КонецПроцедуры

&НаКлиенте
&Перед("СкидкаПроцентПриИзменении")
Процедура АС_СкидкаПроцентПриИзмененииПеред(Элемент)

	Если Не АС_ОграничиватьРучныеСкидки Тогда
		Возврат;
	КонецЕсли;

	Если СкидкаПроцент > АС_МаксимальныйПроцентРучнойСкидки() Тогда
		СкидкаПроцент = АС_МаксимальныйПроцентРучнойСкидки();
		Сообщить(СтрШаблон("Скидка ограничена %1%%.", АС_МаксимальныйПроцентРучнойСкидки()));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&После("СкидкаПроцентПриИзменении")
Процедура АС_СкидкаПроцентПриИзмененииПосле(Элемент)

	АС_ОбновитьОтображениеОплаты();

КонецПроцедуры

&НаКлиенте
&Перед("СкидкаСуммаПриИзменении")
Процедура АС_СкидкаСуммаПриИзмененииПеред(Элемент)

	Если АС_ФормаГотоваКОкруглению = Истина
		И АС_ПересчитываетсяОкруглениеЦен <> Истина Тогда
		АС_ВосстановитьЦеныДоОкругления();
	КонецЕсли;

	Если Не АС_ОграничиватьРучныеСкидки Тогда
		Возврат;
	КонецЕсли;

	МаксимальнаяСуммаСкидки = АС_МаксимальнаяСуммаРучнойСкидки("Запасы");
	Если СкидкаСумма > МаксимальнаяСуммаСкидки Тогда
		СкидкаСумма = МаксимальнаяСуммаСкидки;
		Сообщить(СтрШаблон("Сумма скидки ограничена %1%% от суммы заказа.", АС_МаксимальныйПроцентРучнойСкидки()));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&После("СкидкаСуммаПриИзменении")
Процедура АС_СкидкаСуммаПриИзмененииПосле(Элемент)

	АС_ОбновитьОтображениеОплаты();

КонецПроцедуры

&НаКлиенте
&Перед("ЗапасыПроцентСкидкиНаценкиПриИзменении")
Процедура АС_ЗапасыПроцентСкидкиНаценкиПриИзмененииПеред(Элемент)

	АС_ОграничитьРучнуюСкидкуВТекущейСтроке("Запасы");

КонецПроцедуры

&НаКлиенте
&Перед("ЗапасыСуммаСкидкиНаценкиПриИзменении")
Процедура АС_ЗапасыСуммаСкидкиНаценкиПриИзмененииПеред(Элемент)

	АС_ОграничитьРучнуюСкидкуВТекущейСтроке("Запасы");

КонецПроцедуры

&НаКлиенте
Процедура АС_НастроитьДоступностьРучнойСкидки()

	Доступно = АС_РазрешеноПрименятьСкидки() ИЛИ АС_РазрешеноРедактированиеЦенДокументов();

	Элементы.ЗапасыПроцентСкидкиНаценки.ТолькоПросмотр = НЕ Доступно;
	Элементы.ЗапасыСуммаСкидкиНаценки.ТолькоПросмотр = НЕ Доступно;
	Элементы.Скидки.ТолькоПросмотр = НЕ Доступно;
	Элементы.СкидкаПроцент.ТолькоПросмотр = НЕ Доступно;
	Элементы.СкидкаСумма.ТолькоПросмотр = НЕ Доступно;

КонецПроцедуры

&НаКлиенте
Процедура АС_ОграничитьРучнуюСкидкуВТекущейСтроке(ИмяТабличнойЧасти)

	СтрокаТабличнойЧасти = Элементы[ИмяТабличнойЧасти].ТекущиеДанные;
	Если СтрокаТабличнойЧасти = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если АС_ФормаГотоваКОкруглению = Истина Тогда
		АС_ВосстановитьЦеныДоОкругления(?(ИмяТабличнойЧасти = "Запасы",
			СтрокаТабличнойЧасти, Неопределено));
	КонецЕсли;
	АС_ОграничитьРучнуюСкидкуВСтроке(ИмяТабличнойЧасти, СтрокаТабличнойЧасти, Истина, Ложь);

КонецПроцедуры

&НаКлиенте
Функция АС_СуммаБезСкидкиСтроки(СтрокаТабличнойЧасти)

	КоличествоСтроки = СтрокаТабличнойЧасти.Количество;
	Если СтрокаТабличнойЧасти.Свойство("Кратность") Тогда
		КоличествоСтроки = КоличествоСтроки * СтрокаТабличнойЧасти.Кратность;
	КонецЕсли;
	Если СтрокаТабличнойЧасти.Свойство("Коэффициент") Тогда
		КоличествоСтроки = КоличествоСтроки * СтрокаТабличнойЧасти.Коэффициент;
	КонецЕсли;

	Результат = СтрокаТабличнойЧасти.Цена * КоличествоСтроки;
	Если Результат < 0 Тогда
		Результат = 0;
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаКлиенте
Функция АС_МаксимальнаяСуммаРучнойСкидки(ИмяТабличнойЧасти)

	Результат = 0;
	Для каждого СтрокаТабличнойЧасти Из Объект[ИмяТабличнойЧасти] Цикл
		Если ТабличныеЧастиУНФКлиентСервер.АС_ЭтоСтрокаБезСкидки(СтрокаТабличнойЧасти) Тогда
			Продолжить;
		КонецЕсли;
		Результат = Результат + АС_СуммаБезСкидкиСтроки(СтрокаТабличнойЧасти) * АС_МаксимальныйПроцентРучнойСкидки() / 100;
	КонецЦикла;

	Возврат Окр(Результат, 2);

КонецФункции

&НаКлиенте
Функция АС_ОграничитьРучнуюСкидкуВСтроке(ИмяТабличнойЧасти, СтрокаТабличнойЧасти,
	ПоказыватьСообщение = Истина, Пересчитать = Истина)

	Если ТабличныеЧастиУНФКлиентСервер.АС_ЭтоСтрокаБезСкидки(СтрокаТабличнойЧасти) Тогда
		ТабличныеЧастиУНФКлиентСервер.АС_РассчитатьСтрокуБезСкидки(
			СтрокаТабличнойЧасти, Новый Структура("СуммаВключаетНДС", Объект.СуммаВключаетНДС));
		Возврат Ложь;
	КонецЕсли;

	Если Не АС_ОграничиватьРучныеСкидки Тогда
		Возврат Ложь;
	КонецЕсли;

	МаксимальнаяСуммаСкидки = Окр(АС_СуммаБезСкидкиСтроки(СтрокаТабличнойЧасти) * АС_МаксимальныйПроцентРучнойСкидки() / 100, 2);
	ПроцентОграничен = Ложь;
	СуммаОграничена = Ложь;

	Если СтрокаТабличнойЧасти.ПроцентСкидкиНаценки > АС_МаксимальныйПроцентРучнойСкидки() Тогда
		СтрокаТабличнойЧасти.ПроцентСкидкиНаценки = АС_МаксимальныйПроцентРучнойСкидки();
		СтрокаТабличнойЧасти.СуммаСкидкиНаценки = МаксимальнаяСуммаСкидки;
		ПроцентОграничен = Истина;
	КонецЕсли;

	Если СтрокаТабличнойЧасти.СуммаСкидкиНаценки > МаксимальнаяСуммаСкидки Тогда
		СтрокаТабличнойЧасти.СуммаСкидкиНаценки = МаксимальнаяСуммаСкидки;
		СуммаОграничена = Истина;
	КонецЕсли;

	Если Не ПроцентОграничен И Не СуммаОграничена Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Пересчитать Тогда
		Если ПроцентОграничен Тогда
			ПараметрыРасчета = Новый Структура("РассчитатьСуммуСкидки", Истина);
		Иначе
			ПараметрыРасчета = Новый Структура("РассчитатьПроцентСкидки", Истина);
		КонецЕсли;
		РассчитатьСуммуВСтрокеТабличнойЧасти(ИмяТабличнойЧасти, СтрокаТабличнойЧасти, ПараметрыРасчета);
	КонецЕсли;

	Если ПоказыватьСообщение Тогда
		Если ПроцентОграничен Тогда
			Сообщить(СтрШаблон("Скидка ограничена %1%%.", АС_МаксимальныйПроцентРучнойСкидки()));
		Иначе
			Сообщить(СтрШаблон("Сумма скидки ограничена %1%% от суммы строки.", АС_МаксимальныйПроцентРучнойСкидки()));
		КонецЕсли;
	КонецЕсли;

	Возврат Истина;

КонецФункции

&НаКлиенте
Функция АС_ОграничитьРучныеСкидкиВТаблице(ИмяТабличнойЧасти)

	Изменено = Ложь;
	Для каждого СтрокаТабличнойЧасти Из Объект[ИмяТабличнойЧасти] Цикл
		Если АС_ОграничитьРучнуюСкидкуВСтроке(ИмяТабличнойЧасти, СтрокаТабличнойЧасти, Ложь, Истина) Тогда
			Изменено = Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Изменено;

КонецФункции

&НаКлиенте
Процедура АС_ОграничитьРучныеСкидкиПередЗаписью()

	Если АС_ОграничитьРучныеСкидкиВТаблице("Запасы") Тогда
		Сообщить(СтрШаблон("Скидка ограничена %1%% от суммы строки.", АС_МаксимальныйПроцентРучнойСкидки()));
		ОбновитьИтогиКлиент();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&После("ЗапасыПриАктивизацииЯчейки")
Процедура АС_ЗапасыПриАктивизацииЯчейкиПосле(Элемент)

	АС_ОбновитьДоступностьЦеныУслуги();
	АС_НастроитьОтборНоменклатурыПоОстатку();

КонецПроцедуры

&НаКлиенте
&После("ЗапасыНоменклатураПриИзменении")
Процедура АС_ЗапасыНоменклатураПриИзмененииПосле(Элемент)

	СтрокаТабличнойЧасти = Элементы.Запасы.ТекущиеДанные;
	Если СтрокаТабличнойЧасти <> Неопределено Тогда
		СтрокаТабличнойЧасти.АС_ЦенаИзЗаказаПоставщика = Ложь;
		АС_ЗаполнитьПродавцаСтроки(СтрокаТабличнойЧасти);
	КонецЕсли;
	АС_ОбновитьДоступностьЦеныУслуги();
	АС_НастроитьОтборНоменклатурыПоОстатку(Истина);

КонецПроцедуры

&НаКлиенте
Процедура АС_ОбновитьДоступностьЦеныУслуги()

	Если Не АС_ОграниченоРедактированиеЦеныУслуги Тогда
		Возврат;
	КонецЕсли;

	МожноИзменять = Ложь;
	СтрокаТабличнойЧасти = Элементы.Запасы.ТекущиеДанные;
	Если СтрокаТабличнойЧасти <> Неопределено Тогда
		СтрокаОбъекта = Неопределено;
		Если Элементы.Запасы.ТекущаяСтрока <> Неопределено Тогда
			СтрокаОбъекта = Объект.Запасы.НайтиПоИдентификатору(Элементы.Запасы.ТекущаяСтрока);
		КонецЕсли;
		Если СтрокаОбъекта <> Неопределено Тогда
			МожноИзменять = Не СтрокаОбъекта.ТипНоменклатурыЗапас;
		КонецЕсли;
	КонецЕсли;

	Элементы.ЗапасыЦена.ТолькоПросмотр = Не МожноИзменять;

КонецПроцедуры

&НаКлиенте
&После("ОбновитьОтображениеКолонокВРазрезеЗапасов")
Процедура АС_ОбновитьОтображениеКолонокВРазрезеЗапасовПосле()

	Элементы.АС_ЗапасыДоступноСУчетомЗаказов.Видимость = РежимОстаткиИРезервы;

КонецПроцедуры

&НаКлиенте
&После("ОстаткиИРезервы")
Процедура АС_ОстаткиИРезервыПосле(Команда)

	Если РежимОстаткиИРезервы Тогда
		АС_ПересчитатьДоступность();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&Перед("ЗапасыНоменклатураПриИзмененииПродолжить")
Процедура АС_ЗапасыНоменклатураПриИзмененииПродолжитьПеред(Элемент, НовоеКоличество,
	СтрокаТабличнойЧасти = Неопределено, ЦенаЗапаса = Неопределено, Партия = Неопределено)
	АС_СинхронизироватьВидЦенДокумента();
КонецПроцедуры

&НаКлиенте
&После("ЗапасыНоменклатураПриИзмененииПродолжить")
Процедура АС_ЗапасыНоменклатураПриИзмененииПродолжитьПосле(Элемент, НовоеКоличество,
	СтрокаТабличнойЧасти = Неопределено, ЦенаЗапаса = Неопределено, Партия = Неопределено)
	АС_ЗаполнитьЦенуТовараПоВидуЦен(СтрокаТабличнойЧасти);
	АС_УстановитьВидЦенСтрокиЗапаса(СтрокаТабличнойЧасти);
	АС_ОбновитьДоступностьЦеныУслуги();
	АС_ПересчитатьДоступность(Ложь);
	АС_ОбновитьИтогиПослеИзмененияСтоимости();
КонецПроцедуры

&НаКлиенте
Процедура АС_ЗаполнитьЦенуТовараПоВидуЦен(СтрокаТабличнойЧасти, Принудительно = Ложь,
	ВидЦенДляРасчета = Неопределено)

	Если СтрокаТабличнойЧасти = Неопределено Тогда
		СтрокаТабличнойЧасти = Элементы.Запасы.ТекущиеДанные;
	КонецЕсли;

	Если СтрокаТабличнойЧасти = Неопределено
		Или ТипЗнч(СтрокаТабличнойЧасти.Номенклатура) <> Тип("СправочникСсылка.Номенклатура")
		Или Не СтрокаТабличнойЧасти.ТипНоменклатурыЗапас
		Или (Не Принудительно И СтрокаТабличнойЧасти.Цена <> 0) Тогда
		Возврат;
	КонецЕсли;

	СтруктураДанные = Новый Структура;
	СтруктураДанные.Вставить("Номенклатура", СтрокаТабличнойЧасти.Номенклатура);
	СтруктураДанные.Вставить("Характеристика", СтрокаТабличнойЧасти.Характеристика);
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		СтруктураДанные.Вставить("ДатаОбработки", ОбщегоНазначенияКлиент.ДатаСеанса());
	Иначе
		СтруктураДанные.Вставить("ДатаОбработки", Объект.Дата);
	КонецЕсли;
	СтруктураДанные.Вставить("ВалютаДокумента", Объект.ВалютаДокумента);
	СтруктураДанные.Вставить("СуммаВключаетНДС", Объект.СуммаВключаетНДС);
	СтруктураДанные.Вставить("Коэффициент", 1);
	СтруктураДанные.Вставить("СтавкаНДС", СтрокаТабличнойЧасти.СтавкаНДС);
	Если ВидЦенДляРасчета = Неопределено Тогда
		ВидЦенДляРасчета = АС_ПолучитьВидЦенДляРасчета();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ВидЦенДляРасчета) Тогда
		Если Принудительно Тогда
			СтрокаТабличнойЧасти.Цена = 0;
			СтрокаТабличнойЧасти.АС_ПримененныйВидЦен = ПредопределенноеЗначение(
				"Справочник.ВидыЦен.ПустаяСсылка");
			СтрокаТабличнойЧасти.АС_ЦенаПоВидуЦенКонтрагента = Ложь;
			РассчитатьСуммуВСтрокеТабличнойЧасти("Запасы", СтрокаТабличнойЧасти);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(СтруктураДанные.ДатаОбработки) Тогда
		СтруктураДанные.ДатаОбработки = ОбщегоНазначенияКлиент.ДатаСеанса();
	КонецЕсли;

	ЦенообразованиеКлиентСервер.ДополнитьСтруктуруДанныхНоменклатурыПолямиЦенообразования(
		Объект, СтрокаТабличнойЧасти, СтруктураДанные);
	СтруктураДанные.Вставить("ВидЦен", ВидЦенДляРасчета);

	Если СтрокаТабличнойЧасти.АС_ЦенаИзЗаказаПоставщика
		И СтрокаТабличнойЧасти.АС_ИсходнаяЦенаЗаказаПоставщика > 0 Тогда
		ЦенаПоУмолчанию = АС_РассчитатьЦенуПоЦенеПоставщикаНаСервере(
			СтрокаТабличнойЧасти.АС_ИсходнаяЦенаЗаказаПоставщика,
			СтрокаТабличнойЧасти.Номенклатура, ВидЦенДляРасчета, СтрокаТабличнойЧасти.Характеристика);
	Иначе
		ЦенаПоУмолчанию = АС_ПолучитьЦенуПоВидуЦен(СтруктураДанные);
	КонецЕсли;
	Если ЦенаПоУмолчанию <> 0 Или Принудительно Тогда
		СтрокаТабличнойЧасти.Цена = ЦенаПоУмолчанию;
		СтрокаТабличнойЧасти.АС_ПримененныйВидЦен = ВидЦенДляРасчета;
		СтрокаТабличнойЧасти.АС_ЦенаПоВидуЦенКонтрагента = ЦенаПоУмолчанию <> 0
			И АС_ЭтоВидЦенКонтрагента(ВидЦенДляРасчета);
		РассчитатьСуммуВСтрокеТабличнойЧасти("Запасы", СтрокаТабличнойЧасти);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_ЗаполнитьЦеныТоваровПослеСканирования()

	Если Не ЗначениеЗаполнено(Объект.Контрагент) Тогда
		Возврат;
	КонецЕсли;

	ИзменениеСтоимостиНачато = АС_НачатьИзменениеСтоимости(Неопределено);
	Попытка
		ВидЦенДляРасчета = АС_ПолучитьВидЦенДляРасчета();
		Для Каждого СтрокаТовара Из Объект.Запасы Цикл
			АС_ЗаполнитьЦенуТовараПоВидуЦен(СтрокаТовара, Ложь, ВидЦенДляРасчета);
			Если Не ЗначениеЗаполнено(СтрокаТовара.АС_ПримененныйВидЦен)
				И ТипЗнч(СтрокаТовара.Номенклатура) = Тип("СправочникСсылка.Номенклатура")
				И СтрокаТовара.ТипНоменклатурыЗапас Тогда
				АС_УстановитьВидЦенСтрокиЗапаса(СтрокаТовара);
			КонецЕсли;
		КонецЦикла;
	Исключение
		АС_ЗавершитьИзменениеСтоимости(ИзменениеСтоимостиНачато, Ложь);
		ВызватьИсключение;
	КонецПопытки;
	АС_ЗавершитьИзменениеСтоимости(ИзменениеСтоимостиНачато);

КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_ПолучитьЦенуПоВидуЦен(СтруктураДанные)

	Если Не СтруктураДанные.Свойство("ВидЦен")
		Или Не ЗначениеЗаполнено(СтруктураДанные.ВидЦен) Тогда
		Возврат 0;
	КонецЕсли;

	Возврат ЦенообразованиеСервер.ПолучитьЦенуНоменклатурыПоВидуЦен(СтруктураДанные);

КонецФункции

&НаКлиенте
&После("ЗапасыХарактеристикаПриИзменении")
Процедура АС_ЗапасыХарактеристикаПриИзмененииПосле(Элемент)
	АС_УстановитьВидЦенСтрокиЗапаса(Элементы.Запасы.ТекущиеДанные);
	АС_ПересчитатьДоступность(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура АС_ОткрытьФормуЦеныИВалютаЗавершениеПосле(РезультатФормыЦеныИВалюта, ДополнительныеПараметры)
	Если ТипЗнч(РезультатФормыЦеныИВалюта) = Тип("Структура")
		И РезультатФормыЦеныИВалюта.БылиВнесеныИзменения
		И ЗначениеЗаполнено(РезультатФормыЦеныИВалюта.ВидЦен) Тогда
		Если РезультатФормыЦеныИВалюта.ПерезаполнитьЦены Тогда
			АС_ПересчитатьПоставочныеЦены(РезультатФормыЦеныИВалюта.ВидЦен);
		КонецЕсли;
		АС_УстановитьВидЦенСтрокЗапасов(РезультатФормыЦеныИВалюта.ВидЦен);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура АС_РассчитатьЦенуОтЗаказаПоставщика(СтрокаТабличнойЧасти, ЦенаПоставщика = Неопределено)

	Если СтрокаТабличнойЧасти = Неопределено
		Или ТипЗнч(СтрокаТабличнойЧасти.Номенклатура) <> Тип("СправочникСсылка.Номенклатура")
		Или Не СтрокаТабличнойЧасти.ТипНоменклатурыЗапас Тогда
		Возврат;
	КонецЕсли;

	ВидЦенДляРасчета = АС_ПолучитьВидЦенДляРасчета();
	Если Не ЗначениеЗаполнено(ВидЦенДляРасчета) Тогда
		Возврат;
	КонецЕсли;

	Если ЦенаПоставщика = Неопределено Тогда
		ЦенаПоставщика = АС_ПолучитьЦенуИзБуфераЗаказаПоставщикаНаСервере(
			СтрокаТабличнойЧасти.Номенклатура,
			СтрокаТабличнойЧасти.Характеристика);
	КонецЕсли;
	СтрокаТабличнойЧасти.Цена = АС_РассчитатьЦенуПоЦенеПоставщикаНаСервере(
		ЦенаПоставщика,
		СтрокаТабличнойЧасти.Номенклатура,
		ВидЦенДляРасчета, СтрокаТабличнойЧасти.Характеристика);
	СтрокаТабличнойЧасти.АС_ПримененныйВидЦен = ВидЦенДляРасчета;
	СтрокаТабличнойЧасти.АС_ЦенаИзЗаказаПоставщика = Истина;
	СтрокаТабличнойЧасти.АС_ЦенаПоВидуЦенКонтрагента = Ложь;
	СтрокаТабличнойЧасти.АС_ИсходнаяЦенаЗаказаПоставщика = ЦенаПоставщика;
	РассчитатьСуммуВСтрокеТабличнойЧасти("Запасы", СтрокаТабличнойЧасти);

КонецПроцедуры

&НаКлиенте
Процедура АС_СинхронизироватьСуществующиеСтрокиИзЗаказаПоставщика()

	Если Не АС_АвтозаполнениеИзЗаказаПоставщика Тогда
		Возврат;
	КонецЕсли;

	ИзмененныеСтроки = АС_СинхронизироватьСуществующиеСтрокиИзЗаказаПоставщикаНаСервере();
	Для Каждого ДанныеСтроки Из ИзмененныеСтроки Цикл
		Если ДанныеСтроки.Действие = "Отмена" И ДанныеСтроки.Количество > 0 Тогда
			АС_ОтменитьКоличествоИзЗаказаПоставщика(ДанныеСтроки);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ДанныеСтроки Из ИзмененныеСтроки Цикл
		Если ДанныеСтроки.Действие = "УдалитьВклад" И ДанныеСтроки.Количество > 0 Тогда
			АС_УдалитьВкладЗаказаПоставщика(ДанныеСтроки);
		КонецЕсли;
	КонецЦикла;

	АС_ОбновитьИтогиПослеИзмененияСтоимости();

КонецПроцедуры

&НаКлиенте
Процедура АС_УдалитьВкладЗаказаПоставщика(ДанныеСтроки)

	Для Каждого СтрокаТовара Из Объект.Запасы Цикл
		Если СтрокаТовара.АС_ИдентификаторГруппыПоставок <>
			ДанныеСтроки.ИдентификаторГруппы Тогда
			Продолжить;
		КонецЕсли;

		Если ДанныеСтроки.Количество >= СтрокаТовара.Количество Тогда
			Объект.Запасы.Удалить(СтрокаТовара);
		Иначе
			СтрокаТовара.Количество = СтрокаТовара.Количество - ДанныеСтроки.Количество;
			РассчитатьСуммуВСтрокеТабличнойЧасти("Запасы", СтрокаТовара);
		КонецЕсли;
		Возврат;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура АС_ОтменитьКоличествоИзЗаказаПоставщика(ДанныеСтроки)

	ОсталосьОтменить = ДанныеСтроки.Количество;
	Для Каждого СтрокаТовара Из Объект.Запасы Цикл
		Если СтрокаТовара.АС_ИдентификаторГруппыПоставок <>
			ДанныеСтроки.ИдентификаторГруппы Тогда
			Продолжить;
		КонецЕсли;

		КоличествоКОтмене = Мин(ОсталосьОтменить, СтрокаТовара.Количество);
		Если КоличествоКОтмене = СтрокаТовара.Количество Тогда
			СтрокаТовара.АС_ЗаказПоставщику = ДанныеСтроки.ЗаказПоставщику;
			СтрокаТовара.АС_КлючСвязиЗаказаПоставщику = ДанныеСтроки.КлючСвязиЗаказаПоставщику;
			СтрокаТовара.АС_ИсходнаяЦенаЗаказаПоставщика = ДанныеСтроки.ЦенаПоставщика;
			СтрокиОбработки = Новый Массив;
			СтрокиОбработки.Добавить(СтрокаТовара.ПолучитьИдентификатор());
			ОбработатьОтменуТоваров(СтрокиОбработки);
		Иначе
			ИдентификаторыСуществующихСтрок = Новый Соответствие;
			Для Каждого СуществующаяСтрока Из Объект.Запасы Цикл
				ИдентификаторыСуществующихСтрок.Вставить(СуществующаяСтрока.ПолучитьИдентификатор(), Истина);
			КонецЦикла;

			ПараметрыРазделения = Новый Структура(
				"СтрокаТабличнойЧасти", СтрокаТовара);
			РазбитьСтрокуТабличнойЧастиЗавершение(КоличествоКОтмене, ПараметрыРазделения);

			НоваяСтрока = Неопределено;
			Для Каждого СтрокаПослеРазделения Из Объект.Запасы Цикл
				Если ИдентификаторыСуществующихСтрок.Получить(
						СтрокаПослеРазделения.ПолучитьИдентификатор()) = Неопределено Тогда
					НоваяСтрока = СтрокаПослеРазделения;
					Прервать;
				КонецЕсли;
			КонецЦикла;

			Если НоваяСтрока = Неопределено Тогда
				Сообщить("Не удалось создать строку для отмены товара из заказа поставщика.");
				Возврат;
			КонецЕсли;
			НоваяСтрока.АС_ЗаказПоставщику = ДанныеСтроки.ЗаказПоставщику;
			НоваяСтрока.АС_КлючСвязиЗаказаПоставщику = ДанныеСтроки.КлючСвязиЗаказаПоставщику;
			НоваяСтрока.АС_ИсходнаяЦенаЗаказаПоставщика = ДанныеСтроки.ЦенаПоставщика;

			СтрокиОбработки = Новый Массив;
			СтрокиОбработки.Добавить(НоваяСтрока.ПолучитьИдентификатор());
			ОбработатьОтменуТоваров(СтрокиОбработки);
		КонецЕсли;

		ОсталосьОтменить = ОсталосьОтменить - КоличествоКОтмене;
		Если ОсталосьОтменить = 0 Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;

	Сообщить("Не удалось полностью перенести отмену товара из заказа поставщика.");

КонецПроцедуры

&НаСервере
Процедура АС_МигрироватьСвязиСтрокЗаказаПоставщикаНаСервере()

	ИндексСвязи = Объект.АС_ИсточникиПоставок.Количество() - 1;
	Пока ИндексСвязи >= 0 Цикл
		СвязьПоставки = Объект.АС_ИсточникиПоставок[ИндексСвязи];
		СтрокаПоСвязиСуществует = Ложь;
		Для Каждого СтрокаПокупателя Из Объект.Запасы Цикл
			Если СтрокаПокупателя.АС_ИдентификаторГруппыПоставок =
				СвязьПоставки.ИдентификаторСтрокиПокупателя Тогда
				СтрокаПоСвязиСуществует = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не СтрокаПоСвязиСуществует Тогда
			Объект.АС_ИсточникиПоставок.Удалить(СвязьПоставки);
		КонецЕсли;
		ИндексСвязи = ИндексСвязи - 1;
	КонецЦикла;
	Если Объект.АС_ИсточникиПоставок.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаПокупателя Из Объект.Запасы Цикл
		Если Не ЗначениеЗаполнено(СтрокаПокупателя.АС_ЗаказПоставщику) Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаПокупателя.АС_ИдентификаторГруппыПоставок) Тогда
			СтрокаПокупателя.АС_ИдентификаторГруппыПоставок = Строка(Новый УникальныйИдентификатор);
		КонецЕсли;

		СвязьУжеЕсть = Ложь;
		Для Каждого СвязьПоставки Из Объект.АС_ИсточникиПоставок Цикл
			Если СвязьПоставки.ЗаказПоставщику = СтрокаПокупателя.АС_ЗаказПоставщику
				И СвязьПоставки.КлючСвязиЗаказаПоставщику =
					СтрокаПокупателя.АС_КлючСвязиЗаказаПоставщику Тогда
				СвязьУжеЕсть = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если СвязьУжеЕсть Тогда
			Продолжить;
		КонецЕсли;

		НоваяСвязь = Объект.АС_ИсточникиПоставок.Добавить();
		НоваяСвязь.ИдентификаторСтрокиПокупателя = СтрокаПокупателя.АС_ИдентификаторГруппыПоставок;
		НоваяСвязь.ЗаказПоставщику = СтрокаПокупателя.АС_ЗаказПоставщику;
		НоваяСвязь.КлючСвязиЗаказаПоставщику = СтрокаПокупателя.АС_КлючСвязиЗаказаПоставщику;
		НоваяСвязь.Количество = СтрокаПокупателя.Количество;
		НоваяСвязь.ЦенаПоставщика = СтрокаПокупателя.АС_ИсходнаяЦенаЗаказаПоставщика;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция АС_СинхронизироватьСуществующиеСтрокиИзЗаказаПоставщикаНаСервере()

	Результат = Новый Массив;
	СкопированныеСтроки = ХранилищеОбщихНастроек.Загрузить(
		"БуферОбменаТабличныеЧасти", "Строки");
	Если СкопированныеСтроки = Неопределено
		Или СкопированныеСтроки.Колонки.Найти("АС_ИсточникЗаказПоставщика") = Неопределено
		Или СкопированныеСтроки.Колонки.Найти("АС_ЗаказПоставщику") = Неопределено
		Или СкопированныеСтроки.Колонки.Найти("АС_КлючСвязиЗаказаПоставщику") = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	АС_МигрироватьСвязиСтрокЗаказаПоставщикаНаСервере();
	ЕстьКолонкаОтмены = СкопированныеСтроки.Колонки.Найти("АС_ОтменитьВЗаказеПокупателя") <> Неопределено;
	ЕстьКолонкаУдаления = СкопированныеСтроки.Колонки.Найти("АС_УдалитьИзЗаказаПокупателя") <> Неопределено;

	СтрокиОтмены = Новый Массив;
	Для Каждого СтрокаПоставщика Из СкопированныеСтроки Цикл
		Если Не СтрокаПоставщика.АС_ИсточникЗаказПоставщика
			Или Не ЕстьКолонкаОтмены
			Или Не СтрокаПоставщика.АС_ОтменитьВЗаказеПокупателя Тогда
			Продолжить;
		КонецЕсли;

		ДанныеОтмены = Неопределено;
		Для Каждого ДанныеОтменыПоиска Из СтрокиОтмены Цикл
			Если ДанныеОтменыПоиска.ЗаказПоставщику = СтрокаПоставщика.АС_ЗаказПоставщику
				И ДанныеОтменыПоиска.КлючСвязиЗаказаПоставщику = СтрокаПоставщика.АС_КлючСвязиЗаказаПоставщику
				И ДанныеОтменыПоиска.ЦенаПоставщика = СтрокаПоставщика.АС_ЦенаЗаказаПоставщика Тогда
				ДанныеОтмены = ДанныеОтменыПоиска;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ДанныеОтмены = Неопределено Тогда
			ДанныеОтмены = Новый Структура(
				"Номенклатура,Характеристика,ЗаказПоставщику,КлючСвязиЗаказаПоставщику,ЦенаПоставщика,Количество",
				СтрокаПоставщика.Номенклатура,
				СтрокаПоставщика.Характеристика,
				СтрокаПоставщика.АС_ЗаказПоставщику,
				СтрокаПоставщика.АС_КлючСвязиЗаказаПоставщику,
				СтрокаПоставщика.АС_ЦенаЗаказаПоставщика,
				0);
			СтрокиОтмены.Добавить(ДанныеОтмены);
		КонецЕсли;
		ДанныеОтмены.Количество = ДанныеОтмены.Количество + СтрокаПоставщика.Количество;
	КонецЦикла;

	Для Каждого ДанныеОтмены Из СтрокиОтмены Цикл
		КоличествоУжеОтменено = 0;
		Для Каждого СтрокаОтменыПокупателя Из Объект.ОтмененныеЗапасы Цикл
			Если СтрокаОтменыПокупателя.Номенклатура = ДанныеОтмены.Номенклатура
				И СтрокаОтменыПокупателя.Характеристика = ДанныеОтмены.Характеристика
				И СтрокаОтменыПокупателя.АС_ЗаказПоставщику = ДанныеОтмены.ЗаказПоставщику
				И СтрокаОтменыПокупателя.АС_КлючСвязиЗаказаПоставщику = ДанныеОтмены.КлючСвязиЗаказаПоставщику
				И СтрокаОтменыПокупателя.АС_ЦенаИзЗаказаПоставщика
				И СтрокаОтменыПокупателя.АС_ИсходнаяЦенаЗаказаПоставщика = ДанныеОтмены.ЦенаПоставщика Тогда
				КоличествоУжеОтменено = КоличествоУжеОтменено + СтрокаОтменыПокупателя.Количество;
			КонецЕсли;
		КонецЦикла;
		ОсталосьОтменить = Макс(0, ДанныеОтмены.Количество - КоличествоУжеОтменено);

		ИндексСвязи = Объект.АС_ИсточникиПоставок.Количество() - 1;
		Пока ИндексСвязи >= 0 И ОсталосьОтменить > 0 Цикл
			СвязьПоставки = Объект.АС_ИсточникиПоставок[ИндексСвязи];
			Если СвязьПоставки.ЗаказПоставщику = ДанныеОтмены.ЗаказПоставщику
				И СвязьПоставки.КлючСвязиЗаказаПоставщику = ДанныеОтмены.КлючСвязиЗаказаПоставщику
				И СвязьПоставки.ЦенаПоставщика = ДанныеОтмены.ЦенаПоставщика Тогда
				КоличествоКОтмене = Мин(ОсталосьОтменить, СвязьПоставки.Количество);
				Результат.Добавить(Новый Структура(
					"Действие,ИдентификаторГруппы,Номенклатура,Характеристика,ЗаказПоставщику,КлючСвязиЗаказаПоставщику,ЦенаПоставщика,Количество",
					"Отмена",
					СвязьПоставки.ИдентификаторСтрокиПокупателя,
					ДанныеОтмены.Номенклатура,
					ДанныеОтмены.Характеристика,
					ДанныеОтмены.ЗаказПоставщику,
					ДанныеОтмены.КлючСвязиЗаказаПоставщику,
					ДанныеОтмены.ЦенаПоставщика,
					КоличествоКОтмене));
				ОсталосьОтменить = ОсталосьОтменить - КоличествоКОтмене;
				Если КоличествоКОтмене = СвязьПоставки.Количество Тогда
					Объект.АС_ИсточникиПоставок.Удалить(СвязьПоставки);
				Иначе
					СвязьПоставки.Количество = СвязьПоставки.Количество - КоличествоКОтмене;
				КонецЕсли;
			КонецЕсли;
			ИндексСвязи = ИндексСвязи - 1;
		КонецЦикла;
	КонецЦикла;

	ИндексСтроки = СкопированныеСтроки.Количество() - 1;
	Пока ИндексСтроки >= 0 Цикл
		СтрокаПоставщика = СкопированныеСтроки[ИндексСтроки];
		Если СтрокаПоставщика.АС_ИсточникЗаказПоставщика Тогда
			Если ЕстьКолонкаУдаления И СтрокаПоставщика.АС_УдалитьИзЗаказаПокупателя Тогда
				СвязьУдалена = Ложь;
				ИндексСвязи = Объект.АС_ИсточникиПоставок.Количество() - 1;
				Пока ИндексСвязи >= 0 Цикл
					СвязьПоставки = Объект.АС_ИсточникиПоставок[ИндексСвязи];
					Если СвязьПоставки.ЗаказПоставщику = СтрокаПоставщика.АС_ЗаказПоставщику
						И СвязьПоставки.КлючСвязиЗаказаПоставщику =
							СтрокаПоставщика.АС_КлючСвязиЗаказаПоставщику Тогда
						Результат.Добавить(Новый Структура(
							"Действие,ИдентификаторГруппы,Количество",
							"УдалитьВклад",
							СвязьПоставки.ИдентификаторСтрокиПокупателя,
							СвязьПоставки.Количество));
						Объект.АС_ИсточникиПоставок.Удалить(СвязьПоставки);
						СвязьУдалена = Истина;
					КонецЕсли;
					ИндексСвязи = ИндексСвязи - 1;
				КонецЦикла;
				Если Не СвязьУдалена Тогда
					Для Каждого СтрокаПокупателя Из Объект.Запасы Цикл
						Если СтрокаПокупателя.АС_ЗаказПоставщику = СтрокаПоставщика.АС_ЗаказПоставщику
							И СтрокаПокупателя.АС_КлючСвязиЗаказаПоставщику =
								СтрокаПоставщика.АС_КлючСвязиЗаказаПоставщику Тогда
							Результат.Добавить(Новый Структура(
								"Действие,ИдентификаторГруппы,Количество",
								"УдалитьВклад",
								СтрокаПокупателя.АС_ИдентификаторГруппыПоставок,
								СтрокаПокупателя.Количество));
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				СкопированныеСтроки.Удалить(СтрокаПоставщика);
				ИндексСтроки = ИндексСтроки - 1;
				Продолжить;
			КонецЕсли;

			Если ЕстьКолонкаОтмены И СтрокаПоставщика.АС_ОтменитьВЗаказеПокупателя Тогда
				СкопированныеСтроки.Удалить(СтрокаПоставщика);
				ИндексСтроки = ИндексСтроки - 1;
				Продолжить;
			КонецЕсли;

			СвязьНайдена = Ложь;
			КоличествоВСвязях = 0;
			ЦенаВСвязяхСовпадает = Истина;
			Для Каждого СвязьПоставки Из Объект.АС_ИсточникиПоставок Цикл
				Если СвязьПоставки.ЗаказПоставщику = СтрокаПоставщика.АС_ЗаказПоставщику
					И СвязьПоставки.КлючСвязиЗаказаПоставщику = СтрокаПоставщика.АС_КлючСвязиЗаказаПоставщику Тогда
					СвязьНайдена = Истина;
					КоличествоВСвязях = КоличествоВСвязях + СвязьПоставки.Количество;
					ЦенаВСвязяхСовпадает = ЦенаВСвязяхСовпадает
						И СвязьПоставки.ЦенаПоставщика = СтрокаПоставщика.АС_ЦенаЗаказаПоставщика;
				КонецЕсли;
			КонецЦикла;

			Если СвязьНайдена
				И КоличествоВСвязях = СтрокаПоставщика.Количество
				И ЦенаВСвязяхСовпадает Тогда
				СкопированныеСтроки.Удалить(СтрокаПоставщика);
			ИначеЕсли СвязьНайдена Тогда
				ИндексСвязи = Объект.АС_ИсточникиПоставок.Количество() - 1;
				Пока ИндексСвязи >= 0 Цикл
					СвязьПоставки = Объект.АС_ИсточникиПоставок[ИндексСвязи];
					Если СвязьПоставки.ЗаказПоставщику = СтрокаПоставщика.АС_ЗаказПоставщику
						И СвязьПоставки.КлючСвязиЗаказаПоставщику = СтрокаПоставщика.АС_КлючСвязиЗаказаПоставщику Тогда
						Результат.Добавить(Новый Структура(
							"Действие,ИдентификаторГруппы,Количество",
							"УдалитьВклад",
							СвязьПоставки.ИдентификаторСтрокиПокупателя,
							СвязьПоставки.Количество));
						Объект.АС_ИсточникиПоставок.Удалить(СвязьПоставки);
					КонецЕсли;
					ИндексСвязи = ИндексСвязи - 1;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		ИндексСтроки = ИндексСтроки - 1;
	КонецЦикла;

	ХранилищеОбщихНастроек.Сохранить("БуферОбменаТабличныеЧасти", "Строки", СкопированныеСтроки);
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция АС_ПолучитьЦеныИзБуфераЗаказаПоставщикаНаСервере()

	Результат = Новый Массив;
	СкопированныеСтроки = ХранилищеОбщихНастроек.Загрузить(
		"БуферОбменаТабличныеЧасти", "Строки");
	Если СкопированныеСтроки = Неопределено
		Или СкопированныеСтроки.Колонки.Найти("АС_ЦенаЗаказаПоставщика") = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Строка Из СкопированныеСтроки Цикл
		Если Строка.АС_ИсточникЗаказПоставщика Тогда
			Результат.Добавить(Строка.АС_ЦенаЗаказаПоставщика);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция АС_БуферСодержитСтрокиЗаказаПоставщикаНаСервере()

	СкопированныеСтроки = ХранилищеОбщихНастроек.Загрузить(
		"БуферОбменаТабличныеЧасти", "Строки");
	Если СкопированныеСтроки = Неопределено
		Или СкопированныеСтроки.Колонки.Найти("АС_ИсточникЗаказПоставщика") = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Строка Из СкопированныеСтроки Цикл
		Если Строка.АС_ИсточникЗаказПоставщика Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

&НаСервереБезКонтекста
Функция АС_ПолучитьЦенуИзБуфераЗаказаПоставщикаНаСервере(Номенклатура, Характеристика)

	СкопированныеСтроки = ХранилищеОбщихНастроек.Загрузить(
		"БуферОбменаТабличныеЧасти", "Строки");
	Если СкопированныеСтроки = Неопределено
		Или СкопированныеСтроки.Колонки.Найти("АС_ЦенаЗаказаПоставщика") = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Для Каждого Строка Из СкопированныеСтроки Цикл
		Если Строка.Номенклатура = Номенклатура
			И Строка.Характеристика = Характеристика Тогда
			Возврат Строка.АС_ЦенаЗаказаПоставщика;
		КонецЕсли;
	КонецЦикла;

	Возврат 0;

КонецФункции

&НаСервереБезКонтекста
Функция АС_РассчитатьЦенуПоЦенеПоставщикаНаСервере(ЦенаПоставщика, Номенклатура, ВидЦен,
	Характеристика = Неопределено)

	Возврат АС_ЦенообразованиеСервер.ЦенаПоЦенеПоставщика(
		ЦенаПоставщика, Номенклатура, ВидЦен, Характеристика);

КонецФункции

&НаКлиенте
Процедура АС_ОпределитьНеобходимостьПересчетаДокументаПоУсловиямДоговораПосле(
	РезультатЗакрытия, ДополнительныеПараметры)

	Если РезультатЗакрытия <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Если ДополнительныеПараметры.ПересчетНеобходимПоЗапасам Тогда
		АС_ПересчитатьПоставочныеЦены(АС_ПолучитьВидЦенДляРасчета());
	КонецЕсли;
	АС_УстановитьВидЦенСтрокЗапасов();

КонецПроцедуры

&НаКлиенте
&После("ЗапасыЦенаПриИзменении")
Процедура АС_ЗапасыЦенаПриИзмененииПосле(Элемент)

	Если АС_ВыполняетсяАвтоматическийПересчетЦен = Истина Тогда
		Возврат;
	КонецЕсли;

	СтрокаТабличнойЧасти = Элементы.Запасы.ТекущиеДанные;
	Если СтрокаТабличнойЧасти <> Неопределено Тогда
		СтрокаТабличнойЧасти.АС_ЦенаИзЗаказаПоставщика = Ложь;
		АС_УстановитьВидЦенСтрокиЗапаса(СтрокаТабличнойЧасти);
		СтрокаТабличнойЧасти.АС_ЦенаПоВидуЦенКонтрагента = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&После("ЗапасыКоличествоПриИзменении")
Процедура АС_ЗапасыКоличествоПриИзмененииПосле(Элемент)
	АС_ПересчитатьДоступность(Ложь);
КонецПроцедуры

&НаКлиенте
&После("РазбитьСтрокуТабличнойЧастиЗавершение")
Процедура АС_ИсправитьКоличествоЧастичнойОтменыПослеРазделения(Результат, Параметры)

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТекущаяСтрока = Элементы.Запасы.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено
		Или ТекущаяСтрока.Отменен <> 1
		Или ТекущаяСтрока.Количество = ТекущаяСтрока.КоличествоДоОтмены Тогда
		Возврат;
	КонецЕсли;

	ТекущаяСтрока.КоличествоДоОтмены = ТекущаяСтрока.Количество;
	ТекущаяСтрока.КоличествоДоОтменыСтрокой = Формат(
		ТекущаяСтрока.Количество, "ЧДЦ=3");

	СтрокиОтмененныхЗапасов = Объект.ОтмененныеЗапасы.НайтиСтроки(
		Новый Структура("КлючСвязиОтмененные", ТекущаяСтрока.КлючСвязиОтмененные));
	Если СтрокиОтмененныхЗапасов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ОтмененныйЗапас = СтрокиОтмененныхЗапасов[0];
	ОтмененныйЗапас.Количество = ТекущаяСтрока.Количество;

КонецПроцедуры

&НаКлиенте
Процедура АС_ОтменитьТоварыПоВозвратуПокупателя(СтрокиОтмены)

	ЕстьИзменения = Ложь;
	Для Каждого СтрокаОтмены Из СтрокиОтмены Цикл
		ОсталосьОтменить = СтрокаОтмены.Количество;
		Для Каждого СтрокаТовара Из Объект.Запасы Цикл
			Если СтрокаТовара.Отменен = 1
				Или СтрокаТовара.Номенклатура <> СтрокаОтмены.Номенклатура
				Или СтрокаТовара.Характеристика <> СтрокаОтмены.Характеристика
				Или СтрокаТовара.Цена <> СтрокаОтмены.Цена Тогда
				Продолжить;
			КонецЕсли;

			КоличествоКОтмене = Мин(ОсталосьОтменить, СтрокаТовара.Количество);
			Если КоличествоКОтмене = СтрокаТовара.Количество Тогда
				СтрокиОбработки = Новый Массив;
				СтрокиОбработки.Добавить(СтрокаТовара.ПолучитьИдентификатор());
				ОбработатьОтменуТоваров(СтрокиОбработки);
			Иначе
				ИдентификаторыСуществующихСтрок = Новый Соответствие;
				Для Каждого СуществующаяСтрока Из Объект.Запасы Цикл
					ИдентификаторыСуществующихСтрок.Вставить(
						СуществующаяСтрока.ПолучитьИдентификатор(), Истина);
				КонецЦикла;

				ПараметрыРазделения = Новый Структура(
					"СтрокаТабличнойЧасти", СтрокаТовара);
				РазбитьСтрокуТабличнойЧастиЗавершение(
					КоличествоКОтмене, ПараметрыРазделения);

				НоваяСтрока = Неопределено;
				Для Каждого СтрокаПослеРазделения Из Объект.Запасы Цикл
					Если ИдентификаторыСуществующихСтрок.Получить(
							СтрокаПослеРазделения.ПолучитьИдентификатор()) = Неопределено Тогда
						НоваяСтрока = СтрокаПослеРазделения;
						Прервать;
					КонецЕсли;
				КонецЦикла;

				Если НоваяСтрока = Неопределено Тогда
					Сообщить("Не удалось создать строку для отмены товара по возврату покупателя.");
					Прервать;
				КонецЕсли;

				СтрокиОбработки = Новый Массив;
				СтрокиОбработки.Добавить(НоваяСтрока.ПолучитьИдентификатор());
				ОбработатьОтменуТоваров(СтрокиОбработки);
			КонецЕсли;

			ЕстьИзменения = Истина;
			ОсталосьОтменить = ОсталосьОтменить - КоличествоКОтмене;
			Если ОсталосьОтменить = 0 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если ОсталосьОтменить > 0 Тогда
			Сообщить("Не удалось полностью отменить товар по возврату покупателя: "
				+ Строка(СтрокаОтмены.Номенклатура) + ".");
		КонецЕсли;
	КонецЦикла;

	Если ЕстьИзменения Тогда
		Модифицированность = Истина;
		АС_ПересчитатьДоступность(Ложь);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&Перед("ПолученыШтрихкоды")
Процедура АС_ПолученыШтрихкодыПеред(ДанныеШтрихкодов)
	АС_БезопасноеОбновлениеКлиент.ОтметитьСканирование(АС_СостояниеФоновогоОбновления);
	АС_СинхронизироватьВидЦенДокумента();
	АС_КоличествоСтрокЗапасовДоСканирования = Объект.Запасы.Количество();
КонецПроцедуры

&НаКлиенте
&Перед("ПолученыШтрихкодыЗавершение")
Процедура АС_ПолученыШтрихкодыЗавершениеПеред(ВозвращаемыеПараметры, Параметры)
