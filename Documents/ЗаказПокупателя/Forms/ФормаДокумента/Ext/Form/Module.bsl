&НаСервереБезКонтекста
Функция АС_ПолучитьРазрешенныеВидыЦен()

	РазрешенныеВидыЦен = УправлениеДоступом.РазрешенныеЗначенияДляДинамическогоСписка(
		"Справочник.ВидыЦен",
		Тип("СправочникСсылка.ВидыЦен"),
		Неопределено,
		Истина);

	Если РазрешенныеВидыЦен <> Неопределено
		И РазрешенныеВидыЦен.Количество() = 0 Тогда
		Возврат Новый ФиксированныйМассив(Новый Массив);
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|    ВидыЦен.Ссылка
	|ИЗ
	|    Справочник.ВидыЦен КАК ВидыЦен
	|ГДЕ
	|    НЕ ВидыЦен.ПометкаУдаления";

	Если РазрешенныеВидыЦен <> Неопределено Тогда
		Запрос.Текст = Запрос.Текст
			+ "
			|    И ВидыЦен.Ссылка В (&РазрешенныеВидыЦен)";
		Запрос.УстановитьПараметр("РазрешенныеВидыЦен", РазрешенныеВидыЦен);
	КонецЕсли;

	Выборка = Запрос.Выполнить().Выбрать();
	ВидыЦен = Новый Массив;

	Пока Выборка.Следующий() Цикл
		ВидыЦен.Добавить(Выборка.Ссылка);
	КонецЦикла;

	Возврат Новый ФиксированныйМассив(ВидыЦен);

КонецФункции

&НаСервереБезКонтекста
Функция АС_ПолучитьНоменклатуруСОстатком(ОрганизацияДокумента, Склад, ТекущийЗаказ)

	ДоступнаяНоменклатура = Новый Массив;
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|    Номенклатура.Ссылка КАК Номенклатура
	|ИЗ
	|    Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|    НЕ Номенклатура.ПометкаУдаления
	|    И Номенклатура.ТипНоменклатуры <> ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)";

	Если ЗначениеЗаполнено(ОрганизацияДокумента) Тогда
		Организация = Константы.УчетПоКомпании.Компания(ОрганизацияДокумента);
		Если ПолучитьФункциональнуюОпцию("ПередачаТоваровМеждуОрганизациями") Тогда
			ОрганизацииОстатков = ИнтеркампаниСервер.ОрганизацииОстатков(Организация);
		Иначе
			ОрганизацииОстатков = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Организация);
		КонецЕсли;

		Если Не ЗначениеЗаполнено(ТекущийЗаказ) Тогда
			ТекущийЗаказ = ПредопределенноеЗначение("Документ.ЗаказПокупателя.ПустаяСсылка");
		КонецЕсли;

		ТекстУсловияСклада = "";
		Если ЗначениеЗаполнено(Склад) Тогда
			ТекстУсловияСклада =
			"
			|                И СтруктурнаяЕдиница = &Склад";
		КонецЕсли;

		ТекстЗапроса = ТекстЗапроса
			+ "
			|ОБЪЕДИНИТЬ
			|
			|ВЫБРАТЬ
			|    ЗапасыОстатки.Номенклатура
			|ИЗ
			|    РегистрНакопления.Запасы.Остатки(
			|            ,
			|            Организация В (&ОрганизацииОстатков)
			|                И (ЗаказПокупателя = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
			|                    ИЛИ ЗаказПокупателя = &ТекущийЗаказ)
			|                И ТИПЗНАЧЕНИЯ(СтруктурнаяЕдиница) = ТИП(Справочник.СтруктурныеЕдиницы)"
			+ ТекстУсловияСклада
			+ ") КАК ЗапасыОстатки
			|        ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК НоменклатураСправочника
			|        ПО ЗапасыОстатки.Номенклатура = НоменклатураСправочника.Ссылка
			|            И НЕ НоменклатураСправочника.ПометкаУдаления
			|            И НоменклатураСправочника.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)
			|
			|СГРУППИРОВАТЬ ПО
			|    ЗапасыОстатки.Номенклатура
			|
			|ИМЕЮЩИЕ
			|    СУММА(ЗапасыОстатки.КоличествоОстаток) > 0";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Если ЗначениеЗаполнено(ОрганизацияДокумента) Тогда
		Запрос.УстановитьПараметр("ОрганизацииОстатков", ОрганизацииОстатков);
		Запрос.УстановитьПараметр("ТекущийЗаказ", ТекущийЗаказ);
		Если ЗначениеЗаполнено(Склад) Тогда
			Запрос.УстановитьПараметр("Склад", Склад);
		КонецЕсли;
	КонецЕсли;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДоступнаяНоменклатура.Добавить(Выборка.Номенклатура);
	КонецЦикла;

	Возврат Новый ФиксированныйМассив(ДоступнаяНоменклатура);

КонецФункции

&НаСервере
Процедура АС_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	АС_ДобавитьРежимОплаты();

	АС_ДобавитьКолонкуБезСкидки();

	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.Ответственный = Неопределено;
	КонецЕсли;

	ПолеОтветственного = Элементы.Добавить("АС_Ответственный", Тип("ПолеФормы"), Элементы.ШапкаПраво);
	ПолеОтветственного.Вид = ВидПоляФормы.ПолеВвода;
	ПолеОтветственного.ПутьКДанным = "Объект.Ответственный";
	ПолеОтветственного.Заголовок = "Ответственный";
	ПолеОтветственного.Ширина = 29;
	Элементы.Переместить(ПолеОтветственного, Элементы.ШапкаПраво, Элементы.ГруппаРеквизитыПечатиЦены);

	ИмяКолонкиСрокаВозврата = "АС_ЗапасыКоличествоДнейДоВозврата";
	КолонкаСрокаВозврата = Элементы.Добавить(
		ИмяКолонкиСрокаВозврата,
		Тип("ПолеФормы"),
		Элементы.Запасы);
	КолонкаСрокаВозврата.Вид = ВидПоляФормы.ПолеВвода;
	КолонкаСрокаВозврата.ПутьКДанным = "Объект.Запасы.АС_ПредставлениеДнейДоВозврата";
	КолонкаСрокаВозврата.Заголовок = "Дней до" + Символы.ПС + "возврата";
	КолонкаСрокаВозврата.Подсказка = "Остаток календарных дней до окончания срока возврата поставщику. Отрицательное значение означает просрочку.";
	КолонкаСрокаВозврата.ТолькоПросмотр = Истина;
	КолонкаСрокаВозврата.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Право;
	КолонкаСрокаВозврата.Ширина = 10;
	Элементы.Переместить(КолонкаСрокаВозврата, Элементы.Запасы, Элементы.ЗапасыЦена);

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("АС_ЗапасыДоступноСУчетомЗаказов");
	ОформляемоеПоле.Использование = Истина;

	ОтборПоОстатку = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборПоОстатку.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Запасы.АС_ДоступноСУчетомЗаказов");
	ОтборПоОстатку.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборПоОстатку.ПравоеЗначение = 0;
	ОтборПоОстатку.Использование = Истина;

	ОтборПоТипу = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборПоТипу.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Запасы.ТипНоменклатурыЗапас");
	ОтборПоТипу.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборПоТипу.ПравоеЗначение = Истина;
	ОтборПоТипу.Использование = Истина;

	АвтозаполнениеИзЗаказаПоставщика = Ложь;
	Если Параметры.Свойство("АС_АвтозаполнениеИзЗаказаПоставщика", АвтозаполнениеИзЗаказаПоставщика) Тогда
		АС_АвтозаполнениеИзЗаказаПоставщика = АвтозаполнениеИзЗаказаПоставщика;
	КонецЕсли;
	СтрокиОтменыВозвратаПокупателя = Неопределено;
	Если Параметры.Свойство("АС_СтрокиОтменыВозвратаПокупателя", СтрокиОтменыВозвратаПокупателя) Тогда
		ТаблицаСтрокОтмены = Новый ТаблицаЗначений;
		ТаблицаСтрокОтмены.Колонки.Добавить("Номенклатура");
		ТаблицаСтрокОтмены.Колонки.Добавить("Характеристика");
		ТаблицаСтрокОтмены.Колонки.Добавить("Цена");
		ТаблицаСтрокОтмены.Колонки.Добавить("Количество");
		Для Каждого СтрокаОтмены Из СтрокиОтменыВозвратаПокупателя Цикл
			НоваяСтрокаОтмены = ТаблицаСтрокОтмены.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаОтмены, СтрокаОтмены);
		КонецЦикла;
		ЗначениеВРеквизитФормы(ТаблицаСтрокОтмены, "АС_СтрокиОтменыВозвратаПокупателя");
	КонецЕсли;
	АС_УстановитьОформлениеБезналПослеСоздания(Отказ, СтандартнаяОбработка);

КонецПроцедуры

&НаСервере
Процедура АС_УстановитьОформлениеБезналПослеСоздания(Отказ, СтандартнаяОбработка)

	ВидЦенБезналичногоРасчета = АС_ПолучитьНастроенныйВидЦенБезналичногоРасчета();
	Если ЗначениеЗаполнено(ВидЦенБезналичногоРасчета) Тогда
		ЭлементОформления = УсловноеОформление.Элементы.Добавить();
		РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
			ЭлементОформления.Отбор,
			"Объект.Запасы.АС_ПримененныйВидЦен",
			ВидЦенБезналичногоРасчета,
			ВидСравненияКомпоновкиДанных.Равно);
		РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
			ЭлементОформления.Отбор,
			"Объект.Запасы.Цена",
			0,
			ВидСравненияКомпоновкиДанных.НеРавно);
		РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
			ЭлементОформления.Отбор,
			"Объект.Запасы.ТипНоменклатурыЗапас",
			Истина);
		РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
			ЭлементОформления.Отбор,
			"Объект.Запасы.АС_ЦенаИзЗаказаПоставщика",
			Ложь);
		РаботаСФормой.ДобавитьОформляемоеПоле(ЭлементОформления, Элементы.ЗапасыЦена.Имя);
		РаботаСФормой.ДобавитьЭлементУсловногоОформления(
			ЭлементОформления,
			"ЦветФона",
			Новый Цвет(223, 255, 223));
	КонецЕсли;

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
		ЭлементОформления.Отбор,
		"Объект.Запасы.АС_ЦенаИзЗаказаПоставщика",
		Истина);
	РаботаСФормой.ДобавитьОформляемоеПоле(ЭлементОформления, Элементы.ЗапасыЦена.Имя);
	РаботаСФормой.ДобавитьЭлементУсловногоОформления(
		ЭлементОформления,
		"ЦветФона",
		Новый Цвет(204, 238, 255));

	АС_УстановитьОформлениеЦеныПоВидуЦенКонтрагента();

	АС_УстановитьОформлениеЗаканчивающихсяТоваров();
	АС_УстановитьОформлениеСрокаВозврата();

КонецПроцедуры

&НаСервере
Процедура АС_УстановитьОформлениеСрокаВозврата()

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
		ЭлементОформления.Отбор,
		"Объект.Запасы.АС_ЕстьСрокВозврата",
		Истина);
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
		ЭлементОформления.Отбор,
		"Объект.Запасы.АС_КоличествоДнейДоВозврата",
		5,
		ВидСравненияКомпоновкиДанных.МеньшеИлиРавно);
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
		ЭлементОформления.Отбор,
		"Объект.СостояниеЗаказа",
		ПредопределенноеЗначение("Справочник.СостоянияЗаказовПокупателей.Завершен"),
		ВидСравненияКомпоновкиДанных.НеРавно);
	РаботаСФормой.ДобавитьОформляемоеПоле(
		ЭлементОформления,
		"АС_ЗапасыКоличествоДнейДоВозврата");
	РаботаСФормой.ДобавитьЭлементУсловногоОформления(
		ЭлементОформления,
		"ЦветФона",
		Новый Цвет(255, 153, 153));

КонецПроцедуры

&НаСервере
Процедура АС_ПриЧтенииНаСервере(ТекущийОбъект)

	Если ЗначениеЗаполнено(АС_АдресСнимкаСтоимости) Тогда
		УдалитьИзВременногоХранилища(АС_АдресСнимкаСтоимости);
	КонецЕсли;
	АС_АдресСнимкаСтоимости = ПоместитьВоВременноеХранилище(
		АС_СоздатьСнимокСтоимости(ТекущийОбъект), УникальныйИдентификатор);
	АС_СтоимостьТребуетСнимка = Истина;

	АС_ЗаполнитьКоличествоДнейДоВозврата();

КонецПроцедуры

&НаСервере
Процедура АС_ЗаполнитьКоличествоДнейДоВозврата()

	СрокиВозврата = АС_УсловияВозвратаПоставщикамСервер.ПолучитьСрокиВозврата(
		Объект.Ссылка, Объект.Запасы, Объект.АС_ИсточникиПоставок);
	Для Каждого СтрокаЗапасов Из Объект.Запасы Цикл
		КоличествоДней = СрокиВозврата.Получить(СтрокаЗапасов.НомерСтроки);
		ЕстьСрок = КоличествоДней <> Неопределено;
		НовоеКоличествоДней = ?(ЕстьСрок, КоличествоДней, 0);
		ПредставлениеДней = ?(ЕстьСрок, Формат(НовоеКоличествоДней, "ЧДЦ=0"), "");
		Если СтрокаЗапасов.АС_КоличествоДнейДоВозврата <> НовоеКоличествоДней Тогда
			СтрокаЗапасов.АС_КоличествоДнейДоВозврата = НовоеКоличествоДней;
		КонецЕсли;
		Если СтрокаЗапасов.АС_ЕстьСрокВозврата <> ЕстьСрок Тогда
			СтрокаЗапасов.АС_ЕстьСрокВозврата = ЕстьСрок;
		КонецЕсли;
		Если СтрокаЗапасов.АС_ПредставлениеДнейДоВозврата <> ПредставлениеДней Тогда
			СтрокаЗапасов.АС_ПредставлениеДнейДоВозврата = ПредставлениеДней;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура АС_УстановитьОформлениеЦеныПоВидуЦенКонтрагента()

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
		ЭлементОформления.Отбор,
		"Объект.Запасы.АС_ЦенаПоВидуЦенКонтрагента",
		Истина);
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
		ЭлементОформления.Отбор,
		"Объект.Запасы.АС_ЦенаИзЗаказаПоставщика",
		Ложь);
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
		ЭлементОформления.Отбор,
		"Объект.Запасы.Цена",
		0,
		ВидСравненияКомпоновкиДанных.НеРавно);
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
		ЭлементОформления.Отбор,
		"Объект.Запасы.ТипНоменклатурыЗапас",
		Истина);
	РаботаСФормой.ДобавитьОформляемоеПоле(ЭлементОформления, Элементы.ЗапасыЦена.Имя);
	РаботаСФормой.ДобавитьЭлементУсловногоОформления(
		ЭлементОформления,
		"ЦветФона",
		Новый Цвет(255, 204, 153));

КонецПроцедуры

&НаСервере
Процедура АС_УстановитьОформлениеЗаканчивающихсяТоваров()

	НастройкиОформления = АС_ИндикацияОстатковСервер.НастройкиОформления();
	Для Каждого ПравилоОформления Из НастройкиОформления.Правила Цикл
		АС_ДобавитьОформлениеЗаканчивающегосяТовара(
			ПравилоОформления.ВерхняяГраница,
			ПравилоОформления.НижняяГраница,
			ПравилоОформления.ЦветФона,
			ПравилоОформления.Номенклатура,
			НастройкиОформления.ИсключенияОбщейИндикации);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура АС_ДобавитьОформлениеЗаканчивающегосяТовара(
	ВерхняяГраница, НижняяГраница, ЦветФона, Номенклатура, ИсключенияОбщейИндикации)

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
		ЭлементОформления.Отбор,
		"Объект.Запасы.АС_ДоступноСУчетомЗаказов",
		ВерхняяГраница,
		ВидСравненияКомпоновкиДанных.МеньшеИлиРавно);
	Если НижняяГраница <> Неопределено Тогда
		РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
			ЭлементОформления.Отбор,
			"Объект.Запасы.АС_ДоступноСУчетомЗаказов",
			НижняяГраница,
			ВидСравненияКомпоновкиДанных.Больше);
	КонецЕсли;
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
			ЭлементОформления.Отбор,
			"Объект.Запасы.Номенклатура",
			Номенклатура);
	ИначеЕсли ИсключенияОбщейИндикации.Количество() > 0 Тогда
		РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
			ЭлементОформления.Отбор,
			"Объект.Запасы.Номенклатура",
			ИсключенияОбщейИндикации,
			ВидСравненияКомпоновкиДанных.НеВСписке);
	КонецЕсли;
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
		ЭлементОформления.Отбор,
		"Объект.Запасы.ТипНоменклатурыЗапас",
		Истина);
	РаботаСФормой.ДобавитьОформляемоеПоле(
		ЭлементОформления,
		"АС_ЗапасыДоступноСУчетомЗаказов");
	РаботаСФормой.ДобавитьЭлементУсловногоОформления(
		ЭлементОформления,
		"ЦветФона",
		ЦветФона);

КонецПроцедуры

&НаКлиенте
&Перед("ПередЗаписью")
Процедура АС_ПередЗаписью(Отказ, ПараметрыЗаписи)

	Если АС_ФормаГотоваКОкруглению = Истина
		И АС_ПересчитываетсяОкруглениеЦен <> Истина
		И Не АС_СтоимостьЗаписанногоДокументаНеИзменена() Тогда
		АС_ВосстановитьЦеныДоОкругления();
	КонецЕсли;
	АС_ОграничитьРучныеСкидкиПередЗаписью();
	АС_ПроверитьПродавцовПередЗаписью(Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.Ответственный) Тогда
		Отказ = Истина;
		Сообщить("Выберите ответственного перед записью или проведением заказа.");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&После("ПередЗаписью")
Процедура АС_ПередЗаписьюПосле(Отказ, ПараметрыЗаписи)

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Если Не АС_СтоимостьЗаписанногоДокументаНеИзменена() Тогда
		АС_ПересчитатьСтоимостьИПроверитьПередЗаписью(Отказ);
	Иначе
		АС_ПроверитьЦеныБезПересчета(Отказ);
		Если Не Отказ И ИспользоватьАвтоматическиеСкидки Тогда
			// У неизменённого сохранённого заказа сохраняем и его рассчитанные скидки.
			Объект.СкидкиРассчитаны = Истина;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&После("ПослеЗаписи")
Процедура АС_ПослеЗаписиПосле(ПараметрыЗаписи)

	// Обновляем отображение по уже сохранённым строкам, без переоценки после записи.
	ПересчетДоОбновления = АС_ПересчитываетсяОкруглениеЦен;
	АС_ПересчитываетсяОкруглениеЦен = Истина;
	Попытка
		АС_ОбновитьИтогиПослеИзмененияСтоимости();
	Исключение
		АС_ПересчитываетсяОкруглениеЦен = ПересчетДоОбновления;
		ВызватьИсключение;
	КонецПопытки;
	АС_ПересчитываетсяОкруглениеЦен = ПересчетДоОбновления;
	АС_ПересчитатьДоступность(Истина);
	АС_УстановитьВидЦенСтрокЗапасов(Неопределено, Истина);
	АС_ЗаполнитьКоличествоДнейДоВозврата();

	АС_ЗапомнитьСтоимостьЗаписанногоДокумента();

КонецПроцедуры

&НаКлиенте
Функция АС_ЕстьНДСВСтроках()

	// Видимость определяется суммой в итоговой плашке, с точностью до копейки.
	Возврат Окр(ИтогСуммаНДС, 2) <> 0;

КонецФункции

&НаКлиенте
Процедура АС_ОбновитьВидимостьНДС()

	// При НДС 0,00 повторяющиеся суммы без НДС не показываем, включая ставку 0%.
	ЕстьНДС = АС_ЕстьНДСВСтроках();
	Элементы.ИтогСуммаНДС.Видимость = ЕстьНДС;

КонецПроцедуры

&НаКлиенте
&После("СтавкаНДСДоставкиПриИзменении")
Процедура АС_СтавкаНДСДоставкиПриИзмененииПосле(Элемент)

	АС_ОбновитьВидимостьНДС();

КонецПроцедуры

&НаКлиенте
Процедура АС_ОбновитьОтображениеОплаты()

	НоваяСуммаОплачено = 0;
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ДанныеОплаты = АС_ПолучитьФактОплатыЗаказа(Объект.Ссылка);
		НоваяСуммаОплачено = ДанныеОплаты.СуммаОплаты + ДанныеОплаты.СуммаАванса;
	КонецЕсли;
	Если АС_СуммаОплачено <> НоваяСуммаОплачено Тогда
		АС_СуммаОплачено = НоваяСуммаОплачено;
	КонецЕсли;
	АС_ОбновитьОстатокОплаты();
	АС_ОбновитьВидимостьНДС();

КонецПроцедуры

&НаКлиенте
Процедура АС_ОбновитьОстатокОплаты()

	АС_ЗапланироватьАльтернативныйИтог();

	// Пересчитываем долг и переплату по текущим строкам формы.
	СуммаКОплате = ИтогВсего + Объект.Работы.Итог("Всего");
	ОстатокОплаты = Окр(СуммаКОплате - АС_СуммаОплачено, 2);
	АС_СуммаДолжен = Макс(0, ОстатокОплаты);
	АС_СуммаПереплаты = Макс(0, -ОстатокОплаты);
	ЕстьЧастичнаяОплата = СуммаКОплате > 0
		И АС_СуммаОплачено > 0
		И АС_СуммаДолжен > 0;
	ЕстьПереплата = АС_СуммаОплачено > 0 И АС_СуммаПереплаты > 0;
	Элементы.АС_СуммаДолжен.Видимость = ЕстьЧастичнаяОплата;
	Элементы.АС_СуммаПереплаты.Видимость = ЕстьПереплата;
	Элементы.АС_СтрокаОплаты.Видимость = ЕстьЧастичнаяОплата Или ЕстьПереплата;

КонецПроцедуры

&НаКлиенте
Процедура АС_ПриОткрытии(Отказ)

	АС_НастройкиЦенОплаты = Неопределено;
	АС_ПоследнийНаличныйРежим = Объект.АС_ОплатаНаличными;

	АС_БезопасноеОбновлениеКлиент.НастроитьЗащитуРедакторов(ЭтотОбъект);
	АС_БезопасноеОбновлениеКлиент.ПодготовитьСостояние(АС_СостояниеФоновогоОбновления);
	АС_ОграничиватьРучныеСкидки = Не АС_ПолноправныйПользователь();
	АС_ОграниченоРедактированиеЦеныУслуги = АС_НужноОграничитьРедактированиеЦеныУслуг();
	АС_ИнициализироватьВыборВидаЦен();
	АС_СинхронизироватьВидЦенДокумента();
	Если Не ЗначениеЗаполнено(Объект.Ссылка)
		И Объект.Запасы.Количество() > 0 Тогда
		АС_ПересчитатьЦеныТоваровПоТекущемуКонтрагенту();
	КонецЕсли;
	АС_УстановитьВидЦенСтрокЗапасов(Неопределено, Истина);
	АС_НастроитьОграничениеВыбораВидаЦен();
	АС_ОбновитьДоступностьЦеныУслуги();
	АС_НастроитьДоступностьРучнойСкидки();
	АС_НастроитьОтборНоменклатурыПоОстатку(Истина);

	Если Не РежимОстаткиИРезервы Тогда
		ОстаткиИРезервы(Неопределено);
	Иначе
		АС_ПересчитатьДоступность();
	КонецЕсли;

	АС_ОбновитьОтображениеОплаты();
	ПодключитьОбработчикОжидания("АС_ОбновитьОплатуПоОжиданию", 60, Истина);

	Если АС_АвтозаполнениеИзЗаказаПоставщика Тогда
		ВставитьСтроки("Запасы", "Запасы");
		Модифицированность = Истина;
		АС_АвтозаполнениеИзЗаказаПоставщика = Ложь;
	КонецЕсли;

	АС_ОтменитьТоварыПоВозвратуПокупателяПослеОткрытия(Отказ);

	// Снимок отличает изменение товаров от простого проведения или смены статуса.
	АС_ИнициализироватьЦеныРаботПриОткрытии();
	АС_ЗапомнитьСтоимостьЗаписанногоДокумента();
	// Записанный документ при открытии не переоцениваем.
	АС_ГлубинаИзмененияСтоимости = 0;
	АС_ФормаГотоваКОкруглению = Не Отказ;
	Если Не Отказ И Не ЗначениеЗаполнено(Объект.Ссылка)
		И Объект.Запасы.Количество() > 0 Тогда
		ОбновитьИтогиКлиент();
	КонецЕсли;

	Если Не Отказ Тогда
		АС_ЗапланироватьАльтернативныйИтог();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_ОтменитьТоварыПоВозвратуПокупателяПослеОткрытия(Отказ)

	Если АС_СтрокиОтменыВозвратаПокупателя = Неопределено
		Или АС_СтрокиОтменыВозвратаПокупателя.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	АС_ОтменитьТоварыПоВозвратуПокупателя(АС_СтрокиОтменыВозвратаПокупателя);
	АС_СтрокиОтменыВозвратаПокупателя.Очистить();

КонецПроцедуры

&НаКлиенте
Процедура АС_ОбработкаОповещенияПосле(ИмяСобытия, Параметр, Источник)

	Если Источник = "ПодключаемоеОборудование" Тогда
		АС_БезопасноеОбновлениеКлиент.ОтметитьСканирование(АС_СостояниеФоновогоОбновления);
		Возврат;
	КонецЕсли;

	АС_ОбновитьVINПоОповещению(ИмяСобытия, Параметр);

	Если ИмяСобытия = "Запись_ЗаказПоставщику"
		Или ИмяСобытия = "Запись_ПриходнаяНакладная"
		Или ИмяСобытия = "АС_Запись_ПриходнаяНакладная"
		Или ИмяСобытия = "Запись_СписаниеЗапасов"
		Или ИмяСобытия = "Запись_РасходнаяНакладная"
		Или ИмяСобытия = "Запись_ЗаказПокупателя"
		Или ИмяСобытия = "Запись_ЗаказНаряды"
		Или ИмяСобытия = "ПроведениеЗаказНаряда"
		Или ИмяСобытия = "Запись_ПеремещениеЗапасов"
		Или ИмяСобытия = "Запись_ОприходованиеЗапасов"
		Или ИмяСобытия = "Запись_ЧекККМ"
		Или ИмяСобытия = "Запись_ЧекККМВозврат" Тогда
		АС_ЗапланироватьФоновоеОбновлениеЗаказа("СрокиВозврата");
		Возврат;
	КонецЕсли;

	// Параметр штатного оповещения содержит платёжный документ, а не заказ.
	Если ИмяСобытия = "ОповещениеОбИзмененииДолга"
		Или ИмяСобытия = "ОповещениеОбОплатеЗаказа"
		Или ИмяСобытия = "Запись_ПоступлениеВКассу"
		Или ИмяСобытия = "Запись_ПоступлениеНаСчет"
		Или ИмяСобытия = "Запись_РасходИзКассы"
		Или ИмяСобытия = "Запись_РасходСоСчета"
		Или ИмяСобытия = "Запись_Взаимозачет" Тогда
		АС_ЗапланироватьФоновоеОбновлениеЗаказа("Оплата");
		Возврат;
	КонецЕсли;

	Если ИмяСобытия = "АС_ОтменитьТоварыПоВозвратуПокупателя" Тогда
		ЗаказПокупателя = Неопределено;
		СтрокиОтмены = Неопределено;
		Если Не Параметр.Свойство("ЗаказПокупателя", ЗаказПокупателя)
			Или Не Параметр.Свойство("Строки", СтрокиОтмены)
			Или ЗаказПокупателя <> Объект.Ссылка Тогда
			Возврат;
		КонецЕсли;

		АС_ОтменитьТоварыПоВозвратуПокупателя(СтрокиОтмены);
		Возврат;
	КонецЕсли;

	Если ИмяСобытия <> "АС_ОбновитьЗаказПокупателяИзЗаказаПоставщика"
		Или Параметр <> Объект.Ссылка Тогда
		Возврат;
	КонецЕсли;

	АС_АвтозаполнениеИзЗаказаПоставщика = Истина;
	ВставитьСтроки("Запасы", "Запасы");
	Модифицированность = Истина;
	АС_АвтозаполнениеИзЗаказаПоставщика = Ложь;

КонецПроцедуры

&НаКлиенте
&После("ПредоплатаПриИзменении")
Процедура АС_ПредоплатаПриИзмененииПосле(Элемент)

	АС_ОбновитьОтображениеОплаты();

КонецПроцедуры

&НаКлиенте
Функция АС_СкладДляОтбораНоменклатуры()

	Если Объект.ПоложениеСклада = ПредопределенноеЗначение(
		"Перечисление.ПоложениеРеквизитаНаФорме.ВТабличнойЧасти") Тогда
		ТекущаяСтрока = Элементы.Запасы.ТекущиеДанные;
		Если ТекущаяСтрока <> Неопределено
			И ТекущаяСтрока.Свойство("СтруктурнаяЕдиницаРезерв") Тогда
			Возврат ТекущаяСтрока.СтруктурнаяЕдиницаРезерв;
		КонецЕсли;

		Возврат Неопределено;
	КонецЕсли;

	Возврат Объект.СтруктурнаяЕдиницаРезерв;

КонецФункции

&НаКлиенте
Процедура АС_НастроитьОтборНоменклатурыПоОстатку(Принудительно = Ложь)

	Склад = АС_СкладДляОтбораНоменклатуры();
	Если Не Принудительно
		И АС_ОтборНоменклатурыПоОстаткуУстановлен = Истина
		И АС_ОрганизацияОтбораНоменклатуры = Объект.Организация
		И АС_СкладОтбораНоменклатуры = Склад Тогда
		Возврат;
	КонецЕсли;

	ДоступнаяНоменклатура = АС_ПолучитьНоменклатуруСОстатком(
		Объект.Организация, Склад, Объект.Ссылка);

	НовыеПараметрыВыбора = Новый Массив;
	Если Элементы.ЗапасыНоменклатура.ПараметрыВыбора <> Неопределено Тогда
		Для Каждого ПараметрВыбора Из Элементы.ЗапасыНоменклатура.ПараметрыВыбора Цикл
			Если ПараметрВыбора.Имя <> "Отбор.Ссылка" Тогда
				НовыеПараметрыВыбора.Добавить(ПараметрВыбора);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	НовыеПараметрыВыбора.Добавить(
		Новый ПараметрВыбора("Отбор.Ссылка", ДоступнаяНоменклатура));
	Элементы.ЗапасыНоменклатура.ПараметрыВыбора =
		Новый ФиксированныйМассив(НовыеПараметрыВыбора);

	АС_ОтборНоменклатурыПоОстаткуУстановлен = Истина;
	АС_ОрганизацияОтбораНоменклатуры = Объект.Организация;
	АС_СкладОтбораНоменклатуры = Склад;

КонецПроцедуры

&НаСервере
&Вместо("ВставитьСтрокиНаСервере")
Процедура АС_ВставитьСтрокиНаСервере(ИмяТЧ, ИмяЭлемента, КоличествоСкопированных, КоличествоВставленных)

	ПараметрыВыбораИзменены = Ложь;
	ВставкаИзЗаказаПоставщика = ИмяТЧ = "Запасы"
		И АС_БуферСодержитСтрокиЗаказаПоставщикаНаСервере();
	Если ВставкаИзЗаказаПоставщика Тогда
		ИсходныйРежимОбъединенияСтрок = ОбъединятьСтрокиПриДобавлении;
		ОбъединятьСтрокиПриДобавлении = Ложь;
	КонецЕсли;
	Если ИмяТЧ = "Запасы" Тогда
		ПолеНоменклатуры = Элементы[ИмяЭлемента + "Номенклатура"];
		ИсходныеПараметрыВыбора = ПолеНоменклатуры.ПараметрыВыбора;
		Если ИсходныеПараметрыВыбора <> Неопределено Тогда
			ПараметрыВыбораБезОтбораПоНоменклатуре = Новый Массив;

			Для Каждого ПараметрВыбора Из ИсходныеПараметрыВыбора Цикл
				Если ПараметрВыбора.Имя = "Отбор.Ссылка" Тогда
					ПараметрыВыбораИзменены = Истина;
				Иначе
					ПараметрыВыбораБезОтбораПоНоменклатуре.Добавить(ПараметрВыбора);
				КонецЕсли;
			КонецЦикла;

			Если ПараметрыВыбораИзменены Тогда
				ПолеНоменклатуры.ПараметрыВыбора = Новый ФиксированныйМассив(
					ПараметрыВыбораБезОтбораПоНоменклатуре);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Попытка
		ПродолжитьВызов(ИмяТЧ, ИмяЭлемента, КоличествоСкопированных, КоличествоВставленных);
	Исключение
		Если ПараметрыВыбораИзменены Тогда
			ПолеНоменклатуры.ПараметрыВыбора = ИсходныеПараметрыВыбора;
		КонецЕсли;
		Если ВставкаИзЗаказаПоставщика Тогда
			ОбъединятьСтрокиПриДобавлении = ИсходныйРежимОбъединенияСтрок;
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

	Если ПараметрыВыбораИзменены Тогда
		ПолеНоменклатуры.ПараметрыВыбора = ИсходныеПараметрыВыбора;
	КонецЕсли;
	Если ВставкаИзЗаказаПоставщика Тогда
		ОбъединятьСтрокиПриДобавлении = ИсходныйРежимОбъединенияСтрок;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&Перед("ВставитьСтроки")
Процедура АС_ВставитьСтрокиПеред(ИмяТЧ, ИмяЭлемента)

	Если ИмяТЧ = "Запасы" Тогда
		АС_СинхронизироватьВидЦенДокумента();
		АС_СинхронизироватьСуществующиеСтрокиИзЗаказаПоставщика();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&После("ОбработатьВставленныеСтроки")
Процедура АС_ОбработатьВставленныеСтрокиПосле(ИмяТЧ, ИмяЭлемента, КоличествоВставленных)

	АС_УчестьРежимСкопированныхРабот(ИмяТЧ, КоличествоВставленных);

	Если ИмяТЧ <> "Запасы" Или КоличествоВставленных = 0 Тогда
		Возврат;
	КонецЕсли;

	АС_ЗаполнитьПродавцаВДобавленныхСтроках(КоличествоВставленных);

	ВставкаИзЗаказаПоставщика = АС_БуферСодержитСтрокиЗаказаПоставщикаНаСервере();
	КоличествоСтрок = Объект.Запасы.Количество();
	Для Итератор = 1 По КоличествоВставленных Цикл
		СтрокаТовара = Объект.Запасы[КоличествоСтрок - Итератор];
		// При копировании строки продажи сохраняем уже рассчитанную цену поставщика.
		Если ВставкаИзЗаказаПоставщика Или Не СтрокаТовара.АС_ЦенаИзЗаказаПоставщика Тогда
			АС_ЗаполнитьЦенуТовараПоВидуЦен(СтрокаТовара, Истина);
			СтрокаТовара.АС_ЦенаИзЗаказаПоставщика = Ложь;
		КонецЕсли;
		Если Не ВставкаИзЗаказаПоставщика Тогда
			СтрокаТовара.АС_ЗаказПоставщику = ПредопределенноеЗначение(
				"Документ.ЗаказПоставщику.ПустаяСсылка");
			СтрокаТовара.АС_КлючСвязиЗаказаПоставщику = 0;
			СтрокаТовара.АС_ИдентификаторГруппыПоставок = "";
		КонецЕсли;
	КонецЦикла;

	АС_ОбновитьДоступностьЦеныУслуги();
	АС_ПересчитатьДоступность(Ложь);
	АС_ОбновитьИтогиПослеИзмененияСтоимости();

	Если ВставкаИзЗаказаПоставщика Тогда
		Если АС_АвтозаполнениеИзЗаказаПоставщика Тогда
			ПараметрыОповещения = Новый Структура(
				"КоличествоВставленных,ЦеныПоставщика",
				КоличествоВставленных,
				АС_ПолучитьЦеныИзБуфераЗаказаПоставщикаНаСервере());
			АС_ПереносДляПредоплатыЗавершение(КодВозвратаДиалога.Да, ПараметрыОповещения);
		Иначе
			АС_ЗапроситьПереносДляПредоплаты(КоличествоВставленных);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_ЗапроситьПереносДляПредоплаты(КоличествоВставленных)

	ПараметрыОповещения = Новый Структура("КоличествоВставленных", КоличествоВставленных);
	Оповещение = Новый ОписаниеОповещения(
		"АС_ПереносДляПредоплатыЗавершение", ЭтотОбъект, ПараметрыОповещения);
	ПоказатьВопрос(
		Оповещение,
		"Вы добавляете товары для предоплаты?" + Символы.ПС
			+ "Да, добавить для предоплаты." + Символы.ПС
			+ "Нет, добавить простым копированием.",
		РежимДиалогаВопрос.ДаНет,
		0,
		КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура АС_ПереносДляПредоплатыЗавершение(Результат, ПараметрыОповещения) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	КоличествоСтрок = Объект.Запасы.Количество();
	Для Итератор = 1 По ПараметрыОповещения.КоличествоВставленных Цикл
		ИндексЦены = ПараметрыОповещения.КоличествоВставленных - Итератор;
		ЦенаПоставщика = Неопределено;
		Если ПараметрыОповещения.Свойство("ЦеныПоставщика")
			И ПараметрыОповещения.ЦеныПоставщика.Количество() > ИндексЦены Тогда
			ЦенаПоставщика = ПараметрыОповещения.ЦеныПоставщика[ИндексЦены];
		КонецЕсли;
		АС_РассчитатьЦенуОтЗаказаПоставщика(
			Объект.Запасы[КоличествоСтрок - Итератор], ЦенаПоставщика);
	КонецЦикла;
	АС_ЗарегистрироватьИОбъединитьДобавленныеСтрокиПоставщика(
		ПараметрыОповещения.КоличествоВставленных);
	АС_ЗаполнитьКоличествоДнейДоВозврата();

	АС_ОбновитьДоступностьЦеныУслуги();
	АС_ПересчитатьДоступность(Ложь);
	АС_ОбновитьИтогиПослеИзмененияСтоимости();
КонецПроцедуры

&НаКлиенте
Процедура АС_ЗарегистрироватьИОбъединитьДобавленныеСтрокиПоставщика(КоличествоВставленных)

	ИндексСтроки = Объект.Запасы.Количество() - КоличествоВставленных;
	Для НомерСтроки = 1 По КоличествоВставленных Цикл
		Если ИндексСтроки >= Объект.Запасы.Количество() Тогда
			Прервать;
		КонецЕсли;

		ДобавленнаяСтрока = Объект.Запасы[ИндексСтроки];
		Если Не ЗначениеЗаполнено(ДобавленнаяСтрока.АС_ЗаказПоставщику) Тогда
			ИндексСтроки = ИндексСтроки + 1;
			Продолжить;
		КонецЕсли;
		ЗаказПоставщику = ДобавленнаяСтрока.АС_ЗаказПоставщику;
		КлючСвязи = ДобавленнаяСтрока.АС_КлючСвязиЗаказаПоставщику;
		КоличествоПоставщика = ДобавленнаяСтрока.Количество;
		ЦенаПоставщика = ДобавленнаяСтрока.АС_ИсходнаяЦенаЗаказаПоставщика;

		СтрокаДляОбъединения = Неопределено;
		Для ИндексПоиска = 0 По ИндексСтроки - 1 Цикл
			СтрокаПоиска = Объект.Запасы[ИндексПоиска];
			Если СтрокаПоиска.Номенклатура = ДобавленнаяСтрока.Номенклатура
				И СтрокаПоиска.Характеристика = ДобавленнаяСтрока.Характеристика
				И СтрокаПоиска.АС_НеСписывать = ДобавленнаяСтрока.АС_НеСписывать
				И СтрокаПоиска.Цена = ДобавленнаяСтрока.Цена Тогда
				СтрокаДляОбъединения = СтрокаПоиска;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если СтрокаДляОбъединения = Неопределено Тогда
			Если Не ЗначениеЗаполнено(ДобавленнаяСтрока.АС_ИдентификаторГруппыПоставок) Тогда
				ДобавленнаяСтрока.АС_ИдентификаторГруппыПоставок = Строка(Новый УникальныйИдентификатор);
			КонецЕсли;
			ИдентификаторГруппы = ДобавленнаяСтрока.АС_ИдентификаторГруппыПоставок;
			ИндексСтроки = ИндексСтроки + 1;
		Иначе
			Если Не ЗначениеЗаполнено(СтрокаДляОбъединения.АС_ИдентификаторГруппыПоставок) Тогда
				СтрокаДляОбъединения.АС_ИдентификаторГруппыПоставок = Строка(Новый УникальныйИдентификатор);
			КонецЕсли;
			ИдентификаторГруппы = СтрокаДляОбъединения.АС_ИдентификаторГруппыПоставок;
			СтрокаДляОбъединения.Количество = СтрокаДляОбъединения.Количество + КоличествоПоставщика;
			РассчитатьСуммуВСтрокеТабличнойЧасти("Запасы", СтрокаДляОбъединения);
			Объект.Запасы.Удалить(ДобавленнаяСтрока);
		КонецЕсли;

		НоваяСвязь = Объект.АС_ИсточникиПоставок.Добавить();
		НоваяСвязь.ИдентификаторСтрокиПокупателя = ИдентификаторГруппы;
		НоваяСвязь.ЗаказПоставщику = ЗаказПоставщику;
		НоваяСвязь.КлючСвязиЗаказаПоставщику = КлючСвязи;
		НоваяСвязь.Количество = КоличествоПоставщика;
		НоваяСвязь.ЦенаПоставщика = ЦенаПоставщика;
	КонецЦикла;

КонецПроцедуры

