&НаСервере
Процедура АС_ДобавитьКолонкуБезСкидки()

	Колонка = Элементы.Добавить("АС_ЗапасыБезСкидки", Тип("ПолеФормы"), Элементы.Запасы);
	Колонка.Вид = ВидПоляФормы.ПолеФлажка;
	Колонка.ПутьКДанным = "Объект.Запасы.АС_БезСкидки";
	Колонка.Заголовок = "Без скидки";
	Колонка.Подсказка = "Запрет ручных и автоматических скидок для строки. Установить и снять запрет может только администратор.";
	Колонка.ТолькоПросмотр = Не Пользователи.ЭтоПолноправныйПользователь();
	Колонка.УстановитьДействие("ПриИзменении", "АС_БезСкидкиПриИзменении");
	Элементы.Переместить(Колонка, Элементы.Запасы, Элементы.ЗапасыНоменклатура);

	Оформление = УсловноеОформление.Элементы.Добавить();
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
		Оформление.Отбор, "Объект.Запасы.АС_БезСкидки", Истина);
	РаботаСФормой.ДобавитьОформляемоеПоле(Оформление, "ЗапасыПроцентСкидкиНаценки");
	РаботаСФормой.ДобавитьОформляемоеПоле(Оформление, "ЗапасыСуммаСкидкиНаценки");
	РаботаСФормой.ДобавитьЭлементУсловногоОформления(Оформление, "ТолькоПросмотр", Истина);

КонецПроцедуры

&НаКлиенте
Процедура АС_БезСкидкиПриИзменении(Элемент)

	СтрокаЗапаса = Элементы.Запасы.ТекущиеДанные;
	Если СтрокаЗапаса = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ИзменениеСтоимостиНачато = АС_НачатьИзменениеСтоимости();
	Попытка
		РассчитатьСуммуВСтрокеТабличнойЧасти("Запасы", СтрокаЗапаса);
		Если Не ТабличныеЧастиУНФКлиентСервер.АС_НормализоватьСкидкиЗаказа(Объект) Тогда
			Сообщить("Перед записью пересчитайте автоматические скидки: совпали ключи товара и работы.");
		КонецЕсли;
		Объект.СкидкиРассчитаны = Ложь;
		ОбновитьИтогиКлиент();
		Модифицированность = Истина;
	Исключение
		АС_ЗавершитьИзменениеСтоимости(ИзменениеСтоимостиНачато, Ложь);
		ВызватьИсключение;
	КонецПопытки;
	АС_ЗавершитьИзменениеСтоимости(ИзменениеСтоимостиНачато);

КонецПроцедуры

&НаСервере
&Перед("ПередЗаписьюНаСервере")
Процедура АС_ПередатьЗапретыСкидокКопии(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	ИсточникКопирования = Неопределено;
	Если ТекущийОбъект.ЭтоНовый()
		И Параметры.Свойство("ЗначениеКопирования", ИсточникКопирования)
		И ТипЗнч(ИсточникКопирования) = Тип("ДокументСсылка.ЗаказПокупателя")
		И ЗначениеЗаполнено(ИсточникКопирования) Тогда
		ТекущийОбъект.ДополнительныеСвойства.Вставить("АС_ЗапретыСкидокПриКопировании",
			ИсточникКопирования.ПолучитьОбъект().Запасы.Выгрузить());
	КонецЕсли;

КонецПроцедуры

