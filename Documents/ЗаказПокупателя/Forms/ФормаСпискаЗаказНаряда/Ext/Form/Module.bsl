&НаСервереБезКонтекста
&После("СписокПриПолученииДанныхНаСервере")
Процедура АС_СписокПриПолученииДанныхНаСервереПосле(ИмяЭлемента, Настройки, Строки)

	АС_УсловияВозвратаПоставщикамСервер.УстановитьИндикациюСроковВозврата(
		Строки, Справочники.СостоянияЗаказНарядов.Завершен);

КонецПроцедуры

&НаКлиенте
&После("ОбработкаОповещения")
Процедура АС_ОбработкаОповещенияПосле(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "Запись_ЗаказПоставщику"
		Или ИмяСобытия = "Запись_ПриходнаяНакладная"
		Или ИмяСобытия = "АС_Запись_ПриходнаяНакладная"
		Или ИмяСобытия = "Запись_СписаниеЗапасов"
		Или ИмяСобытия = "Запись_РасходнаяНакладная"
		Или ИмяСобытия = "Запись_ЗаказПокупателя"
		Или ИмяСобытия = "Запись_ЗаказНаряды"
		Или ИмяСобытия = "ПроведениеЗаказНаряда"
		Или ИмяСобытия = "Запись_ПеремещениеЗапасов"
		Или ИмяСобытия = "Запись_ОприходованиеЗапасов"
		Или ИмяСобытия = "Запись_ЧекККМ"
		Или ИмяСобытия = "Запись_ЧекККМВозврат" Тогда
		Элементы.Список.Обновить();
	КонецЕсли;

КонецПроцедуры
