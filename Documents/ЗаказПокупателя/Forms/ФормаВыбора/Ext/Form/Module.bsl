&НаСервере
&После("ПриСозданииНаСервере")
Процедура АС_ПриСозданииНаСервереВыборВидаПосле(Отказ, СтандартнаяОбработка)

	ВыбиратьВид = Ложь;
	Если Не Отказ И Параметры.Свойство("АС_ВыборВидаПриСоздании", ВыбиратьВид) И ВыбиратьВид Тогда
		Элементы.Список.УстановитьДействие("ПередНачаломДобавления", "АС_СписокПередНачаломДобавления");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_СписокПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр = Неопределено)

	Если Копирование Или Группа Тогда
		Возврат;
	КонецЕсли;
	Отказ = Истина;
	Оповещение = Новый ОписаниеОповещения("АС_ВидСоздаваемогоЗаказаВыбран", ЭтотОбъект,
		АС_ЗначенияЗаполненияДляСоздания());
	ОткрытьФорму("ОбщаяФорма.АС_ВыборВидаЗаказа", , ЭтотОбъект,
		, , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура АС_ВидСоздаваемогоЗаказаВыбран(ВыбранныйВидЗаказа, ЗначенияЗаполнения) Экспорт

	Если ТипЗнч(ВыбранныйВидЗаказа) <> Тип("Строка")
		Или (ВыбранныйВидЗаказа <> "ЗаказПокупателя" И ВыбранныйВидЗаказа <> "ЗаказНаряд") Тогда
		Возврат;
	КонецЕсли;
	Если ВыбранныйВидЗаказа = "ЗаказНаряд" Тогда
		АС_ИмяОткрываемойФормы = "Документ.ЗаказПокупателя.Форма.ФормаЗаказНаряда";
		ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаряд");
	Иначе
		АС_ИмяОткрываемойФормы = "Документ.ЗаказПокупателя.Форма.ФормаДокумента";
		ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаПродажу");
	КонецЕсли;
	ЗначенияЗаполнения.Вставить("ВидОперации", ВидОперации);
	ПараметрыСоздания = Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения);
	ОткрытьФорму(АС_ИмяОткрываемойФормы, ПараметрыСоздания, Элементы.Список);

КонецПроцедуры

&НаСервере
Функция АС_ЗначенияЗаполненияДляСоздания()

	ЗначенияЗаполнения = Новый Структура;
	Для Каждого ИмяПараметра Из СтрРазделить("Отбор,ЗначенияЗаполнения", ",") Цикл
		ИсходныеЗначения = Неопределено;
		Если Не Параметры.Свойство(ИмяПараметра, ИсходныеЗначения)
			Или (ТипЗнч(ИсходныеЗначения) <> Тип("Структура")
				И ТипЗнч(ИсходныеЗначения) <> Тип("ФиксированнаяСтруктура")) Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ЗначениеЗаполнения Из ИсходныеЗначения Цикл
			Если Метаданные.Документы.ЗаказПокупателя.Реквизиты.Найти(ЗначениеЗаполнения.Ключ) <> Неопределено
				И ТипЗнч(ЗначениеЗаполнения.Значение) <> Тип("Массив")
				И ТипЗнч(ЗначениеЗаполнения.Значение) <> Тип("ФиксированныйМассив") Тогда
				ЗначенияЗаполнения.Вставить(ЗначениеЗаполнения.Ключ, ЗначениеЗаполнения.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат ЗначенияЗаполнения;

КонецФункции
