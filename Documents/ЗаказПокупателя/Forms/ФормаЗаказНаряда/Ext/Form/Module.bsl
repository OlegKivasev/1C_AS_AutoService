&НаКлиенте
Процедура АС_УдалитьСозданиеРаботыИзВыбора(ДанныеВыбора)

	Если ТипЗнч(ДанныеВыбора) <> Тип("СписокЗначений") Тогда
		Возврат;
	КонецЕсли;

	Индекс = ДанныеВыбора.Количество() - 1;
	Пока Индекс >= 0 Цикл

		ЭлементВыбора = ДанныеВыбора.Получить(Индекс);
		ЗначениеВыбора = ЭлементВыбора.Значение;

		Если ТипЗнч(ЗначениеВыбора) = Тип("Структура") Тогда

			БыстроеСоздание = Ложь;
			ТипНоменклатуры = Неопределено;
			ЕстьБыстроеСоздание = ЗначениеВыбора.Свойство("БыстроеСоздание", БыстроеСоздание);
			ЕстьТипНоменклатуры = ЗначениеВыбора.Свойство("ТипНоменклатуры", ТипНоменклатуры);

			Если ЕстьБыстроеСоздание И ЕстьТипНоменклатуры
				И БыстроеСоздание
				И ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Работа") Тогда
				ДанныеВыбора.Удалить(Индекс);
			КонецЕсли;

		КонецЕсли;

		Индекс = Индекс - 1;

	КонецЦикла;

КонецПроцедуры

&НаКлиенте
&Вместо("ЗНРаботыНоменклатураОбработкаВыбора")
Процедура АС_ЗНРаботыНоменклатураОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)

	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура")
		И ВыбранноеЗначение.Свойство("БыстроеСоздание")
		И ВыбранноеЗначение.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Услуга") Тогда
		АС_ОткрытьФормуУслугиИзЗаказНаряда(Элемент, ВыбранноеЗначение, СтандартнаяОбработка);
		Возврат;
	КонецЕсли;

	ПродолжитьВызов(Элемент, ВыбранноеЗначение, СтандартнаяОбработка);

КонецПроцедуры

&НаКлиенте
Процедура АС_ОткрытьФормуУслугиИзЗаказНаряда(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора", Истина);

	ЗначенияЗаполнения = Новый Структура(
		"ТипНоменклатуры, Наименование, НаименованиеПолное",
		ВыбранноеЗначение.ТипНоменклатуры,
		ВыбранноеЗначение.Наименование,
		ВыбранноеЗначение.Наименование);
	ПараметрыФормы.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);

	ОткрытьФорму(
		"Справочник.Номенклатура.Форма.ФормаЭлемента",
		ПараметрыФормы,
		Элемент,,,,,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
&После("ЗапасыПриНачалеРедактирования")
Процедура АС_ЗапасыНачалоРедактированияДатыПродажи(Элемент, НоваяСтрока, Копирование)

	АС_БезопасноеОбновлениеКлиент.НачатьРедактированиеТаблицы(АС_СостояниеФоновогоОбновления, "Запасы");
	Если НоваяСтрока Или Копирование Тогда
		СтрокаТовара = Элемент.ТекущиеДанные;
		Если СтрокаТовара <> Неопределено Тогда
			СтрокаТовара.АС_ИдентификаторСтрокиПродажи = "";
			СтрокаТовара.АС_ДатаДобавления = Дата(1, 1, 1);
		КонецЕсли;
	КонецЕсли;

