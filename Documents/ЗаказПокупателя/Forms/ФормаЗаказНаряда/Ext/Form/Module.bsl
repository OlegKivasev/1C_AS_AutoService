&НаСервере
Процедура АС_ДобавитьРежимОплаты()

	АС_ДобавитьАльтернативныйИтог();

	Группа = Элементы.Добавить("АС_ГруппаРежимОплаты", Тип("ГруппаФормы"), Элементы.ЗНСписыватьТоварыИМатериалыИз);
	Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Группа.Отображение = ОтображениеОбычнойГруппы.Нет;
	Группа.ОтображатьЗаголовок = Ложь;
	Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
	Группа.Видимость = Не АС_ТолькоБезналичнаяОплатаНаСервере(Объект.ВидОперации, Объект.Контрагент);
	Поле = Элементы.Добавить("АС_ОплатаНаличными", Тип("ПолеФормы"), Группа);
	Поле.Вид = ВидПоляФормы.ПолеФлажка;
	Поле.ПутьКДанным = "Объект.АС_ОплатаНаличными";
	Поле.Заголовок = "Оплата наличными";
	Поле.УстановитьДействие("ПриИзменении", "АС_ОплатаНаличнымиПриИзменении");
	Команда = Команды.Добавить("АС_НастройкиРежимаОплаты");
	Команда.Действие = "АС_ОткрытьНастройкиРежимаОплаты";
	Команда.Заголовок = "...";
	Кнопка = Элементы.Добавить("АС_НастройкиРежимаОплаты", Тип("КнопкаФормы"), Группа);
	Кнопка.ИмяКоманды = Команда.Имя;
	Кнопка.Видимость = Пользователи.ЭтоПолноправныйПользователь();

КонецПроцедуры

