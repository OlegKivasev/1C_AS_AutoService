&НаКлиенте
&После("КонтрагентПриИзмененииНаКлиенте")
Процедура АС_КонтрагентПриИзмененииНаКлиентеПосле(ДанныеКонтрагента = Неопределено)

	АС_ОбновитьТелефонКонтрагента();

	АС_ПрименитьБлокировкуЗаказНарядаГотовогоКПроверке();

	БылТолькоБезналичныйРежим = АС_ПоследнийРежимБезНаценкиРабот = Истина;
	АС_ТолькоБезналичныйРежим = Неопределено;
	ТолькоБезналичнаяОплата = АС_РежимОплатыТолькоБезналичный();
	АС_ОбновитьВидимостьРежимаОплаты();
	Если ТолькоПросмотр Тогда
		Возврат;
	КонецЕсли;
	Если ТолькоБезналичнаяОплата Или БылТолькоБезналичныйРежим Тогда
		Объект.АС_ОплатаНаличными = Ложь;
		АС_ПоследнийНаличныйРежим = Ложь;
	КонецЕсли;
	Если ТолькоБезналичнаяОплата Или БылТолькоБезналичныйРежим Тогда
		// При смене контрагента пересчитываем работы от сохранённой исходной цены.
		Если АС_ГлубинаИзмененияСтоимости = Неопределено Тогда
			АС_ГлубинаИзмененияСтоимости = 0;
		КонецЕсли;
		АС_ГлубинаИзмененияСтоимости = АС_ГлубинаИзмененияСтоимости + 1;
		Попытка
			АС_ВосстановитьЦеныДоОкругления();
			Для Каждого ИмяТаблицы Из СтрРазделить("Запасы,Работы", ",") Цикл
				АС_УчестьРежимСкопированныхРабот(ИмяТаблицы, Объект[ИмяТаблицы].Количество());
			КонецЦикла;
			АС_ПересчитатьЦеныТоваровПоТекущемуКонтрагенту();
		Исключение
			АС_ГлубинаИзмененияСтоимости = АС_ГлубинаИзмененияСтоимости - 1;
			ВызватьИсключение;
		КонецПопытки;
		АС_ГлубинаИзмененияСтоимости = АС_ГлубинаИзмененияСтоимости - 1;
		АС_ПоследнийНеокругленныйИтог = Неопределено;
		АС_ОбновитьИтогиПослеИзмененияСтоимости();
	Иначе
		АС_ПересчитатьЦеныТоваровПоТекущемуКонтрагенту();
	КонецЕсли;

	АС_ПоследнийРежимБезНаценкиРабот = ТолькоБезналичнаяОплата;

КонецПроцедуры

