		Возврат;
	КонецЕсли;

	Объект.СостояниеЗаказа = ПроверкаПерехода.СостояниеДоИзменения;
	ОбщегоНазначенияКлиент.СообщитьПользователю(ПроверкаПерехода.ТекстОшибки);

