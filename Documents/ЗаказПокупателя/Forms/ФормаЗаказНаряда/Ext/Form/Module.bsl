&НаКлиенте
Процедура АС_ОбновитьVINПоОповещению(ИмяСобытия, Параметр)

	Если ИмяСобытия = "Запись_Контрагент" Тогда
		ИзмененныйКонтрагент = Параметр;
		Если ТипЗнч(Параметр) = Тип("Структура")
			Или ТипЗнч(Параметр) = Тип("ФиксированнаяСтруктура") Тогда
			ИзмененныйКонтрагент = Неопределено;
			Параметр.Свойство("Ссылка", ИзмененныйКонтрагент);
		КонецЕсли;
		Если ЗначениеЗаполнено(Объект.Контрагент)
			И ИзмененныйКонтрагент = Объект.Контрагент Тогда
			АС_ЗапланироватьФоновоеОбновлениеЗаказа("VIN");
		КонецЕсли;
	ИначеЕсли ИмяСобытия = "АС_ЗаписьДоговораАвтомобиля"
		И ЗначениеЗаполнено(Объект.Договор)
		И Параметр = Объект.Договор Тогда
		АС_ЗапланироватьФоновоеОбновлениеЗаказа("VIN");
	КонецЕсли;

