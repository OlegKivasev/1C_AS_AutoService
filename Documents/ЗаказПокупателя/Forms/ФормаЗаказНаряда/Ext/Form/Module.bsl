		АС_ДатаФактическойОплаты = Объект.АС_ДатаОплатыВручную;
	Иначе
		АС_ДатаФактическойОплаты = АС_ПолучитьДатуПолнойОплаты(Объект.Ссылка);
	КонецЕсли;

