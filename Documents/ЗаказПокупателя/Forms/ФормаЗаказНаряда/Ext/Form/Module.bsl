&НаСервере
Функция АС_ПроверитьПереходСостоянияЗаказНаряда()

	Результат = Новый Структура("Разрешен,СостояниеДоИзменения,ТекстОшибки", Истина,
		Справочники.СостоянияЗаказНарядов.ПустаяСсылка(), "");

	Если Пользователи.ЭтоПолноправныйПользователь() Тогда
		Возврат Результат;
	КонецЕсли;

	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Результат.СостояниеДоИзменения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
			Объект.Ссылка, "СостояниеЗаказа");
	КонецЕсли;

	НовоеСостояние = Объект.СостояниеЗаказа;
	СостояниеЗавершен = Справочники.СостоянияЗаказНарядов.Завершен;
	СостояниеГотовКПроверке = Справочники.СостоянияЗаказНарядов.НайтиПоНаименованию(
		"Готов к проверке", Истина);

	Если НовоеСостояние = СостояниеЗавершен
		И Не АС_ЭтоСостояниеСНаименованием(Результат.СостояниеДоИзменения, "Готов к отправке") Тогда
		Результат.Разрешен = Ложь;
		Результат.ТекстОшибки = "Сотрудник может завершить заказ-наряд только из состояния «Готов к отправке».";
	ИначеЕсли АС_ЭтоСостояниеСНаименованием(Результат.СостояниеДоИзменения, "Готов к отправке")
		И НовоеСостояние <> Результат.СостояниеДоИзменения
		И НовоеСостояние <> СостояниеЗавершен Тогда
		Результат.Разрешен = Ложь;
		Результат.ТекстОшибки = "Из состояния «Готов к отправке» сотрудник может перейти только в состояние «Завершен».";
	ИначеЕсли ЗначениеЗаполнено(Результат.СостояниеДоИзменения)
		И НовоеСостояние <> Результат.СостояниеДоИзменения
		И НовоеСостояние <> СостояниеГотовКПроверке Тогда
		Результат.Разрешен = Ложь;
		Результат.ТекстОшибки = "Сотрудник может самостоятельно установить только состояние «Готов к проверке».";
	ИначеЕсли Не ЗначениеЗаполнено(Результат.СостояниеДоИзменения)
		И АС_ЭтоСостояниеСНаименованием(НовоеСостояние, "Готов к отправке") Тогда
		Результат.Разрешен = Ложь;
		Результат.ТекстОшибки = "Состояние «Готов к отправке» после проверки устанавливает администратор.";
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаКлиенте
&Перед("СостояниеЗаказаПриИзменении")
Процедура АС_СостояниеЗаказаПриИзмененииПеред(Элемент)

	ПроверкаПерехода = АС_ПроверитьПереходСостоянияЗаказНаряда();
