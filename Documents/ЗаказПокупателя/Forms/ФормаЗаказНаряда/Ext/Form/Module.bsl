КонецПроцедуры

&НаКлиенте
Процедура АС_ОбновитьДоступностьЦенУслуг()

	АС_ОбновитьДоступностьЦеныЗапаса();
	АС_ОбновитьДоступностьЦеныРаботы();

КонецПроцедуры

&НаКлиенте
Процедура АС_ОбновитьДоступностьЦеныЗапаса()

	Если Не АС_ОграниченоРедактированиеЦеныУслуги Тогда
		Возврат;
	КонецЕсли;

	МожноИзменять = Ложь;
	СтрокаТабличнойЧасти = Элементы.Запасы.ТекущиеДанные;
	Если СтрокаТабличнойЧасти <> Неопределено Тогда
		МожноИзменять = ТипЗнч(СтрокаТабличнойЧасти.Номенклатура) = Тип("Строка")
			И АС_РазрешеноИзменятьЦенуВременныхТоваров();
	КонецЕсли;

	Элементы.ЗапасыЦена.ТолькоПросмотр = Не МожноИзменять;

КонецПроцедуры

&НаКлиенте
Процедура АС_ОбновитьДоступностьЦеныРаботы()

	Если Не АС_ОграниченоРедактированиеЦеныУслуги Тогда
		Возврат;
	КонецЕсли;

	МожноИзменять = Ложь;
	СтрокаТабличнойЧасти = Элементы.Работы.ТекущиеДанные;
	Если СтрокаТабличнойЧасти <> Неопределено Тогда
		МожноИзменять = СтрокаТабличнойЧасти.ТипНоменклатурыУслуга;
	КонецЕсли;

	Элементы.ЗНРаботыЦена.ТолькоПросмотр = Не МожноИзменять;

КонецПроцедуры

&НаКлиенте
&После("ОбновитьОтображениеКолонокВРазрезеЗапасов")
Процедура АС_ОбновитьОтображениеКолонокВРазрезеЗапасовПосле(ИмяТЧ = Неопределено,
	УбратьВидимостьРежима = Ложь, ОбновлятьСостояние = Истина)

	Элементы.АС_ЗапасыДоступноСУчетомЗаказовВсего.Видимость = РежимОстаткиИРезервы;

КонецПроцедуры

&НаКлиенте
&После("СтраницыПриСменеСтраницы")
Процедура АС_СтраницыПриСменеСтраницыПосле(Элемент, ТекущаяСтраница)

	Если ТекущаяСтраница.Имя = "ЗНГруппаЗапасы"
		И РежимОстаткиИРезервы Тогда
		ОбновитьОтображениеКолонокВРазрезеЗапасов("Запасы");
		АС_ПересчитатьДоступность();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&После("ОстаткиИРезервы")
Процедура АС_ОстаткиИРезервыПосле(Команда)

	Если РежимОстаткиИРезервы Тогда
		АС_ПересчитатьДоступность();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&Перед("РаботыНоменклатураПриИзмененииЗначения")
Процедура АС_РаботыНоменклатураПриИзмененииЗначенияПеред(Элемент, ОтменаСтроки = Ложь,
	СтрокаТабличнойЧасти = Неопределено)
	АС_СинхронизироватьВидЦенДокумента();
КонецПроцедуры

&НаКлиенте
&Перед("ЗапасыНоменклатураПриИзмененииПродолжить")
Процедура АС_ЗапасыНоменклатураПриИзмененииПродолжитьПеред(Элемент, НовоеКоличество,
	СтрокаТабличнойЧасти = Неопределено, Партия = Неопределено)
	АС_СинхронизироватьВидЦенПередДобавлениемТовара();
КонецПроцедуры

&НаКлиенте
&После("ЗапасыНоменклатураПриИзмененииПродолжить")
Процедура АС_ЗапасыНоменклатураПриИзмененииПродолжитьПосле(Элемент, НовоеКоличество,
	СтрокаТабличнойЧасти = Неопределено, Партия = Неопределено)
	АС_ЗаполнитьПродавцаСтроки(СтрокаТабличнойЧасти);
	АС_ЗаполнитьЦенуТовараПоВидуЦен(СтрокаТабличнойЧасти);
	АС_УстановитьВидЦенСтрокиЗапаса(СтрокаТабличнойЧасти);
	АС_ОбновитьДоступностьЦеныЗапаса();
	АС_ПересчитатьДоступность(Ложь);
	АС_ОбновитьИтогиПослеИзмененияСтоимости();
КонецПроцедуры

&НаКлиенте
Процедура АС_ЗаполнитьЦенуТовараПоВидуЦен(СтрокаТабличнойЧасти, Принудительно = Ложь,
	ВидЦенДляРасчета = Неопределено, ДатаДляРасчета = Неопределено)

	Если СтрокаТабличнойЧасти = Неопределено Тогда
		СтрокаТабличнойЧасти = Элементы.Запасы.ТекущиеДанные;
	КонецЕсли;

	Если СтрокаТабличнойЧасти = Неопределено
		Или ТипЗнч(СтрокаТабличнойЧасти.Номенклатура) <> Тип("СправочникСсылка.Номенклатура")
		Или Не СтрокаТабличнойЧасти.ТипНоменклатурыЗапас
		Или (Не Принудительно И СтрокаТабличнойЧасти.Цена <> 0) Тогда
		Возврат;
	КонецЕсли;

	СтруктураДанные = Новый Структура;
	СтруктураДанные.Вставить("Номенклатура", СтрокаТабличнойЧасти.Номенклатура);
	СтруктураДанные.Вставить("Характеристика", СтрокаТабличнойЧасти.Характеристика);
	Если ДатаДляРасчета <> Неопределено Тогда
		СтруктураДанные.Вставить("ДатаОбработки", ДатаДляРасчета);
	ИначеЕсли ЗначениеЗаполнено(Объект.Ссылка) Тогда
		СтруктураДанные.Вставить("ДатаОбработки", ОбщегоНазначенияКлиент.ДатаСеанса());
	Иначе
		СтруктураДанные.Вставить("ДатаОбработки", Объект.Дата);
	КонецЕсли;
	СтруктураДанные.Вставить("ВалютаДокумента", Объект.ВалютаДокумента);
	СтруктураДанные.Вставить("СуммаВключаетНДС", Объект.СуммаВключаетНДС);
	СтруктураДанные.Вставить("Коэффициент", 1);
	СтруктураДанные.Вставить("СтавкаНДС", СтрокаТабличнойЧасти.СтавкаНДС);
	Если ВидЦенДляРасчета = Неопределено Тогда
		ВидЦенДляРасчета = АС_ПолучитьВидЦенДляРасчета();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ВидЦенДляРасчета) Тогда
		Если Принудительно Тогда
			СтрокаТабличнойЧасти.Цена = 0;
			СтрокаТабличнойЧасти.АС_ПримененныйВидЦен = ПредопределенноеЗначение(
				"Справочник.ВидыЦен.ПустаяСсылка");
			СтрокаТабличнойЧасти.АС_ЦенаПоВидуЦенКонтрагента = Ложь;
			РассчитатьСуммуВСтрокеТабличнойЧасти("Запасы", СтрокаТабличнойЧасти);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(СтруктураДанные.ДатаОбработки) Тогда
		СтруктураДанные.ДатаОбработки = ОбщегоНазначенияКлиент.ДатаСеанса();
	КонецЕсли;

	ЦенообразованиеКлиентСервер.ДополнитьСтруктуруДанныхНоменклатурыПолямиЦенообразования(
		Объект, СтрокаТабличнойЧасти, СтруктураДанные);
	СтруктураДанные.Вставить("ВидЦен", ВидЦенДляРасчета);

	ЦенаПоУмолчанию = АС_ПолучитьЦенуПоВидуЦен(СтруктураДанные);
	Если ЦенаПоУмолчанию <> 0 Или Принудительно Тогда
		СтрокаТабличнойЧасти.Цена = ЦенаПоУмолчанию;
		СтрокаТабличнойЧасти.АС_ПримененныйВидЦен = ВидЦенДляРасчета;
		СтрокаТабличнойЧасти.АС_ЦенаПоВидуЦенКонтрагента = ЦенаПоУмолчанию <> 0
			И АС_ЭтоВидЦенКонтрагента(ВидЦенДляРасчета);
		РассчитатьСуммуВСтрокеТабличнойЧасти("Запасы", СтрокаТабличнойЧасти);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_ЗаполнитьЦеныТоваровПослеСканирования()

	Если Не ЗначениеЗаполнено(Объект.Контрагент) Тогда
		Возврат;
	КонецЕсли;

	ИзменениеСтоимостиНачато = АС_НачатьИзменениеСтоимости(Неопределено);
	Попытка
		ВидЦенДляРасчета = АС_ПолучитьВидЦенДляРасчета();
		Для Каждого СтрокаТовара Из Объект.Запасы Цикл
			АС_ЗаполнитьЦенуТовараПоВидуЦен(СтрокаТовара, Ложь, ВидЦенДляРасчета);
			Если Не ЗначениеЗаполнено(СтрокаТовара.АС_ПримененныйВидЦен)
				И ТипЗнч(СтрокаТовара.Номенклатура) = Тип("СправочникСсылка.Номенклатура")
				И СтрокаТовара.ТипНоменклатурыЗапас Тогда
				АС_УстановитьВидЦенСтрокиЗапаса(СтрокаТовара);
			КонецЕсли;
		КонецЦикла;
	Исключение
		АС_ЗавершитьИзменениеСтоимости(ИзменениеСтоимостиНачато, Ложь);
		ВызватьИсключение;
	КонецПопытки;
	АС_ЗавершитьИзменениеСтоимости(ИзменениеСтоимостиНачато);

КонецПроцедуры

&НаКлиенте
