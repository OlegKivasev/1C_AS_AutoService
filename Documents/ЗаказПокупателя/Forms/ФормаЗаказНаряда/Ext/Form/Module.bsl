КонецФункции

&НаСервере
Функция АС_НужноБлокироватьЗаказНарядДляПользователя()

	Возврат АС_ПолучитьПараметрыОграниченийЗаказНаряда().БлокироватьРедактирование;

КонецФункции

&НаСервере
Функция АС_ПолучитьПараметрыОграниченийЗаказНаряда()

	Результат = Новый Структура(
		"БлокироватьРедактирование,ГотовКОтправке,ФизическоеЛицо,СостояниеДоИзменения",
		Ложь, Ложь, АС_КонтрагентФизическоеЛицо(Объект.Контрагент),
		Справочники.СостоянияЗаказНарядов.ПустаяСсылка());

	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат Результат;
	КонецЕсли;

	СохраненныйЗаказ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Объект.Ссылка, "СостояниеЗаказа,Проведен,Контрагент");
	Результат.СостояниеДоИзменения = СохраненныйЗаказ.СостояниеЗаказа;
	// Смена контрагента не должна позволять обойти проверку заказа юридического лица.
	СохраненныйЗаказФизическогоЛица = АС_КонтрагентФизическоеЛицо(СохраненныйЗаказ.Контрагент);
	Результат.ФизическоеЛицо = Результат.ФизическоеЛицо И СохраненныйЗаказФизическогоЛица;

	Если Пользователи.ЭтоПолноправныйПользователь() Тогда
		Возврат Результат;
	КонецЕсли;

	// Блокируем по записанному состоянию: выбранный переход еще нужно провести.
	Результат.БлокироватьРедактирование =
		СохраненныйЗаказ.СостояниеЗаказа = Справочники.СостоянияЗаказНарядов.Завершен
		Или СохраненныйЗаказ.Проведен
			И Не СохраненныйЗаказФизическогоЛица
			И АС_ЭтоСостояниеСНаименованием(СохраненныйЗаказ.СостояниеЗаказа, "Готов к проверке");
	Результат.ГотовКОтправке = Не Результат.ФизическоеЛицо
		И АС_ЭтоСостояниеСНаименованием(СохраненныйЗаказ.СостояниеЗаказа, "Готов к отправке");

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция АС_КонтрагентФизическоеЛицо(Контрагент)

	Возврат ЗначениеЗаполнено(Контрагент)
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контрагент, "ВидКонтрагента")
			= Перечисления.ВидыКонтрагентов.ФизическоеЛицо;

КонецФункции

&НаСервереБезКонтекста
Функция АС_ЭтоСостояниеСНаименованием(СостояниеЗаказа, НаименованиеСостояния)

	Возврат ЗначениеЗаполнено(СостояниеЗаказа)
		И ВРег(СокрЛП(Строка(СостояниеЗаказа))) = ВРег(НаименованиеСостояния);

КонецФункции

&НаСервере
Функция АС_ПроверитьПереходСостоянияЗаказНаряда()

	Результат = Новый Структура("Разрешен,СостояниеДоИзменения,ТекстОшибки", Истина,
		Справочники.СостоянияЗаказНарядов.ПустаяСсылка(), "");

	ПараметрыОграничений = АС_ПолучитьПараметрыОграниченийЗаказНаряда();
	Результат.СостояниеДоИзменения = ПараметрыОграничений.СостояниеДоИзменения;

	Если Пользователи.ЭтоПолноправныйПользователь() Тогда
		Возврат Результат;
	КонецЕсли;

	Если ПараметрыОграничений.БлокироватьРедактирование Тогда
		Результат.Разрешен = Ложь;
		Результат.ТекстОшибки = "Изменять завершенный заказ-наряд или заказ-наряд на проверке может только администратор.";
		Возврат Результат;
	КонецЕсли;

	Если ПараметрыОграничений.ФизическоеЛицо Тогда
		Возврат Результат;
	КонецЕсли;

	НовоеСостояние = Объект.СостояниеЗаказа;
	СостояниеЗавершен = Справочники.СостоянияЗаказНарядов.Завершен;
	СостояниеГотовКПроверке = Справочники.СостоянияЗаказНарядов.НайтиПоНаименованию(
		"Готов к проверке", Истина);

	Если НовоеСостояние = СостояниеЗавершен
		И Не АС_ЭтоСостояниеСНаименованием(Результат.СостояниеДоИзменения, "Готов к отправке") Тогда
		Результат.Разрешен = Ложь;
		Результат.ТекстОшибки = "Сотрудник может завершить заказ-наряд только из состояния «Готов к отправке».";
	ИначеЕсли АС_ЭтоСостояниеСНаименованием(Результат.СостояниеДоИзменения, "Готов к отправке")
		И НовоеСостояние <> Результат.СостояниеДоИзменения
		И НовоеСостояние <> СостояниеЗавершен Тогда
		Результат.Разрешен = Ложь;
		Результат.ТекстОшибки = "Из состояния «Готов к отправке» сотрудник может перейти только в состояние «Завершен».";
	ИначеЕсли ЗначениеЗаполнено(Результат.СостояниеДоИзменения)
		И НовоеСостояние <> Результат.СостояниеДоИзменения
		И Не АС_ЭтоСостояниеСНаименованием(Результат.СостояниеДоИзменения, "Готов к отправке")
		И НовоеСостояние <> СостояниеГотовКПроверке Тогда
		Результат.Разрешен = Ложь;
		Результат.ТекстОшибки = "Сотрудник может самостоятельно установить только состояние «Готов к проверке».";
	ИначеЕсли Не ЗначениеЗаполнено(Результат.СостояниеДоИзменения)
		И АС_ЭтоСостояниеСНаименованием(НовоеСостояние, "Готов к отправке") Тогда
		Результат.Разрешен = Ложь;
		Результат.ТекстОшибки = "Состояние «Готов к отправке» после проверки устанавливает администратор.";
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаКлиенте
&Перед("СостояниеЗаказаПриИзменении")
Процедура АС_СостояниеЗаказаПриИзмененииПеред(Элемент)

	ПроверкаПерехода = АС_ПроверитьПереходСостоянияЗаказНаряда();
	Если ПроверкаПерехода.Разрешен Тогда
		Возврат;
	КонецЕсли;

	Объект.СостояниеЗаказа = ПроверкаПерехода.СостояниеДоИзменения;
	ОбщегоНазначенияКлиент.СообщитьПользователю(ПроверкаПерехода.ТекстОшибки);

КонецПроцедуры

