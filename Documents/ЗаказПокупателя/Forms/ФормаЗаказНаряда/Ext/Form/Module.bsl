&НаКлиенте
Процедура АС_ДополнитьВыборЗапасовПоРазмерности(
	Текст, ДанныеВыбора, ПараметрыПолученияДанных)

	Если Не АС_ЭтоПоискРазмерности(Текст)
		Или ТипЗнч(ДанныеВыбора) <> Тип("СписокЗначений")
		Или (ТипЗнч(ПараметрыПолученияДанных) <> Тип("Структура")
			И ТипЗнч(ПараметрыПолученияДанных) <> Тип("ФиксированнаяСтруктура")) Тогда
		Возврат;
	КонецЕсли;

	ШтатныеДанныеВыбора = АС_ПолучитьШтатныйВыборПоВариантамНаСервере(
		ПараметрыПолученияДанных, Текст);
	Если ШтатныеДанныеВыбора.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ПоследнийЭлементПустой = Ложь;
	Если ДанныеВыбора.Количество() > 0 Тогда
		ПоследнееЗначение = ДанныеВыбора.Получить(ДанныеВыбора.Количество() - 1).Значение;
		ПоследнийЭлементПустой = ТипЗнч(ПоследнееЗначение) = Тип("Строка")
			И ПустаяСтрока(ПоследнееЗначение);
		Если ПоследнийЭлементПустой Тогда
			ДанныеВыбора.Удалить(ДанныеВыбора.Количество() - 1);
		КонецЕсли;
	КонецЕсли;

	Для Каждого ЭлементВыбора Из ШтатныеДанныеВыбора Цикл
		Если ТипЗнч(ЭлементВыбора.Значение) <> Тип("СправочникСсылка.Номенклатура") Тогда
			Продолжить;
		КонецЕсли;
		Если ДанныеВыбора.НайтиПоЗначению(ЭлементВыбора.Значение) = Неопределено Тогда
			ДанныеВыбора.Добавить(
				ЭлементВыбора.Значение, ЭлементВыбора.Представление);
		КонецЕсли;
	КонецЦикла;

	Если ПоследнийЭлементПустой Тогда
		ДанныеВыбора.Добавить("");
	КонецЕсли;
	АС_ПереместитьБыстроеСозданиеВКонец(ДанныеВыбора);

КонецПроцедуры

&НаКлиенте
Процедура АС_ПереместитьБыстроеСозданиеВКонец(ДанныеВыбора)

	Если ТипЗнч(ДанныеВыбора) <> Тип("СписокЗначений") Тогда
		Возврат;
	КонецЕсли;

	ПоследнийЭлементПустой = Ложь;
	Если ДанныеВыбора.Количество() > 0 Тогда
		ПоследнееЗначение = ДанныеВыбора.Получить(ДанныеВыбора.Количество() - 1).Значение;
		ПоследнийЭлементПустой = ТипЗнч(ПоследнееЗначение) = Тип("Строка")
			И ПустаяСтрока(ПоследнееЗначение);
		Если ПоследнийЭлементПустой Тогда
			ДанныеВыбора.Удалить(ДанныеВыбора.Количество() - 1);
		КонецЕсли;
	КонецЕсли;

	БыстрыеСоздания = Новый Массив;
	Индекс = 0;
	Пока Индекс < ДанныеВыбора.Количество() Цикл
		ЭлементВыбора = ДанныеВыбора.Получить(Индекс);
		ЗначениеВыбора = ЭлементВыбора.Значение;
		БыстроеСоздание = Ложь;
		Если (ТипЗнч(ЗначениеВыбора) = Тип("Структура")
				Или ТипЗнч(ЗначениеВыбора) = Тип("ФиксированнаяСтруктура"))
			И ЗначениеВыбора.Свойство("БыстроеСоздание", БыстроеСоздание)
			И БыстроеСоздание Тогда
			БыстрыеСоздания.Добавить(Новый Структура(
				"Значение, Представление", ЗначениеВыбора, ЭлементВыбора.Представление));
			ДанныеВыбора.Удалить(Индекс);
			Продолжить;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;

	Для Каждого БыстроеСозданиеИзСписка Из БыстрыеСоздания Цикл
		ДанныеВыбора.Добавить(
			БыстроеСозданиеИзСписка.Значение, БыстроеСозданиеИзСписка.Представление);
	КонецЦикла;

	Если ПоследнийЭлементПустой Тогда
		ДанныеВыбора.Добавить("");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция АС_ЭтоПоискРазмерности(Текст)

	Возврат АС_ЕстьДополнительныеВариантыПоискаНаСервере(Текст);

КонецФункции

&НаСервереБезКонтекста
Функция АС_ЕстьДополнительныеВариантыПоискаНаСервере(Текст)

	ВариантыПоиска = АС_СинонимыПоискаСервер.ВариантыСтрокиПоиска(Текст);
	Возврат ВариантыПоиска.Количество() > 1;

КонецФункции

&НаСервереБезКонтекста
Функция АС_ПолучитьШтатныйВыборПоВариантамНаСервере(
	ПараметрыПолученияДанных, Текст)

	ВариантыПоиска = АС_СинонимыПоискаСервер.ВариантыСтрокиПоиска(Текст);
	Результат = Новый СписокЗначений;
	Для Каждого ВариантПоиска Из ВариантыПоиска Цикл
		ПараметрыВарианта = Новый Структура;
		Для Каждого Параметр Из ПараметрыПолученияДанных Цикл
			ПараметрыВарианта.Вставить(Параметр.Ключ, Параметр.Значение);
		КонецЦикла;
		ПараметрыВарианта.Вставить("СтрокаПоиска", ВариантПоиска);
		Отбор = Неопределено;
		Если ПараметрыВарианта.Свойство("Отбор", Отбор)
			И (ТипЗнч(Отбор) = Тип("Структура")
				Или ТипЗнч(Отбор) = Тип("ФиксированнаяСтруктура")) Тогда
			КопияОтбора = Новый Структура;
			Для Каждого ПараметрОтбора Из Отбор Цикл
				КопияОтбора.Вставить(ПараметрОтбора.Ключ, ПараметрОтбора.Значение);
			КонецЦикла;
			ПараметрыВарианта.Вставить("Отбор", КопияОтбора);
		КонецЕсли;

		ДанныеВарианта = Справочники.Номенклатура.
			ПолучитьДанныеВыбора(ПараметрыВарианта);
		Для Каждого ЭлементВарианта Из ДанныеВарианта Цикл
			Если ТипЗнч(ЭлементВарианта.Значение) = Тип("СправочникСсылка.Номенклатура")
				И Результат.НайтиПоЗначению(ЭлементВарианта.Значение) = Неопределено Тогда
				Результат.Добавить(
					ЭлементВарианта.Значение, ЭлементВарианта.Представление);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура АС_ДобавитьСозданиеВременногоТовараВВыбор(Текст, ДанныеВыбора)

	Если ТипЗнч(ДанныеВыбора) <> Тип("СписокЗначений")
		Или ПустаяСтрока(СокрЛП(Текст)) Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ЭлементВыбора Из ДанныеВыбора Цикл
		ЗначениеВыбора = ЭлементВыбора.Значение;
		Если ТипЗнч(ЗначениеВыбора) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;

		ЭтоВременныйТовар = Ложь;
		Если ЗначениеВыбора.Свойство("АС_ВременныйТовар", ЭтоВременныйТовар)
			И ЭтоВременныйТовар Тогда
			Возврат;
		КонецЕсли;

	КонецЦикла;

	Наименование = Лев(СокрЛП(Текст), 150);
	ВременныйТовар = Новый Структура(
		"АС_ВременныйТовар, Наименование",
		Истина,
		Наименование);

	Представление = Новый ФорматированнаяСтрока(
		Новый ФорматированнаяСтрока(
			"Создать: Временный товар """),
		Новый ФорматированнаяСтрока(
			Наименование,
			Новый Шрифт(, , , Истина),
			Новый Цвет(0, 175, 0)),
		Новый ФорматированнаяСтрока(""""));

	ПоследнийЭлементПустой = Ложь;
	Если ДанныеВыбора.Количество() > 0 Тогда
		ПоследнееЗначение = ДанныеВыбора.Получить(ДанныеВыбора.Количество() - 1).Значение;
		ПоследнийЭлементПустой = ТипЗнч(ПоследнееЗначение) = Тип("Строка")
			И ПустаяСтрока(ПоследнееЗначение);
		Если ПоследнийЭлементПустой Тогда
			ДанныеВыбора.Удалить(ДанныеВыбора.Количество() - 1);
		КонецЕсли;
	КонецЕсли;

	ДанныеВыбора.Добавить(ВременныйТовар, Представление);
	Если ПоследнийЭлементПустой Тогда
		ДанныеВыбора.Добавить("");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&Вместо("ЗапасыНоменклатураОбработкаВыбора")
Процедура АС_ЗапасыНоменклатураОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)

	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		ЭтоВременныйТовар = Ложь;
		Если ВыбранноеЗначение.Свойство("АС_ВременныйТовар", ЭтоВременныйТовар)
			И ЭтоВременныйТовар Тогда
			СтандартнаяОбработка = Ложь;
			АС_ОформитьТекущуюСтрокуКакРазовуюПозицию(ВыбранноеЗначение.Наименование);
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ПродолжитьВызов(Элемент, ВыбранноеЗначение, СтандартнаяОбработка);

КонецПроцедуры

&НаКлиенте
&После("ЗНРаботыНоменклатураАвтоПодбор")
Процедура АС_ЗНРаботыНоменклатураАвтоПодборПосле(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)

