&НаСервереБезКонтекста
Функция АС_ПолучитьРазрешенныеВидыЦен()

	РазрешенныеВидыЦен = УправлениеДоступом.РазрешенныеЗначенияДляДинамическогоСписка(
		"Справочник.ВидыЦен",
		Тип("СправочникСсылка.ВидыЦен"),
		Неопределено,
		Истина);

	Если РазрешенныеВидыЦен <> Неопределено
		И РазрешенныеВидыЦен.Количество() = 0 Тогда
		Возврат Новый ФиксированныйМассив(Новый Массив);
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|    ВидыЦен.Ссылка
	|ИЗ
	|    Справочник.ВидыЦен КАК ВидыЦен
	|ГДЕ
	|    НЕ ВидыЦен.ПометкаУдаления";

	Если РазрешенныеВидыЦен <> Неопределено Тогда
		Запрос.Текст = Запрос.Текст
			+ "
			|    И ВидыЦен.Ссылка В (&РазрешенныеВидыЦен)";
		Запрос.УстановитьПараметр("РазрешенныеВидыЦен", РазрешенныеВидыЦен);
	КонецЕсли;

	Выборка = Запрос.Выполнить().Выбрать();
	ВидыЦен = Новый Массив;

	Пока Выборка.Следующий() Цикл
		ВидыЦен.Добавить(Выборка.Ссылка);
	КонецЦикла;

	Возврат Новый ФиксированныйМассив(ВидыЦен);

КонецФункции

&НаСервере
Процедура АС_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	АС_НовыйДокументДляТелефона = РеквизитФормыВЗначение("Объект").ЭтоНовый();

	АС_ДобавитьРежимОплаты();

	АС_ДобавитьКолонкуБезСкидки();

	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.Ответственный = Неопределено;
	КонецЕсли;

	АвтозаполнениеИзЗаказаПоставщика = Ложь;
	Если Параметры.Свойство("АС_АвтозаполнениеИзЗаказаПоставщика", АвтозаполнениеИзЗаказаПоставщика) Тогда
		АС_АвтозаполнениеИзЗаказаПоставщика = АвтозаполнениеИзЗаказаПоставщика;
	КонецЕсли;
	СтрокиОтменыВозвратаПокупателя = Неопределено;
	Если Параметры.Свойство("АС_СтрокиОтменыВозвратаПокупателя", СтрокиОтменыВозвратаПокупателя) Тогда
		ТаблицаСтрокОтмены = Новый ТаблицаЗначений;
		ТаблицаСтрокОтмены.Колонки.Добавить("Номенклатура");
		ТаблицаСтрокОтмены.Колонки.Добавить("Характеристика");
		ТаблицаСтрокОтмены.Колонки.Добавить("Цена");
		ТаблицаСтрокОтмены.Колонки.Добавить("Количество");
		Для Каждого СтрокаОтмены Из СтрокиОтменыВозвратаПокупателя Цикл
			НоваяСтрокаОтмены = ТаблицаСтрокОтмены.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаОтмены, СтрокаОтмены);
		КонецЦикла;
		ЗначениеВРеквизитФормы(ТаблицаСтрокОтмены, "АС_СтрокиОтменыВозвратаПокупателя");
	КонецЕсли;

	ПолеОтветственного = Элементы.Добавить("АС_Ответственный", Тип("ПолеФормы"), Элементы.ЗНСписыватьТоварыИМатериалыИз);
	ПолеОтветственного.Вид = ВидПоляФормы.ПолеВвода;
	ПолеОтветственного.ПутьКДанным = "Объект.Ответственный";
	ПолеОтветственного.Заголовок = "Ответственный";
	ПолеОтветственного.Ширина = 29;
	Элементы.Переместить(ПолеОтветственного, Элементы.ЗНСписыватьТоварыИМатериалыИз, Элементы.ЗНЯчейкаЗапасов);

	ИмяКолонки = "АС_ЗапасыДоступноСУчетомЗаказовВсего";
	Колонка = Элементы.Добавить(ИмяКолонки, Тип("ПолеФормы"), Элементы.Запасы);
	Колонка.Вид = ВидПоляФормы.ПолеВвода;
	Колонка.ПутьКДанным = "Объект.Запасы.АС_ДоступноСУчетомЗаказов";
	Колонка.Заголовок = "С учетом заказов" + Символы.ПС + "(всего)";
	Колонка.Подсказка = "Физический остаток на всех складах за вычетом неотгруженных товаров в заказах покупателей и заказ-нарядах, включая текущий документ";
	Колонка.ТолькоПросмотр = Истина;
	Колонка.Ширина = 10;
	Колонка.Формат = "ЧН=0; ЧДЦ=3";
	Колонка.Видимость = РежимОстаткиИРезервы;
	Элементы.Переместить(Колонка, Элементы.Запасы, Элементы.ЗапасыЦена);

	ИмяКолонкиСрокаВозврата = "АС_ЗапасыКоличествоДнейДоВозврата";
	КолонкаСрокаВозврата = Элементы.Добавить(
		ИмяКолонкиСрокаВозврата,
		Тип("ПолеФормы"),
		Элементы.Запасы);
	КолонкаСрокаВозврата.Вид = ВидПоляФормы.ПолеВвода;
	КолонкаСрокаВозврата.ПутьКДанным = "Объект.Запасы.АС_ПредставлениеДнейДоВозврата";
	КолонкаСрокаВозврата.Заголовок = "Дней до" + Символы.ПС + "возврата";
	КолонкаСрокаВозврата.Подсказка = "Остаток календарных дней до окончания срока возврата поставщику. Отрицательное значение означает просрочку.";
	КолонкаСрокаВозврата.ТолькоПросмотр = Истина;
	КолонкаСрокаВозврата.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Право;
	КолонкаСрокаВозврата.Ширина = 10;
	Элементы.Переместить(КолонкаСрокаВозврата, Элементы.Запасы, Элементы.ЗапасыЦена);

	ИмяКолонкиНеСписывать = "АС_ЗапасыНеСписывать";
	КолонкаНеСписывать = Элементы.Добавить(ИмяКолонкиНеСписывать, Тип("ПолеФормы"), Элементы.Запасы);
	КолонкаНеСписывать.Вид = ВидПоляФормы.ПолеФлажка;
	КолонкаНеСписывать.ПутьКДанным = "Объект.Запасы.АС_НеСписывать";
	КолонкаНеСписывать.Заголовок = "Не списывать";
	КолонкаНеСписывать.Подсказка = "Позиция останется в заказе-наряде, но не попадет в расходную накладную.";
	КолонкаНеСписывать.УстановитьДействие("ПриИзменении", "АС_НеСписыватьПриИзменении");
	Элементы.Переместить(КолонкаНеСписывать, Элементы.Запасы, Элементы.ЗапасыНоменклатура);

	ИмяКолонкиНеУчитывать = "АС_ЗапасыНеУчитывать";
	КолонкаНеУчитывать = Элементы.Добавить(ИмяКолонкиНеУчитывать, Тип("ПолеФормы"), Элементы.Запасы);
	КолонкаНеУчитывать.Вид = ВидПоляФормы.ПолеФлажка;
	КолонкаНеУчитывать.ПутьКДанным = "Объект.Запасы.АС_НеУчитывать";
	КолонкаНеУчитывать.Заголовок = "Не учитывать";
	КолонкаНеУчитывать.Подсказка = "Позиция списывается со склада, но не входит в суммы заказ-наряда и печатную форму с автомобилем.";
	КолонкаНеУчитывать.УстановитьДействие("ПриИзменении", "АС_НеУчитыватьПриИзменении");
	Элементы.Переместить(КолонкаНеУчитывать, Элементы.Запасы, Элементы.ЗапасыНоменклатура);

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяКолонки);
	ОформляемоеПоле.Использование = Истина;

	ОтборПоОстатку = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборПоОстатку.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Запасы.АС_ДоступноСУчетомЗаказов");
	ОтборПоОстатку.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборПоОстатку.ПравоеЗначение = 0;
	ОтборПоОстатку.Использование = Истина;

	ОтборПоТипу = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборПоТипу.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Запасы.ТипНоменклатурыЗапас");
	ОтборПоТипу.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборПоТипу.ПравоеЗначение = Истина;
	ОтборПоТипу.Использование = Истина;

	ВидЦенБезналичногоРасчета = АС_ПолучитьНастроенныйВидЦенБезналичногоРасчета();
	Если ЗначениеЗаполнено(ВидЦенБезналичногоРасчета) Тогда
		ЭлементОформления = УсловноеОформление.Элементы.Добавить();
		РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
			ЭлементОформления.Отбор,
			"Объект.Запасы.АС_ПримененныйВидЦен",
			ВидЦенБезналичногоРасчета,
			ВидСравненияКомпоновкиДанных.Равно);
		РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
			ЭлементОформления.Отбор,
			"Объект.Запасы.Цена",
			0,
			ВидСравненияКомпоновкиДанных.НеРавно);
		РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
			ЭлементОформления.Отбор,
			"Объект.Запасы.ТипНоменклатурыЗапас",
			Истина);
		РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
			ЭлементОформления.Отбор,
			"Объект.Запасы.АС_ЦенаИзЗаказаПоставщика",
			Ложь);
		РаботаСФормой.ДобавитьОформляемоеПоле(ЭлементОформления, Элементы.ЗапасыЦена.Имя);
		РаботаСФормой.ДобавитьЭлементУсловногоОформления(
			ЭлементОформления,
			"ЦветФона",
			Новый Цвет(223, 255, 223));
	КонецЕсли;

	// Цена из заказа поставщика не участвует в зелёном оформлении и всегда остается синей.
	АС_УстановитьОформлениеЦеныЗаказаПоставщика();
	АС_УстановитьОформлениеЦеныПоВидуЦенКонтрагента();

КонецПроцедуры

&НаСервере
&После("ПриСозданииНаСервере")
Процедура АС_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)

	АС_КонтактыКонтрагентовСервер.ДобавитьПолеТелефона(ЭтотОбъект, "ЗНКонтрагент");
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда АС_ОбновитьТелефонКонтрагента(); КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.Старт = ТекущаяДатаСеанса();
		Если Объект.Финиш < Объект.Старт Тогда
			Объект.Финиш = КонецДня(Объект.Старт);
		КонецЕсли;
	КонецЕсли;
	Элементы.ЗНФиниш.УстановитьДействие("ПриИзменении", "АС_ФактическийФинишПриИзменении");
	Элементы.ДатаОплаты.УстановитьДействие("ПриИзменении", "АС_ФактическаяОплатаПриИзменении");
	АС_ОбновитьФактическиеДаты();
	АС_УстановитьОформлениеЗаканчивающихсяТоваров();
	АС_УстановитьОформлениеРазовыхПозиций();
	// Добавляем последним, чтобы остальные правила не перекрывали серый фон неучитываемой строки.
	АС_УстановитьОформлениеНеучитываемыхСтрок();
	// Срок возврата важнее оформления всей строки и должен оставаться заметным.
	АС_УстановитьОформлениеСрокаВозврата();

	АС_ОбновитьVINАвтомобиля();

КонецПроцедуры

&НаСервере
Процедура АС_ОбновитьФактическиеДаты()

	// Ручные даты сохраняются в документе и имеют приоритет над автоматическими.
	Если ЗначениеЗаполнено(Объект.АС_ДатаФинишаВручную) Тогда
		АС_ФактическийФиниш = Объект.АС_ДатаФинишаВручную;
	Иначе
		АС_ФактическийФиниш = ?(
			Объект.СостояниеЗаказа = Справочники.СостоянияЗаказНарядов.Завершен,
			Объект.Финиш,
			Дата(1, 1, 1));
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.АС_ДатаОплатыВручную) Тогда
		АС_ДатаФактическойОплаты = Объект.АС_ДатаОплатыВручную;
	Иначе
		АС_ДатаФактическойОплаты = АС_ПолучитьДатуПолнойОплаты(Объект.Ссылка);
	КонецЕсли;
	Элементы.ЗНФиниш.ТолькоПросмотр = Ложь;
	Элементы.ДатаОплаты.ТолькоПросмотр = Ложь;
	Элементы.ЗНФиниш.Подсказка = "Дата завершения заполняется автоматически. Можно выбрать вручную; очистка возвращает автоматическое значение.";
	АС_СформироватьПодсказкуФактическойОплаты();

КонецПроцедуры

&НаСервере
&После("СформироватьЗаголовокПодсказкиДатыОплаты")
Процедура АС_СформироватьПодсказкуФактическойОплаты()

	Элементы.ДатаОплаты.Подсказка = "Дата полного погашения заполняется автоматически. Можно выбрать вручную; очистка возвращает автоматическое значение.";
	Элементы.ДатаОплатыРасширеннаяПодсказка.Заголовок = Элементы.ДатаОплаты.Подсказка;

КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_ПолучитьФактОплатыЗаказа(Заказ)

	Результат = Новый Структура("СуммаОплаты,СуммаАванса", 0, 0);

	Если Не ЗначениеЗаполнено(Заказ) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|    ЕСТЬNULL(ФактОплаты.СуммаОплаты, 0) КАК СуммаОплаты,
	|    ЕСТЬNULL(ФактОплаты.СуммаАванса, 0) КАК СуммаАванса
	|ИЗ
	|    РегистрСведений.ФактОплатыЗаказов КАК ФактОплаты
	|ГДЕ
	|    ФактОплаты.СчетНаОплату = &Заказ";

	Запрос.УстановитьПараметр("Заказ", Заказ);
	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Результат.СуммаОплаты = Выборка.СуммаОплаты;
		Результат.СуммаАванса = Выборка.СуммаАванса;
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаКлиенте
Функция АС_ЕстьНДСВСтроках()

	// Видимость определяется суммой в итоговой плашке, с точностью до копейки.
	Возврат Окр(ИтогСуммаНДС, 2) <> 0;

КонецФункции

&НаКлиенте
Процедура АС_ОбновитьВидимостьНДС()

	// При НДС 0,00 повторяющиеся суммы без НДС не показываем, включая ставку 0%.
	ЕстьНДС = АС_ЕстьНДСВСтроках();
	Элементы.ЗНСуммаНДСИтог.Видимость = ЕстьНДС;
	Элементы.АС_ИтогБезНДС.Видимость = ЕстьНДС;
	Элементы.АС_СуммаРаботБезНДС.Видимость = ЕстьНДС;
	Элементы.АС_СуммаТоваровБезНДС.Видимость = ЕстьНДС;
	Элементы.АС_СуммыРаботБезНДСПоИсполнителям.Видимость = ЕстьНДС
		И Элементы.АС_РасшифровкаРабот.Видимость;

КонецПроцедуры

&НаКлиенте
Процедура АС_ОбновитьОтображениеОплаты()

	НоваяСуммаОплачено = 0;
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ДанныеОплаты = АС_ПолучитьФактОплатыЗаказа(Объект.Ссылка);
		НоваяСуммаОплачено = ДанныеОплаты.СуммаОплаты + ДанныеОплаты.СуммаАванса;
	КонецЕсли;
	Если АС_СуммаОплачено <> НоваяСуммаОплачено Тогда
		АС_СуммаОплачено = НоваяСуммаОплачено;
	КонецЕсли;
	АС_ОбновитьОстатокОплаты();
	АС_ОбновитьВидимостьНДС();

КонецПроцедуры

&НаКлиенте
Процедура АС_ОбновитьОстатокОплаты()

	АС_ЗапланироватьАльтернативныйИтог();

	// Пересчитываем долг и переплату по текущим строкам формы.
	СуммаКОплате = ИтогВсего;
	ОстатокОплаты = Окр(СуммаКОплате - АС_СуммаОплачено, 2);
	АС_СуммаДолжен = Макс(0, ОстатокОплаты);
	АС_СуммаПереплаты = Макс(0, -ОстатокОплаты);
	ЕстьЧастичнаяОплата = СуммаКОплате > 0
		И АС_СуммаОплачено > 0
		И АС_СуммаДолжен > 0;
	ЕстьПереплата = АС_СуммаОплачено > 0 И АС_СуммаПереплаты > 0;
	Элементы.АС_СуммаДолжен.Видимость = ЕстьЧастичнаяОплата;
	Элементы.АС_СуммаПереплаты.Видимость = ЕстьПереплата;
	Элементы.АС_СтрокаОплаты.Видимость = ЕстьЧастичнаяОплата Или ЕстьПереплата;

КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_ПолучитьДатуПолнойОплаты(ЗаказПокупателя)

	ДатаПолнойОплаты = Дата(1, 1, 1);
	Если Не ЗначениеЗаполнено(ЗаказПокупателя) Тогда
		Возврат ДатаПолнойОплаты;
	КонецЕсли;

	// Факт оплаты относится к сохраненной сумме, а не к несохраненным изменениям формы.
	СуммаЗаказа = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаказПокупателя, "СуммаДокумента");
	Если СуммаЗаказа <= 0 Тогда
		Возврат ДатаПолнойОплаты;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		| Оплаты.Период КАК Период,
		| Оплаты.Регистратор КАК Регистратор,
		| СУММА(Оплаты.СуммаАвансаОборот + Оплаты.СуммаОплатыОборот) КАК СуммаОплаты
		|ИЗ
		| РегистрНакопления.ОплатаСчетовИЗаказов.Обороты(
		| 	, , Регистратор, СчетНаОплату = &ЗаказПокупателя) КАК Оплаты
		|СГРУППИРОВАТЬ ПО
		| Оплаты.Период,
		| Оплаты.Регистратор
		|ИМЕЮЩИЕ
		| СУММА(Оплаты.СуммаАвансаОборот + Оплаты.СуммаОплатыОборот) <> 0
		|УПОРЯДОЧИТЬ ПО
		| Период,
		| Регистратор";
	Запрос.УстановитьПараметр("ЗаказПокупателя", ЗаказПокупателя);
	Выборка = Запрос.Выполнить().Выбрать();
	Оплачено = 0;
	Пока Выборка.Следующий() Цикл
		Оплачено = Оплачено + Выборка.СуммаОплаты;
		Если Окр(Оплачено, 2) < Окр(СуммаЗаказа, 2) Тогда
			ДатаПолнойОплаты = Дата(1, 1, 1);
		ИначеЕсли Не ЗначениеЗаполнено(ДатаПолнойОплаты) Тогда
			ДатаПолнойОплаты = Выборка.Период;
		КонецЕсли;
	КонецЦикла;

	Возврат ДатаПолнойОплаты;

КонецФункции

&НаКлиенте
Процедура АС_ФактическийФинишПриИзменении(Элемент)

	Если ЗначениеЗаполнено(АС_ФактическийФиниш) Тогда
		Если АС_ФактическийФиниш = НачалоДня(АС_ФактическийФиниш) Тогда
			АС_ФактическийФиниш = КонецДня(АС_ФактическийФиниш);
		КонецЕсли;
		Если АС_ФактическийФиниш < Объект.Старт Тогда
			АС_ОбновитьФактическиеДаты();
			ОбщегоНазначенияКлиент.СообщитьПользователю("Дата финиша не может быть раньше даты старта.");
			Возврат;
		КонецЕсли;
		Объект.Финиш = АС_ФактическийФиниш;
	ИначеЕсли Объект.СостояниеЗаказа <> ПредопределенноеЗначение("Справочник.СостоянияЗаказНарядов.Завершен") Тогда
		// Учет продолжает использовать плановый финиш, когда фактическая дата еще не задана.
		Объект.Финиш = КонецДня(Объект.Старт);
	КонецЕсли;
	Объект.АС_ДатаФинишаВручную = АС_ФактическийФиниш;
	ПриИзмененииФиниш = Объект.Финиш;
	Модифицированность = Истина;
	АС_ОбновитьФактическиеДаты();

КонецПроцедуры

&НаКлиенте
Процедура АС_ФактическаяОплатаПриИзменении(Элемент)

	Объект.АС_ДатаОплатыВручную = АС_ДатаФактическойОплаты;
	Модифицированность = Истина;
	АС_ОбновитьДанныеОплаты();

КонецПроцедуры

&НаКлиенте
Процедура АС_ОбновитьОплатуПоОжиданию() Экспорт

	АС_БезопасноеОбновлениеКлиент.ПодготовитьСостояние(АС_СостояниеФоновогоОбновления);
	Если АС_СостояниеФоновогоОбновления.Закрыта Тогда
		Возврат;
	КонецЕсли;
	Если АС_СостояниеФоновогоОбновления.Обновления.Количество() = 0
		Или ТекущаяДата() >= АС_СостояниеФоновогоОбновления.ПроверитьОплатуПосле Тогда
		АС_БезопасноеОбновлениеКлиент.ЗапроситьОбновление(АС_СостояниеФоновогоОбновления, "Оплата");
		АС_СостояниеФоновогоОбновления.ПроверитьОплатуПосле = ТекущаяДата() + 60;
	КонецЕсли;
	Если Не АС_БезопасноеОбновлениеКлиент.МожноОбновить(ЭтотОбъект, АС_СостояниеФоновогоОбновления) Тогда
		ПодключитьОбработчикОжидания("АС_ОбновитьОплатуПоОжиданию", 2, Истина);
		Возврат;
	КонецЕсли;
	Обновления = АС_СостояниеФоновогоОбновления.Обновления;
	Если Обновления.Получить("ШтатныеОповещения") = Истина Тогда
		АС_ПрименитьОтложенныеОповещенияДокумента();
		Если АС_СостояниеФоновогоОбновления.Оповещения.Количество() = 0 Тогда
			Обновления.Удалить("ШтатныеОповещения");
		КонецЕсли;
	КонецЕсли;
	Если Обновления.Получить("Оплата") = Истина Тогда
		АС_ОбновитьДанныеОплаты();
		Обновления.Удалить("Оплата");
	КонецЕсли;
	Если Обновления.Получить("СрокиВозврата") = Истина Тогда
		АС_ЗаполнитьКоличествоДнейДоВозврата();
		Обновления.Удалить("СрокиВозврата");
	КонецЕсли;
	Если Обновления.Получить("VIN") = Истина Тогда
		НовоеПредставление = АС_ПолучитьVINДляПанелиНаСервере(Объект.Контрагент, Объект.Договор);
		Если АС_VINАвтомобиля <> НовоеПредставление Тогда
			АС_VINАвтомобиля = НовоеПредставление;
		КонецЕсли;
		Обновления.Удалить("VIN");
	КонецЕсли;
	ИнтервалОжидания = ?(Обновления.Количество() > 0, 2, 60);
	ПодключитьОбработчикОжидания("АС_ОбновитьОплатуПоОжиданию", ИнтервалОжидания, Истина);

КонецПроцедуры

&НаКлиенте
&После("ПриЗакрытии")
Процедура АС_ПриЗакрытии(ЗавершениеРаботы)

	АС_БезопасноеОбновлениеКлиент.Закрыть(АС_СостояниеФоновогоОбновления);
	ОтключитьОбработчикОжидания("АС_ОбновитьОплатуПоОжиданию");

КонецПроцедуры

&НаСервере
Процедура АС_ПодготовитьФинишПриЗавершении()

	Если ЗначениеЗаполнено(Объект.АС_ДатаФинишаВручную) Тогда
		Объект.Финиш = Объект.АС_ДатаФинишаВручную;
	ИначеЕсли Объект.СостояниеЗаказа = Справочники.СостоянияЗаказНарядов.Завершен Тогда
		ПредыдущееСостояние = Неопределено;
		Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
			ПредыдущееСостояние = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
				Объект.Ссылка, "СостояниеЗаказа");
		КонецЕсли;
		Если ПредыдущееСостояние <> Справочники.СостоянияЗаказНарядов.Завершен Тогда
			Объект.Финиш = ТекущаяДатаСеанса();
		КонецЕсли;
	КонецЕсли;
	АС_ОбновитьФактическиеДаты();

КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_ПробегОбязателен(Контрагент)

	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Истина;
	КонецЕсли;
	ВидКонтрагента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контрагент, "ВидКонтрагента");
	Возврат ВидКонтрагента <> Перечисления.ВидыКонтрагентов.ФизическоеЛицо;

КонецФункции

&НаСервере
Процедура АС_УстановитьОформлениеСрокаВозврата()

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
		ЭлементОформления.Отбор,
		"Объект.Запасы.АС_ЕстьСрокВозврата",
		Истина);
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
		ЭлементОформления.Отбор,
		"Объект.Запасы.АС_КоличествоДнейДоВозврата",
		5,
		ВидСравненияКомпоновкиДанных.МеньшеИлиРавно);
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
		ЭлементОформления.Отбор,
		"Объект.СостояниеЗаказа",
		ПредопределенноеЗначение("Справочник.СостоянияЗаказНарядов.Завершен"),
		ВидСравненияКомпоновкиДанных.НеРавно);
	РаботаСФормой.ДобавитьОформляемоеПоле(
		ЭлементОформления,
		"АС_ЗапасыКоличествоДнейДоВозврата");
	РаботаСФормой.ДобавитьЭлементУсловногоОформления(
		ЭлементОформления,
		"ЦветФона",
		Новый Цвет(255, 153, 153));

КонецПроцедуры

&НаСервере
Процедура АС_УстановитьОформлениеЗаканчивающихсяТоваров()

	НастройкиОформления = АС_ИндикацияОстатковСервер.НастройкиОформления();
	Для Каждого ПравилоОформления Из НастройкиОформления.Правила Цикл
		АС_ДобавитьОформлениеЗаканчивающегосяТовара(
			ПравилоОформления.ВерхняяГраница,
			ПравилоОформления.НижняяГраница,
			ПравилоОформления.ЦветФона,
			ПравилоОформления.Номенклатура,
			НастройкиОформления.ИсключенияОбщейИндикации);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура АС_ДобавитьОформлениеЗаканчивающегосяТовара(
	ВерхняяГраница, НижняяГраница, ЦветФона, Номенклатура, ИсключенияОбщейИндикации)

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
		ЭлементОформления.Отбор,
		"Объект.Запасы.АС_ДоступноСУчетомЗаказов",
		ВерхняяГраница,
		ВидСравненияКомпоновкиДанных.МеньшеИлиРавно);
	Если НижняяГраница <> Неопределено Тогда
		РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
			ЭлементОформления.Отбор,
			"Объект.Запасы.АС_ДоступноСУчетомЗаказов",
			НижняяГраница,
			ВидСравненияКомпоновкиДанных.Больше);
	КонецЕсли;
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
			ЭлементОформления.Отбор,
			"Объект.Запасы.Номенклатура",
			Номенклатура);
	ИначеЕсли ИсключенияОбщейИндикации.Количество() > 0 Тогда
		РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
			ЭлементОформления.Отбор,
			"Объект.Запасы.Номенклатура",
			ИсключенияОбщейИндикации,
			ВидСравненияКомпоновкиДанных.НеВСписке);
	КонецЕсли;
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
		ЭлементОформления.Отбор,
		"Объект.Запасы.ТипНоменклатурыЗапас",
		Истина);
	РаботаСФормой.ДобавитьОформляемоеПоле(
		ЭлементОформления,
		"АС_ЗапасыДоступноСУчетомЗаказовВсего");
	РаботаСФормой.ДобавитьЭлементУсловногоОформления(
		ЭлементОформления,
		"ЦветФона",
		ЦветФона);

КонецПроцедуры

