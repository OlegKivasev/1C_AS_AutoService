&НаСервереБезКонтекста
Функция АС_ПолучитьТекущегоПродавца()

	Результат = Новый Структура("Продавец,ТекстОшибки", Справочники.Сотрудники.ПустаяСсылка(), "");
	ТекущийПользователь = Пользователи.ТекущийПользователь();
	СотрудникиПользователя = РегистрыСведений.СотрудникиПользователя.ПолучитьСотрудниковПользователя(
		ТекущийПользователь);

	Если СотрудникиПользователя.Количество() = 1 Тогда
		Результат.Продавец = СотрудникиПользователя[0];
	ИначеЕсли СотрудникиПользователя.Количество() = 0 Тогда
		Результат.ТекстОшибки = "Нельзя определить продавца: текущая учетная запись не связана с сотрудником.";
	Иначе
		Результат.ТекстОшибки = "Нельзя определить продавца: с текущей учетной записью связано несколько сотрудников.";
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция АС_ПолучитьСтавкуНДСПоУмолчанию(НалогообложениеНДС, Организация, ДатаДокумента)

	СтавкаНДС = Неопределено;
	ЗначениеСтавкиНДС = 0;
	РасчетыРаботаСФормамиВызовСервера.ЗаполнитьСтавкуНДСПоУмолчанию(
		СтавкаНДС,
		ЗначениеСтавкиНДС,
		НалогообложениеНДС,
		Организация,
		ДатаДокумента);

	Возврат СтавкаНДС;

КонецФункции

&НаКлиенте
Процедура АС_ЗаполнитьПродавцаВДобавленныхСтроках(КоличествоДобавленныхСтрок)

	Если КоличествоДобавленныхСтрок <= 0 Тогда
		Возврат;
	КонецЕсли;

	КоличествоСтрок = Объект.Запасы.Количество();
	Для Итератор = 1 По Мин(КоличествоДобавленныхСтрок, КоличествоСтрок) Цикл
		АС_ЗаполнитьПродавцаСтроки(Объект.Запасы[КоличествоСтрок - Итератор]);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура АС_ЗаполнитьПродавцаВДобавленныхРаботах(КоличествоДобавленныхСтрок)

	Если КоличествоДобавленныхСтрок <= 0 Тогда
		Возврат;
	КонецЕсли;

	КоличествоСтрок = Объект.Работы.Количество();
	Для Итератор = 1 По Мин(КоличествоДобавленныхСтрок, КоличествоСтрок) Цикл
		АС_ЗаполнитьПродавцаСтрокиРаботы(Объект.Работы[КоличествоСтрок - Итератор]);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура АС_ОтменитьВернутьЗапасыПосле(ДанныеЗапаса, ТаблицаОбработки, ПричинаОтмены)

	Если ТаблицаОбработки = "Запасы" Тогда
		АС_ПересчитатьДоступность(Ложь);
	КонецЕсли;

	Если ТаблицаОбработки <> "Запасы"
		Или ДанныеЗапаса.Отменен <> 1
		Или Не ЗначениеЗаполнено(ДанныеЗапаса.НоменклатураДоОтмены) Тогда
		Возврат;
	КонецЕсли;

	СтрокиОтмены = Объект.ОтмененныеЗапасы.НайтиСтроки(
		Новый Структура("КлючСвязиОтмененные", ДанныеЗапаса.КлючСвязиОтмененные));
	ПродавецОтмены = ДанныеЗапаса.АС_Продавец;
	Если Не ЗначениеЗаполнено(ПродавецОтмены) Тогда
		// У исторической строки продавец не был зафиксирован: отмену относим к текущему сотруднику.
		ПродавецОтмены = АС_ПолучитьТекущегоПродавца().Продавец;
	КонецЕсли;
	Если СтрокиОтмены.Количество() = 1 Тогда
		СтрокиОтмены[0].АС_Номенклатура = ДанныеЗапаса.НоменклатураДоОтмены;
		СтрокиОтмены[0].АС_Продавец = ПродавецОтмены;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_ЗаполнитьПродавцаСтроки(СтрокаТовара)

	Если СтрокаТовара = Неопределено
		Или Не ЗначениеЗаполнено(СтрокаТовара.Номенклатура)
		Или ЗначениеЗаполнено(СтрокаТовара.АС_Продавец) Тогда
		Возврат;
	КонецЕсли;

	Если АС_ТекущийПродавец = Неопределено
		И АС_ОшибкаОпределенияПродавца = Неопределено Тогда
		ДанныеПродавца = АС_ПолучитьТекущегоПродавца();
		АС_ТекущийПродавец = ДанныеПродавца.Продавец;
		АС_ОшибкаОпределенияПродавца = ДанныеПродавца.ТекстОшибки;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(АС_ТекущийПродавец) Тогда
		Если АС_СтрокиБезПродавца = Неопределено Тогда
			АС_СтрокиБезПродавца = Новый Массив;
		КонецЕсли;
		АС_СтрокиБезПродавца.Добавить(СтрокаТовара.ПолучитьИдентификатор());
		Возврат;
	КонецЕсли;

	СтрокаТовара.АС_Продавец = АС_ТекущийПродавец;

КонецПроцедуры

&НаКлиенте
Функция АС_ЗаполнитьОбязательныеПоляРазовойПозиции(СтрокаТовара)

	Если СтрокаТовара = Неопределено
		Или ТипЗнч(СтрокаТовара.Номенклатура) <> Тип("Строка")
		Или Не ЗначениеЗаполнено(СтрокаТовара.Номенклатура) Тогда
		Возврат Ложь;
	КонецЕсли;

	СтрокаТовара.АС_НеСписывать = Истина;
	АС_ЗаполнитьПродавцаСтроки(СтрокаТовара);

	Если ЗначениеЗаполнено(СтрокаТовара.СтавкаНДС) Тогда
		Возврат Ложь;
	КонецЕсли;

	СтрокаТовара.СтавкаНДС = АС_ПолучитьСтавкуНДСПоУмолчанию(
		Объект.НалогообложениеНДС,
		Объект.Организация,
		Объект.Дата);

	Возврат ЗначениеЗаполнено(СтрокаТовара.СтавкаНДС);

КонецФункции

&НаКлиенте
Процедура АС_ЗаполнитьОбязательныеПоляРазовыхПозицийПередЗаписью()

	СтавкиНДСИзменены = Ложь;
	Для Каждого СтрокаТовара Из Объект.Запасы Цикл
		Если АС_ЗаполнитьОбязательныеПоляРазовойПозиции(СтрокаТовара) Тогда
			РассчитатьСуммуВСтрокеТабличнойЧасти("Запасы", СтрокаТовара);
			СтавкиНДСИзменены = Истина;
		КонецЕсли;
	КонецЦикла;

	Если СтавкиНДСИзменены Тогда
		АС_ОбновитьИтогиПослеИзмененияСтоимости();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_ЗаполнитьПродавцаСтрокиРаботы(СтрокаРаботы)

	Если СтрокаРаботы = Неопределено
		Или Не ЗначениеЗаполнено(СтрокаРаботы.Номенклатура)
		Или ЗначениеЗаполнено(СтрокаРаботы.АС_Продавец) Тогда
		Возврат;
	КонецЕсли;

	Если АС_ТекущийПродавец = Неопределено
		И АС_ОшибкаОпределенияПродавца = Неопределено Тогда
		ДанныеПродавца = АС_ПолучитьТекущегоПродавца();
		АС_ТекущийПродавец = ДанныеПродавца.Продавец;
		АС_ОшибкаОпределенияПродавца = ДанныеПродавца.ТекстОшибки;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(АС_ТекущийПродавец) Тогда
		Если АС_СтрокиРаботБезПродавца = Неопределено Тогда
			АС_СтрокиРаботБезПродавца = Новый Массив;
		КонецЕсли;
		АС_СтрокиРаботБезПродавца.Добавить(СтрокаРаботы.ПолучитьИдентификатор());
		Возврат;
	КонецЕсли;

	СтрокаРаботы.АС_Продавец = АС_ТекущийПродавец;

КонецПроцедуры

&НаКлиенте
Процедура АС_ПроверитьПродавцовПередЗаписью(Отказ)

	Если АС_СтрокиБезПродавца = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ИдентификаторСтроки Из АС_СтрокиБезПродавца Цикл
		СтрокаТовара = Объект.Запасы.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если СтрокаТовара = Неопределено
			Или Не ЗначениеЗаполнено(СтрокаТовара.Номенклатура)
			Или ЗначениеЗаполнено(СтрокаТовара.АС_Продавец) Тогда
			Продолжить;
		КонецЕсли;

		Отказ = Истина;
		Если ЗначениеЗаполнено(АС_ОшибкаОпределенияПродавца) Тогда
			Сообщить(АС_ОшибкаОпределенияПродавца);
		Иначе
			Сообщить("Укажите продавца для новой строки товара перед записью заказа.");
		КонецЕсли;
		Возврат;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
