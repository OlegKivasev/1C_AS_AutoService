&НаКлиенте
Процедура АС_ОбновитьВидимостьРежимаОплаты()

	ТолькоБезналичнаяОплата = АС_РежимОплатыТолькоБезналичный();
	Группа = Элементы.Найти("АС_ГруппаРежимОплаты");
	Если Группа <> Неопределено Тогда
		Группа.Видимость = Не ТолькоБезналичнаяОплата;
	КонецЕсли;
	Если ТолькоБезналичнаяОплата Тогда
		Если АС_ОбновлениеАльтернативыНазначено = Истина Тогда
			ОтключитьОбработчикОжидания("АС_ОбновитьАльтернативныйИтог");
		КонецЕсли;
		АС_ОбновлениеАльтернативыНазначено = Ложь;
		Надпись = Элементы.Найти("АС_АльтернативнаяОплата");
		Если Надпись <> Неопределено Тогда
			Надпись.Видимость = Ложь;
			Надпись.Заголовок = "";
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция АС_ПолучитьВидЦенЮридическогоЛица()

	// Персональная настройка юрлица имеет приоритет перед общим безналичным видом.
	ВидЦенКонтрагента = АС_ЦенообразованиеСервер.ВидЦенКонтрагента(Объект.Контрагент);
	Если ЗначениеЗаполнено(ВидЦенКонтрагента) Тогда
		Для Каждого РазрешенныйВидЦен Из АС_ПолучитьРазрешенныеВидыЦен() Цикл
			Если РазрешенныйВидЦен = ВидЦенКонтрагента Тогда
				Возврат ВидЦенКонтрагента;
			КонецЕсли;
		КонецЦикла;
		Возврат Справочники.ВидыЦен.ПустаяСсылка();
	КонецЕсли;
	ОсновнойВидЦен = АС_ПолучитьНастроенныйВидЦенБезналичногоРасчета();
	Если ЗначениеЗаполнено(ОсновнойВидЦен) Тогда
		Возврат ОсновнойВидЦен;
	КонецЕсли;
	Возврат Справочники.ВидыЦен.ПолучитьОсновнойВидЦенПродажи();

КонецФункции

&НаКлиенте
&Вместо("ПерезаполнитьЦеныТабличнойЧастиПоВидуЦен")
Процедура АС_ПерезаполнитьЦеныБезПотериРабот()

	ТолькоБезналичнаяОплата = АС_РежимОплатыТолькоБезналичный();
	Если ТолькоБезналичнаяОплата Тогда
		АС_СинхронизироватьВидЦенДокумента();
	КонецЕсли;
	// Вид цен в шапке определяет товары. Для уже введённых работ сохраняем
	// исходную стоимость: формула товара может вернуть даже положительную цену 5.
	// Переоценка самих работ по прайсу остаётся отдельным действием над строками.
	Для Каждого СтрокаРаботы Из Объект.Работы Цикл
		ИзмененаЦена = АС_РежимОплатыКлиентСервер.УстановитьЦенуРаботы(
			СтрокаРаботы, АС_НаличныйРежимОплаты(), Ложь, Истина, Не ТолькоБезналичнаяОплата);
		ПараметрыСтроки = Новый Структура(
			?(СтрокаРаботы.ПроцентСкидкиНаценки = 0, "РассчитатьПроцентСкидки", "РассчитатьСуммуСкидки"), Истина);
		РассчитатьСуммуВСтрокеТабличнойЧасти("Работы", СтрокаРаботы, ПараметрыСтроки);
	КонецЦикла;
	Если ТолькоБезналичнаяОплата Тогда
		АС_УстановитьВидЦенСтрокЗапасов();
	КонецЕсли;
	АС_ОбновитьИтогиПослеИзмененияСтоимости();

КонецПроцедуры

&НаКлиенте
&Перед("ОткрытьФормуЦеныИВалютаЗавершение")
Процедура АС_ВыбратьВидЦенЮрлицаПередПересчетом(РезультатФормыЦеныИВалюта, ДополнительныеПараметры)

	Если ТипЗнч(РезультатФормыЦеныИВалюта) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	Если Не РезультатФормыЦеныИВалюта.БылиВнесеныИзменения
		Или Не АС_РежимОплатыТолькоБезналичный() Тогда
		Возврат;
	КонецЕсли;
	ВидЦен = АС_ВидЦенОплаты();
	Если Не АС_ВидЦенРазрешен(ВидЦен) Тогда
		Возврат;
	КонецЕсли;
	// Штатный callback берёт вид цен и включение НДС именно из результата формы.
	РезультатФормыЦеныИВалюта.ВидЦен = ВидЦен;
	ЦенаВключаетНДС = АС_ЦенаВключаетНДСВидаЦен(ВидЦен);
	Если ЦенаВключаетНДС <> Неопределено Тогда
		РезультатФормыЦеныИВалюта.СуммаВключаетНДС = ЦенаВключаетНДС;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_ПересчитатьПоставочныеЦены(ВидЦен)

	ИзменениеСтоимостиНачато = АС_НачатьИзменениеСтоимости(Неопределено);
	Попытка
		Для Каждого СтрокаТовара Из Объект.Запасы Цикл
			Если СтрокаТовара.АС_ЦенаИзЗаказаПоставщика
				И СтрокаТовара.АС_ИсходнаяЦенаЗаказаПоставщика > 0
				И Не СтрокаТовара.ЭтоРазделитель И СтрокаТовара.Отменен = 0
				И СтрокаТовара.Отгружено = 0 Тогда
				АС_ЗаполнитьЦенуТовараПоВидуЦен(СтрокаТовара, Истина, ВидЦен);
			КонецЕсли;
		КонецЦикла;
		АС_ОбновитьИтогиПослеИзмененияСтоимости();
	Исключение
		АС_ЗавершитьИзменениеСтоимости(ИзменениеСтоимостиНачато, Ложь);
		ВызватьИсключение;
	КонецПопытки;
	АС_ЗавершитьИзменениеСтоимости(ИзменениеСтоимостиНачато);

КонецПроцедуры

&НаКлиенте
Функция АС_ИтогТоваровИРаботДляОплаты()

	// Доставка одинакова для способов оплаты и при сравнении сокращается.
	Результат = АС_ИтогДляОкругления();
	Для Каждого СтрокаРаботы Из Объект.Работы Цикл
		Результат = Результат + СтрокаРаботы.Всего;
	КонецЦикла;
	Возврат Окр(Результат, 2);

КонецФункции

&НаКлиенте
Функция АС_ЦелевойИтогКартой(ИсходныйИтог)

	Настройки = АС_НастройкиОплаты();
	Если Не АС_ВидЦенРазрешен(Настройки.НаличныйВидЦен) Тогда
		Возврат ИсходныйИтог;
	КонецЕсли;
	Данные = АС_ПодготовитьПрогнозОплаты(Настройки.НаличныйВидЦен, Истина);
	Если Не ПустаяСтрока(Данные.Ошибка) Тогда
		Возврат ИсходныйИтог;
	КонецЕсли;
	Данные.Вставить("ОграничиватьСкидки", АС_ОграничиватьРучныеСкидки);
	Данные.Вставить("ПределСкидки", Настройки.СкидкаНаличные);
	Данные.Вставить("ИспользоватьМинимальныеЦены", КэшЗначений.ИспользоватьМинимальныеЦены);
	ИтогНаличными = ТабличныеЧастиУНФКлиент.АС_АльтернативныйИтогЗаказа(Данные)
		- Данные.СтоимостьДоставки;
	ИтогКартой = АС_ИтогТоваровИРаботДляОплаты();
	ЦелевойИтог = АС_РежимОплатыКлиентСервер.СогласоватьИтогКартой(ИтогКартой, ИтогНаличными);
	Возврат Окр(ИсходныйИтог + ЦелевойИтог - ИтогКартой, 2);

КонецФункции

&НаКлиенте
Функция АС_ТребуетсяПодтверждениеПробега()

	Если Объект.АС_Пробег > 1
		Или Не АС_ЭтоСостояниеСНаименованием(Объект.СостояниеЗаказа, "Готов к проверке")
		Или Не АС_ПробегОбязателен(Объект.Контрагент) Тогда
		АС_ПодтверждениеНекорректногоПробега = Неопределено;
		Возврат Ложь;
	КонецЕсли;
	Подтверждение = АС_ПодтверждениеНекорректногоПробега;
	Возврат Подтверждение = Неопределено
		Или Подтверждение.Контрагент <> Объект.Контрагент
		Или Подтверждение.Пробег <> Объект.АС_Пробег
		Или Подтверждение.Состояние <> Объект.СостояниеЗаказа;

КонецФункции

&НаКлиенте
Процедура АС_ЗапроситьПодтверждениеПробега(НовоеСостояние, ПараметрыЗаписи = Неопределено)

	Если АС_ВопросПробегаОткрыт = Истина Тогда
		Возврат;
	КонецЕсли;
	АС_ВопросПробегаОткрыт = Истина;
	Контекст = Новый Структура("Контрагент,Пробег,Состояние,ПараметрыЗаписи",
		Объект.Контрагент, Объект.АС_Пробег, НовоеСостояние, ПараметрыЗаписи);
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить("Указать", "Указать пробег");
	Кнопки.Добавить("Ответственность", "Я беру ответственность на себя");
	ПоказатьВопрос(Новый ОписаниеОповещения("АС_ПодтверждениеПробегаЗавершение", ЭтотОбъект, Контекст),
		"Не указан корректный пробег." + Символы.ПС
			+ "Перед переводом заказа-наряда в статус «Готов к проверке» укажите пробег больше 1 км."
			+ Символы.ПС + "Чтобы продолжить без корректного пробега, возьмите ответственность на себя.",
		Кнопки, 0, "Указать", "Пробег заказа-наряда");

КонецПроцедуры

&НаКлиенте
Процедура АС_ПодтверждениеПробегаЗавершение(Результат, Контекст) Экспорт

	АС_ВопросПробегаОткрыт = Ложь;
	Если Результат <> "Ответственность" Тогда
		АС_ПодтверждениеНекорректногоПробега = Неопределено;
		ТекущийЭлемент = Элементы.АС_Пробег;
		Возврат;
	КонецЕсли;
	// Подтверждение не переносится на другой пробег, контрагента или статус.
	Если Объект.Контрагент <> Контекст.Контрагент Или Объект.АС_Пробег <> Контекст.Пробег Тогда
		Возврат;
	КонецЕсли;
	АС_ПодтверждениеНекорректногоПробега = Новый Структура("Контрагент,Пробег,Состояние",
		Контекст.Контрагент, Контекст.Пробег, Контекст.Состояние);
	Если Контекст.ПараметрыЗаписи = Неопределено Тогда
		Объект.СостояниеЗаказа = Контекст.Состояние;
		СостояниеЗаказаПриИзменении(Элементы.СостояниеЗаказа);
	Иначе
		Записать(Контекст.ПараметрыЗаписи);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция АС_ОбновитьТелефонКонтрагента()

	АС_КонтактыКонтрагентовСервер.ДобавитьПолеТелефона(ЭтотОбъект, "ЗНКонтрагент");
	Данные = АС_КонтактыКонтрагентовСервер.ДанныеКонтрагента(Объект.Контрагент);
	АС_ТелефонКонтрагента = Данные.Телефон;
	Возврат Данные.ФизическоеЛицо;

КонецФункции

&НаКлиенте
Процедура АС_ПроверитьТелефонПередЗаписью(Отказ, ПараметрыЗаписи)

	// Ссылка может быть назначена до успешной записи. Новизну определяет сервер.
	Если Отказ Или Не АС_НовыйДокументДляТелефона
		Или АС_КонтрагентБезТелефонаПодтвержден = Объект.Контрагент Тогда Возврат; КонецЕсли;
	Если Не АС_ОбновитьТелефонКонтрагента() Или Не ПустаяСтрока(АС_ТелефонКонтрагента) Тогда Возврат; КонецЕсли;
	Отказ = Истина;
	Если АС_ВопросТелефонаОткрыт = Истина Тогда Возврат; КонецЕсли;
	АС_ВопросТелефонаОткрыт = Истина;
	СохраненныеПараметры = Новый Структура;
	Для Каждого Параметр Из ПараметрыЗаписи Цикл
		СохраненныеПараметры.Вставить(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	Контекст = Новый Структура("Контрагент,ПараметрыЗаписи", Объект.Контрагент, СохраненныеПараметры);
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить("Указать", "Записать телефон");
	Кнопки.Добавить("Ответственность", "Я беру ответственность на себя");
	ПоказатьВопрос(Новый ОписаниеОповещения("АС_ТелефонПередЗаписьюЗавершение", ЭтотОбъект, Контекст),
		"Запишите телефон покупателя в карточке контрагента." + Символы.ПС
			+ "Чтобы создать заказ-наряд без телефона, возьмите ответственность на себя.",
		Кнопки, 0, "Указать", "Телефон покупателя");

КонецПроцедуры

&НаКлиенте
Процедура АС_ТелефонПередЗаписьюЗавершение(Результат, Контекст) Экспорт

	АС_ВопросТелефонаОткрыт = Ложь;
	Если Объект.Контрагент <> Контекст.Контрагент Тогда Возврат; КонецЕсли;
	Если Результат = "Указать" Тогда
		ОткрытьФорму("Справочник.Контрагенты.Форма.ФормаЭлемента", Новый Структура("Ключ", Объект.Контрагент), ЭтотОбъект);
		Возврат;
	КонецЕсли;
	Если Результат <> "Ответственность" Тогда Возврат; КонецЕсли;
	// Подтверждение однократное для создания документа на выбранного контрагента.
	АС_КонтрагентБезТелефонаПодтвержден = Объект.Контрагент;
	Записать(Контекст.ПараметрыЗаписи);

КонецПроцедуры


&НаКлиенте
Процедура АС_ПровестиИЗакрыть(Команда)

	Если ТолькоПросмотр Тогда Возврат; КонецЕсли;

	ПараметрыЗаписи = Новый Структура("РежимЗаписи,РежимПроведения,ПринудительноЗакрытьФорму",
		РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный, Истина);
	Записать(ПараметрыЗаписи);

КонецПроцедуры
