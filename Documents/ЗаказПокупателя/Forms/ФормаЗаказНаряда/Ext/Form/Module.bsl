&НаСервереБезКонтекста
Функция АС_ПолучитьЦенуПоВидуЦен(СтруктураДанные, ПрименятьИсключенияТоваров = Истина)

	Если Не СтруктураДанные.Свойство("ВидЦен")
		Или Не ЗначениеЗаполнено(СтруктураДанные.ВидЦен) Тогда
		Возврат 0;
	КонецЕсли;

	Возврат АС_ЦенообразованиеСервер.ЦенаДляОбновления(СтруктураДанные, Ложь, , ПрименятьИсключенияТоваров);

КонецФункции

&НаСервере
Функция АС_ПолучитьВидЦенЗаказНарядаПриОткрытии()

	Основание = Неопределено;
	ЗначениеКопирования = Неопределено;
	ЗначенияЗаполнения = Неопределено;
	Параметры.Свойство("Основание", Основание);
	Параметры.Свойство("ЗначениеКопирования", ЗначениеКопирования);
	Параметры.Свойство("ЗначенияЗаполнения", ЗначенияЗаполнения);

	Если ЗначениеЗаполнено(Объект.Ссылка)
		Или ЗначениеЗаполнено(Основание)
		Или ЗначениеЗаполнено(ЗначениеКопирования)
		Или ЗаполнениеОбъектовУНФ.ЭтоЗаполнениеПоШаблону(ЗначенияЗаполнения) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат АС_ПолучитьОсновнойВидЦенЗаказНаряда();

КонецФункции

&НаКлиенте
Процедура АС_СинхронизироватьВидЦенПередДобавлениемТовара()

	ВидЦенДляРасчета = АС_ПолучитьОсновнойВидЦенЗаказНаряда();
	Если Не АС_ВидЦенРазрешен(ВидЦенДляРасчета) Тогда
		Возврат;
	КонецЕсли;

	Если Объект.ВидЦен <> ВидЦенДляРасчета Тогда
		Объект.ВидЦен = ВидЦенДляРасчета;
		ЦеныИВалюта = ЦеныИВалютаКлиентСервер.ТекстНадписиЦеныИВалюта(
			Объект,
			ВалютаРасчетов,
			КурсНациональнаяВалюта,
			УчетВалютныхОпераций);
	КонецЕсли;
	Если АС_СинхронизироватьСуммуВключаетНДСПоВидуЦен(ВидЦенДляРасчета) Тогда
		АС_ПересчитатьНДСПослеИзмененияНалогообложения();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&Перед("ОпределитьНеобходимостьПересчетаДокументаПоУсловиямДоговора")
Процедура АС_ОпределитьНеобходимостьПересчетаДокументаПоУсловиямДоговораПеред(
	РезультатЗакрытия, ДополнительныеПараметры)

	Если АС_КонтрагентДляБезналичногоРасчета() Тогда
		АС_СинхронизироватьВидЦенПередДобавлениемТовара();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&После("ОпределитьНеобходимостьПересчетаДокументаПоУсловиямДоговора")
Процедура АС_ОпределитьНеобходимостьПересчетаДокументаПоУсловиямДоговораПосле(
	РезультатЗакрытия, ДополнительныеПараметры)

	Если РезультатЗакрытия <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Если ДополнительныеПараметры.ПересчетНеобходимПоЗапасам Тогда
		АС_ПересчитатьПоставочныеЦены(АС_ПолучитьВидЦенДляРасчета());
	КонецЕсли;
	АС_УстановитьВидЦенСтрокЗапасов();

КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_ПолучитьНастроенныйВидЦенБезналичногоРасчета()

	ОсновнойВидЦен = Константы.АС_ОсновнойВидЦенБезналичногоРасчета.Получить();
	Если Не ЗначениеЗаполнено(ОсновнойВидЦен) Тогда
		ОсновнойВидЦен = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
			"АС_ВидыЦен",
			"ОсновнойВидЦенБезналичногоРасчета");
		Если ЗначениеЗаполнено(ОсновнойВидЦен) Тогда
			Константы.АС_ОсновнойВидЦенБезналичногоРасчета.Установить(ОсновнойВидЦен);
		КонецЕсли;
	КонецЕсли;

	Если ТипЗнч(ОсновнойВидЦен) = Тип("СправочникСсылка.ВидыЦен")
		И ЗначениеЗаполнено(ОсновнойВидЦен) Тогда
		Возврат ОсновнойВидЦен;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

&НаСервере
Функция АС_ПолучитьОсновнойВидЦенЗаказНаряда()

	Если АС_ТолькоБезналичнаяОплатаНаСервере(Объект.ВидОперации, Объект.Контрагент) Тогда
		Возврат АС_ПолучитьВидЦенЮридическогоЛица();
	КонецЕсли;

	ВидЦенОплаты = АС_ЦенообразованиеСервер.ВидЦенРежимаОплаты(Объект.АС_ОплатаНаличными
		И Не АС_ТолькоБезналичнаяОплатаНаСервере(Объект.ВидОперации, Объект.Контрагент));
	Если ЗначениеЗаполнено(ВидЦенОплаты) Тогда
		Возврат ВидЦенОплаты;
	КонецЕсли;

	ВидЦенКонтрагента = АС_ЦенообразованиеСервер.ВидЦенКонтрагента(Объект.Контрагент);
	Если ЗначениеЗаполнено(ВидЦенКонтрагента) Тогда
		Для Каждого РазрешенныйВидЦен Из АС_ПолучитьРазрешенныеВидыЦен() Цикл
			Если РазрешенныйВидЦен = ВидЦенКонтрагента Тогда
				Возврат ВидЦенКонтрагента;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если АС_КонтрагентДляБезналичногоРасчета() Тогда
		ОсновнойВидЦен = АС_ПолучитьНастроенныйВидЦенБезналичногоРасчета();

		Если ТипЗнч(ОсновнойВидЦен) = Тип("СправочникСсылка.ВидыЦен")
			И ЗначениеЗаполнено(ОсновнойВидЦен) Тогда
			Возврат ОсновнойВидЦен;
		КонецЕсли;
	КонецЕсли;

	Возврат Справочники.ВидыЦен.ПолучитьОсновнойВидЦенПродажи();

КонецФункции

&НаСервере
Функция АС_КонтрагентДляБезналичногоРасчета()

	Если Не ЗначениеЗаполнено(Объект.Контрагент) Тогда
		Возврат Ложь;
	КонецЕсли;

	ВидКонтрагента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
		Объект.Контрагент,
		"ВидКонтрагента");

	Возврат ВидКонтрагента = Перечисления.ВидыКонтрагентов.ЮридическоеЛицо
		Или ВидКонтрагента = Перечисления.ВидыКонтрагентов.ИндивидуальныйПредприниматель;

КонецФункции

&НаКлиенте
&После("ЗапасыХарактеристикаПриИзменении")
Процедура АС_ЗапасыХарактеристикаПриИзмененииПосле(Элемент)
	АС_УстановитьВидЦенСтрокиЗапаса(Элементы.Запасы.ТекущиеДанные);
	АС_ПересчитатьДоступность(Ложь);
КонецПроцедуры

&НаКлиенте
&После("ОткрытьФормуЦеныИВалютаЗавершение")
Процедура АС_ОткрытьФормуЦеныИВалютаЗавершениеПосле(РезультатФормыЦеныИВалюта, ДополнительныеПараметры)
	ПересчитыватьНДС = Ложь;
	Если ТипЗнч(РезультатФормыЦеныИВалюта) = Тип("Структура")
		И РезультатФормыЦеныИВалюта.БылиВнесеныИзменения
		И ЗначениеЗаполнено(РезультатФормыЦеныИВалюта.ВидЦен) Тогда
		Если РезультатФормыЦеныИВалюта.ПерезаполнитьЦены Тогда
			АС_ПересчитатьПоставочныеЦены(РезультатФормыЦеныИВалюта.ВидЦен);
		КонецЕсли;
		АС_УстановитьВидЦенСтрокЗапасов(РезультатФормыЦеныИВалюта.ВидЦен);
		ПересчитыватьНДС = АС_СинхронизироватьСуммуВключаетНДСПоВидуЦен(
			РезультатФормыЦеныИВалюта.ВидЦен);
	КонецЕсли;

	Если ТипЗнч(РезультатФормыЦеныИВалюта) = Тип("Структура")
		И РезультатФормыЦеныИВалюта.БылиВнесеныИзменения
		И (ПересчитыватьНДС
			Или РезультатФормыЦеныИВалюта.НалогообложениеНДС
			<> РезультатФормыЦеныИВалюта.ПредНалогообложениеНДС) Тогда
		АС_ПересчитатьНДСПослеИзмененияНалогообложения();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура АС_ПересчитатьНДСПослеИзмененияНалогообложения()

