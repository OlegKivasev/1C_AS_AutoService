КонецПроцедуры

&НаКлиенте
Процедура АС_СообщитьОЗапретеИзмененияСтрок()

	ОбщегоНазначенияКлиент.СообщитьПользователю(
		"Заказ-наряд готов к проверке. Изменять товары и работы может только администратор.");

КонецПроцедуры

&НаКлиенте
Процедура АС_ОформитьТекущуюСтрокуКакРазовуюПозицию(Наименование)

	НаименованиеРазовойПозиции = СокрЛП(Наименование);
	Если ПустаяСтрока(НаименованиеРазовойПозиции) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			"Наименование разовой позиции не может быть пустым.");
		Возврат;
	КонецЕсли;

	СтрокаТабличнойЧасти = Элементы.Запасы.ТекущиеДанные;
	Если СтрокаТабличнойЧасти = Неопределено Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			"Не удалось определить строку для временного товара.");
		Возврат;
	КонецЕсли;

	СтрокаТабличнойЧасти.Номенклатура = НаименованиеРазовойПозиции;
	СтрокаТабличнойЧасти.Содержание = НаименованиеРазовойПозиции;
	СтрокаТабличнойЧасти.АС_НеСписывать = Истина;
	СтрокаТабличнойЧасти.АС_НеУчитывать = Ложь;
	СтрокаТабличнойЧасти.ТипНоменклатурыЗапас = Ложь;
	Если СтрокаТабличнойЧасти.Количество = 0 Тогда
		СтрокаТабличнойЧасти.Количество = 1;
	КонецЕсли;

	АС_ЗаполнитьОбязательныеПоляРазовойПозиции(СтрокаТабличнойЧасти);
	РассчитатьСуммуВСтрокеТабличнойЧасти("Запасы", СтрокаТабличнойЧасти);
	АС_ПересчитатьДоступность();
	АС_ОбновитьИтогиПослеИзмененияСтоимости();
	Модифицированность = Истина;

КонецПроцедуры

&НаКлиенте
Процедура АС_ОткрытьКарточкуНоменклатуры(Команда)

	ТекущиеДанные = Элементы.Запасы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено
		Или Не ЗначениеЗаполнено(ТекущиеДанные.Номенклатура) Тогда
		Возврат;
	КонецЕсли;

	ПоказатьЗначение(Неопределено, ТекущиеДанные.Номенклатура);

КонецПроцедуры

&НаКлиенте
Процедура АС_ОткрытьКарточкуРаботы(Команда)

	ТекущиеДанные = Элементы.Работы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено
		Или Не ЗначениеЗаполнено(ТекущиеДанные.Номенклатура) Тогда
		Возврат;
	КонецЕсли;

	ПоказатьЗначение(Неопределено, ТекущиеДанные.Номенклатура);

КонецПроцедуры

&НаКлиенте
Процедура АС_УстановитьВидЦенЗаказНарядаПослеОткрытия(Отказ)

	ВидЦенПоУмолчанию = АС_ПолучитьВидЦенЗаказНарядаПриОткрытии();
	Если ЗначениеЗаполнено(ВидЦенПоУмолчанию)
		И Объект.ВидЦен <> ВидЦенПоУмолчанию Тогда
		Объект.ВидЦен = ВидЦенПоУмолчанию;
		ЦеныИВалюта = ЦеныИВалютаКлиентСервер.ТекстНадписиЦеныИВалюта(
			Объект,
			ВалютаРасчетов,
			КурсНациональнаяВалюта,
			УчетВалютныхОпераций);
	КонецЕсли;

	АС_СинхронизироватьВидЦенДокумента();
	АС_УстановитьВидЦенСтрокЗапасов(Неопределено, Истина);

	Если АС_АвтозаполнениеИзЗаказаПоставщика Тогда
		ВставитьСтроки("Запасы", "Запасы");
		Модифицированность = Истина;
		АС_АвтозаполнениеИзЗаказаПоставщика = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_ОтменитьТоварыПоВозвратуПокупателяПослеОткрытия(Отказ)

	Если АС_СтрокиОтменыВозвратаПокупателя = Неопределено
		Или АС_СтрокиОтменыВозвратаПокупателя.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	АС_ОтменитьТоварыПоВозвратуПокупателя(АС_СтрокиОтменыВозвратаПокупателя);
	АС_СтрокиОтменыВозвратаПокупателя.Очистить();

КонецПроцедуры

&НаКлиенте
Процедура АС_ИнициализироватьВыборВидаЦен()

	АС_ВидыЦенДляВыбора = АС_ПолучитьРазрешенныеВидыЦен();

КонецПроцедуры

&НаКлиенте
Функция АС_ВидЦенРазрешен(ВидЦен)

	Если АС_ВидыЦенДляВыбора = Неопределено Тогда
		АС_ИнициализироватьВыборВидаЦен();
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ВидЦен) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого РазрешенныйВидЦен Из АС_ВидыЦенДляВыбора Цикл
		Если РазрешенныйВидЦен = ВидЦен Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

&НаКлиенте
Функция АС_ПолучитьВидЦенДляРасчета()

	Если АС_ВидыЦенДляВыбора = Неопределено Тогда
		АС_ИнициализироватьВыборВидаЦен();
	КонецЕсли;

	Если АС_ВидЦенРазрешен(Объект.ВидЦен) Тогда
		Возврат Объект.ВидЦен;
	КонецЕсли;

	Если АС_ВидыЦенДляВыбора.Количество() > 0 Тогда
		Возврат АС_ВидыЦенДляВыбора[0];
	КонецЕсли;

	Возврат ПредопределенноеЗначение("Справочник.ВидыЦен.ПустаяСсылка");

КонецФункции

&НаСервереБезКонтекста
Функция АС_ЦенаВключаетНДСВидаЦен(ВидЦен)

	Если Не ЗначениеЗаполнено(ВидЦен) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|   ВидыЦен.ЦенаВключаетНДС КАК ЦенаВключаетНДС
		|ИЗ
		|   Справочник.ВидыЦен КАК ВидыЦен
		|ГДЕ
		|   ВидыЦен.Ссылка = &ВидЦен");
	Запрос.УстановитьПараметр("ВидЦен", ВидЦен);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Выборка.ЦенаВключаетНДС;

КонецФункции

&НаКлиенте
Функция АС_СинхронизироватьСуммуВключаетНДСПоВидуЦен(ВидЦен)

	ЦенаВключаетНДС = АС_ЦенаВключаетНДСВидаЦен(ВидЦен);
	Если ЦенаВключаетНДС = Неопределено
		Или Объект.СуммаВключаетНДС = ЦенаВключаетНДС Тогда
		Возврат Ложь;
	КонецЕсли;

	Объект.СуммаВключаетНДС = ЦенаВключаетНДС;
	Возврат Истина;

КонецФункции

&НаКлиенте
Процедура АС_СинхронизироватьВидЦенДокумента()

	ВидЦенДляРасчета = АС_ПолучитьВидЦенДляРасчета();
	Если Не ЗначениеЗаполнено(ВидЦенДляРасчета) Тогда
		Возврат;
	КонецЕсли;

	Если Объект.ВидЦен <> ВидЦенДляРасчета Тогда
		Объект.ВидЦен = ВидЦенДляРасчета;
		ЦеныИВалюта = ЦеныИВалютаКлиентСервер.ТекстНадписиЦеныИВалюта(
			Объект,
			ВалютаРасчетов,
			КурсНациональнаяВалюта,
			УчетВалютныхОпераций);
	КонецЕсли;

	Если АС_СинхронизироватьСуммуВключаетНДСПоВидуЦен(ВидЦенДляРасчета) Тогда
		АС_ПересчитатьНДСПослеИзмененияНалогообложения();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_УстановитьВидЦенСтрокиЗапаса(СтрокаТабличнойЧасти)

	Если СтрокаТабличнойЧасти = Неопределено Тогда
		СтрокаТабличнойЧасти = Элементы.Запасы.ТекущиеДанные;
	КонецЕсли;

	Если СтрокаТабличнойЧасти = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтрокаТабличнойЧасти.АС_ПримененныйВидЦен = АС_ПолучитьВидЦенДляРасчета();

КонецПроцедуры

&НаКлиенте
Процедура АС_УстановитьВидЦенСтрокЗапасов(ВидЦен = Неопределено, ТолькоНезаполненные = Ложь)

	Если ВидЦен = Неопределено Тогда
		ВидЦен = АС_ПолучитьВидЦенДляРасчета();
	КонецЕсли;

	Для Каждого СтрокаТовара Из Объект.Запасы Цикл
		Если ТолькоНезаполненные И ЗначениеЗаполнено(СтрокаТовара.АС_ПримененныйВидЦен) Тогда
			Продолжить;
		КонецЕсли;
		СтрокаТовара.АС_ПримененныйВидЦен = ВидЦен;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура АС_НастроитьОграничениеВыбораВидаЦен(ИмяТЧ)

	Если АС_ВидыЦенДляВыбора = Неопределено Тогда
		АС_ИнициализироватьВыборВидаЦен();
	КонецЕсли;

	Если ИмяТЧ = "Запасы" Тогда
		Действие = ЗапасыИзменениеСтрокДействие;
		ЭлементЗначения = Элементы.ЗапасыИзменениеСтрокЗначение;
	ИначеЕсли ИмяТЧ = "Работы" Тогда
		Действие = РаботыИзменениеСтрокДействие;
		ЭлементЗначения = Элементы.РаботыИзменениеСтрокЗначение;
	Иначе
		Возврат;
	КонецЕсли;

	Если Действие <> ПредопределенноеЗначение(
			"Перечисление.ДействияГрупповогоИзмененияСтрок.УстановитьЦеныПоВиду") Тогда
		Возврат;
	КонецЕсли;

	Если АС_ВидыЦенДляВыбора = Неопределено Тогда
		АС_ВидыЦенДляВыбора = АС_ПолучитьРазрешенныеВидыЦен();
	КонецЕсли;

	АС_ПараметрыВыбораВидаЦен = Новый Массив;
	АС_ПараметрыВыбораВидаЦен.Добавить(Новый ПараметрВыбора("Отбор.Ссылка", АС_ВидыЦенДляВыбора));
	ЭлементЗначения.ПараметрыВыбора = Новый ФиксированныйМассив(АС_ПараметрыВыбораВидаЦен);

КонецПроцедуры

&НаКлиенте
&Перед("ВставитьСтроки")
Процедура АС_ВставитьСтрокиПеред(ИмяТЧ, ИмяЭлемента)

	Если ИмяТЧ = "Запасы" Тогда
		АС_СинхронизироватьВидЦенПередДобавлениемТовара();
		АС_СинхронизироватьСуществующиеСтрокиИзЗаказаПоставщика();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&После("ОбработатьВставленныеСтроки")
Процедура АС_ОбработатьВставленныеСтрокиПосле(ИмяТЧ, ИмяЭлемента, КоличествоВставленных)

	Если КоличествоВставленных = 0 Тогда
		Возврат;
	КонецЕсли;

	Если ИмяТЧ = "Работы" Тогда
		АС_ЗаполнитьПродавцаВДобавленныхРаботах(КоличествоВставленных);
		АС_ОбновитьСуммуРабот();
		Возврат;
	ИначеЕсли ИмяТЧ <> "Запасы" Тогда
		Возврат;
	КонецЕсли;

	АС_ЗаполнитьПродавцаВДобавленныхСтроках(КоличествоВставленных);

	ВставкаИзЗаказаПоставщика = АС_БуферСодержитСтрокиЗаказаПоставщикаНаСервере();
	КоличествоСтрок = Объект.Запасы.Количество();
	Для Итератор = 1 По КоличествоВставленных Цикл
		СтрокаТовара = Объект.Запасы[КоличествоСтрок - Итератор];
		АС_ЗаполнитьЦенуТовараПоВидуЦен(СтрокаТовара, Истина);
		СтрокаТовара.АС_ЦенаИзЗаказаПоставщика = Ложь;
	КонецЦикла;

	АС_ОбновитьДоступностьЦеныЗапаса();
	АС_ПересчитатьДоступность();
	АС_ОбновитьИтогиПослеИзмененияСтоимости();

	Если ВставкаИзЗаказаПоставщика Тогда
		Если АС_АвтозаполнениеИзЗаказаПоставщика Тогда
			ПараметрыОповещения = Новый Структура(
				"КоличествоВставленных,ЦеныПоставщика",
				КоличествоВставленных,
				АС_ПолучитьЦеныИзБуфераЗаказаПоставщикаНаСервере());
			АС_ПереносДляПредоплатыЗавершение(КодВозвратаДиалога.Да, ПараметрыОповещения);
		Иначе
			АС_ЗапроситьПереносДляПредоплаты(КоличествоВставленных);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_ЗапроситьПереносДляПредоплаты(КоличествоВставленных)

	ПараметрыОповещения = Новый Структура("КоличествоВставленных", КоличествоВставленных);
	Оповещение = Новый ОписаниеОповещения(
		"АС_ПереносДляПредоплатыЗавершение", ЭтотОбъект, ПараметрыОповещения);
	ПоказатьВопрос(
		Оповещение,
		"Вы добавляете товары для предоплаты?" + Символы.ПС
			+ "Да, добавить для предоплаты." + Символы.ПС
			+ "Нет, добавить простым копированием.",
		РежимДиалогаВопрос.ДаНет,
		0,
		КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура АС_ПереносДляПредоплатыЗавершение(Результат, ПараметрыОповещения) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	КоличествоСтрок = Объект.Запасы.Количество();
	Для Итератор = 1 По ПараметрыОповещения.КоличествоВставленных Цикл
		ИндексЦены = ПараметрыОповещения.КоличествоВставленных - Итератор;
		ЦенаПоставщика = Неопределено;
		Если ПараметрыОповещения.Свойство("ЦеныПоставщика")
			И ПараметрыОповещения.ЦеныПоставщика.Количество() > ИндексЦены Тогда
			ЦенаПоставщика = ПараметрыОповещения.ЦеныПоставщика[ИндексЦены];
		КонецЕсли;
		АС_РассчитатьЦенуОтЗаказаПоставщика(
			Объект.Запасы[КоличествоСтрок - Итератор], ЦенаПоставщика);
	КонецЦикла;

	АС_ОбновитьДоступностьЦеныЗапаса();
	АС_ПересчитатьДоступность();
	АС_ОбновитьИтогиПослеИзмененияСтоимости();

КонецПроцедуры

&НаСервере
Процедура АС_УстановитьОформлениеЦеныЗаказаПоставщика()

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
		ЭлементОформления.Отбор,
		"Объект.Запасы.АС_ЦенаИзЗаказаПоставщика",
		Истина);
	РаботаСФормой.ДобавитьОформляемоеПоле(ЭлементОформления, Элементы.ЗапасыЦена.Имя);
	РаботаСФормой.ДобавитьЭлементУсловногоОформления(
		ЭлементОформления,
		"ЦветФона",
		Новый Цвет(204, 238, 255));

КонецПроцедуры

&НаКлиенте
Процедура АС_РассчитатьЦенуОтЗаказаПоставщика(СтрокаТабличнойЧасти, ЦенаПоставщика = Неопределено)

	Если СтрокаТабличнойЧасти = Неопределено
		Или ТипЗнч(СтрокаТабличнойЧасти.Номенклатура) <> Тип("СправочникСсылка.Номенклатура")
		Или Не СтрокаТабличнойЧасти.ТипНоменклатурыЗапас Тогда
		Возврат;
	КонецЕсли;

	ВидЦенДляРасчета = АС_ПолучитьВидЦенДляРасчета();
	Если Не ЗначениеЗаполнено(ВидЦенДляРасчета) Тогда
		Возврат;
	КонецЕсли;

	Если ЦенаПоставщика = Неопределено Тогда
		ЦенаПоставщика = АС_ПолучитьЦенуИзБуфераЗаказаПоставщикаНаСервере(
			СтрокаТабличнойЧасти.Номенклатура,
			СтрокаТабличнойЧасти.Характеристика);
	КонецЕсли;
	СтрокаТабличнойЧасти.Цена = АС_РассчитатьЦенуПоЦенеПоставщикаНаСервере(
		ЦенаПоставщика,
		СтрокаТабличнойЧасти.Номенклатура,
		ВидЦенДляРасчета);
	СтрокаТабличнойЧасти.АС_ПримененныйВидЦен = ВидЦенДляРасчета;
	СтрокаТабличнойЧасти.АС_ЦенаИзЗаказаПоставщика = Истина;
	СтрокаТабличнойЧасти.АС_ИсходнаяЦенаЗаказаПоставщика = ЦенаПоставщика;
	РассчитатьСуммуВСтрокеТабличнойЧасти("Запасы", СтрокаТабличнойЧасти);

КонецПроцедуры

&НаКлиенте
Процедура АС_СинхронизироватьСуществующиеСтрокиИзЗаказаПоставщика()

	Если Не АС_АвтозаполнениеИзЗаказаПоставщика Тогда
		Возврат;
	КонецЕсли;

	ИзмененныеСтроки = АС_СинхронизироватьСуществующиеСтрокиИзЗаказаПоставщикаНаСервере();
	Для Каждого ДанныеСтроки Из ИзмененныеСтроки Цикл
		Если ДанныеСтроки.Действие = "Отмена" И ДанныеСтроки.Количество > 0 Тогда
			АС_ОтменитьКоличествоИзЗаказаПоставщика(ДанныеСтроки);
		КонецЕсли;
	КонецЦикла;

	Для Каждого ДанныеСтроки Из ИзмененныеСтроки Цикл
		Если ДанныеСтроки.Действие <> "Обновить" Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого СтрокаТовара Из Объект.Запасы Цикл
			Если СтрокаТовара.Номенклатура = ДанныеСтроки.Номенклатура
				И СтрокаТовара.Характеристика = ДанныеСтроки.Характеристика Тогда
				СтрокаТовара.Количество = ДанныеСтроки.Количество;
				Если ДанныеСтроки.ОбновлятьЦену Тогда
					АС_РассчитатьЦенуОтЗаказаПоставщика(СтрокаТовара, ДанныеСтроки.ЦенаПоставщика);
				Иначе
					РассчитатьСуммуВСтрокеТабличнойЧасти("Запасы", СтрокаТовара);
				КонецЕсли;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	АС_ОбновитьИтогиПослеИзмененияСтоимости();

КонецПроцедуры

&НаКлиенте
Процедура АС_ОтменитьКоличествоИзЗаказаПоставщика(ДанныеСтроки)

	ОсталосьОтменить = ДанныеСтроки.Количество;
	Для Каждого СтрокаТовара Из Объект.Запасы Цикл
		Если СтрокаТовара.Номенклатура <> ДанныеСтроки.Номенклатура
			Или СтрокаТовара.Характеристика <> ДанныеСтроки.Характеристика
			Или Не СтрокаТовара.АС_ЦенаИзЗаказаПоставщика
			Или СтрокаТовара.АС_ИсходнаяЦенаЗаказаПоставщика <> ДанныеСтроки.ЦенаПоставщика Тогда
			Продолжить;
		КонецЕсли;

		КоличествоКОтмене = Мин(ОсталосьОтменить, СтрокаТовара.Количество);
		Если КоличествоКОтмене = СтрокаТовара.Количество Тогда
			СтрокиОбработки = Новый Массив;
			СтрокиОбработки.Добавить(СтрокаТовара.ПолучитьИдентификатор());
			ОбработатьОтменуТоваров(СтрокиОбработки, "Запасы");
		Иначе
			ИдентификаторыСуществующихСтрок = Новый Соответствие;
			Для Каждого СуществующаяСтрока Из Объект.Запасы Цикл
				ИдентификаторыСуществующихСтрок.Вставить(СуществующаяСтрока.ПолучитьИдентификатор(), Истина);
			КонецЦикла;

			ПараметрыРазделения = Новый Структура(
				"СтрокаТабличнойЧасти,ИмяТЧ", СтрокаТовара, "Запасы");
			РазбитьСтрокуТабличнойЧастиЗавершение(КоличествоКОтмене, ПараметрыРазделения);

			НоваяСтрока = Неопределено;
			Для Каждого СтрокаПослеРазделения Из Объект.Запасы Цикл
				Если ИдентификаторыСуществующихСтрок.Получить(
						СтрокаПослеРазделения.ПолучитьИдентификатор()) = Неопределено Тогда
					НоваяСтрока = СтрокаПослеРазделения;
					Прервать;
				КонецЕсли;
			КонецЦикла;

			Если НоваяСтрока = Неопределено Тогда
				Сообщить("Не удалось создать строку для отмены товара из заказа поставщика.");
				Возврат;
			КонецЕсли;

			СтрокиОбработки = Новый Массив;
			СтрокиОбработки.Добавить(НоваяСтрока.ПолучитьИдентификатор());
			ОбработатьОтменуТоваров(СтрокиОбработки, "Запасы");
		КонецЕсли;

		ОсталосьОтменить = ОсталосьОтменить - КоличествоКОтмене;
		Если ОсталосьОтменить = 0 Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;

	Сообщить("Не удалось полностью перенести отмену товара из заказа поставщика.");

КонецПроцедуры

&НаСервере
Функция АС_СинхронизироватьСуществующиеСтрокиИзЗаказаПоставщикаНаСервере()

	Результат = Новый Массив;
	СкопированныеСтроки = ХранилищеОбщихНастроек.Загрузить(
		"БуферОбменаТабличныеЧасти", "Строки");
	Если СкопированныеСтроки = Неопределено
		Или СкопированныеСтроки.Колонки.Найти("АС_ИсточникЗаказПоставщика") = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	ЕстьКолонкаОтмены = СкопированныеСтроки.Колонки.Найти("АС_ОтменитьВЗаказеПокупателя") <> Неопределено;

	Для Каждого СтрокаПоставщика Из СкопированныеСтроки Цикл
		Если СтрокаПоставщика.АС_ИсточникЗаказПоставщика
			И ЕстьКолонкаОтмены
			И СтрокаПоставщика.АС_ОтменитьВЗаказеПокупателя Тогда
			СтрокаРезультата = Неопределено;
			Для Каждого СтрокаРезультатаПоиска Из Результат Цикл
				Если СтрокаРезультатаПоиска.Действие = "Отмена"
					И СтрокаРезультатаПоиска.Номенклатура = СтрокаПоставщика.Номенклатура
					И СтрокаРезультатаПоиска.Характеристика = СтрокаПоставщика.Характеристика
					И СтрокаРезультатаПоиска.ЦенаПоставщика = СтрокаПоставщика.АС_ЦенаЗаказаПоставщика Тогда
					СтрокаРезультата = СтрокаРезультатаПоиска;
					Прервать;
				КонецЕсли;
			КонецЦикла;

			Если СтрокаРезультата = Неопределено Тогда
				СтрокаРезультата = Новый Структура(
					"Действие,Номенклатура,Характеристика,ЦенаПоставщика,Количество",
					"Отмена",
					СтрокаПоставщика.Номенклатура,
					СтрокаПоставщика.Характеристика,
					СтрокаПоставщика.АС_ЦенаЗаказаПоставщика,
					0);
				Результат.Добавить(СтрокаРезультата);
			КонецЕсли;
			СтрокаРезультата.Количество = СтрокаРезультата.Количество + СтрокаПоставщика.Количество;
		КонецЕсли;
	КонецЦикла;

	Для Каждого СтрокаРезультата Из Результат Цикл
		Если СтрокаРезультата.Действие <> "Отмена" Тогда
			Продолжить;
		КонецЕсли;

		КоличествоУжеОтменено = 0;
		Для Каждого СтрокаОтменыПокупателя Из Объект.ОтмененныеЗапасы Цикл
			Если СтрокаОтменыПокупателя.Номенклатура = СтрокаРезультата.Номенклатура
				И СтрокаОтменыПокупателя.Характеристика = СтрокаРезультата.Характеристика
				И СтрокаОтменыПокупателя.АС_ЦенаИзЗаказаПоставщика
				И СтрокаОтменыПокупателя.АС_ИсходнаяЦенаЗаказаПоставщика = СтрокаРезультата.ЦенаПоставщика Тогда
				КоличествоУжеОтменено = КоличествоУжеОтменено + СтрокаОтменыПокупателя.Количество;
			КонецЕсли;
		КонецЦикла;
		СтрокаРезультата.Количество = Макс(0, СтрокаРезультата.Количество - КоличествоУжеОтменено);
	КонецЦикла;

	ИндексСтроки = СкопированныеСтроки.Количество() - 1;
	Пока ИндексСтроки >= 0 Цикл
		СтрокаПоставщика = СкопированныеСтроки[ИндексСтроки];
		Если СтрокаПоставщика.АС_ИсточникЗаказПоставщика Тогда
			Если ЕстьКолонкаОтмены И СтрокаПоставщика.АС_ОтменитьВЗаказеПокупателя Тогда
				СкопированныеСтроки.Удалить(СтрокаПоставщика);
				ИндексСтроки = ИндексСтроки - 1;
				Продолжить;
			КонецЕсли;
			Для Каждого СтрокаПокупателя Из Объект.Запасы Цикл
			Если СтрокаПокупателя.Номенклатура = СтрокаПоставщика.Номенклатура
				И СтрокаПокупателя.Характеристика = СтрокаПоставщика.Характеристика
				И СтрокаПокупателя.АС_ЦенаИзЗаказаПоставщика
				И СтрокаПокупателя.АС_ИсходнаяЦенаЗаказаПоставщика = СтрокаПоставщика.АС_ЦенаЗаказаПоставщика Тогда
					Результат.Добавить(Новый Структура(
						"Действие,Номенклатура,Характеристика,ЦенаПоставщика,Количество,ОбновлятьЦену",
						"Обновить",
						СтрокаПоставщика.Номенклатура,
						СтрокаПоставщика.Характеристика,
						СтрокаПоставщика.АС_ЦенаЗаказаПоставщика,
						СтрокаПоставщика.Количество,
						СтрокаПокупателя.АС_ЦенаИзЗаказаПоставщика));
					СкопированныеСтроки.Удалить(СтрокаПоставщика);
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		ИндексСтроки = ИндексСтроки - 1;
	КонецЦикла;

	ХранилищеОбщихНастроек.Сохранить("БуферОбменаТабличныеЧасти", "Строки", СкопированныеСтроки);
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция АС_ПолучитьЦеныИзБуфераЗаказаПоставщикаНаСервере()

	Результат = Новый Массив;
	СкопированныеСтроки = ХранилищеОбщихНастроек.Загрузить(
		"БуферОбменаТабличныеЧасти", "Строки");
	Если СкопированныеСтроки = Неопределено
		Или СкопированныеСтроки.Колонки.Найти("АС_ЦенаЗаказаПоставщика") = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Строка Из СкопированныеСтроки Цикл
		Если Строка.АС_ИсточникЗаказПоставщика Тогда
			Результат.Добавить(Строка.АС_ЦенаЗаказаПоставщика);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция АС_БуферСодержитСтрокиЗаказаПоставщикаНаСервере()

	СкопированныеСтроки = ХранилищеОбщихНастроек.Загрузить(
		"БуферОбменаТабличныеЧасти", "Строки");
	Если СкопированныеСтроки = Неопределено
		Или СкопированныеСтроки.Колонки.Найти("АС_ИсточникЗаказПоставщика") = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Строка Из СкопированныеСтроки Цикл
		Если Строка.АС_ИсточникЗаказПоставщика Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

&НаСервереБезКонтекста
Функция АС_ПолучитьЦенуИзБуфераЗаказаПоставщикаНаСервере(Номенклатура, Характеристика)

	СкопированныеСтроки = ХранилищеОбщихНастроек.Загрузить(
		"БуферОбменаТабличныеЧасти", "Строки");
	Если СкопированныеСтроки = Неопределено
		Или СкопированныеСтроки.Колонки.Найти("АС_ЦенаЗаказаПоставщика") = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Для Каждого Строка Из СкопированныеСтроки Цикл
		Если Строка.Номенклатура = Номенклатура
			И Строка.Характеристика = Характеристика Тогда
			Возврат Строка.АС_ЦенаЗаказаПоставщика;
		КонецЕсли;
	КонецЦикла;

	Возврат 0;

КонецФункции

&НаСервереБезКонтекста
Функция АС_РассчитатьЦенуПоЦенеПоставщикаНаСервере(ЦенаПоставщика, Номенклатура, ВидЦен)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|   ВЫБОР
		|       КОГДА УсловияПоЦеновымГруппам.Формула ЕСТЬ NULL
		|           ТОГДА ВидыЦен.Формула
		|       ИНАЧЕ УсловияПоЦеновымГруппам.Формула
		|   КОНЕЦ КАК Формула
		|ИЗ
		|   Справочник.ВидыЦен КАК ВидыЦен
		|       ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыЦен.ЦеновыеГруппы КАК УсловияПоЦеновымГруппам
		|       ПО УсловияПоЦеновымГруппам.Ссылка = ВидыЦен.Ссылка
		|           И УсловияПоЦеновымГруппам.ЦеноваяГруппа = &ЦеноваяГруппа
		|ГДЕ
		|   ВидыЦен.Ссылка = &ВидЦен");
	Запрос.УстановитьПараметр("ЦеноваяГруппа", Номенклатура.ЦеноваяГруппа);
	Запрос.УстановитьПараметр("ВидЦен", ВидЦен);
	Результат = Запрос.Выполнить().Выбрать();
	Если Не Результат.Следующий() Тогда
		ВызватьИсключение "Не найден вид цены для расчета цены по заказу поставщика.";
	КонецЕсли;

	Если ПустаяСтрока(Результат.Формула) Тогда
		Возврат ЦенаПоставщика;
	КонецЕсли;

	ТаблицаОперандов = ЦенообразованиеФормулыСервер.ПолучитьТаблицуОперандовФормулы(
		ТекущаяДатаСеанса(), Результат.Формула);
	ТаблицаОперандов.Колонки.Добавить("Значение");
	ОперандЗакупочнойЦены = ТаблицаОперандов.Найти("[Закупочнаяцена]", "Операнд");
	Если ОперандЗакупочнойЦены = Неопределено Тогда
		ВызватьИсключение "Формула вида цены " + Строка(ВидЦен)
			+ " не содержит операнд [Закупочнаяцена].";
	КонецЕсли;

	ЗначенияЗакупочнойЦены = Новый ТаблицаЗначений;
	ЗначенияЗакупочнойЦены.Колонки.Добавить("ВидЦен", Новый ОписаниеТипов("СправочникСсылка.ВидыЦен"));
	ЗначенияЗакупочнойЦены.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ЗначенияЗакупочнойЦены.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ЗначенияЗакупочнойЦены.Колонки.Добавить("Значение", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	ЗначенияЗакупочнойЦены.Колонки.Добавить("ЕдиницаИзмерения", Новый ОписаниеТипов("СправочникСсылка.ЕдиницыИзмерения"));
	ЗначенияЗакупочнойЦены.Колонки.Добавить("Курс", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 4)));
	ЗначенияЗакупочнойЦены.Колонки.Добавить("Кратность", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 4)));
	СтрокаЗакупочнойЦены = ЗначенияЗакупочнойЦены.Добавить();
	СтрокаЗакупочнойЦены.ВидЦен = ОперандЗакупочнойЦены.ВидЦен;
	СтрокаЗакупочнойЦены.Номенклатура = Номенклатура;
	СтрокаЗакупочнойЦены.Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	СтрокаЗакупочнойЦены.Значение = ЦенаПоставщика;
	СтрокаЗакупочнойЦены.ЕдиницаИзмерения = Номенклатура.ЕдиницаИзмерения;
	СтрокаЗакупочнойЦены.Курс = 1;
	СтрокаЗакупочнойЦены.Кратность = 1;
	ОперандЗакупочнойЦены.Значение = ЗначенияЗакупочнойЦены;

	КоллекцияНоменклатуры = Новый ТаблицаЗначений;
	КоллекцияНоменклатуры.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата"));
	КоллекцияНоменклатуры.Колонки.Добавить("ВидЦен", Новый ОписаниеТипов("СправочникСсылка.ВидыЦен"));
	КоллекцияНоменклатуры.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	КоллекцияНоменклатуры.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	КоллекцияНоменклатуры.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	КоллекцияНоменклатуры.Колонки.Добавить("Актуальность", Новый ОписаниеТипов("Булево"));
	КоллекцияНоменклатуры.Колонки.Добавить("ЕдиницаИзмерения", Новый ОписаниеТипов("СправочникСсылка.ЕдиницыИзмерения"));
	КоллекцияНоменклатуры.Колонки.Добавить("ВключаяХарактеристики", Новый ОписаниеТипов("Булево"));
	КоллекцияНоменклатуры.Колонки.Добавить("Автор", Новый ОписаниеТипов("СправочникСсылка.Пользователи"));
	КоллекцияНоменклатуры.Колонки.Добавить("ПересчетВыполнен", Новый ОписаниеТипов("Булево"));
	КоллекцияНоменклатуры.Колонки.Добавить("Формула", ОбщегоНазначения.ОписаниеТипаСтрока(1024));
	СтрокаКоллекции = КоллекцияНоменклатуры.Добавить();
	СтрокаКоллекции.Период = ТекущаяДатаСеанса();
	СтрокаКоллекции.ВидЦен = ВидЦен;
	СтрокаКоллекции.Номенклатура = Номенклатура;
	СтрокаКоллекции.Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	СтрокаКоллекции.Цена = 0;
	СтрокаКоллекции.Актуальность = Истина;
	СтрокаКоллекции.ЕдиницаИзмерения = Номенклатура.ЕдиницаИзмерения;
	СтрокаКоллекции.ВключаяХарактеристики = Ложь;
	СтрокаКоллекции.ПересчетВыполнен = Ложь;
	СтрокаКоллекции.Формула = Результат.Формула;

	КурсВалюты = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВидЦен.ВалютаЦены, ТекущаяДатаСеанса());
	ПараметрыРасчета = Новый Структура("ВидЦен, Курс, Кратность", ВидЦен,
		?(ЗначениеЗаполнено(КурсВалюты.Курс), КурсВалюты.Курс, 1),
		?(ЗначениеЗаполнено(КурсВалюты.Кратность), КурсВалюты.Кратность, 1));
	ЦенообразованиеФормулыСервер.РассчитатьДанныеКоллекции(
		КоллекцияНоменклатуры, ТаблицаОперандов, ПараметрыРасчета);

	Если КоллекцияНоменклатуры.Количество() = 0 Тогда
		ВызватьИсключение "Не удалось рассчитать цену по формуле вида цены " + Строка(ВидЦен) + ".";
	КонецЕсли;

	Возврат КоллекцияНоменклатуры[0].Цена;

КонецФункции

&НаКлиенте
Функция АС_РазрешитьИспользованиеВидаЦен(ИмяТЧ)

	Если АС_ВидыЦенДляВыбора = Неопределено Тогда
		АС_ИнициализироватьВыборВидаЦен();
	КонецЕсли;

	Если ИмяТЧ = "Запасы" Тогда
		Действие = ЗапасыИзменениеСтрокДействие;
		ВидЦен = ЗапасыИзменениеСтрокЗначение;
	ИначеЕсли ИмяТЧ = "Работы" Тогда
		Действие = РаботыИзменениеСтрокДействие;
		ВидЦен = РаботыИзменениеСтрокЗначение;
	Иначе
		Возврат Истина;
	КонецЕсли;

	Если Действие <> ПредопределенноеЗначение(
			"Перечисление.ДействияГрупповогоИзмененияСтрок.УстановитьЦеныПоВиду")
		Или Не ЗначениеЗаполнено(ВидЦен) Тогда
		Возврат Истина;
	КонецЕсли;

	Для Каждого РазрешенныйВидЦен Из АС_ВидыЦенДляВыбора Цикл
		Если РазрешенныйВидЦен = ВидЦен Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Сообщить("Вид цены «" + Строка(ВидЦен)
		+ "» недоступен согласно профилю доступа.");

	Возврат Ложь;

