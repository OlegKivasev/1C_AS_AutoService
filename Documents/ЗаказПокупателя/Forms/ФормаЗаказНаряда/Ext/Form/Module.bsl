		Если СтрокаТовара <> Неопределено Тогда
			СтрокаТовара.АС_ИдентификаторСтрокиПродажи = "";
			СтрокаТовара.АС_ДатаДобавления = Дата(1, 1, 1);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&После("Подключаемый_ОбновитьКоманды")
Процедура АС_ПослеОбновленияПодключаемыхКоманд()

	АС_ПрименитьБлокировкуЗаказНарядаГотовогоКПроверке();

