Процедура АС_НастроитьДоступностьРучнойСкидки()

	Доступно = АС_РазрешеноПрименятьСкидки() ИЛИ АС_РазрешеноРедактированиеЦенДокументов();

	Элементы.ЗНРаботыПроцентСкидкиНаценки.ТолькоПросмотр = НЕ Доступно;
	Элементы.ЗНРаботыСуммаСкидкиНаценки.ТолькоПросмотр = НЕ Доступно;
	Элементы.ЗапасыПроцентСкидкиНаценки.ТолькоПросмотр = НЕ Доступно;
	Элементы.ЗапасыСуммаСкидкиНаценки.ТолькоПросмотр = НЕ Доступно;
	Элементы.СкидкиИтоги.ТолькоПросмотр = НЕ Доступно;
	Элементы.СкидкаПроцент.ТолькоПросмотр = НЕ Доступно;
	Элементы.СкидкаСумма.ТолькоПросмотр = НЕ Доступно;

