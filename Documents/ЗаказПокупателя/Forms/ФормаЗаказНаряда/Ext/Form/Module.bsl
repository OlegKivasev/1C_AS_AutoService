	РаботаСФормой.ДобавитьОформляемоеПоле(
		ОформлениеФлажкаНеСписывать,
		Элементы.АС_ЗапасыНеСписывать.Имя);
	РаботаСФормой.ДобавитьЭлементУсловногоОформления(
		ОформлениеФлажкаНеСписывать,
		"ТолькоПросмотр",
		Истина);

КонецПроцедуры

&НаСервере
Процедура АС_УстановитьОформлениеНеучитываемыхСтрок()

	ОформлениеНеучитываемойСтроки = УсловноеОформление.Элементы.Добавить();
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
		ОформлениеНеучитываемойСтроки.Отбор,
		"Объект.Запасы.АС_НеУчитывать",
		Истина);
	АС_ДобавитьПоляОформляемойСтроки(
		ОформлениеНеучитываемойСтроки,
		Элементы.Запасы.ПодчиненныеЭлементы);
	РаботаСФормой.ДобавитьЭлементУсловногоОформления(
		ОформлениеНеучитываемойСтроки,
		"ЦветФона",
		Новый Цвет(230, 230, 230));
	РаботаСФормой.ДобавитьЭлементУсловногоОформления(
		ОформлениеНеучитываемойСтроки,
		"ЦветТекста",
		ЦветаСтиля.ЦветНедоступногоТекстаТабличнойЧасти);

КонецПроцедуры

&НаСервере
Процедура АС_ДобавитьПоляОформляемойСтроки(ЭлементОформленияСтроки, КоллекцияЭлементов)

	Для Каждого ЭлементКолонки Из КоллекцияЭлементов Цикл
		Если ТипЗнч(ЭлементКолонки) = Тип("ПолеФормы") Тогда
			РаботаСФормой.ДобавитьОформляемоеПоле(ЭлементОформленияСтроки, ЭлементКолонки.Имя);
		Иначе
			Попытка
				АС_ДобавитьПоляОформляемойСтроки(
					ЭлементОформленияСтроки,
					ЭлементКолонки.ПодчиненныеЭлементы);
			Исключение
				// У листового элемента нет подчиненных элементов.
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
&Перед("ПередЗаписью")
Процедура АС_ПередЗаписью(Отказ, ПараметрыЗаписи)

	ПроверкаПерехода = АС_ПроверитьПереходСостоянияЗаказНаряда();
	Если Не ПроверкаПерехода.Разрешен Тогда
		Отказ = Истина;
		ОбщегоНазначенияКлиент.СообщитьПользователю(ПроверкаПерехода.ТекстОшибки);
		Возврат;
	КонецЕсли;
	Если Объект.СостояниеЗаказа = ПредопределенноеЗначение("Справочник.СостоянияЗаказНарядов.Завершен")
		И Объект.СостояниеЗаказа <> ПроверкаПерехода.СостояниеДоИзменения Тогда
		Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
			Отказ = Истина;
			ОбщегоНазначенияКлиент.СообщитьПользователю(
				"Для отмены проведения сначала отмените несохраненный переход в состояние «Завершен».");
			Возврат;
		КонецЕсли;
		// Завершение проводим до блокировки, в том числе при команде «Записать».
		// Вариант завершения сохраняем из штатной обработки состояния и выбора пользователя.
		ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение;
	КонецЕсли;


	Если АС_ФормаГотоваКОкруглению = Истина
		И АС_ПересчитываетсяОкруглениеЦен <> Истина
		И Не АС_СтоимостьЗаписанногоДокументаНеИзменена() Тогда
		АС_ВосстановитьЦеныДоОкругления();
	КонецЕсли;
	АС_ОграничитьРучныеСкидкиПередЗаписью();
	АС_ЗаполнитьОбязательныеПоляРазовыхПозицийПередЗаписью();
	АС_ПроверитьПродавцовПередЗаписью(Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	АС_ПроверитьПродавцовРаботПередЗаписью(Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.Ответственный) Тогда
		Отказ = Истина;
		Сообщить("Выберите ответственного перед записью или проведением заказа-наряда.");
	КонецЕсли;


КонецПроцедуры

&НаКлиенте
&После("ПередЗаписью")
Процедура АС_ПередЗаписьюПосле(Отказ, ПараметрыЗаписи)

	Если Отказ Тогда
		ОбновитьПодвалФормы();
		Возврат;
	КонецЕсли;

	Если Не АС_СтоимостьЗаписанногоДокументаНеИзменена() Тогда
		АС_ПересчитатьСтоимостьИПроверитьПередЗаписью(Отказ);
	Иначе
		АС_ПроверитьЦеныБезПересчета(Отказ);
	КонецЕсли;

	Если Не Отказ И АС_ТребуетсяПодтверждениеПробега() Тогда
		Отказ = Истина;
		СохраненныеПараметры = Новый Структура;
		Для Каждого Параметр Из ПараметрыЗаписи Цикл
			СохраненныеПараметры.Вставить(Параметр.Ключ, Параметр.Значение);
		КонецЦикла;
		АС_ЗапроситьПодтверждениеПробега(Объект.СостояниеЗаказа, СохраненныеПараметры);
	КонецЕсли;
	Если Не Отказ Тогда АС_ПроверитьТелефонПередЗаписью(Отказ, ПараметрыЗаписи); КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура АС_ПриЧтенииНаСервере(ТекущийОбъект)

	АС_НовыйДокументДляТелефона = ТекущийОбъект.ЭтоНовый();
	АС_ОбновитьТелефонКонтрагента();

	Если ЗначениеЗаполнено(АС_АдресСнимкаСтоимости) Тогда
		УдалитьИзВременногоХранилища(АС_АдресСнимкаСтоимости);
	КонецЕсли;
	АС_АдресСнимкаСтоимости = ПоместитьВоВременноеХранилище(
		АС_СоздатьСнимокСтоимости(ТекущийОбъект), УникальныйИдентификатор);
	АС_СтоимостьТребуетСнимка = Истина;

	АС_ОбновитьФактическиеДаты();
	Если Объект.ИспользоватьТовары
		И Объект.Запасы.Количество() > 0 Тогда
		АС_ЗаполнитьОстаткиПриОткрытииНаСервере();
	КонецЕсли;
	АС_ЗаполнитьКоличествоДнейДоВозврата();

	Если АС_НужноБлокироватьЗаказНарядДляПользователя() Тогда
		ТолькоПросмотр = Истина;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура АС_ЗаполнитьКоличествоДнейДоВозврата()

	СрокиВозврата = АС_УсловияВозвратаПоставщикамСервер.ПолучитьСрокиВозврата(
		Объект.Ссылка, Объект.Запасы, Объект.АС_ИсточникиПоставок);
	Для Каждого СтрокаЗапасов Из Объект.Запасы Цикл
		КоличествоДней = СрокиВозврата.Получить(СтрокаЗапасов.НомерСтроки);
		ЕстьСрок = КоличествоДней <> Неопределено;
		НовоеКоличествоДней = ?(ЕстьСрок, КоличествоДней, 0);
		ПредставлениеДней = ?(ЕстьСрок, Формат(НовоеКоличествоДней, "ЧДЦ=0"), "");
		Если СтрокаЗапасов.АС_КоличествоДнейДоВозврата <> НовоеКоличествоДней Тогда
			СтрокаЗапасов.АС_КоличествоДнейДоВозврата = НовоеКоличествоДней;
		КонецЕсли;
		Если СтрокаЗапасов.АС_ЕстьСрокВозврата <> ЕстьСрок Тогда
			СтрокаЗапасов.АС_ЕстьСрокВозврата = ЕстьСрок;
		КонецЕсли;
		Если СтрокаЗапасов.АС_ПредставлениеДнейДоВозврата <> ПредставлениеДней Тогда
			СтрокаЗапасов.АС_ПредставлениеДнейДоВозврата = ПредставлениеДней;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
&После("ПослеЗаписи")
Процедура АС_ПослеЗаписиПосле(ПараметрыЗаписи)

	АС_НовыйДокументДляТелефона = Ложь;
	АС_ПодтверждениеНекорректногоПробега = Неопределено;
	АС_СостояниеДоПроверкиПробега = Объект.СостояниеЗаказа;
	// После завершения транзакции ускоряем отправку уже сохранённого документа.
	АС_АгрегаторОтправитьОчередь();

	АС_ОбновитьФактическиеДаты();
	АС_ОбновитьОтображениеОплаты();
	// Обновляем отображение по уже сохранённым строкам, без переоценки после записи.
	ПересчетДоОбновления = АС_ПересчитываетсяОкруглениеЦен;
	АС_ПересчитываетсяОкруглениеЦен = Истина;
	Попытка
		АС_ОбновитьИтогиПослеИзмененияСтоимости();
	Исключение
		АС_ПересчитываетсяОкруглениеЦен = ПересчетДоОбновления;
		ВызватьИсключение;
	КонецПопытки;
	АС_ПересчитываетсяОкруглениеЦен = ПересчетДоОбновления;
	АС_ПересчитатьДоступность(Истина);
	АС_УстановитьВидЦенСтрокЗапасов(Неопределено, Истина);
	АС_ЗаполнитьКоличествоДнейДоВозврата();
	АС_ПрименитьБлокировкуЗаказНарядаГотовогоКПроверке();

	АС_ЗапомнитьСтоимостьЗаписанногоДокумента();

	Если ПараметрыЗаписи.Свойство("ПринудительноЗакрытьФорму")
		И ПараметрыЗаписи.ПринудительноЗакрытьФорму Тогда Закрыть(); КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_ПриОткрытии(Отказ)

	АС_СостояниеДоПроверкиПробега = Объект.СостояниеЗаказа;
	АС_НастройкиЦенОплаты = Неопределено;
	АС_ТолькоБезналичныйРежим = Неопределено;
	АС_ПоследнийНаличныйРежим = АС_НаличныйРежимОплаты();
	АС_ПоследнийРежимБезНаценкиРабот = АС_РежимОплатыТолькоБезналичный();

	АС_БезопасноеОбновлениеКлиент.НастроитьЗащитуРедакторов(ЭтотОбъект);
	АС_БезопасноеОбновлениеКлиент.ПодготовитьСостояние(АС_СостояниеФоновогоОбновления);
	АС_ОбновитьФактическиеДаты();
	АС_ОбновитьОтображениеОплаты();
	ПодключитьОбработчикОжидания("АС_ОбновитьОплатуПоОжиданию", 60, Истина);
	АС_ОграничиватьРучныеСкидки = Не АС_ПолноправныйПользователь();
	АС_ОграниченоРедактированиеЦеныУслуги = АС_НужноОграничитьРедактированиеЦеныУслуг();
	АС_ИнициализироватьВыборВидаЦен();
	АС_СинхронизироватьВидЦенДокумента();
	Если Не ЗначениеЗаполнено(Объект.Ссылка)
		И Объект.Запасы.Количество() > 0 Тогда
		АС_ПересчитатьЦеныТоваровПоТекущемуКонтрагенту();
	КонецЕсли;
	АС_НастроитьОграничениеВыбораВидаЦен("Запасы");
	АС_НастроитьОграничениеВыбораВидаЦен("Работы");
	АС_ОбновитьДоступностьЦенУслуг();
	АС_НастроитьДоступностьРучнойСкидки();

	Элементы.АС_ЗапасыДоступноСУчетомЗаказовВсего.Видимость = РежимОстаткиИРезервы;
	Если Не РежимОстаткиИРезервы Тогда
		ОстаткиИРезервы(Неопределено);
	Иначе
		АС_ПересчитатьДоступность();
	КонецЕсли;

	АС_УстановитьВидЦенЗаказНарядаПослеОткрытия(Отказ);
	АС_ОтменитьТоварыПоВозвратуПокупателяПослеОткрытия(Отказ);
	АС_ОбновитьСуммуРабот();
	АС_ПрименитьБлокировкуЗаказНарядаГотовогоКПроверке();

	// Снимок отличает изменение товаров от простого проведения или смены статуса.
	АС_ИнициализироватьЦеныРаботПриОткрытии();
	АС_ЗапомнитьСтоимостьЗаписанногоДокумента();
	// Записанный документ при открытии не переоцениваем.
	АС_ГлубинаИзмененияСтоимости = 0;
	АС_ФормаГотоваКОкруглению = Не Отказ;
	Если Не Отказ И Не ЗначениеЗаполнено(Объект.Ссылка)
		И Объект.Запасы.Количество() > 0 Тогда
		ОбновитьПодвалФормы();
	КонецЕсли;

	Если Не Отказ Тогда
		АС_ОбновитьВидимостьРежимаОплаты();
		АС_ЗапланироватьАльтернативныйИтог();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_ПрименитьБлокировкуЗаказНарядаГотовогоКПроверке()

	ПараметрыОграничений = АС_ПолучитьПараметрыОграниченийЗаказНаряда();
	БлокироватьРедактирование = ПараметрыОграничений.БлокироватьРедактирование;
	ПоказыватьКнопкиКарточек = АС_ПоказыватьКнопкиКарточекСотруднику(Объект.СостояниеЗаказа);
	Элементы.АС_ОткрытьКарточкуНоменклатуры.Видимость = ПоказыватьКнопкиКарточек;
	Элементы.АС_ОткрытьКарточкуНоменклатуры.Доступность = ПоказыватьКнопкиКарточек;
	Элементы.АС_ОткрытьКарточкуРаботы.Видимость = ПоказыватьКнопкиКарточек;
	Элементы.АС_ОткрытьКарточкуРаботы.Доступность = ПоказыватьКнопкиКарточек;

	Если БлокироватьРедактирование Тогда
		ТолькоПросмотр = Истина;
		Элементы.ПодменюСоздатьНаОснованииПереопределен.Доступность = Ложь;
		АС_УстановитьДоступностьКомандИзмененияСтрок(Ложь);
	ИначеЕсли ПараметрыОграничений.ГотовКОтправке Тогда
		АС_ПрименитьОграниченноеРедактированиеГотовКОтправке();
	ИначеЕсли Не АС_ПолноправныйПользователь() Тогда
		Если ПараметрыОграничений.ФизическоеЛицо Тогда
			АС_ОграничитьВыборСостоянияДляСотрудника(
				ПредопределенноеЗначение("Справочник.СостоянияЗаказНарядов.Завершен"));
		Иначе
			АС_ОграничитьВыборСостоянияДляСотрудника(АС_ПолучитьСостояниеГотовКПроверке());
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_ПоказыватьКнопкиКарточекСотруднику(СостояниеЗаказа)

	Если Пользователи.ЭтоПолноправныйПользователь() Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат АС_ЭтоСостояниеСНаименованием(СостояниеЗаказа, "Готов к проверке")
		Или АС_ЭтоСостояниеСНаименованием(СостояниеЗаказа, "Готов к отправке")
		Или СостояниеЗаказа = Справочники.СостоянияЗаказНарядов.Завершен;

КонецФункции

&НаСервереБезКонтекста
Функция АС_ПолучитьСостояниеГотовКПроверке()

	Возврат Справочники.СостоянияЗаказНарядов.НайтиПоНаименованию("Готов к проверке", Истина);

КонецФункции

&НаКлиенте
Процедура АС_ОграничитьВыборСостоянияДляСотрудника(РазрешенноеСостояние)

	Если Не ЗначениеЗаполнено(РазрешенноеСостояние) Тогда
		Возврат;
	КонецЕсли;

	РазрешенныеСостояния = Новый Массив;
	РазрешенныеСостояния.Добавить(РазрешенноеСостояние);
	ПараметрыВыбораСостояния = Новый Массив;
	ПараметрыВыбораСостояния.Добавить(Новый ПараметрВыбора(
		"Отбор.Ссылка", Новый ФиксированныйМассив(РазрешенныеСостояния)));
	Элементы.СостояниеЗаказа.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораСостояния);

КонецПроцедуры

&НаКлиенте
Процедура АС_ПрименитьОграниченноеРедактированиеГотовКОтправке()

	Для Каждого ЭлементФормы Из Элементы Цикл
		Если ТипЗнч(ЭлементФормы) = Тип("ПолеФормы") Тогда
			ЭлементФормы.ТолькоПросмотр = Истина;
		КонецЕсли;
	КонецЦикла;

	Элементы.ЗННомер.ТолькоПросмотр = Ложь;
	Элементы.ЗНДата.ТолькоПросмотр = Ложь;
	Элементы.ЗНСтарт.ТолькоПросмотр = Ложь;
	Элементы.ЗНФиниш.ТолькоПросмотр = Ложь;
	Элементы.ДатаОплаты.ТолькоПросмотр = Ложь;
	Элементы.СостояниеЗаказа.ТолькоПросмотр = Ложь;

	АС_ОграничитьВыборСостоянияДляСотрудника(
		ПредопределенноеЗначение("Справочник.СостоянияЗаказНарядов.Завершен"));

	// Доступ к созданию на основании определяют штатные команды и права сотрудника.
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	АС_УстановитьДоступностьКомандИзмененияСтрок(Ложь);
	Элементы.ЗаполнитьПоОснованию.Доступность = Ложь;
	Элементы.ЗаполнитьОбновитьКалькуляцию.Доступность = Ложь;
	Элементы.ЗаполнитьПоДокументуПоступления.Доступность = Ложь;
	Элементы.СчитатьДисконтнуюКарту.Доступность = Ложь;
	Элементы.ДобавитьПромокод.Доступность = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура АС_УстановитьДоступностьКомандИзмененияСтрок(ДоступностьКоманд)

	Элементы.РаботыКонтекстноеМенюОтменитьТоварыУслуги.Доступность = ДоступностьКоманд;
	Элементы.МатериалыКонтекстноеМенюЗапасыРазбитьСтроку.Доступность = ДоступностьКоманд;
	Элементы.ЗапасыКонтекстноеМенюЗапасыРазбитьСтроку.Доступность = ДоступностьКоманд;
	Элементы.ЗапасыКонтекстноеМенюОтменитьТоварыУслугиЗапасыРезервы.Доступность = ДоступностьКоманд;
	Элементы.ЗапасыКонтекстноеМенюОтменитьТоварыУслуги.Доступность = ДоступностьКоманд;

