&НаСервере
Процедура АС_ДобавитьПоляОформляемойСтроки(ЭлементОформленияСтроки, КоллекцияЭлементов)

	Для Каждого ЭлементКолонки Из КоллекцияЭлементов Цикл
		Если ТипЗнч(ЭлементКолонки) = Тип("ПолеФормы") Тогда
			РаботаСФормой.ДобавитьОформляемоеПоле(ЭлементОформленияСтроки, ЭлементКолонки.Имя);
		Иначе
			Попытка
				АС_ДобавитьПоляОформляемойСтроки(
					ЭлементОформленияСтроки,
					ЭлементКолонки.ПодчиненныеЭлементы);
			Исключение
				// У листового элемента нет подчиненных элементов.
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
&Перед("ПередЗаписью")
Процедура АС_ПередЗаписью(Отказ, ПараметрыЗаписи)

	ПроверкаПерехода = АС_ПроверитьПереходСостоянияЗаказНаряда();
	Если Не ПроверкаПерехода.Разрешен Тогда
		Отказ = Истина;
		ОбщегоНазначенияКлиент.СообщитьПользователю(ПроверкаПерехода.ТекстОшибки);
		Возврат;
	КонецЕсли;
	Если Объект.СостояниеЗаказа = ПредопределенноеЗначение("Справочник.СостоянияЗаказНарядов.Завершен")
		И Объект.СостояниеЗаказа <> ПроверкаПерехода.СостояниеДоИзменения Тогда
		Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
			Отказ = Истина;
			ОбщегоНазначенияКлиент.СообщитьПользователю(
				"Для отмены проведения сначала отмените несохраненный переход в состояние «Завершен».");
			Возврат;
		КонецЕсли;
		// Завершение проводим до блокировки, в том числе при команде «Записать».
		// Вариант завершения сохраняем из штатной обработки состояния и выбора пользователя.
		ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение;
	КонецЕсли;


	Если АС_ФормаГотоваКОкруглению = Истина
		И АС_ПересчитываетсяОкруглениеЦен <> Истина Тогда
		АС_ВосстановитьЦеныДоОкругления();
	КонецЕсли;
	АС_ОграничитьРучныеСкидкиПередЗаписью();
	АС_ЗаполнитьОбязательныеПоляРазовыхПозицийПередЗаписью();
	АС_ПроверитьПродавцовПередЗаписью(Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	АС_ПроверитьПродавцовРаботПередЗаписью(Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.Ответственный) Тогда
		Отказ = Истина;
		Сообщить("Выберите ответственного перед записью или проведением заказа-наряда.");
	КонецЕсли;

	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение
		И Объект.АС_Пробег = 0
		И АС_ПробегОбязателен(Объект.Контрагент) Тогда
		Отказ = Истина;
		Сообщить("Укажите пробег перед проведением заказа-наряда.");
	КонецЕсли;

	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение
		И Не ЗначениеЗаполнено(Объект.АС_ДокументыБухгалтеру)
		И АС_НужныДокументыБухгалтеру(Объект.Контрагент) Тогда
		Отказ = Истина;
		Сообщить("Укажите статус отправки документов бухгалтеру перед проведением заказа-наряда.");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&После("ПередЗаписью")
Процедура АС_ПередЗаписьюПосле(Отказ, ПараметрыЗаписи)

	Если Отказ Тогда
		ОбновитьПодвалФормы();
		Возврат;
	КонецЕсли;

	АС_ПересчитатьСтоимостьИПроверитьПередЗаписью(Отказ);

КонецПроцедуры

&НаСервере
Процедура АС_ПриЧтенииНаСервере(ТекущийОбъект)

	АС_ОбновитьФактическиеДаты();
	АС_ОбновитьВидимостьДокументовБухгалтеру();
	Если Объект.ИспользоватьТовары
		И Объект.Запасы.Количество() > 0 Тогда
		АС_ЗаполнитьОстаткиПриОткрытииНаСервере();
	КонецЕсли;
	АС_ЗаполнитьКоличествоДнейДоВозврата();

	Если АС_НужноБлокироватьЗаказНарядДляПользователя() Тогда
		ТолькоПросмотр = Истина;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура АС_ЗаполнитьКоличествоДнейДоВозврата()

	Для Каждого СтрокаЗапасов Из Объект.Запасы Цикл
		СтрокаЗапасов.АС_КоличествоДнейДоВозврата = 0;
		СтрокаЗапасов.АС_ЕстьСрокВозврата = Ложь;
		СтрокаЗапасов.АС_ПредставлениеДнейДоВозврата = "";
	КонецЦикла;

	Если Не ЗначениеЗаполнено(Объект.Ссылка)
		Или Объект.Запасы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		| ЗаказПоставщикуЗапасы.Номенклатура КАК Номенклатура,
		| ЗаказПоставщикуЗапасы.Характеристика КАК Характеристика,
		| МИНИМУМ(ВЫБОР
		| 	КОГДА НАЧАЛОПЕРИОДА(&ТекущаяДата, ДЕНЬ)
		| 			< НАЧАЛОПЕРИОДА(ПриходнаяНакладнаяЗапасы.Ссылка.Дата, ДЕНЬ)
		| 		ТОГДА ЗаказПоставщикуЗапасы.АС_КоличествоДнейНаВозврат
		| 	ИНАЧЕ РАЗНОСТЬДАТ(
		| 		НАЧАЛОПЕРИОДА(&ТекущаяДата, ДЕНЬ),
		| 		НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(
		| 			ПриходнаяНакладнаяЗапасы.Ссылка.Дата,
		| 			ДЕНЬ,
		| 			ЗаказПоставщикуЗапасы.АС_КоличествоДнейНаВозврат), ДЕНЬ),
		| 		ДЕНЬ)
		| КОНЕЦ) КАК КоличествоДнейДоВозврата
		|ИЗ
		| Документ.ЗаказПоставщику.Запасы КАК ЗаказПоставщикуЗапасы
		| 	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПриходнаяНакладная.Запасы КАК ПриходнаяНакладнаяЗапасы
		| 	ПО ЗаказПоставщикуЗапасы.Номенклатура = ПриходнаяНакладнаяЗапасы.Номенклатура
		| 		И ЗаказПоставщикуЗапасы.Характеристика = ПриходнаяНакладнаяЗапасы.Характеристика
		| 		И (ПриходнаяНакладнаяЗапасы.ЗаказПокупателя = ЗаказПоставщикуЗапасы.ЗаказПокупателя
		| 			ИЛИ ПриходнаяНакладнаяЗапасы.ЗаказПокупателя = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка))
		| 		И (ЗаказПоставщикуЗапасы.Ссылка = ПриходнаяНакладнаяЗапасы.Заказ
		| 			ИЛИ ЗаказПоставщикуЗапасы.Ссылка = ПриходнаяНакладнаяЗапасы.Ссылка.Заказ)
		|ГДЕ
		| ЗаказПоставщикуЗапасы.ЗаказПокупателя = &ЗаказПокупателя
		| И ЗаказПоставщикуЗапасы.АС_КоличествоДнейНаВозврат > 0
		| И ПриходнаяНакладнаяЗапасы.Ссылка.Проведен
		| И ПриходнаяНакладнаяЗапасы.Количество > 0
		|СГРУППИРОВАТЬ ПО
		| ЗаказПоставщикуЗапасы.Номенклатура,
		| ЗаказПоставщикуЗапасы.Характеристика";
	Запрос.УстановитьПараметр("ЗаказПокупателя", Объект.Ссылка);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	СрокиВозврата = Запрос.Выполнить().Выгрузить();

	Для Каждого СтрокаЗапасов Из Объект.Запасы Цикл
		ПараметрыПоиска = Новый Структура(
			"Номенклатура,Характеристика",
			СтрокаЗапасов.Номенклатура,
			СтрокаЗапасов.Характеристика);
		НайденныеСроки = СрокиВозврата.НайтиСтроки(ПараметрыПоиска);
		Если НайденныеСроки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		КоличествоДней = НайденныеСроки[0].КоличествоДнейДоВозврата;
		СтрокаЗапасов.АС_КоличествоДнейДоВозврата = КоличествоДней;
		СтрокаЗапасов.АС_ЕстьСрокВозврата = Истина;
		СтрокаЗапасов.АС_ПредставлениеДнейДоВозврата = Формат(КоличествоДней, "ЧДЦ=0");
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
&После("ПослеЗаписи")
Процедура АС_ПослеЗаписиПосле(ПараметрыЗаписи)

	АС_ОбновитьФактическиеДаты();
	АС_ОбновитьОтображениеОплаты();
	АС_ОбновитьИтогиПослеИзмененияСтоимости();
	АС_ПересчитатьДоступность(Истина);
	АС_УстановитьВидЦенСтрокЗапасов(Неопределено, Истина);
	АС_ЗаполнитьКоличествоДнейДоВозврата();
	АС_ПрименитьБлокировкуЗаказНарядаГотовогоКПроверке();

КонецПроцедуры

&НаКлиенте
Процедура АС_ПриОткрытии(Отказ)

	АС_ОбновитьФактическиеДаты();
	АС_ОбновитьОтображениеОплаты();
	ПодключитьОбработчикОжидания("АС_ОбновитьОплатуПоОжиданию", 30);
	АС_ОграничиватьРучныеСкидки = Не АС_ПолноправныйПользователь();
	АС_ОграниченоРедактированиеЦеныУслуги = АС_НужноОграничитьРедактированиеЦеныУслуг();
	АС_ИнициализироватьВыборВидаЦен();
	АС_СинхронизироватьВидЦенДокумента();
	Если Не ЗначениеЗаполнено(Объект.Ссылка)
		И Объект.Запасы.Количество() > 0 Тогда
		АС_ПересчитатьЦеныТоваровПоТекущемуКонтрагенту();
	КонецЕсли;
	АС_НастроитьОграничениеВыбораВидаЦен("Запасы");
	АС_НастроитьОграничениеВыбораВидаЦен("Работы");
	АС_ОбновитьДоступностьЦенУслуг();
	АС_НастроитьДоступностьРучнойСкидки();

	Элементы.АС_ЗапасыДоступноСУчетомЗаказовВсего.Видимость = РежимОстаткиИРезервы;
	Если Не РежимОстаткиИРезервы Тогда
		ОстаткиИРезервы(Неопределено);
	Иначе
		АС_ПересчитатьДоступность();
	КонецЕсли;

	АС_УстановитьВидЦенЗаказНарядаПослеОткрытия(Отказ);
	АС_ОтменитьТоварыПоВозвратуПокупателяПослеОткрытия(Отказ);
	АС_ОбновитьСуммуРабот();
	АС_ПрименитьБлокировкуЗаказНарядаГотовогоКПроверке();

	// Записанный документ при открытии не переоцениваем.
	АС_ГлубинаИзмененияСтоимости = 0;
	АС_ФормаГотоваКОкруглению = Не Отказ;
	Если Не Отказ И Не ЗначениеЗаполнено(Объект.Ссылка)
		И Объект.Запасы.Количество() > 0 Тогда
		ОбновитьПодвалФормы();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_ПрименитьБлокировкуЗаказНарядаГотовогоКПроверке()

	ПараметрыОграничений = АС_ПолучитьПараметрыОграниченийЗаказНаряда();
	БлокироватьРедактирование = ПараметрыОграничений.БлокироватьРедактирование;
	ПоказыватьКнопкиКарточек = АС_ПоказыватьКнопкиКарточекСотруднику(Объект.СостояниеЗаказа);
	Элементы.АС_ОткрытьКарточкуНоменклатуры.Видимость = ПоказыватьКнопкиКарточек;
	Элементы.АС_ОткрытьКарточкуНоменклатуры.Доступность = ПоказыватьКнопкиКарточек;
	Элементы.АС_ОткрытьКарточкуРаботы.Видимость = ПоказыватьКнопкиКарточек;
	Элементы.АС_ОткрытьКарточкуРаботы.Доступность = ПоказыватьКнопкиКарточек;

	Если БлокироватьРедактирование Тогда
		ТолькоПросмотр = Истина;
		Элементы.ПодменюСоздатьНаОснованииПереопределен.Доступность = Ложь;
		АС_УстановитьДоступностьКомандИзмененияСтрок(Ложь);
	ИначеЕсли ПараметрыОграничений.ГотовКОтправке Тогда
		АС_ПрименитьОграниченноеРедактированиеГотовКОтправке();
	ИначеЕсли Не АС_ПолноправныйПользователь() Тогда
		Если ПараметрыОграничений.ФизическоеЛицо Тогда
			АС_ОграничитьВыборСостоянияДляСотрудника(
				ПредопределенноеЗначение("Справочник.СостоянияЗаказНарядов.Завершен"));
		Иначе
			АС_ОграничитьВыборСостоянияДляСотрудника(АС_ПолучитьСостояниеГотовКПроверке());
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_ПоказыватьКнопкиКарточекСотруднику(СостояниеЗаказа)

	Если Пользователи.ЭтоПолноправныйПользователь() Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат АС_ЭтоСостояниеСНаименованием(СостояниеЗаказа, "Готов к проверке")
		Или АС_ЭтоСостояниеСНаименованием(СостояниеЗаказа, "Готов к отправке")
		Или СостояниеЗаказа = Справочники.СостоянияЗаказНарядов.Завершен;

КонецФункции

&НаСервереБезКонтекста
Функция АС_ПолучитьСостояниеГотовКПроверке()

	Возврат Справочники.СостоянияЗаказНарядов.НайтиПоНаименованию("Готов к проверке", Истина);

КонецФункции

&НаКлиенте
Процедура АС_ОграничитьВыборСостоянияДляСотрудника(РазрешенноеСостояние)

	Если Не ЗначениеЗаполнено(РазрешенноеСостояние) Тогда
		Возврат;
	КонецЕсли;

	РазрешенныеСостояния = Новый Массив;
	РазрешенныеСостояния.Добавить(РазрешенноеСостояние);
	ПараметрыВыбораСостояния = Новый Массив;
	ПараметрыВыбораСостояния.Добавить(Новый ПараметрВыбора(
		"Отбор.Ссылка", Новый ФиксированныйМассив(РазрешенныеСостояния)));
	Элементы.СостояниеЗаказа.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораСостояния);

КонецПроцедуры

&НаКлиенте
Процедура АС_ПрименитьОграниченноеРедактированиеГотовКОтправке()

	Для Каждого ЭлементФормы Из Элементы Цикл
		Если ТипЗнч(ЭлементФормы) = Тип("ПолеФормы") Тогда
			ЭлементФормы.ТолькоПросмотр = Истина;
		КонецЕсли;
	КонецЦикла;

	Элементы.ЗННомер.ТолькоПросмотр = Ложь;
	Элементы.ЗНДата.ТолькоПросмотр = Ложь;
	Элементы.ЗНСтарт.ТолькоПросмотр = Ложь;
	Элементы.ЗНФиниш.ТолькоПросмотр = Ложь;
	Элементы.ДатаОплаты.ТолькоПросмотр = Ложь;
	Элементы.СостояниеЗаказа.ТолькоПросмотр = Ложь;

	АС_ОграничитьВыборСостоянияДляСотрудника(
		ПредопределенноеЗначение("Справочник.СостоянияЗаказНарядов.Завершен"));

	// Доступ к созданию на основании определяют штатные команды и права сотрудника.
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	АС_УстановитьДоступностьКомандИзмененияСтрок(Ложь);
	Элементы.ЗаполнитьПоОснованию.Доступность = Ложь;
	Элементы.ЗаполнитьОбновитьКалькуляцию.Доступность = Ложь;
	Элементы.ЗаполнитьПоДокументуПоступления.Доступность = Ложь;
	Элементы.СчитатьДисконтнуюКарту.Доступность = Ложь;
	Элементы.ДобавитьПромокод.Доступность = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура АС_УстановитьДоступностьКомандИзмененияСтрок(ДоступностьКоманд)

	Элементы.РаботыКонтекстноеМенюОтменитьТоварыУслуги.Доступность = ДоступностьКоманд;
	Элементы.МатериалыКонтекстноеМенюЗапасыРазбитьСтроку.Доступность = ДоступностьКоманд;
	Элементы.ЗапасыКонтекстноеМенюЗапасыРазбитьСтроку.Доступность = ДоступностьКоманд;
	Элементы.ЗапасыКонтекстноеМенюОтменитьТоварыУслугиЗапасыРезервы.Доступность = ДоступностьКоманд;
	Элементы.ЗапасыКонтекстноеМенюОтменитьТоварыУслуги.Доступность = ДоступностьКоманд;

КонецПроцедуры

&НаКлиенте
&Вместо("ЗапасыРазбитьСтроку")
Процедура АС_ЗапасыРазбитьСтроку(Команда)

	Если АС_НужноБлокироватьЗаказНарядДляПользователя() Тогда
		АС_СообщитьОЗапретеИзмененияСтрок();
		Возврат;
	КонецЕсли;

	ПродолжитьВызов(Команда);

КонецПроцедуры

&НаКлиенте
&Вместо("ОтменитьТоварыУслуги")
Процедура АС_ОтменитьТоварыУслуги(Команда)

	Если АС_НужноБлокироватьЗаказНарядДляПользователя() Тогда
		АС_СообщитьОЗапретеИзмененияСтрок();
		Возврат;
	КонецЕсли;

	ПродолжитьВызов(Команда);

КонецПроцедуры

&НаКлиенте
Процедура АС_СообщитьОЗапретеИзмененияСтрок()

	ОбщегоНазначенияКлиент.СообщитьПользователю(
		"Заказ-наряд готов к проверке. Изменять товары и работы может только администратор.");

КонецПроцедуры

&НаКлиенте
Процедура АС_ОформитьТекущуюСтрокуКакРазовуюПозицию(Наименование)

	НаименованиеРазовойПозиции = СокрЛП(Наименование);
	Если ПустаяСтрока(НаименованиеРазовойПозиции) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			"Наименование разовой позиции не может быть пустым.");
		Возврат;
	КонецЕсли;

	СтрокаТабличнойЧасти = Элементы.Запасы.ТекущиеДанные;
	Если СтрокаТабличнойЧасти = Неопределено Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			"Не удалось определить строку для временного товара.");
		Возврат;
	КонецЕсли;

	СтрокаТабличнойЧасти.Номенклатура = НаименованиеРазовойПозиции;
	СтрокаТабличнойЧасти.Содержание = НаименованиеРазовойПозиции;
	СтрокаТабличнойЧасти.АС_НеСписывать = Истина;
	СтрокаТабличнойЧасти.АС_НеУчитывать = Ложь;
	СтрокаТабличнойЧасти.ТипНоменклатурыЗапас = Ложь;
	Если СтрокаТабличнойЧасти.Количество = 0 Тогда
		СтрокаТабличнойЧасти.Количество = 1;
	КонецЕсли;

	АС_ЗаполнитьОбязательныеПоляРазовойПозиции(СтрокаТабличнойЧасти);
	РассчитатьСуммуВСтрокеТабличнойЧасти("Запасы", СтрокаТабличнойЧасти);
	АС_ОбновитьДоступностьЦеныЗапаса();
	АС_ПересчитатьДоступность(Ложь);
	АС_ОбновитьИтогиПослеИзмененияСтоимости();
	Модифицированность = Истина;

КонецПроцедуры

&НаКлиенте
Процедура АС_ОткрытьКарточкуНоменклатуры(Команда)

	ТекущиеДанные = Элементы.Запасы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено
		Или Не ЗначениеЗаполнено(ТекущиеДанные.Номенклатура) Тогда
		Возврат;
	КонецЕсли;

	ПоказатьЗначение(Неопределено, ТекущиеДанные.Номенклатура);

КонецПроцедуры

&НаКлиенте
Процедура АС_ОткрытьКарточкуРаботы(Команда)

	ТекущиеДанные = Элементы.Работы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено
		Или Не ЗначениеЗаполнено(ТекущиеДанные.Номенклатура) Тогда
		Возврат;
	КонецЕсли;

	ПоказатьЗначение(Неопределено, ТекущиеДанные.Номенклатура);

КонецПроцедуры

&НаКлиенте
Процедура АС_УстановитьВидЦенЗаказНарядаПослеОткрытия(Отказ)

	ВидЦенПоУмолчанию = АС_ПолучитьВидЦенЗаказНарядаПриОткрытии();
	Если ЗначениеЗаполнено(ВидЦенПоУмолчанию)
		И Объект.ВидЦен <> ВидЦенПоУмолчанию Тогда
		Объект.ВидЦен = ВидЦенПоУмолчанию;
		ЦеныИВалюта = ЦеныИВалютаКлиентСервер.ТекстНадписиЦеныИВалюта(
			Объект,
			ВалютаРасчетов,
			КурсНациональнаяВалюта,
			УчетВалютныхОпераций);
	КонецЕсли;

	АС_СинхронизироватьВидЦенДокумента();
	АС_УстановитьВидЦенСтрокЗапасов(Неопределено, Истина);

	Если АС_АвтозаполнениеИзЗаказаПоставщика Тогда
		ВставитьСтроки("Запасы", "Запасы");
		Модифицированность = Истина;
		АС_АвтозаполнениеИзЗаказаПоставщика = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_ОтменитьТоварыПоВозвратуПокупателяПослеОткрытия(Отказ)

	Если АС_СтрокиОтменыВозвратаПокупателя = Неопределено
		Или АС_СтрокиОтменыВозвратаПокупателя.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	АС_ОтменитьТоварыПоВозвратуПокупателя(АС_СтрокиОтменыВозвратаПокупателя);
	АС_СтрокиОтменыВозвратаПокупателя.Очистить();

КонецПроцедуры

&НаКлиенте
Процедура АС_ИнициализироватьВыборВидаЦен()

	АС_ВидыЦенДляВыбора = АС_ПолучитьРазрешенныеВидыЦен();

КонецПроцедуры

&НаКлиенте
Функция АС_ВидЦенРазрешен(ВидЦен)

	Если АС_ВидыЦенДляВыбора = Неопределено Тогда
		АС_ИнициализироватьВыборВидаЦен();
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ВидЦен) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого РазрешенныйВидЦен Из АС_ВидыЦенДляВыбора Цикл
		Если РазрешенныйВидЦен = ВидЦен Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

&НаКлиенте
Функция АС_ПолучитьВидЦенДляРасчета()

	Если АС_ВидыЦенДляВыбора = Неопределено Тогда
		АС_ИнициализироватьВыборВидаЦен();
	КонецЕсли;

	Если АС_ВидЦенРазрешен(Объект.ВидЦен) Тогда
		Возврат Объект.ВидЦен;
	КонецЕсли;

	Если АС_ВидыЦенДляВыбора.Количество() > 0 Тогда
		Возврат АС_ВидыЦенДляВыбора[0];
	КонецЕсли;

	Возврат ПредопределенноеЗначение("Справочник.ВидыЦен.ПустаяСсылка");

КонецФункции

&НаСервереБезКонтекста
Функция АС_ЦенаВключаетНДСВидаЦен(ВидЦен)

	Если Не ЗначениеЗаполнено(ВидЦен) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|   ВидыЦен.ЦенаВключаетНДС КАК ЦенаВключаетНДС
		|ИЗ
		|   Справочник.ВидыЦен КАК ВидыЦен
		|ГДЕ
		|   ВидыЦен.Ссылка = &ВидЦен");
	Запрос.УстановитьПараметр("ВидЦен", ВидЦен);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Выборка.ЦенаВключаетНДС;

КонецФункции

&НаКлиенте
Функция АС_СинхронизироватьСуммуВключаетНДСПоВидуЦен(ВидЦен)

	ЦенаВключаетНДС = АС_ЦенаВключаетНДСВидаЦен(ВидЦен);
	Если ЦенаВключаетНДС = Неопределено
		Или Объект.СуммаВключаетНДС = ЦенаВключаетНДС Тогда
		Возврат Ложь;
	КонецЕсли;

	Объект.СуммаВключаетНДС = ЦенаВключаетНДС;
	Возврат Истина;

КонецФункции

&НаКлиенте
Процедура АС_СинхронизироватьВидЦенДокумента()

	ВидЦенДляРасчета = АС_ПолучитьВидЦенДляРасчета();
	Если Не ЗначениеЗаполнено(ВидЦенДляРасчета) Тогда
		Возврат;
	КонецЕсли;

	Если Объект.ВидЦен <> ВидЦенДляРасчета Тогда
		Объект.ВидЦен = ВидЦенДляРасчета;
		ЦеныИВалюта = ЦеныИВалютаКлиентСервер.ТекстНадписиЦеныИВалюта(
			Объект,
			ВалютаРасчетов,
			КурсНациональнаяВалюта,
			УчетВалютныхОпераций);
	КонецЕсли;

	Если АС_СинхронизироватьСуммуВключаетНДСПоВидуЦен(ВидЦенДляРасчета) Тогда
		АС_ПересчитатьНДСПослеИзмененияНалогообложения();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_УстановитьВидЦенСтрокиЗапаса(СтрокаТабличнойЧасти)

	Если СтрокаТабличнойЧасти = Неопределено Тогда
		СтрокаТабличнойЧасти = Элементы.Запасы.ТекущиеДанные;
	КонецЕсли;

	Если СтрокаТабличнойЧасти = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ВидЦенДляРасчета = АС_ПолучитьВидЦенДляРасчета();
	СтрокаТабличнойЧасти.АС_ПримененныйВидЦен = ВидЦенДляРасчета;
	СтрокаТабличнойЧасти.АС_ЦенаПоВидуЦенКонтрагента = СтрокаТабличнойЧасти.Цена <> 0
		И АС_ЭтоВидЦенКонтрагента(ВидЦенДляРасчета);

КонецПроцедуры

&НаКлиенте
Процедура АС_УстановитьВидЦенСтрокЗапасов(ВидЦен = Неопределено, ТолькоНезаполненные = Ложь)

	Если ВидЦен = Неопределено Тогда
		ВидЦен = АС_ПолучитьВидЦенДляРасчета();
	КонецЕсли;
	ЦенаПоВидуЦенКонтрагента = АС_ЭтоВидЦенКонтрагента(ВидЦен);

	Для Каждого СтрокаТовара Из Объект.Запасы Цикл
		Если ТолькоНезаполненные И ЗначениеЗаполнено(СтрокаТовара.АС_ПримененныйВидЦен) Тогда
			Продолжить;
		КонецЕсли;
		СтрокаТовара.АС_ПримененныйВидЦен = ВидЦен;
		СтрокаТовара.АС_ЦенаПоВидуЦенКонтрагента = СтрокаТовара.Цена <> 0
			И ЦенаПоВидуЦенКонтрагента;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция АС_ЭтоВидЦенКонтрагента(ВидЦен)

	Если Не ЗначениеЗаполнено(Объект.Контрагент)
		Или Не ЗначениеЗаполнено(ВидЦен) Тогда
		Возврат Ложь;
	КонецЕсли;

	ВидЦенКонтрагента = АС_ЦенообразованиеСервер.ВидЦенКонтрагента(Объект.Контрагент);
	Возврат ЗначениеЗаполнено(ВидЦенКонтрагента)
		И ВидЦен = ВидЦенКонтрагента;

КонецФункции

&НаКлиенте
Процедура АС_НастроитьОграничениеВыбораВидаЦен(ИмяТЧ)

	Если АС_ВидыЦенДляВыбора = Неопределено Тогда
		АС_ИнициализироватьВыборВидаЦен();
	КонецЕсли;

	Если ИмяТЧ = "Запасы" Тогда
		Действие = ЗапасыИзменениеСтрокДействие;
		ЭлементЗначения = Элементы.ЗапасыИзменениеСтрокЗначение;
	ИначеЕсли ИмяТЧ = "Работы" Тогда
		Действие = РаботыИзменениеСтрокДействие;
		ЭлементЗначения = Элементы.РаботыИзменениеСтрокЗначение;
	Иначе
		Возврат;
	КонецЕсли;

	Если Действие <> ПредопределенноеЗначение(
			"Перечисление.ДействияГрупповогоИзмененияСтрок.УстановитьЦеныПоВиду") Тогда
		Возврат;
	КонецЕсли;

	Если АС_ВидыЦенДляВыбора = Неопределено Тогда
		АС_ВидыЦенДляВыбора = АС_ПолучитьРазрешенныеВидыЦен();
	КонецЕсли;

	АС_ПараметрыВыбораВидаЦен = Новый Массив;
	АС_ПараметрыВыбораВидаЦен.Добавить(Новый ПараметрВыбора("Отбор.Ссылка", АС_ВидыЦенДляВыбора));
	ЭлементЗначения.ПараметрыВыбора = Новый ФиксированныйМассив(АС_ПараметрыВыбораВидаЦен);

КонецПроцедуры

&НаСервере
&Вместо("ВставитьСтрокиНаСервере")
Процедура АС_ВставитьСтрокиНаСервере(ИмяТЧ, ИмяЭлемента, КоличествоСкопированных, КоличествоВставленных)

	Если ИмяТЧ = "Работы" Тогда
		АС_ВставитьРаботыИзБуфераНаСервере(ИмяЭлемента, КоличествоСкопированных, КоличествоВставленных);
		ОбработатьВставленныеСтрокиНаСервере(ИмяТЧ, ИмяЭлемента, КоличествоВставленных);
		НоменклатураВДокументахСервер.ЗаполнитьПризнакиИспользованияХарактеристик(Объект);
		ЦенообразованиеСервер.ДобавитьКолонкуИЗаполнитьМинимальныеЦеныВТЧ(ЭтотОбъект, ИмяТЧ);
		Возврат;
	КонецЕсли;

	ВставкаИзЗаказаПоставщика = ИмяТЧ = "Запасы"
		И АС_БуферСодержитСтрокиЗаказаПоставщикаНаСервере();
	Если ВставкаИзЗаказаПоставщика Тогда
		ИсходныйРежимОбъединенияСтрок = ОбъединятьСтрокиПриДобавлении;
		ОбъединятьСтрокиПриДобавлении = Ложь;
	КонецЕсли;

	Попытка
		ПродолжитьВызов(ИмяТЧ, ИмяЭлемента, КоличествоСкопированных, КоличествоВставленных);
	Исключение
		Если ВставкаИзЗаказаПоставщика Тогда
			ОбъединятьСтрокиПриДобавлении = ИсходныйРежимОбъединенияСтрок;
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

	Если ВставкаИзЗаказаПоставщика Тогда
		ОбъединятьСтрокиПриДобавлении = ИсходныйРежимОбъединенияСтрок;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура АС_ВставитьРаботыИзБуфераНаСервере(ИмяЭлемента, КоличествоСкопированных, КоличествоВставленных)

	КоличествоСкопированных = 0;
	КоличествоВставленных = 0;
	СтрокиБуфера = ХранилищеОбщихНастроек.Загрузить("БуферОбменаТабличныеЧасти", "Строки");
	Если СтрокиБуфера = Неопределено Тогда
		Возврат;
	КонецЕсли;
	КоличествоСкопированных = СтрокиБуфера.Количество();
	Если СтрокиБуфера.Колонки.Найти("Номенклатура") = Неопределено Тогда
		Возврат;
	КонецЕсли;

	НоменклатураБуфера = Новый Массив;
	Для Каждого СтрокаБуфера Из СтрокиБуфера Цикл
		Если ТипЗнч(СтрокаБуфера.Номенклатура) = Тип("СправочникСсылка.Номенклатура")
			И ЗначениеЗаполнено(СтрокаБуфера.Номенклатура) Тогда
			НоменклатураБуфера.Добавить(СтрокаБуфера.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	Если НоменклатураБуфера.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ТипыРабот = Новый Массив;
	ТипыРабот.Добавить(Перечисления.ТипыНоменклатуры.Услуга);
	ТипыРабот.Добавить(Перечисления.ТипыНоменклатуры.Работа);
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|Номенклатура.Ссылка КАК Ссылка
		|ИЗ Справочник.Номенклатура КАК Номенклатура
		|ГДЕ Номенклатура.Ссылка В (&Номенклатура)
		|    И Номенклатура.ТипНоменклатуры В (&ТипыРабот)");
	Запрос.УстановитьПараметр("Номенклатура", НоменклатураБуфера);
	Запрос.УстановитьПараметр("ТипыРабот", ТипыРабот);
	ДопустимаяНоменклатура = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДопустимаяНоменклатура.Вставить(Выборка.Ссылка, Истина);
	КонецЦикла;

	// Штатная вставка исключает всю строку по отбору вспомогательного «Вида работ».
	// Для уже заполненных работ проверяем саму услугу или работу, а остальные
	// реквизиты переносим по совместимым типам без изменения общего буфера.
	МетаданныеРабот = Объект.Ссылка.Метаданные().ТабличныеЧасти.Работы;
	НекопируемыеКолонки = СтрРазделить(
		"СерииНоменклатуры,СерииНоменклатурыОприходование,КлючСвязи,КлючСвязиСерииНоменклатуры", ",");
	ВыделенныеСтроки = Элементы[ИмяЭлемента].ВыделенныеСтроки;
	ВыделенныеСтроки.Очистить();
	ПоследняяСтрока = Неопределено;
	Для Каждого СтрокаБуфера Из СтрокиБуфера Цикл
		Если ДопустимаяНоменклатура.Получить(СтрокаБуфера.Номенклатура) <> Истина Тогда
			Продолжить;
		КонецЕсли;
		КопируемыеКолонки = Новый Массив;
		Для Каждого РеквизитРаботы Из МетаданныеРабот.Реквизиты Цикл
			Если СтрокиБуфера.Колонки.Найти(РеквизитРаботы.Имя) <> Неопределено
				И НекопируемыеКолонки.Найти(РеквизитРаботы.Имя) = Неопределено
				И РеквизитРаботы.Тип.СодержитТип(ТипЗнч(СтрокаБуфера[РеквизитРаботы.Имя])) Тогда
				КопируемыеКолонки.Добавить(РеквизитРаботы.Имя);
			КонецЕсли;
		КонецЦикла;
		ПоследняяСтрока = Объект.Работы.Добавить();
		ЗаполнитьЗначенияСвойств(ПоследняяСтрока, СтрокаБуфера, СтрСоединить(КопируемыеКолонки, ","));
		ВыделенныеСтроки.Добавить(ПоследняяСтрока.ПолучитьИдентификатор());
		КоличествоВставленных = КоличествоВставленных + 1;
	КонецЦикла;
	Если ПоследняяСтрока <> Неопределено Тогда
		Элементы[ИмяЭлемента].ТекущаяСтрока = ПоследняяСтрока.ПолучитьИдентификатор();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&Вместо("ВставитьСтроки")
Процедура АС_ВставитьСтроки(ИмяТЧ, ИмяЭлемента)

	Если ИмяТЧ = "Запасы" Тогда
		Если Не ЗначениеЗаполнено(АС_РежимЦенПриВставке)
			И АС_НуженВыборЦенПриВставкеНаСервере() Тогда
			Кнопки = Новый СписокЗначений;
			Кнопки.Добавить("Актуальные", "Пересчитать по актуальным ценам");
			Кнопки.Добавить("Исходные", "Сохранить исходные цены");
			Кнопки.Добавить(КодВозвратаДиалога.Отмена);
			Контекст = Новый Структура("ИмяТЧ,ИмяЭлемента", ИмяТЧ, ИмяЭлемента);
			ПоказатьВопрос(
				Новый ОписаниеОповещения("АС_ВыборЦенПриВставкеЗавершение", ЭтотОбъект, Контекст),
				"Как перенести товары?" + Символы.ПС
					+ "Актуальные цены: прайс на текущую дату, скидки по скопированным процентам."
					+ Символы.ПС + "Исходные цены: цены и точные суммы скидок из скопированных строк."
					+ Символы.ПС + "Синие цены из заказов поставщика сохраняются без пересчёта в обоих случаях.",
				Кнопки, 0, "Актуальные");
			Возврат;
		КонецЕсли;

		// До ответа или при отмене документ не меняем.
		АС_СинхронизироватьВидЦенПередДобавлениемТовара();
		АС_СинхронизироватьСуществующиеСтрокиИзЗаказаПоставщика();
	КонецЕсли;
	ПродолжитьВызов(ИмяТЧ, ИмяЭлемента);

КонецПроцедуры

&НаКлиенте
Процедура АС_ВыборЦенПриВставкеЗавершение(Результат, Контекст) Экспорт

	Если Результат <> "Актуальные" И Результат <> "Исходные" Тогда
		Возврат;
	КонецЕсли;
	АС_РежимЦенПриВставке = Результат;
	Попытка
		ВставитьСтроки(Контекст.ИмяТЧ, Контекст.ИмяЭлемента);
	Исключение
		АС_РежимЦенПриВставке = Неопределено;
		ВызватьИсключение;
	КонецПопытки;
	АС_РежимЦенПриВставке = Неопределено;

КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_НуженВыборЦенПриВставкеНаСервере()

	СтрокиБуфера = ХранилищеОбщихНастроек.Загрузить("БуферОбменаТабличныеЧасти", "Строки");
	Если СтрокиБуфера = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СтрокиБуфера.Количество() = 0
		Или СтрокиБуфера.Колонки.Найти("Номенклатура") = Неопределено
		Или СтрокиБуфера.Колонки.Найти("Цена") = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	// Поставщицкий буфер обрабатывается отдельным сценарием переноса для предоплаты.
	Если СтрокиБуфера.Колонки.Найти("АС_ИсточникЗаказПоставщика") <> Неопределено Тогда
		Для Каждого СтрокаБуфера Из СтрокиБуфера Цикл
			Если СтрокаБуфера.АС_ИсточникЗаказПоставщика Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Истина;

КонецФункции

&НаКлиенте
&После("ОбработатьВставленныеСтроки")
Процедура АС_ОбработатьВставленныеСтрокиПосле(ИмяТЧ, ИмяЭлемента, КоличествоВставленных)

	Если КоличествоВставленных = 0 Тогда
		Возврат;
	КонецЕсли;

	Если ИмяТЧ = "Работы" Тогда
		АС_ЗаполнитьПродавцаВДобавленныхРаботах(КоличествоВставленных);
		АС_ОбновитьСуммуРабот();
		Возврат;
	ИначеЕсли ИмяТЧ <> "Запасы" Тогда
		Возврат;
	КонецЕсли;

	АС_ЗаполнитьПродавцаВДобавленныхСтроках(КоличествоВставленных);

	ВставкаИзЗаказаПоставщика = АС_БуферСодержитСтрокиЗаказаПоставщикаНаСервере();
	СтрокиБезАктуальнойЦены = "";
	КоличествоСтрок = Объект.Запасы.Количество();
	Для Итератор = 1 По КоличествоВставленных Цикл
		СтрокаТовара = Объект.Запасы[КоличествоСтрок - Итератор];
		Если Не ВставкаИзЗаказаПоставщика И СтрокаТовара.АС_ЦенаИзЗаказаПоставщика Тогда
			// Уже рассчитанную поставщицкую цену продажи переносим вместе с синим оформлением.
			СтрокаТовара.АС_ЦенаПоВидуЦенКонтрагента = Ложь;
		ИначеЕсли АС_РежимЦенПриВставке = "Исходные" Тогда
			СтрокаТовара.АС_ЦенаИзЗаказаПоставщика = Ложь;
			СтрокаТовара.АС_ЦенаПоВидуЦенКонтрагента = Ложь;
		ИначеЕсли АС_РежимЦенПриВставке = "Актуальные" Тогда
			АС_ЗаполнитьЦенуТовараПоВидуЦен(СтрокаТовара, Истина, Неопределено,
				ОбщегоНазначенияКлиент.ДатаСеанса());
			СтрокаТовара.АС_ЦенаИзЗаказаПоставщика = Ложь;
			Если СтрокаТовара.ТипНоменклатурыЗапас И СтрокаТовара.Цена = 0
				И Не СтрокаТовара.ЭтоРазделитель И Не СтрокаТовара.АС_НеУчитывать
				И СтрокаТовара.Отменен = 0 И СтрокаТовара.Количество <> 0 Тогда
				СтрокиБезАктуальнойЦены = СтрокиБезАктуальнойЦены + Символы.ПС
					+ СтрШаблон("Строка %1: %2", КоличествоСтрок - Итератор + 1,
						СтрокаТовара.Номенклатура);
			КонецЕсли;
		ИначеЕсли ВставкаИзЗаказаПоставщика Или Не СтрокаТовара.АС_ЦенаИзЗаказаПоставщика Тогда
			АС_ЗаполнитьЦенуТовараПоВидуЦен(СтрокаТовара, Истина);
			СтрокаТовара.АС_ЦенаИзЗаказаПоставщика = Ложь;
		КонецЕсли;
		Если Не ВставкаИзЗаказаПоставщика Тогда
			СтрокаТовара.АС_ЗаказПоставщику = ПредопределенноеЗначение(
				"Документ.ЗаказПоставщику.ПустаяСсылка");
			СтрокаТовара.АС_КлючСвязиЗаказаПоставщику = 0;
			СтрокаТовара.АС_ИдентификаторГруппыПоставок = "";
		КонецЕсли;
	КонецЦикла;

	АС_ОбновитьДоступностьЦеныЗапаса();
	АС_ПересчитатьДоступность(Ложь);
	АС_ОбновитьИтогиПослеИзмененияСтоимости();

	Если Не ПустаяСтрока(СтрокиБезАктуальнойЦены) Тогда
		Сообщить("Для следующих товаров актуальная цена не найдена. Цена в них установлена в 0."
			+ Символы.ПС + "Укажите цену перед записью заказа:" + СтрокиБезАктуальнойЦены);
	КонецЕсли;

	Если ВставкаИзЗаказаПоставщика Тогда
		Если АС_АвтозаполнениеИзЗаказаПоставщика Тогда
			ПараметрыОповещения = Новый Структура(
				"КоличествоВставленных,ЦеныПоставщика",
				КоличествоВставленных,
				АС_ПолучитьЦеныИзБуфераЗаказаПоставщикаНаСервере());
			АС_ПереносДляПредоплатыЗавершение(КодВозвратаДиалога.Да, ПараметрыОповещения);
		Иначе
			АС_ЗапроситьПереносДляПредоплаты(КоличествоВставленных);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_ЗапроситьПереносДляПредоплаты(КоличествоВставленных)

	ПараметрыОповещения = Новый Структура("КоличествоВставленных", КоличествоВставленных);
	Оповещение = Новый ОписаниеОповещения(
		"АС_ПереносДляПредоплатыЗавершение", ЭтотОбъект, ПараметрыОповещения);
	ПоказатьВопрос(
		Оповещение,
		"Вы добавляете товары для предоплаты?" + Символы.ПС
			+ "Да, добавить для предоплаты." + Символы.ПС
			+ "Нет, добавить простым копированием.",
		РежимДиалогаВопрос.ДаНет,
		0,
		КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура АС_ПереносДляПредоплатыЗавершение(Результат, ПараметрыОповещения) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	КоличествоСтрок = Объект.Запасы.Количество();
	Для Итератор = 1 По ПараметрыОповещения.КоличествоВставленных Цикл
		ИндексЦены = ПараметрыОповещения.КоличествоВставленных - Итератор;
		ЦенаПоставщика = Неопределено;
		Если ПараметрыОповещения.Свойство("ЦеныПоставщика")
			И ПараметрыОповещения.ЦеныПоставщика.Количество() > ИндексЦены Тогда
			ЦенаПоставщика = ПараметрыОповещения.ЦеныПоставщика[ИндексЦены];
		КонецЕсли;
		АС_РассчитатьЦенуОтЗаказаПоставщика(
			Объект.Запасы[КоличествоСтрок - Итератор], ЦенаПоставщика);
	КонецЦикла;
	АС_ЗарегистрироватьИОбъединитьДобавленныеСтрокиПоставщика(
		ПараметрыОповещения.КоличествоВставленных);

	АС_ОбновитьДоступностьЦеныЗапаса();
	АС_ПересчитатьДоступность(Ложь);
	АС_ОбновитьИтогиПослеИзмененияСтоимости();

КонецПроцедуры

&НаКлиенте
Процедура АС_ЗарегистрироватьИОбъединитьДобавленныеСтрокиПоставщика(КоличествоВставленных)

	ИндексСтроки = Объект.Запасы.Количество() - КоличествоВставленных;
	Для НомерСтроки = 1 По КоличествоВставленных Цикл
		Если ИндексСтроки >= Объект.Запасы.Количество() Тогда
			Прервать;
		КонецЕсли;

		ДобавленнаяСтрока = Объект.Запасы[ИндексСтроки];
		Если Не ЗначениеЗаполнено(ДобавленнаяСтрока.АС_ЗаказПоставщику) Тогда
			ИндексСтроки = ИндексСтроки + 1;
			Продолжить;
		КонецЕсли;
		ЗаказПоставщику = ДобавленнаяСтрока.АС_ЗаказПоставщику;
		КлючСвязи = ДобавленнаяСтрока.АС_КлючСвязиЗаказаПоставщику;
		КоличествоПоставщика = ДобавленнаяСтрока.Количество;
		ЦенаПоставщика = ДобавленнаяСтрока.АС_ИсходнаяЦенаЗаказаПоставщика;

		СтрокаДляОбъединения = Неопределено;
		Для ИндексПоиска = 0 По ИндексСтроки - 1 Цикл
			СтрокаПоиска = Объект.Запасы[ИндексПоиска];
			Если СтрокаПоиска.Номенклатура = ДобавленнаяСтрока.Номенклатура
				И СтрокаПоиска.Цена = ДобавленнаяСтрока.Цена Тогда
				СтрокаДляОбъединения = СтрокаПоиска;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если СтрокаДляОбъединения = Неопределено Тогда
			Если Не ЗначениеЗаполнено(ДобавленнаяСтрока.АС_ИдентификаторГруппыПоставок) Тогда
				ДобавленнаяСтрока.АС_ИдентификаторГруппыПоставок = Строка(Новый УникальныйИдентификатор);
			КонецЕсли;
			ИдентификаторГруппы = ДобавленнаяСтрока.АС_ИдентификаторГруппыПоставок;
			ИндексСтроки = ИндексСтроки + 1;
		Иначе
			Если Не ЗначениеЗаполнено(СтрокаДляОбъединения.АС_ИдентификаторГруппыПоставок) Тогда
				СтрокаДляОбъединения.АС_ИдентификаторГруппыПоставок = Строка(Новый УникальныйИдентификатор);
			КонецЕсли;
			ИдентификаторГруппы = СтрокаДляОбъединения.АС_ИдентификаторГруппыПоставок;
			СтрокаДляОбъединения.Количество = СтрокаДляОбъединения.Количество + КоличествоПоставщика;
			РассчитатьСуммуВСтрокеТабличнойЧасти("Запасы", СтрокаДляОбъединения);
			Объект.Запасы.Удалить(ДобавленнаяСтрока);
		КонецЕсли;

		НоваяСвязь = Объект.АС_ИсточникиПоставок.Добавить();
		НоваяСвязь.ИдентификаторСтрокиПокупателя = ИдентификаторГруппы;
		НоваяСвязь.ЗаказПоставщику = ЗаказПоставщику;
		НоваяСвязь.КлючСвязиЗаказаПоставщику = КлючСвязи;
		НоваяСвязь.Количество = КоличествоПоставщика;
		НоваяСвязь.ЦенаПоставщика = ЦенаПоставщика;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура АС_УстановитьОформлениеЦеныЗаказаПоставщика()

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
		ЭлементОформления.Отбор,
		"Объект.Запасы.АС_ЦенаИзЗаказаПоставщика",
		Истина);
	РаботаСФормой.ДобавитьОформляемоеПоле(ЭлементОформления, Элементы.ЗапасыЦена.Имя);
	РаботаСФормой.ДобавитьЭлементУсловногоОформления(
		ЭлементОформления,
		"ЦветФона",
		Новый Цвет(204, 238, 255));

КонецПроцедуры

&НаСервере
Процедура АС_УстановитьОформлениеЦеныПоВидуЦенКонтрагента()

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
		ЭлементОформления.Отбор,
		"Объект.Запасы.АС_ЦенаПоВидуЦенКонтрагента",
		Истина);
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
		ЭлементОформления.Отбор,
		"Объект.Запасы.АС_ЦенаИзЗаказаПоставщика",
		Ложь);
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
		ЭлементОформления.Отбор,
		"Объект.Запасы.Цена",
		0,
		ВидСравненияКомпоновкиДанных.НеРавно);
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
		ЭлементОформления.Отбор,
		"Объект.Запасы.ТипНоменклатурыЗапас",
		Истина);
	РаботаСФормой.ДобавитьОформляемоеПоле(ЭлементОформления, Элементы.ЗапасыЦена.Имя);
	РаботаСФормой.ДобавитьЭлементУсловногоОформления(
		ЭлементОформления,
		"ЦветФона",
		Новый Цвет(255, 204, 153));

КонецПроцедуры

&НаКлиенте
Процедура АС_РассчитатьЦенуОтЗаказаПоставщика(СтрокаТабличнойЧасти, ЦенаПоставщика = Неопределено)

	Если СтрокаТабличнойЧасти = Неопределено
		Или ТипЗнч(СтрокаТабличнойЧасти.Номенклатура) <> Тип("СправочникСсылка.Номенклатура")
		Или Не СтрокаТабличнойЧасти.ТипНоменклатурыЗапас Тогда
		Возврат;
	КонецЕсли;

	ВидЦенДляРасчета = АС_ПолучитьВидЦенДляРасчета();
	Если Не ЗначениеЗаполнено(ВидЦенДляРасчета) Тогда
		Возврат;
	КонецЕсли;

	Если ЦенаПоставщика = Неопределено Тогда
		ЦенаПоставщика = АС_ПолучитьЦенуИзБуфераЗаказаПоставщикаНаСервере(
			СтрокаТабличнойЧасти.Номенклатура,
			СтрокаТабличнойЧасти.Характеристика);
	КонецЕсли;
	СтрокаТабличнойЧасти.Цена = АС_РассчитатьЦенуПоЦенеПоставщикаНаСервере(
		ЦенаПоставщика,
		СтрокаТабличнойЧасти.Номенклатура,
		ВидЦенДляРасчета);
	СтрокаТабличнойЧасти.АС_ПримененныйВидЦен = ВидЦенДляРасчета;
	СтрокаТабличнойЧасти.АС_ЦенаИзЗаказаПоставщика = Истина;
	СтрокаТабличнойЧасти.АС_ЦенаПоВидуЦенКонтрагента = Ложь;
	СтрокаТабличнойЧасти.АС_ИсходнаяЦенаЗаказаПоставщика = ЦенаПоставщика;
	РассчитатьСуммуВСтрокеТабличнойЧасти("Запасы", СтрокаТабличнойЧасти);

КонецПроцедуры

&НаКлиенте
Процедура АС_СинхронизироватьСуществующиеСтрокиИзЗаказаПоставщика()

	Если Не АС_АвтозаполнениеИзЗаказаПоставщика Тогда
		Возврат;
	КонецЕсли;

	ИзмененныеСтроки = АС_СинхронизироватьСуществующиеСтрокиИзЗаказаПоставщикаНаСервере();
	Для Каждого ДанныеСтроки Из ИзмененныеСтроки Цикл
		Если ДанныеСтроки.Действие = "Отмена" И ДанныеСтроки.Количество > 0 Тогда
			АС_ОтменитьКоличествоИзЗаказаПоставщика(ДанныеСтроки);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ДанныеСтроки Из ИзмененныеСтроки Цикл
		Если ДанныеСтроки.Действие = "УдалитьВклад" И ДанныеСтроки.Количество > 0 Тогда
			АС_УдалитьВкладЗаказаПоставщика(ДанныеСтроки);
		КонецЕсли;
	КонецЦикла;

	АС_ОбновитьИтогиПослеИзмененияСтоимости();

КонецПроцедуры

&НаКлиенте
Процедура АС_УдалитьВкладЗаказаПоставщика(ДанныеСтроки)

	Для Каждого СтрокаТовара Из Объект.Запасы Цикл
		Если СтрокаТовара.АС_ИдентификаторГруппыПоставок <>
			ДанныеСтроки.ИдентификаторГруппы Тогда
			Продолжить;
		КонецЕсли;

		Если ДанныеСтроки.Количество >= СтрокаТовара.Количество Тогда
			Объект.Запасы.Удалить(СтрокаТовара);
		Иначе
			СтрокаТовара.Количество = СтрокаТовара.Количество - ДанныеСтроки.Количество;
			РассчитатьСуммуВСтрокеТабличнойЧасти("Запасы", СтрокаТовара);
		КонецЕсли;
		Возврат;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура АС_ОтменитьКоличествоИзЗаказаПоставщика(ДанныеСтроки)

	ОсталосьОтменить = ДанныеСтроки.Количество;
	Для Каждого СтрокаТовара Из Объект.Запасы Цикл
		Если СтрокаТовара.АС_ИдентификаторГруппыПоставок <>
			ДанныеСтроки.ИдентификаторГруппы Тогда
			Продолжить;
		КонецЕсли;

		КоличествоКОтмене = Мин(ОсталосьОтменить, СтрокаТовара.Количество);
		Если КоличествоКОтмене = СтрокаТовара.Количество Тогда
			СтрокаТовара.АС_ЗаказПоставщику = ДанныеСтроки.ЗаказПоставщику;
			СтрокаТовара.АС_КлючСвязиЗаказаПоставщику = ДанныеСтроки.КлючСвязиЗаказаПоставщику;
			СтрокаТовара.АС_ИсходнаяЦенаЗаказаПоставщика = ДанныеСтроки.ЦенаПоставщика;
			СтрокиОбработки = Новый Массив;
			СтрокиОбработки.Добавить(СтрокаТовара.ПолучитьИдентификатор());
			ОбработатьОтменуТоваров(СтрокиОбработки, "Запасы");
		Иначе
			ИдентификаторыСуществующихСтрок = Новый Соответствие;
			Для Каждого СуществующаяСтрока Из Объект.Запасы Цикл
				ИдентификаторыСуществующихСтрок.Вставить(СуществующаяСтрока.ПолучитьИдентификатор(), Истина);
			КонецЦикла;

			ПараметрыРазделения = Новый Структура(
				"СтрокаТабличнойЧасти,ИмяТЧ", СтрокаТовара, "Запасы");
			РазбитьСтрокуТабличнойЧастиЗавершение(КоличествоКОтмене, ПараметрыРазделения);

			НоваяСтрока = Неопределено;
			Для Каждого СтрокаПослеРазделения Из Объект.Запасы Цикл
				Если ИдентификаторыСуществующихСтрок.Получить(
						СтрокаПослеРазделения.ПолучитьИдентификатор()) = Неопределено Тогда
					НоваяСтрока = СтрокаПослеРазделения;
					Прервать;
				КонецЕсли;
			КонецЦикла;

			Если НоваяСтрока = Неопределено Тогда
				Сообщить("Не удалось создать строку для отмены товара из заказа поставщика.");
				Возврат;
			КонецЕсли;
			НоваяСтрока.АС_ЗаказПоставщику = ДанныеСтроки.ЗаказПоставщику;
			НоваяСтрока.АС_КлючСвязиЗаказаПоставщику = ДанныеСтроки.КлючСвязиЗаказаПоставщику;
			НоваяСтрока.АС_ИсходнаяЦенаЗаказаПоставщика = ДанныеСтроки.ЦенаПоставщика;

			СтрокиОбработки = Новый Массив;
			СтрокиОбработки.Добавить(НоваяСтрока.ПолучитьИдентификатор());
			ОбработатьОтменуТоваров(СтрокиОбработки, "Запасы");
		КонецЕсли;

		ОсталосьОтменить = ОсталосьОтменить - КоличествоКОтмене;
		Если ОсталосьОтменить = 0 Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;

	Сообщить("Не удалось полностью перенести отмену товара из заказа поставщика.");

КонецПроцедуры

&НаСервере
Процедура АС_МигрироватьСвязиСтрокЗаказаПоставщикаНаСервере()

	ИндексСвязи = Объект.АС_ИсточникиПоставок.Количество() - 1;
	Пока ИндексСвязи >= 0 Цикл
		СвязьПоставки = Объект.АС_ИсточникиПоставок[ИндексСвязи];
		СтрокаПоСвязиСуществует = Ложь;
		Для Каждого СтрокаПокупателя Из Объект.Запасы Цикл
			Если СтрокаПокупателя.АС_ИдентификаторГруппыПоставок =
				СвязьПоставки.ИдентификаторСтрокиПокупателя Тогда
				СтрокаПоСвязиСуществует = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не СтрокаПоСвязиСуществует Тогда
			Объект.АС_ИсточникиПоставок.Удалить(СвязьПоставки);
		КонецЕсли;
		ИндексСвязи = ИндексСвязи - 1;
	КонецЦикла;
	Если Объект.АС_ИсточникиПоставок.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаПокупателя Из Объект.Запасы Цикл
		Если Не ЗначениеЗаполнено(СтрокаПокупателя.АС_ЗаказПоставщику) Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаПокупателя.АС_ИдентификаторГруппыПоставок) Тогда
			СтрокаПокупателя.АС_ИдентификаторГруппыПоставок = Строка(Новый УникальныйИдентификатор);
		КонецЕсли;

		СвязьУжеЕсть = Ложь;
		Для Каждого СвязьПоставки Из Объект.АС_ИсточникиПоставок Цикл
			Если СвязьПоставки.ЗаказПоставщику = СтрокаПокупателя.АС_ЗаказПоставщику
				И СвязьПоставки.КлючСвязиЗаказаПоставщику =
					СтрокаПокупателя.АС_КлючСвязиЗаказаПоставщику Тогда
				СвязьУжеЕсть = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если СвязьУжеЕсть Тогда
			Продолжить;
		КонецЕсли;

		НоваяСвязь = Объект.АС_ИсточникиПоставок.Добавить();
		НоваяСвязь.ИдентификаторСтрокиПокупателя = СтрокаПокупателя.АС_ИдентификаторГруппыПоставок;
		НоваяСвязь.ЗаказПоставщику = СтрокаПокупателя.АС_ЗаказПоставщику;
		НоваяСвязь.КлючСвязиЗаказаПоставщику = СтрокаПокупателя.АС_КлючСвязиЗаказаПоставщику;
		НоваяСвязь.Количество = СтрокаПокупателя.Количество;
		НоваяСвязь.ЦенаПоставщика = СтрокаПокупателя.АС_ИсходнаяЦенаЗаказаПоставщика;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция АС_СинхронизироватьСуществующиеСтрокиИзЗаказаПоставщикаНаСервере()

	Результат = Новый Массив;
	СкопированныеСтроки = ХранилищеОбщихНастроек.Загрузить(
		"БуферОбменаТабличныеЧасти", "Строки");
	Если СкопированныеСтроки = Неопределено
		Или СкопированныеСтроки.Колонки.Найти("АС_ИсточникЗаказПоставщика") = Неопределено
		Или СкопированныеСтроки.Колонки.Найти("АС_ЗаказПоставщику") = Неопределено
		Или СкопированныеСтроки.Колонки.Найти("АС_КлючСвязиЗаказаПоставщику") = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	АС_МигрироватьСвязиСтрокЗаказаПоставщикаНаСервере();
	ЕстьКолонкаОтмены = СкопированныеСтроки.Колонки.Найти("АС_ОтменитьВЗаказеПокупателя") <> Неопределено;
	ЕстьКолонкаУдаления = СкопированныеСтроки.Колонки.Найти("АС_УдалитьИзЗаказаПокупателя") <> Неопределено;

	СтрокиОтмены = Новый Массив;
	Для Каждого СтрокаПоставщика Из СкопированныеСтроки Цикл
		Если Не СтрокаПоставщика.АС_ИсточникЗаказПоставщика
			Или Не ЕстьКолонкаОтмены
			Или Не СтрокаПоставщика.АС_ОтменитьВЗаказеПокупателя Тогда
			Продолжить;
		КонецЕсли;

		ДанныеОтмены = Неопределено;
		Для Каждого ДанныеОтменыПоиска Из СтрокиОтмены Цикл
			Если ДанныеОтменыПоиска.ЗаказПоставщику = СтрокаПоставщика.АС_ЗаказПоставщику
				И ДанныеОтменыПоиска.КлючСвязиЗаказаПоставщику = СтрокаПоставщика.АС_КлючСвязиЗаказаПоставщику
				И ДанныеОтменыПоиска.ЦенаПоставщика = СтрокаПоставщика.АС_ЦенаЗаказаПоставщика Тогда
				ДанныеОтмены = ДанныеОтменыПоиска;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ДанныеОтмены = Неопределено Тогда
			ДанныеОтмены = Новый Структура(
				"Номенклатура,Характеристика,ЗаказПоставщику,КлючСвязиЗаказаПоставщику,ЦенаПоставщика,Количество",
				СтрокаПоставщика.Номенклатура,
				СтрокаПоставщика.Характеристика,
				СтрокаПоставщика.АС_ЗаказПоставщику,
				СтрокаПоставщика.АС_КлючСвязиЗаказаПоставщику,
				СтрокаПоставщика.АС_ЦенаЗаказаПоставщика,
				0);
			СтрокиОтмены.Добавить(ДанныеОтмены);
		КонецЕсли;
		ДанныеОтмены.Количество = ДанныеОтмены.Количество + СтрокаПоставщика.Количество;
	КонецЦикла;

	Для Каждого ДанныеОтмены Из СтрокиОтмены Цикл
		КоличествоУжеОтменено = 0;
		Для Каждого СтрокаОтменыПокупателя Из Объект.ОтмененныеЗапасы Цикл
			Если СтрокаОтменыПокупателя.Номенклатура = ДанныеОтмены.Номенклатура
				И СтрокаОтменыПокупателя.Характеристика = ДанныеОтмены.Характеристика
				И СтрокаОтменыПокупателя.АС_ЗаказПоставщику = ДанныеОтмены.ЗаказПоставщику
				И СтрокаОтменыПокупателя.АС_КлючСвязиЗаказаПоставщику = ДанныеОтмены.КлючСвязиЗаказаПоставщику
				И СтрокаОтменыПокупателя.АС_ЦенаИзЗаказаПоставщика
				И СтрокаОтменыПокупателя.АС_ИсходнаяЦенаЗаказаПоставщика = ДанныеОтмены.ЦенаПоставщика Тогда
				КоличествоУжеОтменено = КоличествоУжеОтменено + СтрокаОтменыПокупателя.Количество;
			КонецЕсли;
		КонецЦикла;
		ОсталосьОтменить = Макс(0, ДанныеОтмены.Количество - КоличествоУжеОтменено);

		ИндексСвязи = Объект.АС_ИсточникиПоставок.Количество() - 1;
		Пока ИндексСвязи >= 0 И ОсталосьОтменить > 0 Цикл
			СвязьПоставки = Объект.АС_ИсточникиПоставок[ИндексСвязи];
			Если СвязьПоставки.ЗаказПоставщику = ДанныеОтмены.ЗаказПоставщику
				И СвязьПоставки.КлючСвязиЗаказаПоставщику = ДанныеОтмены.КлючСвязиЗаказаПоставщику
				И СвязьПоставки.ЦенаПоставщика = ДанныеОтмены.ЦенаПоставщика Тогда
				КоличествоКОтмене = Мин(ОсталосьОтменить, СвязьПоставки.Количество);
				Результат.Добавить(Новый Структура(
					"Действие,ИдентификаторГруппы,Номенклатура,Характеристика,ЗаказПоставщику,КлючСвязиЗаказаПоставщику,ЦенаПоставщика,Количество",
					"Отмена",
					СвязьПоставки.ИдентификаторСтрокиПокупателя,
					ДанныеОтмены.Номенклатура,
					ДанныеОтмены.Характеристика,
					ДанныеОтмены.ЗаказПоставщику,
					ДанныеОтмены.КлючСвязиЗаказаПоставщику,
					ДанныеОтмены.ЦенаПоставщика,
					КоличествоКОтмене));
				ОсталосьОтменить = ОсталосьОтменить - КоличествоКОтмене;
				Если КоличествоКОтмене = СвязьПоставки.Количество Тогда
					Объект.АС_ИсточникиПоставок.Удалить(СвязьПоставки);
				Иначе
					СвязьПоставки.Количество = СвязьПоставки.Количество - КоличествоКОтмене;
				КонецЕсли;
			КонецЕсли;
			ИндексСвязи = ИндексСвязи - 1;
		КонецЦикла;
	КонецЦикла;

	ИндексСтроки = СкопированныеСтроки.Количество() - 1;
	Пока ИндексСтроки >= 0 Цикл
		СтрокаПоставщика = СкопированныеСтроки[ИндексСтроки];
		Если СтрокаПоставщика.АС_ИсточникЗаказПоставщика Тогда
			Если ЕстьКолонкаУдаления И СтрокаПоставщика.АС_УдалитьИзЗаказаПокупателя Тогда
				СвязьУдалена = Ложь;
				ИндексСвязи = Объект.АС_ИсточникиПоставок.Количество() - 1;
				Пока ИндексСвязи >= 0 Цикл
					СвязьПоставки = Объект.АС_ИсточникиПоставок[ИндексСвязи];
					Если СвязьПоставки.ЗаказПоставщику = СтрокаПоставщика.АС_ЗаказПоставщику
						И СвязьПоставки.КлючСвязиЗаказаПоставщику =
							СтрокаПоставщика.АС_КлючСвязиЗаказаПоставщику Тогда
						Результат.Добавить(Новый Структура(
							"Действие,ИдентификаторГруппы,Количество",
							"УдалитьВклад",
							СвязьПоставки.ИдентификаторСтрокиПокупателя,
							СвязьПоставки.Количество));
						Объект.АС_ИсточникиПоставок.Удалить(СвязьПоставки);
						СвязьУдалена = Истина;
					КонецЕсли;
					ИндексСвязи = ИндексСвязи - 1;
				КонецЦикла;
				Если Не СвязьУдалена Тогда
					Для Каждого СтрокаПокупателя Из Объект.Запасы Цикл
						Если СтрокаПокупателя.АС_ЗаказПоставщику = СтрокаПоставщика.АС_ЗаказПоставщику
							И СтрокаПокупателя.АС_КлючСвязиЗаказаПоставщику =
								СтрокаПоставщика.АС_КлючСвязиЗаказаПоставщику Тогда
							Результат.Добавить(Новый Структура(
								"Действие,ИдентификаторГруппы,Количество",
								"УдалитьВклад",
								СтрокаПокупателя.АС_ИдентификаторГруппыПоставок,
								СтрокаПокупателя.Количество));
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				СкопированныеСтроки.Удалить(СтрокаПоставщика);
				ИндексСтроки = ИндексСтроки - 1;
				Продолжить;
			КонецЕсли;

			Если ЕстьКолонкаОтмены И СтрокаПоставщика.АС_ОтменитьВЗаказеПокупателя Тогда
				СкопированныеСтроки.Удалить(СтрокаПоставщика);
				ИндексСтроки = ИндексСтроки - 1;
				Продолжить;
			КонецЕсли;

			СвязьНайдена = Ложь;
			КоличествоВСвязях = 0;
			ЦенаВСвязяхСовпадает = Истина;
			Для Каждого СвязьПоставки Из Объект.АС_ИсточникиПоставок Цикл
				Если СвязьПоставки.ЗаказПоставщику = СтрокаПоставщика.АС_ЗаказПоставщику
					И СвязьПоставки.КлючСвязиЗаказаПоставщику = СтрокаПоставщика.АС_КлючСвязиЗаказаПоставщику Тогда
					СвязьНайдена = Истина;
					КоличествоВСвязях = КоличествоВСвязях + СвязьПоставки.Количество;
					ЦенаВСвязяхСовпадает = ЦенаВСвязяхСовпадает
						И СвязьПоставки.ЦенаПоставщика = СтрокаПоставщика.АС_ЦенаЗаказаПоставщика;
				КонецЕсли;
			КонецЦикла;

			Если СвязьНайдена
				И КоличествоВСвязях = СтрокаПоставщика.Количество
				И ЦенаВСвязяхСовпадает Тогда
				СкопированныеСтроки.Удалить(СтрокаПоставщика);
			ИначеЕсли СвязьНайдена Тогда
				ИндексСвязи = Объект.АС_ИсточникиПоставок.Количество() - 1;
				Пока ИндексСвязи >= 0 Цикл
					СвязьПоставки = Объект.АС_ИсточникиПоставок[ИндексСвязи];
					Если СвязьПоставки.ЗаказПоставщику = СтрокаПоставщика.АС_ЗаказПоставщику
						И СвязьПоставки.КлючСвязиЗаказаПоставщику = СтрокаПоставщика.АС_КлючСвязиЗаказаПоставщику Тогда
						Результат.Добавить(Новый Структура(
							"Действие,ИдентификаторГруппы,Количество",
							"УдалитьВклад",
							СвязьПоставки.ИдентификаторСтрокиПокупателя,
							СвязьПоставки.Количество));
						Объект.АС_ИсточникиПоставок.Удалить(СвязьПоставки);
					КонецЕсли;
					ИндексСвязи = ИндексСвязи - 1;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		ИндексСтроки = ИндексСтроки - 1;
	КонецЦикла;

	ХранилищеОбщихНастроек.Сохранить("БуферОбменаТабличныеЧасти", "Строки", СкопированныеСтроки);
	Возврат Результат;

КонецФункции

&НаСервере
Функция АС_СинхронизироватьСуществующиеСтрокиИзЗаказаПоставщикаНаСервереУстаревшая()

	Результат = Новый Массив;
	СкопированныеСтроки = ХранилищеОбщихНастроек.Загрузить(
		"БуферОбменаТабличныеЧасти", "Строки");
	Если СкопированныеСтроки = Неопределено
		Или СкопированныеСтроки.Колонки.Найти("АС_ИсточникЗаказПоставщика") = Неопределено
		Или СкопированныеСтроки.Колонки.Найти("АС_ЗаказПоставщику") = Неопределено
		Или СкопированныеСтроки.Колонки.Найти("АС_КлючСвязиЗаказаПоставщику") = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	ЕстьКолонкаОтмены = СкопированныеСтроки.Колонки.Найти("АС_ОтменитьВЗаказеПокупателя") <> Неопределено;

	Для Каждого СтрокаПоставщика Из СкопированныеСтроки Цикл
		Если СтрокаПоставщика.АС_ИсточникЗаказПоставщика
			И ЕстьКолонкаОтмены
			И СтрокаПоставщика.АС_ОтменитьВЗаказеПокупателя Тогда
			СтрокаРезультата = Неопределено;
			Для Каждого СтрокаРезультатаПоиска Из Результат Цикл
				Если СтрокаРезультатаПоиска.Действие = "Отмена"
					И СтрокаРезультатаПоиска.Номенклатура = СтрокаПоставщика.Номенклатура
					И СтрокаРезультатаПоиска.Характеристика = СтрокаПоставщика.Характеристика
					И СтрокаРезультатаПоиска.ЗаказПоставщику = СтрокаПоставщика.АС_ЗаказПоставщику
					И СтрокаРезультатаПоиска.КлючСвязиЗаказаПоставщику = СтрокаПоставщика.АС_КлючСвязиЗаказаПоставщику
					И СтрокаРезультатаПоиска.ЦенаПоставщика = СтрокаПоставщика.АС_ЦенаЗаказаПоставщика Тогда
					СтрокаРезультата = СтрокаРезультатаПоиска;
					Прервать;
				КонецЕсли;
			КонецЦикла;

			Если СтрокаРезультата = Неопределено Тогда
				СтрокаРезультата = Новый Структура(
					"Действие,Номенклатура,Характеристика,ЗаказПоставщику,КлючСвязиЗаказаПоставщику,ЦенаПоставщика,Количество",
					"Отмена",
					СтрокаПоставщика.Номенклатура,
					СтрокаПоставщика.Характеристика,
					СтрокаПоставщика.АС_ЗаказПоставщику,
					СтрокаПоставщика.АС_КлючСвязиЗаказаПоставщику,
					СтрокаПоставщика.АС_ЦенаЗаказаПоставщика,
					0);
				Результат.Добавить(СтрокаРезультата);
			КонецЕсли;
			СтрокаРезультата.Количество = СтрокаРезультата.Количество + СтрокаПоставщика.Количество;
		КонецЕсли;
	КонецЦикла;

	Для Каждого СтрокаРезультата Из Результат Цикл
		Если СтрокаРезультата.Действие <> "Отмена" Тогда
			Продолжить;
		КонецЕсли;

		КоличествоУжеОтменено = 0;
		Для Каждого СтрокаОтменыПокупателя Из Объект.ОтмененныеЗапасы Цикл
			Если СтрокаОтменыПокупателя.Номенклатура = СтрокаРезультата.Номенклатура
				И СтрокаОтменыПокупателя.Характеристика = СтрокаРезультата.Характеристика
				И СтрокаОтменыПокупателя.АС_ЗаказПоставщику = СтрокаРезультата.ЗаказПоставщику
				И СтрокаОтменыПокупателя.АС_КлючСвязиЗаказаПоставщику = СтрокаРезультата.КлючСвязиЗаказаПоставщику
				И СтрокаОтменыПокупателя.АС_ЦенаИзЗаказаПоставщика
				И СтрокаОтменыПокупателя.АС_ИсходнаяЦенаЗаказаПоставщика = СтрокаРезультата.ЦенаПоставщика Тогда
				КоличествоУжеОтменено = КоличествоУжеОтменено + СтрокаОтменыПокупателя.Количество;
			КонецЕсли;
		КонецЦикла;
		СтрокаРезультата.Количество = Макс(0, СтрокаРезультата.Количество - КоличествоУжеОтменено);
	КонецЦикла;

	ИндексСтроки = СкопированныеСтроки.Количество() - 1;
	Пока ИндексСтроки >= 0 Цикл
		СтрокаПоставщика = СкопированныеСтроки[ИндексСтроки];
		Если СтрокаПоставщика.АС_ИсточникЗаказПоставщика Тогда
			Если ЕстьКолонкаОтмены И СтрокаПоставщика.АС_ОтменитьВЗаказеПокупателя Тогда
				СкопированныеСтроки.Удалить(СтрокаПоставщика);
				ИндексСтроки = ИндексСтроки - 1;
				Продолжить;
			КонецЕсли;
			Для Каждого СтрокаПокупателя Из Объект.Запасы Цикл
			Если СтрокаПокупателя.Номенклатура = СтрокаПоставщика.Номенклатура
				И СтрокаПокупателя.Характеристика = СтрокаПоставщика.Характеристика
				И СтрокаПокупателя.АС_ЗаказПоставщику = СтрокаПоставщика.АС_ЗаказПоставщику
				И СтрокаПокупателя.АС_КлючСвязиЗаказаПоставщику = СтрокаПоставщика.АС_КлючСвязиЗаказаПоставщику
				И СтрокаПокупателя.АС_ЦенаИзЗаказаПоставщика
				И СтрокаПокупателя.АС_ИсходнаяЦенаЗаказаПоставщика = СтрокаПоставщика.АС_ЦенаЗаказаПоставщика Тогда
					Результат.Добавить(Новый Структура(
						"Действие,Номенклатура,Характеристика,ЗаказПоставщику,КлючСвязиЗаказаПоставщику,ЦенаПоставщика,Количество,ОбновлятьЦену",
						"Обновить",
						СтрокаПоставщика.Номенклатура,
						СтрокаПоставщика.Характеристика,
						СтрокаПоставщика.АС_ЗаказПоставщику,
						СтрокаПоставщика.АС_КлючСвязиЗаказаПоставщику,
						СтрокаПоставщика.АС_ЦенаЗаказаПоставщика,
						СтрокаПоставщика.Количество,
						СтрокаПокупателя.АС_ЦенаИзЗаказаПоставщика));
					СкопированныеСтроки.Удалить(СтрокаПоставщика);
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		ИндексСтроки = ИндексСтроки - 1;
	КонецЦикла;

	ХранилищеОбщихНастроек.Сохранить("БуферОбменаТабличныеЧасти", "Строки", СкопированныеСтроки);
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция АС_ПолучитьЦеныИзБуфераЗаказаПоставщикаНаСервере()

	Результат = Новый Массив;
	СкопированныеСтроки = ХранилищеОбщихНастроек.Загрузить(
		"БуферОбменаТабличныеЧасти", "Строки");
	Если СкопированныеСтроки = Неопределено
		Или СкопированныеСтроки.Колонки.Найти("АС_ЦенаЗаказаПоставщика") = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Строка Из СкопированныеСтроки Цикл
		Если Строка.АС_ИсточникЗаказПоставщика Тогда
			Результат.Добавить(Строка.АС_ЦенаЗаказаПоставщика);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция АС_БуферСодержитСтрокиЗаказаПоставщикаНаСервере()

	СкопированныеСтроки = ХранилищеОбщихНастроек.Загрузить(
		"БуферОбменаТабличныеЧасти", "Строки");
	Если СкопированныеСтроки = Неопределено
		Или СкопированныеСтроки.Колонки.Найти("АС_ИсточникЗаказПоставщика") = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Строка Из СкопированныеСтроки Цикл
		Если Строка.АС_ИсточникЗаказПоставщика Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

&НаСервереБезКонтекста
Функция АС_ПолучитьЦенуИзБуфераЗаказаПоставщикаНаСервере(Номенклатура, Характеристика)

	СкопированныеСтроки = ХранилищеОбщихНастроек.Загрузить(
		"БуферОбменаТабличныеЧасти", "Строки");
	Если СкопированныеСтроки = Неопределено
		Или СкопированныеСтроки.Колонки.Найти("АС_ЦенаЗаказаПоставщика") = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Для Каждого Строка Из СкопированныеСтроки Цикл
		Если Строка.Номенклатура = Номенклатура
			И Строка.Характеристика = Характеристика Тогда
			Возврат Строка.АС_ЦенаЗаказаПоставщика;
		КонецЕсли;
	КонецЦикла;

	Возврат 0;

КонецФункции

&НаСервереБезКонтекста
Функция АС_РассчитатьЦенуПоЦенеПоставщикаНаСервере(ЦенаПоставщика, Номенклатура, ВидЦен)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|   ВЫБОР
		|       КОГДА УсловияПоЦеновымГруппам.Формула ЕСТЬ NULL
		|           ТОГДА ВидыЦен.Формула
		|       ИНАЧЕ УсловияПоЦеновымГруппам.Формула
		|   КОНЕЦ КАК Формула
		|ИЗ
		|   Справочник.ВидыЦен КАК ВидыЦен
		|       ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыЦен.ЦеновыеГруппы КАК УсловияПоЦеновымГруппам
		|       ПО УсловияПоЦеновымГруппам.Ссылка = ВидыЦен.Ссылка
		|           И УсловияПоЦеновымГруппам.ЦеноваяГруппа = &ЦеноваяГруппа
		|ГДЕ
		|   ВидыЦен.Ссылка = &ВидЦен");
	Запрос.УстановитьПараметр("ЦеноваяГруппа", Номенклатура.ЦеноваяГруппа);
	Запрос.УстановитьПараметр("ВидЦен", ВидЦен);
	Результат = Запрос.Выполнить().Выбрать();
	Если Не Результат.Следующий() Тогда
		ВызватьИсключение "Не найден вид цены для расчета цены по заказу поставщика.";
	КонецЕсли;

	Если ПустаяСтрока(Результат.Формула) Тогда
		Возврат ЦенаПоставщика;
	КонецЕсли;

	ТаблицаОперандов = ЦенообразованиеФормулыСервер.ПолучитьТаблицуОперандовФормулы(
		ТекущаяДатаСеанса(), Результат.Формула);
	ТаблицаОперандов.Колонки.Добавить("Значение");
	ОперандЗакупочнойЦены = ТаблицаОперандов.Найти("[Закупочнаяцена]", "Операнд");
	Если ОперандЗакупочнойЦены = Неопределено Тогда
		ВызватьИсключение "Формула вида цены " + Строка(ВидЦен)
			+ " не содержит операнд [Закупочнаяцена].";
	КонецЕсли;

	ЗначенияЗакупочнойЦены = Новый ТаблицаЗначений;
	ЗначенияЗакупочнойЦены.Колонки.Добавить("ВидЦен", Новый ОписаниеТипов("СправочникСсылка.ВидыЦен"));
	ЗначенияЗакупочнойЦены.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ЗначенияЗакупочнойЦены.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ЗначенияЗакупочнойЦены.Колонки.Добавить("Значение", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	ЗначенияЗакупочнойЦены.Колонки.Добавить("ЕдиницаИзмерения", Новый ОписаниеТипов("СправочникСсылка.ЕдиницыИзмерения"));
	ЗначенияЗакупочнойЦены.Колонки.Добавить("Курс", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 4)));
	ЗначенияЗакупочнойЦены.Колонки.Добавить("Кратность", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 4)));
	СтрокаЗакупочнойЦены = ЗначенияЗакупочнойЦены.Добавить();
	СтрокаЗакупочнойЦены.ВидЦен = ОперандЗакупочнойЦены.ВидЦен;
	СтрокаЗакупочнойЦены.Номенклатура = Номенклатура;
	СтрокаЗакупочнойЦены.Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	СтрокаЗакупочнойЦены.Значение = ЦенаПоставщика;
	СтрокаЗакупочнойЦены.ЕдиницаИзмерения = Номенклатура.ЕдиницаИзмерения;
	СтрокаЗакупочнойЦены.Курс = 1;
	СтрокаЗакупочнойЦены.Кратность = 1;
	ОперандЗакупочнойЦены.Значение = ЗначенияЗакупочнойЦены;

	КоллекцияНоменклатуры = Новый ТаблицаЗначений;
	КоллекцияНоменклатуры.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата"));
	КоллекцияНоменклатуры.Колонки.Добавить("ВидЦен", Новый ОписаниеТипов("СправочникСсылка.ВидыЦен"));
	КоллекцияНоменклатуры.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	КоллекцияНоменклатуры.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	КоллекцияНоменклатуры.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	КоллекцияНоменклатуры.Колонки.Добавить("Актуальность", Новый ОписаниеТипов("Булево"));
	КоллекцияНоменклатуры.Колонки.Добавить("ЕдиницаИзмерения", Новый ОписаниеТипов("СправочникСсылка.ЕдиницыИзмерения"));
	КоллекцияНоменклатуры.Колонки.Добавить("ВключаяХарактеристики", Новый ОписаниеТипов("Булево"));
	КоллекцияНоменклатуры.Колонки.Добавить("Автор", Новый ОписаниеТипов("СправочникСсылка.Пользователи"));
	КоллекцияНоменклатуры.Колонки.Добавить("ПересчетВыполнен", Новый ОписаниеТипов("Булево"));
	КоллекцияНоменклатуры.Колонки.Добавить("Формула", ОбщегоНазначения.ОписаниеТипаСтрока(1024));
	СтрокаКоллекции = КоллекцияНоменклатуры.Добавить();
	СтрокаКоллекции.Период = ТекущаяДатаСеанса();
	СтрокаКоллекции.ВидЦен = ВидЦен;
	СтрокаКоллекции.Номенклатура = Номенклатура;
	СтрокаКоллекции.Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	СтрокаКоллекции.Цена = 0;
	СтрокаКоллекции.Актуальность = Истина;
	СтрокаКоллекции.ЕдиницаИзмерения = Номенклатура.ЕдиницаИзмерения;
	СтрокаКоллекции.ВключаяХарактеристики = Ложь;
	СтрокаКоллекции.ПересчетВыполнен = Ложь;
	СтрокаКоллекции.Формула = Результат.Формула;

	КурсВалюты = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВидЦен.ВалютаЦены, ТекущаяДатаСеанса());
	ПараметрыРасчета = Новый Структура("ВидЦен, Курс, Кратность", ВидЦен,
		?(ЗначениеЗаполнено(КурсВалюты.Курс), КурсВалюты.Курс, 1),
		?(ЗначениеЗаполнено(КурсВалюты.Кратность), КурсВалюты.Кратность, 1));
	ЦенообразованиеФормулыСервер.РассчитатьДанныеКоллекции(
		КоллекцияНоменклатуры, ТаблицаОперандов, ПараметрыРасчета);

	Если КоллекцияНоменклатуры.Количество() = 0 Тогда
		ВызватьИсключение "Не удалось рассчитать цену по формуле вида цены " + Строка(ВидЦен) + ".";
	КонецЕсли;

	Возврат КоллекцияНоменклатуры[0].Цена;

КонецФункции

&НаКлиенте
Функция АС_РазрешитьИспользованиеВидаЦен(ИмяТЧ)

	Если АС_ВидыЦенДляВыбора = Неопределено Тогда
		АС_ИнициализироватьВыборВидаЦен();
	КонецЕсли;

	Если ИмяТЧ = "Запасы" Тогда
		Действие = ЗапасыИзменениеСтрокДействие;
		ВидЦен = ЗапасыИзменениеСтрокЗначение;
	ИначеЕсли ИмяТЧ = "Работы" Тогда
		Действие = РаботыИзменениеСтрокДействие;
		ВидЦен = РаботыИзменениеСтрокЗначение;
	Иначе
		Возврат Истина;
	КонецЕсли;

	Если Действие <> ПредопределенноеЗначение(
			"Перечисление.ДействияГрупповогоИзмененияСтрок.УстановитьЦеныПоВиду")
		Или Не ЗначениеЗаполнено(ВидЦен) Тогда
		Возврат Истина;
	КонецЕсли;

	Для Каждого РазрешенныйВидЦен Из АС_ВидыЦенДляВыбора Цикл
		Если РазрешенныйВидЦен = ВидЦен Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Сообщить("Вид цены «" + Строка(ВидЦен)
		+ "» недоступен согласно профилю доступа.");

	Возврат Ложь;

КонецФункции

