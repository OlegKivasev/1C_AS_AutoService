&НаКлиенте
Перем АС_ОграниченоРедактированиеЦеныУслуги;

&НаСервереБезКонтекста
Функция АС_НужноОграничитьРедактированиеЦеныУслуг()

	Возврат РольДоступна(Метаданные.Роли.АС_РазрешитьИзменятьЦенуНаУслуги)
		И Не УправлениеДоступомУНФ.РазрешеноРедактированиеЦенДокументов();

КонецФункции

&НаСервере
Процедура АС_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.Ответственный = Неопределено;
	КонецЕсли;

	ПолеОтветственного = Элементы.Добавить("АС_Ответственный", Тип("ПолеФормы"), Элементы.ЗНСписыватьТоварыИМатериалыИз);
	ПолеОтветственного.Вид = ВидПоляФормы.ПолеВвода;
	ПолеОтветственного.ПутьКДанным = "Объект.Ответственный";
	ПолеОтветственного.Заголовок = "Ответственный";
	ПолеОтветственного.Ширина = 29;
	Элементы.Переместить(Элементы.АС_ДокументыБухгалтеру, Элементы.ЗНСписыватьТоварыИМатериалыИз, Элементы.ЗНЯчейкаЗапасов);
	Элементы.Переместить(ПолеОтветственного, Элементы.ЗНСписыватьТоварыИМатериалыИз, Элементы.АС_ДокументыБухгалтеру);

	ИмяКолонки = "АС_ЗапасыДоступноСУчетомЗаказовВсего";
	Колонка = Элементы.Добавить(ИмяКолонки, Тип("ПолеФормы"), Элементы.Запасы);
	Колонка.Вид = ВидПоляФормы.ПолеВвода;
	Колонка.ПутьКДанным = "Объект.Запасы.АС_ДоступноСУчетомЗаказов";
	Колонка.Заголовок = "С учетом заказов" + Символы.ПС + "(всего)";
	Колонка.Подсказка = "Физический остаток на всех складах за вычетом неотгруженных товаров в заказах покупателей и заказ-нарядах, включая текущий документ";
	Колонка.ТолькоПросмотр = Истина;
	Колонка.Ширина = 10;
	Колонка.Формат = "ЧН=0; ЧДЦ=3";
	Колонка.Видимость = РежимОстаткиИРезервы;
	Элементы.Переместить(Колонка, Элементы.Запасы, Элементы.ЗапасыЦена);

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяКолонки);
	ОформляемоеПоле.Использование = Истина;

	ОтборПоОстатку = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборПоОстатку.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Запасы.АС_ДоступноСУчетомЗаказов");
	ОтборПоОстатку.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборПоОстатку.ПравоеЗначение = 0;
	ОтборПоОстатку.Использование = Истина;

	ОтборПоТипу = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборПоТипу.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Запасы.ТипНоменклатурыЗапас");
	ОтборПоТипу.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборПоТипу.ПравоеЗначение = Истина;
	ОтборПоТипу.Использование = Истина;

	ЦветТекста = ЭлементОформления.Оформление.Элементы.Найти("ЦветТекста");
	ЦветТекста.Значение = WebЦвета.Красный;
	ЦветТекста.Использование = Истина;

КонецПроцедуры

&НаКлиенте
&Перед("ПередЗаписью")
Процедура АС_ПередЗаписью(Отказ, ПараметрыЗаписи)

	Если Не ЗначениеЗаполнено(Объект.Ответственный) Тогда
		Отказ = Истина;
		Сообщить("Выберите ответственного перед записью или проведением заказа-наряда.");
	КонецЕсли;

	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение
		И Объект.АС_Пробег = 0 Тогда
		Отказ = Истина;
		Сообщить("Укажите пробег перед проведением заказа-наряда.");
	КонецЕсли;

	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение
		И Не ЗначениеЗаполнено(Объект.АС_ДокументыБухгалтеру) Тогда
		Отказ = Истина;
		Сообщить("Укажите статус отправки документов бухгалтеру перед проведением заказа-наряда.");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура АС_ПриЧтенииНаСервере(ТекущийОбъект)

	Если Объект.ИспользоватьТовары
		И Объект.Запасы.Количество() > 0 Тогда
		АС_ЗаполнитьОстаткиПриОткрытииНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&После("ПослеЗаписи")
Процедура АС_ПослеЗаписиПосле(ПараметрыЗаписи)

	АС_ПересчитатьДоступность();

КонецПроцедуры

&НаКлиенте
Процедура АС_ПриОткрытии(Отказ)

	АС_ОграниченоРедактированиеЦеныУслуги = АС_НужноОграничитьРедактированиеЦеныУслуг();
	АС_ОбновитьДоступностьЦенУслуг();

	Элементы.АС_ЗапасыДоступноСУчетомЗаказовВсего.Видимость = РежимОстаткиИРезервы;
	Если Не РежимОстаткиИРезервы Тогда
		ОстаткиИРезервы(Неопределено);
	Иначе
		АС_ПересчитатьДоступность();
	КонецЕсли;

КонецПроцедуры

