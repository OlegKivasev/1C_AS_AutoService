&НаКлиенте
Процедура АС_НеСписыватьПриИзменении(Элемент)

	СтрокаТабличнойЧасти = Элементы.Запасы.ТекущиеДанные;
	Если СтрокаТабличнойЧасти <> Неопределено
		И ТипЗнч(СтрокаТабличнойЧасти.Номенклатура) = Тип("Строка")
		И ЗначениеЗаполнено(СтрокаТабличнойЧасти.Номенклатура)
		И Не СтрокаТабличнойЧасти.АС_НеСписывать Тогда
		СтрокаТабличнойЧасти.АС_НеСписывать = Истина;
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			"Для временного товара нельзя отключить признак «Не списывать». Для него не создается карточка номенклатуры, поэтому складское списание невозможно.");
	КонецЕсли;

	АС_ПересчитатьДоступность(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура АС_НеУчитыватьПриИзменении(Элемент)

	СтрокаТабличнойЧасти = Элементы.Запасы.ТекущиеДанные;
	Если СтрокаТабличнойЧасти = Неопределено Тогда
		Возврат;
	КонецЕсли;

	РассчитатьСуммуВСтрокеТабличнойЧасти("Запасы", СтрокаТабличнойЧасти);
	АС_ОбновитьИтогиПослеИзмененияСтоимости();

КонецПроцедуры

&НаКлиенте
Процедура АС_ПересчитатьДоступность(ИспользоватьЗарегистрированнуюПотребность = Неопределено)

	Если Не РежимОстаткиИРезервы
		Или Элементы.ЗНСтраницы.ТекущаяСтраница.Имя <> "ЗНГруппаЗапасы" Тогда
		Возврат;
	КонецЕсли;

	Если ИспользоватьЗарегистрированнуюПотребность = Неопределено Тогда
		ИспользоватьЗарегистрированнуюПотребность =
			ЗначениеЗаполнено(Объект.Ссылка) И Не Модифицированность;
	КонецЕсли;

	АС_ЗаполнитьДоступностьНаСервере(ИспользоватьЗарегистрированнуюПотребность);

КонецПроцедуры

&НаСервере
Процедура АС_ЗаполнитьОстаткиПриОткрытииНаСервере()

	ЗаказНарядВСостоянииВыполненияАС = СостоянияЗаказов.ЭтоСостояниеВыполненияЗаказНаряда(
		Объект.СостояниеЗаказа, Объект.ВидЗаказа);

	Если ЗаказНарядВСостоянииВыполненияАС Тогда
		НоменклатураВДокументахСервер.ЗаполнитьЗначенияОстатковНоменклатурыВТабличнойЧасти(
			Объект, , , "Запасы", "ЗаказНаряд");
	Иначе
		РезервированиеЗапасовАС = ПолучитьФункциональнуюОпцию("РезервированиеЗапасов");
		НоменклатураВДокументахСервер.ЗаполнитьЗначенияРезервовИОстатокНоменклатурыВТабличнойЧасти(
			Объект, , 0, , РезервированиеЗапасовАС, "Запасы");
	КонецЕсли;

	АС_ЗаполнитьДоступностьНаСервере(Истина);

КонецПроцедуры

&НаСервере
Процедура АС_ЗаполнитьДоступностьНаСервере(ИспользоватьЗарегистрированнуюПотребность = Ложь)

	ЗаказНарядВСостоянииВыполненияАС = СостоянияЗаказов.ЭтоСостояниеВыполненияЗаказНаряда(
		Объект.СостояниеЗаказа, Объект.ВидЗаказа);
	СтрокиДокумента = Новый Массив;
	Для Каждого СтрокаДокумента Из Объект.Запасы Цикл

		ИспользоватьВРасчете = СтрокаДокумента.ТипНоменклатурыЗапас
			И Не СтрокаДокумента.Отменен
			И ЗначениеЗаполнено(СтрокаДокумента.Номенклатура)
			И ТипЗнч(СтрокаДокумента.Номенклатура) <> Тип("Строка");
		УчитыватьВПотребности = Не СтрокаДокумента.АС_НеСписывать;
		ПотребностьСтроки = ?(ЗаказНарядВСостоянииВыполненияАС, 0, СтрокаДокумента.Количество);

		СтрокиДокумента.Добавить(Новый Структура(
			"Номенклатура, Характеристика, ЕдиницаИзмерения, НеОтгружено, ИспользоватьВРасчете, УчитыватьВПотребности, ИспользоватьЗарегистрированнуюПотребность",
			СтрокаДокумента.Номенклатура, СтрокаДокумента.Характеристика,
			СтрокаДокумента.ЕдиницаИзмерения, ПотребностьСтроки,
			ИспользоватьВРасчете, УчитыватьВПотребности,
			ИспользоватьЗарегистрированнуюПотребность));

	КонецЦикла;

	Результат = АС_ДоступностьТоваровСервер.Рассчитать(
		СтрокиДокумента, Объект.Организация, Объект.Ссылка);

	Для Индекс = 0 По Объект.Запасы.Количество() - 1 Цикл
		Объект.Запасы[Индекс].АС_ДоступноСУчетомЗаказов = Результат[Индекс].Доступно;
	КонецЦикла;

КонецПроцедуры

