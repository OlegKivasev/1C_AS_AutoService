&НаКлиенте
Процедура АС_ОбновитьДоступностьЦенУслуг()

	АС_ОбновитьДоступностьЦеныЗапаса();
	АС_ОбновитьДоступностьЦеныРаботы();

КонецПроцедуры

&НаКлиенте
Процедура АС_ОбновитьДоступностьЦеныЗапаса()

	Если Не АС_ОграниченоРедактированиеЦеныУслуги Тогда
		Возврат;
	КонецЕсли;

	МожноИзменять = Ложь;
	СтрокаТабличнойЧасти = Элементы.Запасы.ТекущиеДанные;
	Если СтрокаТабличнойЧасти <> Неопределено Тогда
		МожноИзменять = ТипЗнч(СтрокаТабличнойЧасти.Номенклатура) = Тип("Строка")
			И АС_РазрешеноИзменятьЦенуВременныхТоваров();
	КонецЕсли;

	Элементы.ЗапасыЦена.ТолькоПросмотр = Не МожноИзменять;

КонецПроцедуры

&НаКлиенте
Процедура АС_ОбновитьДоступностьЦеныРаботы()

	Если Не АС_ОграниченоРедактированиеЦеныУслуги Тогда
		Возврат;
	КонецЕсли;

	МожноИзменять = Ложь;
	СтрокаТабличнойЧасти = Элементы.Работы.ТекущиеДанные;
	Если СтрокаТабличнойЧасти <> Неопределено Тогда
		МожноИзменять = СтрокаТабличнойЧасти.ТипНоменклатурыУслуга;
	КонецЕсли;

	Элементы.ЗНРаботыЦена.ТолькоПросмотр = Не МожноИзменять;

КонецПроцедуры

&НаКлиенте
&После("ОбновитьОтображениеКолонокВРазрезеЗапасов")
Процедура АС_ОбновитьОтображениеКолонокВРазрезеЗапасовПосле(ИмяТЧ = Неопределено,
	УбратьВидимостьРежима = Ложь, ОбновлятьСостояние = Истина)

	Элементы.АС_ЗапасыДоступноСУчетомЗаказовВсего.Видимость = РежимОстаткиИРезервы;

КонецПроцедуры

&НаКлиенте
&После("СтраницыПриСменеСтраницы")
Процедура АС_СтраницыПриСменеСтраницыПосле(Элемент, ТекущаяСтраница)

	Если ТекущаяСтраница.Имя = "ЗНГруппаЗапасы"
		И РежимОстаткиИРезервы Тогда
		ОбновитьОтображениеКолонокВРазрезеЗапасов("Запасы");
		АС_ПересчитатьДоступность();
	КонецЕсли;

КонецПроцедуры

