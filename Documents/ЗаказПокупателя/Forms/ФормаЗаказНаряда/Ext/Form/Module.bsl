Функция АС_ПолучитьФактОплатыЗаказа(Заказ)

	Результат = Новый Структура("СуммаОплаты,СуммаАванса", 0, 0);

	Если Не ЗначениеЗаполнено(Заказ) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|    ЕСТЬNULL(ФактОплаты.СуммаОплаты, 0) КАК СуммаОплаты,
	|    ЕСТЬNULL(ФактОплаты.СуммаАванса, 0) КАК СуммаАванса
	|ИЗ
	|    РегистрСведений.ФактОплатыЗаказов КАК ФактОплаты
	|ГДЕ
	|    ФактОплаты.СчетНаОплату = &Заказ";

	Запрос.УстановитьПараметр("Заказ", Заказ);
	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Результат.СуммаОплаты = Выборка.СуммаОплаты;
		Результат.СуммаАванса = Выборка.СуммаАванса;
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура АС_ОбновитьОтображениеОплаты()

	АС_СуммаОплачено = 0;
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ДанныеОплаты = АС_ПолучитьФактОплатыЗаказа(Объект.Ссылка);
		АС_СуммаОплачено = ДанныеОплаты.СуммаОплаты + ДанныеОплаты.СуммаАванса;
	КонецЕсли;
	АС_ОбновитьОстатокОплаты();

КонецПроцедуры

&НаКлиенте
Процедура АС_ОбновитьОстатокОплаты()

	// Пересчитываем долг по текущим строкам формы, не перечитывая сам документ.
	СуммаКОплате = ИтогВсего;
	АС_СуммаДолжен = Макс(0, Окр(СуммаКОплате - АС_СуммаОплачено, 2));
	ЕстьЧастичнаяОплата = СуммаКОплате > 0
		И АС_СуммаОплачено > 0
		И АС_СуммаДолжен > 0;
	Элементы.АС_СтрокаОплаты.Видимость = ЕстьЧастичнаяОплата;

КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_ПолучитьДатуПолнойОплаты(ЗаказПокупателя)

	ДатаПолнойОплаты = Дата(1, 1, 1);
	Если Не ЗначениеЗаполнено(ЗаказПокупателя) Тогда
		Возврат ДатаПолнойОплаты;
	КонецЕсли;

	// Факт оплаты относится к сохраненной сумме, а не к несохраненным изменениям формы.
	СуммаЗаказа = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаказПокупателя, "СуммаДокумента");
	Если СуммаЗаказа <= 0 Тогда
		Возврат ДатаПолнойОплаты;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		| Оплаты.Период КАК Период,
		| Оплаты.Регистратор КАК Регистратор,
		| СУММА(Оплаты.СуммаАвансаОборот + Оплаты.СуммаОплатыОборот) КАК СуммаОплаты
		|ИЗ
		| РегистрНакопления.ОплатаСчетовИЗаказов.Обороты(
		| 	, , Регистратор, СчетНаОплату = &ЗаказПокупателя) КАК Оплаты
		|СГРУППИРОВАТЬ ПО
		| Оплаты.Период,
		| Оплаты.Регистратор
		|ИМЕЮЩИЕ
		| СУММА(Оплаты.СуммаАвансаОборот + Оплаты.СуммаОплатыОборот) <> 0
		|УПОРЯДОЧИТЬ ПО
		| Период,
		| Регистратор";
	Запрос.УстановитьПараметр("ЗаказПокупателя", ЗаказПокупателя);
	Выборка = Запрос.Выполнить().Выбрать();
	Оплачено = 0;
	Пока Выборка.Следующий() Цикл
		Оплачено = Оплачено + Выборка.СуммаОплаты;
		Если Окр(Оплачено, 2) < Окр(СуммаЗаказа, 2) Тогда
			ДатаПолнойОплаты = Дата(1, 1, 1);
		ИначеЕсли Не ЗначениеЗаполнено(ДатаПолнойОплаты) Тогда
			ДатаПолнойОплаты = Выборка.Период;
		КонецЕсли;
	КонецЦикла;

	Возврат ДатаПолнойОплаты;

КонецФункции

&НаКлиенте
Процедура АС_ФактическийФинишПриИзменении(Элемент)

	Если ЗначениеЗаполнено(АС_ФактическийФиниш) Тогда
		Если АС_ФактическийФиниш = НачалоДня(АС_ФактическийФиниш) Тогда
			АС_ФактическийФиниш = КонецДня(АС_ФактическийФиниш);
		КонецЕсли;
		Если АС_ФактическийФиниш < Объект.Старт Тогда
			АС_ОбновитьФактическиеДаты();
			ОбщегоНазначенияКлиент.СообщитьПользователю("Дата финиша не может быть раньше даты старта.");
			Возврат;
		КонецЕсли;
		Объект.Финиш = АС_ФактическийФиниш;
	ИначеЕсли Объект.СостояниеЗаказа <> ПредопределенноеЗначение("Справочник.СостоянияЗаказНарядов.Завершен") Тогда
		// Учет продолжает использовать плановый финиш, когда фактическая дата еще не задана.
		Объект.Финиш = КонецДня(Объект.Старт);
	КонецЕсли;
	Объект.АС_ДатаФинишаВручную = АС_ФактическийФиниш;
	ПриИзмененииФиниш = Объект.Финиш;
	Модифицированность = Истина;
	АС_ОбновитьФактическиеДаты();

КонецПроцедуры

&НаКлиенте
Процедура АС_ФактическаяОплатаПриИзменении(Элемент)

	Объект.АС_ДатаОплатыВручную = АС_ДатаФактическойОплаты;
	Модифицированность = Истина;
	АС_ОбновитьОплатуПоОжиданию();

КонецПроцедуры

&НаКлиенте
Процедура АС_ОбновитьОплатуПоОжиданию() Экспорт

	АС_ОбновитьОтображениеОплаты();
	Если ЗначениеЗаполнено(Объект.АС_ДатаОплатыВручную) Тогда
		АС_ДатаФактическойОплаты = Объект.АС_ДатаОплатыВручную;
	Иначе
		АС_ДатаФактическойОплаты = АС_ПолучитьДатуПолнойОплаты(Объект.Ссылка);
	КонецЕсли;

КонецПроцедуры

