	ОформлениеФлажкаНеСписывать = УсловноеОформление.Элементы.Добавить();
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
		ОформлениеФлажкаНеСписывать.Отбор,
		"Объект.Запасы.АС_НеСписывать",
		Истина);
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
		ОформлениеФлажкаНеСписывать.Отбор,
		"Объект.Запасы.ТипНоменклатурыЗапас",
