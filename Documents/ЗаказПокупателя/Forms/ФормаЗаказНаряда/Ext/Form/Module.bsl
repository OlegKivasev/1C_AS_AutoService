&НаКлиенте
Процедура АС_ОбновитьСуммуРабот()

	АС_СуммаРабот = Объект.Работы.Итог("Всего");
	АС_СуммаРаботБезНДС = Объект.Работы.Итог("Всего") - Объект.Работы.Итог("СуммаНДС");
	АС_СуммаТоваров = Объект.Запасы.Итог("Всего");
	АС_СуммаТоваровБезНДС = Объект.Запасы.Итог("Всего") - Объект.Запасы.Итог("СуммаНДС");
	АС_ИтогБезНДС = ИтогВсего - ИтогСуммаНДС;
	АС_СуммыРаботПоИсполнителям = "";
	АС_СуммыРаботБезНДСПоИсполнителям = "";

	СуммыИсполнителей = Новый Соответствие;
	СуммыИсполнителейБезНДС = Новый Соответствие;
	ПорядокИсполнителей = Новый Массив;
	ЕстьРаботы = Ложь;
	ЕстьТовары = Ложь;

	Для Каждого СтрокаРаботы Из Объект.Работы Цикл
		Если Не ЗначениеЗаполнено(СтрокаРаботы.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;

		ЕстьРаботы = Истина;
		Если Не ЗначениеЗаполнено(СтрокаРаботы.АС_Исполнитель) Тогда
			Продолжить;
		КонецЕсли;

		СуммаИсполнителя = СуммыИсполнителей.Получить(СтрокаРаботы.АС_Исполнитель);
		Если СуммаИсполнителя = Неопределено Тогда
			СуммаИсполнителя = 0;
			ПорядокИсполнителей.Добавить(СтрокаРаботы.АС_Исполнитель);
		КонецЕсли;
		СуммаИсполнителяБезНДС = СуммыИсполнителейБезНДС.Получить(СтрокаРаботы.АС_Исполнитель);
		Если СуммаИсполнителяБезНДС = Неопределено Тогда
			СуммаИсполнителяБезНДС = 0;
		КонецЕсли;
		СуммыИсполнителей.Вставить(
			СтрокаРаботы.АС_Исполнитель,
			СуммаИсполнителя + СтрокаРаботы.Всего);
		СуммыИсполнителейБезНДС.Вставить(
			СтрокаРаботы.АС_Исполнитель,
			СуммаИсполнителяБезНДС + СтрокаРаботы.Всего - СтрокаРаботы.СуммаНДС);
	КонецЦикла;

	Для Каждого СтрокаТовара Из Объект.Запасы Цикл
		Если ЗначениеЗаполнено(СтрокаТовара.Номенклатура)
			И СтрокаТовара.Отменен = 0 Тогда
			ЕстьТовары = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	ПоказыватьРазбивку = ПорядокИсполнителей.Количество() > 1;
	Если ПоказыватьРазбивку Тогда
		Для Каждого Исполнитель Из ПорядокИсполнителей Цикл
			Если Не ПустаяСтрока(АС_СуммыРаботПоИсполнителям) Тогда
				АС_СуммыРаботПоИсполнителям = АС_СуммыРаботПоИсполнителям + Символы.ПС;
			КонецЕсли;
			АС_СуммыРаботПоИсполнителям = АС_СуммыРаботПоИсполнителям
				+ Строка(Исполнитель) + " — "
				+ Формат(СуммыИсполнителей.Получить(Исполнитель), "ЧДЦ=2");
			Если Не ПустаяСтрока(АС_СуммыРаботБезНДСПоИсполнителям) Тогда
				АС_СуммыРаботБезНДСПоИсполнителям = АС_СуммыРаботБезНДСПоИсполнителям + Символы.ПС;
			КонецЕсли;
			АС_СуммыРаботБезНДСПоИсполнителям = АС_СуммыРаботБезНДСПоИсполнителям
				+ Строка(Исполнитель) + " — "
				+ Формат(СуммыИсполнителейБезНДС.Получить(Исполнитель), "ЧДЦ=2");
		КонецЦикла;
	КонецЕсли;

	Элементы.АС_ГруппаИтоговРабот.Видимость = ЕстьРаботы;
	Элементы.АС_РасшифровкаРабот.Видимость = ПоказыватьРазбивку;
	Элементы.АС_ГруппаИтоговТоваров.Видимость = ЕстьТовары;
	Элементы.АС_СуммыРаботПоИсполнителям.Видимость = ПоказыватьРазбивку;
	Элементы.АС_СуммыРаботБезНДСПоИсполнителям.Видимость = ПоказыватьРазбивку;
	Если ПоказыватьРазбивку Тогда
		Элементы.АС_СуммыРаботПоИсполнителям.Высота = Мин(ПорядокИсполнителей.Количество(), 8);
		Элементы.АС_СуммыРаботБезНДСПоИсполнителям.Высота = Мин(ПорядокИсполнителей.Количество(), 8);
	КонецЕсли;
	АС_ОбновитьОстатокОплаты();

КонецПроцедуры

&НаКлиенте
Процедура АС_ПересчитатьСтоимостьИПроверитьПередЗаписью(Отказ)

	ИзменениеСтоимостиНачато = АС_НачатьИзменениеСтоимости(Неопределено);
	Попытка
		// Денежная скидка уже рассчитана обработчиком изменения строки или перенесена
		// из буфера. Округлённый процент не должен менять её при записи документа.
		ПараметрыРасчета = Новый Структура(
			"РассчитатьПроцентСкидки,СброситьФлагСкидкиРассчитаны", Истина, Ложь);
		ТекстСтрокБезЦены = "";
		НомерСтроки = 0;

		Для Каждого СтрокаТовара Из Объект.Запасы Цикл
			НомерСтроки = НомерСтроки + 1;
			Если СтрокаТовара.ЭтоРазделитель
				Или СтрокаТовара.Отменен <> 0
				Или Не ЗначениеЗаполнено(СтрокаТовара.Номенклатура)
				Или ТипЗнч(СтрокаТовара.Номенклатура) <> Тип("СправочникСсылка.Номенклатура") Тогда
				Продолжить;
			КонецЕсли;

			Если СтрокаТовара.ТипНоменклатурыЗапас И СтрокаТовара.Цена = 0
				И Не СтрокаТовара.АС_ЦенаИзЗаказаПоставщика Тогда
				АС_ЗаполнитьЦенуТовараПоВидуЦен(СтрокаТовара);
			КонецЕсли;

			ИсходнаяЦена = СтрокаТовара.Цена;
			ИсходнаяСумма = СтрокаТовара.Сумма;
			ИсходнаяАвтоСкидка = СтрокаТовара.СуммаАвтоматическойСкидки;
			ИсходнаяБонуснаяСкидка = СтрокаТовара.СуммаСкидкиОплатыБонусом;
			ИсходнаяСуммаСкидки = СтрокаТовара.СуммаСкидкиНаценки;
			ИсходныйПроцентСкидки = СтрокаТовара.ПроцентСкидкиНаценки;
			РассчитатьСуммуВСтрокеТабличнойЧасти("Запасы", СтрокаТовара, ПараметрыРасчета);
			Если СтрокаТовара.СуммаСкидкиНаценки = ИсходнаяСуммаСкидки Тогда
				// Запись не должна превращать заданный процент в процент от округлённой суммы.
				СтрокаТовара.ПроцентСкидкиНаценки = ИсходныйПроцентСкидки;
				Если СтрокаТовара.Цена = ИсходнаяЦена
					И СтрокаТовара.СуммаАвтоматическойСкидки = ИсходнаяАвтоСкидка
					И СтрокаТовара.СуммаСкидкиОплатыБонусом = ИсходнаяБонуснаяСкидка
					И Не СтрокаТовара.АС_НеУчитывать И СтрокаТовара.Отменен = 0
					И АС_СуммаСтрокиНеНижеМинимальной(СтрокаТовара, ИсходнаяСумма) Тогда
					// Точный ввод суммы сохраняется и после полного пересчёта перед записью.
					СтрокаТовара.Сумма = ИсходнаяСумма;
					ТабличныеЧастиУНФКлиент.РассчитатьСуммуНДСИВсего(СтрокаТовара,
						Новый Структура("СуммаВключаетНДС", Объект.СуммаВключаетНДС));
				КонецЕсли;
			КонецЕсли;

			Если Не СтрокаТовара.АС_НеУчитывать
				И СтрокаТовара.Количество <> 0
				И СтрокаТовара.Цена = 0 Тогда
				ТекстСтрокБезЦены = ТекстСтрокБезЦены + Символы.ПС
					+ СтрШаблон("Товары, строка %1: %2", НомерСтроки, СтрокаТовара.Номенклатура);
			КонецЕсли;
		КонецЦикла;

		НомерСтроки = 0;
		Для Каждого СтрокаРаботы Из Объект.Работы Цикл
			НомерСтроки = НомерСтроки + 1;
			Если Не ЗначениеЗаполнено(СтрокаРаботы.Номенклатура)
				Или ТипЗнч(СтрокаРаботы.Номенклатура) <> Тип("СправочникСсылка.Номенклатура") Тогда
				Продолжить;
			КонецЕсли;

			РассчитатьСуммуВСтрокеТабличнойЧасти("Работы", СтрокаРаботы, ПараметрыРасчета);

			Если СтрокаРаботы.Количество <> 0 И СтрокаРаботы.Цена = 0 Тогда
				ТекстСтрокБезЦены = ТекстСтрокБезЦены + Символы.ПС
					+ СтрШаблон("Работы, строка %1: %2", НомерСтроки, СтрокаРаботы.Номенклатура);
			КонецЕсли;
		КонецЦикла;

		АС_ОбновитьИтогиПослеИзмененияСтоимости();

		Если Не ПустаяСтрока(ТекстСтрокБезЦены) Тогда
			Отказ = Истина;
			Сообщить("Запись отменена: у товаров или работ не определена цена."
				+ Символы.ПС + "Укажите цену в строках:" + ТекстСтрокБезЦены);
		КонецЕсли;
	Исключение
		АС_ЗавершитьИзменениеСтоимости(ИзменениеСтоимостиНачато, Ложь);
		ВызватьИсключение;
	КонецПопытки;
	АС_ЗавершитьИзменениеСтоимости(ИзменениеСтоимостиНачато);

КонецПроцедуры

&НаКлиенте
&Вместо("РассчитатьСуммуВСтрокеТабличнойЧасти")
Процедура АС_РассчитатьСуммуВСтрокеТабличнойЧасти(ИмяТабличнойЧасти = "Запасы",
	СтрокаТабличнойЧасти = Неопределено, ПараметрыРасчета = Неопределено)

	СтрокаБезПересчета = Неопределено;
	Если ИмяТабличнойЧасти = "Запасы" Тогда
		СтрокаБезПересчета = СтрокаТабличнойЧасти;
		Если СтрокаБезПересчета = Неопределено Тогда
			СтрокаБезПересчета = Элементы.Запасы.ТекущиеДанные;
		КонецЕсли;
	КонецЕсли;

	ИзменениеСтоимостиНачато = АС_НачатьИзменениеСтоимости(СтрокаБезПересчета);
	Попытка
		Если ИмяТабличнойЧасти = "Запасы"
			И ЗначениеЗаполнено(АС_РежимЦенПриВставке) И ПараметрыРасчета = Неопределено Тогда
			СтрокаДляРасчета = СтрокаТабличнойЧасти;
			Если СтрокаДляРасчета = Неопределено Тогда
				СтрокаДляРасчета = Элементы.Запасы.ТекущиеДанные;
			КонецЕсли;
			СохранитьСкидки = АС_РежимЦенПриВставке = "Исходные";
			Если СтрокаДляРасчета <> Неопределено Тогда
				СохранитьСкидки = СохранитьСкидки Или СтрокаДляРасчета.АС_ЦенаИзЗаказаПоставщика;
			КонецЕсли;
			Если СохранитьСкидки Тогда
				// Синие цены и точные скидки сохраняем при любом выборе режима вставки.
				ПараметрыРасчета = Новый Структура(
					"РассчитатьПроцентСкидки,СброситьФлагСкидкиРассчитаны", Истина, Ложь);
			КонецЕсли;
		КонецЕсли;
		ПродолжитьВызов(ИмяТабличнойЧасти, СтрокаТабличнойЧасти, ПараметрыРасчета);

		// Обработку исключённых из итогов строк выполняем в том же перехвате.
		Если ИмяТабличнойЧасти = "Запасы" Тогда
			Если СтрокаТабличнойЧасти = Неопределено Тогда
				СтрокаТабличнойЧасти = Элементы.Запасы.ТекущиеДанные;
			КонецЕсли;

			Если АС_ОбнулитьСуммыНеучитываемойСтроки(СтрокаТабличнойЧасти) Тогда
				АС_РассчитатьСуммуИПроцентСкидкиРаботыЗапасы(Объект, СкидкаСумма, СкидкаПроцент);
				АС_ОбновитьИтогиПослеИзмененияСтоимости();
			КонецЕсли;
		КонецЕсли;
	Исключение
		АС_ЗавершитьИзменениеСтоимости(ИзменениеСтоимостиНачато, Ложь);
		ВызватьИсключение;
	КонецПопытки;
	АС_ЗавершитьИзменениеСтоимости(ИзменениеСтоимостиНачато);

КонецПроцедуры

&НаКлиенте
Функция АС_ОбнулитьСуммыНеучитываемойСтроки(СтрокаТабличнойЧасти)

	Если СтрокаТабличнойЧасти = Неопределено
		Или Не СтрокаТабличнойЧасти.АС_НеУчитывать Тогда
		Возврат Ложь;
	КонецЕсли;

	СуммыИзменены = СтрокаТабличнойЧасти.Сумма <> 0
		Или СтрокаТабличнойЧасти.СуммаНДС <> 0
		Или СтрокаТабличнойЧасти.Всего <> 0
		Или СтрокаТабличнойЧасти.СуммаСкидкиНаценки <> 0
		Или СтрокаТабличнойЧасти.СуммаАвтоматическойСкидки <> 0
		Или СтрокаТабличнойЧасти.СуммаСкидкиОплатыБонусом <> 0;

	СтрокаТабличнойЧасти.Сумма = 0;
	СтрокаТабличнойЧасти.СуммаНДС = 0;
	СтрокаТабличнойЧасти.Всего = 0;
	СтрокаТабличнойЧасти.СуммаСкидкиНаценки = 0;
	СтрокаТабличнойЧасти.СуммаАвтоматическойСкидки = 0;
	СтрокаТабличнойЧасти.СуммаСкидкиОплатыБонусом = 0;

	Возврат СуммыИзменены;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
&Вместо("РассчитатьСуммуИПроцентСкидкиРаботыЗапасы")
Процедура АС_РассчитатьСуммуИПроцентСкидкиРаботыЗапасы(Объект, СкидкаСумма, СкидкаПроцент)

	ОбщаяСуммаБезСкидок = 0;
	Для Каждого СтрокаЗапаса Из Объект.Запасы Цикл
		Если Не СтрокаЗапаса.АС_НеУчитывать И Не СтрокаЗапаса.АС_БезСкидки Тогда
			ОбщаяСуммаБезСкидок = ОбщаяСуммаБезСкидок + СтрокаЗапаса.Цена * СтрокаЗапаса.Количество;
		КонецЕсли;
	КонецЦикла;

	СкидкаСумма = Объект.Запасы.Итог("СуммаСкидкиНаценки");
	СкидкаПроцент = ?(ОбщаяСуммаБезСкидок = 0, 0, СкидкаСумма / ОбщаяСуммаБезСкидок * 100);

КонецПроцедуры

