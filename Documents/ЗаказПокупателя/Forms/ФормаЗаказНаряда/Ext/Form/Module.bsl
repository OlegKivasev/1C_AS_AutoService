// Сумма товаров округляется по правилам РМК: свыше 200 до 50, с резервной правкой суммы строки.
&НаКлиенте
Функция АС_НачатьИзменениеСтоимости(СтрокаБезПересчета = Неопределено)

	Если АС_ФормаГотоваКОкруглению <> Истина
		Или АС_ПересчитываетсяОкруглениеЦен = Истина Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Не АС_НужноОбрабатыватьОкругление() Тогда
		Возврат Ложь;
	КонецЕсли;
	АС_ГлубинаИзмененияСтоимости = АС_ГлубинаИзмененияСтоимости + 1;
	Если АС_ГлубинаИзмененияСтоимости = 1 Тогда
		Попытка
			АС_ВосстановитьЦеныДоОкругления(СтрокаБезПересчета);
		Исключение
			АС_ГлубинаИзмененияСтоимости = 0;
			ВызватьИсключение;
		КонецПопытки;
	КонецЕсли;
	Возврат Истина;

КонецФункции

&НаКлиенте
Процедура АС_ЗавершитьИзменениеСтоимости(ИзменениеНачато, ПересчитатьИтог = Истина)

	Если Не ИзменениеНачато Тогда
		Возврат;
	КонецЕсли;
	АС_ГлубинаИзмененияСтоимости = АС_ГлубинаИзмененияСтоимости - 1;
	Если АС_ГлубинаИзмененияСтоимости = 0 И ПересчитатьИтог Тогда
		ОбновитьПодвалФормы();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&Вместо("ОбновитьПодвалФормы")
Процедура АС_ОбновитьПодвалСОкруглениемЦены()

	Если АС_ФормаГотоваКОкруглению <> Истина
		Или АС_ПересчитываетсяОкруглениеЦен = Истина
		Или АС_ГлубинаИзмененияСтоимости > 0 Или ТолькоПросмотр Тогда
		ПродолжитьВызов();
		АС_ОбновитьПодвалФормыПосле();
		Возврат;
	КонецЕсли;
	Если Не АС_НужноОбрабатыватьОкругление() Тогда
		ПродолжитьВызов();
		АС_ОбновитьПодвалФормыПосле();
		Возврат;
	КонецЕсли;
	АС_ПересчитываетсяОкруглениеЦен = Истина;
	Попытка
		ПредыдущийИтог = АС_ИтогДляОкругления();
		АС_ВосстановитьЦеныДоОкругления();
		Если АС_ОкруглятьИтогЗаказНаряда Тогда
			АС_ОкруглитьИтогИзменениемЦены();
		Иначе
			АС_ПоследнийНеокругленныйИтог = Неопределено;
		КонецЕсли;
		АС_РассчитатьСуммуИПроцентСкидкиРаботыЗапасы(Объект, СкидкаСумма, СкидкаПроцент);
		ПродолжитьВызов();
		АС_ОбновитьПодвалФормыПосле();
		Если ПредыдущийИтог <> АС_ИтогДляОкругления() Тогда
			Модифицированность = Истина;
			ПересчитатьПлатежныйКалендарь();
		КонецЕсли;
	Исключение
		АС_ПересчитываетсяОкруглениеЦен = Ложь;
		ВызватьИсключение;
	КонецПопытки;
	АС_ПересчитываетсяОкруглениеЦен = Ложь;

КонецПроцедуры

&НаКлиенте
Функция АС_НужноОбрабатыватьОкругление()

	Если АС_КонтрагентОкругления <> Объект.Контрагент
		Или АС_ОкруглятьИтогЗаказНаряда = Неопределено Тогда
		АС_КонтрагентОкругления = Объект.Контрагент;
		АС_ОкруглятьИтогЗаказНаряда = АС_КонтрагентФизическоеЛицо(Объект.Контрагент);
	КонецЕсли;
	Если АС_ОкруглятьИтогЗаказНаряда Тогда
		Возврат Истина;
	КонецЕсли;
	Для Каждого СтрокаТовара Из Объект.Запасы Цикл
		Если СтрокаТовара.АС_ЦенаДоОкругленияЗН > 0 И СтрокаТовара.Отгружено = 0 Тогда
			// При смене физлица на другой вид снимаем предыдущее округление.
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

&НаКлиенте
Функция АС_ИтогДляОкругления()

	Если Объект.КоличествоВариантовКП <> 0 И Объект.ОсновнойВариантКП = 0 Тогда
		Возврат 0;
	КонецЕсли;
	// Работы и доставка не участвуют в округлении суммы товаров.
	Результат = 0;
	Для Каждого СтрокаТовара Из Объект.Запасы Цикл
		Если Не СтрокаТовара.ЭтоРазделитель
			И СтрокаТовара.НомерВариантаКП = Объект.ОсновнойВариантКП Тогда
			Результат = Результат + СтрокаТовара.Всего;
		КонецЕсли;
	КонецЦикла;
	Возврат Окр(Результат, 2);

КонецФункции

&НаКлиенте
Процедура АС_ВосстановитьЦеныДоОкругления(СтрокаБезПересчета = Неопределено)

	Для Каждого СтрокаТовара Из Объект.Запасы Цикл
		Если СтрокаТовара.АС_ЦенаДоОкругленияЗН <= 0 Или СтрокаТовара.Отгружено > 0 Тогда
			Продолжить;
		КонецЕсли;
		ИсходнаяЦена = СтрокаТовара.АС_ЦенаДоОкругленияЗН;
		ОкругленнаяЦена = СтрокаТовара.АС_ЦенаПослеОкругленияЗН;
		ИсходнаяСумма = СтрокаТовара.АС_СуммаДоОкругленияЗН;
		ИсходнаяСкидка = СтрокаТовара.АС_СкидкаДоОкругленияЗН;
		ИсходныйПроцентСкидки = СтрокаТовара.АС_ПроцентСкидкиДоОкругленияЗН;
		КоличествоНеИзменено = СтрокаТовара.АС_КоличествоПриОкругленииЗН = 0
			Или СтрокаТовара.Количество = СтрокаТовара.АС_КоличествоПриОкругленииЗН;
		СуммаНеИзменена = СтрокаТовара.АС_КоличествоПриОкругленииЗН > 0
			И КоличествоНеИзменено
			И СтрокаТовара.Сумма = СтрокаТовара.АС_СуммаПослеОкругленияЗН;
		СкидкаНеИзменена = СтрокаТовара.СуммаСкидкиНаценки = СтрокаТовара.АС_СкидкаПослеОкругленияЗН
			И СтрокаТовара.ПроцентСкидкиНаценки = СтрокаТовара.АС_ПроцентСкидкиПослеОкругленияЗН;
		Если СтрокаТовара.Цена = ОкругленнаяЦена И СкидкаНеИзменена Тогда
			СтрокаТовара.СуммаСкидкиНаценки = СтрокаТовара.АС_СкидкаДоОкругленияЗН;
			СтрокаТовара.ПроцентСкидкиНаценки = СтрокаТовара.АС_ПроцентСкидкиДоОкругленияЗН;
		КонецЕсли;
		СтрокаТовара.АС_ЦенаДоОкругленияЗН = 0;
		СтрокаТовара.АС_ЦенаПослеОкругленияЗН = 0;
		СтрокаТовара.АС_СкидкаДоОкругленияЗН = 0;
		СтрокаТовара.АС_СкидкаПослеОкругленияЗН = 0;
		СтрокаТовара.АС_ПроцентСкидкиДоОкругленияЗН = 0;
		СтрокаТовара.АС_ПроцентСкидкиПослеОкругленияЗН = 0;
		СтрокаТовара.АС_СуммаДоОкругленияЗН = 0;
		СтрокаТовара.АС_СуммаПослеОкругленияЗН = 0;
		СтрокаТовара.АС_КоличествоПриОкругленииЗН = 0;
		// Введённая вручную или полученная по виду цен цена становится новой исходной.
		Если СтрокаТовара.Цена <> ОкругленнаяЦена Тогда
			Продолжить;
		КонецЕсли;
		СтрокаТовара.Цена = ИсходнаяЦена;
		Если СтрокаБезПересчета <> Неопределено Тогда
			Если СтрокаТовара.ПолучитьИдентификатор() = СтрокаБезПересчета.ПолучитьИдентификатор() Тогда
				// Введённую скидку/сумму текущей строки рассчитает вызывающий обработчик.
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Если Не СтрокаТовара.ЭтоРазделитель И СтрокаТовара.Отменен = 0 Тогда
			ИсходнаяАвтоСкидка = СтрокаТовара.СуммаАвтоматическойСкидки;
			ИсходнаяБонуснаяСкидка = СтрокаТовара.СуммаСкидкиОплатыБонусом;
			АС_РассчитатьСтрокуПриОкруглении(СтрокаТовара, СкидкаНеИзменена И КоличествоНеИзменено);
			Если СкидкаНеИзменена И КоличествоНеИзменено
				И СтрокаТовара.СуммаСкидкиНаценки = ИсходнаяСкидка Тогда
				// Не выводим исходный процент заново из округлённой денежной скидки:
				// при дробном количестве это превращало, например, 20% в 20,02%.
				СтрокаТовара.ПроцентСкидкиНаценки = ИсходныйПроцентСкидки;
				Если СуммаНеИзменена
					И АС_СуммаСтрокиНеНижеМинимальной(СтрокаТовара, ИсходнаяСумма)
					И СтрокаТовара.СуммаАвтоматическойСкидки = ИсходнаяАвтоСкидка
					И СтрокаТовара.СуммаСкидкиОплатыБонусом = ИсходнаяБонуснаяСкидка Тогда
					// Сохраняем точный ручной ввод суммы, если скидки не урезаны минимумом.
					СтрокаТовара.Сумма = ИсходнаяСумма;
					ТабличныеЧастиУНФКлиент.РассчитатьСуммуНДСИВсего(СтрокаТовара,
						Новый Структура("СуммаВключаетНДС", Объект.СуммаВключаетНДС));
				КонецЕсли;
			КонецЕсли;
			АС_ОбнулитьСуммыНеучитываемойСтроки(СтрокаТовара);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура АС_РассчитатьСтрокуПриОкруглении(СтрокаТовара, СохранитьСуммуСкидки = Неопределено)

	СуммаБезСкидки = Окр(СтрокаТовара.Цена * СтрокаТовара.Количество, 2);
	// Как в РМК: сохраняем точную денежную скидку, когда её процент
	// согласован с новой ценой; в остальных случаях приоритет у процента.
	Если СохранитьСуммуСкидки = Неопределено Тогда
		СохранитьСуммуСкидки = СтрокаТовара.ПроцентСкидкиНаценки = 0;
		Если СуммаБезСкидки > 0 Тогда
			СохранитьСуммуСкидки = СохранитьСуммуСкидки
				Или Окр(СтрокаТовара.СуммаСкидкиНаценки / СуммаБезСкидки * 100, 2)
					= СтрокаТовара.ПроцентСкидкиНаценки;
		КонецЕсли;
	КонецЕсли;
	ПараметрыРасчета = Новый Структура("СуммаВключаетНДС,ИспользоватьМинимальныеЦены",
		Объект.СуммаВключаетНДС, КэшЗначений.ИспользоватьМинимальныеЦены);
	Если СохранитьСуммуСкидки Тогда
		ПараметрыРасчета.Вставить("РассчитатьПроцентСкидки", Истина);
	Иначе
		ПараметрыРасчета.Вставить("РассчитатьСуммуСкидки", Истина);
	КонецЕсли;
	ТабличныеЧастиУНФКлиент.РассчитатьСуммыВСтрокеТЧ(СтрокаТовара, ПараметрыРасчета);

КонецПроцедуры

&НаКлиенте
Процедура АС_ОкруглитьИтогИзменениемЦены()

	ИсходныйИтог = АС_ИтогДляОкругления();
	Если ИсходныйИтог <= 200 Тогда
		АС_ПоследнийНеокругленныйИтог = Неопределено;
		Возврат;
	КонецЕсли;
	ПравилоОкругления = ПредопределенноеЗначение("Перечисление.ПорядкиОкругления.Окр50");
	ЦелевойИтог = ЦенообразованиеКлиентСервер.ОкруглитьЦену(ИсходныйИтог, ПравилоОкругления, Ложь);
	Если ЦелевойИтог = ИсходныйИтог Тогда
		АС_ПоследнийНеокругленныйИтог = Неопределено;
		Возврат;
	КонецЕсли;
	// Сначала проверяем все цены; сумма служит только запасным способом.
	Для СпособОкругления = 1 По 2 Цикл
		Для ПриоритетКоличество = 1 По 2 Цикл
			Для Каждого СтрокаТовара Из Объект.Запасы Цикл
				Если (ПриоритетКоличество = 1 И СтрокаТовара.Количество <> 1)
					Или (ПриоритетКоличество = 2 И СтрокаТовара.Количество = 1)
					Или Не АС_МожноОкруглитьЦенуСтроки(СтрокаТовара) Тогда
					Продолжить;
				КонецЕсли;
				Если АС_ПодобратьЦенуДляИтога(СтрокаТовара, ИсходныйИтог, ЦелевойИтог,
					СпособОкругления = 2) Тогда
					АС_ПоследнийНеокругленныйИтог = Неопределено;
					Возврат;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Если АС_ПоследнийНеокругленныйИтог <> ИсходныйИтог Тогда
		Сообщить("Сумма товаров заказ-наряда не округлена: нет подходящего товара, цену или сумму которого можно изменить до точного итога с сохранением скидок и минимальной цены.");
		АС_ПоследнийНеокругленныйИтог = ИсходныйИтог;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция АС_МожноОкруглитьЦенуСтроки(СтрокаТовара)

	Если СтрокаТовара.АС_БезСкидки Тогда
		Возврат Ложь;
	КонецЕсли;

	Если СтрокаТовара.Количество <= 0 Или СтрокаТовара.Цена <= 0
		Или СтрокаТовара.Отменен <> 0 Или СтрокаТовара.Отгружено > 0
		Или СтрокаТовара.НомерВариантаКП <> Объект.ОсновнойВариантКП
		Или СтрокаТовара.ЭтоРазделитель Или СтрокаТовара.АС_НеУчитывать
		Или Не СтрокаТовара.ТипНоменклатурыЗапас Или СтрокаТовара.ПродажаПодарка
		Или СтрокаТовара.ЭтоНабор Или ЗначениеЗаполнено(СтрокаТовара.НоменклатураНабора)
		Или ТипЗнч(СтрокаТовара.Номенклатура) <> Тип("СправочникСсылка.Номенклатура") Тогда
		Возврат Ложь;
	КонецЕсли;
	Если АС_ДопускНоменклатурыКОкруглению = Неопределено Тогда
		АС_ДопускНоменклатурыКОкруглению = Новый Соответствие;
	КонецЕсли;
	Разрешено = АС_ДопускНоменклатурыКОкруглению.Получить(СтрокаТовара.Номенклатура);
	Если Разрешено = Неопределено Тогда
		Разрешено = АС_НоменклатураДопускаетОкруглениеЦены(СтрокаТовара.Номенклатура);
		АС_ДопускНоменклатурыКОкруглению.Вставить(СтрокаТовара.Номенклатура, Разрешено);
	КонецЕсли;
	Возврат Разрешено;

КонецФункции

&НаСервереБезКонтекста
Функция АС_НоменклатураДопускаетОкруглениеЦены(Номенклатура)

	РеквизитыТовара = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Номенклатура, "ТипНоменклатуры,ВидПродукцииИС");
	Возврат РеквизитыТовара.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Запас
		И РеквизитыТовара.ВидПродукцииИС <> Перечисления.ВидыПродукцииИС.Табак
		И РеквизитыТовара.ВидПродукцииИС <> Перечисления.ВидыПродукцииИС.АльтернативныйТабак
		И РеквизитыТовара.ВидПродукцииИС <> Перечисления.ВидыПродукцииИС.НикотиносодержащаяПродукция;

КонецФункции

&НаКлиенте
Функция АС_ПодобратьЦенуДляИтога(СтрокаТовара, ИсходныйИтог, ЦелевойИтог, КорректироватьСумму = Ложь)

	ИсходныеЗначения = Новый Структура(
		"Цена,Сумма,СуммаНДС,Всего,ПроцентСкидкиНаценки,СуммаСкидкиНаценки,"
		+ "ПроцентАвтоматическойСкидки,СуммаАвтоматическойСкидки,СуммаСкидкиОплатыБонусом");
	ЗаполнитьЗначенияСвойств(ИсходныеЗначения, СтрокаТовара);
	МинимальнаяЦена = 0;
	Если СтрокаТовара.Свойство("МинимальнаяЦена") Тогда
		МинимальнаяЦена = СтрокаТовара.МинимальнаяЦена;
	КонецЕсли;
	ИсходнаяЦена = ИсходныеЗначения.Цена;
	НоваяЦена = Окр(ИсходнаяЦена + (ЦелевойИтог - ИсходныйИтог) / СтрокаТовара.Количество, 2);
	ПроверенныеЦены = Новый Массив;
	Для НомерПопытки = 1 По 4 Цикл
		Если НоваяЦена <= 0 Или НоваяЦена < МинимальнаяЦена
			Или Окр(НоваяЦена * СтрокаТовара.Количество, 2) <= 0
			Или (НоваяЦена = ИсходнаяЦена И Не КорректироватьСумму)
			Или ПроверенныеЦены.Найти(НоваяЦена) <> Неопределено Тогда
			Прервать;
		КонецЕсли;
		ПроверенныеЦены.Добавить(НоваяЦена);
		ЗаполнитьЗначенияСвойств(СтрокаТовара, ИсходныеЗначения);
		СтрокаТовара.Цена = НоваяЦена;
		Попытка
			АС_РассчитатьСтрокуПриОкруглении(СтрокаТовара);
		Исключение
			ЗаполнитьЗначенияСвойств(СтрокаТовара, ИсходныеЗначения);
			ВызватьИсключение;
		КонецПопытки;
		ФактическийИтог = АС_ИтогДляОкругления();
		СкидкаДопустима = Не АС_ОграничиватьРучныеСкидки
			Или СтрокаТовара.ПроцентСкидкиНаценки <= 20
				И СтрокаТовара.СуммаСкидкиНаценки <= Окр(АС_СуммаБезСкидкиСтроки(СтрокаТовара) * 0.2, 2);
		// Не принимаем цену, из-за которой штатный контроль минимальной цены урезал скидки.
		АвтоСкидкаСохранена = СтрокаТовара.СуммаАвтоматическойСкидки = ИсходныеЗначения.СуммаАвтоматическойСкидки;
		СуммаБезСкидки = Окр(НоваяЦена * СтрокаТовара.Количество, 2);
		СохраняласьДенежнаяСкидка = ИсходныеЗначения.ПроцентСкидкиНаценки = 0
			Или Окр(ИсходныеЗначения.СуммаСкидкиНаценки / СуммаБезСкидки * 100, 2)
				= ИсходныеЗначения.ПроцентСкидкиНаценки;
		РучнаяСкидкаСохранена = ?(СохраняласьДенежнаяСкидка,
			СтрокаТовара.СуммаСкидкиНаценки = ИсходныеЗначения.СуммаСкидкиНаценки,
			СтрокаТовара.ПроцентСкидкиНаценки = ИсходныеЗначения.ПроцентСкидкиНаценки);
		Если КорректироватьСумму И ФактическийИтог <> ЦелевойИтог
			И СкидкаДопустима И АвтоСкидкаСохранена И РучнаяСкидкаСохранена Тогда
			Попытка
				СуммаПодобрана = АС_ПодобратьСуммуДляИтога(СтрокаТовара, ФактическийИтог, ЦелевойИтог, МинимальнаяЦена);
			Исключение
				ЗаполнитьЗначенияСвойств(СтрокаТовара, ИсходныеЗначения);
				ВызватьИсключение;
			КонецПопытки;
			Если СуммаПодобрана Тогда
				ФактическийИтог = АС_ИтогДляОкругления();
			КонецЕсли;
		КонецЕсли;
		Если ФактическийИтог = ЦелевойИтог И СкидкаДопустима И АвтоСкидкаСохранена И РучнаяСкидкаСохранена
			И СтрокаТовара.Сумма >= Окр(МинимальнаяЦена * СтрокаТовара.Количество, 2) Тогда
			АС_ЗапомнитьОкруглениеСтроки(СтрокаТовара, ИсходныеЗначения);
			Возврат Истина;
		КонецЕсли;
		ИзменениеИтога = ФактическийИтог - ИсходныйИтог;
		Если НоваяЦена = ИсходнаяЦена Тогда
			// Ручная сумма могла отличаться от цены на копейки. При той же цене
			// делитель для оценки влияния равен нулю: проверяем соседнюю копейку.
			НоваяЦена = Окр(НоваяЦена + ?(ЦелевойИтог > ФактическийИтог, 0.01, -0.01), 2);
			Продолжить;
		КонецЕсли;
		Если ИзменениеИтога = 0 Тогда
			Прервать;
		КонецЕсли;
		ВлияниеЦеныНаИтог = ИзменениеИтога / (НоваяЦена - ИсходнаяЦена);
		НоваяЦена = Окр(НоваяЦена + (ЦелевойИтог - ФактическийИтог) / ВлияниеЦеныНаИтог, 2);
	КонецЦикла;
	ЗаполнитьЗначенияСвойств(СтрокаТовара, ИсходныеЗначения);
	Возврат Ложь;

КонецФункции

&НаКлиенте
Функция АС_СуммаСтрокиНеНижеМинимальной(СтрокаТовара, ПроверяемаяСумма)

	Если ПроверяемаяСумма <= 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СтрокаТовара.Свойство("МинимальнаяЦена") И СтрокаТовара.Цена > 0 Тогда
		КоличествоДляЦены = АС_СуммаБезСкидкиСтроки(СтрокаТовара) / СтрокаТовара.Цена;
		Возврат ПроверяемаяСумма >= Окр(СтрокаТовара.МинимальнаяЦена * КоличествоДляЦены, 2);
	КонецЕсли;
	Возврат Истина;

КонецФункции

&НаКлиенте
Функция АС_ПодобратьСуммуДляИтога(СтрокаТовара, ИсходныйИтог, ЦелевойИтог, МинимальнаяЦена)

	ИсходныеСуммы = Новый Структура("Сумма,СуммаНДС,Всего");
	ЗаполнитьЗначенияСвойств(ИсходныеСуммы, СтрокаТовара);
	Если ИсходныеСуммы.Сумма <= 0 Или ИсходныеСуммы.Всего <= 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	КоличествоДляЦены = АС_СуммаБезСкидкиСтроки(СтрокаТовара) / СтрокаТовара.Цена;
	ПараметрыНДС = Новый Структура("СуммаВключаетНДС", Объект.СуммаВключаетНДС);
	КоэффициентСуммы = ИсходныеСуммы.Сумма / ИсходныеСуммы.Всего;
	НоваяСумма = Окр(ИсходныеСуммы.Сумма + (ЦелевойИтог - ИсходныйИтог) * КоэффициентСуммы, 2);
	ПроверенныеСуммы = Новый Массив;
	Для НомерПопытки = 1 По 4 Цикл
		Если НоваяСумма <= 0 Или НоваяСумма < Окр(МинимальнаяЦена * СтрокаТовара.Количество, 2)
			Или ПроверенныеСуммы.Найти(НоваяСумма) <> Неопределено Тогда
			Прервать;
		КонецЕсли;
		// Поправляем лишь остаток округления: цена согласована с точной суммой
		// и уже рассчитанными скидками. Дополнительную ручную скидку не создаём.
		ЦенаИзСуммы = Окр((НоваяСумма + СтрокаТовара.СуммаСкидкиНаценки
			+ СтрокаТовара.СуммаАвтоматическойСкидки + СтрокаТовара.СуммаСкидкиОплатыБонусом)
			/ КоличествоДляЦены, 2);
		ПроверенныеСуммы.Добавить(НоваяСумма);
		СтрокаТовара.Сумма = НоваяСумма;
		Попытка
			ТабличныеЧастиУНФКлиент.РассчитатьСуммуНДСИВсего(СтрокаТовара, ПараметрыНДС);
		Исключение
			ЗаполнитьЗначенияСвойств(СтрокаТовара, ИсходныеСуммы);
			ВызватьИсключение;
		КонецПопытки;
		ФактическийИтог = АС_ИтогДляОкругления();
		Если ФактическийИтог = ЦелевойИтог И ЦенаИзСуммы = СтрокаТовара.Цена Тогда
			Возврат Истина;
		КонецЕсли;
		НоваяСумма = Окр(НоваяСумма + (ЦелевойИтог - ФактическийИтог) * КоэффициентСуммы, 2);
	КонецЦикла;
	ЗаполнитьЗначенияСвойств(СтрокаТовара, ИсходныеСуммы);
	Возврат Ложь;

КонецФункции

&НаКлиенте
Процедура АС_ЗапомнитьОкруглениеСтроки(СтрокаТовара, ИсходныеЗначения)

	СтрокаТовара.АС_ЦенаДоОкругленияЗН = ИсходныеЗначения.Цена;
	СтрокаТовара.АС_ЦенаПослеОкругленияЗН = СтрокаТовара.Цена;
	СтрокаТовара.АС_СкидкаДоОкругленияЗН = ИсходныеЗначения.СуммаСкидкиНаценки;
	СтрокаТовара.АС_ПроцентСкидкиДоОкругленияЗН = ИсходныеЗначения.ПроцентСкидкиНаценки;
	СтрокаТовара.АС_СкидкаПослеОкругленияЗН = СтрокаТовара.СуммаСкидкиНаценки;
	СтрокаТовара.АС_ПроцентСкидкиПослеОкругленияЗН = СтрокаТовара.ПроцентСкидкиНаценки;
	СтрокаТовара.АС_СуммаДоОкругленияЗН = ИсходныеЗначения.Сумма;
	СтрокаТовара.АС_СуммаПослеОкругленияЗН = СтрокаТовара.Сумма;
	СтрокаТовара.АС_КоличествоПриОкругленииЗН = СтрокаТовара.Количество;

КонецПроцедуры

&НаКлиенте
&Вместо("СкидкаПроцентПриИзменении")
Процедура АС_ПрименитьПроцентнуюСкидкуБезОкругления(Элемент)

	АС_СкидкаПроцентПриИзмененииПеред(Элемент);
	ИзменениеСтоимостиНачато = АС_НачатьИзменениеСтоимости();
	Попытка
		// Общая ручная скидка применяется только к товарам; работы сохраняют свои скидки.
		ЗапасыИзменениеСтрокДействие = ПредопределенноеЗначение(
			"Перечисление.ДействияГрупповогоИзмененияСтрок.УстановитьПроцентСкидкиНаценки");
		ЗапасыИзменениеСтрокОбъектИзмененийРеквизит = "ПроцентСкидкиНаценки";
		ЗапасыИзменениеСтрокЗначение = СкидкаПроцент;
		Если Объект.Запасы.Количество() > 0 Тогда
			ОбработатьТаблицу("Запасы");
		КонецЕсли;
		Модифицированность = Истина;
	Исключение
		АС_ЗавершитьИзменениеСтоимости(ИзменениеСтоимостиНачато, Ложь);
		ВызватьИсключение;
	КонецПопытки;
	АС_ЗавершитьИзменениеСтоимости(ИзменениеСтоимостиНачато);

КонецПроцедуры

&НаКлиенте
&Вместо("ОбработатьИзменениеСкидкаСумма")
Процедура АС_ПрименитьДенежнуюСкидкуБезОкругления()

	ИзменениеСтоимостиНачато = АС_НачатьИзменениеСтоимости();
	Попытка
		ВсегоТовары = Объект.Запасы.Итог("Всего");
		Если ВсегоТовары = 0 Тогда
			ВсегоТовары = Объект.Запасы.Итог("СуммаСкидкиНаценки");
		КонецЕсли;
		Если ВсегоТовары <> 0 Тогда
			ЗапасыИзменениеСтрокДействие = ПредопределенноеЗначение(
				"Перечисление.ДействияГрупповогоИзмененияСтрок.УстановитьСкидкуСуммой");
			ЗапасыИзменениеСтрокОбъектИзмененийРеквизит = "Сумма";
			ЗапасыИзменениеСтрокЗначение = СкидкаСумма;
			СтруктураОповещения = Новый Структура("СуммаДоРасчета", СкидкаСумма);
			ОбработатьТаблицу("Запасы");
			СтруктураОповещения.Вставить("СуммаПослеРасчета", СкидкаСумма);
			ЦенообразованиеКлиент.ПоказатьОповещениеПользователяОКорректировкеЦены(СтруктураОповещения);
			Модифицированность = Истина;
		КонецЕсли;
	Исключение
		АС_ЗавершитьИзменениеСтоимости(ИзменениеСтоимостиНачато, Ложь);
		ВызватьИсключение;
	КонецПопытки;
	АС_ЗавершитьИзменениеСтоимости(ИзменениеСтоимостиНачато);

КонецПроцедуры

&НаКлиенте
&Вместо("ПродолжитьОбработкуТаблицы")
Процедура АС_ИзменитьГруппуСтрокБезОкругления(ИмяТЧ, РаспределятьКакСкидку = Неопределено)

	Если АС_ЭтоМассоваяСкидкаНаРаботы(ИмяТЧ, РаспределятьКакСкидку) Тогда
		Сообщить("Массовая скидка применяется только к товарам. Скидку работы можно указать в её строке.");
		Возврат;
	КонецЕсли;

	ИзменениеСтоимостиНачато = АС_НачатьИзменениеСтоимости(Неопределено);
	Попытка
		ПродолжитьВызов(ИмяТЧ, РаспределятьКакСкидку);
	Исключение
		АС_ЗавершитьИзменениеСтоимости(ИзменениеСтоимостиНачато, Ложь);
		ВызватьИсключение;
	КонецПопытки;
	АС_ЗавершитьИзменениеСтоимости(ИзменениеСтоимостиНачато);

