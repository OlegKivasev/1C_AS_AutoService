&НаКлиенте
Функция АС_РежимОплатыТолькоБезналичный()

	Если АС_ТолькоБезналичныйРежим = Неопределено
		Или АС_КонтрагентРежимаОплаты <> Объект.Контрагент
		Или АС_ВидОперацииРежимаОплаты <> Объект.ВидОперации Тогда
		АС_ТолькоБезналичныйРежим = АС_ТолькоБезналичнаяОплатаНаСервере(Объект.ВидОперации, Объект.Контрагент);
		АС_КонтрагентРежимаОплаты = Объект.Контрагент;
		АС_ВидОперацииРежимаОплаты = Объект.ВидОперации;
	КонецЕсли;
	Возврат АС_ТолькоБезналичныйРежим;

