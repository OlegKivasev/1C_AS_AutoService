#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

&Вместо("ТекстЗапросаИнициализироватьДанныеДокументаЗаказНаряд")
Функция АС_ТекстЗапросаИнициализироватьДанныеДокументаЗаказНаряд()

	ТекстЗапроса = ПродолжитьВызов();

	// Строка должна участвовать в сумме продажи и взаиморасчетах, но не создавать
	// складское движение и потребность. Поэтому не удаляем ее из общей таблицы,
	// а обнуляем только складские количественные показатели.
	ТекстЗапроса = СтрЗаменить(
		ТекстЗапроса,
		"ЗаказНарядТовары.Количество * ВЫБОР",
		"ВЫБОР КОГДА ТИПЗНАЧЕНИЯ(ЗаказНарядТовары.Номенклатура) = ТИП(СТРОКА) ИЛИ ЗаказНарядТовары.АС_НеСписывать ТОГДА 0 ИНАЧЕ ЗаказНарядТовары.Количество КОНЕЦ * ВЫБОР");
	ТекстЗапроса = СтрЗаменить(
		ТекстЗапроса,
		"ЗаказНарядТовары.Резерв * ВЫБОР",
		"ВЫБОР КОГДА ТИПЗНАЧЕНИЯ(ЗаказНарядТовары.Номенклатура) = ТИП(СТРОКА) ИЛИ ЗаказНарядТовары.АС_НеСписывать ТОГДА 0 ИНАЧЕ ЗаказНарядТовары.Резерв КОНЕЦ * ВЫБОР");
	ТекстЗапроса = СтрЗаменить(
		ТекстЗапроса,
		"ЗаказНарядТовары.РезервОтгрузка * ВЫБОР",
		"ВЫБОР КОГДА ТИПЗНАЧЕНИЯ(ЗаказНарядТовары.Номенклатура) = ТИП(СТРОКА) ИЛИ ЗаказНарядТовары.АС_НеСписывать ТОГДА 0 ИНАЧЕ ЗаказНарядТовары.РезервОтгрузка КОНЕЦ * ВЫБОР");

	// У временной позиции в реквизите хранится строка. В таблицы движений передаем
	// пустую ссылку номенклатуры, чтобы строковое значение не попало в измерения регистров.
	ТекстЗапроса = СтрЗаменить(
		ТекстЗапроса,
		"ЗаказНарядТовары.Номенклатура КАК Номенклатура,",
		"ВЫБОР КОГДА ТИПЗНАЧЕНИЯ(ЗаказНарядТовары.Номенклатура) = ТИП(Справочник.Номенклатура) "
		+ "ТОГДА ВЫРАЗИТЬ(ЗаказНарядТовары.Номенклатура КАК Справочник.Номенклатура) "
		+ "ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка) КОНЕЦ КАК Номенклатура,");
	// Временная позиция не имеет карточки номенклатуры и, следовательно, счета учета.
	// В блокировку регистра передаем типизированную пустую ссылку, а не NULL.
	ТекстЗапроса = СтрЗаменить(
		ТекстЗапроса,
		"ЗаказНарядТовары.Номенклатура.СчетУчетаЗапасов КАК СчетУчета,",
		"ВЫБОР КОГДА ТИПЗНАЧЕНИЯ(ЗаказНарядТовары.Номенклатура) = ТИП(Справочник.Номенклатура) "
		+ "ТОГДА ВЫРАЗИТЬ(ЗаказНарядТовары.Номенклатура КАК Справочник.Номенклатура).СчетУчетаЗапасов "
		+ "ИНАЧЕ ЗНАЧЕНИЕ(ПланСчетов.Управленческий.ПустаяСсылка) КОНЕЦ КАК СчетУчета,");

	// Платная временная строка участвует в выручке и расчетах с клиентом.
	// Карточки у нее нет: используем настройки основного направления деятельности.
	// Сначала заменяем выражения счетов, затем само направление, чтобы не задеть префиксы.
	ТекстЗапроса = АС_ЗаменитьВыражениеДляВременногоТовара(
		ТекстЗапроса,
		"ЗаказНарядТовары.Номенклатура.НаправлениеДеятельности.СчетУчетаВыручкиОтПродаж",
		АС_ВыражениеСчетаОсновногоНаправления("СчетУчетаВыручкиОтПродаж", "ВыручкаОтПродаж"));
	ТекстЗапроса = АС_ЗаменитьВыражениеДляВременногоТовара(
		ТекстЗапроса,
		"ЗаказНарядТовары.Номенклатура.НаправлениеДеятельности.СчетУчетаСебестоимостиПродаж",
		АС_ВыражениеСчетаОсновногоНаправления("СчетУчетаСебестоимостиПродаж", "СебестоимостьПродаж"));
	ТекстЗапроса = АС_ЗаменитьВыражениеДляВременногоТовара(
		ТекстЗапроса,
		"ЗаказНарядТовары.Номенклатура.НаправлениеДеятельности",
		"ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ОсновноеНаправление)");
	ТекстЗапроса = АС_ЗаменитьВыражениеДляВременногоТовара(
		ТекстЗапроса,
		"ЗаказНарядТовары.Номенклатура.СчетУчетаНДСПоРеализации",
		"ЗНАЧЕНИЕ(ПланСчетов.Управленческий.Продажи_НДС)");

	// Во внутренних таблицах это услуга без склада, а не неизвестный тип NULL.
	// Иначе штатные отборы исключают строку из учета доходов.
	ТекстЗапроса = АС_ЗаменитьВыражениеДляВременногоТовара(
		ТекстЗапроса,
		"ЗаказНарядТовары.Номенклатура.ТипНоменклатуры",
		"ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)");
	ТекстЗапроса = АС_ЗаменитьВыражениеДляВременногоТовара(
		ТекстЗапроса,
		"ЗаказНарядТовары.Номенклатура.ЭтоАгентскаяУслуга",
		"ЛОЖЬ");
	ТекстЗапроса = АС_ЗаменитьВыражениеДляВременногоТовара(
		ТекстЗапроса,
		"ЗаказНарядТовары.Номенклатура.ИспользоватьСерииНоменклатуры",
		"ЛОЖЬ");
	ТекстЗапроса = АС_ЗаменитьВыражениеДляВременногоТовара(
		ТекстЗапроса,
		"ЗаказНарядТовары.Номенклатура.ПолитикаУчетаСерий",
		"ЗНАЧЕНИЕ(Справочник.ПолитикаУчетаСерий.ПустаяСсылка)");

	// Соединение добавляем после замен выражений; оно возвращает не более одной строки.
	ТекстЗапроса = СтрЗаменить(
		ТекстЗапроса,
		"Документ.ЗаказПокупателя.Запасы КАК ЗаказНарядТовары",
		"Документ.ЗаказПокупателя.Запасы КАК ЗаказНарядТовары "
		+ "ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НаправленияДеятельности КАК АС_ОсновноеНаправление "
		+ "ПО АС_ОсновноеНаправление.Ссылка = ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ОсновноеНаправление)");

	// Бонусная выборка повторно читает исходную таблицу, минуя временную таблицу товаров.
	ТекстЗапроса = СтрЗаменить(
		ТекстЗапроса,
		"ЗаказПокупателяЗапасы.Номенклатура КАК Номенклатура,",
		"ВЫБОР КОГДА ТИПЗНАЧЕНИЯ(ЗаказПокупателяЗапасы.Номенклатура) = ТИП(СТРОКА) "
		+ "ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка) "
		+ "ИНАЧЕ ЗаказПокупателяЗапасы.Номенклатура КОНЕЦ КАК Номенклатура,");

	Возврат ТекстЗапроса;

КонецФункции

Функция АС_ЗаменитьВыражениеДляВременногоТовара(ТекстЗапроса, ИсходноеВыражение, ВыражениеВременногоТовара)

	// Явное приведение сохраняет обычную ветку и защищает ее от последующих замен.
	ВыражениеНоменклатуры = СтрЗаменить(
		ИсходноеВыражение,
		"ЗаказНарядТовары.Номенклатура.",
		"ВЫРАЗИТЬ(ЗаказНарядТовары.Номенклатура КАК Справочник.Номенклатура).");
	НовоеВыражение =
		"ВЫБОР КОГДА ТИПЗНАЧЕНИЯ(ЗаказНарядТовары.Номенклатура) = ТИП(СТРОКА) "
		+ "ТОГДА " + ВыражениеВременногоТовара
		+ " ИНАЧЕ " + ВыражениеНоменклатуры + " КОНЕЦ";

	Возврат СтрЗаменить(ТекстЗапроса, ИсходноеВыражение, НовоеВыражение);

КонецФункции

Функция АС_ВыражениеСчетаОсновногоНаправления(ИмяРеквизита, ПредопределенныйСчет)

	ВыражениеСчета = "АС_ОсновноеНаправление." + ИмяРеквизита;
	ПустойСчет = "ЗНАЧЕНИЕ(ПланСчетов.Управленческий.ПустаяСсылка)";

	Возврат "ВЫБОР КОГДА ЕСТЬNULL(" + ВыражениеСчета + ", " + ПустойСчет + ") = " + ПустойСчет
		+ " ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Управленческий." + ПредопределенныйСчет + ")"
		+ " ИНАЧЕ " + ВыражениеСчета + " КОНЕЦ";

КонецФункции

&Вместо("СформироватьТаблицаПродажиЗаказНаряд")
Процедура АС_СформироватьТаблицаПродажиЗаказНаряд(
	ДокументСсылкаЗаказПокупателя, СтруктураДополнительныеСвойства)

	ПродолжитьВызов(ДокументСсылкаЗаказПокупателя, СтруктураДополнительныеСвойства);

	// Товарный регистр продаж требует карточку номенклатуры. Временные позиции
	// остаются в выручке и расчетах, но не записываются в товарную аналитику.
	ТаблицаПродажи = СтруктураДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаПродажи;
	ИндексСтроки = ТаблицаПродажи.Количество() - 1;
	Пока ИндексСтроки >= 0 Цикл
		Если Не ЗначениеЗаполнено(ТаблицаПродажи[ИндексСтроки].Номенклатура) Тогда
			ТаблицаПродажи.Удалить(ИндексСтроки);
		КонецЕсли;
		ИндексСтроки = ИндексСтроки - 1;
	КонецЦикла;

КонецПроцедуры

&Вместо("СформироватьТаблицаГрафикДвиженияЗапасовЗаказНаряд")
Процедура АС_СформироватьТаблицаГрафикДвиженияЗапасовЗаказНаряд(
	ДокументСсылкаЗаказПокупателя, СтруктураДополнительныеСвойства)

	ПродолжитьВызов(ДокументСсылкаЗаказПокупателя, СтруктураДополнительныеСвойства);

	// Временные товары не имеют ссылки на карточку номенклатуры. Их строки
	// участвуют в суммах и взаиморасчетах, но не могут быть записаны в измерение
	// регистра "График движения запасов". Удаляем только такие строки из графика.
	ТаблицаГрафик = СтруктураДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаГрафикДвиженияЗапасов;
	ИндексСтроки = ТаблицаГрафик.Количество() - 1;
	Пока ИндексСтроки >= 0 Цикл
		Если Не ЗначениеЗаполнено(ТаблицаГрафик[ИндексСтроки].Номенклатура) Тогда
			ТаблицаГрафик.Удалить(ИндексСтроки);
		КонецЕсли;
		ИндексСтроки = ИндексСтроки - 1;
	КонецЦикла;

КонецПроцедуры

&Вместо("СформироватьТаблицаЗаказыПокупателейЗаказНаряд")
Процедура АС_СформироватьТаблицаЗаказыПокупателейЗаказНаряд(
	ДокументСсылкаЗаказПокупателя, СтруктураДополнительныеСвойства)

	ПродолжитьВызов(ДокументСсылкаЗаказПокупателя, СтруктураДополнительныеСвойства);

	// Временный товар не имеет ссылки на карточку номенклатуры и не может быть
	// записан в измерение регистра "Заказы покупателей".
	ТаблицаЗаказыПокупателей = СтруктураДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаЗаказыПокупателей;
	ИндексСтроки = ТаблицаЗаказыПокупателей.Количество() - 1;
	Пока ИндексСтроки >= 0 Цикл
		Если Не ЗначениеЗаполнено(ТаблицаЗаказыПокупателей[ИндексСтроки].Номенклатура) Тогда
			ТаблицаЗаказыПокупателей.Удалить(ИндексСтроки);
		КонецЕсли;
		ИндексСтроки = ИндексСтроки - 1;
	КонецЦикла;

КонецПроцедуры

#КонецЕсли

&После("ДобавитьКомандыСозданияНаОсновании")
Процедура АС_ДобавитьКомандыСозданияНаОснованииПосле(КомандыСозданияНаОсновании, Параметры)

	Для Каждого Команда Из КомандыСозданияНаОсновании Цикл
		Если Команда.Идентификатор = "ФормаДокументПоступлениеНаСчетСоздатьНаОсновании" Тогда
			Команда.Обработчик = "АС_ПлатежиЗаказовКлиент.ПоступлениеНаСчетИзЗаказа";
			Прервать;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры
