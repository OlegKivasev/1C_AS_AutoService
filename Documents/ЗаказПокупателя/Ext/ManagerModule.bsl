#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

&Вместо("ТекстЗапросаИнициализироватьДанныеДокументаЗаказНаряд")
Функция АС_ТекстЗапросаИнициализироватьДанныеДокументаЗаказНаряд()

	ТекстЗапроса = ПродолжитьВызов();

	// Строка должна участвовать в сумме продажи и взаиморасчетах, но не создавать
	// складское движение и потребность. Поэтому не удаляем ее из общей таблицы,
	// а обнуляем только складские количественные показатели.
	ТекстЗапроса = СтрЗаменить(
		ТекстЗапроса,
		"ЗаказНарядТовары.Количество * ВЫБОР",
		"ВЫБОР КОГДА ЗаказНарядТовары.АС_НеСписывать ТОГДА 0 ИНАЧЕ ЗаказНарядТовары.Количество КОНЕЦ * ВЫБОР");
	ТекстЗапроса = СтрЗаменить(
		ТекстЗапроса,
		"ЗаказНарядТовары.Резерв * ВЫБОР",
		"ВЫБОР КОГДА ЗаказНарядТовары.АС_НеСписывать ТОГДА 0 ИНАЧЕ ЗаказНарядТовары.Резерв КОНЕЦ * ВЫБОР");
	ТекстЗапроса = СтрЗаменить(
		ТекстЗапроса,
		"ЗаказНарядТовары.РезервОтгрузка * ВЫБОР",
		"ВЫБОР КОГДА ЗаказНарядТовары.АС_НеСписывать ТОГДА 0 ИНАЧЕ ЗаказНарядТовары.РезервОтгрузка КОНЕЦ * ВЫБОР");

	// У временной позиции в реквизите хранится строка. В таблицы движений передаем
	// пустую ссылку номенклатуры, чтобы строковое значение не попало в измерения регистров.
	ТекстЗапроса = СтрЗаменить(
		ТекстЗапроса,
		"ЗаказНарядТовары.Номенклатура КАК Номенклатура,",
		"ВЫБОР КОГДА ТИПЗНАЧЕНИЯ(ЗаказНарядТовары.Номенклатура) = ТИП(Справочник.Номенклатура) "
		+ "ТОГДА ВЫРАЗИТЬ(ЗаказНарядТовары.Номенклатура КАК Справочник.Номенклатура) "
		+ "ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка) КОНЕЦ КАК Номенклатура,");

	Возврат ТекстЗапроса;

КонецФункции

#КонецЕсли
