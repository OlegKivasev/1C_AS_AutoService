#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

&Перед("ОбработкаПроверкиЗаполнения")
Процедура АС_ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если ВидОперации <> Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаряд Тогда
		Возврат;
	КонецЕсли;

	// Штатная проверка заполнения не допускает нулевую сумму строки при включенных скидках.
	// На время проверки подставляем минимальную сумму, после проверки она снова обнуляется.
	Для Каждого СтрокаЗапаса Из Запасы Цикл
		Если СтрокаЗапаса.АС_НеУчитывать И СтрокаЗапаса.Сумма = 0 Тогда
			СтрокаЗапаса.Сумма = 0.01;
		КонецЕсли;
	КонецЦикла;

	Если ЭтоНовый()
		ИЛИ АС_ТребоватьИсполнителя Тогда
		Возврат;
	КонецЕсли;

	ПроверяемыйРеквизит = ПроверяемыеРеквизиты.Найти("Работы.АС_Исполнитель");
	Если ПроверяемыйРеквизит <> Неопределено Тогда
		ПроверяемыеРеквизиты.Удалить(ПроверяемыйРеквизит);
	КонецЕсли;

КонецПроцедуры

&После("ОбработкаПроверкиЗаполнения")
Процедура АС_ОбработкаПроверкиЗаполненияПосле(Отказ, ПроверяемыеРеквизиты)

	АС_ОбнулитьСуммыНеучитываемыхЗапасов();

КонецПроцедуры

&Перед("ПередЗаписью")
Процедура АС_ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если Не АС_ПроверитьПравоИзмененияЗапретаСкидки() Тогда
		Отказ = Истина;
		ОбщегоНазначения.СообщитьПользователю(
			"Установить или снять флажок «Без скидки» может только администратор.", ЭтотОбъект);
		Возврат;
	КонецЕсли;
	Если Не ТабличныеЧастиУНФКлиентСервер.АС_НормализоватьСкидкиЗаказа(ЭтотОбъект) Тогда
		Отказ = Истина;
		ОбщегоНазначения.СообщитьПользователю(
			"Перед записью пересчитайте автоматические скидки: совпали ключи товара и работы.", ЭтотОбъект);
		Возврат;
	КонецЕсли;

	ПричинаЗапретаИзменения = "";
	Если АС_ИзменениеЗаказНарядаСотрудникомЗапрещено(ПричинаЗапретаИзменения) Тогда
		Отказ = Истина;
		ОбщегоНазначения.СообщитьПользователю(ПричинаЗапретаИзменения, ЭтотОбъект);
		Возврат;
	КонецЕсли;

	АС_ЗаполнитьФинишПриЗавершении();
	АС_ОбнулитьСуммыНеучитываемыхЗапасов();

	Если ЭтоНовый() Тогда
		АС_ТребоватьИсполнителя = Истина;
	КонецЕсли;

КонецПроцедуры

&После("ОбработкаЗаполнения")
Процедура АС_ПослеЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)

	АС_ИнициализироватьДатыЗаказНаряда();

КонецПроцедуры

&После("ПриКопировании")
Процедура АС_ПослеКопирования(ОбъектКопирования)

	// Доверенный снимок исходного документа разрешает сохранить скопированные
	// запреты, но не позволяет сотруднику самостоятельно изменить их в копии.
	ДополнительныеСвойства.Вставить("АС_ЗапретыСкидокПриКопировании",
		ОбъектКопирования.Запасы.Выгрузить());

	АС_ИнициализироватьДатыЗаказНаряда();

КонецПроцедуры

Процедура АС_ИнициализироватьДатыЗаказНаряда()

	Если ОбменДанными.Загрузка
		Или ВидОперации <> Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаряд Тогда
		Возврат;
	КонецЕсли;
	Старт = ТекущаяДатаСеанса();
	Финиш = КонецДня(Старт);
	АС_ДатаФинишаВручную = Дата(1, 1, 1);
	АС_ДатаОплатыВручную = Дата(1, 1, 1);

КонецПроцедуры

Процедура АС_ЗаполнитьФинишПриЗавершении()

	Если ОбменДанными.Загрузка
		Или ВидОперации <> Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаряд Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Старт) Тогда
		Старт = ТекущаяДатаСеанса();
	КонецЕсли;
	Если ЗначениеЗаполнено(АС_ДатаФинишаВручную) Тогда
		Финиш = АС_ДатаФинишаВручную;
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Финиш) Тогда
		Финиш = КонецДня(Старт);
	КонецЕсли;
	Если СостояниеЗаказа <> Справочники.СостоянияЗаказНарядов.Завершен Тогда
		Возврат;
	КонецЕсли;
	ПредыдущееСостояние = Неопределено;
	Если Не ЭтоНовый() Тогда
		ПредыдущееСостояние = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "СостояниеЗаказа");
	КонецЕсли;
	// Повторная запись и перепроведение сохраняют уже зафиксированную дату завершения.
	Если ПредыдущееСостояние <> Справочники.СостоянияЗаказНарядов.Завершен Тогда
		Финиш = ТекущаяДатаСеанса();
	КонецЕсли;

КонецПроцедуры

Процедура АС_ОбнулитьСуммыНеучитываемыхЗапасов()

	Если ВидОперации <> Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаряд Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаЗапаса Из Запасы Цикл
		Если Не СтрокаЗапаса.АС_НеУчитывать Тогда
			Продолжить;
		КонецЕсли;

		СтрокаЗапаса.Сумма = 0;
		СтрокаЗапаса.СуммаНДС = 0;
		СтрокаЗапаса.Всего = 0;
		СтрокаЗапаса.СуммаСкидкиНаценки = 0;
		СтрокаЗапаса.СуммаАвтоматическойСкидки = 0;
		СтрокаЗапаса.СуммаСкидкиОплатыБонусом = 0;
	КонецЦикла;

КонецПроцедуры

Функция АС_ИзменениеЗаказНарядаСотрудникомЗапрещено(ПричинаЗапретаИзменения)

	Если ОбменДанными.Загрузка
		Или ВидОперации <> Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаряд
		Или Пользователи.ЭтоПолноправныйПользователь() Тогда
		Возврат Ложь;
	КонецЕсли;

	ЗаказФизическогоЛица = АС_КонтрагентФизическоеЛицо(Контрагент);
	Если ЭтоНовый() Тогда
		Если ЗаказФизическогоЛица Тогда
			Возврат Ложь;
		КонецЕсли;
		Если СостояниеЗаказа = Справочники.СостоянияЗаказНарядов.Завершен Тогда
			ПричинаЗапретаИзменения =
				"Сотрудник может завершить заказ-наряд только из состояния ""Готов к отправке"".";
			Возврат Истина;
		ИначеЕсли АС_ЭтоСостояниеГотовКОтправке(СостояниеЗаказа) Тогда
			ПричинаЗапретаИзменения =
				"Состояние ""Готов к отправке"" после проверки устанавливает администратор.";
			Возврат Истина;
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;

	СохраненныйЗаказ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Ссылка, "СостояниеЗаказа,Проведен,Контрагент");
	ПредыдущееСостояние = СохраненныйЗаказ.СостояниеЗаказа;
	ПредыдущийДокументПроведен = СохраненныйЗаказ.Проведен;

	Если ПредыдущееСостояние = Справочники.СостоянияЗаказНарядов.Завершен Тогда
		ПричинаЗапретаИзменения =
			"Изменять завершенный заказ-наряд может только администратор.";
		Возврат Истина;
	КонецЕсли;

	// Для физлиц проверка и отправка документов не являются этапами завершения.
	Если ЗаказФизическогоЛица И АС_КонтрагентФизическоеЛицо(СохраненныйЗаказ.Контрагент) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если СостояниеЗаказа = Справочники.СостоянияЗаказНарядов.Завершен
		И Не АС_ЭтоСостояниеГотовКОтправке(ПредыдущееСостояние) Тогда
		ПричинаЗапретаИзменения =
			"Сотрудник может завершить заказ-наряд только из состояния ""Готов к отправке"".";
		Возврат Истина;
	КонецЕсли;

	Если АС_ЭтоСостояниеГотовКОтправке(ПредыдущееСостояние)
		И СостояниеЗаказа <> ПредыдущееСостояние
		И СостояниеЗаказа <> Справочники.СостоянияЗаказНарядов.Завершен Тогда
		ПричинаЗапретаИзменения =
			"Из состояния ""Готов к отправке"" сотрудник может перейти только в состояние ""Завершен"".";
		Возврат Истина;
	КонецЕсли;

	Если СостояниеЗаказа <> ПредыдущееСостояние
		И Не АС_ЭтоСостояниеГотовКОтправке(ПредыдущееСостояние)
		И Не АС_ЭтоСостояниеГотовКПроверке(СостояниеЗаказа) Тогда
		ПричинаЗапретаИзменения =
			"Сотрудник может самостоятельно установить только состояние ""Готов к проверке"".";
		Возврат Истина;
	КонецЕсли;

	Если ПредыдущийДокументПроведен
		И АС_ЭтоСостояниеГотовКПроверке(ПредыдущееСостояние) Тогда
		ПричинаЗапретаИзменения =
			"Заказ-наряд находится в состоянии ""Готов к проверке"". Изменять его может только администратор.";
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

Функция АС_КонтрагентФизическоеЛицо(Контрагент)

	Возврат ЗначениеЗаполнено(Контрагент)
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контрагент, "ВидКонтрагента")
			= Перечисления.ВидыКонтрагентов.ФизическоеЛицо;

КонецФункции

Функция АС_ЭтоСостояниеГотовКПроверке(Состояние)

	Возврат ЗначениеЗаполнено(Состояние)
		И ВРег(СокрЛП(Строка(Состояние))) = ВРег("Готов к проверке");

КонецФункции

Функция АС_ЭтоСостояниеГотовКОтправке(Состояние)

	Возврат ЗначениеЗаполнено(Состояние)
		И ВРег(СокрЛП(Строка(Состояние))) = ВРег("Готов к отправке");

КонецФункции

Функция АС_ПроверитьПравоИзмененияЗапретаСкидки()

	Если Пользователи.ЭтоПолноправныйПользователь() Тогда
		Возврат Истина;
	КонецЕсли;
	СохраненныеЗапасы = Неопределено;
	Если ЭтоНовый() Тогда
		ДополнительныеСвойства.Свойство("АС_ЗапретыСкидокПриКопировании", СохраненныеЗапасы);
	Иначе
		СохраненныеЗапасы = Ссылка.ПолучитьОбъект().Запасы.Выгрузить();
	КонецЕсли;
	Для Каждого СтрокаЗапаса Из Запасы Цикл
		ПрежнийЗапрет = Ложь;
		Если СохраненныеЗапасы <> Неопределено Тогда
			СохраненныеСтроки = СохраненныеЗапасы.НайтиСтроки(
				Новый Структура("КлючСвязи", СтрокаЗапаса.КлючСвязи));
			ТекущиеСтроки = Запасы.НайтиСтроки(
				Новый Структура("КлючСвязи", СтрокаЗапаса.КлючСвязи));
			Если ЗначениеЗаполнено(СтрокаЗапаса.КлючСвязи)
				И СохраненныеСтроки.Количество() <= 1 И ТекущиеСтроки.Количество() = 1 Тогда
				Если СохраненныеСтроки.Количество() = 1 Тогда
					ПрежнийЗапрет = СохраненныеСтроки[0].АС_БезСкидки;
				КонецЕсли;
			Иначе
				// Старые пустые/неуникальные ключи не схлопываем в соответствие.
				// Для них допускается только однозначное совпадение исходной строки.
				СохраненныеСтроки = СохраненныеЗапасы.НайтиСтроки(Новый Структура(
					"НомерСтроки,Номенклатура,Характеристика", СтрокаЗапаса.НомерСтроки,
					СтрокаЗапаса.Номенклатура, СтрокаЗапаса.Характеристика));
				Если СохраненныеСтроки.Количество() = 1 Тогда
					ПрежнийЗапрет = СохраненныеСтроки[0].АС_БезСкидки;
				Иначе
					Для Каждого ПрежняяСтрока Из СохраненныеЗапасы.НайтиСтроки(
						Новый Структура("КлючСвязи", СтрокаЗапаса.КлючСвязи)) Цикл
						Если ПрежняяСтрока.АС_БезСкидки Тогда
							Возврат Ложь;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если СтрокаЗапаса.АС_БезСкидки <> ПрежнийЗапрет Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

#КонецЕсли
