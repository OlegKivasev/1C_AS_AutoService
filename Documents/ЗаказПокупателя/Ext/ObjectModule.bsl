#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

&Перед("ОбработкаПроверкиЗаполнения")
Процедура АС_ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если ВидОперации <> Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаряд
		ИЛИ ЭтоНовый()
		ИЛИ АС_ТребоватьИсполнителя Тогда
		Возврат;
	КонецЕсли;

	ПроверяемыйРеквизит = ПроверяемыеРеквизиты.Найти("Работы.АС_Исполнитель");
	Если ПроверяемыйРеквизит <> Неопределено Тогда
		ПроверяемыеРеквизиты.Удалить(ПроверяемыйРеквизит);
	КонецЕсли;

КонецПроцедуры

&Перед("ПередЗаписью")
Процедура АС_ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	ПричинаЗапретаИзменения = "";
	Если АС_ИзменениеЗаказНарядаСотрудникомЗапрещено(ПричинаЗапретаИзменения) Тогда
		Отказ = Истина;
		ОбщегоНазначения.СообщитьПользователю(ПричинаЗапретаИзменения, ЭтотОбъект);
		Возврат;
	КонецЕсли;

	Если ЭтоНовый() Тогда
		АС_ТребоватьИсполнителя = Истина;
	КонецЕсли;

КонецПроцедуры

Функция АС_ИзменениеЗаказНарядаСотрудникомЗапрещено(ПричинаЗапретаИзменения)

	Если ОбменДанными.Загрузка
		Или ВидОперации <> Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаряд
		Или Пользователи.ЭтоПолноправныйПользователь() Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ЭтоНовый() Тогда
		Если СостояниеЗаказа = Справочники.СостоянияЗаказНарядов.Завершен Тогда
			ПричинаЗапретаИзменения =
				"Сотрудник может завершить заказ-наряд только из состояния ""Готов к отправке"".";
			Возврат Истина;
		ИначеЕсли АС_ЭтоСостояниеГотовКОтправке(СостояниеЗаказа) Тогда
			ПричинаЗапретаИзменения =
				"Состояние ""Готов к отправке"" после проверки устанавливает администратор.";
			Возврат Истина;
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;

	ПредыдущееСостояние = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "СостояниеЗаказа");
	ПредыдущийДокументПроведен = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Проведен");

	Если ПредыдущееСостояние = Справочники.СостоянияЗаказНарядов.Завершен Тогда
		ПричинаЗапретаИзменения =
			"Изменять завершенный заказ-наряд может только администратор.";
		Возврат Истина;
	КонецЕсли;

	Если СостояниеЗаказа = Справочники.СостоянияЗаказНарядов.Завершен
		И Не АС_ЭтоСостояниеГотовКОтправке(ПредыдущееСостояние) Тогда
		ПричинаЗапретаИзменения =
			"Сотрудник может завершить заказ-наряд только из состояния ""Готов к отправке"".";
		Возврат Истина;
	КонецЕсли;

	Если АС_ЭтоСостояниеГотовКОтправке(ПредыдущееСостояние)
		И СостояниеЗаказа <> ПредыдущееСостояние
		И СостояниеЗаказа <> Справочники.СостоянияЗаказНарядов.Завершен Тогда
		ПричинаЗапретаИзменения =
			"Из состояния ""Готов к отправке"" сотрудник может перейти только в состояние ""Завершен"".";
		Возврат Истина;
	КонецЕсли;

	Если СостояниеЗаказа <> ПредыдущееСостояние
		И Не АС_ЭтоСостояниеГотовКОтправке(ПредыдущееСостояние)
		И Не АС_ЭтоСостояниеГотовКПроверке(СостояниеЗаказа) Тогда
		ПричинаЗапретаИзменения =
			"Сотрудник может самостоятельно установить только состояние ""Готов к проверке"".";
		Возврат Истина;
	КонецЕсли;

	Если ПредыдущийДокументПроведен
		И АС_ЭтоСостояниеГотовКПроверке(ПредыдущееСостояние) Тогда
		ПричинаЗапретаИзменения =
			"Заказ-наряд находится в состоянии ""Готов к проверке"". Изменять его может только администратор.";
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

Функция АС_ЭтоСостояниеГотовКПроверке(Состояние)

	Возврат ЗначениеЗаполнено(Состояние)
		И ВРег(СокрЛП(Строка(Состояние))) = ВРег("Готов к проверке");

КонецФункции

Функция АС_ЭтоСостояниеГотовКОтправке(Состояние)

	Возврат ЗначениеЗаполнено(Состояние)
		И ВРег(СокрЛП(Строка(Состояние))) = ВРег("Готов к отправке");

КонецФункции

#КонецЕсли
