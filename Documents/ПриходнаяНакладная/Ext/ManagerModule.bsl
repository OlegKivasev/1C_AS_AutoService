&После("ДобавитьКомандыПечати")
Процедура АС_ДобавитьКомандыПечатиПосле(КомандыПечати)

	Отбор = Новый Структура(
		"Идентификатор",
		"ПечатьЭтикетокИзПриходнойНакладной");
	Для Каждого КомандаПечати Из КомандыПечати.НайтиСтроки(Отбор) Цикл
		КомандаПечати.Обработчик =
			"АС_ПечатьЭтикетокКлиент.ПечатьЭтикетокИзПриходнойНакладной";
	КонецЦикла;

КонецПроцедуры
