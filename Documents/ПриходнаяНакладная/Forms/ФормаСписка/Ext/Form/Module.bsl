&НаСервереБезКонтекста
Функция АС_ПолучитьСоставЗаказаПоставщику(ЗаказПоставщику)
	
	СоставЗаказа = Новый СписокЗначений;
	Если Не ЗначениеЗаполнено(ЗаказПоставщику) Тогда
		Возврат СоставЗаказа;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|  Запасы.НомерСтроки КАК НомерСтроки,
	|  Запасы.Номенклатура.Артикул КАК Артикул,
	|  Запасы.Номенклатура.Наименование КАК Наименование,
	|  Запасы.Количество КАК Количество
	|ИЗ
	|  Документ.ЗаказПоставщику.Запасы КАК Запасы
	|ГДЕ
	|  Запасы.Ссылка = &ЗаказПоставщику
	|  И Запасы.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)
	|
	|УПОРЯДОЧИТЬ ПО
	|  НомерСтроки";
	Запрос.УстановитьПараметр("ЗаказПоставщику", ЗаказПоставщику);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Артикул = СокрЛП(Выборка.Артикул);
		Количество = СокрЛП(Строка(Выборка.Количество)) + " шт.";
		Если ПустаяСтрока(Артикул) Тогда
			ТекстСтроки = СтрШаблон("%1 | %2",
				Выборка.Наименование,
				Количество);
		Иначе
			ТекстСтроки = СтрШаблон("%1 | %2 | %3",
				Артикул,
				Выборка.Наименование,
				Количество);
		КонецЕсли;
		СоставЗаказа.Добавить(ТекстСтроки, ТекстСтроки);
	КонецЦикла;
	
	Возврат СоставЗаказа;
	
КонецФункции
