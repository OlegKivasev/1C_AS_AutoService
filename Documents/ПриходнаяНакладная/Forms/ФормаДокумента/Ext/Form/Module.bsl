&НаКлиенте
Перем АС_ПроведениеПодтверждено;

&НаКлиенте
Перем АС_ОтменаВозвратаПереданаВЗаказ;

&НаКлиенте
&Перед("ПередЗаписью")
Процедура АС_ПередЗаписьюПеред(Отказ, ПараметрыЗаписи)

	Если ПараметрыЗаписи.РежимЗаписи <> РежимЗаписиДокумента.Проведение Тогда
		Возврат;
	КонецЕсли;

	Если АС_ПроведениеПодтверждено = Истина Тогда
		АС_ПроведениеПодтверждено = Ложь;
		Возврат;
	КонецЕсли;

	Если АС_ЭтоВозвратПокупателяИзЗаказа() Тогда
		АС_ПередатьОтменуТоваровПоВозвратуПокупателя();
		Возврат;
	КонецЕсли;

	Если АС_ЕстьПрисоединенныеФайлы(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;

	Отказ = Истина;
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить(КодВозвратаДиалога.ОК, "Отсканирован");
	Кнопки.Добавить(КодВозвратаДиалога.Отмена, "Не отсканирован");
	ПоказатьВопрос(
		Новый ОписаниеОповещения("АС_ПодтверждениеСканированияНакладнойЗавершение", ЭтотОбъект),
		"Бумажный вариант приходной накладной отсканирован?",
		Кнопки);

КонецПроцедуры

&НаКлиенте
Процедура АС_ПередатьОтменуТоваровПоВозвратуПокупателя()

	Если АС_ОтменаВозвратаПереданаВЗаказ = Истина
		Или Не АС_ЭтоВозвратПокупателяИзЗаказа() Тогда
		Возврат;
	КонецЕсли;

	СтрокиОтмены = АС_ПолучитьСтрокиОтменыВозвратаПокупателя();
	Если СтрокиОтмены.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	АС_ОтменаВозвратаПереданаВЗаказ = Истина;
	ДанныеОтмены = Новый Структура("ЗаказПокупателя,Строки",
		Объект.ДокументОснование,
		СтрокиОтмены);
	Оповестить("АС_ОтменитьТоварыПоВозвратуПокупателя", ДанныеОтмены);

	ПараметрыФормыЗаказа = Новый Структура;
	ПараметрыФормыЗаказа.Вставить("Ключ", Объект.ДокументОснование);
	ПараметрыФормыЗаказа.Вставить(
		"АС_СтрокиОтменыВозвратаПокупателя", СтрокиОтмены);
	ОткрытьФорму(АС_ПолучитьИмяФормыЗаказаПокупателяНаСервере(), ПараметрыФормыЗаказа);

КонецПроцедуры

&НаКлиенте
Функция АС_ЭтоВозвратПокупателяИзЗаказа()

	Возврат Объект.ВидОперации = ПредопределенноеЗначение(
		"Перечисление.ВидыОперацийПриходнаяНакладная.ВозвратОтПокупателя")
		И ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ЗаказПокупателя");

КонецФункции

&НаКлиенте
Функция АС_ПолучитьСтрокиОтменыВозвратаПокупателя()

	Результат = Новый Массив;

	Для Каждого СтрокаВозврата Из Объект.Запасы Цикл
		Если Не ЗначениеЗаполнено(СтрокаВозврата.Номенклатура)
			Или СтрокаВозврата.Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;

		СтрокаОтмены = Новый Структура("Номенклатура,Характеристика,Цена,Количество");
		СтрокаОтмены.Номенклатура = СтрокаВозврата.Номенклатура;
		СтрокаОтмены.Характеристика = СтрокаВозврата.Характеристика;
		СтрокаОтмены.Цена = СтрокаВозврата.Цена;
		СтрокаОтмены.Количество = СтрокаВозврата.Количество;
		Результат.Добавить(СтрокаОтмены);
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервере
Функция АС_ПолучитьИмяФормыЗаказаПокупателяНаСервере()

	ЗаказПокупателяОбъект = Объект.ДокументОснование.ПолучитьОбъект();
	Если ЗаказПокупателяОбъект.ВидОперации = ПредопределенноеЗначение(
			"Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаряд") Тогда
		Возврат "Документ.ЗаказПокупателя.Форма.ФормаЗаказНаряда";
	КонецЕсли;

	Возврат "Документ.ЗаказПокупателя.Форма.ФормаДокумента";

КонецФункции

&НаСервереБезКонтекста
Функция АС_ЕстьПрисоединенныеФайлы(СсылкаНаДокумент) Экспорт

	Если Не ЗначениеЗаполнено(СсылкаНаДокумент) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат РаботаСФайламиСлужебныйВызовСервера.КоличествоПрисоединенныхФайлов(СсылкаНаДокумент) > 0;

КонецФункции

&НаКлиенте
Процедура АС_ПодтверждениеСканированияНакладнойЗавершение(Результат, Параметры) Экспорт

	Если Результат <> КодВозвратаДиалога.ОК Тогда
		Возврат;
	КонецЕсли;

	АС_ПроведениеПодтверждено = Истина;
	Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));

КонецПроцедуры
