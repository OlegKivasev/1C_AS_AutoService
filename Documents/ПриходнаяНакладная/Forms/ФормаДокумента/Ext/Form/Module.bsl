&НаКлиенте
Перем АС_ПроведениеПодтверждено;

&НаКлиенте
Перем АС_УведомлениеОПоступленииПодтверждено;

&НаКлиенте
Перем АС_ОтменаВозвратаПереданаВЗаказ;

&НаКлиенте
&Перед("ПередЗаписью")
Процедура АС_ПередЗаписьюПеред(Отказ, ПараметрыЗаписи)

	Если ПараметрыЗаписи.РежимЗаписи <> РежимЗаписиДокумента.Проведение Тогда
		Возврат;
	КонецЕсли;

	Если АС_ПроведениеПодтверждено = Истина Тогда
		АС_ПроведениеПодтверждено = Ложь;
		Возврат;
	КонецЕсли;

	Если АС_УведомлениеОПоступленииПодтверждено = Истина Тогда
		АС_УведомлениеОПоступленииПодтверждено = Ложь;
	Иначе
		ТекстУведомления = АС_ПолучитьТекстУведомленияОПоступленииТовараНаСервере();
		Если Не ПустаяСтрока(ТекстУведомления) Тогда
			Отказ = Истина;
			ПоказатьПредупреждение(
				Новый ОписаниеОповещения("АС_УведомлениеОПоступленииТовараЗавершение", ЭтотОбъект),
				ТекстУведомления,
				,
				"Уведомление клиентов");
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Если АС_ЭтоВозвратПокупателяИзЗаказа() Тогда
		АС_ПередатьОтменуТоваровПоВозвратуПокупателя();
		Возврат;
	КонецЕсли;

	Если АС_ЕстьПрисоединенныеФайлы(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;

	Отказ = Истина;
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить(КодВозвратаДиалога.ОК, "Отсканирован");
	Кнопки.Добавить(КодВозвратаДиалога.Отмена, "Не отсканирован");
	ПоказатьВопрос(
		Новый ОписаниеОповещения("АС_ПодтверждениеСканированияНакладнойЗавершение", ЭтотОбъект),
		"Бумажный вариант приходной накладной отсканирован?",
		Кнопки);

КонецПроцедуры

&НаКлиенте
Процедура АС_УведомлениеОПоступленииТовараЗавершение(ДополнительныеПараметры) Экспорт

	АС_УведомлениеОПоступленииПодтверждено = Истина;
	Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));

КонецПроцедуры

&НаСервере
Функция АС_ПолучитьТекстУведомленияОПоступленииТовараНаСервере()

	ГруппыПоЗаказамПокупателей = Новый Соответствие;
	ПорядокЗаказовПокупателей = Новый Массив;
	ЗаказПоставщикуИзШапки = Объект.Заказ;

	Для Каждого СтрокаПоступления Из Объект.Запасы Цикл
		Если Не ЗначениеЗаполнено(СтрокаПоступления.Номенклатура)
			Или СтрокаПоступления.Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;

		ЗаказПокупателя = АС_ПолучитьЗаказПокупателяПоСтрокеПоступленияНаСервере(
			СтрокаПоступления, ЗаказПоставщикуИзШапки);
		Если Не ЗначениеЗаполнено(ЗаказПокупателя) Тогда
			Продолжить;
		КонецЕсли;

		ГруппаПокупателя = ГруппыПоЗаказамПокупателей.Получить(ЗаказПокупателя);
		Если ГруппаПокупателя = Неопределено Тогда
			ДанныеАвтомобиля = АС_ПолучитьДанныеАвтомобиляЗаказаПокупателяНаСервере(ЗаказПокупателя);
			ГруппаПокупателя = Новый Структура("Автомобиль,ГосНомер,Телефон,Имя,Товары",
				ДанныеАвтомобиля.Автомобиль,
				ДанныеАвтомобиля.ГосНомер,
				ДанныеАвтомобиля.Телефон,
				ДанныеАвтомобиля.Имя,
				Новый Массив);
			ГруппыПоЗаказамПокупателей.Вставить(ЗаказПокупателя, ГруппаПокупателя);
			ПорядокЗаказовПокупателей.Добавить(ЗаказПокупателя);
		КонецЕсли;

		ПредставлениеТовара = Строка(СтрокаПоступления.Номенклатура);
		ПредставлениеКоличества = Строка(СтрокаПоступления.Количество);
		Если ЗначениеЗаполнено(СтрокаПоступления.ЕдиницаИзмерения) Тогда
			ПредставлениеКоличества = ПредставлениеКоличества
				+ " " + Строка(СтрокаПоступления.ЕдиницаИзмерения);
		КонецЕсли;
		ГруппаПокупателя.Товары.Добавить(ПредставлениеТовара + " — " + ПредставлениеКоличества);
	КонецЦикла;

	Если ПорядокЗаказовПокупателей.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Текст = "Не забудьте уведомить клиентов о приходе товара.";
	Для Каждого ЗаказПокупателя Из ПорядокЗаказовПокупателей Цикл
		ГруппаПокупателя = ГруппыПоЗаказамПокупателей.Получить(ЗаказПокупателя);
		Текст = Текст + Символы.ПС + Символы.ПС;
		Если ПустаяСтрока(ГруппаПокупателя.Автомобиль) Тогда
			Текст = Текст + "Автомобиль: не указан";
		Иначе
			Текст = Текст + "Автомобиль: " + ГруппаПокупателя.Автомобиль;
		КонецЕсли;
		Если Не ПустаяСтрока(ГруппаПокупателя.ГосНомер) Тогда
			Текст = Текст + Символы.ПС + "Гос. номер: " + ГруппаПокупателя.ГосНомер;
		КонецЕсли;
		Если Не ПустаяСтрока(ГруппаПокупателя.Телефон) Тогда
			Текст = Текст + Символы.ПС + "Телефон: " + ГруппаПокупателя.Телефон;
		КонецЕсли;
		Если Не ПустаяСтрока(ГруппаПокупателя.Имя) Тогда
			Текст = Текст + Символы.ПС + "Имя: " + ГруппаПокупателя.Имя;
		КонецЕсли;
		Текст = Текст + Символы.ПС + "Товары:";
		Для Каждого ПредставлениеТовара Из ГруппаПокупателя.Товары Цикл
			Текст = Текст + Символы.ПС + "- " + ПредставлениеТовара;
		КонецЦикла;
	КонецЦикла;

	Возврат Текст;

КонецФункции

&НаСервере
Функция АС_ПолучитьЗаказПокупателяПоСтрокеПоступленияНаСервере(
	СтрокаПоступления, ЗаказПоставщикуИзШапки)

	ЗаказПоставщику = СтрокаПоступления.Заказ;
	Если ТипЗнч(ЗаказПоставщику) <> Тип("ДокументСсылка.ЗаказПоставщику") Тогда
		ЗаказПоставщику = ЗаказПоставщикуИзШапки;
	КонецЕсли;
	Если ТипЗнч(ЗаказПоставщику) <> Тип("ДокументСсылка.ЗаказПоставщику") Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЗаказПоставщикуОбъект = ЗаказПоставщику.ПолучитьОбъект();
	Если ЗначениеЗаполнено(ЗаказПоставщикуОбъект.ЗаказПокупателя) Тогда
		Возврат ЗаказПоставщикуОбъект.ЗаказПокупателя;
	КонецЕсли;

	Для Каждого СтрокаЗаказаПоставщику Из ЗаказПоставщикуОбъект.Запасы Цикл
		Если СтрокаЗаказаПоставщику.Номенклатура = СтрокаПоступления.Номенклатура
			И СтрокаЗаказаПоставщику.Характеристика = СтрокаПоступления.Характеристика
			И ЗначениеЗаполнено(СтрокаЗаказаПоставщику.ЗаказПокупателя) Тогда
			Возврат СтрокаЗаказаПоставщику.ЗаказПокупателя;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

&НаСервере
Функция АС_ПолучитьДанныеАвтомобиляЗаказаПокупателяНаСервере(ЗаказПокупателя)

	Результат = Новый Структура("Автомобиль,ГосНомер,Телефон,Имя", "", "", "", "");
	ЗаказПокупателяОбъект = ЗаказПокупателя.ПолучитьОбъект();

	Если ЗначениеЗаполнено(ЗаказПокупателяОбъект.Договор) Тогда
		ДоговорОбъект = ЗаказПокупателяОбъект.Договор.ПолучитьОбъект();
		Результат.Автомобиль = АС_СформироватьНаименованиеАвтомобиляНаСервере(
			ДоговорОбъект.АС_МаркаАвтомобиляИзСправочника,
			ДоговорОбъект.АС_МодельАвтомобиляИзСправочника);
		Результат.ГосНомер = СокрЛП(ДоговорОбъект.АС_ГосНомерАвтомобиля);
	КонецЕсли;

	Если ЗначениеЗаполнено(ЗаказПокупателяОбъект.Контрагент) Тогда
		КонтрагентОбъект = ЗаказПокупателяОбъект.Контрагент.ПолучитьОбъект();
		Если ПустаяСтрока(Результат.Автомобиль) Тогда
			Результат.Автомобиль = АС_СформироватьНаименованиеАвтомобиляНаСервере(
				КонтрагентОбъект.АС_МаркаАвтомобиляИзСправочника,
				КонтрагентОбъект.АС_МодельАвтомобиляИзСправочника);
		КонецЕсли;
		Если ПустаяСтрока(Результат.ГосНомер) Тогда
			Результат.ГосНомер = СокрЛП(КонтрагентОбъект.АС_ГосНомерАвтомобиля);
		КонецЕсли;
		Результат.Телефон = АС_ПолучитьТелефонКонтрагентаНаСервере(КонтрагентОбъект);
		Результат.Имя = СокрЛП(КонтрагентОбъект.Комментарий);
	КонецЕсли;

	Если ПустаяСтрока(Результат.Автомобиль)
		И ЗначениеЗаполнено(ЗаказПокупателяОбъект.Автомобиль) Тогда
		Результат.Автомобиль = Строка(ЗаказПокупателяОбъект.Автомобиль);
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервере
Функция АС_ПолучитьТелефонКонтрагентаНаСервере(КонтрагентОбъект)

	Результат = "";
	НомерПервойСтроки = 0;
	Для Каждого СтрокаКонтактнойИнформации Из КонтрагентОбъект.КонтактнаяИнформация Цикл
		Если СтрокаКонтактнойИнформации.Тип = ПредопределенноеЗначение(
				"Перечисление.ТипыКонтактнойИнформации.Телефон")
			И Не ПустаяСтрока(СокрЛП(СтрокаКонтактнойИнформации.НомерТелефона))
			И (НомерПервойСтроки = 0 Или СтрокаКонтактнойИнформации.НомерСтроки < НомерПервойСтроки) Тогда
			Результат = СокрЛП(СтрокаКонтактнойИнформации.НомерТелефона);
			НомерПервойСтроки = СтрокаКонтактнойИнформации.НомерСтроки;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервере
Функция АС_СформироватьНаименованиеАвтомобиляНаСервере(Марка, Модель)

	Результат = "";
	Если ЗначениеЗаполнено(Марка) Тогда
		Результат = Строка(Марка);
	КонецЕсли;
	Если ЗначениеЗаполнено(Модель) Тогда
		Если Не ПустаяСтрока(Результат) Тогда
			Результат = Результат + " ";
		КонецЕсли;
		Результат = Результат + Строка(Модель);
	КонецЕсли;

	Возврат СокрЛП(Результат);

КонецФункции

&НаКлиенте
Процедура АС_ПередатьОтменуТоваровПоВозвратуПокупателя()

	Если АС_ОтменаВозвратаПереданаВЗаказ = Истина
		Или Не АС_ЭтоВозвратПокупателяИзЗаказа() Тогда
		Возврат;
	КонецЕсли;

	СтрокиОтмены = АС_ПолучитьСтрокиОтменыВозвратаПокупателя();
	Если СтрокиОтмены.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	АС_ОтменаВозвратаПереданаВЗаказ = Истина;
	ДанныеОтмены = Новый Структура("ЗаказПокупателя,Строки",
		Объект.ДокументОснование,
		СтрокиОтмены);
	Оповестить("АС_ОтменитьТоварыПоВозвратуПокупателя", ДанныеОтмены);

	ПараметрыФормыЗаказа = Новый Структура;
	ПараметрыФормыЗаказа.Вставить("Ключ", Объект.ДокументОснование);
	ПараметрыФормыЗаказа.Вставить(
		"АС_СтрокиОтменыВозвратаПокупателя", СтрокиОтмены);
	ОткрытьФорму(АС_ПолучитьИмяФормыЗаказаПокупателяНаСервере(), ПараметрыФормыЗаказа);

КонецПроцедуры

&НаКлиенте
Функция АС_ЭтоВозвратПокупателяИзЗаказа()

	Возврат Объект.ВидОперации = ПредопределенноеЗначение(
		"Перечисление.ВидыОперацийПриходнаяНакладная.ВозвратОтПокупателя")
		И ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ЗаказПокупателя");

КонецФункции

&НаКлиенте
Функция АС_ПолучитьСтрокиОтменыВозвратаПокупателя()

	Результат = Новый Массив;

	Для Каждого СтрокаВозврата Из Объект.Запасы Цикл
		Если Не ЗначениеЗаполнено(СтрокаВозврата.Номенклатура)
			Или СтрокаВозврата.Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;

		СтрокаОтмены = Новый Структура("Номенклатура,Характеристика,Цена,Количество");
		СтрокаОтмены.Номенклатура = СтрокаВозврата.Номенклатура;
		СтрокаОтмены.Характеристика = СтрокаВозврата.Характеристика;
		СтрокаОтмены.Цена = СтрокаВозврата.Цена;
		СтрокаОтмены.Количество = СтрокаВозврата.Количество;
		Результат.Добавить(СтрокаОтмены);
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервере
Функция АС_ПолучитьИмяФормыЗаказаПокупателяНаСервере()

	ЗаказПокупателяОбъект = Объект.ДокументОснование.ПолучитьОбъект();
	Если ЗаказПокупателяОбъект.ВидОперации = ПредопределенноеЗначение(
			"Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаряд") Тогда
		Возврат "Документ.ЗаказПокупателя.Форма.ФормаЗаказНаряда";
	КонецЕсли;

	Возврат "Документ.ЗаказПокупателя.Форма.ФормаДокумента";

КонецФункции

&НаСервереБезКонтекста
Функция АС_ЕстьПрисоединенныеФайлы(СсылкаНаДокумент) Экспорт

	Если Не ЗначениеЗаполнено(СсылкаНаДокумент) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат РаботаСФайламиСлужебныйВызовСервера.КоличествоПрисоединенныхФайлов(СсылкаНаДокумент) > 0;

КонецФункции

&НаКлиенте
Процедура АС_ПодтверждениеСканированияНакладнойЗавершение(Результат, Параметры) Экспорт

	Если Результат <> КодВозвратаДиалога.ОК Тогда
		Возврат;
	КонецЕсли;

	АС_ПроведениеПодтверждено = Истина;
	Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));

КонецПроцедуры
