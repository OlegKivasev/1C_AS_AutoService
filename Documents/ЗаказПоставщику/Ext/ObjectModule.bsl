#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

&После("ПередЗаписью")
Процедура АС_ПередЗаписьюПосле(Отказ, РежимЗаписи, РежимПроведения)

	Если Отказ
		Или ОбменДанными.Загрузка
		Или РежимЗаписи <> РежимЗаписиДокумента.Проведение
		Или Не ЗначениеЗаполнено(Контрагент)
		Или ВРег(СокрЛП(Контрагент.Наименование)) <> ВРег("Рынок") Тогда
		Возврат;
	КонецЕсли;

	// Для поставщика "Рынок" дата заранее неизвестна, но период движения
	// регистра не может быть пустым. Максимальная дата означает "срок не задан".
	ТехническаяДатаПоступления = Дата(3999, 12, 31);
	Для Каждого СтрокаЗапаса Из Запасы Цикл
		Если Не ЗначениеЗаполнено(СтрокаЗапаса.ДатаПоступления) Тогда
			СтрокаЗапаса.ДатаПоступления = ТехническаяДатаПоступления;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&После("ОбработкаПроверкиЗаполнения")
Процедура АС_ОбработкаПроверкиЗаполненияПосле(Отказ, ПроверяемыеРеквизиты)

	Если ЗначениеЗаполнено(Контрагент)
		И ВРег(СокрЛП(Контрагент.Наименование)) = ВРег("Рынок") Тогда
		ЗаполнениеОбъектовУНФ.УдалитьПроверяемыйРеквизит(
			ПроверяемыеРеквизиты, "Запасы.Цена");
		ЗаполнениеОбъектовУНФ.УдалитьПроверяемыйРеквизит(
			ПроверяемыеРеквизиты, "ОтмененныеЗапасы.Цена");
		ЗаполнениеОбъектовУНФ.УдалитьПроверяемыйРеквизит(
			ПроверяемыеРеквизиты, "Запасы.ДатаПоступления");
		ЗаполнениеОбъектовУНФ.УдалитьПроверяемыйРеквизит(
			ПроверяемыеРеквизиты, "ДатаПоступления");
		Возврат;
	КонецЕсли;

	Если ЭтоНовый() Тогда
		// Копия старого заказа тоже считается новым заказом и не должна обходить проверку.
		АС_ТребоватьКоличествоДнейНаВозврат = Истина;
	КонецЕсли;

	Если Не АС_ТребоватьКоличествоДнейНаВозврат Тогда
		Возврат;
	КонецЕсли;

	ПодходящаяНоменклатура = НоменклатураВДокументахСервер.НоменклатураТабличнойЧастиПоТипу(
		ЭтотОбъект,
		Перечисления.ТипыНоменклатуры.Запас);

	Для Каждого СтрокаЗапасы Из Запасы Цикл
		Если ПодходящаяНоменклатура.Найти(СтрокаЗапасы.Номенклатура) = Неопределено
			Или СтрокаЗапасы.АС_КоличествоДнейНаВозврат > 0 Тогда
			Продолжить;
		КонецЕсли;

		КонтекстноеПоле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(
			"Запасы",
			СтрокаЗапасы.НомерСтроки,
			"АС_КоличествоДнейНаВозврат");
		ТекстСообщения = НСтр("ru = 'В строке товаров не заполнено количество дней на возврат.'");
		ОбщегоНазначения.СообщитьПользователю(
			ТекстСообщения,
			ЭтотОбъект,
			КонтекстноеПоле,
			,
			Отказ);
	КонецЦикла;

КонецПроцедуры

#КонецЕсли
