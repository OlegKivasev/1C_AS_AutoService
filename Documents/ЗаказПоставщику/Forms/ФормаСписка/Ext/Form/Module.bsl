&НаКлиенте
&Вместо("СписокВыбор")
Процедура АС_СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле = Неопределено Или Поле.Имя <> "АС_СоставЗаказа" Тогда
		ПродолжитьВызов(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка);
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	Если Элемент.ТекущиеДанные = Неопределено
		Или Не ЗначениеЗаполнено(Элемент.ТекущиеДанные.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	СоставЗаказа = АС_ПолучитьСоставЗаказа(Элемент.ТекущиеДанные.Ссылка);
	Если СоставЗаказа.Количество() = 0 Тогда
		ТекстНетТоваров = НСтр("ru = 'Заказанные товары отсутствуют'");
		СоставЗаказа.Добавить(ТекстНетТоваров, ТекстНетТоваров);
	КонецЕсли;
	
	АС_РасширитьПредставлениеСоставаЗаказа(СоставЗаказа);
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("АС_СоставЗаказаЗавершение", ЭтотОбъект);
	ПоказатьВыборИзСписка(ОповещениеОЗакрытии, СоставЗаказа, Поле);
	
КонецПроцедуры

&НаКлиенте
Процедура АС_РасширитьПредставлениеСоставаЗаказа(СоставЗаказа)
	
	МаксимальнаяДлина = 0;
	СамаяДлиннаяСтрока = Неопределено;
	Для Каждого СтрокаСостава Из СоставЗаказа Цикл
		ДлинаСтроки = СтрДлина(СтрокаСостава.Представление);
		Если ДлинаСтроки > МаксимальнаяДлина Тогда
			МаксимальнаяДлина = ДлинаСтроки;
			СамаяДлиннаяСтрока = СтрокаСостава;
		КонецЕсли;
	КонецЦикла;
	
	Если СамаяДлиннаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Заполнитель = "";
	Для ИндексСимвола = 1 По МаксимальнаяДлина * 2 Цикл
		Заполнитель = Заполнитель + Символ(160);
	КонецЦикла;
	СамаяДлиннаяСтрока.Представление = СамаяДлиннаяСтрока.Представление + Заполнитель;
	
КонецПроцедуры

&НаКлиенте
Процедура АС_СоставЗаказаЗавершение(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_ПолучитьСоставЗаказа(ЗаказПоставщику)
	
	СоставЗаказа = Новый СписокЗначений;
	Если Не ЗначениеЗаполнено(ЗаказПоставщику) Тогда
		Возврат СоставЗаказа;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|  Запасы.НомерСтроки КАК НомерСтроки,
	|  Запасы.Номенклатура.Артикул КАК Артикул,
	|  Запасы.Номенклатура.Наименование КАК Наименование,
	|  Запасы.Количество КАК Количество
	|ИЗ
	|  Документ.ЗаказПоставщику.Запасы КАК Запасы
	|ГДЕ
	|  Запасы.Ссылка = &ЗаказПоставщику
	|  И Запасы.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)
	|
	|УПОРЯДОЧИТЬ ПО
	|  НомерСтроки";
	Запрос.УстановитьПараметр("ЗаказПоставщику", ЗаказПоставщику);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Артикул = СокрЛП(Выборка.Артикул);
		Количество = СокрЛП(Строка(Выборка.Количество)) + " шт.";
		Если ПустаяСтрока(Артикул) Тогда
			ТекстСтроки = СтрШаблон("%1 | %2",
				Выборка.Наименование,
				Количество);
		Иначе
			ТекстСтроки = СтрШаблон("%1 | %2 | %3",
				Артикул,
				Выборка.Наименование,
				Количество);
		КонецЕсли;
		СоставЗаказа.Добавить(ТекстСтроки, ТекстСтроки);
	КонецЦикла;
	
	Возврат СоставЗаказа;
	
КонецФункции
&НаСервере
&После("ПриСозданииНаСервере")
Процедура АС_ДобавитьКомандыАгрегатораПослеСоздания(Отказ, СтандартнаяОбработка)

	Если Отказ Тогда Возврат; КонецЕсли;
	Если ПравоДоступа("Чтение", Метаданные.Документы.ЗаказПоставщику) Тогда
		Команда = Команды.Добавить("АС_ПроверитьЗаказПоставщику");
		Команда.Заголовок = "Выполнить проверку";
		Команда.Действие = "АС_ПроверитьЗаказПоставщику";
		Кнопка = Элементы.Вставить(Команда.Имя, Тип("КнопкаФормы"),
			Элементы.ГруппаГлобальныеКоманды, Элементы.ОбщаяКомандаОтчетПоДвижениям);
		Кнопка.ИмяКоманды = Команда.Имя;
		Кнопка.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
	КонецЕсли;
	Если Не ПравоДоступа("Добавление", Метаданные.Документы.ЗаказПоставщику) Тогда
		Возврат;
	КонецЕсли;
	Команда = Команды.Добавить("АС_ДобавитьИзАгрегатора");
	Команда.Заголовок = "Добавить из агрегатора";
	Команда.Действие = "АС_ДобавитьИзАгрегатора";
	Кнопка = Элементы.Вставить("АС_ДобавитьИзАгрегатора", Тип("КнопкаФормы"),
		Элементы.ГруппаГлобальныеКоманды, Элементы.ОбщаяКомандаОтчетПоДвижениям);
	Кнопка.ИмяКоманды = Команда.Имя;
	Кнопка.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;

КонецПроцедуры

&НаКлиенте
Асинх Процедура АС_ДобавитьИзАгрегатора(Команда)

	Текст = Неопределено;
	Попытка
		Если СредстваБуфераОбмена.ИспользованиеДоступно() Тогда
			Текст = Ждать СредстваБуфераОбмена.ПолучитьДанныеАсинх(СтандартныйФорматДанныхБуфераОбмена.Текст);
		КонецЕсли;
	Исключение
		Сообщить("Не удалось прочитать буфер обмена. Проверьте доступ или скопируйте заказ заново.");
		Возврат;
	КонецПопытки;
	Если ТипЗнч(Текст) <> Тип("Строка") Или ПустаяСтрока(Текст) Тогда
		Сообщить("В буфере обмена нет текста заказа. Нажмите «В 1С» на карточке заказа в агрегаторе.");
		Возврат;
	КонецЕсли;
	Если СтрДлина(Текст) > 3000000 Тогда
		Сообщить("В буфере слишком много данных для одного заказа из агрегатора.");
		Возврат;
	КонецЕсли;
	ОткрытьФорму("ОбщаяФорма.АС_ИмпортЗаказаПоставщику", Новый Структура("ТекстЗаказа", Текст), ЭтотОбъект,,,,,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура АС_ПроверитьЗаказПоставщику(Команда)

	Сегодня = ОбщегоНазначенияКлиент.ДатаСеанса();
	Диалог = Новый ДиалогРедактированияСтандартногоПериода;
	Диалог.Период.ДатаНачала = НачалоДня(Сегодня);
	Диалог.Период.ДатаОкончания = КонецДня(Сегодня);
	Диалог.Показать(Новый ОписаниеОповещения("АС_ПериодПроверкиВыбран", ЭтотОбъект));

КонецПроцедуры

&НаКлиенте
Процедура АС_ПериодПроверкиВыбран(Период, ДополнительныеПараметры) Экспорт

	Если Период = Неопределено Тогда Возврат; КонецЕсли;
	Если Не ЗначениеЗаполнено(Период.ДатаНачала) Или Не ЗначениеЗаполнено(Период.ДатаОкончания)
		Или Период.ДатаОкончания < Период.ДатаНачала
		Или НачалоДня(Период.ДатаОкончания) - НачалоДня(Период.ДатаНачала) > 92 * 86400 Тогда
		ПоказатьПредупреждение(, "Укажите период сверки от одного до 93 дней.");
		Возврат;
	КонецЕсли;
	Попытка
		Отчет = АС_СверитьЗаказыПоставщикамНаСервере(Период.ДатаНачала, Период.ДатаОкончания);
		Отчет.Показать("Сверка заказов поставщику");
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_СверитьЗаказыПоставщикамНаСервере(НачалоПериода, КонецПериода)

	Результат = АС_АгрегаторСервер.СверитьЗаказыПоставщикам(НачалоПериода, КонецПериода);
	Отчет = Новый ТабличныйДокумент;
	Заголовки = СтрРазделить("Результат|Поставщик|Артикул|Бренд|Товар|Количество в 1С|У поставщика|Отменено|Пояснение", "|");
	Ширины = СтрРазделить("26|32|20|18|40|18|18|12|52", "|");
	Для Колонка = 1 По Заголовки.Количество() Цикл
		Отчет.Область(, Колонка,, Колонка).ШиринаКолонки = Число(Ширины[Колонка - 1]);
	КонецЦикла;

	НомерСтроки = 1;
	АС_СтрокаСверки(Отчет, НомерСтроки, СтрШаблон("Незавершённые заказы в 1С · %1", Результат.КоличествоДокументов));
	АС_СтрокаСверки(Отчет, НомерСтроки, СтрШаблон("Период сверки %1 — %2 · %3",
		Формат(НачалоПериода, "ДФ=dd.MM.yyyy"), Формат(КонецПериода, "ДФ=dd.MM.yyyy"), СтрСоединить(Результат.sources, ", ")));
	Для Каждого Предупреждение Из Результат.warnings Цикл
		АС_СтрокаСверки(Отчет, НомерСтроки, Предупреждение);
	КонецЦикла;
	Если Результат.rows.Количество() = 0 Тогда
		ТекстИтога = ?(Результат.sources.Количество() = 0, "Нет поставщиков с доступной историей.",
			?(Результат.sourcesRead = 0, "Не удалось получить данные для сверки.",
			?(Результат.warnings.Количество() = 0, "Расхождений нет.", "В полученных данных расхождений нет. Сверка неполная.")));
		АС_СтрокаСверки(Отчет, НомерСтроки, ТекстИтога);
		Возврат Отчет;
	КонецЕсли;
	Для Колонка = 1 По Заголовки.Количество() Цикл
		Отчет.Область(НомерСтроки, Колонка).Текст = Заголовки[Колонка - 1];
	КонецЦикла;
	НомерСтроки = НомерСтроки + 1;
	ЦветПолучено = Новый Цвет(204, 255, 204);
	ЦветОтменено = Новый Цвет(251, 212, 212);
	Для Каждого СтрокаСверки Из Результат.rows Цикл
		Подсветка = "";
		СтрокаСверки.Свойство("highlight", Подсветка);
		Если СтрокаСверки.status = "received" Тогда
			Статус = ?(Подсветка = "received", "Получено у поставщика", "Частично получено");
		ИначеЕсли СтрокаСверки.status = "cancelled" Тогда
			Статус = "Есть отменённое количество";
		Иначе
			Статус = ?(СтрокаСверки.status = "shortage", "Меньше у поставщика",
				?(СтрокаСверки.status = "extra", "Меньше в 1С", "Требует уточнения"));
		КонецЕсли;
		КоличествоПоставщика = Строка(СтрокаСверки.confirmed);
		Если СтрокаСверки.possible > СтрокаСверки.confirmed Тогда
			КоличествоПоставщика = КоличествоПоставщика + "–" + Строка(СтрокаСверки.possible);
		КонецЕсли;
		Отчет.Область(НомерСтроки, 1).Текст = Статус;
		Отчет.Область(НомерСтроки, 2).Текст = СтрокаСверки.supplier;
		Отчет.Область(НомерСтроки, 3).Текст = СтрокаСверки.article;
		Отчет.Область(НомерСтроки, 4).Текст = СтрокаСверки.brand;
		Отчет.Область(НомерСтроки, 5).Текст = СтрокаСверки.title;
		Отчет.Область(НомерСтроки, 6).Текст = Строка(СтрокаСверки.onec);
		Отчет.Область(НомерСтроки, 7).Текст = КоличествоПоставщика;
		Отчет.Область(НомерСтроки, 8).Текст = Строка(СтрокаСверки.cancelled);
		Отчет.Область(НомерСтроки, 9).Текст = СтрокаСверки.reason;
		Если Подсветка = "received" Или Подсветка = "cancelled" Тогда
			Отчет.Область(НомерСтроки, 1, НомерСтроки, Заголовки.Количество()).ЦветФона =
				?(Подсветка = "received", ЦветПолучено, ЦветОтменено);
		КонецЕсли;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	Возврат Отчет;

КонецФункции

&НаСервереБезКонтекста
Процедура АС_СтрокаСверки(Отчет, НомерСтроки, Текст)
	Область = Отчет.Область(НомерСтроки, 1, НомерСтроки, 9);
	Область.Объединить();
	Область.Текст = Текст;
	НомерСтроки = НомерСтроки + 1;
КонецПроцедуры
