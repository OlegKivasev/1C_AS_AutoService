&НаКлиенте
&Вместо("СписокВыбор")
Процедура АС_СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле = Неопределено Или Поле.Имя <> "АС_СоставЗаказа" Тогда
		ПродолжитьВызов(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка);
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	Если Элемент.ТекущиеДанные = Неопределено
		Или Не ЗначениеЗаполнено(Элемент.ТекущиеДанные.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	СоставЗаказа = АС_ПолучитьСоставЗаказа(Элемент.ТекущиеДанные.Ссылка);
	Если СоставЗаказа.Количество() = 0 Тогда
		СоставЗаказа.Добавить(НСтр("ru = 'Заказанные товары отсутствуют'"));
	КонецЕсли;
	
	Поле.ШиринаСпискаВыбора = 120;
	Оповещение = Новый ОписаниеОповещения("АС_ПросмотрСоставаЗаказаЗавершение", ЭтотОбъект);
	ПоказатьВыборИзСписка(Оповещение, СоставЗаказа, Поле);
	
КонецПроцедуры

&НаКлиенте
Процедура АС_ПросмотрСоставаЗаказаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	// Выбор строки закрывает окно просмотра и не выполняет дополнительных действий.
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_ПолучитьСоставЗаказа(ЗаказПоставщику)
	
	СоставЗаказа = Новый СписокЗначений;
	Если Не ЗначениеЗаполнено(ЗаказПоставщику) Тогда
		Возврат СоставЗаказа;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|  Запасы.НомерСтроки КАК НомерСтроки,
	|  Запасы.Номенклатура.Артикул КАК Артикул,
	|  Запасы.Номенклатура.Наименование КАК Наименование,
	|  Запасы.Количество КАК Количество
	|ИЗ
	|  Документ.ЗаказПоставщику.Запасы КАК Запасы
	|ГДЕ
	|  Запасы.Ссылка = &ЗаказПоставщику
	|  И Запасы.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)
	|
	|УПОРЯДОЧИТЬ ПО
	|  НомерСтроки";
	Запрос.УстановитьПараметр("ЗаказПоставщику", ЗаказПоставщику);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Артикул = СокрЛП(Выборка.Артикул);
		Если ПустаяСтрока(Артикул) Тогда
			ТекстСтроки = СтрШаблон("%1 | %2",
				Выборка.Наименование,
				СокрЛП(Строка(Выборка.Количество)));
		Иначе
			ТекстСтроки = СтрШаблон("%1 | %2 | %3",
				Артикул,
				Выборка.Наименование,
				СокрЛП(Строка(Выборка.Количество)));
		КонецЕсли;
		СоставЗаказа.Добавить(ТекстСтроки);
	КонецЦикла;
	
	Возврат СоставЗаказа;
	
КонецФункции
