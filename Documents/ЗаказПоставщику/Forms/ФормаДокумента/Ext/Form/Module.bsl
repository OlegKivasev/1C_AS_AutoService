Процедура АС_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	АС_ПоступлениеЗаказовПоставщикамСервер.ЗаполнитьСтатусыПоступления(Объект);

КонецПроцедуры

&НаСервере
Процедура АС_ПослеСозданияНаСервере(Отказ, СтандартнаяОбработка)

	АС_ЗаполнитьНаименованиеКонтрагентаЗаказаПокупателя();

КонецПроцедуры

&НаКлиенте
Процедура АС_ЗаказПокупателяАвтоПодбор(
	Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)

	Если ПустаяСтрока(СокрЛП(Текст)) Тогда
		Возврат;
	КонецЕсли;

	Ожидание = Ложь;
	ДанныеВыбора = АС_ПолучитьНезавершенныеЗаказыПокупателей(Текст);
	СтандартнаяОбработка = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура АС_ЗаказПокупателяОкончаниеВводаТекста(
	Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)

	Если ПустаяСтрока(СокрЛП(Текст)) Тогда
		Возврат;
	КонецЕсли;

	ДанныеВыбора = АС_ПолучитьНезавершенныеЗаказыПокупателей(Текст);
	СтандартнаяОбработка = Ложь;

КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_ПолучитьНезавершенныеЗаказыПокупателей(Текст)

	Результат = Новый СписокЗначений;
	ТекстПоиска = СокрЛП(Текст);
	Если ПустаяСтрока(ТекстПоиска) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 50
		| Заказы.Ссылка КАК Ссылка,
		| Заказы.Контрагент.Наименование КАК НаименованиеКонтрагента
		|ИЗ
		| Документ.ЗаказПокупателя КАК Заказы
		|ГДЕ
		| НЕ Заказы.ПометкаУдаления
		| И Заказы.СостояниеЗаказа <> ЗНАЧЕНИЕ(Справочник.СостоянияЗаказовПокупателей.Завершен)
		| И Заказы.СостояниеЗаказа <> ЗНАЧЕНИЕ(Справочник.СостоянияЗаказНарядов.Завершен)
		| И Заказы.Контрагент.Наименование ПОДОБНО &ТекстПоиска СПЕЦСИМВОЛ ""~""
		|УПОРЯДОЧИТЬ ПО
		| Заказы.Дата УБЫВ";
	Запрос.УстановитьПараметр(
		"ТекстПоиска", "%" + ОбщегоНазначения.СформироватьСтрокуДляПоискаВЗапросе(ТекстПоиска) + "%");

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Ссылка, Выборка.НаименованиеКонтрагента);
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура АС_ЗаказПокупателяОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)

	ЗначениеЗаказаПокупателя = ВыбранноеЗначение;
	Если ТипЗнч(ВыбранноеЗначение) = Тип("ЭлементСпискаЗначений") Тогда
		ЗначениеЗаказаПокупателя = ВыбранноеЗначение.Значение;
	КонецЕсли;

	Если Не АС_УстановитьЗаказПокупателяПоВыборуНаСервере(ЗначениеЗаказаПокупателя) Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;
	ЗаказПокупателяПриИзменении(Элемент);

КонецПроцедуры

&НаСервере
Функция АС_УстановитьЗаказПокупателяПоВыборуНаСервере(ВыбранноеЗначение)

	Если ТипЗнч(ВыбранноеЗначение) <> Тип("ДокументСсылка.ЗаказПокупателя")
		Или Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Объект.ЗаказПокупателя = ВыбранноеЗначение;
	АС_ЗаполнитьНаименованиеКонтрагентаЗаказаПокупателя();
	Возврат Истина;

КонецФункции

&НаКлиенте
Процедура АС_НаименованиеКонтрагентаЗаказаПокупателяПриИзменении(Элемент)

	АС_ПроверитьНаименованиеКонтрагентаЗаказаПокупателя();

КонецПроцедуры

&НаСервере
Процедура АС_ПроверитьНаименованиеКонтрагентаЗаказаПокупателя()

	Если Не ЗначениеЗаполнено(Объект.ЗаказПокупателя) Тогда
		Возврат;
	КонецЕсли;

	НаименованиеКонтрагента = Объект.ЗаказПокупателя.Контрагент.Наименование;
	Если СокрЛП(АС_НаименованиеКонтрагентаЗаказаПокупателя) <> СокрЛП(НаименованиеКонтрагента) Тогда
		Объект.ЗаказПокупателя = Документы.ЗаказПокупателя.ПустаяСсылка();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_ЗаказПокупателяОчистка(Элемент, СтандартнаяОбработка)

	АС_ОчиститьЗаказПокупателяНаСервере();

КонецПроцедуры

&НаСервере
Процедура АС_ОчиститьЗаказПокупателяНаСервере()

	Объект.ЗаказПокупателя = Документы.ЗаказПокупателя.ПустаяСсылка();
	АС_НаименованиеКонтрагентаЗаказаПокупателя = "";

КонецПроцедуры

&НаСервере
Процедура АС_ЗаполнитьНаименованиеКонтрагентаЗаказаПокупателя()

	АС_НаименованиеКонтрагентаЗаказаПокупателя = "";
	Если ЗначениеЗаполнено(Объект.ЗаказПокупателя) Тогда
		АС_НаименованиеКонтрагентаЗаказаПокупателя = Объект.ЗаказПокупателя.Контрагент.Наименование;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_ЗаказПокупателяНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	ФиксированныеНастройки = Новый НастройкиКомпоновкиДанных;
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(
		ФиксированныеНастройки.Отбор,
		"СостояниеЗаказа",
		ВидСравненияКомпоновкиДанных.НеРавно,
		ПредопределенноеЗначение("Справочник.СостоянияЗаказовПокупателей.Завершен"),
		,
		Истина,
		РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(
		ФиксированныеНастройки.Отбор,
		"СостояниеЗаказа",
		ВидСравненияКомпоновкиДанных.НеРавно,
		ПредопределенноеЗначение("Справочник.СостоянияЗаказНарядов.Завершен"),
		,
		Истина,
		РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(
		ФиксированныеНастройки.Отбор,
		"ПометкаУдаления",
		ВидСравненияКомпоновкиДанных.Равно,
		Ложь,
		,
		Истина,
		РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ФиксированныеНастройки", ФиксированныеНастройки);
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	ПараметрыФормы.Вставить("МножественныйВыбор", Ложь);
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Истина);

	СтандартнаяОбработка = Ложь;
	ОткрытьФорму("Документ.ЗаказПокупателя.Форма.ФормаВыбора", ПараметрыФормы, Элемент);

КонецПроцедуры

&НаКлиенте
Процедура АС_ОткрытьЗаказПокупателяНажатие(Элемент, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(Объект.ЗаказПокупателя) Тогда
		Возврат;
