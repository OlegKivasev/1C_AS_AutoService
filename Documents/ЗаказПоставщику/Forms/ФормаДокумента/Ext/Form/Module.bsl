&НаСервере
Процедура АС_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ТипКоличества = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3));
	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
		"АС_ОстатокСУчетомЗаказов", ТипКоличества, "Объект.Запасы", "Остаток с учетом заказов"));
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);

	ИмяКолонкиОстатка = "АС_ЗапасыОстатокСУчетомЗаказов";
	КолонкаОстатка = Элементы.Добавить(ИмяКолонкиОстатка, Тип("ПолеФормы"), Элементы.Запасы);
	КолонкаОстатка.Вид = ВидПоляФормы.ПолеВвода;
	КолонкаОстатка.ПутьКДанным = "Объект.Запасы.АС_ОстатокСУчетомЗаказов";
	КолонкаОстатка.Заголовок = "Остаток с учетом" + Символы.ПС + "заказов";
	КолонкаОстатка.Подсказка =
		"Остаток на складе резерва за вычетом товаров в активных заказах покупателей и заказ-нарядах";
	КолонкаОстатка.ТолькоПросмотр = Истина;
	КолонкаОстатка.Ширина = 10;
	КолонкаОстатка.Формат = "ЧН=0; ЧДЦ=3";
	Элементы.Переместить(КолонкаОстатка, Элементы.Запасы, Элементы.ЗапасыКоличество);

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяКолонкиОстатка);
	ОформляемоеПоле.Использование = Истина;

	ОтборПоОстатку = ЭлементОформления.Отбор.Элементы.Добавить(
		Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборПоОстатку.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(
		"Объект.Запасы.АС_ОстатокСУчетомЗаказов");
	ОтборПоОстатку.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборПоОстатку.ПравоеЗначение = 0;
	ОтборПоОстатку.Использование = Истина;

	ОтборПоТипу = ЭлементОформления.Отбор.Элементы.Добавить(
		Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборПоТипу.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Запасы.ТипНоменклатуры");
	ОтборПоТипу.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборПоТипу.ПравоеЗначение = Перечисления.ТипыНоменклатуры.Запас;
	ОтборПоТипу.Использование = Истина;

	ЦветТекста = ЭлементОформления.Оформление.Элементы.Найти("ЦветТекста");
	ЦветТекста.Значение = WebЦвета.Красный;
	ЦветТекста.Использование = Истина;

	АС_ПоступлениеЗаказовПоставщикамСервер.ЗаполнитьСтатусыПоступления(Объект);

КонецПроцедуры

