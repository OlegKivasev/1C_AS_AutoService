	ОткрытьФорму("Документ.ЗаказПокупателя.ФормаОбъекта");

КонецПроцедуры

&НаКлиенте
&После("ПередЗаписью")
Процедура АС_ПередЗаписьюПосле(Отказ, ПараметрыЗаписи)

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Если ПараметрыЗаписи.РежимЗаписи <> РежимЗаписиДокумента.Проведение Тогда
		Возврат;
	КонецЕсли;

	Если АС_ПроведениеПослеПроверкиТоваров Тогда
		АС_ПроведениеПослеПроверкиТоваров = Ложь;
		Возврат;
	КонецЕсли;

	Если Не АС_ПроверитьЗаполнениеПередАвтоматическимОбновлениемНаСервере() Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.ЗаказПокупателя)
		Или Не АС_ЕстьИзмененияВЗаказеПокупателяНаСервере() Тогда
		Возврат;
	КонецЕсли;

	Отказ = Истина;
	ПоказатьВопрос(
		Новый ОписаниеОповещения("АС_ПодтверждениеДобавленияТоваровЗавершение", ЭтотОбъект),
		"Автоматически внести изменения в заказ покупателя?",
		РежимДиалогаВопрос.ДаНет,
		0,
		КодВозвратаДиалога.Да);

КонецПроцедуры

&НаСервере
Функция АС_ПроверитьЗаполнениеПередАвтоматическимОбновлениемНаСервере()

	ТекущийОбъект = РеквизитФормыВЗначение("Объект");
	Возврат ТекущийОбъект.ПроверитьЗаполнение();

КонецФункции

&НаКлиенте
Процедура АС_ПодтверждениеДобавленияТоваровЗавершение(Результат, ДополнительныеПараметры) Экспорт

	ОбновитьЗаказПокупателя = Результат = КодВозвратаДиалога.Да;
	Если ОбновитьЗаказПокупателя Тогда
		// Снимок нужно получить до проведения: после записи форма заказа поставщику
		// уже не обязана сохранять исходное состояние отмененных строк.
		АС_СкопироватьВсеТоварыВБуферНаСервере();
	КонецЕсли;

	АС_ПроведениеПослеПроверкиТоваров = Истина;
	ПараметрыПроведения = Новый Структура(
		"РежимЗаписи",
		РежимЗаписиДокумента.Проведение);
	Записать(ПараметрыПроведения);

	Если ОбновитьЗаказПокупателя Тогда
		АС_ОткрытьЗаказПокупателяПослеПодготовкиОбновления();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция АС_ЕстьИзмененияВЗаказеПокупателяНаСервере()

	ЗаказПокупателяОбъект = Объект.ЗаказПокупателя.ПолучитьОбъект();
	ИсточникЗаказПоставщику = АС_ПолучитьСсылкуТекущегоЗаказаПоставщикуНаСервере();
	Для Каждого СтрокаПоставщика Из Объект.Запасы Цикл
		Если Не ЗначениеЗаполнено(СтрокаПоставщика.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;

		СвязьНайдена = Ложь;
		КоличествоВЗаказеПокупателя = 0;
		ЦенаПоставщикаСовпадает = Истина;
		Для Каждого СвязьПоставки Из ЗаказПокупателяОбъект.АС_ИсточникиПоставок Цикл
			Если СвязьПоставки.ЗаказПоставщику = ИсточникЗаказПоставщику
				И СвязьПоставки.КлючСвязиЗаказаПоставщику = СтрокаПоставщика.КлючСвязи Тогда
				СтрокаПоСвязиСуществует = Ложь;
				Для Каждого СтрокаПокупателя Из ЗаказПокупателяОбъект.Запасы Цикл
					Если СтрокаПокупателя.АС_ИдентификаторГруппыПоставок =
						СвязьПоставки.ИдентификаторСтрокиПокупателя Тогда
						СтрокаПоСвязиСуществует = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Если Не СтрокаПоСвязиСуществует Тогда
					Возврат Истина;
				КонецЕсли;
				СвязьНайдена = Истина;
				КоличествоВЗаказеПокупателя = КоличествоВЗаказеПокупателя + СвязьПоставки.Количество;
				ЦенаПоставщикаСовпадает = ЦенаПоставщикаСовпадает
					И СвязьПоставки.ЦенаПоставщика = СтрокаПоставщика.Цена;
			КонецЕсли;
		КонецЦикла;

		// Совместимость со строками, созданными до появления реестра вкладов.
		Если Не СвязьНайдена Тогда
			Для Каждого СтрокаПокупателя Из ЗаказПокупателяОбъект.Запасы Цикл
				Если СтрокаПокупателя.Номенклатура = СтрокаПоставщика.Номенклатура
					И СтрокаПокупателя.Характеристика = СтрокаПоставщика.Характеристика
					И СтрокаПокупателя.АС_ЗаказПоставщику = ИсточникЗаказПоставщику
					И СтрокаПокупателя.АС_КлючСвязиЗаказаПоставщику = СтрокаПоставщика.КлючСвязи Тогда
					СвязьНайдена = Истина;
					КоличествоВЗаказеПокупателя = КоличествоВЗаказеПокупателя + СтрокаПокупателя.Количество;
					ЦенаПоставщикаСовпадает = ЦенаПоставщикаСовпадает
						И СтрокаПокупателя.АС_ЦенаИзЗаказаПоставщика
						И СтрокаПокупателя.АС_ИсходнаяЦенаЗаказаПоставщика = СтрокаПоставщика.Цена;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		Если Не СвязьНайдена
			Или КоличествоВЗаказеПокупателя <> СтрокаПоставщика.Количество
			Или Не ЦенаПоставщикаСовпадает Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Для Каждого СвязьПоставки Из ЗаказПокупателяОбъект.АС_ИсточникиПоставок Цикл
		Если СвязьПоставки.ЗаказПоставщику <> ИсточникЗаказПоставщику Тогда
			Продолжить;
		КонецЕсли;

		СтрокаПоставщикаНайдена = Ложь;
		Для Каждого СтрокаПоставщика Из Объект.Запасы Цикл
			Если СтрокаПоставщика.КлючСвязи = СвязьПоставки.КлючСвязиЗаказаПоставщику Тогда
				СтрокаПоставщикаНайдена = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не СтрокаПоставщикаНайдена Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Для Каждого СтрокаПокупателя Из ЗаказПокупателяОбъект.Запасы Цикл
		Если СтрокаПокупателя.АС_ЗаказПоставщику <> ИсточникЗаказПоставщику Тогда
			Продолжить;
		КонецЕсли;

		СтрокаПоставщикаНайдена = Ложь;
		Для Каждого СтрокаПоставщика Из Объект.Запасы Цикл
			Если СтрокаПоставщика.КлючСвязи =
				СтрокаПокупателя.АС_КлючСвязиЗаказаПоставщику Тогда
				СтрокаПоставщикаНайдена = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не СтрокаПоставщикаНайдена Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	РаспределениеОтмен = АС_ПолучитьРаспределениеОтменНаСервере(
		ЗаказПокупателяОбъект, ИсточникЗаказПоставщику);
	Для Каждого СтрокаОтменыПоставщика Из РаспределениеОтмен Цикл
		КоличествоОтмененоВЗаказеПокупателя = 0;
		Для Каждого СтрокаОтменыПокупателя Из ЗаказПокупателяОбъект.ОтмененныеЗапасы Цикл
			Если СтрокаОтменыПокупателя.Номенклатура = СтрокаОтменыПоставщика.Номенклатура
				И СтрокаОтменыПокупателя.Характеристика = СтрокаОтменыПоставщика.Характеристика
				И СтрокаОтменыПокупателя.АС_ЗаказПоставщику = ИсточникЗаказПоставщику
				И СтрокаОтменыПокупателя.АС_КлючСвязиЗаказаПоставщику =
					СтрокаОтменыПоставщика.КлючСвязиЗаказаПоставщику
				И СтрокаОтменыПокупателя.АС_ЦенаИзЗаказаПоставщика
				И СтрокаОтменыПокупателя.АС_ИсходнаяЦенаЗаказаПоставщика = СтрокаОтменыПоставщика.Цена Тогда
				КоличествоОтмененоВЗаказеПокупателя = КоличествоОтмененоВЗаказеПокупателя
					+ СтрокаОтменыПокупателя.Количество;
			КонецЕсли;
		КонецЦикла;

		Если СтрокаОтменыПоставщика.Количество > КоличествоОтмененоВЗаказеПокупателя Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

&НаСервере
Функция АС_ПолучитьРаспределениеОтменНаСервере(
	ЗаказПокупателяОбъект, ИсточникЗаказПоставщику)

	ГруппыОтмен = Новый Массив;
	Для Каждого СтрокаОтмены Из Объект.ОтмененныеЗапасы Цикл
		ГруппаОтмены = Неопределено;
		Для Каждого ГруппаОтменыПоиска Из ГруппыОтмен Цикл
			Если ГруппаОтменыПоиска.Номенклатура = СтрокаОтмены.Номенклатура
				И ГруппаОтменыПоиска.Характеристика = СтрокаОтмены.Характеристика
				И ГруппаОтменыПоиска.Цена = СтрокаОтмены.Цена Тогда
				ГруппаОтмены = ГруппаОтменыПоиска;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ГруппаОтмены = Неопределено Тогда
			ГруппаОтмены = Новый Структура(
				"Номенклатура,Характеристика,Цена,Количество",
				СтрокаОтмены.Номенклатура,
				СтрокаОтмены.Характеристика,
				СтрокаОтмены.Цена,
				0);
			ГруппыОтмен.Добавить(ГруппаОтмены);
		КонецЕсли;
		ГруппаОтмены.Количество = ГруппаОтмены.Количество + СтрокаОтмены.Количество;
	КонецЦикла;

	Результат = Новый Массив;
	Для Каждого ГруппаОтмены Из ГруппыОтмен Цикл
		ОсталосьРаспределить = ГруппаОтмены.Количество;
		НайденыСвязи = Ложь;
		Для Каждого СвязьПоставки Из ЗаказПокупателяОбъект.АС_ИсточникиПоставок Цикл
			Если ОсталосьРаспределить <= 0 Тогда
				Прервать;
			КонецЕсли;
			Если СвязьПоставки.ЗаказПоставщику <> ИсточникЗаказПоставщику
				Или СвязьПоставки.ЦенаПоставщика <> ГруппаОтмены.Цена Тогда
				Продолжить;
			КонецЕсли;

			СтрокаПокупателяНайдена = Ложь;
			Для Каждого СтрокаПокупателя Из ЗаказПокупателяОбъект.Запасы Цикл
				Если СтрокаПокупателя.АС_ИдентификаторГруппыПоставок =
						СвязьПоставки.ИдентификаторСтрокиПокупателя
					И СтрокаПокупателя.Номенклатура = ГруппаОтмены.Номенклатура
					И СтрокаПокупателя.Характеристика = ГруппаОтмены.Характеристика Тогда
					СтрокаПокупателяНайдена = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если Не СтрокаПокупателяНайдена Тогда
				Продолжить;
			КонецЕсли;

			НайденыСвязи = Истина;
			КоличествоКОтмене = Мин(ОсталосьРаспределить, СвязьПоставки.Количество);
			АС_ДобавитьВРаспределениеОтмен(
				Результат,
				ГруппаОтмены,
				СвязьПоставки.КлючСвязиЗаказаПоставщику,
				КоличествоКОтмене);
			ОсталосьРаспределить = ОсталосьРаспределить - КоличествоКОтмене;
		КонецЦикла;

		Если НайденыСвязи Или ОсталосьРаспределить <= 0 Тогда
			Продолжить;
		КонецЕсли;

		// Совместимость со строками, созданными до появления реестра вкладов.
		Для Каждого СтрокаПокупателя Из ЗаказПокупателяОбъект.Запасы Цикл
			Если ОсталосьРаспределить <= 0 Тогда
				Прервать;
			КонецЕсли;
			Если СтрокаПокупателя.Номенклатура <> ГруппаОтмены.Номенклатура
				Или СтрокаПокупателя.Характеристика <> ГруппаОтмены.Характеристика
				Или СтрокаПокупателя.АС_ЗаказПоставщику <> ИсточникЗаказПоставщику
				Или Не ЗначениеЗаполнено(СтрокаПокупателя.АС_КлючСвязиЗаказаПоставщику)
				Или Не СтрокаПокупателя.АС_ЦенаИзЗаказаПоставщика
				Или СтрокаПокупателя.АС_ИсходнаяЦенаЗаказаПоставщика <> ГруппаОтмены.Цена Тогда
				Продолжить;
			КонецЕсли;

			КоличествоКОтмене = Мин(ОсталосьРаспределить, СтрокаПокупателя.Количество);
			АС_ДобавитьВРаспределениеОтмен(
				Результат,
				ГруппаОтмены,
				СтрокаПокупателя.АС_КлючСвязиЗаказаПоставщику,
				КоличествоКОтмене);
			ОсталосьРаспределить = ОсталосьРаспределить - КоличествоКОтмене;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервере
Процедура АС_ДобавитьВРаспределениеОтмен(
	РаспределениеОтмен, ГруппаОтмены, КлючСвязиЗаказаПоставщику, Количество)

	Если Количество <= 0 Тогда
		Возврат;
	КонецЕсли;

	СтрокаРаспределения = Неопределено;
	Для Каждого СтрокаРаспределенияПоиска Из РаспределениеОтмен Цикл
		Если СтрокаРаспределенияПоиска.КлючСвязиЗаказаПоставщику = КлючСвязиЗаказаПоставщику
			И СтрокаРаспределенияПоиска.Номенклатура = ГруппаОтмены.Номенклатура
			И СтрокаРаспределенияПоиска.Характеристика = ГруппаОтмены.Характеристика
			И СтрокаРаспределенияПоиска.Цена = ГруппаОтмены.Цена Тогда
			СтрокаРаспределения = СтрокаРаспределенияПоиска;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если СтрокаРаспределения = Неопределено Тогда
		СтрокаРаспределения = Новый Структура(
			"Номенклатура,Характеристика,Цена,КлючСвязиЗаказаПоставщику,Количество",
			ГруппаОтмены.Номенклатура,
			ГруппаОтмены.Характеристика,
			ГруппаОтмены.Цена,
			КлючСвязиЗаказаПоставщику,
			0);
		РаспределениеОтмен.Добавить(СтрокаРаспределения);
	КонецЕсли;
	СтрокаРаспределения.Количество = СтрокаРаспределения.Количество + Количество;

КонецПроцедуры

&НаСервере
Функция АС_ПолучитьСсылкуТекущегоЗаказаПоставщикуНаСервере()

	ТекущийОбъект = РеквизитФормыВЗначение("Объект");
	Если ТекущийОбъект.ЭтоНовый() Тогда
		СсылкаНовогоЗаказа = ТекущийОбъект.ПолучитьСсылкуНового();
		ЗначениеВРеквизитФормы(ТекущийОбъект, "Объект");
		Возврат СсылкаНовогоЗаказа;
	КонецЕсли;

	Возврат ТекущийОбъект.Ссылка;

КонецФункции

&НаКлиенте
Процедура АС_ЗаполнитьЗаказПокупателяПоЗаказуПоставщика(Команда)

	Если Не ЗначениеЗаполнено(Объект.ЗаказПокупателя) Тогда
		Сообщить("Укажите связанный заказ покупателя.");
		Возврат;
	КонецЕсли;

	Если Объект.Запасы.Количество() = 0
		И Объект.ОтмененныеЗапасы.Количество() = 0 Тогда
		Сообщить("В заказе поставщику нет товаров для переноса.");
		Возврат;
	КонецЕсли;

	АС_СкопироватьВсеТоварыВБуферНаСервере();
	АС_ОткрытьЗаказПокупателяПослеПодготовкиОбновления();

КонецПроцедуры

&НаКлиенте
Процедура АС_ОткрытьЗаказПокупателяПослеПодготовкиОбновления()

	Оповестить("АС_ОбновитьЗаказПокупателяИзЗаказаПоставщика", Объект.ЗаказПокупателя);

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Ключ", Объект.ЗаказПокупателя);
	ПараметрыФормы.Вставить("АС_АвтозаполнениеИзЗаказаПоставщика", Истина);
	ОткрытьФорму(АС_ПолучитьИмяФормыЗаказаПокупателяНаСервере(), ПараметрыФормы);

КонецПроцедуры

&НаСервере
Функция АС_ПолучитьИмяФормыЗаказаПокупателяНаСервере()

	ЗаказПокупателяОбъект = Объект.ЗаказПокупателя.ПолучитьОбъект();
	Если ЗаказПокупателяОбъект.ВидОперации = ПредопределенноеЗначение(
			"Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаряд") Тогда
		Возврат "Документ.ЗаказПокупателя.Форма.ФормаЗаказНаряда";
	КонецЕсли;

	Возврат "Документ.ЗаказПокупателя.Форма.ФормаДокумента";

КонецФункции

&НаСервере
Процедура АС_СкопироватьВсеТоварыВБуферНаСервере()

	Если Объект.Запасы.Количество() = 0 Тогда
		АС_СохранитьСтрокиОтменыВБуферНаСервере();
		Возврат;
	КонецЕсли;

	ВыделенныеСтроки = Новый Массив;
	Для Каждого СтрокаТовара Из Объект.Запасы Цикл
		Если СтрокаТовара.Отменен Тогда
			Продолжить;
		КонецЕсли;
		ВыделенныеСтроки.Добавить(СтрокаТовара.ПолучитьИдентификатор());
	КонецЦикла;

	КоличествоСкопированных = 0;
	КопированиеТабличнойЧастиСервер.Копировать(
		Объект.Запасы, ВыделенныеСтроки, КоличествоСкопированных);
	АС_КопироватьСтрокиНаСервереПосле("Запасы", КоличествоСкопированных);

КонецПроцедуры

&НаСервере
&После("ПриЧтенииНаСервере")
Процедура АС_ПриЧтенииНаСервере(ТекущийОбъект)

	АС_ПоступлениеЗаказовПоставщикамСервер.ЗаполнитьСтатусыПоступления(Объект);
	АС_ЗаполнитьНаименованиеКонтрагентаЗаказаПокупателя();

КонецПроцедуры

&НаСервере
&После("КопироватьСтрокиНаСервере")
Процедура АС_КопироватьСтрокиНаСервереПосле(ИмяТЧ, КоличествоСкопированных)

	Если ИмяТЧ <> "Запасы" Тогда
		Возврат;
	КонецЕсли;

	СкопированныеСтроки = ХранилищеОбщихНастроек.Загрузить(
		"БуферОбменаТабличныеЧасти", "Строки");
	Если СкопированныеСтроки = Неопределено Тогда
		СкопированныеСтроки = Новый ТаблицаЗначений;
		СкопированныеСтроки.Колонки.Добавить("Номенклатура");
		СкопированныеСтроки.Колонки.Добавить("Характеристика");
		СкопированныеСтроки.Колонки.Добавить("Количество");
		СкопированныеСтроки.Колонки.Добавить("Цена");
	КонецЕсли;

	ИмяКолонкиИсточника = "АС_ИсточникЗаказПоставщика";
	Если СкопированныеСтроки.Колонки.Найти(ИмяКолонкиИсточника) = Неопределено Тогда
		СкопированныеСтроки.Колонки.Добавить(ИмяКолонкиИсточника, Новый ОписаниеТипов("Булево"));
	КонецЕсли;
	ИмяКолонкиЦены = "АС_ЦенаЗаказаПоставщика";
	Если СкопированныеСтроки.Колонки.Найти(ИмяКолонкиЦены) = Неопределено Тогда
		СкопированныеСтроки.Колонки.Добавить(ИмяКолонкиЦены, Новый ОписаниеТипов("Число"));
	КонецЕсли;
	ИмяКолонкиОтмены = "АС_ОтменитьВЗаказеПокупателя";
	Если СкопированныеСтроки.Колонки.Найти(ИмяКолонкиОтмены) = Неопределено Тогда
		СкопированныеСтроки.Колонки.Добавить(ИмяКолонкиОтмены, Новый ОписаниеТипов("Булево"));
	КонецЕсли;
	ИмяКолонкиУдаления = "АС_УдалитьИзЗаказаПокупателя";
	Если СкопированныеСтроки.Колонки.Найти(ИмяКолонкиУдаления) = Неопределено Тогда
		СкопированныеСтроки.Колонки.Добавить(ИмяКолонкиУдаления, Новый ОписаниеТипов("Булево"));
	КонецЕсли;
	ИмяКолонкиЗаказаПоставщику = "АС_ЗаказПоставщику";
	Если СкопированныеСтроки.Колонки.Найти(ИмяКолонкиЗаказаПоставщику) = Неопределено Тогда
		СкопированныеСтроки.Колонки.Добавить(ИмяКолонкиЗаказаПоставщику);
	КонецЕсли;
	ИмяКолонкиКлючаСвязи = "АС_КлючСвязиЗаказаПоставщику";
	Если СкопированныеСтроки.Колонки.Найти(ИмяКолонкиКлючаСвязи) = Неопределено Тогда
		СкопированныеСтроки.Колонки.Добавить(ИмяКолонкиКлючаСвязи);
	КонецЕсли;

	ИсточникЗаказПоставщику = АС_ПолучитьСсылкуТекущегоЗаказаПоставщикуНаСервере();
	Для Каждого Строка Из СкопированныеСтроки Цикл
		Строка[ИмяКолонкиИсточника] = Истина;
		Строка[ИмяКолонкиЦены] = Строка.Цена;
		Строка[ИмяКолонкиОтмены] = Ложь;
		Строка[ИмяКолонкиУдаления] = Ложь;
		Строка[ИмяКолонкиЗаказаПоставщику] = ИсточникЗаказПоставщику;
		Строка[ИмяКолонкиКлючаСвязи] = Строка.КлючСвязи;
	КонецЦикла;
	АС_ДобавитьСтрокиОтменыВБуферНаСервере(СкопированныеСтроки);
	АС_ДобавитьУдаленныеСтрокиВБуферНаСервере(СкопированныеСтроки);
	ХранилищеОбщихНастроек.Сохранить("БуферОбменаТабличныеЧасти", "Строки", СкопированныеСтроки);

КонецПроцедуры

&НаСервере
Процедура АС_СохранитьСтрокиОтменыВБуферНаСервере()

	СкопированныеСтроки = Новый ТаблицаЗначений;
	СкопированныеСтроки.Колонки.Добавить("Номенклатура");
	СкопированныеСтроки.Колонки.Добавить("Характеристика");
	СкопированныеСтроки.Колонки.Добавить("Количество");
	СкопированныеСтроки.Колонки.Добавить("Цена");
	СкопированныеСтроки.Колонки.Добавить("АС_ИсточникЗаказПоставщика", Новый ОписаниеТипов("Булево"));
	СкопированныеСтроки.Колонки.Добавить("АС_ЦенаЗаказаПоставщика", Новый ОписаниеТипов("Число"));
	СкопированныеСтроки.Колонки.Добавить("АС_ОтменитьВЗаказеПокупателя", Новый ОписаниеТипов("Булево"));
	СкопированныеСтроки.Колонки.Добавить("АС_УдалитьИзЗаказаПокупателя", Новый ОписаниеТипов("Булево"));
	СкопированныеСтроки.Колонки.Добавить("АС_ЗаказПоставщику");
	СкопированныеСтроки.Колонки.Добавить("АС_КлючСвязиЗаказаПоставщику");
	АС_ДобавитьСтрокиОтменыВБуферНаСервере(СкопированныеСтроки);
	АС_ДобавитьУдаленныеСтрокиВБуферНаСервере(СкопированныеСтроки);
	ХранилищеОбщихНастроек.Сохранить("БуферОбменаТабличныеЧасти", "Строки", СкопированныеСтроки);

КонецПроцедуры

&НаСервере
Процедура АС_ДобавитьСтрокиОтменыВБуферНаСервере(СкопированныеСтроки)

	Если Не ЗначениеЗаполнено(Объект.ЗаказПокупателя) Тогда
		Возврат;
	КонецЕсли;

	ИсточникЗаказПоставщику = АС_ПолучитьСсылкуТекущегоЗаказаПоставщикуНаСервере();
	ЗаказПокупателяОбъект = Объект.ЗаказПокупателя.ПолучитьОбъект();
	РаспределениеОтмен = АС_ПолучитьРаспределениеОтменНаСервере(
		ЗаказПокупателяОбъект, ИсточникЗаказПоставщику);
	Для Каждого СтрокаОтмены Из РаспределениеОтмен Цикл
		СтрокаБуфера = СкопированныеСтроки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаБуфера, СтрокаОтмены);
		СтрокаБуфера.АС_ИсточникЗаказПоставщика = Истина;
		СтрокаБуфера.АС_ЦенаЗаказаПоставщика = СтрокаОтмены.Цена;
		СтрокаБуфера.АС_ОтменитьВЗаказеПокупателя = Истина;
		СтрокаБуфера.АС_УдалитьИзЗаказаПокупателя = Ложь;
		СтрокаБуфера.АС_ЗаказПоставщику = ИсточникЗаказПоставщику;
		СтрокаБуфера.АС_КлючСвязиЗаказаПоставщику = СтрокаОтмены.КлючСвязиЗаказаПоставщику;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура АС_ДобавитьУдаленныеСтрокиВБуферНаСервере(СкопированныеСтроки)

	Если Не ЗначениеЗаполнено(Объект.ЗаказПокупателя) Тогда
		Возврат;
	КонецЕсли;

	ИсточникЗаказПоставщику = АС_ПолучитьСсылкуТекущегоЗаказаПоставщикуНаСервере();
	ЗаказПокупателяОбъект = Объект.ЗаказПокупателя.ПолучитьОбъект();
	РаспределениеОтмен = АС_ПолучитьРаспределениеОтменНаСервере(
		ЗаказПокупателяОбъект, ИсточникЗаказПоставщику);
	Для Каждого СвязьПоставки Из ЗаказПокупателяОбъект.АС_ИсточникиПоставок Цикл
		Если СвязьПоставки.ЗаказПоставщику <> ИсточникЗаказПоставщику Тогда
			Продолжить;
		КонецЕсли;

		СтрокаПоставщикаНайдена = Ложь;
		Для Каждого СтрокаПоставщика Из Объект.Запасы Цикл
			Если СтрокаПоставщика.КлючСвязи = СвязьПоставки.КлючСвязиЗаказаПоставщику Тогда
				СтрокаПоставщикаНайдена = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если СтрокаПоставщикаНайдена Тогда
			Продолжить;
		КонецЕсли;
		СвязьПокрытаОтменой = Ложь;
		Для Каждого СтрокаОтмены Из РаспределениеОтмен Цикл
			Если СтрокаОтмены.КлючСвязиЗаказаПоставщику =
				СвязьПоставки.КлючСвязиЗаказаПоставщику Тогда
				СвязьПокрытаОтменой = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если СвязьПокрытаОтменой Тогда
			Продолжить;
		КонецЕсли;

		СтрокаБуфера = СкопированныеСтроки.Добавить();
		СтрокаБуфера.Количество = СвязьПоставки.Количество;
		СтрокаБуфера.Цена = СвязьПоставки.ЦенаПоставщика;
		СтрокаБуфера.АС_ИсточникЗаказПоставщика = Истина;
		СтрокаБуфера.АС_ЦенаЗаказаПоставщика = СвязьПоставки.ЦенаПоставщика;
		СтрокаБуфера.АС_ОтменитьВЗаказеПокупателя = Ложь;
		СтрокаБуфера.АС_УдалитьИзЗаказаПокупателя = Истина;
		СтрокаБуфера.АС_ЗаказПоставщику = ИсточникЗаказПоставщику;
		СтрокаБуфера.АС_КлючСвязиЗаказаПоставщику = СвязьПоставки.КлючСвязиЗаказаПоставщику;
	КонецЦикла;

	Для Каждого СтрокаПокупателя Из ЗаказПокупателяОбъект.Запасы Цикл
		Если СтрокаПокупателя.АС_ЗаказПоставщику <> ИсточникЗаказПоставщику Тогда
			Продолжить;
		КонецЕсли;

		РеестроваяСвязьНайдена = Ложь;
		Для Каждого СвязьПоставки Из ЗаказПокупателяОбъект.АС_ИсточникиПоставок Цикл
			Если СвязьПоставки.ЗаказПоставщику = ИсточникЗаказПоставщику
				И СвязьПоставки.КлючСвязиЗаказаПоставщику =
					СтрокаПокупателя.АС_КлючСвязиЗаказаПоставщику Тогда
				РеестроваяСвязьНайдена = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если РеестроваяСвязьНайдена Тогда
			Продолжить;
		КонецЕсли;

		СтрокаПоставщикаНайдена = Ложь;
		Для Каждого СтрокаПоставщика Из Объект.Запасы Цикл
			Если СтрокаПоставщика.КлючСвязи =
				СтрокаПокупателя.АС_КлючСвязиЗаказаПоставщику Тогда
				СтрокаПоставщикаНайдена = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если СтрокаПоставщикаНайдена Тогда
			Продолжить;
		КонецЕсли;

		СвязьПокрытаОтменой = Ложь;
		Для Каждого СтрокаОтмены Из РаспределениеОтмен Цикл
			Если СтрокаОтмены.КлючСвязиЗаказаПоставщику =
				СтрокаПокупателя.АС_КлючСвязиЗаказаПоставщику Тогда
				СвязьПокрытаОтменой = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если СвязьПокрытаОтменой Тогда
			Продолжить;
		КонецЕсли;

		СтрокаБуфера = СкопированныеСтроки.Добавить();
		СтрокаБуфера.Номенклатура = СтрокаПокупателя.Номенклатура;
		СтрокаБуфера.Характеристика = СтрокаПокупателя.Характеристика;
		СтрокаБуфера.Количество = СтрокаПокупателя.Количество;
		СтрокаБуфера.Цена = СтрокаПокупателя.АС_ИсходнаяЦенаЗаказаПоставщика;
		СтрокаБуфера.АС_ИсточникЗаказПоставщика = Истина;
		СтрокаБуфера.АС_ЦенаЗаказаПоставщика = СтрокаПокупателя.АС_ИсходнаяЦенаЗаказаПоставщика;
		СтрокаБуфера.АС_ОтменитьВЗаказеПокупателя = Ложь;
		СтрокаБуфера.АС_УдалитьИзЗаказаПокупателя = Истина;
		СтрокаБуфера.АС_ЗаказПоставщику = ИсточникЗаказПоставщику;
		СтрокаБуфера.АС_КлючСвязиЗаказаПоставщику =
			СтрокаПокупателя.АС_КлючСвязиЗаказаПоставщику;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
&После("КонтрагентПриИзменении")
Процедура АС_ПослеИзмененияКонтрагентаРынок(Элемент)

	АС_НастроитьТаблицуРынка();

КонецПроцедуры

&НаКлиенте
&После("ДоговорПриИзменении")
Процедура АС_ПослеИзмененияДоговораРынок(Элемент)

	АС_НастроитьТаблицуРынка();

КонецПроцедуры

&НаКлиенте
&После("УстановитьВидимостьИДоступность")
Процедура АС_ПослеУстановкиВидимостиРынок()

	АС_НастроитьТаблицуРынка();

КонецПроцедуры

&НаКлиенте
Процедура АС_НастроитьТаблицуРынка()

	Если АС_ВыполняетсяВосстановлениеВидимости = Неопределено Тогда
		АС_ВыполняетсяВосстановлениеВидимости = Ложь;
	КонецЕсли;

	Если АС_РежимПоставщикаРынок = Неопределено Тогда
		АС_РежимПоставщикаРынок = Ложь;
	КонецЕсли;

	Если АС_ВыполняетсяВосстановлениеВидимости Тогда
		Возврат;
	КонецЕсли;

	ПоставщикРынок = АС_ПоставщикРынокНаСервере();
	Если Не ПоставщикРынок Тогда
		Если АС_РежимПоставщикаРынок Тогда
			АС_ВыполняетсяВосстановлениеВидимости = Истина;
			УстановитьВидимостьИДоступность();
			Если АС_ИсходнаяВидимостьКолонокРынка <> Неопределено Тогда
				Для Каждого ИмяИВидимость Из АС_ИсходнаяВидимостьКолонокРынка Цикл
					ЭлементФормы = Элементы.Найти(ИмяИВидимость.Ключ);
					Если ЭлементФормы <> Неопределено Тогда
						ЭлементФормы.Видимость = ИмяИВидимость.Значение;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			АС_ИсходнаяВидимостьКолонокРынка = Неопределено;
			АС_ВыполняетсяВосстановлениеВидимости = Ложь;
		КонецЕсли;
		АС_РежимПоставщикаРынок = Ложь;
		Возврат;
	КонецЕсли;

	Если АС_ИсходнаяВидимостьКолонокРынка = Неопределено Тогда
		АС_ИсходнаяВидимостьКолонокРынка = Новый Соответствие;
		Для Каждого ИмяЭлемента Из АС_ИменаКолонокТаблицыРынка() Цикл
			ЭлементФормы = Элементы.Найти(ИмяЭлемента);
			Если ЭлементФормы <> Неопределено Тогда
				АС_ИсходнаяВидимостьКолонокРынка.Вставить(ИмяЭлемента, ЭлементФормы.Видимость);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Для Каждого ИмяЭлемента Из АС_ИменаКолонокТаблицыРынка() Цикл
		ЭлементФормы = Элементы.Найти(ИмяЭлемента);
		Если ЭлементФормы <> Неопределено Тогда
			ЭлементФормы.Видимость = Ложь;
		КонецЕсли;
	КонецЦикла;

	Для Каждого ИмяЭлемента Из СтрРазделить("ЗапасыНоменклатура,ЗапасыКоличество,ЗапасыАС_Поступление", ",") Цикл
		ЭлементФормы = Элементы.Найти(ИмяЭлемента);
		Если ЭлементФормы <> Неопределено Тогда
			ЭлементФормы.Видимость = Истина;
		КонецЕсли;
	КонецЦикла;

	АС_РежимПоставщикаРынок = Истина;

КонецПроцедуры

&НаСервере
Функция АС_ПоставщикРынокНаСервере()

	Если Не ЗначениеЗаполнено(Объект.Контрагент) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ВРег(СокрЛП(Объект.Контрагент.Наименование)) = ВРег("Рынок");

КонецФункции

