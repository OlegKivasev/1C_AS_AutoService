&НаСервере
Процедура АС_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	АС_ПоступлениеЗаказовПоставщикамСервер.ЗаполнитьСтатусыПоступления(Объект);

КонецПроцедуры

&НаКлиенте
&Перед("ПередЗаписью")
Процедура АС_ПередЗаписьюПеред(Отказ, ПараметрыЗаписи)

	Если ПараметрыЗаписи.РежимЗаписи <> РежимЗаписиДокумента.Проведение Тогда
		Возврат;
	КонецЕсли;

	Если АС_ПроведениеПослеПроверкиТоваров Тогда
		АС_ПроведениеПослеПроверкиТоваров = Ложь;
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.ЗаказПокупателя)
		Или Не АС_ЕстьНедостающиеТоварыВЗаказеПокупателяНаСервере() Тогда
		Возврат;
	КонецЕсли;

	Отказ = Истина;
	АС_ПараметрыЗаписиДляПроведения = АС_СкопироватьПараметрыЗаписи(ПараметрыЗаписи);
	ПоказатьВопрос(
		Новый ОписаниеОповещения("АС_ПодтверждениеДобавленияТоваровЗавершение", ЭтотОбъект),
		"В заказ покупателя не добавлены соответствующие товары." + Символы.ПС
			+ "Да — добавить товары и провести заказ поставщику." + Символы.ПС
			+ "Нет — провести заказ поставщику без добавления.",
		РежимДиалогаВопрос.ДаНет,
		0,
		КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Функция АС_СкопироватьПараметрыЗаписи(ИсходныеПараметры)

	Результат = Новый Структура;
	Для Каждого ЭлементПараметров Из ИсходныеПараметры Цикл
		Результат.Вставить(ЭлементПараметров.Ключ, ЭлементПараметров.Значение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура АС_ПодтверждениеДобавленияТоваровЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		АС_ЗаполнитьЗаказПокупателяПоЗаказуПоставщика(Неопределено);
	КонецЕсли;

	АС_ПроведениеПослеПроверкиТоваров = Истина;
	Записать(АС_ПараметрыЗаписиДляПроведения);
	АС_ПараметрыЗаписиДляПроведения = Неопределено;

КонецПроцедуры

&НаСервере
Функция АС_ЕстьНедостающиеТоварыВЗаказеПокупателяНаСервере()

	ЗаказПокупателяОбъект = Объект.ЗаказПокупателя.ПолучитьОбъект();
	Для Каждого СтрокаПоставщика Из Объект.Запасы Цикл
		Если Не ЗначениеЗаполнено(СтрокаПоставщика.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;

		ТоварНайден = Ложь;
		Для Каждого СтрокаПокупателя Из ЗаказПокупателяОбъект.Запасы Цикл
			Если СтрокаПокупателя.Номенклатура = СтрокаПоставщика.Номенклатура
				И СтрокаПокупателя.Характеристика = СтрокаПоставщика.Характеристика Тогда
				ТоварНайден = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если Не ТоварНайден Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

&НаКлиенте
Процедура АС_ЗаполнитьЗаказПокупателяПоЗаказуПоставщика(Команда)

	Если Не ЗначениеЗаполнено(Объект.ЗаказПокупателя) Тогда
		Сообщить("Укажите связанный заказ покупателя.");
		Возврат;
	КонецЕсли;

	Если Объект.Запасы.Количество() = 0 Тогда
		Сообщить("В заказе поставщику нет товаров для переноса.");
		Возврат;
	КонецЕсли;

	АС_СкопироватьВсеТоварыВБуферНаСервере();

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Ключ", Объект.ЗаказПокупателя);
	ПараметрыФормы.Вставить("АС_АвтозаполнениеИзЗаказаПоставщика", Истина);
	ОткрытьФорму("Документ.ЗаказПокупателя.ФормаОбъекта", ПараметрыФормы);

КонецПроцедуры

&НаСервере
Процедура АС_СкопироватьВсеТоварыВБуферНаСервере()

	ВыделенныеСтроки = Новый Массив;
	Для Каждого СтрокаТовара Из Объект.Запасы Цикл
		ВыделенныеСтроки.Добавить(СтрокаТовара.ПолучитьИдентификатор());
	КонецЦикла;

	КоличествоСкопированных = 0;
	КопированиеТабличнойЧастиСервер.Копировать(
		Объект.Запасы, ВыделенныеСтроки, КоличествоСкопированных);
	АС_КопироватьСтрокиНаСервереПосле("Запасы", КоличествоСкопированных);

КонецПроцедуры

&НаСервере
&После("ПриЧтенииНаСервере")
Процедура АС_ПриЧтенииНаСервере(ТекущийОбъект)

	АС_ПоступлениеЗаказовПоставщикамСервер.ЗаполнитьСтатусыПоступления(Объект);

КонецПроцедуры

&НаСервере
&После("КопироватьСтрокиНаСервере")
Процедура АС_КопироватьСтрокиНаСервереПосле(ИмяТЧ, КоличествоСкопированных)

	Если ИмяТЧ <> "Запасы" Или КоличествоСкопированных = 0 Тогда
		Возврат;
	КонецЕсли;

	СкопированныеСтроки = ХранилищеОбщихНастроек.Загрузить(
		"БуферОбменаТабличныеЧасти", "Строки");
	Если СкопированныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИмяКолонкиИсточника = "АС_ИсточникЗаказПоставщика";
	Если СкопированныеСтроки.Колонки.Найти(ИмяКолонкиИсточника) = Неопределено Тогда
		СкопированныеСтроки.Колонки.Добавить(ИмяКолонкиИсточника, Новый ОписаниеТипов("Булево"));
	КонецЕсли;
	ИмяКолонкиЦены = "АС_ЦенаЗаказаПоставщика";
	Если СкопированныеСтроки.Колонки.Найти(ИмяКолонкиЦены) = Неопределено Тогда
		СкопированныеСтроки.Колонки.Добавить(ИмяКолонкиЦены, Новый ОписаниеТипов("Число"));
	КонецЕсли;

	Для Каждого Строка Из СкопированныеСтроки Цикл
		Строка[ИмяКолонкиИсточника] = Истина;
		Строка[ИмяКолонкиЦены] = Строка.Цена;
	КонецЦикла;
	ХранилищеОбщихНастроек.Сохранить("БуферОбменаТабличныеЧасти", "Строки", СкопированныеСтроки);

КонецПроцедуры
