#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

&Вместо("ОбработкаЗаполнения")
Процедура АС_ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)

	СсылкаЗаказаНаряда = АС_СсылкаЗаказаНаряда(ДанныеЗаполнения);
	Если Не ЗначениеЗаполнено(СсылкаЗаказаНаряда) Тогда
		ПродолжитьВызов();
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;
	СведенияПрослеживаемости.Очистить();

	ДанныеДляЗаполнения = Новый Структура;
	МассивЗаказов = Новый Массив;
	МассивЗаказов.Добавить(СсылкаЗаказаНаряда);
	ДанныеДляЗаполнения.Вставить("МассивЗаказовПокупателей", МассивЗаказов);

	ПредыдущийРежим = АС_ЗаполнениеРасходнойНакладнойСервер.ИсключатьНеСписываемыеСтроки();
	АС_ЗаполнениеРасходнойНакладнойСервер.УстановитьИсключениеНеСписываемыхСтрок(Истина);

	Попытка
		ЗаполнитьПоСтруктуре(ДанныеДляЗаполнения);
	Исключение
		АС_ЗаполнениеРасходнойНакладнойСервер.УстановитьИсключениеНеСписываемыхСтрок(ПредыдущийРежим);
		ВызватьИсключение;
	КонецПопытки;

	АС_ЗаполнениеРасходнойНакладнойСервер.УстановитьИсключениеНеСписываемыхСтрок(ПредыдущийРежим);

	Если Запасы.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'В заказе-наряде нет товаров для включения в расходную накладную.'");
	КонецЕсли;

КонецПроцедуры

Функция АС_СсылкаЗаказаНаряда(ДанныеЗаполнения)

	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеЗаполнения, "ВидОперации") = Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаряд Тогда
			Возврат ДанныеЗаполнения;
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		Если ДанныеЗаполнения.Свойство("Основание")
			И ТипЗнч(ДанныеЗаполнения.Основание) = Тип("ДокументСсылка.ЗаказПокупателя")
			И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеЗаполнения.Основание, "ВидОперации") = Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаряд Тогда
			Возврат ДанныеЗаполнения.Основание;
		КонецЕсли;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

#КонецЕсли
