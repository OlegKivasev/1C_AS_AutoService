&НаКлиенте
Перем АС_ВыборРежимаУстановкиЦенПоказан;

&НаКлиенте
Перем АС_ОставлятьТолькоМагазинныеТовары;

&НаКлиенте
&После("ПриОткрытии")
Процедура АС_ПриОткрытииПосле(Отказ)

	АС_ПоказатьВыборРежимаУстановкиЦен();

КонецПроцедуры

&НаКлиенте
&После("ОбработатьРезультатЗаполненияЦенПоДаннымИБ")
Процедура АС_ОбработатьРезультатЗаполненияЦенПоДаннымИБПосле(Результат, ДополнительныеПараметры)

	АС_ПовторноПрименитьРежимТолькоМагазин();

КонецПроцедуры

&НаКлиенте
&После("ОбработатьЗаполненияДокументаПриОткрытии")
Процедура АС_ОбработатьЗаполненияДокументаПриОткрытииПосле(Результат, ДополнительныеПараметры)

	АС_ПовторноПрименитьРежимТолькоМагазин();

КонецПроцедуры

&НаКлиенте
Процедура АС_ПоказатьВыборРежимаУстановкиЦен()

	Если АС_ВыборРежимаУстановкиЦенПоказан = Истина
		Или Не АС_НужноВыбратьРежимУстановкиЦенНаСервере() Тогда
		Возврат;
	КонецЕсли;

	АС_ВыборРежимаУстановкиЦенПоказан = Истина;

	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить(
		"ТолькоМагазин",
		"Установить цены только на товары в магазине");
	Кнопки.Добавить(
		"ВсеТовары",
		"Установить цены на все товары");

	ПоказатьВопрос(
		Новый ОписаниеОповещения(
			"АС_ВыборРежимаУстановкиЦенЗавершение", ЭтотОбъект),
		"В приходной накладной есть товары для заказов покупателей и товары для магазина. На какие товары установить цены?",
		Кнопки,
		,
		"ВсеТовары");

КонецПроцедуры

&НаКлиенте
Процедура АС_ВыборРежимаУстановкиЦенЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> "ТолькоМагазин" Тогда
		АС_ОставлятьТолькоМагазинныеТовары = Ложь;
		Возврат;
	КонецЕсли;

	АС_ОставлятьТолькоМагазинныеТовары = Истина;
	АС_ОставитьТолькоМагазинныеТоварыНаСервере();
	ОбновитьКоличествоЗаписейПоДокументу();
	Модифицированность = Истина;

КонецПроцедуры

&НаКлиенте
Процедура АС_ПовторноПрименитьРежимТолькоМагазин()

	Если АС_ОставлятьТолькоМагазинныеТовары <> Истина Тогда
		Возврат;
	КонецЕсли;

	АС_ОставитьТолькоМагазинныеТоварыНаСервере();
	ОбновитьКоличествоЗаписейПоДокументу();

КонецПроцедуры

&НаСервере
Функция АС_НужноВыбратьРежимУстановкиЦенНаСервере()

	Если ЗначениеЗаполнено(Объект.Ссылка)
		Или ТипЗнч(Объект.ДокументОснование) <> Тип("ДокументСсылка.ПриходнаяНакладная")
		Или Не ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		Возврат Ложь;
	КонецЕсли;

	ДанныеПоступления = АС_ПолучитьКлассификациюТоваровПоступленияНаСервере();
	Возврат ДанныеПоступления.ЕстьТоварыВМагазин
		И ДанныеПоступления.ЕстьТоварыНаЗаказ;

КонецФункции

&НаСервере
Процедура АС_ОставитьТолькоМагазинныеТоварыНаСервере()

	ДанныеПоступления = АС_ПолучитьКлассификациюТоваровПоступленияНаСервере();
	Если Не ДанныеПоступления.ЕстьТоварыВМагазин
		Или Не ДанныеПоступления.ЕстьТоварыНаЗаказ Тогда
		Возврат;
	КонецЕсли;

	Индекс = Объект.Запасы.Количество() - 1;
	Пока Индекс >= 0 Цикл
		СтрокаЦен = Объект.Запасы[Индекс];
		Если Не АС_ЕстьМагазинныйТовар(
			ДанныеПоступления.МагазинныеТовары,
			СтрокаЦен.Номенклатура,
			СтрокаЦен.Характеристика,
			СтрокаЦен.ЕдиницаИзмерения) Тогда
			Объект.Запасы.Удалить(СтрокаЦен);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

	ЗаполнитьТаблицуНоменклатурыИХарактеристикПоДокументу(Истина, Ложь);

КонецПроцедуры

&НаСервере
Функция АС_ПолучитьКлассификациюТоваровПоступленияНаСервере()

	МагазинныеТовары = Новый ТаблицаЗначений;
	МагазинныеТовары.Колонки.Добавить("Номенклатура");
	МагазинныеТовары.Колонки.Добавить("Характеристика");
	МагазинныеТовары.Колонки.Добавить("ЕдиницаИзмерения");

	Результат = Новый Структура(
		"ЕстьТоварыВМагазин,ЕстьТоварыНаЗаказ,МагазинныеТовары",
		Ложь,
		Ложь,
		МагазинныеТовары);

	Если ТипЗнч(Объект.ДокументОснование) <> Тип("ДокументСсылка.ПриходнаяНакладная")
		Или Не ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		ПоступлениеОбъект = Объект.ДокументОснование.ПолучитьОбъект();
	Исключение
		Возврат Результат;
	КонецПопытки;

	ОбъектыЗаказовПоставщикам = Новый Соответствие;
	Для Каждого СтрокаПоступления Из ПоступлениеОбъект.Запасы Цикл
		Если Не ЗначениеЗаполнено(СтрокаПоступления.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;

		Если АС_СтрокаСвязанаСЗаказомПокупателяНаСервере(
			СтрокаПоступления,
			ПоступлениеОбъект.Заказ,
			ОбъектыЗаказовПоставщикам) Тогда
			Результат.ЕстьТоварыНаЗаказ = Истина;
		Иначе
			Результат.ЕстьТоварыВМагазин = Истина;
			Если Не АС_ЕстьМагазинныйТовар(
				МагазинныеТовары,
				СтрокаПоступления.Номенклатура,
				СтрокаПоступления.Характеристика,
				СтрокаПоступления.ЕдиницаИзмерения) Тогда
				НоваяСтрока = МагазинныеТовары.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПоступления);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервере
Функция АС_СтрокаСвязанаСЗаказомПокупателяНаСервере(
	СтрокаПоступления, ЗаказПоставщикуИзШапки, ОбъектыЗаказовПоставщикам)

	Если ТипЗнч(СтрокаПоступления.ЗаказПокупателя) = Тип("ДокументСсылка.ЗаказПокупателя")
		И ЗначениеЗаполнено(СтрокаПоступления.ЗаказПокупателя) Тогда
		Возврат Истина;
	КонецЕсли;

	ЗаказПоставщику = СтрокаПоступления.Заказ;
	Если ТипЗнч(ЗаказПоставщику) <> Тип("ДокументСсылка.ЗаказПоставщику")
		Или Не ЗначениеЗаполнено(ЗаказПоставщику) Тогда
		ЗаказПоставщику = ЗаказПоставщикуИзШапки;
	КонецЕсли;
	Если ТипЗнч(ЗаказПоставщику) <> Тип("ДокументСсылка.ЗаказПоставщику")
		Или Не ЗначениеЗаполнено(ЗаказПоставщику) Тогда
		Возврат Ложь;
	КонецЕсли;

	ЗаказПоставщикуОбъект = ОбъектыЗаказовПоставщикам.Получить(ЗаказПоставщику);
	Если ЗаказПоставщикуОбъект = Неопределено Тогда
		ЗаказПоставщикуОбъект = ЗаказПоставщику.ПолучитьОбъект();
		ОбъектыЗаказовПоставщикам.Вставить(ЗаказПоставщику, ЗаказПоставщикуОбъект);
	КонецЕсли;

	Если ЗаказПоставщикуОбъект.ПоложениеЗаказаПокупателя <>
		ПредопределенноеЗначение("Перечисление.ПоложениеРеквизитаНаФорме.ВТабличнойЧасти")
		И ЗначениеЗаполнено(ЗаказПоставщикуОбъект.ЗаказПокупателя) Тогда
		Возврат Истина;
	КонецЕсли;

	Для Каждого СтрокаЗаказаПоставщику Из ЗаказПоставщикуОбъект.Запасы Цикл
		Если СтрокаЗаказаПоставщику.Номенклатура = СтрокаПоступления.Номенклатура
			И СтрокаЗаказаПоставщику.Характеристика = СтрокаПоступления.Характеристика
			И ЗначениеЗаполнено(СтрокаЗаказаПоставщику.ЗаказПокупателя) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

&НаСервереБезКонтекста
Функция АС_ЕстьМагазинныйТовар(
	МагазинныеТовары, Номенклатура, Характеристика, ЕдиницаИзмерения)

	Отбор = Новый Структура(
		"Номенклатура,Характеристика,ЕдиницаИзмерения",
		Номенклатура,
		Характеристика,
		ЕдиницаИзмерения);
	Возврат МагазинныеТовары.НайтиСтроки(Отбор).Количество() > 0;

КонецФункции
