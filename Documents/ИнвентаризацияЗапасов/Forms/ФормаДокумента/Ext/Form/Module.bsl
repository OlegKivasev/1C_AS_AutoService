	АС_ОбновитьНесогласованныеСтроки();
	ПараметрыОтбора = Новый Структура("АС_Несогласован", Истина);
	НайденныеСтроки = Объект.Запасы.НайтиСтроки(ПараметрыОтбора);

	Элементы.Запасы.ОтборСтрок = Новый ФиксированнаяСтруктура("АС_Несогласован", Истина);
	Элементы.ДекорацияОтбор.Заголовок = ИнформацияОбОтборе(
		СтрШаблон(НСтр("ru = 'Несогласованные (%1)'"), НайденныеСтроки.Количество()));
	Элементы.ДекорацияОтбор.Видимость = Истина;

КонецПроцедуры

