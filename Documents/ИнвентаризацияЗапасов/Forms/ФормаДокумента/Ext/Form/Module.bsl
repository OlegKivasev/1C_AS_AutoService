КонецПроцедуры

&НаСервере
Процедура АС_ДобавитьКолонкуАктивныхЗаказов()

	ИмяКолонки = "АС_ЗапасыКоличествоВАктивныхЗаказах";
	Если Элементы.Найти(ИмяКолонки) = Неопределено Тогда
		Колонка = Элементы.Добавить(ИмяКолонки, Тип("ПолеФормы"), Элементы.Запасы);
		Колонка.Вид = ВидПоляФормы.ПолеВвода;
		Колонка.ПутьКДанным = "Объект.Запасы.АС_КоличествоВАктивныхЗаказах";
		Колонка.Заголовок = "В активных" + Символы.ПС + "заказах";
		Колонка.Подсказка = "Суммарное количество товара в незавершенных заказах покупателей и заказ-нарядах.";
		Колонка.ТолькоПросмотр = Истина;
		Колонка.Ширина = 11;
		Колонка.Формат = "ЧН=0; ЧДЦ=3";
		Элементы.Переместить(Колонка, Элементы.Запасы, Элементы.ЗапасыКоличествоУчет);
	КонецЕсли;

	ИмяКолонки = "АС_ЗапасыКоличествоВЗавершенныхЗаказахПослеИнвентаризации";
	Если Элементы.Найти(ИмяКолонки) = Неопределено Тогда
		Колонка = Элементы.Добавить(ИмяКолонки, Тип("ПолеФормы"), Элементы.Запасы);
		Колонка.Вид = ВидПоляФормы.ПолеВвода;
		Колонка.ПутьКДанным = "Объект.Запасы.АС_КоличествоВЗавершенныхЗаказахПослеИнвентаризации";
		Колонка.Заголовок = "Расход" + Символы.ПС + "после инв.";
		Колонка.Подсказка = "Суммарный расход товара после даты инвентаризации по расходным накладным и успешно завершённым заказ-нарядам.";
		Колонка.ТолькоПросмотр = Истина;
		Колонка.Ширина = 12;
		Колонка.Формат = "ЧН=0; ЧДЦ=3";
		Элементы.Переместить(Колонка, Элементы.Запасы, Элементы.ЗапасыКоличествоУчет);
	КонецЕсли;

	ИмяКолонки = "АС_ЗапасыТекущийОстаток";
	Если Элементы.Найти(ИмяКолонки) = Неопределено Тогда
		Колонка = Элементы.Добавить(ИмяКолонки, Тип("ПолеФормы"), Элементы.Запасы);
		Колонка.Вид = ВидПоляФормы.ПолеВвода;
		Колонка.ПутьКДанным = "Объект.Запасы.АС_ТекущийОстаток";
		Колонка.Заголовок = "Остаток" + Символы.ПС + "сейчас";
		Колонка.Подсказка = "Текущий остаток товара по организации, складу, характеристике, партии и ячейке.";
		Колонка.ТолькоПросмотр = Истина;
		Колонка.Ширина = 11;
		Колонка.Формат = "ЧН=0; ЧДЦ=3";
		Элементы.Переместить(Колонка, Элементы.Запасы, Элементы.ЗапасыЕдиницаИзмерения);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура АС_ЗаполнитьКоличествоВАктивныхЗаказах()

	НоменклатураДокумента = Новый Массив;
	Для Каждого СтрокаЗапасов Из Объект.Запасы Цикл
		СтрокаЗапасов.АС_КоличествоВАктивныхЗаказах = 0;
		СтрокаЗапасов.АС_КоличествоВЗавершенныхЗаказахПослеИнвентаризации = 0;
		СтрокаЗапасов.АС_ПроданИлиВАктивномЗаказе = Ложь;
		Если ЗначениеЗаполнено(СтрокаЗапасов.Номенклатура) Тогда
			НоменклатураДокумента.Добавить(СтрокаЗапасов.Номенклатура);
		КонецЕсли;
	КонецЦикла;

	Если НоменклатураДокумента.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|    СтрокиЗапасов.Номенклатура КАК Номенклатура,
		|    СУММА(СтрокиЗапасов.Количество) КАК Количество
		|ИЗ
		|    Документ.ЗаказПокупателя.Запасы КАК СтрокиЗапасов
		|        ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя КАК Заказ
		|        ПО СтрокиЗапасов.Ссылка = Заказ.Ссылка
		|ГДЕ
		|    СтрокиЗапасов.Номенклатура В (&НоменклатураДокумента)
		|    И НЕ Заказ.ПометкаУдаления
		|    И Заказ.ВидОперации В (
		|        ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаПродажу),
		|        ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаряд))
		|    И Заказ.СостояниеЗаказа <> ЗНАЧЕНИЕ(Справочник.СостоянияЗаказовПокупателей.Завершен)
		|    И Заказ.СостояниеЗаказа <> ЗНАЧЕНИЕ(Справочник.СостоянияЗаказНарядов.Завершен)
		|
		|СГРУППИРОВАТЬ ПО
		|    СтрокиЗапасов.Номенклатура";
	Запрос.УстановитьПараметр("НоменклатураДокумента", НоменклатураДокумента);

	КоличествоПоНоменклатуре = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		КоличествоПоНоменклатуре.Вставить(Выборка.Номенклатура, Выборка.Количество);
	КонецЦикла;

	КоличествоВЗавершенныхЗаказахПоНоменклатуре = Новый Соответствие;
	Если ЗначениеЗаполнено(Объект.Дата)
		И ЗначениеЗаполнено(Компания)
		И ЗначениеЗаполнено(Объект.СтруктурнаяЕдиница) Тогда

		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|    ДвиженияЗапасов.Номенклатура КАК Номенклатура,
			|    СУММА(ДвиженияЗапасов.Количество) КАК Количество
			|ИЗ
			|    РегистрНакопления.Запасы КАК ДвиженияЗапасов
			|        ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя КАК ЗаказНаряд
			|        ПО ДвиженияЗапасов.Регистратор = ЗаказНаряд.Ссылка
			|ГДЕ
			|    ДвиженияЗапасов.Номенклатура В (&НоменклатураДокумента)
			|    И ДвиженияЗапасов.Активность
			|    И ДвиженияЗапасов.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
			|    И ДвиженияЗапасов.Период > &ДатаИнвентаризации
			|    И ДвиженияЗапасов.Период <= &ТекущаяДата
			|    И ДвиженияЗапасов.Организация = &Организация
			|    И ДвиженияЗапасов.СтруктурнаяЕдиница = &СтруктурнаяЕдиница
			|    И (
			|        ДвиженияЗапасов.Регистратор ССЫЛКА Документ.РасходнаяНакладная
			|        ИЛИ (
			|            ЗаказНаряд.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаряд)
			|            И НЕ ЗаказНаряд.ПометкаУдаления
			|            И ЗаказНаряд.Проведен
			|            И ЗаказНаряд.СостояниеЗаказа = ЗНАЧЕНИЕ(Справочник.СостоянияЗаказНарядов.Завершен)
			|            И ЗаказНаряд.ВариантЗавершения = ЗНАЧЕНИЕ(Перечисление.ВариантыЗавершенияЗаказа.Успешно)
			|        )
			|    )
			|
			|СГРУППИРОВАТЬ ПО
			|    ДвиженияЗапасов.Номенклатура";
		Запрос.УстановитьПараметр("НоменклатураДокумента", НоменклатураДокумента);
		Запрос.УстановитьПараметр("ДатаИнвентаризации", Объект.Дата);
		Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
		Запрос.УстановитьПараметр("Организация", Компания);
		Запрос.УстановитьПараметр("СтруктурнаяЕдиница", Объект.СтруктурнаяЕдиница);

		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			КоличествоВЗавершенныхЗаказахПоНоменклатуре.Вставить(
				Выборка.Номенклатура, Выборка.Количество);
		КонецЦикла;
	КонецЕсли;

	НоменклатураСРасходомПослеИнвентаризации = Новый Соответствие;
	Если ЗначениеЗаполнено(Объект.Дата)
		И ЗначениеЗаполнено(Компания)
		И ЗначениеЗаполнено(Объект.СтруктурнаяЕдиница) Тогда

		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|    ДвиженияЗапасов.Номенклатура КАК Номенклатура
			|ИЗ
			|    РегистрНакопления.Запасы КАК ДвиженияЗапасов
			|ГДЕ
			|    ДвиженияЗапасов.Активность
			|    И ДвиженияЗапасов.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
			|    И ДвиженияЗапасов.Период > &ДатаИнвентаризации
			|    И ДвиженияЗапасов.Период <= &ТекущаяДата
			|    И ДвиженияЗапасов.Организация = &Организация
			|    И ДвиженияЗапасов.СтруктурнаяЕдиница = &СтруктурнаяЕдиница
			|    И ДвиженияЗапасов.Номенклатура В (&НоменклатураДокумента)";
		Запрос.УстановитьПараметр("ДатаИнвентаризации", Объект.Дата);
		Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
		Запрос.УстановитьПараметр("Организация", Компания);
		Запрос.УстановитьПараметр("СтруктурнаяЕдиница", Объект.СтруктурнаяЕдиница);
		Запрос.УстановитьПараметр("НоменклатураДокумента", НоменклатураДокумента);

		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			НоменклатураСРасходомПослеИнвентаризации.Вставить(Выборка.Номенклатура, Истина);
		КонецЦикла;
	КонецЕсли;

	Для Каждого СтрокаЗапасов Из Объект.Запасы Цикл
		КоличествоВАктивныхЗаказах = КоличествоПоНоменклатуре.Получить(СтрокаЗапасов.Номенклатура);
		Если КоличествоВАктивныхЗаказах <> Неопределено Тогда
			СтрокаЗапасов.АС_КоличествоВАктивныхЗаказах = КоличествоВАктивныхЗаказах;
		КонецЕсли;
		КоличествоВЗавершенныхЗаказах = КоличествоВЗавершенныхЗаказахПоНоменклатуре.Получить(
			СтрокаЗапасов.Номенклатура);
		Если КоличествоВЗавершенныхЗаказах <> Неопределено Тогда
			СтрокаЗапасов.АС_КоличествоВЗавершенныхЗаказахПослеИнвентаризации =
				КоличествоВЗавершенныхЗаказах;
		КонецЕсли;
		СтрокаЗапасов.АС_ПроданИлиВАктивномЗаказе =
			СтрокаЗапасов.АС_КоличествоВАктивныхЗаказах <> 0
			ИЛИ НоменклатураСРасходомПослеИнвентаризации.Получить(СтрокаЗапасов.Номенклатура) <> Неопределено;
	КонецЦикла;

	АС_ЗаполнитьПризнакТребуетсяОбновитьУчетныеДанные();

КонецПроцедуры
