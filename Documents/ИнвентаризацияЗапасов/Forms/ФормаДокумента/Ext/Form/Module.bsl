	АС_ЗаполнитьКоличествоВАктивныхЗаказах();

КонецПроцедуры

&НаСервере
&После("ЗаполнитьСписокДействий")
Процедура АС_ЗаполнитьСписокДействийПосле()

	Действие = ПредопределенноеЗначение(
		"Перечисление.ДействияГрупповогоИзмененияСтрок.АС_ОбновитьТолькоУчетныеДанные");
	СписокДействий = Элементы.ЗапасыИзменениеСтрокДействие.СписокВыбора;
	Если СписокДействий.НайтиПоЗначению(Действие) = Неопределено Тогда
		СписокДействий.Добавить(Действие, НСтр("ru = 'Обновить только учётные данные'"));
	КонецЕсли;

КонецПроцедуры

