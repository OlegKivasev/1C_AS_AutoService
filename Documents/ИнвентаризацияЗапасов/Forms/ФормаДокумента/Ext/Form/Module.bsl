КонецПроцедуры

&НаКлиенте
Процедура АС_ОбновитьТолькоУчетныеДанные()

	КоличествоОбновленныхСтрок = АС_ОбновитьТолькоУчетныеДанныеНаСервере();
	Если КоличествоОбновленныхСтрок = 0 Тогда
		Сообщить(НСтр("ru = 'Не отмечены строки для обновления учётных данных.'"));
		Возврат;
	КонецЕсли;

	Модифицированность = Истина;

КонецПроцедуры

&НаКлиенте
&Вместо("ЗапасыВыполнитьДействие")
Процедура АС_ЗапасыВыполнитьДействиеВместо(Команда)

	ДействиеОбновитьУчетныеДанные = ПредопределенноеЗначение(
		"Перечисление.ДействияГрупповогоИзмененияСтрок.АС_ОбновитьТолькоУчетныеДанные");
	Если ЗапасыИзменениеСтрокДействие = ДействиеОбновитьУчетныеДанные Тогда
		АС_ОбновитьТолькоУчетныеДанные();
	Иначе
		ПродолжитьВызов(Команда);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция АС_ОбновитьТолькоУчетныеДанныеНаСервере()

	ТаблицаЗатраты = Объект.Запасы.Выгрузить();
	ТаблицаЗатраты.Колонки.Добавить("АС_ИндексСтроки",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Неотрицательный)));
	КоличествоОбновленныхСтрок = 0;

	Для ИндексСтроки = 0 По ТаблицаЗатраты.Количество() - 1 Цикл
		ТаблицаЗатраты[ИндексСтроки].АС_ИндексСтроки = ИндексСтроки;
		Если ТаблицаЗатраты[ИндексСтроки].Пометка Тогда
			КоличествоОбновленныхСтрок = КоличествоОбновленныхСтрок + 1;
		КонецЕсли;
	КонецЦикла;

	Если КоличествоОбновленныхСтрок = 0 Тогда
		Возврат 0;
	КонецЕсли;

	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст =
		"ВЫБРАТЬ
		|    ТаблицаЗатраты.Номенклатура КАК Номенклатура,
		|    ТаблицаЗатраты.Характеристика КАК Характеристика,
		|    ТаблицаЗатраты.Партия КАК Партия,
		|    ТаблицаЗатраты.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|    ТаблицаЗатраты.АС_ИндексСтроки КАК АС_ИндексСтроки
		|ПОМЕСТИТЬ ИнвентаризацияЗапасов
		|ИЗ
		|    &ТаблицаЗатраты КАК ТаблицаЗатраты
		|ГДЕ
		|    ТаблицаЗатраты.Пометка";
	Запрос.УстановитьПараметр("ТаблицаЗатраты", ТаблицаЗатраты);
	Запрос.Выполнить();

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Если ЗначениеЗаполнено(Объект.Ячейка) Тогда
		ТекстЗапроса = СформироватьТекстЗапросаУчетныеДанныеВЯчейкеНаСкладе();
		Запрос.УстановитьПараметр("Ячейка", Объект.Ячейка);
	Иначе
		ТекстЗапроса = СформироватьТекстЗапросаУчетныеДанныеНаСкладе();
	КонецЕсли;

	Запрос.Текст = ТекстЗапроса +
		"ВЫБРАТЬ
		|    ИнвентаризацияЗапасов.АС_ИндексСтроки КАК АС_ИндексСтроки,
		|    ЕСТЬNULL(ВременнаяТаблицаЗапасыОстатки.ПризнакВЯчейке, ЛОЖЬ) КАК ПризнакВЯчейке,
		|    ЕСТЬNULL(ВременнаяТаблицаЗапасыОстатки.Количество, 0)
		|        / ЕСТЬNULL(ИнвентаризацияЗапасов.ЕдиницаИзмерения.Коэффициент, 1) КАК КоличествоВЯчейке,
		|    ЕСТЬNULL(ВременнаяТаблицаЗапасыОстатки.КоличествоУчет, 0)
		|        / ЕСТЬNULL(ИнвентаризацияЗапасов.ЕдиницаИзмерения.Коэффициент, 1) КАК КоличествоУчет,
		|    ЕСТЬNULL(ВременнаяТаблицаЗапасыОстатки.СуммаУчет, 0) КАК СуммаУчет
		|ИЗ
		|    ИнвентаризацияЗапасов КАК ИнвентаризацияЗапасов
		|        ЛЕВОЕ СОЕДИНЕНИЕ ВременнаяТаблицаЗапасыОстатки КАК ВременнаяТаблицаЗапасыОстатки
		|        ПО ИнвентаризацияЗапасов.Номенклатура = ВременнаяТаблицаЗапасыОстатки.Номенклатура
		|            И ИнвентаризацияЗапасов.Характеристика = ВременнаяТаблицаЗапасыОстатки.Характеристика
		|            И ИнвентаризацияЗапасов.Партия = ВременнаяТаблицаЗапасыОстатки.Партия";

	Запрос.УстановитьПараметр("Организация", Компания);
	Запрос.УстановитьПараметр("СтруктурнаяЕдиница", Объект.СтруктурнаяЕдиница);
	Запрос.УстановитьПараметр("Период", ТекущаяДатаСеанса());

	МассивРезультатов = Запрос.ВыполнитьПакет();
	СтрокиКУдалению = Новый Массив;
	Выборка = МассивРезультатов[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаЗапасов = Объект.Запасы[Выборка.АС_ИндексСтроки];
		СтароеКоличествоУчет = СтрокаЗапасов.КоличествоУчет;
		НовоеКоличествоУчет = Выборка.КоличествоУчет;
		НоваяСуммаУчет = Выборка.СуммаУчет;

		Если Выборка.ПризнакВЯчейке
			И Выборка.КоличествоВЯчейке <> Выборка.КоличествоУчет Тогда
			НовоеКоличествоУчет = Выборка.КоличествоВЯчейке;
			Если Выборка.КоличествоВЯчейке = 0
				ИЛИ Выборка.КоличествоУчет <= 0
				ИЛИ Выборка.СуммаУчет = 0 Тогда
				НоваяСуммаУчет = 0;
			Иначе
				НоваяСуммаУчет = Выборка.СуммаУчет / Выборка.КоличествоУчет
					* НовоеКоличествоУчет;
			КонецЕсли;
		КонецЕсли;

		Если СтароеКоличествоУчет <> 0 И НовоеКоличествоУчет = 0 Тогда
			АС_ДобавитьЕдиницуТовараБезУчета(СтрокаЗапасов);
			СтрокиКУдалению.Добавить(СтрокаЗапасов);
			Продолжить;
		КонецЕсли;

		СтрокаЗапасов.КоличествоУчет = НовоеКоличествоУчет;
		СтрокаЗапасов.СуммаУчет = НоваяСуммаУчет;
		СтрокаЗапасов.АС_ТребуетОбновленияУчетныхДанных = Ложь;
	КонецЦикла;

	Для Каждого СтрокаКУдалению Из СтрокиКУдалению Цикл
		АС_УдалитьСерииУдаляемойСтроки(СтрокаКУдалению.КлючСвязи);
		Объект.Запасы.Удалить(СтрокаКУдалению);
	КонецЦикла;

	НоменклатураВДокументахСервер.ЗаполнитьПризнакиИспользованияХарактеристик(Объект);
	ОбработатьОтклонения();
	АС_ЗаполнитьКоличествоВАктивныхЗаказах();

	Возврат КоличествоОбновленныхСтрок;

КонецФункции

&НаСервере
Процедура АС_ДобавитьЕдиницуТовараБезУчета(СтрокаИсточник)

	ПараметрыПоиска = Новый Структура;
	ПараметрыПоиска.Вставить("Номенклатура", СтрокаИсточник.Номенклатура);
	ПараметрыПоиска.Вставить("Характеристика", СтрокаИсточник.Характеристика);
	ПараметрыПоиска.Вставить("Партия", СтрокаИсточник.Партия);
	ПараметрыПоиска.Вставить("ЕдиницаИзмерения", СтрокаИсточник.ЕдиницаИзмерения);
	ПараметрыПоиска.Вставить("КоличествоУчет", 0);
	ПараметрыПоиска.Вставить("СерииНоменклатуры", "");

	СтрокиБезУчета = Объект.Запасы.НайтиСтроки(ПараметрыПоиска);
	Если СтрокиБезУчета.Количество() = 0 Тогда
		СтрокаБезУчета = Объект.Запасы.Добавить();
		СтрокаБезУчета.Номенклатура = СтрокаИсточник.Номенклатура;
		СтрокаБезУчета.Характеристика = СтрокаИсточник.Характеристика;
		СтрокаБезУчета.Партия = СтрокаИсточник.Партия;
		СтрокаБезУчета.ЕдиницаИзмерения = СтрокаИсточник.ЕдиницаИзмерения;
		СтрокаБезУчета.Цена = СтрокаИсточник.Цена;
		СтрокаБезУчета.Количество = 1;
	Иначе
		СтрокаБезУчета = СтрокиБезУчета[0];
		Если СтрокаБезУчета.Цена = 0 Тогда
			СтрокаБезУчета.Цена = СтрокаИсточник.Цена;
		КонецЕсли;
		СтрокаБезУчета.Количество = СтрокаБезУчета.Количество + 1;
	КонецЕсли;

	СтрокаБезУчета.КоличествоУчет = 0;
	СтрокаБезУчета.СуммаУчет = 0;
	СтрокаБезУчета.Сумма = СтрокаБезУчета.Количество * СтрокаБезУчета.Цена;
	СтрокаБезУчета.Пометка = Истина;
	СтрокаБезУчета.АС_ТекущийОстаток = 0;
	СтрокаБезУчета.АС_ТребуетОбновленияУчетныхДанных = Ложь;

КонецПроцедуры

&НаСервере
Процедура АС_УдалитьСерииУдаляемойСтроки(КлючСвязи)

	Если КлючСвязи = 0 Тогда
		Возврат;
	КонецЕсли;

	СтрокиСерийКУдалению = Новый Массив;
	Для Каждого СтрокаСерии Из Объект.СерииНоменклатуры Цикл
		Если СтрокаСерии.КлючСвязи = КлючСвязи Тогда
			СтрокиСерийКУдалению.Добавить(СтрокаСерии);
		КонецЕсли;
	КонецЦикла;

	Для Каждого СтрокаСерии Из СтрокиСерийКУдалению Цикл
		Объект.СерииНоменклатуры.Удалить(СтрокаСерии);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура АС_ЗаполнитьПризнакТребуетсяОбновитьУчетныеДанные()

	Для Каждого СтрокаЗапасов Из Объект.Запасы Цикл
		СтрокаЗапасов.АС_ТекущийОстаток = 0;
		СтрокаЗапасов.АС_ТребуетОбновленияУчетныхДанных = Ложь;
	КонецЦикла;

	Если Объект.Запасы.Количество() = 0
		ИЛИ Не ЗначениеЗаполнено(Компания)
		ИЛИ Не ЗначениеЗаполнено(Объект.СтруктурнаяЕдиница) Тогда
		Возврат;
	КонецЕсли;

	ТаблицаЗатраты = Объект.Запасы.Выгрузить();
	ТаблицаЗатраты.Колонки.Добавить("АС_ИндексСтроки",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Неотрицательный)));
	Для ИндексСтроки = 0 По ТаблицаЗатраты.Количество() - 1 Цикл
		ТаблицаЗатраты[ИндексСтроки].АС_ИндексСтроки = ИндексСтроки;
	КонецЦикла;

	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст =
		"ВЫБРАТЬ
		|    ТаблицаЗатраты.Номенклатура КАК Номенклатура,
		|    ТаблицаЗатраты.Характеристика КАК Характеристика,
		|    ТаблицаЗатраты.Партия КАК Партия,
		|    ТаблицаЗатраты.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|    ТаблицаЗатраты.АС_ИндексСтроки КАК АС_ИндексСтроки
		|ПОМЕСТИТЬ ИнвентаризацияЗапасов
		|ИЗ
		|    &ТаблицаЗатраты КАК ТаблицаЗатраты";
	Запрос.УстановитьПараметр("ТаблицаЗатраты", ТаблицаЗатраты);
	Запрос.Выполнить();

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Если ЗначениеЗаполнено(Объект.Ячейка) Тогда
		ТекстЗапроса = СформироватьТекстЗапросаУчетныеДанныеВЯчейкеНаСкладе();
		Запрос.УстановитьПараметр("Ячейка", Объект.Ячейка);
	Иначе
		ТекстЗапроса = СформироватьТекстЗапросаУчетныеДанныеНаСкладе();
	КонецЕсли;

	Запрос.Текст = ТекстЗапроса +
		"ВЫБРАТЬ
		|    ИнвентаризацияЗапасов.АС_ИндексСтроки КАК АС_ИндексСтроки,
		|    ЕСТЬNULL(ВременнаяТаблицаЗапасыОстатки.ПризнакВЯчейке, ЛОЖЬ) КАК ПризнакВЯчейке,
		|    ЕСТЬNULL(ВременнаяТаблицаЗапасыОстатки.Количество, 0)
		|        / ЕСТЬNULL(ИнвентаризацияЗапасов.ЕдиницаИзмерения.Коэффициент, 1) КАК КоличествоВЯчейке,
		|    ЕСТЬNULL(ВременнаяТаблицаЗапасыОстатки.КоличествоУчет, 0)
		|        / ЕСТЬNULL(ИнвентаризацияЗапасов.ЕдиницаИзмерения.Коэффициент, 1) КАК КоличествоУчет
		|ИЗ
		|    ИнвентаризацияЗапасов КАК ИнвентаризацияЗапасов
		|        ЛЕВОЕ СОЕДИНЕНИЕ ВременнаяТаблицаЗапасыОстатки КАК ВременнаяТаблицаЗапасыОстатки
		|        ПО ИнвентаризацияЗапасов.Номенклатура = ВременнаяТаблицаЗапасыОстатки.Номенклатура
		|            И ИнвентаризацияЗапасов.Характеристика = ВременнаяТаблицаЗапасыОстатки.Характеристика
		|            И ИнвентаризацияЗапасов.Партия = ВременнаяТаблицаЗапасыОстатки.Партия";

	Запрос.УстановитьПараметр("Организация", Компания);
	Запрос.УстановитьПараметр("СтруктурнаяЕдиница", Объект.СтруктурнаяЕдиница);
	Запрос.УстановитьПараметр("Период", ТекущаяДатаСеанса());

	МассивРезультатов = Запрос.ВыполнитьПакет();
	Выборка = МассивРезультатов[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		ТекущееКоличествоУчет = Выборка.КоличествоУчет;
		Если Выборка.ПризнакВЯчейке
			И Выборка.КоличествоВЯчейке <> Выборка.КоличествоУчет Тогда
			ТекущееКоличествоУчет = Выборка.КоличествоВЯчейке;
		КонецЕсли;

		СтрокаЗапасов = Объект.Запасы[Выборка.АС_ИндексСтроки];
		СтрокаЗапасов.АС_ТекущийОстаток = ТекущееКоличествоУчет;
		СтрокаЗапасов.АС_ТребуетОбновленияУчетныхДанных =
			СтрокаЗапасов.КоличествоУчет <> ТекущееКоличествоУчет;
	КонецЦикла;

КонецПроцедуры

&НаСервере
&После("ПриСозданииНаСервере")
Процедура АС_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)

