&НаКлиенте
Перем АС_СтрокаКоличествоИсходная;

&НаКлиенте
Перем АС_СтрокаКоличествоСледующая;

&НаСервере
&После("ОбработатьОтклонения")
Процедура АС_ОбработатьОтклоненияПосле()

	Для Каждого СтрокаЗапасов Из Объект.Запасы Цикл
		Если СтрокаЗапасов.Количество = 0 Тогда
			СтрокаЗапасов.НедостачаСоответствуетОтбору = Ложь;
		КонецЕсли;
		СтрокаЗапасов.АС_Несогласован = Не СтрокаЗапасов.АС_Согласованность
			И СтрокаЗапасов.Количество <> 0;
	КонецЦикла;

КонецПроцедуры

&НаСервере
&После("ПередЗаписьюНаСервере")
Процедура АС_ПередЗаписьюНаСервереПосле(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаЗапасов Из ТекущийОбъект.Запасы Цикл
		Если СтрокаЗапасов.Количество = 0 Тогда
			СтрокаЗапасов.НедостачаСоответствуетОтбору = Ложь;
		КонецЕсли;
		СтрокаЗапасов.АС_Несогласован = Не СтрокаЗапасов.АС_Согласованность
			И СтрокаЗапасов.Количество <> 0;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
&Перед("ЗапасыКоличествоПриИзменении")
Процедура АС_ЗапасыКоличествоПриИзмененииПеред(Элемент)

	АС_СтрокаКоличествоИсходная = Неопределено;
	АС_СтрокаКоличествоСледующая = Неопределено;

	ОтборСтрок = Элементы.Запасы.ОтборСтрок;
	Если ОтборСтрок = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТекущаяСтрока = Элементы.Запасы.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;

	АС_СтрокаКоличествоИсходная = ТекущаяСтрока.ПолучитьИдентификатор();
	ИндексТекущейСтроки = Объект.Запасы.Индекс(ТекущаяСтрока);

	Для ИндексСтроки = ИндексТекущейСтроки + 1 По Объект.Запасы.Количество() - 1 Цикл
		Кандидат = Объект.Запасы[ИндексСтроки];
		Если АС_СтрокаСоответствуетОтбору(Кандидат, ОтборСтрок) Тогда
			АС_СтрокаКоличествоСледующая = Кандидат.ПолучитьИдентификатор();
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если АС_СтрокаКоличествоСледующая = Неопределено Тогда
		ИндексСтроки = ИндексТекущейСтроки - 1;
		Пока ИндексСтроки >= 0 Цикл
			Кандидат = Объект.Запасы[ИндексСтроки];
			Если АС_СтрокаСоответствуетОтбору(Кандидат, ОтборСтрок) Тогда
				АС_СтрокаКоличествоСледующая = Кандидат.ПолучитьИдентификатор();
				Прервать;
			КонецЕсли;
			ИндексСтроки = ИндексСтроки - 1;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция АС_СтрокаСоответствуетОтбору(СтрокаТабличнойЧасти, ОтборСтрок)

	Для Каждого ИмяОтбора Из ОтборСтрок Цикл
		Если СтрокаТабличнойЧасти[ИмяОтбора.Ключ] <> ИмяОтбора.Значение Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

&НаКлиенте
&После("ЗапасыКоличествоПриИзменении")
Процедура АС_ЗапасыКоличествоПриИзмененииПосле(Элемент)

	ИсходнаяСтрока = Неопределено;
	Если АС_СтрокаКоличествоИсходная <> Неопределено Тогда
		ИсходнаяСтрока = Объект.Запасы.НайтиПоИдентификатору(АС_СтрокаКоличествоИсходная);
	КонецЕсли;

	Если ИсходнаяСтрока = Неопределено Тогда
		АС_ОбновитьНесогласованностьТекущейСтроки();
	Иначе
		ИсходнаяСтрока.АС_Несогласован = Не ИсходнаяСтрока.АС_Согласованность
			И ИсходнаяСтрока.Количество <> 0;
	КонецЕсли;

	Если АС_СтрокаКоличествоИсходная = Неопределено
		ИЛИ АС_СтрокаКоличествоСледующая = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОтборСтрок = Элементы.Запасы.ОтборСтрок;
	Если ИсходнаяСтрока <> Неопределено
		И (ОтборСтрок = Неопределено
		ИЛИ АС_СтрокаСоответствуетОтбору(ИсходнаяСтрока, ОтборСтрок)) Тогда
		Возврат;
	КонецЕсли;

	ПодключитьОбработчикОжидания("АС_ВосстановитьТекущуюСтрокуПослеКоличество", 0.1, Истина);

КонецПроцедуры

&НаКлиенте
Процедура АС_ВосстановитьТекущуюСтрокуПослеКоличество()

	Попытка
		ОтборСтрок = Элементы.Запасы.ОтборСтрок;
		СтрокаДляВыделения = Объект.Запасы.НайтиПоИдентификатору(АС_СтрокаКоличествоСледующая);
		Если СтрокаДляВыделения <> Неопределено
			И ОтборСтрок <> Неопределено
			И АС_СтрокаСоответствуетОтбору(СтрокаДляВыделения, ОтборСтрок) Тогда
			Элементы.Запасы.ТекущаяСтрока = АС_СтрокаКоличествоСледующая;
		КонецЕсли;
	Исключение
		// Таблица могла быть закрыта или перестроена до отложенного вызова.
	КонецПопытки;

	АС_СтрокаКоличествоИсходная = Неопределено;
	АС_СтрокаКоличествоСледующая = Неопределено;

КонецПроцедуры

&НаКлиенте
Процедура АС_СогласованностьПриИзменении(Элемент)

	АС_ОбновитьНесогласованностьТекущейСтроки();

КонецПроцедуры

&НаКлиенте
Процедура АС_ОбновитьНесогласованностьТекущейСтроки()

	СтрокаЗапасов = Элементы.Запасы.ТекущиеДанные;
	Если СтрокаЗапасов = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтрокаЗапасов.НедостачаСоответствуетОтбору = СтрокаЗапасов.Количество <> 0
		И СтрокаЗапасов.Количество < СтрокаЗапасов.КоличествоУчет;
	СтрокаЗапасов.АС_Несогласован = Не СтрокаЗапасов.АС_Согласованность
		И СтрокаЗапасов.Количество <> 0;

КонецПроцедуры

&НаКлиенте
Процедура АС_ОбновитьНесогласованныеСтроки()

	Для Каждого СтрокаЗапасов Из Объект.Запасы Цикл
		Если СтрокаЗапасов.Количество = 0 Тогда
			СтрокаЗапасов.НедостачаСоответствуетОтбору = Ложь;
		КонецЕсли;
		СтрокаЗапасов.АС_Несогласован = Не СтрокаЗапасов.АС_Согласованность
			И СтрокаЗапасов.Количество <> 0;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура АС_СброситьОтборыОтклонений()

	ИзлишкиОтбор = Ложь;
	НедостачаОтбор = Ложь;
	ОтклонениеОтбор = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура АС_УстановитьОтборПоСогласованным(Команда)

	АС_СброситьОтборыОтклонений();
	ПараметрыОтбора = Новый Структура("АС_Согласованность", Истина);
	НайденныеСтроки = Объект.Запасы.НайтиСтроки(ПараметрыОтбора);

	Элементы.Запасы.ОтборСтрок = Новый ФиксированнаяСтруктура("АС_Согласованность", Истина);
	Элементы.ДекорацияОтбор.Заголовок = ИнформацияОбОтборе(
		СтрШаблон(НСтр("ru = 'Согласованные (%1)'"), НайденныеСтроки.Количество()));
	Элементы.ДекорацияОтбор.Видимость = Истина;

КонецПроцедуры

