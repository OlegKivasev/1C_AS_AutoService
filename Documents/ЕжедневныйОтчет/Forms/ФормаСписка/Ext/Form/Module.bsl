&НаСервере
&После("ПриСозданииНаСервере")
Процедура АС_ПриСозданииНаСервереЧасыПосле(Отказ, СтандартнаяОбработка)

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	ПоляЧасов = "NULL КАК Сотрудники,
	| ВЫБОР
	|  КОГДА ДЕНЬНЕДЕЛИ(ДокументЕжедневныйОтчет.ДатаОтчета) = 1 ТОГДА ""Понедельник""
	|  КОГДА ДЕНЬНЕДЕЛИ(ДокументЕжедневныйОтчет.ДатаОтчета) = 2 ТОГДА ""Вторник""
	|  КОГДА ДЕНЬНЕДЕЛИ(ДокументЕжедневныйОтчет.ДатаОтчета) = 3 ТОГДА ""Среда""
	|  КОГДА ДЕНЬНЕДЕЛИ(ДокументЕжедневныйОтчет.ДатаОтчета) = 4 ТОГДА ""Четверг""
	|  КОГДА ДЕНЬНЕДЕЛИ(ДокументЕжедневныйОтчет.ДатаОтчета) = 5 ТОГДА ""Пятница""
	|  КОГДА ДЕНЬНЕДЕЛИ(ДокументЕжедневныйОтчет.ДатаОтчета) = 6 ТОГДА ""Суббота""
	|  ИНАЧЕ ""Воскресенье"" КОНЕЦ КАК АС_ДеньНедели,
	| ВЫРАЗИТЬ(ЕСТЬNULL(ЧасыСмены.МинимумСекунд, 0) / 3600 КАК ЧИСЛО(10, 2)) КАК АС_КоличествоЧасов,
	| ЕСТЬNULL(ЧасыСмены.МинимумСекунд, 0) КАК АС_МинимумСекунд,
	| ЕСТЬNULL(ЧасыСмены.МаксимумСекунд, 0) КАК АС_МаксимумСекунд,
	| ВЫБОР КОГДА ДЕНЬНЕДЕЛИ(ДокументЕжедневныйОтчет.ДатаОтчета) >= 6
	|  ТОГДА ЕСТЬNULL(ЧасыСмены.МинимумСекунд, 0) <> 32400
	|   ИЛИ ЕСТЬNULL(ЧасыСмены.МаксимумСекунд, 0) <> 32400
	|  ИНАЧЕ ЕСТЬNULL(ЧасыСмены.МинимумСекунд, 0) <> 36000
	|   ИЛИ ЕСТЬNULL(ЧасыСмены.МаксимумСекунд, 0) <> 36000
	| КОНЕЦ КАК АС_ОтклонениеЧасов";

	Список.ТекстЗапроса = СтрЗаменить(Список.ТекстЗапроса, "NULL КАК Сотрудники", ПоляЧасов)
		+ Символы.ПС + "ЛЕВОЕ СОЕДИНЕНИЕ
	| (ВЫБРАТЬ
	|  Время.Ссылка КАК Ссылка,
	|  МИНИМУМ(ЧАС(Время.ПродолжительностьДня) * 3600
	|   + МИНУТА(Время.ПродолжительностьДня) * 60
	|   + СЕКУНДА(Время.ПродолжительностьДня)) КАК МинимумСекунд,
	|  МАКСИМУМ(ЧАС(Время.ПродолжительностьДня) * 3600
	|   + МИНУТА(Время.ПродолжительностьДня) * 60
	|   + СЕКУНДА(Время.ПродолжительностьДня)) КАК МаксимумСекунд
	| ИЗ Документ.ЕжедневныйОтчет.ОтработанноеВремя КАК Время
	| СГРУППИРОВАТЬ ПО Время.Ссылка) КАК ЧасыСмены
	| ПО ДокументЕжедневныйОтчет.Ссылка = ЧасыСмены.Ссылка";

	Список.УстановитьОбязательноеИспользование("АС_ОтклонениеЧасов", Истина);
	Список.УстановитьОбязательноеИспользование("АС_КоличествоЧасов", Истина);
	Список.УстановитьОбязательноеИспользование("АС_МинимумСекунд", Истина);
	Список.УстановитьОбязательноеИспользование("АС_МаксимумСекунд", Истина);

	Колонка = Элементы.Добавить("АС_ДеньНедели", Тип("ПолеФормы"), Элементы.Список);
	Колонка.Вид = ВидПоляФормы.ПолеНадписи;
	Колонка.ПутьКДанным = "Список.АС_ДеньНедели";
	Колонка.Заголовок = "День недели";
	Колонка.Ширина = 14;
	Элементы.Переместить(Колонка, Элементы.Список, Элементы.Сотрудники);
	Колонка = Элементы.Добавить("АС_КоличествоЧасов", Тип("ПолеФормы"), Элементы.Список);
	Колонка.Вид = ВидПоляФормы.ПолеНадписи;
	Колонка.ПутьКДанным = "Список.АС_КоличествоЧасов";
	Колонка.Заголовок = "Количество часов";
	Колонка.Подсказка = "Длительность смены сотрудника. При разных длительностях показан диапазон часов.";
	Колонка.Ширина = 14;
	Элементы.Переместить(Колонка, Элементы.Список, Элементы.Сотрудники);

КонецПроцедуры

&НаСервереБезКонтекста
&После("СписокПриПолученииДанныхНаСервере")
Процедура АС_СписокПриПолученииДанныхНаСервереЧасыПосле(ИмяЭлемента, Настройки, Строки)

	Для Каждого СтрокаСписка Из Строки Цикл
		СтрокаСписка = Строки[СтрокаСписка.Ключ];
		МинимумСекунд = СтрокаСписка.Данные["АС_МинимумСекунд"];
		МаксимумСекунд = СтрокаСписка.Данные["АС_МаксимумСекунд"];
		ПредставлениеЧасов = АС_ПредставлениеЧасов(МинимумСекунд);
		Если МинимумСекунд <> МаксимумСекунд Тогда
			ПредставлениеЧасов = ПредставлениеЧасов + "–" + АС_ПредставлениеЧасов(МаксимумСекунд);
		КонецЕсли;
		ОформлениеЧасов = СтрокаСписка.Оформление.Получить("АС_КоличествоЧасов");
		Если ОформлениеЧасов <> Неопределено Тогда
			ОформлениеЧасов.УстановитьЗначениеПараметра("Текст", ПредставлениеЧасов);
		КонецЕсли;
		// Окрашиваем всю строку после штатного оформления независимо от настроек списка.
		Если СтрокаСписка.Данные["АС_ОтклонениеЧасов"] Тогда
			Для Каждого ОформлениеЯчейки Из СтрокаСписка.Оформление Цикл
				ОформлениеЯчейки.Значение.УстановитьЗначениеПараметра(
					"ЦветФона", Новый Цвет(255, 199, 206));
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция АС_ПредставлениеЧасов(Секунды)

	Представление = Формат(Секунды / 3600, "ЧДЦ=2; ЧГ=; ЧН=0");
	Если СтрНайти(Представление, ",") > 0 Или СтрНайти(Представление, ".") > 0 Тогда
		Пока Прав(Представление, 1) = "0" Цикл
			Представление = Лев(Представление, СтрДлина(Представление) - 1);
		КонецЦикла;
		Если Прав(Представление, 1) = "," Или Прав(Представление, 1) = "." Тогда
			Представление = Лев(Представление, СтрДлина(Представление) - 1);
		КонецЕсли;
	КонецЕсли;
	Возврат Представление;

КонецФункции
