&НаСервере
Процедура АС_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ТипКоличества = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3));
	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
		"АС_ОстатокСУчетомЗаказов", ТипКоличества, "Объект.Запасы", "Остаток"));
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);

	ИмяКолонки = "АС_ЗапасыОстатокСУчетомЗаказов";
	Колонка = Элементы.Добавить(ИмяКолонки, Тип("ПолеФормы"), Элементы.Запасы);
	Колонка.Вид = ВидПоляФормы.ПолеВвода;
	Колонка.ПутьКДанным = "Объект.Запасы.АС_ОстатокСУчетомЗаказов";
	Колонка.Заголовок = "Остаток";
	Колонка.Подсказка = "Физический остаток на всех складах за вычетом незакрытой потребности заказов покупателей и заказ-нарядов";
	Колонка.ТолькоПросмотр = Истина;
	Колонка.Ширина = 10;
	Колонка.Формат = "ЧН=0; ЧДЦ=3";
	Элементы.Переместить(Колонка, Элементы.Запасы, Элементы.ЗапасыКоличество);

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяКолонки);
	ОформляемоеПоле.Использование = Истина;

	ОтборПоОстатку = ЭлементОформления.Отбор.Элементы.Добавить(
		Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборПоОстатку.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(
		"Объект.Запасы.АС_ОстатокСУчетомЗаказов");
	ОтборПоОстатку.ВидСравнения = ВидСравненияКомпоновкиДанных.Больше;
	ОтборПоОстатку.ПравоеЗначение = 0;
	ОтборПоОстатку.Использование = Истина;

	ЦветТекста = ЭлементОформления.Оформление.Элементы.Найти("ЦветТекста");
	ЦветТекста.Значение = WebЦвета.Оранжевый;
	ЦветТекста.Использование = Истина;

КонецПроцедуры

&НаКлиенте
