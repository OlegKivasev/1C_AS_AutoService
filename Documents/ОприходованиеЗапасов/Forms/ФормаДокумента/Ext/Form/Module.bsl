&НаСервере
Процедура АС_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ТипКоличества = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3));
	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
		"АС_ОстатокСУчетомЗаказов", ТипКоличества, "Объект.Запасы", "Остаток"));
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);

	ИмяКолонки = "АС_ЗапасыОстатокСУчетомЗаказов";
	Колонка = Элементы.Добавить(ИмяКолонки, Тип("ПолеФормы"), Элементы.Запасы);
	Колонка.Вид = ВидПоляФормы.ПолеВвода;
	Колонка.ПутьКДанным = "Объект.Запасы.АС_ОстатокСУчетомЗаказов";
	Колонка.Заголовок = "Остаток";
	Колонка.Подсказка = "Физический остаток на всех складах за вычетом незакрытой потребности заказов покупателей и заказ-нарядов";
	Колонка.ТолькоПросмотр = Истина;
	Колонка.Ширина = 10;
	Колонка.Формат = "ЧН=0; ЧДЦ=3";
	Элементы.Переместить(Колонка, Элементы.Запасы, Элементы.ЗапасыКоличество);

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяКолонки);
	ОформляемоеПоле.Использование = Истина;

	ОтборПоОстатку = ЭлементОформления.Отбор.Элементы.Добавить(
		Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборПоОстатку.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(
		"Объект.Запасы.АС_ОстатокСУчетомЗаказов");
	ОтборПоОстатку.ВидСравнения = ВидСравненияКомпоновкиДанных.Больше;
	ОтборПоОстатку.ПравоеЗначение = 0;
	ОтборПоОстатку.Использование = Истина;

	ЦветТекста = ЭлементОформления.Оформление.Элементы.Найти("ЦветТекста");
	ЦветТекста.Значение = WebЦвета.Оранжевый;
	ЦветТекста.Использование = Истина;

КонецПроцедуры

&НаКлиенте
&После("ПриОткрытии")
Процедура АС_ПриОткрытииПосле(Отказ)

	АС_ЗаполнитьОстаткиСУчетомЗаказовНаСервере();

КонецПроцедуры

&НаКлиенте
&После("ОрганизацияПриИзменении")
Процедура АС_ОрганизацияПриИзмененииПосле(Элемент)

	АС_ЗаполнитьОстаткиСУчетомЗаказовНаСервере();

КонецПроцедуры

&НаКлиенте
&После("ЗапасыНоменклатураПриИзмененииПродолжить")
Процедура АС_ЗапасыНоменклатураПриИзмененииПродолжитьПосле(Элемент, НовоеКоличество)

	АС_ЗаполнитьОстаткиСУчетомЗаказовНаСервере();

КонецПроцедуры

&НаКлиенте
&После("ЗапасыХарактеристикаПриИзменении")
Процедура АС_ЗапасыХарактеристикаПриИзмененииПосле(Элемент)

	АС_ЗаполнитьОстаткиСУчетомЗаказовНаСервере();

КонецПроцедуры

&НаКлиенте
&После("ЗапасыЕдиницаИзмеренияПриИзменении")
Процедура АС_ЗапасыЕдиницаИзмеренияПриИзмененииПосле(Элемент)

	АС_ЗаполнитьОстаткиСУчетомЗаказовНаСервере();

КонецПроцедуры

&НаКлиенте
&После("ОбработкаОповещения")
Процедура АС_ОбработкаОповещенияПосле(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "ПодборПроизведен" Тогда
		АС_ЗаполнитьОстаткиСУчетомЗаказовНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&После("ЗапасыПодтверждениеСбросаКоличестваЗавершение")
Процедура АС_ЗапасыПодтверждениеСбросаКоличестваЗавершениеПосле(
	Результат, ДополнительныеПараметры)

	Если ДополнительныеПараметры.Свойство("ЭтоПодбор")
		И ДополнительныеПараметры.ЭтоПодбор Тогда
		АС_ЗаполнитьОстаткиСУчетомЗаказовНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&После("ПолученыШтрихкодыФрагмент")
Процедура АС_ПолученыШтрихкодыФрагментПосле(НеизвестныеШтрихкоды)

	АС_ЗаполнитьОстаткиСУчетомЗаказовНаСервере();

КонецПроцедуры

&НаСервере
Процедура АС_ЗаполнитьОстаткиСУчетомЗаказовНаСервере()

	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		Для Каждого СтрокаДокумента Из Объект.Запасы Цикл
			СтрокаДокумента.АС_ОстатокСУчетомЗаказов = 0;
		КонецЦикла;
		Возврат;
	КонецЕсли;

	СтрокиДокумента = Новый Массив;
	Для Каждого СтрокаДокумента Из Объект.Запасы Цикл
		ИспользоватьВРасчете = ЗначениеЗаполнено(СтрокаДокумента.Номенклатура)
			И ТипЗнч(СтрокаДокумента.Номенклатура) = Тип("СправочникСсылка.Номенклатура");
		СтрокиДокумента.Добавить(Новый Структура(
			"Номенклатура,Характеристика,ЕдиницаИзмерения,НеОтгружено,ИспользоватьВРасчете",
			СтрокаДокумента.Номенклатура,
			СтрокаДокумента.Характеристика,
			СтрокаДокумента.ЕдиницаИзмерения,
			0,
			ИспользоватьВРасчете));
	КонецЦикла;

	Результат = АС_ДоступностьТоваровСервер.Рассчитать(
		СтрокиДокумента,
		Объект.Организация,
		Документы.ЗаказПокупателя.ПустаяСсылка());

	Для Индекс = 0 По Объект.Запасы.Количество() - 1 Цикл
		Объект.Запасы[Индекс].АС_ОстатокСУчетомЗаказов = Результат[Индекс].Доступно;
	КонецЦикла;

КонецПроцедуры
